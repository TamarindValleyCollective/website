  .whatsnew-eyebrow,
  .tour-count {
    margin: 0 0 4px;
    color: var(--tvc-orange-text);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .whatsnew-close {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    margin: -10px -10px 0 0;
    border: 0;
    background: none;
    color: var(--tvc-ink-soft);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
  }

  .whatsnew-list {
    display: grid;
    gap: 10px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .whatsnew-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .whatsnew-tag {
    flex: none;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .whatsnew-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tour {
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  /* .button sets display, which would beat the hidden attribute on Back (first step) and Skip (last) */
  .tour [hidden] {
    display: none;
  }

  .tour-block {
    position: absolute;
    inset: 0;
    background: rgb(34 41 31 / 0.55);
  }

  .tour--spot .tour-block {
    background: transparent;
  }

  .tour-spot {
    position: absolute;
    border-radius: var(--radius);
    outline: 3px solid var(--tvc-orange);
    box-shadow: 0 0 0 100vmax rgb(34 41 31 / 0.55);
    pointer-events: none;
  }

  .tour-card {
    position: absolute;
    width: min(360px, calc(100vw - 24px));
    box-sizing: border-box;
    padding: 20px;
    background: var(--tvc-white);
    /* Ringed in the spotlight's orange: a dark card on a dark scrim has no edge otherwise, and the pair reads as one. */
    border: 2px solid var(--tvc-orange);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    --pointer: 50%; /* where the pointer sits along its edge; the script aims it at the target */
  }

  /* The pointer: a turned square on the edge that faces the highlighted element. */
  .tour-card[data-side]::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid transparent;
    border-radius: 3px;
    background: inherit;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .tour-card[data-side='right']::before { left: 0; top: var(--pointer); border-color: transparent transparent var(--tvc-orange) var(--tvc-orange); }
  .tour-card[data-side='left']::before { left: 100%; top: var(--pointer); border-color: var(--tvc-orange) var(--tvc-orange) transparent transparent; }
  .tour-card[data-side='below']::before { left: var(--pointer); top: 0; border-color: var(--tvc-orange) transparent transparent var(--tvc-orange); }
  .tour-card[data-side='above']::before { left: var(--pointer); top: 100%; border-color: transparent var(--tvc-orange) var(--tvc-orange) transparent; }

  .tour-card--centre::before {
    display: none;
  }

  .tour-card--centre {
