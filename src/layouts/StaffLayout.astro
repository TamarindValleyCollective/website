    }
  }

  @keyframes who-pop {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  /* --------------------------------------------- collapsed (desktop only) */
  @media (min-width: 900px) {
    html[data-nav='collapsed'] .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    html[data-nav='collapsed'] .group-label {
      margin: 12px 10px 6px;
      padding: 0;
      height: 1px;
      overflow: hidden;
