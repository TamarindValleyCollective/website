    border-radius: var(--radius-sm);
    color: var(--tvc-ink-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
  }

  .rail-link svg {
    flex: none;
    color: var(--tvc-icon);
  }

  .rail-link[aria-current] {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .rail-link[aria-current] svg {
    color: var(--tvc-white);
  }

  /* Something waiting in this block (a count the shell may be given). Empty and hidden until then. */
  .badge {
    position: absolute;
    top: 2px;
