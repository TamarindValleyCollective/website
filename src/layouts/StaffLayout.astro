    }

    /* Collapsed, the brand row is just the mark with the round button under it. */
    html[data-nav='collapsed'] .brand {
      flex-direction: column;
      gap: 12px;
      padding: 16px 0 8px;
    }

    html[data-nav='collapsed'] .collapse-button {
      margin-left: 0;
    }
  }

  /* ------------------------------------------------------------ phones */
  @media (max-width: 899px) {
    .shell {
      grid-template-columns: 1fr;
    }

    .topbar {
      gap: 6px;
      padding: 8px;
    }

    .topbar .icon-button {
      display: inline-flex;
    }

    .topbar-title {
      display: inline;
      font-family: var(--font-wordmark);
      font-weight: 700;
      color: var(--tvc-green-dark);
    }

    /* The name and role would crowd the title on a phone; the initial still opens the menu. */
    .who-text,
    .caret {
      display: none;
    }

    .who {
      padding: 4px;
    }

    /* Explicit full height: the desktop rule's align-self: start would otherwise
       shrink this fixed panel to its content. */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      height: 100dvh;
      width: min(300px, 86vw);
      z-index: 70;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: var(--shadow-soft);
    }

    html[data-nav='collapsed'] .sidebar {
      width: min(300px, 86vw);
