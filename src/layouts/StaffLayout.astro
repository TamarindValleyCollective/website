  }

  /* ------------------------------------------------ sidebar: a rail of blocks and a panel of that block's pages
     Desktop: the rail (Today and the blocks the person may open, icon over label) beside a panel listing only the
     current block's pages. The round button hides the panel and the rail stays. Phones: the rail becomes a bottom tab
     bar and the panel's pages become a row of tabs under the top bar (.pagetabs). One set of links serves both. */
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    height: 100vh;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--tvc-white) 74%, transparent);
