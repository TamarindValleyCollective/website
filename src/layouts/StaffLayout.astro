  }

  .who-menu {
    transform-origin: top right;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    min-width: 240px;
    padding: 8px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .who-menu :global(p) {
    margin: 4px 8px 6px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
    overflow-wrap: anywhere; /* a long email must not stretch the menu */
  }

  .who-menu :global(button) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-base);
    text-align: left;
    cursor: pointer;
  }

  .who-menu :global(.appearance) {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 2px 4px 6px;
    padding: 3px;
    border-radius: 9px;
