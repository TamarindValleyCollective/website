  }

  .who-menu :global(button) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
