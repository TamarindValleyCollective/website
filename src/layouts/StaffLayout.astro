---
// The shell around every internal admin page (issue #89). It replaces the public website's header, footer, cookie banner,
// chat widget and analytics on these pages, none of which belong on a tool that shows guest and payment data.
//
// Navigation is by BLOCKS (Operations, Community, Finance, Settings), each holding pages: scripts/lib/admin-nav.mjs is the
// model (tested against the permission registry, so no tool can be missing). Desktop: a narrow rail of Today and the blocks
// the person may open (icon over label), beside a panel listing only the current block's pages; the round button hides the
// panel and the rail stays (the choice is remembered on this device; WhatsApp and the accommodation calendar start with the
// panel hidden because they need the width). Phone: the rail becomes a bottom tab bar and the block's pages a row of tabs
// under the top bar; the search button (or Command/Ctrl+K) jumps to any page.
//
// Everything starts hidden except Today and the current block. A small script asks /api/staff-me which modules this person
// holds a role in and reveals just those pages; the current page is always shown. Showing or hiding is only a convenience:
// every tool checks the person's role on the server for every request. A page that is one of several in a block passes
// `currentPage` (Finance: 'finance-parties'); `current` stays the module id the tours and permissions use.
import '../styles/global.css';
import '../styles/portal-look.css';
import { type ModuleId } from '../../netlify/functions/lib/staff-registry';
import { HOME, BLOCKS, blockOfPage } from '../../scripts/lib/admin-nav.mjs';
import { STAFF_ICONS as ICONS } from '../lib/staff-icons';

interface Props {
  title: string;
  description?: string;
  current: 'home' | ModuleId | 'access' | 'units' | 'previews' | 'security';
  // The page inside a block when one tool has several (Finance: 'finance-parties', 'finance-import'); defaults to `current`.
  currentPage?: string;
  // Start with the menu collapsed unless the person has chosen otherwise.
  collapseByDefault?: boolean;
  // 'full' (default): the content uses all the room to the right of the menu,
  // like the Netlify and Supabase dashboards. 'readable' keeps the public
  // site's 1120px column, for a page that is mostly prose.
  width?: 'full' | 'readable';
}
const { title, description = 'Internal tools for Tamarind Valley Collective.', current, currentPage = current, collapseByDefault = false, width = 'full' } = Astro.props;

// The block this page sits in (null for Today). Until /api/staff-me answers, only this block shows in the rail and its
// pages in the panel; the script then reveals the rest according to the person's roles (scripts/lib/admin-nav.mjs).
const currentBlockId = blockOfPage(currentPage);
const currentBlock = BLOCKS.find((b) => b.id === currentBlockId);
const hasPanel = Boolean(currentBlock && currentBlock.pages.length > 1);
---

<html lang="en" data-page={current} data-nav-page={currentPage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · Admin Portal</title>
    <!-- Sets the menu's expanded/collapsed state before first paint so the
         page doesn't jump. Runs before the body exists. -->
    <script is:inline define:vars={{ collapseByDefault }}>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('tvc-staff-nav-collapsed');
        } catch (e) {}
        var collapsed = saved === null ? collapseByDefault : saved === '1';
        try {
          var theme = localStorage.getItem('tvc-staff-theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
        // Google's sign-in button is white by default, a bright slab on the dark card; pages pass this as its theme.
        window.tvcGsiTheme = function () {
          var t = document.documentElement.getAttribute('data-theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          return dark ? 'filled_black' : 'outline';
        };
        document.documentElement.setAttribute('data-nav', collapsed ? 'collapsed' : 'expanded');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#staff-main">Skip to content</a>
    <div class="shell">

      <aside class="sidebar" id="staff-sidebar" aria-label="Admin portal" data-panel={hasPanel ? 'on' : 'off'}>
        <nav class="rail" aria-label="Sections" data-tour="menu">
          <a class="rail-logo" href={HOME.path} aria-label="Admin Portal, Today">
            <img src="/images/brand/tvc-logo-mark.svg" width="32" height="32" alt="" />
          </a>
          <ul class="rail-list">
            <li data-block="home">
              <a class="rail-link" href={HOME.path} aria-current={currentPage === 'home' ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[HOME.icon]} />
                <span class="label">{HOME.label}</span>
              </a>
            </li>
            {BLOCKS.map((b) => (
              <li data-block={b.id} hidden={b.id !== currentBlockId}>
                <a class="rail-link" href={b.pages[0].path} aria-current={b.id === currentBlockId ? 'true' : undefined}>
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[b.icon]} />
                  <span class="label">{b.label}</span>
                  <span class="badge" hidden></span>
                </a>
              </li>
            ))}
          </ul>
          <button type="button" id="collapse" data-tour="collapse" class="collapse-button" aria-label="Hide the page list" aria-pressed="false" aria-controls="staff-panel" title="Hide the page list">
            <svg class="collapse-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
          </button>
        </nav>
        <nav class="panel" id="staff-panel" aria-label="Pages">
          {BLOCKS.map((b) => (
            <div class="panel-block" data-block={b.id} hidden={b.id !== currentBlockId}>
              <h2 class="panel-title">{b.label}</h2>
              <ul>
                {b.pages.map((p) => (
                  <li data-page={p.id}>
                    <a href={p.path} aria-current={p.id === currentPage ? 'page' : undefined}>{p.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <dialog class="switcher" id="switcher" aria-label="Go to a page">
        <input id="switcher-input" type="text" placeholder="Go to a page" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="switcher-list" aria-autocomplete="list" aria-label="Go to a page" />
        <ul id="switcher-list" role="listbox" aria-label="Pages"></ul>
        <p class="switcher-empty" id="switcher-empty" hidden>Nothing matches.</p>
      </dialog>

      <div class="col">
        <header class="topbar">
          <a class="topbar-brand" href={HOME.path} aria-label="Admin Portal, Today">
            <img src="/images/brand/tvc-logo-mark.svg" width="28" height="28" alt="" />
            <span class="topbar-title">Admin Portal</span>
          </a>
          <div class="toolbar-slot"><slot name="toolbar" /></div>
          <button type="button" id="jump-open" class="jump-button" aria-label="Go to a page" title="Go to a page">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6"></circle><path d="M20 20l-4.5-4.5"></path></svg>
          </button>
          <div class="who-wrap" id="who-wrap" data-tour="account" hidden>
            <button type="button" class="who" id="who" aria-haspopup="true" aria-expanded="false" aria-controls="who-menu">
              <span class="avatar" id="avatar" aria-hidden="true"></span>
              <span class="who-text"><strong id="who-name"></strong><small id="who-role"></small></span>
              <svg class="caret" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
            </button>
            <div class="who-menu" id="who-menu" hidden></div>
          </div>
        </header>

        <!-- Phones: the pages of this block, as a row of tabs (the panel's job on a desktop). Rebuilt by the script. -->
        <nav class="pagetabs" id="pagetabs" aria-label="Pages in this section" hidden={!hasPanel}>
          {currentBlock && currentBlock.pages.map((p) => (
            <a href={p.path} data-page={p.id} aria-current={p.id === currentPage ? 'page' : undefined}>{p.label}</a>
          ))}
        </nav>

        <main id="staff-main" data-width={width}>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: var(--tvc-stone);
    color: var(--tvc-ink);
  }

  .skip-link {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 100;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }

  .skip-link:focus {
    top: 8px;
  }

  .shell {
    display: grid;
    grid-template-columns: auto 1fr;
    min-height: 100vh;
    --tabbar-h: 64px; /* the phone's bottom tab bar; things fixed to the bottom keep clear of it */
  }

  .col {
    min-width: 0; /* lets wide tables and the calendar scroll instead of stretching the page */
  }

  #staff-main {
    min-width: 0;
  }

  /* Signed out (or signed in without access): the card alone on the page, like the member portal's, instead of a menu,
     a top bar and a page title that nobody can use yet. Keyed on the card itself, so it holds on every admin page and
     for every way the card appears; the shell comes back as soon as a page hides the card. */
  :global(html:has(#staff-main #gate:not([hidden]), #staff-main #forbidden:not([hidden]))) .shell {
    grid-template-columns: 1fr;
  }

  :global(html:has(#staff-main #gate:not([hidden]), #staff-main #forbidden:not([hidden]))) :is(.sidebar, .topbar, .pagetabs) {
    display: none;
  }

  :global(html:has(#staff-main #gate:not([hidden]), #staff-main #forbidden:not([hidden]))) #staff-main :global(section > :not(.signin)) {
    display: none;
  }

  /* The pages wrap themselves in the public site's .section, which paints cream. Here the stone
     backdrop (like the member portal's) should run behind them, with the cards standing out in white. */
  #staff-main :global(.section) {
    background: transparent;
  }

  /* The pages wrap their content in the public site's .wrapper, a 1120px
     centred column. In the staff shell that cap is lifted so tables, grids and
     the inbox use the whole screen; each page keeps its own padding, and
     forms and cards keep their own sensible inner widths. */
  /* One title style for every tool: the older pages used 1.6rem to 2.9rem. */
  #staff-main :global(h1) {
    font-size: 2.125rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.022em;
    margin: 6px 0 6px;
    text-wrap: balance;
  }

  #staff-main :global(h2) {
    letter-spacing: -0.015em;
  }

  /* Admin buttons. The shared .button is the public site's large orange pill; inside the admin
     shell it becomes a compact, quiet control (36px, small radius). The modifiers (--outline,
     --primary, --danger, --danger-outline, --small) are defined once here, after the base rule at
     the same specificity, so pages never need their own copies. The tour card (staff-tour-ui.mjs)
     sits on the body, outside main, so it is listed too. */
  main :global(.button),
  :global(.tour .button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--tvc-green-dark);
    border-radius: var(--radius-sm);
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
    box-shadow: none;
  }

  main :global(.button--outline),
  :global(.tour .button--outline) {
    border-color: var(--tvc-line-strong);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  main :global(.button:disabled),
  :global(.tour .button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  main :global(.button--primary) {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: var(--tvc-white);
  }

  main :global(.button--danger) {
    background: var(--tvc-error-text);
    border-color: var(--tvc-error-text);
    color: var(--tvc-white);
  }

  main :global(.button--danger-outline) {
    background: var(--tvc-white);
    border-color: var(--tvc-error-text);
    color: var(--tvc-error-text);
  }

  /* An icon-only button (a close or back control): a square, so the glyph is never squeezed by the label padding. */
  main :global(.button--icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    min-width: 32px;
    height: 32px;
    min-height: 32px;
    padding: 0;
    line-height: 1;
  }

  main :global(.button--small) {
    min-height: 28px;
    padding: 0 12px;
    font-size: var(--text-xs);
  }

  /* ---- shared primitives. Pages use these and do not redefine them (CLAUDE.md, Design language): the card
     surface, the line under a page title, small notes, error text, the page's vertical rhythm, text-style
     buttons, and visually hidden labels. A page may add to one (WhatsApp's panes run edge to edge) but
     never repeats what is here. Sizes come from the --text-* scale, nothing below 0.8rem. */
  main :global(.card) {
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
  }

  main :global(.hint) {
    color: var(--tvc-ink-soft);
    margin: -8px 0 24px;
  }

  main :global(.note) {
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
    margin: 0 0 10px;
  }

  main :global(.error) {
    color: var(--tvc-error-text);
    font-size: var(--text-sm);
    margin: 10px 0 0;
  }

  main :global(.section.wrapper) {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  main :global([hidden]) {
    display: none !important;
  }

  main :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- shared building blocks, from the Apple-style concept. Pages compose these; none redefines them. */

  /* .field (search) and .segmented (one choice from a few) are shared with the member portal: see styles/portal-look.css. */

  /* .list and .row (a grouped list) are shared with the member portal: see styles/portal-look.css. */

  /* A destructive row: plain red text in its own group, never a filled button (the .row inside a .list). */
  main :global(.crit-row) {
    justify-content: center;
    color: var(--tvc-error-text);
    font-weight: 500;
    text-align: center;
  }

  @media (hover: hover) {
    main :global(button.crit-row:hover:not(:disabled)) {
      background: var(--tvc-error-bg);
    }
  }

  main :global(.crit-row:disabled) {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* A small status pill; the colour only reinforces the word. */
  main :global(.pill) {
    display: inline-flex;
    align-items: center;
    padding: 1px 9px;
    border-radius: 999px;
    background: var(--tvc-cream);
    color: var(--tvc-ink-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  main :global(.pill--ok) {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  main :global(.pill--warn) {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  main :global(.pill--crit) {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  /* Go to a tool (Command/Ctrl K): a search field over a short list, near the top like a command palette. */
  .switcher {
    width: min(460px, calc(100vw - 32px));
    margin: 12vh auto auto;
    padding: 8px;
    border: 1px solid var(--tvc-line);
    border-radius: 16px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    box-shadow: var(--shadow-soft);
  }

  .switcher::backdrop {
    background: rgba(8, 12, 8, 0.4);
  }

  .switcher[open] {
    animation: staff-sheet-in 200ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .switcher input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-md);
    outline: none;
  }

  .switcher ul {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    max-height: 50vh;
    overflow-y: auto;
  }

  /* The rows are built by the script, so they are global (Astro's scoped CSS never reaches them). */
  .switcher :global(li) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-field);
    cursor: pointer;
  }

  .switcher :global(li[aria-selected='true']) {
    background: var(--tvc-cream);
  }

  .switcher :global(li small) {
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .switcher-empty {
    margin: 0;
    padding: 12px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .who-menu :global(kbd) {
    margin-left: auto;
    font: inherit;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .switcher[open] {
      animation: none;
    }
  }

  /* One focus ring for anything that has none of its own: a keyboard user can always see where they are. */
  main :global(:where(a, button, summary, select, [tabindex]):focus-visible) {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  /* Admin forms. Two layouts share one look for labels and fields:
       .inline-form   a short form in a card: fields and the button in one wrapping row, on the same baseline
       .stack-form    a longer form: labels above fields, one column (a page's own grid may re-arrange it)
     The field rules are written with :where() so they carry almost no specificity: a page may make one field
     denser (the accommodation guest rows) without fighting them, but it does not restyle borders, focus or labels. */
  main :global(.inline-form) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 14px 12px;
  }

  main :global(.stack-form) {
    display: grid;
    gap: 14px;
  }

  main :global(:where(.inline-form, .stack-form) label) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink);
  }

  /* A checkbox or radio and its words: one row, the whole label is the target. */
  main :global(:where(.inline-form, .stack-form) label:has(> input[type='checkbox'], > input[type='radio'])) {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    cursor: pointer;
  }

  main :global(:where(.inline-form, .stack-form) input:is([type='checkbox'], [type='radio'])) {
    accent-color: var(--tvc-green-dark);
  }

  main :global(:where(.inline-form, .stack-form) :is(.opt, small)) {
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  main :global(:where(.inline-form, .stack-form) :is(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'], [type='hidden']), select, textarea)) {
    box-sizing: border-box;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-md);
    font-weight: 400;
    transition: border-color 120ms ease-out, box-shadow 120ms ease-out;
  }

  main :global(:where(.inline-form, .stack-form) :is(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'], [type='hidden']), select)) {
    min-height: 36px;
    padding: 0 12px;
  }

  main :global(:where(.inline-form, .stack-form) textarea) {
    padding: 8px 12px;
    resize: vertical;
  }

  /* The field itself shows focus (a border and a soft halo), not a ring floating off its edge. */
  main :global(:where(.inline-form, .stack-form) :is(input, select, textarea):focus) {
    outline: none;
    border-color: var(--tvc-orange);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tvc-orange) 28%, transparent);
  }

  main :global(:where(.inline-form, .stack-form) :is(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'], [type='hidden']), select):disabled),
  main :global(:where(.inline-form, .stack-form) textarea:disabled) {
    background: var(--tvc-cream);
    color: var(--tvc-ink-soft);
    cursor: not-allowed;
  }

  @media (pointer: coarse) {
    main :global(:where(.inline-form, .stack-form) :is(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'], [type='hidden']), select)) {
      min-height: 44px;
    }
  }

  /* A sheet: a small modal <dialog> for one focused task (unlocking, a refund). */
  main :global(.sheet) {
    width: min(420px, calc(100vw - 32px));
    padding: 22px;
    border: 1px solid var(--tvc-line);
    border-radius: 16px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    box-shadow: var(--shadow-soft);
  }

  main :global(.sheet::backdrop) {
    background: rgba(8, 12, 8, 0.4);
  }

  main :global(.sheet[open]) {
    animation: staff-sheet-in 240ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes staff-sheet-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(6px);
    }
  }

  main :global(.sheet h2) {
    margin: 0 0 6px;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  main :global(.sheet-text) {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  main :global(.sheet-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
  }

  /* A toast: one short message at the foot of the page, with Undo when the action can be reversed (showToast). */
  main :global(.toast) {
    position: fixed;
    z-index: 80;
    left: 50%;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 10px 10px 10px 16px;
    border-radius: 12px;
    background: var(--tvc-ink);
    color: var(--tvc-stone);
    font-size: var(--text-sm);
    box-shadow: var(--shadow-soft);
    transform: translateX(-50%);
    animation: staff-toast-rise 240ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes staff-toast-rise {
    from {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
  }

  main :global(.toast-undo) {
    min-height: 32px;
    padding: 4px 12px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    main :global(.sheet[open]),
    main :global(.toast) {
      animation: none;
    }
  }

  main :global(.link-button) {
    font: inherit;
    font-size: var(--text-sm);
    background: none;
    border: none;
    padding: 8px 4px;
    color: var(--tvc-ink-soft);
    text-decoration: underline;
    cursor: pointer;
  }

  @media (pointer: coarse) {
    main :global(.button),
    :global(.tour .button) {
      min-height: 44px;
    }
  }

  @media (pointer: coarse) {
    main :global(.button--icon) {
      width: 44px;
      min-width: 44px;
      height: 44px;
    }
  }

  /* A finger, not a mouse: the Undo in a toast and the appearance choice get full-size targets, and form fields are
     16px so iOS Safari does not zoom the page when one is focused. */
  @media (pointer: coarse) {
    main :global(.toast-undo),
    .who-menu :global(.appearance button),
    main :global(.lock-pill),
    main :global(.role-select),
    main :global(.chip),
    main :global(.button--small),
    main :global(.event-picker select),
    main :global(.toolbar select) {
      min-height: 44px;
    }

    main :global(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'])),
    main :global(select),
    main :global(textarea),
    :global(.sheet) :global(input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'])),
    :global(.sheet) :global(select),
    :global(.sheet) :global(textarea) {
      font-size: var(--text-md);
    }
  }

  #staff-main[data-width='full'] :global(.wrapper) {
    max-width: none;
