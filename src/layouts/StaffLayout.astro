---
// The shell around every internal admin page (issue #89): a left menu listing
// the tools the signed-in person holds a role in, with their name and Sign out
// at the bottom. It replaces the public website's header, footer, cookie banner,
// chat widget and analytics on these pages, none of which belong on a tool that
// shows guest and payment data.
//
// The menu items are rendered here from the same registry the server uses for
// permissions (labels and paths: MODULE_INFO), but start hidden. A small script
// asks /api/staff-me which tools this person has a role in and reveals just
// those; the current page's item is always shown. Showing or hiding an item is
// only a convenience — every tool checks the person's role on the server for
// every request.
//
// Desktop: a sticky left menu that collapses to an icon strip (the choice is
// remembered on this device; WhatsApp and the accommodation calendar start
// collapsed because they need the width). Phone: a top bar with a menu button
// that slides the list over the page.
import '../styles/global.css';
import { MODULE_INFO, type ModuleId } from '../../netlify/functions/lib/staff-registry';
import { STAFF_ICONS as ICONS } from '../lib/staff-icons';

interface Props {
  title: string;
  description?: string;
  current: 'home' | ModuleId | 'access' | 'security';
  // Start with the menu collapsed unless the person has chosen otherwise.
  collapseByDefault?: boolean;
  // 'full' (default): the content uses all the room to the right of the menu,
  // like the Netlify and Supabase dashboards. 'readable' keeps the public
  // site's 1120px column, for a page that is mostly prose.
  width?: 'full' | 'readable';
}
const { title, description = 'Internal tools for Tamarind Valley Collective.', current, collapseByDefault = false, width = 'full' } = Astro.props;

const toolIds: ModuleId[] = ['photo-pool', 'whatsapp', 'event-payments', 'accommodation', 'members', 'usage'];
const adminItems = [
  { id: 'access', label: 'Access', path: '/internal/access/' },
  { id: 'security', label: 'Security', path: '/internal/security/' },
] as const;
---

<html lang="en" data-page={current}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · Admin Portal</title>
    <!-- Sets the menu's expanded/collapsed state before first paint so the
         page doesn't jump. Runs before the body exists. -->
    <script is:inline define:vars={{ collapseByDefault }}>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('tvc-staff-nav-collapsed');
        } catch (e) {}
        var collapsed = saved === null ? collapseByDefault : saved === '1';
        document.documentElement.setAttribute('data-nav', collapsed ? 'collapsed' : 'expanded');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#staff-main">Skip to content</a>
    <div class="shell">

      <aside class="sidebar" id="staff-sidebar" aria-label="Admin portal">
        <div class="brand">
          <img src="/images/brand/tvc-logo-mark.svg" width="30" height="30" alt="" />
          <span class="label brand-name">Admin Portal</span>
          <button type="button" id="collapse" data-tour="collapse" class="collapse-button" aria-label="Collapse the menu" aria-pressed="false" title="Collapse the menu">
            <svg class="collapse-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
          </button>
          <button type="button" id="menu-close" class="icon-button menu-close" aria-label="Close the menu">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>

        <nav class="menu" aria-label="Tools" data-tour="menu">
          <ul>
            <li>
              <a href="/internal/" title="Home" aria-current={current === 'home' ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS.home} />
                <span class="label">Home</span>
              </a>
            </li>
          </ul>

          <p class="group-label" id="group-tools">Tools</p>
          <ul aria-labelledby="group-tools" class="group-list">
            {toolIds.map((id) => (
              <li data-module={id} data-current={current === id ? 'true' : undefined} hidden={current !== id}>
                <a href={MODULE_INFO[id].path} title={MODULE_INFO[id].label} aria-current={current === id ? 'page' : undefined}>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[id]} />
                  <span class="label">{MODULE_INFO[id].label}</span>
                </a>
              </li>
            ))}
          </ul>

          <div id="admin-group" data-current={adminItems.some((a) => a.id === current) ? 'true' : undefined} hidden={!adminItems.some((a) => a.id === current)}>
            <p class="group-label" id="group-admin">Admin</p>
            <ul aria-labelledby="group-admin" class="group-list">
              {adminItems.map((item) => (
                <li>
                  <a href={item.path} title={item.label} aria-current={current === item.id ? 'page' : undefined}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[item.id]} />
                    <span class="label">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>

      </aside>

      <div class="scrim" id="scrim" hidden></div>

      <div class="col">
        <header class="topbar">
          <button type="button" id="menu-open" class="icon-button" aria-label="Open the menu" aria-controls="staff-sidebar" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <span class="topbar-title">Admin Portal</span>
          <div class="who-wrap" id="who-wrap" data-tour="account" hidden>
            <button type="button" class="who" id="who" aria-haspopup="true" aria-expanded="false" aria-controls="who-menu">
              <span class="avatar" id="avatar" aria-hidden="true"></span>
              <span class="who-text"><strong id="who-name"></strong><small id="who-role"></small></span>
              <svg class="caret" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
            </button>
            <div class="who-menu" id="who-menu" hidden></div>
          </div>
        </header>

        <main id="staff-main" data-width={width}>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: var(--tvc-stone);
    color: var(--tvc-ink);
  }

  .skip-link {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 100;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }

  .skip-link:focus {
    top: 8px;
  }

  .shell {
    display: grid;
    grid-template-columns: auto 1fr;
    min-height: 100vh;
  }

  .col {
    min-width: 0; /* lets wide tables and the calendar scroll instead of stretching the page */
  }

  #staff-main {
    min-width: 0;
  }

  /* The pages wrap themselves in the public site's .section, which paints cream. Here the stone
     backdrop (like the member portal's) should run behind them, with the cards standing out in white. */
  #staff-main :global(.section) {
    background: transparent;
  }

  /* The pages wrap their content in the public site's .wrapper, a 1120px
     centred column. In the staff shell that cap is lifted so tables, grids and
     the inbox use the whole screen; each page keeps its own padding, and
     forms and cards keep their own sensible inner widths. */
  /* One title style for every tool: the older pages used 1.6rem to 2.9rem. */
  #staff-main :global(h1) {
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 0 0 8px;
  }

  /* Admin buttons. The shared .button is the public site's large orange pill; inside the
     staff shell it becomes a compact, quiet control (36px, small radius). These rules are
     deliberately low specificity (main .button) so a page's own modifier classes
     (--danger, --primary, --icon...) still win, and global.css is untouched. The tour card
     (scripts/lib/staff-tour-ui.mjs) sits on the body, outside main, so it is listed too. */
  main :global(.button),
  :global(.tour .button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--tvc-green-dark);
    border-radius: var(--radius-sm);
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    box-shadow: none;
  }

  main :global(.button--outline),
  :global(.tour .button--outline) {
    border-color: var(--tvc-line-strong);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  main :global(.button:disabled),
  :global(.tour .button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (pointer: coarse) {
    main :global(.button),
    :global(.tour .button) {
      min-height: 44px;
    }
  }

  #staff-main[data-width='full'] :global(.wrapper) {
    max-width: none;
    margin: 0;
  }

  /* ---------------------------------------------------------------- sidebar */
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    width: 276px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: var(--tvc-white);
    border-right: 1px solid var(--tvc-line);
    overflow-x: hidden;
    overflow-y: auto;
    z-index: 40;
    transition: width 0.18s ease;
  }

  html[data-nav='collapsed'] .sidebar {
    width: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 19px;
    min-height: 32px;
  }

  .brand img {
    flex: none;
  }

  .collapse-button {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--tvc-line);
    border-radius: 50%;
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    cursor: pointer;
  }

  .brand-name {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--tvc-green-dark);
    white-space: nowrap;
  }

  .menu {
    flex: 1;
    padding: 4px 10px;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu li[hidden],
  .menu div[hidden],
  .who-wrap[hidden],
  .who-menu[hidden] {
    display: none;
  }

  .group-label {
    margin: 18px 0 6px;
    padding: 0 10px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
    white-space: nowrap;
  }

  .menu a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    font-size: 1rem;
    color: var(--tvc-ink);
    text-decoration: none;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
  }

  .menu a svg {
    flex: none;
  }

  .menu a .label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (hover: hover) and (pointer: fine) {
    .menu a:hover {
      background: var(--tvc-cream);
    }
  }

  .menu a:focus-visible,
  .collapse-button:focus-visible,
  .who:focus-visible,
  .who-menu :global(button:focus-visible),
  .icon-button:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 1px;
  }

  .menu a[aria-current='page'] {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  .collapse-icon {
    transition: transform 0.18s ease;
  }

  html[data-nav='collapsed'] .collapse-icon {
    transform: rotate(180deg);
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--tvc-ink);
    cursor: pointer;
  }

  /* Phone-only pieces: hidden by default, shown in the phone query below. This
     comes after .icon-button on purpose; declared before it, .icon-button's
     display would win and the close button would show on desktop. */
  .menu-close,
  .scrim,
  .topbar .icon-button,
  .topbar-title {
    display: none;
  }

  /* ------------------------------------------------ top bar and the signed-in user */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    background: color-mix(in srgb, var(--tvc-white) 82%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease-out;
  }

  /* The hairline appears only once content is passing under the bar. */
  .topbar.scrolled {
    border-bottom-color: var(--tvc-line);
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .topbar {
      background: var(--tvc-white);
      backdrop-filter: none;
      border-bottom-color: var(--tvc-line);
    }
  }

  .who-wrap {
    position: relative;
    flex: none;
    margin-left: auto;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 4px 12px 4px 8px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    cursor: pointer;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .who-text {
    display: grid;
    text-align: left;
    line-height: 1.15;
  }

  .who-text strong {
    font-size: var(--text-sm);
  }

  .who-text small {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .caret {
    flex: none;
    color: var(--tvc-ink-soft);
  }

  .who-menu {
    transform-origin: top right;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    min-width: 240px;
    padding: 8px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .who-menu :global(p) {
    margin: 4px 8px 6px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
    overflow-wrap: anywhere; /* a long email must not stretch the menu */
  }

  .who-menu :global(button) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-base);
    text-align: left;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .who-menu :global(button:hover) {
      background: var(--tvc-green-tint);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .who-menu:not([hidden]) {
      animation: who-pop 140ms ease-out;
    }
  }

  @keyframes who-pop {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  /* --------------------------------------------- collapsed (desktop only) */
  @media (min-width: 900px) {
    html[data-nav='collapsed'] .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    html[data-nav='collapsed'] .group-label {
      margin: 12px 10px 6px;
      padding: 0;
      height: 1px;
      overflow: hidden;
      font-size: 0;
      background: var(--tvc-line);
    }

    /* Collapsed, the brand row is just the mark with the round button under it. */
    html[data-nav='collapsed'] .brand {
      flex-direction: column;
      gap: 12px;
      padding: 16px 0 8px;
    }

    html[data-nav='collapsed'] .collapse-button {
      margin-left: 0;
    }
  }

  /* ------------------------------------------------------------ phones */
  @media (max-width: 899px) {
    .shell {
      grid-template-columns: 1fr;
    }

    .topbar {
      gap: 6px;
      padding: 8px;
    }

    .topbar .icon-button {
      display: inline-flex;
    }

    .topbar-title {
      display: inline;
      font-family: var(--font-wordmark);
      font-weight: 700;
      color: var(--tvc-green-dark);
    }

    /* The name and role would crowd the title on a phone; the initial still opens the menu. */
    .who-text,
    .caret {
      display: none;
    }

    .who {
      padding: 4px;
    }

    /* Explicit full height: the desktop rule's align-self: start would otherwise
       shrink this fixed panel to its content. */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      height: 100dvh;
      width: min(300px, 86vw);
      z-index: 70;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: var(--shadow-soft);
    }

    html[data-nav='collapsed'] .sidebar {
      width: min(300px, 86vw);
    }

    html[data-menu='open'] .sidebar {
      transform: none;
    }

    .menu-close {
      display: inline-flex;
      margin-left: auto;
    }

    .collapse-button {
      display: none;
    }

    .scrim {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(34, 41, 31, 0.45);
    }

    html[data-menu='open'] .scrim {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .collapse-icon,
    .topbar {
      transition: none;
    }
  }
</style>

<script is:inline>
  // On admin.tvc.farm the pages are served without the /internal prefix (netlify.toml), so show
  // the short address in every in-page link. Elsewhere (previews, netlify dev) the prefix is real.
  // The long form still redirects there, so a link this misses only costs one hop.
  if (location.hostname === 'admin.tvc.farm') {
    const shorten = (root) =>
      root.querySelectorAll('a[href^="/internal"]').forEach((a) => {
        const href = a.getAttribute('href');
        if (href === '/internal' || href.startsWith('/internal/')) a.setAttribute('href', href.slice('/internal'.length) || '/');
      });
    shorten(document);
    new MutationObserver((records) => records.forEach((r) => r.addedNodes.forEach((n) => n.nodeType === 1 && shorten(n)))).observe(document.body, { childList: true, subtree: true });
  }
</script>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, staffFetch } from '../../scripts/lib/staff-client.mjs';
  import { fullTourFor } from '../../scripts/lib/staff-tour.mjs';
  import { offerTour, startTour } from '../../scripts/lib/staff-tour-ui.mjs';

  declare const google: any;

  interface Me {
    name: string | null;
    maskedEmail?: string | null; // masked by the server; absent in answers cached before this existed
    isSuperAdmin: boolean;
    tools: { module: string }[];
  }

  const CACHE_KEY = 'tvc-staff-me'; // sessionStorage: the last answer from /api/staff-me, for this sign-in only
  const COLLAPSE_KEY = 'tvc-staff-nav-collapsed'; // localStorage: a per-device preference
  const FRESH_MS = 60_000;
  const MAX_AGE_MS = 10 * 60_000;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.documentElement;
  const toolItems = Array.from(document.querySelectorAll<HTMLElement>('li[data-module]'));
  const adminGroup = $('admin-group');
  const page = root.dataset.page ?? '';
  const whoWrap = $('who-wrap');
  const whoBtn = $<HTMLButtonElement>('who');
  const whoMenu = $('who-menu');
  const topbar = document.querySelector<HTMLElement>('.topbar')!;
  const collapseBtn = $<HTMLButtonElement>('collapse');
  const menuOpen = $<HTMLButtonElement>('menu-open');
  const menuClose = $<HTMLButtonElement>('menu-close');
  const scrim = $('scrim');
  const sidebar = $('staff-sidebar');

  // ---- what to show: the person's tools (cache keyed to this sign-in)
  const fingerprint = (token: string) => token.slice(-24);

  function readCache(token: string | null): { at: number; me: Me } | null {
    if (!token) return null;
    try {
      const saved = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? 'null');
      if (saved && saved.fp === fingerprint(token) && Date.now() - saved.at < MAX_AGE_MS) return { at: saved.at, me: saved.me };
    } catch {
      // treated as no cache
    }
    return null;
  }

  function writeCache(token: string, me: Me) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ fp: fingerprint(token), at: Date.now(), me }));
    } catch {
      // storage blocked: the menu just refetches each page
    }
  }

  function signOut() {
    clearToken();
    clearStepUp();
    try {
      sessionStorage.removeItem(CACHE_KEY);
    } catch {
      // nothing to clear
    }
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    location.reload(); // each page then shows its own sign-in panel
  }

  // ---- the signed-in user: a pill in the top bar that opens a small menu (like the member portal's)
  const whoOpen = () => !whoMenu.hidden;
  function setWho(open: boolean, returnFocus = false) {
    whoMenu.hidden = !open;
    whoBtn.setAttribute('aria-expanded', String(open));
    if (open) whoMenu.querySelector<HTMLElement>('button')?.focus();
    else if (returnFocus) whoBtn.focus();
  }

  function renderWho(me: Me | null) {
    whoWrap.hidden = !me || !me.name;
    setWho(false);
    if (!me?.name) return;
    $('avatar').textContent = me.name.trim().slice(0, 1).toUpperCase() || '?'; // text only, whatever the name contains
    $('who-name').textContent = me.name;
    $('who-role').textContent = me.isSuperAdmin ? 'Super admin' : 'Admin';
    const items: HTMLElement[] = [];
    if (me.maskedEmail) {
      const signedIn = document.createElement('p');
      signedIn.textContent = `Signed in as ${me.maskedEmail}`;
      items.push(signedIn);
    }
    if (fullTourFor(page, me.isSuperAdmin).length) {
      const tour = document.createElement('button');
      tour.type = 'button';
      tour.textContent = page === 'home' ? 'Take the tour' : 'Take the tour of this page';
      tour.addEventListener('click', () => {
        setWho(false);
        startTour(fullTourFor(page, me.isSuperAdmin));
      });
      items.push(tour);
    }
    const out = document.createElement('button');
    out.type = 'button';
    out.textContent = 'Sign out';
    out.addEventListener('click', signOut);
    items.push(out);
    whoMenu.replaceChildren(...items);
  }
  whoBtn.addEventListener('click', () => setWho(!whoOpen()));
  document.addEventListener('click', (ev) => {
    if (whoOpen() && !(ev.target as Element).closest('.who-wrap')) setWho(false);
  });
  window.addEventListener('scroll', () => topbar.classList.toggle('scrolled', window.scrollY > 4), { passive: true });

  // Offer this page's tour once, and only to someone who can actually see the page behind it.
  function canSeePage(me: Me): boolean {
    if (page === 'home') return true;
    if (page === 'access' || page === 'security') return me.isSuperAdmin;
    return me.tools.some((t) => t.module === page);
  }

  function apply(me: Me | null) {
    for (const li of toolItems) li.hidden = li.dataset.current !== 'true' && !me?.tools.some((t) => t.module === li.dataset.module);
    adminGroup.hidden = adminGroup.dataset.current !== 'true' && !me?.isSuperAdmin;
    renderWho(me);
    const token = getToken();
    if (me && me.name && token && canSeePage(me)) offerTour({ page, isSuperAdmin: me.isSuperAdmin, email: decodeTokenEmail(token) });
  }

  let pollTimer: number | undefined;

  async function refresh() {
    const token = getToken();
    if (!token) {
      apply(null);
      startPolling();
      return;
    }
    const cached = readCache(token);
    if (cached) apply(cached.me);
    if (cached && Date.now() - cached.at < FRESH_MS) return;
    try {
      const { status, data } = await staffFetch('/api/staff-me');
      if (status === 200) {
        writeCache(token, data as Me);
        apply(data as Me);
      }
    } catch (err) {
      if (err instanceof StaffAuthError && err.kind === 'forbidden') apply({ name: null, isSuperAdmin: false, tools: [] });
      else apply(null); // signed out or the session ended: only Home, and wait for a new sign-in
      if (err instanceof StaffAuthError && err.kind === 'unauthorized') startPolling();
    }
  }

  // The pages sign people in themselves, so the menu notices a new sign-in by
  // checking storage; it stops as soon as it has an answer.
  function startPolling() {
    if (pollTimer !== undefined) return;
    pollTimer = window.setInterval(() => {
      if (!getToken()) return;
      window.clearInterval(pollTimer);
      pollTimer = undefined;
      refresh();
    }, 1000);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refresh();
  });

  // ---- collapse (desktop)
  function setCollapsed(collapsed: boolean) {
    root.setAttribute('data-nav', collapsed ? 'collapsed' : 'expanded');
    collapseBtn.setAttribute('aria-pressed', String(collapsed));
    const label = collapsed ? 'Expand the menu' : 'Collapse the menu';
    collapseBtn.setAttribute('aria-label', label);
    collapseBtn.title = label;
  }
  setCollapsed(root.getAttribute('data-nav') === 'collapsed');
  collapseBtn.addEventListener('click', () => {
    const next = root.getAttribute('data-nav') !== 'collapsed';
    setCollapsed(next);
    try {
      localStorage.setItem(COLLAPSE_KEY, next ? '1' : '0');
    } catch {
      // preference just isn't remembered
    }
  });

  // ---- slide-over menu (phones)
  function setMenu(open: boolean) {
    if (open) root.setAttribute('data-menu', 'open');
    else root.removeAttribute('data-menu');
    scrim.hidden = !open;
    menuOpen.setAttribute('aria-expanded', String(open));
    if (open) sidebar.querySelector<HTMLElement>('a[aria-current="page"], .menu a')?.focus();
    else menuOpen.focus();
  }
  menuOpen.addEventListener('click', () => setMenu(true));
  menuClose.addEventListener('click', () => setMenu(false));
  scrim.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    if (whoOpen()) setWho(false, true);
    else if (root.getAttribute('data-menu') === 'open') setMenu(false);
  });
  sidebar.addEventListener('click', (ev) => {
    if ((ev.target as HTMLElement).closest('.menu a') && root.getAttribute('data-menu') === 'open') setMenu(false);
  });

  refresh();
</script>

