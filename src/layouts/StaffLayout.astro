    min-width: 44px;
    min-height: 44px;
    margin: -10px -10px 0 0;
    border: 0;
    background: none;
    color: var(--tvc-ink-soft);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
  }

  .whatsnew-list {
    display: grid;
    gap: 10px;
    margin: 0 0 14px;
    padding: 0;
