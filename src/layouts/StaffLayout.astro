    height: 44px;
    margin-bottom: 8px;
  }

  .rail-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-list li[hidden],
  .panel-block[hidden],
  .panel li[hidden],
  .badge[hidden],
  .pagetabs[hidden],
  .who-wrap[hidden],
  .who-menu[hidden] {
