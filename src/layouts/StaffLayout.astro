    .menu-close {
      display: inline-flex;
      margin-left: auto;
    }

    .collapse-button {
      display: none;
    }

    .scrim {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(34, 41, 31, 0.45);
    }

    html[data-menu='open'] .scrim {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .collapse-icon,
    .topbar {
      transition: none;
    }
  }
</style>

<script is:inline>
  // On admin.tvc.farm the pages are served without the /internal prefix (netlify.toml), so show
  // the short address in every in-page link. Elsewhere (previews, netlify dev) the prefix is real.
  // The long form still redirects there, so a link this misses only costs one hop.
  if (location.hostname === 'admin.tvc.farm') {
    const shorten = (root) =>
      root.querySelectorAll('a[href^="/internal"]').forEach((a) => {
        const href = a.getAttribute('href');
        if (href === '/internal' || href.startsWith('/internal/')) a.setAttribute('href', href.slice('/internal'.length) || '/');
      });
    shorten(document);
    new MutationObserver((records) => records.forEach((r) => r.addedNodes.forEach((n) => n.nodeType === 1 && shorten(n)))).observe(document.body, { childList: true, subtree: true });
  }
</script>

<script>
  import { StaffAuthError, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, fillAvatar, getToken, staffFetch } from '../../scripts/lib/staff-client.mjs';
  import { fullTourFor } from '../../scripts/lib/staff-tour.mjs';
  import { offerTour, startTour } from '../../scripts/lib/staff-tour-ui.mjs';

  declare const google: any;

  interface Me {
    name: string | null;
    maskedEmail?: string | null; // masked by the server; absent in answers cached before this existed
    picture?: string | null; // their own Google picture, from their token; absent in older cached answers
    isSuperAdmin: boolean;
    tools: { module: string }[];
  }

  const CACHE_KEY = 'tvc-staff-me'; // sessionStorage: the last answer from /api/staff-me, for this sign-in only
  const COLLAPSE_KEY = 'tvc-staff-nav-collapsed'; // localStorage: a per-device preference
  const FRESH_MS = 60_000;
  const MAX_AGE_MS = 10 * 60_000;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.documentElement;
  const toolItems = Array.from(document.querySelectorAll<HTMLElement>('li[data-module]'));
  const adminGroup = $('admin-group');
  const page = root.dataset.page ?? '';
  const whoWrap = $('who-wrap');
  const whoBtn = $<HTMLButtonElement>('who');
  const whoMenu = $('who-menu');
  const topbar = document.querySelector<HTMLElement>('.topbar')!;
  const collapseBtn = $<HTMLButtonElement>('collapse');
  const menuOpen = $<HTMLButtonElement>('menu-open');
  const menuClose = $<HTMLButtonElement>('menu-close');
  const scrim = $('scrim');
  const sidebar = $('staff-sidebar');

  // ---- what to show: the person's tools (cache keyed to this sign-in)
  const fingerprint = (token: string) => token.slice(-24);

  function readCache(token: string | null): { at: number; me: Me } | null {
    if (!token) return null;
    try {
      const saved = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? 'null');
      if (saved && saved.fp === fingerprint(token) && Date.now() - saved.at < MAX_AGE_MS) return { at: saved.at, me: saved.me };
    } catch {
      // treated as no cache
    }
    return null;
  }

  function writeCache(token: string, me: Me) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ fp: fingerprint(token), at: Date.now(), me }));
    } catch {
      // storage blocked: the menu just refetches each page
    }
  }

  function signOut() {
    clearToken();
    clearStepUp();
    try {
      sessionStorage.removeItem(CACHE_KEY);
    } catch {
      // nothing to clear
    }
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    location.reload(); // each page then shows its own sign-in panel
  }

  // ---- the signed-in user: a pill in the top bar that opens a small menu (like the member portal's)
  const whoOpen = () => !whoMenu.hidden;
  function setWho(open: boolean, returnFocus = false) {
    whoMenu.hidden = !open;
    whoBtn.setAttribute('aria-expanded', String(open));
    if (open) whoMenu.querySelector<HTMLElement>('button')?.focus();
    else if (returnFocus) whoBtn.focus();
  }

  // Appearance: follow the device (Auto), or pin Light or Dark. Remembered in this browser; the <head> script applies it early.
  const THEME_KEY = 'tvc-staff-theme';
  function currentTheme(): '' | 'light' | 'dark' {
    const t = root.getAttribute('data-theme');
    return t === 'light' || t === 'dark' ? t : '';
  }
  function setTheme(value: '' | 'light' | 'dark') {
    if (value) root.setAttribute('data-theme', value);
    else root.removeAttribute('data-theme');
    try {
      if (value) localStorage.setItem(THEME_KEY, value);
      else localStorage.removeItem(THEME_KEY);
    } catch {
      // not remembered
    }
  }
  function appearanceControl(): HTMLElement {
    const group = document.createElement('div');
    group.className = 'appearance';
    group.setAttribute('role', 'group');
    group.setAttribute('aria-label', 'Appearance');
    const options: ['' | 'light' | 'dark', string][] = [['', 'Auto'], ['light', 'Light'], ['dark', 'Dark']];
    const paint = () => group.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-pressed', String(options[i][0] === currentTheme())));
    for (const [value, label] of options) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.addEventListener('click', (ev) => {
        ev.stopPropagation(); // choosing an appearance keeps the menu open so the change can be seen
        setTheme(value);
        paint();
      });
      group.append(b);
    }
    paint();
    return group;
  }

  function renderWho(me: Me | null) {
    whoWrap.hidden = !me || !me.name;
    setWho(false);
    if (!me?.name) return;
    fillAvatar($('avatar'), me.name, me.picture);
    $('who-name').textContent = me.name;
    $('who-role').textContent = me.isSuperAdmin ? 'Super admin' : 'Admin';
    const items: HTMLElement[] = [];
    if (me.maskedEmail) {
      const signedIn = document.createElement('p');
      signedIn.textContent = `Signed in as ${me.maskedEmail}`;
      items.push(signedIn);
    }
    if (fullTourFor(page, me.isSuperAdmin).length) {
      const tour = document.createElement('button');
      tour.type = 'button';
      tour.textContent = page === 'home' ? 'Take the tour' : 'Take the tour of this page';
      tour.addEventListener('click', () => {
        setWho(false);
        startTour(fullTourFor(page, me.isSuperAdmin));
      });
      items.push(tour);
    }
    const jump = document.createElement('button');
    jump.type = 'button';
    jump.append('Go to a tool');
    const hint = document.createElement('kbd');
    hint.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K';
    jump.append(hint);
    jump.addEventListener('click', () => {
      setWho(false);
      openSwitcher();
    });
    items.push(jump);
    items.push(appearanceControl());
    const out = document.createElement('button');
    out.type = 'button';
    out.textContent = 'Sign out';
    out.addEventListener('click', signOut);
    items.push(out);
    whoMenu.replaceChildren(...items);
  }
  whoBtn.addEventListener('click', () => setWho(!whoOpen()));
  document.addEventListener('click', (ev) => {
    if (whoOpen() && !(ev.target as Element).closest('.who-wrap')) setWho(false);
  });
  window.addEventListener('scroll', () => topbar.classList.toggle('scrolled', window.scrollY > 4), { passive: true });

  // Offer this page's tour once, and only to someone who can actually see the page behind it.
  function canSeePage(me: Me): boolean {
    if (page === 'home') return true;
    if (page === 'access' || page === 'units' || page === 'security') return me.isSuperAdmin;
    return me.tools.some((t) => t.module === page);
  }

  function apply(me: Me | null) {
    for (const li of toolItems) li.hidden = li.dataset.current !== 'true' && !me?.tools.some((t) => t.module === li.dataset.module);
    adminGroup.hidden = adminGroup.dataset.current !== 'true' && !me?.isSuperAdmin;
    renderWho(me);
    const token = getToken();
    if (me && me.name && token && canSeePage(me)) offerTour({ page, isSuperAdmin: me.isSuperAdmin, email: decodeTokenEmail(token) });
  }

  let pollTimer: number | undefined;

  async function refresh() {
    const token = getToken();
    if (!token) {
      apply(null);
      startPolling();
      return;
    }
    const cached = readCache(token);
    if (cached) apply(cached.me);
    if (cached && Date.now() - cached.at < FRESH_MS) return;
    try {
      const { status, data } = await staffFetch('/api/staff-me');
      if (status === 200) {
        writeCache(token, data as Me);
        apply(data as Me);
      }
    } catch (err) {
      if (err instanceof StaffAuthError && err.kind === 'forbidden') apply({ name: null, isSuperAdmin: false, tools: [] });
      else apply(null); // signed out or the session ended: only Home, and wait for a new sign-in
      if (err instanceof StaffAuthError && err.kind === 'unauthorized') startPolling();
    }
  }

  // The pages sign people in themselves, so the menu notices a new sign-in by
  // checking storage; it stops as soon as it has an answer.
  function startPolling() {
    if (pollTimer !== undefined) return;
    pollTimer = window.setInterval(() => {
      if (!getToken()) return;
      window.clearInterval(pollTimer);
      pollTimer = undefined;
      refresh();
    }, 1000);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refresh();
  });

  // ---- collapse (desktop)
  function setCollapsed(collapsed: boolean) {
    root.setAttribute('data-nav', collapsed ? 'collapsed' : 'expanded');
    collapseBtn.setAttribute('aria-pressed', String(collapsed));
    const label = collapsed ? 'Expand the menu' : 'Collapse the menu';
    collapseBtn.setAttribute('aria-label', label);
    collapseBtn.title = label;
  }
  setCollapsed(root.getAttribute('data-nav') === 'collapsed');
  collapseBtn.addEventListener('click', () => {
    const next = root.getAttribute('data-nav') !== 'collapsed';
    setCollapsed(next);
    try {
      localStorage.setItem(COLLAPSE_KEY, next ? '1' : '0');
    } catch {
      // preference just isn't remembered
    }
  });

  // ---- slide-over menu (phones)
  function setMenu(open: boolean) {
    if (open) root.setAttribute('data-menu', 'open');
    else root.removeAttribute('data-menu');
    scrim.hidden = !open;
    menuOpen.setAttribute('aria-expanded', String(open));
    if (open) sidebar.querySelector<HTMLElement>('a[aria-current="page"], .menu a')?.focus();
    else menuOpen.focus();
  }
  menuOpen.addEventListener('click', () => setMenu(true));
  menuClose.addEventListener('click', () => setMenu(false));
  scrim.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    if (whoOpen()) setWho(false, true);
    else if (root.getAttribute('data-menu') === 'open') setMenu(false);
  });
  sidebar.addEventListener('click', (ev) => {
    if ((ev.target as HTMLElement).closest('.menu a') && root.getAttribute('data-menu') === 'open') setMenu(false);
  });

  // ---- go to a tool: Command or Ctrl plus K, from any page. It lists exactly the menu's links, so a tool
  // appears only if the person holds a role in it.
  const switcher = $('switcher') as HTMLDialogElement;
  const switcherInput = $('switcher-input') as HTMLInputElement;
  const switcherList = $('switcher-list');
  const switcherEmpty = $('switcher-empty');
  let switcherShown: { label: string; href: string }[] = [];
  let switcherActive = 0;

  function paintSwitcher() {
    const q = switcherInput.value.trim().toLowerCase();
    const all = [...document.querySelectorAll<HTMLAnchorElement>('.menu a')].map((a) => ({ label: a.querySelector('.label')?.textContent?.trim() ?? a.title, href: a.href }));
    switcherShown = all.filter((t) => t.label.toLowerCase().includes(q));
    switcherActive = Math.min(switcherActive, Math.max(0, switcherShown.length - 1));
    switcherList.replaceChildren(
      ...switcherShown.map((t, i) => {
        const li = document.createElement('li');
        li.id = `switcher-opt-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === switcherActive));
        li.textContent = t.label;
        li.addEventListener('click', () => (location.href = t.href));
        li.addEventListener('mousemove', () => {
          if (switcherActive === i) return;
          switcherActive = i;
          paintSwitcher();
        });
        return li;
      }),
    );
    switcherEmpty.hidden = switcherShown.length > 0;
    if (switcherShown.length) switcherInput.setAttribute('aria-activedescendant', `switcher-opt-${switcherActive}`);
    else switcherInput.removeAttribute('aria-activedescendant');
    switcherList.children[switcherActive]?.scrollIntoView({ block: 'nearest' });
  }

  function openSwitcher() {
    if (switcher.open) return;
    switcherInput.value = '';
    switcherActive = 0;
    paintSwitcher();
    switcher.showModal();
    switcherInput.focus();
  }

  switcherInput.addEventListener('input', () => {
    switcherActive = 0;
    paintSwitcher();
  });
  switcherInput.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
      ev.preventDefault();
      if (!switcherShown.length) return;
      switcherActive = (switcherActive + (ev.key === 'ArrowDown' ? 1 : -1) + switcherShown.length) % switcherShown.length;
      paintSwitcher();
    } else if (ev.key === 'Enter') {
      ev.preventDefault();
      const t = switcherShown[switcherActive];
      if (t) location.href = t.href;
    }
  });
  // a click on the dim area (the dialog element itself) closes it
  closeOnBackdrop(switcher);
  document.addEventListener('keydown', (ev) => {
    if ((ev.metaKey || ev.ctrlKey) && !ev.altKey && ev.key.toLowerCase() === 'k') {
      ev.preventDefault();
      if (document.querySelector('dialog[open]:not(#switcher)')) return; // a task sheet is open: finish that first
      if (switcher.open) switcher.close();
      else openSwitcher();
    }
  });

  // ---- arrow keys inside tabs and radio groups: Left/Right (or Up/Down) move and choose, Home/End jump
  document.addEventListener('keydown', (ev) => {
    if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(ev.key)) return;
    const current = (ev.target as Element).closest<HTMLElement>('[role="tab"], [role="radio"]');
    const group = current?.closest('[role="tablist"], [role="radiogroup"]');
    if (!current || !group) return;
    const options = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"], [role="radio"]')].filter((o) => !o.disabled && !o.hidden);
    const at = options.indexOf(current as HTMLButtonElement);
    if (at < 0) return;
    ev.preventDefault();
    const next = ev.key === 'Home' ? 0 : ev.key === 'End' ? options.length - 1 : (at + (ev.key === 'ArrowRight' || ev.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
    options[next].focus();
    options[next].click();
  });

  refresh();
</script>

<!-- The admin's look (neutral tokens, system type, the dark appearance) lives in styles/portal-look.css, shared
     with the member portal. This is the one rule that is admin-only: photos keep their own colours in dark. -->
<style is:global>
  html[data-theme='dark'] #staff-main img,
  html[data-theme='dark'] .brand img {
    color-scheme: normal;
  }

  /* The logo mark is a dark green disc: on the dark sidebar it needs a light ground to read, like an app icon. */
  @media (prefers-color-scheme: dark) {
    html:not([data-theme='light']) .brand img {
      padding: 2px;
      border-radius: 50%;
      background: var(--tvc-ink);
      box-sizing: border-box;
    }
  }

  html[data-theme='dark'] .brand img {
    padding: 2px;
    border-radius: 50%;
    background: var(--tvc-ink);
    box-sizing: border-box;
  }
</style>

<!-- The admin tour and the "What's new" card (scripts/lib/staff-tour-ui.mjs). Global because they are
