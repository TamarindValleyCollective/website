---
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import JsonLd from '../components/JsonLd.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import { FARM_AREA_ACRES } from '../data/site-facts';
import { LAT, LNG } from '../utils/weather';
import { useTranslations, stripLocalePrefix, SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from '../i18n/utils';
import { TRANSLATION_REVIEWED } from '../i18n/reviewStatus';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
  lang?: Locale;
  title: string;
  description?: string;
  image?: string;
  // The actual pixel dimensions of `image`. og:image:width/height must
  // match the real file — WhatsApp's link-preview crawler silently
  // discards the image and falls back to the apple-touch-icon when they
  // don't (the home hero is a 4204x1330 panorama, nowhere near a lazily
  // hardcoded 1200x630), which is why only the logo showed up there.
  imageWidth?: number;
  imageHeight?: number;
  // Extra JSON-LD objects (Event, Article, FAQPage, BreadcrumbList, ...) a
  // page contributes on top of the sitewide Organization/WebSite graph
  // below.
  schema?: Record<string, unknown>[];
  // Set on pages with nothing worth ranking on (404) so crawlers don't
  // index a dead end.
  noindex?: boolean;
  // False for the handful of pages that only ever exist in English (legal
  // boilerplate: Privacy, Terms, Refund Policy) - skips hreflang alternates
  // that would otherwise point at a /kn or /ta URL that 404s, and tells the
  // language switcher to land on that locale's homepage instead of a
  // nonexistent translated version of this same page.
  translated?: boolean;
}

const {
  lang = DEFAULT_LOCALE,
  title,
  description,
  image = '/images/pages/home/hero.jpg',
  imageWidth = 4204,
  imageHeight = 1330,
  schema = [],
  noindex = false,
  translated = true,
} = Astro.props;

const t = useTranslations(lang);
const pageDescription = description ?? t('jsonLd.orgDescription', { acres: FARM_AREA_ACRES });

const pageTitle = `${title} · Tamarind Valley Collective`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

// Only pages that exist in all 3 locales get hreflang alternates - the bare
// path re-prefixed per locale, no per-page translated-slug mapping needed.
const barePathname = stripLocalePrefix(Astro.url.pathname);
const alternateLinks = translated
  ? SUPPORTED_LOCALES.map((locale) => ({
      hreflang: locale,
      href: new URL(getRelativeLocaleUrl(locale, barePathname), Astro.site).toString(),
    }))
  : [];
const xDefaultHref = new URL(getRelativeLocaleUrl(DEFAULT_LOCALE, barePathname), Astro.site).toString();
const showTranslationNotice = lang !== DEFAULT_LOCALE && !TRANSLATION_REVIEWED[lang];

// Shared across every page so Google can resolve the same Organization
// entity everywhere (Event organizers, Article publishers, the knowledge
// panel) instead of re-describing it inconsistently per page.
const siteURL = new URL('/', Astro.site).toString();
const organizationId = `${siteURL}#organization`;
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Tamarind Valley Collective',
      url: siteURL,
      logo: new URL('/images/brand/tvc-logo-mark.png', Astro.site).toString(),
      description: t('jsonLd.orgDescription', { acres: FARM_AREA_ACRES }),
      telephone: '+91 74063 07309',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Thaggatti village',
        addressLocality: 'Kanakapura',
        addressRegion: 'Karnataka/Tamil Nadu border',
        addressCountry: 'IN',
      },
      // Same coordinates the weather widget uses (src/utils/weather.ts,
      // matching the farm's Google Business Profile pin exactly) - one
      // source of truth for the farm's location.
      geo: {
        '@type': 'GeoCoordinates',
        latitude: LAT,
        longitude: LNG,
      },
      priceRange: '₹1,200–₹5,950',
      sameAs: [
        'https://www.facebook.com/farm.tvc',
        'https://twitter.com/TVCFarm',
        'https://www.instagram.com/tamarindvalleycollective/',
        'https://www.google.com/maps?cid=12716822598495943685',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: 'Tamarind Valley Collective',
      publisher: { '@id': organizationId },
    },
  ],
};
---

<html lang={lang}>
  <head>
    <!-- charset must be within the first 1024 bytes of the document (the
         GA script/comment block below alone is over that), so it goes
         first, before anything else in <head>. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Fraunces is the --font-display face used by every page's hero
         heading/intro (usually the LCP element) - preloading it lets the
         browser fetch it before it discovers the font-face rule in the
         parsed CSS, instead of waiting on that discovery. -->
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Google Analytics (GA4) — consent-gated. Doesn't load until the visitor
         accepts the cookie banner (see CookieConsent.astro), skipped
         entirely on localhost so local/dev browsing never pollutes
         production traffic data. window.tvcAnalytics is the interface the
         banner calls into: .load() on Accept (or on return visits that
         already granted consent), .revoke() on Reject/withdrawal, using
         gtag's own documented `ga-disable-<id>` kill switch since a script
         already injected earlier in the session can't be un-injected. -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-795FTPB47P';
        if (/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) return;
        window['ga-disable-' + GA_ID] = true;

        function loadGA() {
          window['ga-disable-' + GA_ID] = false;
          if (window.gtag) return;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        }

        function revokeGA() {
          window['ga-disable-' + GA_ID] = true;
        }

        window.tvcAnalytics = { load: loadGA, revoke: revokeGA };
      })();
    </script>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {translated && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="ezmJ6GxRMbmhLA3xrXN6WJorNEEU6RyDHAoATSKrb58" />
    <title>{pageTitle}</title>

    <!-- Open Graph — WhatsApp, Facebook, Instagram, LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tamarind Valley Collective" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />

    <JsonLd items={[siteGraph, ...schema]} />
  </head>
  <body>
    <Nav lang={lang} translated={translated} />
    {showTranslationNotice && <TranslationNotice lang={lang} />}
    <Breadcrumbs pathname={Astro.url.pathname} pageTitle={title} lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <ChatWidget lang={lang} />
    <CookieConsent lang={lang} />
    <ScrollReveal />
  </body>
</html>
