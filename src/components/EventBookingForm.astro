---
// Reusable "pay online, for N people" booking form — any event opts in by
// setting `razorpayReferenceId` in its content file (see content.config.ts
// and EventDetailView.astro, which renders this in place of the inquiry-
// first BookingInquiry flow when that field is set). Submitting posts to
// netlify/functions/event-booking.mts, which creates a fresh per-booking
// Razorpay Payment Link for (unit price × attendee count) and returns its
// URL; this component redirects the browser there on success.
//
// English-only for now (unlike BookingInquiry, which is i18n'd) — this is
// the prototype of the flow; worth carrying over the kn/ta treatment once
// it's proven out on a real event.
interface Props {
  referenceId: string;
  unitAmount: string; // display only, e.g. "₹2,250" — the charged amount always comes from the base Payment Link server-side, never from this string
  unitLabel: string; // e.g. "per person"
  // yyyy-mm-dd, the event's own date at the moment this form renders —
  // carried through to event-booking.mts so the resulting booking row
  // remembers what date the guest actually paid against. Needed because the
  // /internal/event-payments refund-tier suggestion otherwise keys off the
  // event content file's *current* date, which drifts if the event gets
  // rescheduled after payments already came in (see event-payments.astro).
  eventDate: string;
  // Rendered as an <h2> above the form, same convention as
  // BookingInquiry.astro's own `heading` prop — the "book this" moment
  // should look and read the same way whichever of the two flows an event
  // uses.
  heading?: string;
}

const { referenceId, unitAmount, unitLabel, eventDate, heading } = Astro.props;
const fieldId = referenceId.replace(/[^a-z0-9]+/gi, '-');
const MAX_ATTENDEES = 10;
const counts = Array.from({ length: MAX_ATTENDEES }, (_, i) => i + 1);
---

<div class="booking-form">
  {heading && <h2 class="booking-form__heading">{heading}</h2>}
  <form class="event-booking-form card site-form" id={`${fieldId}-form`} data-reference-id={referenceId} data-unit-amount={unitAmount} data-event-date={eventDate}>
    <p class="form-honeypot" aria-hidden="true">
      <label>Leave this field blank <input name="botField" tabindex="-1" autocomplete="off" /></label>
    </p>
    <p class="form-required-note">All fields are required.</p>

    <div class="site-form-grid">
      <div>
        <label for={`${fieldId}-name`}>Name</label>
        <input id={`${fieldId}-name`} type="text" name="name" autocomplete="name" required />
      </div>
      <div>
        <label for={`${fieldId}-email`}>Email</label>
        <input id={`${fieldId}-email`} type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
      </div>
      <div>
        <label for={`${fieldId}-phone`}>Phone</label>
        <input id={`${fieldId}-phone`} type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" required />
      </div>
      <div>
        <label for={`${fieldId}-count`}>Number of people</label>
        <select id={`${fieldId}-count`} name="attendeeCount" required>
          {counts.map((n) => <option value={n} selected={n === 1}>{n}</option>)}
        </select>
      </div>
    </div>

    <div class="field-total">
      <span class="field-total__label">Total ({unitAmount} {unitLabel})</span>
      <span class="field-total__amount" id={`${fieldId}-total`}>{unitAmount}</span>
    </div>

    <button class="button" type="submit">Pay &amp; register →</button>
    <p class="booking-form__error" role="alert" hidden></p>
    <div class="booking-form__duplicate-warning" role="alert" hidden>
      <p class="booking-form__duplicate-text"></p>
      <button type="button" class="button booking-form__confirm-duplicate">Yes, book again</button>
    </div>
  </form>
</div>

<style>
  /* Same section-separator treatment as BookingInquiry.astro's
     .booking-inquiry — a "book this" moment should look and read the same
     way site-wide regardless of which of the two flows an event uses. */
  .booking-form {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--tvc-line);
  }

  .booking-form__heading {
    margin-top: 0;
  }

  .field-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--tvc-green-tint);
    margin-bottom: 16px;
  }

  .field-total__label {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .field-total__amount {
    font-weight: 700;
    font-size: 1.15rem;
  }

  .booking-form__error {
    color: #a3312a;
    font-size: 0.9rem;
    margin-top: 12px;
  }

  .booking-form__duplicate-warning {
    margin-top: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--tvc-orange-tint);
  }

  .booking-form__duplicate-text {
    margin: 0 0 10px;
    font-size: 0.88rem;
    color: var(--tvc-orange-text);
  }
</style>

<script>
  // Same-device convenience only, no server lookup - a returning visitor on
  // the same browser gets name/email/phone prefilled from their last
  // successful booking (any event, since this form is reused across all of
  // them). Deliberately not a cross-device "existing customer" lookup by
  // phone/email, which would need to be gated behind proof of ownership
  // (e.g. a WhatsApp-delivered code) to avoid becoming a PII-enumeration
  // endpoint - out of scope for this simple prefill.
  const CONTACT_STORAGE_KEY = 'tvc-booking-contact';

  interface SavedContact {
    name: string;
    email: string;
    phone: string;
  }

  function loadSavedContact(): SavedContact | null {
    try {
      const raw = localStorage.getItem(CONTACT_STORAGE_KEY);
      return raw ? (JSON.parse(raw) as SavedContact) : null;
    } catch {
      return null; // private browsing, blocked storage, corrupt value, etc.
    }
  }

  function saveContact(contact: SavedContact) {
    try {
      localStorage.setItem(CONTACT_STORAGE_KEY, JSON.stringify(contact));
    } catch {
      // Same as above - a failed save just means no prefill next time.
    }
  }

  function toIntOrNull(s: string): number | null {
    const cleaned = s.replace(/[^\d]/g, '');
    return cleaned ? Number.parseInt(cleaned, 10) : null;
  }

  document.querySelectorAll<HTMLFormElement>('.event-booking-form').forEach((form) => {
    const referenceId = form.dataset.referenceId ?? '';
    const eventDate = form.dataset.eventDate ?? '';
    const unitAmount = toIntOrNull(form.dataset.unitAmount ?? '');
    const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]');
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');
    const countSelect = form.querySelector<HTMLSelectElement>('select[name="attendeeCount"]');
    const totalEl = form.querySelector<HTMLElement>('.field-total__amount');
    const errorEl = form.querySelector<HTMLElement>('.booking-form__error');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const duplicateWarningEl = form.querySelector<HTMLElement>('.booking-form__duplicate-warning');
    const duplicateTextEl = form.querySelector<HTMLElement>('.booking-form__duplicate-text');
    const confirmDuplicateBtn = form.querySelector<HTMLButtonElement>('.booking-form__confirm-duplicate');

    const saved = loadSavedContact();
    if (saved) {
      if (nameInput && !nameInput.value) nameInput.value = saved.name;
      if (emailInput && !emailInput.value) emailInput.value = saved.email;
      if (phoneInput && !phoneInput.value) phoneInput.value = saved.phone;
    }

    function updateTotal() {
      if (!countSelect || !totalEl || unitAmount === null) return;
      const count = Number(countSelect.value) || 1;
      totalEl.textContent = `₹${(unitAmount * count).toLocaleString('en-IN')}`;
    }
    countSelect?.addEventListener('change', updateTotal);
    updateTotal();

    // Two-step when the server reports this email already has a paid
    // booking for this event (see event-booking.mts's countActivePaymentsForEmail
    // check): not a hard block, since a second booking can be legitimate
    // (e.g. paying for a separate group under the same email), but the
    // guest gets a chance to notice before paying twice by mistake. The
    // confirm button re-sends the same submitted values with
    // confirmDuplicate: true, which skips the check server-side.
    async function attemptBooking(data: FormData, confirmDuplicate: boolean) {
      if (errorEl) errorEl.hidden = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Starting payment…';
      }

      try {
        const res = await fetch('/api/event-booking', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            referenceId,
            eventDate,
            name: data.get('name'),
            email: data.get('email'),
            phone: data.get('phone'),
            attendeeCount: Number(data.get('attendeeCount')),
            confirmDuplicate,
          }),
        });
        const json = await res.json();

        if (res.ok && json.duplicateWarning) {
          if (duplicateWarningEl && duplicateTextEl) {
            duplicateTextEl.textContent = `Heads up: this email already has ${json.existingCount === 1 ? 'a paid booking' : `${json.existingCount} paid bookings`} for this event. If that's intentional (e.g. booking for another group), confirm below to continue.`;
            duplicateWarningEl.hidden = false;
          }
          if (confirmDuplicateBtn) confirmDuplicateBtn.onclick = () => attemptBooking(data, true);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Pay & register →';
          }
          return;
        }

        if (!res.ok || !json.url) throw new Error(json.error || 'Something went wrong');
        saveContact({
          name: String(data.get('name') ?? ''),
          email: String(data.get('email') ?? ''),
          phone: String(data.get('phone') ?? ''),
        });
        window.location.href = json.url;
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong — try again.';
          errorEl.hidden = false;
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Pay & register →';
        }
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (duplicateWarningEl) duplicateWarningEl.hidden = true;

      const data = new FormData(form);
      if (data.get('botField')) return; // silently drop, matches server-side honeypot

      attemptBooking(data, false);
    });
  });
</script>
