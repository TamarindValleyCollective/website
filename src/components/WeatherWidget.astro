---
// Live current-conditions fetched client-side from Open-Meteo (no API key,
// free for this volume of use) -- same farm coordinates already used
// elsewhere in the codebase for the biodiversity map's default view.
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<div class="weather-widget" id="weather-widget" hidden data-fmt-humidity={t('weather.humidityFormat')} data-fmt-as-of={t('weather.asOf')} data-fmt-sunset={t('weather.sunsetFormat')} data-elevation-label={t('weather.elevationLabel')}>
  <p class="weather-widget__location">Tamarind Valley Collective</p>
  <div class="weather-widget__row">
    <div class="weather-widget__temp">
      <span id="weather-icon" class="weather-widget__icon" aria-hidden="true"></span>
      <span id="weather-temp" class="weather-widget__value"></span>
    </div>
    <div class="weather-widget__details">
      <p id="weather-condition" class="weather-widget__condition"></p>
      <p id="weather-humidity" class="weather-widget__humidity"></p>
    </div>
  </div>
  <div class="weather-widget__extra">
    <p id="weather-elevation" class="weather-widget__extra-item"></p>
    <p id="weather-sunset" class="weather-widget__extra-item"></p>
  </div>
  <p id="weather-updated" class="weather-widget__updated"></p>
</div>

<style>
  .weather-widget {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 16px 22px;
    max-width: 360px;
    margin: 20px 0;
  }

  .weather-widget[hidden] {
    display: none;
  }

  .weather-widget__location {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tvc-ink-soft);
  }

  .weather-widget__row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .weather-widget__temp {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .weather-widget__icon {
    font-size: 2rem;
    line-height: 1;
  }

  .weather-widget__value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--tvc-green-dark);
    line-height: 1;
  }

  .weather-widget__details {
    min-width: 0;
  }

  .weather-widget__condition {
    margin: 0;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--tvc-ink);
  }

  .weather-widget__humidity {
    margin: 2px 0 0;
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .weather-widget__updated {
    margin: 0;
    font-size: 0.75rem;
    color: var(--tvc-ink-soft);
  }

  .weather-widget__extra {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 10px;
    border-top: 1px solid var(--tvc-line);
  }

  .weather-widget__extra-item {
    margin: 0;
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }
</style>

<script>
  import { fetchWeather, formatFarmTime, iconFor, labelFor } from '../utils/weather';

  (async () => {
    const widget = document.getElementById('weather-widget')!;
    const lang = (widget.closest('html')?.lang || 'en') as 'en' | 'kn' | 'ta';
    try {
      const data = await fetchWeather();
      document.getElementById('weather-icon')!.textContent = iconFor(data.weather_code);
      document.getElementById('weather-temp')!.textContent = `${Math.round(data.temperature_2m)}°C`;
      document.getElementById('weather-condition')!.textContent = labelFor(data.weather_code, lang);
      document.getElementById('weather-humidity')!.textContent = (widget.dataset.fmtHumidity ?? '{pct}% humidity').replace('{pct}', String(Math.round(data.relative_humidity_2m)));
      document.getElementById('weather-elevation')!.textContent = `${widget.dataset.elevationLabel ?? 'Elevation'}: ${Math.round(data.elevation)}m`;
      document.getElementById('weather-sunset')!.textContent = (widget.dataset.fmtSunset ?? 'Sunset today {time}').replace('{time}', formatFarmTime(data.sunset));
      document.getElementById('weather-updated')!.textContent = (widget.dataset.fmtAsOf ?? 'As of {time}').replace('{time}', formatFarmTime(data.time));
      widget.hidden = false;
    } catch (err) {
      console.warn('Could not load live weather', err);
    }
  })();
</script>
