---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { FARM_AREA_ACRES } from '../data/site-facts';
import { MEMBER_FAMILY_COUNT } from '../data/members';
import { DEFAULT_LOCALE, type Locale } from '../i18n/utils';
import { fetchSpeciesCountFresh } from './biodiversity/species-count';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const YEARS_REGENERATING = new Date().getFullYear() - 2017;

// Baked into the static HTML at build time (this runs in Node during
// `astro build`, once per locale) so every visitor sees a real species
// count on first paint -- not just ones with a warm browser cache from an
// earlier visit. Previously this tile only ever got a number client-side,
// deferred until after `window.load` to keep the ~470KB iNaturalist fetch
// off the critical path; that's still true for freshness (the script below
// still fetches live and corrects this number if it's changed since the
// last deploy), but the *first* number a visitor sees no longer waits on
// any of that. Falls back to null (renders "—", same as before) if the
// build-time fetch fails -- a flaky external API must never fail the build.
let speciesCount: number | null = null;
try {
  speciesCount = await fetchSpeciesCountFresh();
} catch (err) {
  console.warn('Could not fetch iNaturalist species count at build time:', err);
}

// Only four short labels here (no shared i18n key for them yet) - kept as a
// local dictionary rather than touching src/i18n/*.ts, per this pass's
// constraints.
const labels = {
  // species is "All species" not "Species" - same reason as
  // BiodiversityExplorer's statSpecies: this tile's live count spans every
  // iNaturalist taxon, not just birds, and this tile links straight to the
  // Biodiversity page whose hero leads with "over 100 bird species".
  en: { acres: 'Acres', years: 'Years', families: 'Families', species: 'All species' },
  kn: { acres: 'ಎಕರೆಗಳು', years: 'ವರ್ಷಗಳು', families: 'ಕುಟುಂಬಗಳು', species: 'ಎಲ್ಲಾ ಪ್ರಭೇದಗಳು' },
  ta: { acres: 'ஏக்கர்கள்', years: 'ஆண்டுகள்', families: 'குடும்பங்கள்', species: 'அனைத்து இனங்களும்' },
} as const;

const l = labels[lang];

const peopleHref = getRelativeLocaleUrl(lang, '/people/members');
---

<section class="home-stats" id="home-stats">
  <div class="wrapper home-stats__grid">
    <a class="home-stat" href={getRelativeLocaleUrl(lang, '/about')}>
      <p class="home-stat__value" data-count-to={FARM_AREA_ACRES}>0</p>
      <p class="home-stat__label">{l.acres}</p>
    </a>
    <a class="home-stat" href={getRelativeLocaleUrl(lang, '/our-journey')}>
      <p class="home-stat__value" data-count-to={YEARS_REGENERATING}>0</p>
      <p class="home-stat__label">{l.years}</p>
    </a>
    <a class="home-stat" href={peopleHref}>
      <p class="home-stat__value" data-count-to={MEMBER_FAMILY_COUNT}>0</p>
      <p class="home-stat__label">{l.families}</p>
    </a>
    <a class="home-stat" href={getRelativeLocaleUrl(lang, '/ecosystem/biodiversity')}>
      <p class="home-stat__value" id="home-stat-species" data-count-to={speciesCount ?? undefined}>{speciesCount != null ? '0' : '—'}</p>
      <p class="home-stat__label">{l.species}</p>
    </a>
  </div>
</section>

<style>
  /* Overlaid on the hero image (a positioned ancestor — see .hero in
     index.astro) rather than sitting in normal flow below it. */
  .home-stats {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding-bottom: clamp(20px, 4vw, 40px);
  }

  .home-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    /* Reserves clearance for the fixed chat bubble (ChatWidget.astro:
       58px circle, offset clamp(14px, 3vw, 28px) from the corner) so the
       last tile's text never sits underneath it — this bar can end up
       right at the bottom of the viewport on first load since it's
       pinned to the hero, unlike the old in-flow section further down
       the page where that corner was already scrolled past. */
    padding-right: clamp(84px, 9vw, 100px);
  }

  /* Apple's "material" look (Control Center, Big Sur widgets): a heavily
     blurred, saturation-boosted glass pane over the hero image, not a flat
     translucent tint — the saturate() is what keeps it from reading as
     plain frosted plastic. The inset highlight is what sells "glass" over
     "frosted plastic": a bright sliver along the top edge as if catching
     light, fading immediately, the way a real beveled pane would. */
  .home-stat {
    position: relative;
    display: block;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 18px 12px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.32);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.18),
      inset 0 1px 1px rgba(255, 255, 255, 0.5),
      inset 0 0 24px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: transform 0.18s ease, background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  /* A much bolder hover state than a plain glass tint shift — against a
     busy, variably-bright photo, a subtle change is easy to miss (this is
     what prompted the redo: cursor:pointer alone wasn't enough of a
     signal). The orange border matches the site's existing hover
     convention for clickable cards (see .explore-card / .rung). */
  .home-stat:hover,
  .home-stat:focus-visible {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.3);
    border-color: var(--tvc-orange);
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.28),
      inset 0 1px 1px rgba(255, 255, 255, 0.6),
      inset 0 0 24px rgba(255, 255, 255, 0.08);
  }

  .home-stat__value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .home-stat__label {
    margin: 6px 0 0;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.82);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .home-stats {
      padding-bottom: 16px;
    }

    .home-stats__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      /* Symmetric clearance instead of the desktop right-only reserve
         above — one-sided padding here left the 2-column grid visibly
         off-centre. Still enough on the right to clear the chat bubble
         (58px circle + up to 28px offset, per the comment above) at
         mobile's smaller clamp values. */
      padding-left: 76px;
      padding-right: 76px;
    }

    .home-stat {
      padding: 14px 10px;
      border-radius: 12px;
    }
  }
</style>

<script>
  // No top-level `import` in this file, on purpose -- see the comment above
  // refreshSpeciesCount() below for why.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateValue(el: HTMLElement, to: number, duration = 1200) {
    if (reduceMotion) {
      el.textContent = String(to);
      return;
    }
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(to * eased));
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const section = document.getElementById('home-stats')!;
  const speciesEl = document.getElementById('home-stat-species')!;
  let played = false;

  speciesEl.dataset.value = speciesEl.dataset.countTo ?? '';

  function playEntrance() {
    if (played) return;
    played = true;
    // Queried fresh here (not a snapshot taken earlier) so that if
    // refreshSpeciesCount() below sets data-count-to on speciesEl right
    // before this fires, it's swept up in the same pass as the other
    // three tiles rather than requiring its own separate animation call.
    for (const el of section.querySelectorAll<HTMLElement>('[data-count-to]')) {
      animateValue(el, Number(el.dataset.countTo));
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) playEntrance();
    },
    { threshold: 0.4 }
  );
  observer.observe(section);

  // Confirms/corrects the build-time-baked number against live data --
  // observations logged since the last deploy wouldn't be reflected in it
  // yet -- or, if that build-time fetch failed, provides the number at all
  // (seeded from cache first, then a live fetch). Reuses
  // BiodiversityExplorer's own cached-observations data/TTL and the same
  // taxon + boundary filtering it uses, so this count can't drift from what
  // /ecosystem itself shows (see species-count.ts).
  //
  // The species-count import lives inside this function, as a dynamic
  // import(), rather than at the top of the file -- a static top-level
  // import here would force the browser to fetch and parse that module's
  // whole dependency chain before ANY code in this module could run,
  // IntersectionObserver setup above included, since ES modules resolve
  // their full static import graph before executing a single line. On a
  // slow/high-latency connection that's a multi-second sequential waterfall
  // (each hop is its own round trip) -- confirmed via a real-device
  // recording where all four stat tiles sat frozen at "0" for several
  // seconds past first paint, unblocking only once that chain finished.
  // This function already only ever runs deferred (after `load`), so
  // pulling the import in dynamically here costs nothing on that path and
  // keeps it off the one that matters. species-count.ts is also
  // deliberately its own module rather than living in observation-utils.ts
  // (which BiodiversityExplorer.astro statically imports alongside
  // Leaflet) -- sharing that file would have re-coupled this dynamic
  // import to Leaflet's ~165KB, which was confirmed happening (and is
  // exactly the kind of regression this comment exists to stop someone
  // from quietly reintroducing).
  async function refreshSpeciesCount() {
    const { fetchSpeciesCount, getCachedSpeciesCount, setCachedSpeciesCount } = await import('./biodiversity/species-count');

    // Only matters if the build-time bake (see this file's frontmatter)
    // failed -- seed from whatever the last successful fetch (this page or
    // /ecosystem/biodiversity) left behind, so a repeat visitor isn't
    // stuck on "—" while the live fetch below is in flight.
    if (!speciesEl.dataset.value) {
      const cached = getCachedSpeciesCount();
      if (cached != null) {
        speciesEl.dataset.value = String(cached);
        if (played) speciesEl.textContent = String(cached);
        else speciesEl.dataset.countTo = String(cached);
      }
    }

    try {
      const speciesCount = await fetchSpeciesCount();
      const priorValue = speciesEl.dataset.value;
      speciesEl.dataset.value = String(speciesCount);
      setCachedSpeciesCount(speciesCount);
      if (priorValue === String(speciesCount)) return;
      if (played) {
        // Already shown (build-time number, cached number, or a plain
        // "—" that never got a count-to at all) -- correct it quietly, no
        // second count-up flourish over a number the visitor may already
        // have read.
        speciesEl.textContent = String(speciesCount);
      } else {
        // Entrance hasn't fired yet -- keep data-count-to in sync so
        // playEntrance(), whenever it does fire, animates straight to the
        // freshest number instead of a stale build-time/cached one.
        speciesEl.dataset.countTo = String(speciesCount);
      }
    } catch {
      // Live count is a nice-to-have -- if iNaturalist is unreachable and
      // nothing else has put a number on screen, fall back to a plain
      // label rather than leaving a stuck "—".
      if (!speciesEl.dataset.value) speciesEl.textContent = '100+';
    }
  }

  // This uncached request (first visit) runs ~470KB through iNaturalist's API
  // -- deferred past `load` so it doesn't compete with the hero video/images
  // for bandwidth during the page's critical initial-paint window. A repeat
  // visit within the 10-minute cache window resolves instantly regardless.
  if (document.readyState === 'complete') {
    refreshSpeciesCount();
  } else {
    window.addEventListener('load', refreshSpeciesCount, { once: true });
  }
</script>
