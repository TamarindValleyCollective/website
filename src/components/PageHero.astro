---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, intro, image, imageAlt = '' } = Astro.props;
---

{image ? (
  <>
    <div class="hero-bg">
      <img class="hero-bg__image" src={image} alt={imageAlt} />
      <div class="hero-bg__scrim"></div>
    </div>
    <section class="hero hero--image">
      <div class="wrapper hero__content">
        {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
        <h1>{title}</h1>
        {intro && <p class="hero__intro">{intro}</p>}
      </div>
    </section>
  </>
) : (
  <section class="hero hero--plain">
    <div class="wrapper hero__content">
      {eyebrow && (
        <p class="eyebrow">
          {eyebrow}
          <span class="eyebrow__rule" aria-hidden="true"></span>
        </p>
      )}
      <h1>{title}</h1>
      {intro && <p class="hero__intro hero__intro--dark">{intro}</p>}
    </div>
  </section>
)}

<style>
  /* Pinned behind the whole page (fixed, z-index below everything) rather
     than living inside .hero--image's own box, so the photo doesn't simply
     scroll away with the hero the way normal in-flow content does — it
     stays put and fades out over the first stretch of scroll instead, the
     same technique (and the same reason) as the homepage's own hero — see
     the script at the bottom of this file. Tried an un-faded, hard-cut
     version first: it either bled through the page's own content (a plain
     .section has no background of its own — see global.css) or, once made
     tall enough to avoid that, left the hero's own white-on-photo text
     needing a full extra viewport of "just image" beneath it before a safe
     cutoff point, pushing real content much further down every page. The
     fade sidesteps both — by the time it completes, the hero's own (short)
     box has long since scrolled out of view. */
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-bg__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: opacity;
  }

  .hero-bg__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 26, 18, 0.15) 0%, rgba(15, 26, 18, 0.75) 100%);
    will-change: opacity;
  }

  .hero--image {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
  }

  .hero__content {
    /* Without an explicit width, a flex item shrinks to fit its content
       *before* `margin: 0 auto` centers it — so a short heading would
       center as a narrow box instead of sitting flush at the same left
       edge every other .wrapper on the site uses. width:100% forces it to
       fill the flex container first, so the max-width/auto-margin centering
       behaves exactly like normal block-flow .wrapper usage everywhere else. */
    width: 100%;
    /* .hero--image is display:flex, and flex items default to
       min-width:auto - a floor at their content's intrinsic min-content
       width that doesn't respect a heading's own overflow-wrap:break-word.
       Without this, a long unbroken word forces this box (and so the page)
       wider than the viewport instead of wrapping - confirmed on
       HomeView.astro's own hero (same pattern) with both a Kannada compound
       word and an English word of equal width. Same fix as .nav__left /
       .whats-next__text elsewhere in the codebase. */
    min-width: 0;
    position: relative;
    padding-top: 60px;
    padding-bottom: 48px;
  }

  /* Pages without a photo (Ecosystem, About, Visit...) had nothing to give
     the header visual weight, so it read as an unstyled void bleeding into
     the section below on the same cream background. The tint band + rule
     borrow the accent already used for section--tint elsewhere, giving the
     hero its own presence without introducing a new color. */
  .hero--plain {
    background: var(--tvc-green-tint);
    border-bottom: 1px solid var(--tvc-line);
  }

  .hero--plain .hero__content {
    padding-top: 88px;
    padding-bottom: 56px;
  }

  .hero--image h1 {
    color: #fff;
    max-width: 20ch;
  }

  .hero--plain h1 {
    max-width: 22ch;
  }

  .eyebrow--light {
    color: #ffd8a8;
  }

  .eyebrow__rule {
    display: block;
    width: 40px;
    height: 3px;
    margin-top: 14px;
    background: var(--tvc-orange);
    border-radius: 2px;
  }

  .hero__intro {
    font-size: 1.15rem;
    color: #eef2ea;
    max-width: 62ch;
    margin-top: 10px;
  }

  .hero__intro--dark {
    color: var(--tvc-ink-soft);
  }

  @media (max-width: 640px) {
    .hero--image {
      min-height: 320px;
    }

    .hero--plain .hero__content {
      padding-top: 56px;
      padding-bottom: 40px;
    }
  }
</style>

<script>
  // Fades the fixed background image+scrim out over the first stretch of
  // scroll, identical to the homepage's own hero (see index.astro) — kept
  // as a separate copy here rather than a shared import since Astro
  // components can't share a <script> across files without a bundled
  // module, and this is only ~20 lines.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const imageEl = document.querySelector('.hero-bg__image') as HTMLElement | null;
  const scrimEl = document.querySelector('.hero-bg__scrim') as HTMLElement | null;

  function ease(t: number): number {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  if (imageEl && scrimEl && !reduceMotion) {
    let ticking = false;

    function update() {
      ticking = false;
      const fadeDistance = window.innerHeight;
      const progress = Math.min(Math.max(window.scrollY / fadeDistance, 0), 1);
      const opacity = String(1 - ease(progress));
      imageEl!.style.opacity = opacity;
      scrimEl!.style.opacity = opacity;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    // Skip the initial call when already at the top of the page: opacity is
    // already 1 there by default CSS, so writing style.opacity = '1' would
    // be a no-op visually - but it's an inline-style mutation on the page's
    // own LCP element, and doing it here means the browser doesn't count
    // that write as a delayed repaint of the largest contentful element
    // (only triggers for the rarer case of loading already scrolled, e.g.
    // scroll-restoring back/forward navigation or a mid-page #anchor link).
    if (window.scrollY > 0) update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
