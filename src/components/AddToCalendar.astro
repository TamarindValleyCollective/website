---
import type { Locale } from '../i18n/utils';

interface Props {
  googleUrl: string;
  icsHref: string;
  icsFilename: string;
  lang?: Locale;
}

const { googleUrl, icsHref, icsFilename, lang = 'en' } = Astro.props;

// Only used from src/components/views/EventDetailView.astro, so a small
// local dict here (rather than an i18n/*.ts entry) is enough - kept next to
// the three strings it covers instead of adding cross-file indirection.
const text: Record<Locale, { toggle: string; google: string; ics: string }> = {
  en: { toggle: 'Add to calendar', google: 'Google Calendar', ics: 'Apple / Outlook (.ics)' },
  kn: { toggle: 'ಕ್ಯಾಲೆಂಡರ್‌ಗೆ ಸೇರಿಸಿ', google: 'ಗೂಗಲ್ ಕ್ಯಾಲೆಂಡರ್', ics: 'ಆಪಲ್ / ಔಟ್‌ಲುಕ್ (.ics)' },
  ta: { toggle: 'கேலெண்டரில் சேர்க்கவும்', google: 'Google Calendar', ics: 'Apple / Outlook (.ics)' },
};
const t = text[lang];
---

<div class="add-to-cal">
  <button type="button" class="button button--outline add-to-cal__toggle" aria-haspopup="true" aria-expanded="false">
    <svg class="add-to-cal__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    {t.toggle}
    <svg class="add-to-cal__chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div class="add-to-cal__menu" hidden>
    <a href={googleUrl} target="_blank" rel="noopener noreferrer">
      <svg class="add-to-cal__menu-icon" aria-hidden="true" viewBox="0 0 18 18">
        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"></path>
        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"></path>
        <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"></path>
        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"></path>
      </svg>
      {t.google}
    </a>
    <a href={icsHref} download={icsFilename}>
      <svg class="add-to-cal__menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
        <path d="M12 13.5v4M10 15.5l2 2 2-2"></path>
      </svg>
      {t.ics}
    </a>
  </div>
</div>

<style>
  .add-to-cal {
    position: relative;
    display: inline-block;
  }

  .add-to-cal__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .add-to-cal__chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .add-to-cal__toggle[aria-expanded='true'] .add-to-cal__chevron {
    transform: rotate(180deg);
  }

  .add-to-cal__menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 10;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 6px;
    min-width: 200px;
    display: flex;
    flex-direction: column;
  }

  .add-to-cal__menu[hidden] {
    display: none;
  }

  .add-to-cal__menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    color: var(--tvc-ink);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .add-to-cal__menu-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .add-to-cal__menu a:hover {
    background: var(--tvc-green-tint);
    color: var(--tvc-green);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.add-to-cal').forEach((widget) => {
    const toggle = widget.querySelector<HTMLButtonElement>('.add-to-cal__toggle')!;
    const menu = widget.querySelector<HTMLElement>('.add-to-cal__menu')!;

    function close() {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
    });

    document.addEventListener('click', (e) => {
      if (!widget.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
