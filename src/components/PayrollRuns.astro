  });

  const reloadRun = async () => {
    await load(openId ?? undefined);
  };

  function renderRun(d: Detail) {
    const me = data!.me;
    const box = $('run');
    box.replaceChildren();
    const r = d.run;
    const head = el('div', 'pr-head');
    head.append(el('h2', undefined, runTitle(r)), pill(r.status));
    box.append(head, el('p', 'hint', `Pay on ${dayName(r.paymentDate)} · ${r.paymentMode === 'I' ? 'mode I' : 'NEFT'}`));
    if (r.next) box.append(el('p', 'pr-next', r.next));
    if (r.cancelledReason) box.append(el('p', 'hint', `Cancelled: ${r.cancelledReason}`));
    if (r.stale) box.append(el('p', 'pr-warn', `The payment date (${dayName(r.paymentDate)}) has passed, so the bank will reject this file. Regenerate it with a new date.`));
    if (d.changed) box.append(el('p', 'pr-warn', `${d.changed} ${d.changed === 1 ? 'person has' : 'people have'} a different bank account from the last run. Check each one marked "account changed" before going on.`));
    if (d.problems) box.append(el('p', 'pr-warn', `${d.problems} ${d.problems === 1 ? 'person has' : 'people have'} a bank account that cannot be paid (not verified, retired or missing). The file cannot be made until it is fixed on the Parties page.`));

    const editable = r.status === 'draft' && me.canEnter;
    const list = el('div', 'pr-lines');
    for (const l of d.lines) {
      const row = el('div', `pr-line${l.problem ? ' pr-line--bad' : ''}`);
      const who = el('div', 'pr-who');
      who.append(el('strong', undefined, l.name));
      const sub = el('span', 'pr-sub', l.last4 ? `Account ending ${l.last4}` : 'No bank account on file');
      who.append(sub);
      if (l.changed) who.append(el('span', 'pill pill--warn', 'account changed'));
      if (l.problem) who.append(el('span', 'pill pill--crit', 'account cannot be paid'));
      if (l.reference) who.append(el('span', 'pr-sub', l.reference));
      row.append(who);
      if (editable) {
        const input = el('input');
        input.inputMode = 'numeric';
        input.autocomplete = 'off';
        input.value = String(l.netPaise / 100);
        input.dataset.employee = l.employeeId;
        input.setAttribute('aria-label', `Net pay for ${l.name}, in rupees`);
        row.append(input);
      } else {
        row.append(el('span', 'amt pr-amt', rupees(l.netPaise)));
      }
      list.append(row);
    }
    box.append(list);
    const total = el('div', 'pr-total');
    total.append(el('span', undefined, `${d.lines.length} ${d.lines.length === 1 ? 'person' : 'people'}`), el('strong', 'amt', rupees(d.totalPaise)));
    box.append(total);

    const acts = el('div', 'pr-actions');
    const act = (action: string, extra: Record<string, unknown> = {}, done = 'Done.') => async () => {
      if (await call(`/api/finance-admin/payroll/runs/${r.id}/action`, 'POST', { action, ...extra }, done)) await reloadRun();
    };
    if (r.status === 'draft' && me.canEnter) {
      acts.append(
        btn('Save changes', async () => {
          const amounts = readAmounts(list);
          if ('error' in amounts) return void showToast(amounts.error);
          if (await call(`/api/finance-admin/payroll/runs/${r.id}`, 'PUT', { lines: amounts.lines }, 'Saved.')) await reloadRun();
        }),
        btn('Confirm these amounts', act('confirm', {}, 'Confirmed.'), 'button button--primary'),
      );
    }
    if (r.status === 'confirmed') {
      if (me.canEnter) acts.append(btn('Change the amounts', act('reopen', {}, 'Reopened.')));
      if (me.canPrepare) {
        const date = el('input');
        date.type = 'date';
        date.min = data!.today;
        date.value = r.paymentDate < data!.today ? data!.today : r.paymentDate;
        date.setAttribute('aria-label', 'Payment date');
        acts.append(
          date,
          btn('Make the bank file', async () => {
            if (await call(`/api/finance-admin/payroll/runs/${r.id}/action`, 'POST', { action: 'generate', paymentDate: date.value }, 'File made.')) await reloadRun();
          }, 'button button--primary'),
        );
      }
    }
    if (r.status === 'file_generated') {
      if (me.canPrepare) {
        acts.append(btn('Download the file', async () => {
          try {
            const res = await fetch(`/api/finance-admin/payroll/runs/${r.id}/file`, { headers: { authorization: `Bearer ${getToken() ?? ''}`, ...(getStepUp() ? { 'x-stepup-token': getStepUp() as string } : {}) } });
            if (res.status === 403) return void (showToast('Unlock first.'), lock.open());
            if (!res.ok) return void showToast('Could not download the file.');
            const url = URL.createObjectURL(await res.blob());
            const a = el('a');
            a.href = url;
            a.download = `salary-${r.month}.xlsx`;
            a.click();
            URL.revokeObjectURL(url);
          } catch {
            showToast('Could not download the file.');
          }
        }));
        if (r.batch?.status === 'file_generated') acts.append(btn('I uploaded it to the bank', act('mark_uploaded', {}, 'Marked as uploaded.'), 'button button--primary'));
        acts.append(btn('Make a new file', async () => {
          if (confirm('Make a new bank file? The old file will no longer be valid.')) await act('regenerate', {}, 'Ready for a new file.')();
        }));
      }
      if (me.canApprove && !r.preparedByMe && r.batch?.status === 'uploaded') acts.append(btn('Approve (after approving in the bank)', act('approve', {}, 'Approved.'), 'button button--primary'));
      if (me.canApprove && r.preparedByMe) acts.append(el('p', 'hint', 'You made this file, so another director approves it.'));
    }
    if (['draft', 'confirmed', 'file_generated'].includes(r.status) && (me.canEnter || me.canPrepare)) {
      acts.append(btn('Cancel this month', async () => {
        const reason = prompt('Why is this month being cancelled?');
        if (reason) await act('cancel', { reason }, 'Cancelled.')();
      }, 'button button--outline pr-danger'));
    }
    box.append(acts);
    renderEvidence(box, r);
    lock.render();
  }

  // The bank's confirmation: a screenshot of the portal's page for the uploaded batch. The preparer attaches it; all three payroll roles can see it.
  // The files need the token, so each is fetched and shown from a local object URL, never linked.
  function renderEvidence(box: HTMLElement, r: Detail['run']) {
    if (!r.batch || !['file_generated', 'approved', 'settled'].includes(r.status) || r.batch.status === 'file_generated') return;
    const me = data!.me;
    const section = el('div', 'pr-evidence');
    section.append(el('h3', 'pr-section-title', "The bank's confirmation"));
    const note = el('p', 'hint', me.canPrepare ? 'Attach a screenshot of the batch as the bank shows it after you upload. It is the proof from the bank, and what the farm manager checks.' : 'The screenshot of the batch as the bank shows it.');
    section.append(note);
    const shots = el('div', 'pr-shots');
    section.append(shots);
    const authed = () => ({ authorization: `Bearer ${getToken() ?? ''}` });
    async function show() {
      shots.replaceChildren();
      const res = await fetch(`/api/finance-admin/payroll/runs/${r.id}/evidence`, { headers: authed() }).catch(() => null);
      const files: { id: string; mime: string }[] = res && res.ok ? ((await res.json()) as { files: { id: string; mime: string }[] }).files : [];
      if (!files.length) shots.append(el('p', 'hint', 'Nothing attached yet.'));
      for (const f of files) {
        const file = await fetch(`/api/finance-admin/payroll/evidence/${f.id}`, { headers: authed() }).catch(() => null);
        if (!file || !file.ok) continue;
        const url = URL.createObjectURL(await file.blob());
        if (f.mime === 'application/pdf') {
          const a = el('a', 'pr-link', 'Open the PDF');
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener';
          shots.append(a);
        } else {
          const img = el('img', 'pr-shot');
          img.src = url;
          img.alt = "The bank's page for this batch";
          shots.append(img);
        }
      }
    }
    if (me.canPrepare) {
      const input = el('input');
      input.type = 'file';
      input.accept = 'image/*,application/pdf';
      input.setAttribute('aria-label', "Attach the bank's confirmation");
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        const form = new FormData();
        form.set('file', file);
        const res = await fetch(`/api/finance-admin/payroll/runs/${r.id}/evidence`, { method: 'POST', headers: authed(), body: form }).catch(() => null);
        input.value = '';
        if (res && res.status === 401) return void fail(new StaffAuthError('unauthorized'));
        if (res && res.ok) {
          showToast('Attached.');
          await show();
        } else {
          showToast(((await res?.json().catch(() => ({}))) as { error?: string } | undefined)?.error ?? 'The file could not be saved.');
        }
      });
      section.append(input);
    }
    box.append(section);
    void show();
  }

  // ---- loading
  async function load(open?: string) {
    gate.hidden = true;
    forbidden.hidden = true;
    showLoading(statusEl);
    try {
      const { status, data: out } = await staffFetch('/api/finance-admin/payroll');
      if (status !== 200) throw new Error('load failed');
      clearState(statusEl);
      data = out;
      intro.hidden = false;
      intro.textContent = data!.me.canEnter ? 'Enter what each person is to be paid, then confirm. A director makes the bank file.' : 'Months of salaries: from the farm manager\'s amounts to the bank file and its approval.';
      $('new-run').hidden = !data!.me.canEnter;
      $('add-person').hidden = !data!.me.canPrepare;
      $('join-btn').hidden = !data!.me.canEnter;
      $('leave-btn').hidden = !data!.me.canEnter;
      $('bank-btn').hidden = !data!.me.canEnter;
      const asked = await staffFetch('/api/finance-admin/payroll/requests').catch(() => null);
      requests = asked && asked.status === 200 ? (asked.data.requests as PersonRequest[]) : [];
      renderPeople();
      renderRuns();
      content.hidden = false;
      const want = open ?? (location.hash.length > 1 ? location.hash.slice(1) : undefined);
      if (want && /^[0-9a-f-]{36}$/.test(want)) await openRun(want);
      else {
        $('run-view').hidden = true;
        $('list-view').hidden = false;
      }
      lock.render();
    } catch (err) {
      if (fail(err)) return;
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the salary runs", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: () => load() });
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  if (getToken()) load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

