    $('bank-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('bank-btn').addEventListener('click', openBank);
  $('bank-cancel').addEventListener('click', () => ($('bank-form').hidden = true));
  $('bank-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
