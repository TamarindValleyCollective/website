  // ---- one run
  async function openRun(id: string) {
    openId = id;
    history.replaceState(null, '', `#${id}`);
    $('list-view').hidden = true;
    $('run-view').hidden = false;
    showLoading(statusEl);
    try {
      const { status, data: detail } = await staffFetch(`/api/finance-admin/payroll/runs/${id}`);
      if (status !== 200) throw new Error('load failed');
      clearState(statusEl);
      renderRun(detail as Detail);
    } catch (err) {
      if (fail(err)) return;
      showFailure(statusEl, { title: "Couldn't load this month", text: 'Nothing was changed. Try again.', onRetry: () => openRun(id) });
    }
  }
  $('back').addEventListener('click', () => {
