---
// Payroll runs (docs/finance/sessions/09-payroll.md, 09a), the body of two pages that differ only in their shell: the farm manager's
// (/internal/finance-requests/payroll/, built for a phone) and the directors' (/internal/finance/payroll/). One screen, because the
// work is one thing seen by three people: the farm manager enters and confirms each person's net pay for the month; a director
// generates the bank file; a second director approves. What each person can press is decided by the server's `me` (canEnter,
// canPrepare, canApprove), and the server re-checks every action.
//
// Backed by netlify/functions/finance-admin.mts (/payroll, lib/finance-payroll.ts). Bank account numbers never reach this page: a
// person's account is shown as its last four digits. Everything the server returns is placed with textContent only, never as HTML.
import SignInGate from './SignInGate.astro';
import StepUpSheet from './StepUpSheet.astro';
---

<section class="finance finance-payroll section wrapper">
  <h1>Salaries</h1>
  <p id="intro" class="hint">Sign in to see the salary runs.</p>

  <SignInGate forbiddenWhat="the salary runs" />

  <div id="status" aria-live="polite" class="hint" hidden></div>

  <div id="content" hidden>
    <div id="list-view">
      <div class="segmented pr-tabs" role="group" aria-label="Salaries">
        <button type="button" class="tap-target is-active" id="tab-months" aria-pressed="true">Monthly salaries</button>
        <button type="button" class="tap-target" id="tab-people" aria-pressed="false">People<span id="people-count" class="chip-count" hidden></span></button>
      </div>

      <div id="months-pane">
        <div class="pr-actions">
          <button type="button" id="new-run" class="button button--primary" hidden>Start a month's salaries</button>
        </div>
        <button type="button" id="people-nudge" class="pr-link" hidden></button>

      <form id="new-form" class="pr-card" hidden novalidate>
        <h2>Start a month's salaries</h2>
        <p class="hint">Enter what each person is to be paid, in whole rupees. Leave a person blank to leave them out of this month.</p>
        <label class="pr-field"><span>Salary month</span><input id="n-month" type="month" required /></label>
        <label class="pr-field"><span>Kind</span><select id="n-type"><option value="salary">Salary</option><option value="bonus">Bonus (a named extra payment)</option></select></label>
        <label class="pr-field" id="n-label-wrap" hidden><span>Name of the bonus</span><input id="n-label" type="text" maxlength="40" placeholder="Diwali Bonus" /></label>
        <div id="n-people" class="pr-people"></div>
        <p id="new-error" class="pr-error" role="alert" hidden></p>
        <div class="pr-actions">
          <button type="submit" class="button button--primary">Save as a draft</button>
          <button type="button" id="new-cancel" class="button">Cancel</button>
        </div>
      </form>

        <div id="runs"></div>
      </div>

      <div id="people-pane" hidden>
        <p class="hint">Who is on payroll, and the changes that are waiting. Joining and leaving go to a director to approve.</p>
        <div class="pr-actions">
          <button type="button" id="join-btn" class="button button--outline" hidden>A new person is joining</button>
          <button type="button" id="leave-btn" class="button button--outline" hidden>Someone is leaving</button>
          <button type="button" id="bank-btn" class="button button--outline" hidden>Change bank details</button>
          <button type="button" id="add-person" class="button button--outline" hidden>Add a person to payroll</button>
        </div>

      <form id="person-form" class="pr-card" hidden novalidate>
        <h2>Add a person to payroll</h2>
        <p class="hint">Only people already added as an employee on the Parties page are listed.</p>
        <label class="pr-field"><span>Who</span><select id="p-party"></select></label>
        <p id="person-error" class="pr-error" role="alert" hidden></p>
        <div class="pr-actions">
          <button type="submit" class="button button--primary">Add</button>
          <button type="button" id="person-cancel" class="button">Cancel</button>
        </div>
      </form>

      <form id="join-form" class="pr-card" hidden novalidate>
        <h2>A new person is joining</h2>
        <p class="hint">A director approves this. Someone else adds the person on the Parties page, with their bank details.</p>
        <label class="pr-field"><span>Name</span><input id="j-name" autocomplete="off" maxlength="100" /></label>
        <label class="pr-field"><span>Role (optional)</span><input id="j-role" autocomplete="off" maxlength="60" /></label>
        <label class="pr-field"><span>First month paid</span><input id="j-start" type="month" required /></label>
        <label class="pr-field"><span>Agreed monthly pay, in rupees (optional)</span><input id="j-pay" inputmode="numeric" autocomplete="off" placeholder="₹" /></label>
        <div id="j-bank"></div>
        <p id="join-error" class="pr-error" role="alert" hidden></p>
        <div class="pr-actions">
          <button type="submit" class="button button--primary">Send for approval</button>
          <button type="button" id="join-cancel" class="button">Cancel</button>
        </div>
      </form>

      <form id="bank-form" class="pr-card" hidden novalidate>
        <h2>Change someone's bank details</h2>
        <p class="hint">Use the details the employee gave you. The old account keeps being paid until the new one starts. A director approves this, and someone else then verifies the new account.</p>
        <label class="pr-field"><span>Who</span><select id="b-who"></select></label>
        <label class="pr-field"><span>First salary month paid to the new account</span><input id="b-from" type="month" required /></label>
        <div id="b-bank"></div>
        <p id="bank-error" class="pr-error" role="alert" hidden></p>
        <div class="pr-actions">
          <button type="submit" class="button button--primary">Send for approval</button>
          <button type="button" id="bank-cancel" class="button">Cancel</button>
        </div>
      </form>

      <form id="leave-form" class="pr-card" hidden novalidate>
        <h2>Someone is leaving</h2>
        <p class="hint">A director approves this. The person is still paid up to the last month you choose, and not after.</p>
        <label class="pr-field"><span>Who</span><select id="l-who"></select></label>
        <label class="pr-field"><span>Last month paid</span><input id="l-last" type="month" required /></label>
        <label class="pr-field"><span>Reason (optional)</span><input id="l-reason" autocomplete="off" maxlength="200" /></label>
        <p id="leave-error" class="pr-error" role="alert" hidden></p>
        <div class="pr-actions">
          <button type="submit" class="button button--primary">Send for approval</button>
          <button type="button" id="leave-cancel" class="button">Cancel</button>
        </div>
      </form>

        <div id="people-box" hidden></div>
        <div id="staff-list"></div>
      </div>
    </div>

    <div id="run-view" hidden>
      <button type="button" id="back" class="pr-link">← All months</button>
      <div id="run"></div>
    </div>
  </div>
  <StepUpSheet />
</section>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getStepUp, getToken, setToken, showToast, staffFetch } from '../../scripts/lib/staff-client.mjs';
  import { initStepUpLock } from '../../scripts/lib/staff-stepup-ui.mjs';
  import { clearState, showFailure, showLoading } from '../../scripts/lib/staff-states.mjs';
  import { bankNameOfIfsc } from '../../scripts/lib/ifsc-banks.mjs';
  import { createDataTable } from '../../scripts/lib/data-table-ui.mjs';
  import '../styles/data-table.css';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  type Me = { id: string; canEnter: boolean; canPrepare: boolean; canApprove: boolean; ready: boolean; hasPasskey: boolean; stepUpValid: boolean };
  type RunRow = { id: string; month: string; runType: string; label: string | null; status: string; paymentDate: string; count: number; totalPaise: number; next: string | null };
  type Person = { id: string; name: string; rollNo: string | null; bank: { last4: string | null; ifsc: string | null; status: string } | null; active: boolean; startMonth: string | null; lastMonth: string | null };
  type PersonRequest = { id: string; kind: 'join' | 'leave' | 'bank_change'; status: string; name: string; rollNo: string | null; roleTitle: string | null; startMonth: string | null; agreedPayRupees: number | null; lastMonth: string | null; reason: string | null; decisionNote: string | null; mine: boolean; next: string | null; hasBank: boolean; last4: string | null; bankName: string | null; hasProof: boolean; effectiveOn: string | null };
  type Line = { id: string; employeeId: string; name: string; netPaise: number; last4: string | null; changed: boolean; problem: string | null; reference: string | null; returned: boolean; agreedPayPaise: number | null; daysWorked: number | null; advanceDeductedPaise: number | null };
  type Detail = {
    run: { id: string; month: string; runType: string; label: string | null; status: string; paymentMode: string; paymentDate: string; cancelledReason: string | null; preparedByMe: boolean; batch: { status: string; totalPaise: number; lineCount: number } | null; stale: boolean; next: string | null };
    lines: Line[];
    totalPaise: number;
    changed: number;
    problems: number;
  };
  let data: { me: Me; today: string; runs: RunRow[]; employees: Person[]; partyInactive: { id: string; name: string }[]; candidates: { id: string; name: string }[] } | null = null;
  let requests: PersonRequest[] = [];
  let openId: string | null = null;

  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(paise / 100);
  const runTitle = (r: { month: string; label: string | null }) => `${monthName(r.month)}${r.label ? ` · ${r.label}` : ''}`;
  const monthName = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const dayName = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  const STATUS: Record<string, { text: string; kind: string }> = {
    draft: { text: 'Draft', kind: 'dim' },
    confirmed: { text: 'Confirmed', kind: 'warn' },
    file_generated: { text: 'File made', kind: 'warn' },
    approved: { text: 'Approved at the bank', kind: 'ok' },
    settled: { text: 'Paid', kind: 'ok' },
    cancelled: { text: 'Cancelled', kind: 'dim' },
  };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (className) e.className = className;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const btn = (text: string, onClick: () => void, cls = 'button') => {
    const b = el('button', cls, text);
    b.type = 'button';
    b.addEventListener('click', onClick);
    return b;
  };
  const pill = (status: string, label?: string) => el('span', `pill pill--${(STATUS[status] ?? { kind: 'dim' }).kind}`, label ?? (STATUS[status] ?? { text: status }).text);

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    intro.hidden = false;
    intro.textContent = 'Sign in to see the salary runs.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function fail(err: unknown) {
    if (err instanceof StaffAuthError) {
      if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
      else showForbidden();
      return true;
    }
    return false;
  }

  // Only the directors' actions need the unlock (generating, downloading, approving); the farm manager never sees the pill.
  const lock = initStepUpLock({ getMe: () => (data?.me && (data.me.canPrepare || data.me.canApprove) ? data.me : null), onChange: () => {} });

  // One call for every change. A 403 asking for the step-up opens the unlock sheet instead of failing quietly.
  async function call(path: string, method: string, body: unknown, done: string): Promise<boolean> {
    try {
      const { status, data: out } = await staffFetch(path, { method, body });
      if (status === 403 && out?.code === 'STEP_UP_REQUIRED') {
        showToast(data?.me?.ready ? 'Unlock first.' : 'Set up two second factors first (see Security).');
        lock.open();
        return false;
      }
      if (status === 409 && Array.isArray(out?.blockers)) {
        showToast(`The file cannot be made yet. ${out.blockers.join(' ')}`);
        return false;
      }
      if (status >= 400) {
        showToast(out?.error ?? 'Could not do that.');
        return false;
      }
      showToast(done);
      return true;
    } catch (err) {
      if (!fail(err)) showToast('Could not do that.');
      return false;
    }
  }

  // ---- the list
  function renderRuns() {
    const box = $('runs');
    box.replaceChildren();
    if (!data) return;
    if (!data.runs.length) {
      box.append(el('p', 'hint', data.me.canEnter ? 'No month has been started yet.' : 'No salary run has been started yet.'));
      return;
    }
    for (const r of data.runs) {
      const card = el('button', 'pr-run');
      card.type = 'button';
      const top = el('span', 'pr-run-top');
      top.append(el('strong', undefined, runTitle(r)), pill(r.status));
      card.append(top, el('span', 'pr-run-sub', `${r.count} ${r.count === 1 ? 'person' : 'people'} · ${rupees(r.totalPaise)} · pay on ${dayName(r.paymentDate)}`));
      if (r.next) card.append(el('span', 'pr-run-next', r.next));
      card.addEventListener('click', () => openRun(r.id));
      box.append(card);
    }
  }

  // ---- start a month
  function previousMonth() {
    const d = new Date(`${data?.today ?? new Date().toISOString().slice(0, 10)}T00:00:00Z`);
    d.setUTCMonth(d.getUTCMonth() - 1, 1);
    return d.toISOString().slice(0, 7);
  }
  $('new-run').addEventListener('click', () => {
    if (!data) return;
    $<HTMLInputElement>('n-month').value = previousMonth();
    renderNewPeople();
    $('new-error').hidden = true;
    $('new-form').hidden = false;
    $('new-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  // Only the people on payroll for the chosen month: from their first month to their last, either end being open. What was typed stays.
  function renderNewPeople() {
    if (!data) return;
    const month = $<HTMLInputElement>('n-month').value;
    const typed = new Map([...$('n-people').querySelectorAll<HTMLInputElement>('input[data-employee]')].map((i) => [i.dataset.employee as string, i.value]));
    const people = $('n-people');
    people.replaceChildren();
    for (const p of data.employees.filter((e) => e.active && (!month || ((!e.startMonth || e.startMonth <= month) && (!e.lastMonth || e.lastMonth >= month))))) {
      const row = el('label', 'pr-person');
      row.append(el('span', undefined, p.rollNo ? `${p.rollNo}. ${p.name}` : p.name));
      const input = el('input');
      input.inputMode = 'numeric';
      input.autocomplete = 'off';
      input.placeholder = '₹';
      input.dataset.employee = p.id;
      input.value = typed.get(p.id) ?? '';
      input.setAttribute('aria-label', `Net pay for ${p.name}, in rupees`);
      row.append(input);
      people.append(row);
    }
    if (!people.children.length) people.append(el('p', 'hint', month ? 'No one is on payroll for that month.' : 'No one is on payroll yet. A director adds people first.'));
  }
  $('n-month').addEventListener('change', renderNewPeople);
  $('new-cancel').addEventListener('click', () => ($('new-form').hidden = true));
  $('n-type').addEventListener('change', () => ($('n-label-wrap').hidden = $<HTMLSelectElement>('n-type').value !== 'bonus'));

  function readAmounts(root: HTMLElement): { lines: { employeeId: string; netRupees: number }[] } | { error: string } {
    const lines: { employeeId: string; netRupees: number }[] = [];
    for (const input of root.querySelectorAll<HTMLInputElement>('input[data-employee]')) {
      const raw = input.value.replace(/[₹,\s]/g, '');
      if (!raw) continue;
      if (!/^\d+$/.test(raw) || Number(raw) <= 0) return { error: 'Each amount must be a whole number of rupees, with no paise.' };
      lines.push({ employeeId: input.dataset.employee as string, netRupees: Number(raw) });
    }
    if (!lines.length) return { error: 'Enter at least one amount.' };
    return { lines };
  }

  $('new-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const err = $('new-error');
    err.hidden = true;
    const amounts = readAmounts($('n-people'));
    if ('error' in amounts) return void ((err.textContent = amounts.error), (err.hidden = false));
    const { status, data: out } = await staffFetch('/api/finance-admin/payroll/runs', { method: 'POST', body: { month: $<HTMLInputElement>('n-month').value, runType: $<HTMLSelectElement>('n-type').value, label: $<HTMLInputElement>('n-label').value, lines: amounts.lines } }).catch((e) => {
      fail(e);
      return { status: 0, data: null as any };
    });
    if (status !== 201) {
      if (status) {
        err.textContent = out?.error ?? 'Could not save it.';
        err.hidden = false;
      }
      return;
    }
    showToast('Saved as a draft.');
    $('new-form').hidden = true;
    await load(out.id);
  });

  // ---- the two halves of the page: the month's work, and who is on payroll
  function showTab(name: 'months' | 'people') {
    $('months-pane').hidden = name !== 'months';
    $('people-pane').hidden = name !== 'people';
    for (const [id, on] of [['tab-months', name === 'months'], ['tab-people', name === 'people']] as const) {
      $(id).classList.toggle('is-active', on);
      $(id).setAttribute('aria-pressed', String(on));
    }
  }
  $('tab-months').addEventListener('click', () => showTab('months'));
  $('tab-people').addEventListener('click', () => showTab('people'));
  $('people-nudge').addEventListener('click', () => showTab('people'));

  // ---- changes of people: the farm manager raises them, a director signs them off
  const monthShort = (m: string | null) => (m ? new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-IN', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : '');
  function renderPeople() {
    const box = $('people-box');
    box.replaceChildren();
    const me = data?.me;
    renderStaffList();
    if (!data || !me) return void (box.hidden = true);
    const open = requests.filter((r) => r.status === 'requested');
    const lately = requests.filter((r) => r.status !== 'requested').slice(0, 5);
    // The People tab says when something waits there, and the monthly view points to it, so the rarely used actions can stay out of sight.
    const waiting = open.length + data.partyInactive.length;
    const count = $('people-count');
    count.hidden = !waiting;
    count.textContent = String(waiting);
    const nudge = $('people-nudge');
    nudge.hidden = !open.length;
    nudge.textContent = open.length ? `${open.length} ${open.length === 1 ? 'change of people is' : 'changes of people are'} waiting. Open People →` : '';
    if (!open.length && !lately.length && !data.partyInactive.length) return void (box.hidden = true);
    box.hidden = false;
    box.append(el('h3', 'pr-section-title', 'Changes of people'));
    if (data.partyInactive.length) {
      box.append(el('p', 'pr-warn', `${data.partyInactive.map((p) => p.name).join(', ')} ${data.partyInactive.length === 1 ? 'is' : 'are'} inactive on the Parties page but still on payroll. Their salary file is blocked until a leaving request is approved or the party is reactivated.`));
    }
    for (const r of [...open, ...lately]) {
      const card = el('div', 'pr-card');
      const top = el('div', 'pr-run-top');
      const who = `${r.rollNo ? `${r.rollNo}. ` : ''}${r.name}`;
      top.append(el('strong', undefined, r.kind === 'join' ? `Joining: ${r.name}` : r.kind === 'bank_change' ? `New bank details: ${who}` : `Leaving: ${who}`), pill(r.status === 'requested' ? 'draft' : r.status === 'approved' ? 'settled' : 'cancelled', r.status === 'requested' ? 'Waiting' : r.status === 'approved' ? 'Approved' : r.status === 'rejected' ? 'Declined' : 'Withdrawn'));
      card.append(top);
      const bits = r.kind === 'join'
        ? [`from ${monthShort(r.startMonth)}`, r.roleTitle, r.agreedPayRupees ? `${rupees(r.agreedPayRupees * 100)} a month` : null]
        : r.kind === 'bank_change'
          ? [`new account paid from ${r.effectiveOn ? dayName(r.effectiveOn) : ''}`]
          : [`last month paid: ${monthShort(r.lastMonth)}`, r.reason];
      card.append(el('p', 'pr-sub', bits.filter(Boolean).join(' · ')));
      if (r.hasBank) card.append(el('p', 'pr-sub', `${r.bankName ?? 'Bank'} · account ending ${r.last4} · photo ${r.hasProof ? 'attached' : 'missing'}`));
      if (r.decisionNote) card.append(el('p', 'pr-sub', `Note: ${r.decisionNote}`));
      if (r.status === 'requested') {
        card.append(el('p', 'pr-sub', r.next ?? ''));
        const acts = el('div', 'pr-actions');
        const decide = (action: string, extra: Record<string, unknown> = {}, done = 'Done.') => async () => {
          if (await call(`/api/finance-admin/payroll/requests/${r.id}/action`, 'POST', { action, ...extra }, done)) await load();
        };
        // The person who raised it can attach, or replace, the photo of the passbook or cheque while the request is open.
        if (r.mine && r.hasBank) {
          const photo = el('input');
          photo.type = 'file';
          photo.accept = 'image/*,application/pdf';
          photo.setAttribute('aria-label', r.hasProof ? 'Replace the photo' : 'Attach the photo of the passbook or cheque');
          photo.addEventListener('change', async () => {
            const file = photo.files?.[0];
            if (!file) return;
            const problem = await sendProof(r.id, file);
            showToast(problem ?? 'Photo saved.');
            if (!problem) await load();
          });
          acts.append(photo);
        }
        if (me.canPrepare && r.hasProof) acts.append(btn('View the photo', () => void viewProof(r.id), 'button button--outline'));
        if (me.canPrepare && !r.mine) {
          let pick: HTMLSelectElement | null = null;
          if (r.kind === 'join') {
            if (data.candidates.length) {
              pick = el('select');
              pick.setAttribute('aria-label', `Party for ${r.name}`);
              pick.append(...data.candidates.map((c) => Object.assign(document.createElement('option'), { value: c.id, textContent: c.name })));
              const guess = data.candidates.find((c) => c.name.trim().toLowerCase() === r.name.trim().toLowerCase());
              if (guess) pick.value = guess.id;
              acts.append(pick);
            } else {
              card.append(el('p', 'hint', 'Add them as an employee on the Parties page first, then approve.'));
            }
          }
          const chosen = pick;
          const ready = !(r.hasBank && !r.hasProof);
          if (ready && (r.kind !== 'join' || chosen)) acts.append(btn('Approve', () => decide('approve', chosen ? { partyId: chosen.value } : {}, r.kind === 'join' ? 'Added to payroll.' : r.kind === 'bank_change' ? 'Bank details sent for verification.' : 'Last month set.')(), 'button button--primary'));
          acts.append(btn('Decline', () => {
            const note = prompt('Why? (optional)');
            if (note !== null) void decide('reject', { note }, 'Declined.')();
          }, 'button button--outline'));
        }
        if (r.mine || me.canPrepare) acts.append(btn('Withdraw', decide('cancel', {}, 'Withdrawn.'), 'button button--outline pr-danger'));
        card.append(acts);
      }
      box.append(card);
    }
  }
  // Who is on payroll, as the admin table the other finance pages use: the number, the name, the masked account and IFSC (for the people who
  // prepare and approve the file; the server sends them to no one else), the months they are paid for, and, for a director, a handle to drag a
  // row to a new place and arrows for the keyboard and touch screens. The number is their place in the bank's file, so moving someone renumbers
  // everyone; it works on the number order whatever column the table happens to be sorted by. Everything below reads the page's current data,
  // never what it was when the table was first built (the table is built once, the data is replaced on every load).
  let peopleTable: ReturnType<typeof createDataTable> | null = null;
  const peopleRoot = el('div');
  const people = () => data?.employees ?? [];
  let dragId: string | null = null;
  // Puts one person before or after another. The page reorders and renumbers at once, as the server will, and goes back to the server's
  // order only if the save fails.
  async function placePerson(id: string, targetId: string, after: boolean) {
    if (!data || id === targetId) return;
    const ids = people().map((x) => x.id);
    const from = ids.indexOf(id);
    if (from < 0 || ids.indexOf(targetId) < 0) return;
    ids.splice(from, 1);
    ids.splice(ids.indexOf(targetId) + (after ? 1 : 0), 0, id);
    if (ids.every((x, i) => x === people()[i].id)) return;
    const byId = new Map(people().map((x) => [x.id, x]));
    const before = data.employees;
    data.employees = ids.map((x, i) => ({ ...(byId.get(x) as Person), rollNo: String(i + 1) }));
    renderStaffList();
    if (!(await call('/api/finance-admin/payroll/employees/order', 'POST', { order: ids }, 'Order changed.'))) {
      if (data) data.employees = before;
      await load();
    }
  }
  function renderStaffList() {
    const box = $('staff-list');
    box.replaceChildren();
    if (!data) return;
    box.append(el('h3', 'pr-section-title', 'On payroll'));
    if (!data.employees.length) return void box.append(el('p', 'hint', 'No one is on payroll yet. A director adds the first people with "Add a person to payroll".'));
    const me = data.me;
    if (me.canPrepare) box.append(el('p', 'hint', "Drag a row by its ⠿ handle, or use the arrows, to change the order. The number is the person's place in the bank's file."));
    const state = (e: Person) => {
      const thisMonth = (data?.today ?? '').slice(0, 7);
      return !e.active ? 'Not on payroll' : (data?.partyInactive ?? []).some((p) => p.id === e.id) ? 'Inactive in Parties' : e.startMonth && e.startMonth > thisMonth ? `Starts ${monthShort(e.startMonth)}` : 'On payroll';
    };
    if (!peopleTable) {
      const showBank = me.canPrepare || me.canApprove;
      const arrows = (e: Person, withGrip = false) => {
        const ids = people().map((x) => x.id);
        const at = ids.indexOf(e.id);
        const wrap = el('div', 'pr-move');
        if (withGrip) {
          const grip = el('span', 'pr-grip', '⠿');
          grip.draggable = true;
          grip.dataset.id = e.id;
          grip.title = 'Drag to change the order';
          grip.setAttribute('aria-hidden', 'true');
          wrap.append(grip);
        }
        const up = btn('↑', () => void placePerson(e.id, ids[at - 1], false), 'button button--soft-neutral');
        up.setAttribute('aria-label', `Move ${e.name} up`);
        up.disabled = at <= 0;
        const down = btn('↓', () => void placePerson(e.id, ids[at + 1], true), 'button button--soft-neutral');
        down.setAttribute('aria-label', `Move ${e.name} down`);
        down.disabled = at === ids.length - 1;
        wrap.append(up, down);
        return wrap;
      };
      const columns: any[] = [
        { id: 'no', label: '#', type: 'count', value: (e: Person) => e.rollNo ?? '', sortValue: (e: Person) => Number(e.rollNo ?? 1e9) },
        { id: 'name', label: 'Name', value: (e: Person) => e.name },
      ];
      if (showBank) {
        columns.push(
          { id: 'account', label: 'Account', value: (e: Person) => (e.bank?.last4 ? `••••${e.bank.last4}` : e.bank ? 'None on file' : '') },
          { id: 'ifsc', label: 'IFSC', value: (e: Person) => e.bank?.ifsc ?? '' },
          { id: 'bank', label: 'Bank details', value: (e: Person) => (e.bank ? (e.bank.status === 'verified' ? 'Verified' : e.bank.status.replace(/_/g, ' ')) : '') },
        );
      }
      columns.push(
        { id: 'state', label: 'State', value: state },
        { id: 'last', label: 'Last month paid', value: (e: Person) => (e.lastMonth ? monthShort(e.lastMonth) : ''), sortValue: (e: Person) => e.lastMonth ?? '' },
      );
      if (me.canPrepare) {
        columns.push({ id: 'order', label: 'Order', sortable: false, sticky: true, filter: 'none', value: () => '', render: (e: Person) => arrows(e, true) });
      }
      peopleTable = createDataTable({
        root: peopleRoot,
        rowId: (e: Person) => e.id,
        noun: ['person', 'people'],
        searchPlaceholder: 'Search people…',
        defaultSort: ['no', 1],
        searchText: (e: Person) => [e.rollNo, e.name, e.bank?.ifsc, e.bank?.last4, state(e)].filter(Boolean).join(' '),
        rowClass: (e: Person) => (e.active ? '' : 'is-off'),
        empty: { title: 'No one on payroll', text: 'A director adds the first people.' },
        columns,
        card: (e: Person) => {
          const c = el('div', 'pr-person-card');
          c.append(el('strong', undefined, `${e.rollNo ? `${e.rollNo}. ` : ''}${e.name}`));
          const bits = [e.bank ? `${e.bank.last4 ? `A/c ••••${e.bank.last4}` : 'No account on file'}${e.bank.ifsc ? ` · IFSC ${e.bank.ifsc}` : ''}` : null, state(e), e.lastMonth ? `Last month paid ${monthShort(e.lastMonth)}` : null].filter(Boolean);
          c.append(el('span', 'pr-sub', bits.join(' · ')));
          if (me.canPrepare) c.append(arrows(e));
          return c;
        },
      });
      // Dragging, for the whole table at once (its rows are redrawn on every change): the handle starts it, a row takes the drop, and a line
      // above or below the row under the pointer shows where the person will land.
      const rowAt = (ev: Event) => (ev.target as HTMLElement).closest<HTMLElement>('tr.dt-row');
      const clearMarks = (all = false) => peopleRoot.querySelectorAll(all ? '.pr-drop-before, .pr-drop-after, .pr-dragging' : '.pr-drop-before, .pr-drop-after').forEach((n) => n.classList.remove('pr-drop-before', 'pr-drop-after', ...(all ? ['pr-dragging'] : [])));
      peopleRoot.addEventListener('dragstart', (ev) => {
        const grip = (ev.target as HTMLElement).closest<HTMLElement>('.pr-grip');
        if (!grip || !ev.dataTransfer) return;
        dragId = grip.dataset.id ?? null;
        ev.dataTransfer.setData('text/plain', dragId ?? '');
        ev.dataTransfer.effectAllowed = 'move';
        grip.closest('tr')?.classList.add('pr-dragging');
      });
      peopleRoot.addEventListener('dragover', (ev) => {
        const tr = rowAt(ev);
        if (!dragId || !tr) return;
        ev.preventDefault();
        if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move';
        const box = tr.getBoundingClientRect();
        clearMarks();
        tr.classList.add(ev.clientY > box.top + box.height / 2 ? 'pr-drop-after' : 'pr-drop-before');
      });
      peopleRoot.addEventListener('drop', (ev) => {
        const tr = rowAt(ev);
        if (!dragId || !tr) return;
        ev.preventDefault();
        const after = tr.classList.contains('pr-drop-after');
        const id = dragId;
        const target = tr.dataset.row;
        dragId = null;
        clearMarks(true);
        if (target) void placePerson(id, target, after);
      });
      peopleRoot.addEventListener('dragend', () => {
        dragId = null;
        clearMarks(true);
      });
    }
    box.append(peopleRoot);
    peopleTable.setRows(people());
  }
  // The bank details the employee gave the farm manager. The number is typed twice, the IFSC names its bank as it is typed (a typing aid only),
  // and the photo of the passbook or cancelled cheque goes with them. Nothing is stored in the page: after sending, only the last four show.
  function mountBankFields(host: HTMLElement, required: boolean) {
    host.replaceChildren();
    const field = (label: string, input: HTMLElement) => {
      const wrap = el('label', 'pr-field');
      wrap.append(el('span', undefined, label), input);
      host.append(wrap);
      return input as HTMLInputElement;
    };
    host.append(el('h3', 'pr-section-title', required ? 'New bank details' : 'Bank details (from the employee, optional)'));
    const account = field('Account number', Object.assign(el('input'), { inputMode: 'numeric', autocomplete: 'off', maxLength: 24 }));
    const confirm = field('Account number again', Object.assign(el('input'), { inputMode: 'numeric', autocomplete: 'off', maxLength: 24 }));
    const ifsc = field('IFSC code', Object.assign(el('input'), { autocomplete: 'off', maxLength: 11, placeholder: 'ABCD0123456' }));
    const hint = el('p', 'hint');
    hint.setAttribute('aria-live', 'polite');
    host.append(hint);
    const photo = field('Photo of the passbook or a cancelled cheque', Object.assign(el('input'), { type: 'file', accept: 'image/*,application/pdf' }));
    ifsc.addEventListener('input', () => {
      ifsc.value = ifsc.value.toUpperCase().replace(/\s+/g, '');
      const name = bankNameOfIfsc(ifsc.value);
      hint.textContent = ifsc.value.length < 4 ? '' : name ? `${name}. Check this is the right bank.` : 'This bank code is not one we know. Check it against the passbook.';
    });
    return {
      // -> { bank, photo } | { error } | { empty: true } (nothing typed and the bank part is optional)
      read(): { bank: { account: string; accountConfirm: string; ifsc: string }; photo: File } | { error: string } | { empty: true } {
        const any = [account, confirm, ifsc].some((i) => i.value.trim()) || photo.files?.length;
        if (!any && !required) return { empty: true };
        if (!account.value.trim() || !confirm.value.trim() || !ifsc.value.trim()) return { error: 'Enter the account number twice and the IFSC code.' };
        const file = photo.files?.[0];
        if (!file) return { error: 'Attach the photo of the passbook or cancelled cheque. It shows the details are the employee\'s own.' };
        return { bank: { account: account.value, accountConfirm: confirm.value, ifsc: ifsc.value }, photo: file };
      },
    };
  }
  // The photo goes as a form upload (staffFetch sends JSON), so this one carries the token itself.
  async function sendProof(id: string, file: File): Promise<string | null> {
    const form = new FormData();
    form.set('file', file);
    const res = await fetch(`/api/finance-admin/payroll/requests/${id}/proof`, { method: 'POST', headers: { authorization: `Bearer ${getToken() ?? ''}` }, body: form }).catch(() => null);
    if (res && res.status === 401) throw new StaffAuthError('unauthorized');
    if (res && res.ok) return null;
    return ((await res?.json().catch(() => ({}))) as { error?: string } | undefined)?.error ?? 'The photo could not be saved.';
  }
  // A director sees the photo only behind the unlock (it shows the whole account number); it opens in a new tab from a local object URL.
  async function viewProof(id: string) {
    const res = await fetch(`/api/finance-admin/payroll/requests/${id}/proof`, { headers: { authorization: `Bearer ${getToken() ?? ''}`, ...(getStepUp() ? { 'x-stepup-token': getStepUp() as string } : {}) } }).catch(() => null);
    if (res && res.status === 403) return void (showToast('Unlock first.'), lock.open());
    if (!res || !res.ok) return void showToast('Could not open the photo.');
    window.open(URL.createObjectURL(await res.blob()), '_blank', 'noopener');
  }
  let joinBank: ReturnType<typeof mountBankFields> | null = null;
  function openJoin() {
    $<HTMLInputElement>('j-name').value = '';
    $<HTMLInputElement>('j-role').value = '';
    $<HTMLInputElement>('j-pay').value = '';
    joinBank = mountBankFields($('j-bank'), false);
    $<HTMLInputElement>('j-start').value = new Date(`${data?.today ?? new Date().toISOString().slice(0, 10)}T00:00:00Z`).toISOString().slice(0, 7);
    $('join-error').hidden = true;
    $('join-form').hidden = false;
    $('join-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('join-btn').addEventListener('click', openJoin);
  $('join-cancel').addEventListener('click', () => ($('join-form').hidden = true));
  $('join-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const payRaw = $<HTMLInputElement>('j-pay').value.replace(/[₹,\s]/g, '');
    const bank = joinBank?.read() ?? { empty: true as const };
    if ('error' in bank) {
      $('join-error').textContent = bank.error;
      $('join-error').hidden = false;
      return;
    }
    const body = { kind: 'join', name: $<HTMLInputElement>('j-name').value, role: $<HTMLInputElement>('j-role').value, startMonth: $<HTMLInputElement>('j-start').value, ...(payRaw ? { agreedPayRupees: Number(payRaw) } : {}), ...('bank' in bank ? { bank: bank.bank } : {}) };
    const { status, data: out } = await staffFetch('/api/finance-admin/payroll/requests', { method: 'POST', body }).catch((e) => (fail(e), { status: 0, data: null as any }));
    if (status !== 201) {
      if (status) {
        $('join-error').textContent = out?.error ?? 'Could not send it.';
        $('join-error').hidden = false;
      }
      return;
    }
    if ('bank' in bank) {
      const problem = await sendProof(out.id, bank.photo);
      if (problem) showToast(`Sent, but the photo was not saved: ${problem} Attach it on the request.`);
    }
    showToast('Sent for approval.');
    $('join-form').hidden = true;
    await load();
  });
  let changeBank: ReturnType<typeof mountBankFields> | null = null;
  function openBank() {
    if (!data) return;
    const sel = $<HTMLSelectElement>('b-who');
    const people = data.employees.filter((e) => e.active);
    sel.replaceChildren(...people.map((e) => Object.assign(document.createElement('option'), { value: e.id, textContent: e.rollNo ? `${e.rollNo}. ${e.name}` : e.name })));
    $<HTMLInputElement>('b-from').value = data.today.slice(0, 7);
    changeBank = mountBankFields($('b-bank'), true);
    $('bank-error').hidden = !!people.length;
