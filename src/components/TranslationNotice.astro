---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<p class="translation-notice">{t('translationNotice.text')}</p>

<style>
  .translation-notice {
    margin: 0;
    padding: 8px 24px;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.82rem;
    text-align: center;
  }
</style>
