---
// The Events page already computes this same countdown, but it's only
// visible to someone who clicks through there -- this surfaces it on the
// homepage itself, for anyone who'd never otherwise notice an event coming up.
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { formatDateRange, daysUntil } from '../utils/events';
import { DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

// The events collection glob (src/content.config.ts) picks up translated
// copies under kn/ and ta/ subfolders too, whose id is prefixed like
// "kn/2020-10-31-...". Restrict to root-level (canonical, undated-prefix)
// entries here so `nextEvent.id` below is always the bare slug - the href
// re-adds the current `lang` prefix itself via getRelativeLocaleUrl, so a
// locale-prefixed id would double up.
const allEvents = await getCollection('events', (e) => !e.data.draft && !e.id.includes('/'));
const today = new Date();
// Soonest first, capped at 3 - the strip cycles through these one at a time
// (see the script below) rather than growing into a card row, so it stays
// the same glanceable size regardless of how many events are upcoming.
const MAX_EVENTS = 3;
const upcomingEvents = allEvents
  .filter((e) => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, MAX_EVENTS);

// Countdown text is reproduced locally (rather than importing
// countdownLabel from ../utils/events, which is shared with the
// English-only events pages) so translating it here doesn't touch that
// shared util - only the day-count math (daysUntil, no UI text) is reused.
const labels = {
  en: { eyebrow: 'Coming up', cta: 'See details →', today: 'Today', tomorrow: 'Tomorrow', daysToGo: '{n} days to go' },
  kn: { eyebrow: 'ಮುಂಬರುವುದು', cta: 'ವಿವರಗಳನ್ನು ನೋಡಿ →', today: 'ಇಂದು', tomorrow: 'ನಾಳೆ', daysToGo: '{n} ದಿನಗಳು ಬಾಕಿ' },
  ta: { eyebrow: 'வரவிருப்பது', cta: 'விவரங்களைக் காண்க →', today: 'இன்று', tomorrow: 'நாளை', daysToGo: '{n} நாட்களில்' },
} as const;

const l = labels[lang];

function countdownText(daysAway: number): string {
  if (daysAway <= 0) return l.today;
  if (daysAway === 1) return l.tomorrow;
  return l.daysToGo.replace('{n}', String(daysAway));
}
---

{upcomingEvents.length > 0 && (
  <section class="whats-next" id="whats-next">
    <div class="wrapper whats-next__inner">
      <div class="whats-next__slides">
        {upcomingEvents.map((event, i) => (
          <div class="whats-next__slide" data-slide hidden={i !== 0}>
            <div class="whats-next__text">
              <span class="whats-next__eyebrow">{l.eyebrow}</span>
              <h3 class="whats-next__title">{event.data.title}</h3>
              <span class="whats-next__date">{formatDateRange(event.data.date, event.data.endDate)}</span>
            </div>
            <span class="whats-next__countdown">{countdownText(daysUntil(event.data.date, today))}</span>
            <a
              class="button whats-next__cta"
              href={
                event.data.series === '3bs1h'
                  ? `/events/3bs1h/${event.data.edition}`
                  : getRelativeLocaleUrl(lang, `/events/${event.id}`)
              }
            >
              {l.cta}
            </a>
          </div>
        ))}
      </div>
      {upcomingEvents.length > 1 && (
        <div class="whats-next__dots" role="tablist" aria-label={l.eyebrow}>
          {upcomingEvents.map((_, i) => (
            <button type="button" class="whats-next__dot" class:list={{ 'is-active': i === 0 }} data-dot={i} role="tab" aria-selected={i === 0} aria-label={`${i + 1}`}></button>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .whats-next {
    background: var(--tvc-orange-tint);
    border-top: 1px solid rgba(246, 133, 32, 0.25);
    border-bottom: 1px solid rgba(246, 133, 32, 0.25);
    padding: 18px 0;
  }

  .whats-next__inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .whats-next__slides {
    flex: 1;
    min-width: 0;
  }

  .whats-next__slide {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .whats-next__slide[hidden] {
    display: none;
  }

  .whats-next__dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .whats-next__dot {
    appearance: none;
    -webkit-appearance: none;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(168, 87, 18, 0.3);
    cursor: pointer;
  }

  .whats-next__dot.is-active {
    background: var(--tvc-orange-strong, #a85712);
  }

  .whats-next__text {
    flex: 1;
    min-width: 0;
  }

  .whats-next__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-orange-strong, #a85712);
    margin-bottom: 2px;
  }

  .whats-next__title {
    margin: 0;
    font-size: 1.05rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .whats-next__date {
    display: block;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
    margin-top: 2px;
  }

  .whats-next__countdown {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--tvc-orange-strong, #a85712);
    white-space: nowrap;
  }

  .whats-next__cta {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .whats-next__inner {
      flex-wrap: wrap;
    }

    .whats-next__slide {
      flex-wrap: wrap;
      width: 100%;
    }

    .whats-next__countdown {
      order: 3;
    }

    .whats-next__cta {
      order: 4;
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  const ADVANCE_MS = 6000;

  document.querySelectorAll<HTMLElement>('#whats-next').forEach((banner) => {
    const slides = Array.from(banner.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(banner.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    if (slides.length <= 1) return;

    let active = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      active = index;
      slides.forEach((s, i) => (s.hidden = i !== index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        d.setAttribute('aria-selected', String(i === index));
      });
    }

    function next() {
      show((active + 1) % slides.length);
    }

    // No auto-advance for reduced-motion users - same convention as
    // PageHero's own scroll-fade script - but the dots stay fully clickable,
    // so cycling is still possible, just not automatic.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      timer = setInterval(next, ADVANCE_MS);
      banner.addEventListener('mouseenter', () => timer && clearInterval(timer));
      banner.addEventListener('mouseleave', () => (timer = setInterval(next, ADVANCE_MS)));
      banner.addEventListener('focusin', () => timer && clearInterval(timer));
      banner.addEventListener('focusout', () => (timer = setInterval(next, ADVANCE_MS)));
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  });
</script>
