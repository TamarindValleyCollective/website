---
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text" set:html={t('cookie.text')} />
    <div class="cookie-banner__actions">
      <button type="button" class="button button--outline" id="cookie-reject">{t('cookie.reject')}</button>
      <button type="button" class="button" id="cookie-accept">{t('cookie.accept')}</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    background: #fff;
    border-top: 1px solid var(--tvc-line);
    box-shadow: var(--shadow-soft);
    padding: 18px 24px;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cookie-banner__text {
    margin: 0;
    font-size: 0.88rem;
    color: var(--tvc-ink-soft);
    max-width: 62ch;
    flex: 1 1 320px;
  }

  .cookie-banner__text a {
    font-weight: 600;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Same visual weight for both — a GDPR-compliant banner can't make
     "Reject" harder to notice or act on than "Accept". */
  .cookie-banner__actions .button,
  .cookie-banner__actions .button--outline {
    padding: 10px 18px;
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .cookie-banner__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .cookie-banner__actions {
      justify-content: flex-end;
    }
  }
</style>

<script is:inline>
  // is:inline (not a module) so this runs the instant the parser reaches it,
  // instead of a module script's implicit defer-to-end-of-document - for a
  // first-time visitor, that defer was the entire reason this already-in-DOM
  // banner took 2s+ to un-hide, long enough for Lighthouse to flag its text
  // as the page's LCP element on lighter pages (see CHANGELOG).
  (function () {
    var CONSENT_KEY = 'tvc-cookie-consent';
    var banner = document.getElementById('cookie-banner');
    var acceptBtn = document.getElementById('cookie-accept');
    var rejectBtn = document.getElementById('cookie-reject');

    function show() {
      banner.hidden = false;
    }

    function hide() {
      banner.hidden = true;
    }

    acceptBtn.addEventListener('click', function () {
      localStorage.setItem(CONSENT_KEY, 'granted');
      window.tvcAnalytics?.load();
      hide();
    });

    rejectBtn.addEventListener('click', function () {
      localStorage.setItem(CONSENT_KEY, 'denied');
      window.tvcAnalytics?.revoke();
      hide();
    });

    // Footer's "Cookie preferences" link re-opens this banner from anywhere
    // on the site, without a page reload, so consent can be
    // withdrawn/changed as easily as it was given.
    window.addEventListener('tvc:open-cookie-preferences', show);

    var stored = localStorage.getItem(CONSENT_KEY);
    if (stored === 'granted') {
      window.tvcAnalytics?.load();
    } else if (stored === 'denied') {
      window.tvcAnalytics?.revoke();
    } else {
      show();
    }
  })();
</script>
