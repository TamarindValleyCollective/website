---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';
import WhatsAppButton from './WhatsAppButton.astro';

interface PricedPackageOption {
  label: string;
  // Per-adult rate for this package. Presence of at least one priced option
  // is what turns on the live "estimated total" - a plain string list (see
  // DayVisitView's itinerary names) has no rate to compute from, so no
  // total is shown for those forms.
  adultRate: number;
  // Per-child rate; omitted (or 0) matches the "children under 10 free"
  // pricing used across events (see `price` in content.config.ts).
  childRate?: number;
}

interface Props {
  type: string;
  whatsappMessage: string;
  packageOptions?: string[] | PricedPackageOption[];
  note?: string;
  lang?: Locale;
  // Rendered as an <h2> above the note/form, with a border-top separating it
  // from whatever content precedes it on the page - every page using this
  // component should pass one, so the "book this" moment always looks and
  // reads the same way site-wide rather than each caller improvising its own
  // heading/boundary treatment.
  heading?: string;
  // For a booking whose date is already fixed (e.g. one edition of a
  // recurring event) rather than a flexible visit - replaces the free-text
  // "Preferred dates" field with a hidden input carrying this value, so the
  // submission still records a date without asking the visitor to restate
  // one they have no choice over.
  fixedDates?: string;
  // False when the page already surfaces a WhatsApp CTA elsewhere (e.g.
  // EventDetailView's "at a glance" sidebar, which has its own per-event
  // contact) - avoids showing the same "message us" link twice on one page.
  showWhatsapp?: boolean;
}

const { type, whatsappMessage, packageOptions, note, lang = DEFAULT_LOCALE, fixedDates, heading, showWhatsapp = true } = Astro.props;
const t = useTranslations(lang);

const WHATSAPP_NUMBER = '918548065772';
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessage)}`;
const fieldId = type.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// English field slugs kept as-is regardless of locale - itinerary names
// (packageOptions) are supplied pre-translated by the caller, but their
// slugified form is only used as a stable HTML id, never shown.
const fieldLabels = {
  en: { itinerary: 'Which itinerary?', adults: 'Number of adults', children: 'Number of children', dates: 'Preferred dates', datesPlaceholder: 'e.g. a weekend in December, or flexible', anythingElse: 'Anything else? (optional)', anythingElsePlaceholder: 'Any questions or extra details', total: 'Estimated total' },
  kn: { itinerary: 'ಯಾವ ಪ್ರಯಾಣ ಯೋಜನೆ?', adults: 'ವಯಸ್ಕರ ಸಂಖ್ಯೆ', children: 'ಮಕ್ಕಳ ಸಂಖ್ಯೆ', dates: 'ಆದ್ಯತೆಯ ದಿನಾಂಕಗಳು', datesPlaceholder: 'ಉದಾ. ಡಿಸೆಂಬರ್‌ನಲ್ಲಿ ಒಂದು ವಾರಾಂತ್ಯ, ಅಥವಾ ಹೊಂದಿಕೊಳ್ಳುವ', anythingElse: 'ಬೇರೆ ಏನಾದರೂ? (ಐಚ್ಛಿಕ)', anythingElsePlaceholder: 'ಯಾವುದೇ ಪ್ರಶ್ನೆಗಳು ಅಥವಾ ಹೆಚ್ಚಿನ ವಿವರಗಳು', total: 'ಅಂದಾಜು ಒಟ್ಟು ಮೊತ್ತ' },
  ta: { itinerary: 'எந்த பயணத் திட்டம்?', adults: 'பெரியவர்களின் எண்ணிக்கை', children: 'குழந்தைகளின் எண்ணிக்கை', dates: 'விருப்பமான தேதிகள்', datesPlaceholder: 'எ.கா. டிசம்பரில் ஒரு வார இறுதி, அல்லது நெகிழ்வானது', anythingElse: 'வேறு ஏதேனும்? (விருப்பம்)', anythingElsePlaceholder: 'ஏதேனும் கேள்விகள் அல்லது கூடுதல் விவரங்கள்', total: 'மதிப்பிடப்பட்ட மொத்தம்' },
} as const;
const f = fieldLabels[lang];

// Capped at 10 (plus a "10+" option) - a party larger than that should
// just say so in the "anything else" field rather than the dropdown
// growing indefinitely, and the live total (below) intentionally doesn't
// try to compute a number for "10+".
const MAX_COUNT = 10;
const adultCounts = [...Array.from({ length: MAX_COUNT }, (_, i) => String(i + 1)), '10+'];
const childCounts = ['0', ...adultCounts];

interface DisplayPackageOption {
  label: string;
  adultRate?: number;
  childRate?: number;
}

const normalizedPackages: DisplayPackageOption[] | undefined = packageOptions?.map((opt) =>
  typeof opt === 'string' ? { label: opt } : opt,
);
const hasPricing = normalizedPackages?.some((opt) => typeof opt.adultRate === 'number') ?? false;
---

<div class="booking-inquiry">
  {heading && <h2 class="booking-inquiry__heading">{heading}</h2>}
  {note && <p class="note">{note}</p>}
  <form
    class="inquiry-form card"
    name="visit-inquiry"
    method="POST"
    action={getRelativeLocaleUrl(lang, '/visit/thanks')}
    data-netlify="true"
    data-netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="visit-inquiry" />
    <input type="hidden" name="type" value={type} />
    <p class="inquiry-hp"><label>{t('forms.honeypotLabel')} <input name="bot-field" /></label></p>

    {normalizedPackages && (
      <div class="field-package">
        <label for={`${fieldId}-package`}>{f.itinerary}</label>
        <select id={`${fieldId}-package`} name="package" required>
          <option value="">{t('forms.chooseOne')}</option>
          {normalizedPackages.map((opt) => (
            <option value={opt.label} data-adult-rate={opt.adultRate ?? ''} data-child-rate={opt.childRate ?? 0}>
              {opt.label}
            </option>
          ))}
        </select>
      </div>
    )}

    <div class="inquiry-grid">
      <div>
        <label for={`${fieldId}-name`}>{t('forms.name')}</label>
        <input id={`${fieldId}-name`} type="text" name="name" placeholder={t('forms.namePlaceholder')} autocomplete="name" required />
      </div>
      <div>
        <label for={`${fieldId}-email`}>{t('forms.email')}</label>
        <input id={`${fieldId}-email`} type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
      </div>
      <div>
        <label for={`${fieldId}-phone`}>{t('forms.phoneOptional')}</label>
        <input id={`${fieldId}-phone`} type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" />
      </div>
      <div>
        <label for={`${fieldId}-adults`}>{f.adults}</label>
        <select id={`${fieldId}-adults`} name="adults" required>
          <option value="">{t('forms.chooseOne')}</option>
          {adultCounts.map((n) => <option value={n}>{n}</option>)}
        </select>
      </div>
      <div>
        <label for={`${fieldId}-children`}>{f.children}</label>
        <select id={`${fieldId}-children`} name="children">
          {childCounts.map((n) => <option value={n} selected={n === '0'}>{n}</option>)}
        </select>
      </div>
    </div>

    {fixedDates ? (
      <input type="hidden" name="dates" value={fixedDates} />
    ) : (
      <>
        <label for={`${fieldId}-dates`}>{f.dates}</label>
        <input id={`${fieldId}-dates`} type="text" name="dates" placeholder={f.datesPlaceholder} />
      </>
    )}

    <label for={`${fieldId}-message`}>{f.anythingElse}</label>
    <textarea id={`${fieldId}-message`} name="message" rows="3" placeholder={f.anythingElsePlaceholder}></textarea>

    {hasPricing && (
      <div class="field-total" id={`${fieldId}-total-wrap`} hidden>
        <span class="field-total__label">{f.total}</span>
        <span class="field-total__amount" id={`${fieldId}-total-amount`}>₹0</span>
      </div>
    )}

    <button class="button" type="submit">{t('forms.sendBookingRequest')}</button>
  </form>

  {hasPricing && (
    // Recomputes on every package/adults/children change. Deliberately
    // stays hidden (rather than showing ₹0 or an error) whenever the
    // package or adult count isn't a concrete number yet - notably for
    // the "10+" option, where a per-person rate times "10+" isn't a real
    // total, so the visitor is left to confirm that via WhatsApp instead.
    <script define:vars={{ fieldId }}>
      const packageSelect = document.getElementById(`${fieldId}-package`);
      const adultsSelect = document.getElementById(`${fieldId}-adults`);
      const childrenSelect = document.getElementById(`${fieldId}-children`);
      const totalWrap = document.getElementById(`${fieldId}-total-wrap`);
      const totalAmount = document.getElementById(`${fieldId}-total-amount`);

      function formatInr(amount) {
        return `₹${amount.toLocaleString('en-IN')}`;
      }

      function updateTotal() {
        if (!packageSelect || !adultsSelect || !totalWrap || !totalAmount) return;

        const selected = packageSelect.selectedOptions[0];
        const adultRate = selected ? Number(selected.dataset.adultRate) : NaN;
        const childRate = selected ? Number(selected.dataset.childRate || '0') : 0;
        const adults = Number(adultsSelect.value);
        const children = childrenSelect ? Number(childrenSelect.value) : 0;

        if (!selected?.value || Number.isNaN(adultRate) || !adultsSelect.value || Number.isNaN(adults)) {
          totalWrap.hidden = true;
          return;
        }

        const total = adultRate * adults + (Number.isNaN(childRate) ? 0 : childRate) * (Number.isNaN(children) ? 0 : children);
        totalAmount.textContent = formatInr(total);
        totalWrap.hidden = false;
      }

      packageSelect?.addEventListener('change', updateTotal);
      adultsSelect?.addEventListener('change', updateTotal);
      childrenSelect?.addEventListener('change', updateTotal);
    </script>
  )}

  {showWhatsapp && (
    <div class="whatsapp-cta">
      <p class="whatsapp-cta__label">{t('forms.preferChat')}</p>
      <WhatsAppButton href={whatsappHref}>{t('forms.messageOnWhatsapp')}</WhatsAppButton>
    </div>
  )}
</div>

<style>
  .booking-inquiry {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--tvc-line);
  }

  .booking-inquiry__heading {
    margin-top: 0;
  }

  .note {
    margin-bottom: 16px;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .inquiry-form label {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  .inquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }

  .inquiry-form button {
    align-self: flex-start;
  }

  .field-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--tvc-green-tint);
  }

  /* The [hidden] attribute is how the script (below) toggles this element,
     but its UA-stylesheet `display: none` loses to the `display: flex`
     above under the cascade's origin ordering - restate it explicitly so
     hiding actually works. */
  .field-total[hidden] {
    display: none;
  }

  .field-total__label {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .field-total__amount {
    font-weight: 700;
    font-size: 1.15rem;
  }

  .whatsapp-cta {
    margin-top: 16px;
  }

  .whatsapp-cta__label {
    margin-bottom: 8px;
  }

  /* Netlify Forms spam honeypot - off-screen, not display:none (some bots
     skip hidden fields, but few check for visibility via position). */
  .inquiry-hp {
    position: absolute;
    left: -9999px;
  }
</style>
