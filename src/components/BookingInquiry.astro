---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  type: string;
  whatsappMessage: string;
  packageOptions?: string[];
  note?: string;
  lang?: Locale;
  // Rendered as an <h2> above the note/form, with a border-top separating it
  // from whatever content precedes it on the page - every page using this
  // component should pass one, so the "book this" moment always looks and
  // reads the same way site-wide rather than each caller improvising its own
  // heading/boundary treatment.
  heading?: string;
  // For a booking whose date is already fixed (e.g. one edition of a
  // recurring event) rather than a flexible visit - replaces the free-text
  // "Preferred dates" field with a hidden input carrying this value, so the
  // submission still records a date without asking the visitor to restate
  // one they have no choice over.
  fixedDates?: string;
}

const { type, whatsappMessage, packageOptions, note, lang = DEFAULT_LOCALE, fixedDates, heading } = Astro.props;
const t = useTranslations(lang);

const WHATSAPP_NUMBER = '918548065772';
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessage)}`;
const fieldId = type.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// English field slugs kept as-is regardless of locale - itinerary names
// (packageOptions) are supplied pre-translated by the caller, but their
// slugified form is only used as a stable HTML id, never shown.
const fieldLabels = {
  en: { itinerary: 'Which itinerary?', people: 'Number of people', peoplePlaceholder: 'e.g. 2 adults, 1 child', dates: 'Preferred dates', datesPlaceholder: 'e.g. a weekend in December, or flexible', anythingElse: 'Anything else? (optional)', anythingElsePlaceholder: 'Any questions or extra details' },
  kn: { itinerary: 'ಯಾವ ಪ್ರಯಾಣ ಯೋಜನೆ?', people: 'ಜನರ ಸಂಖ್ಯೆ', peoplePlaceholder: 'ಉದಾ. 2 ವಯಸ್ಕರು, 1 ಮಗು', dates: 'ಆದ್ಯತೆಯ ದಿನಾಂಕಗಳು', datesPlaceholder: 'ಉದಾ. ಡಿಸೆಂಬರ್‌ನಲ್ಲಿ ಒಂದು ವಾರಾಂತ್ಯ, ಅಥವಾ ಹೊಂದಿಕೊಳ್ಳುವ', anythingElse: 'ಬೇರೆ ಏನಾದರೂ? (ಐಚ್ಛಿಕ)', anythingElsePlaceholder: 'ಯಾವುದೇ ಪ್ರಶ್ನೆಗಳು ಅಥವಾ ಹೆಚ್ಚಿನ ವಿವರಗಳು' },
  ta: { itinerary: 'எந்த பயணத் திட்டம்?', people: 'நபர்களின் எண்ணிக்கை', peoplePlaceholder: 'எ.கா. 2 பெரியவர்கள், 1 குழந்தை', dates: 'விருப்பமான தேதிகள்', datesPlaceholder: 'எ.கா. டிசம்பரில் ஒரு வார இறுதி, அல்லது நெகிழ்வானது', anythingElse: 'வேறு ஏதேனும்? (விருப்பம்)', anythingElsePlaceholder: 'ஏதேனும் கேள்விகள் அல்லது கூடுதல் விவரங்கள்' },
} as const;
const f = fieldLabels[lang];
---

<div class="booking-inquiry">
  {heading && <h2 class="booking-inquiry__heading">{heading}</h2>}
  {note && <p class="note">{note}</p>}
  <div class="inquiry-options">
    <form
      class="inquiry-form card"
      name="visit-inquiry"
      method="POST"
      action={getRelativeLocaleUrl(lang, '/visit/thanks')}
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="visit-inquiry" />
      <input type="hidden" name="type" value={type} />
      <p class="inquiry-hp"><label>{t('forms.honeypotLabel')} <input name="bot-field" /></label></p>

      {packageOptions && (
        <div class="field-package">
          <label for={`${fieldId}-package`}>{f.itinerary}</label>
          <select id={`${fieldId}-package`} name="package" required>
            <option value="">{t('forms.chooseOne')}</option>
            {packageOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
      )}

      <div class="inquiry-grid">
        <div>
          <label for={`${fieldId}-name`}>{t('forms.name')}</label>
          <input id={`${fieldId}-name`} type="text" name="name" placeholder={t('forms.namePlaceholder')} autocomplete="name" required />
        </div>
        <div>
          <label for={`${fieldId}-email`}>{t('forms.email')}</label>
          <input id={`${fieldId}-email`} type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
        </div>
        <div>
          <label for={`${fieldId}-phone`}>{t('forms.phoneOptional')}</label>
          <input id={`${fieldId}-phone`} type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" />
        </div>
        <div>
          <label for={`${fieldId}-people`}>{f.people}</label>
          <input id={`${fieldId}-people`} type="text" name="people" placeholder={f.peoplePlaceholder} />
        </div>
      </div>

      {fixedDates ? (
        <input type="hidden" name="dates" value={fixedDates} />
      ) : (
        <>
          <label for={`${fieldId}-dates`}>{f.dates}</label>
          <input id={`${fieldId}-dates`} type="text" name="dates" placeholder={f.datesPlaceholder} />
        </>
      )}

      <label for={`${fieldId}-message`}>{f.anythingElse}</label>
      <textarea id={`${fieldId}-message`} name="message" rows="3" placeholder={f.anythingElsePlaceholder}></textarea>

      <button class="button" type="submit">{t('forms.sendInquiry')}</button>
    </form>

    <div class="whatsapp-cta">
      <p>{t('forms.preferChat')}</p>
      <a class="button button--outline whatsapp-btn" href={whatsappHref} target="_blank" rel="noopener noreferrer">
        <svg class="whatsapp-btn__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.42 1.26 4.86L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.2h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.2a8.2 8.2 0 0 1-4.19-1.14l-.3-.18-3.15.83.84-3.07-.2-.32a8.24 8.24 0 0 1-1.26-4.36 8.25 8.25 0 1 1 8.26 8.24Zm4.53-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.36-.77-1.86-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.02 2.59.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.1-.23-.16-.48-.28Z"/></svg>
        {t('forms.messageOnWhatsapp')}
      </a>
    </div>
  </div>
</div>

<style>
  .booking-inquiry {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--tvc-line);
  }

  .booking-inquiry__heading {
    margin-top: 0;
  }

  .note {
    margin-bottom: 16px;
  }

  .inquiry-options {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .inquiry-form label {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  .inquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }

  .inquiry-form button {
    align-self: flex-start;
  }

  .whatsapp-cta {
    padding: 20px;
    border: 1px dashed var(--tvc-line);
    border-radius: var(--radius);
    text-align: center;
  }

  .whatsapp-cta p {
    margin-bottom: 12px;
  }

  /* Global, not scoped to this component - the same classes are reused
     verbatim by hand-authored event content (raw HTML in Markdown, e.g. the
     Melagiri event's own WhatsApp link) so every "message us on WhatsApp"
     affordance across the site looks identical, whether it comes from this
     component or from an event's own body. */
  :global(.whatsapp-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  :global(.whatsapp-btn__icon) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Netlify Forms spam honeypot - off-screen, not display:none (some bots
     skip hidden fields, but few check for visibility via position). */
  .inquiry-hp {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 780px) {
    .inquiry-options {
      grid-template-columns: 1fr;
    }
  }
</style>
