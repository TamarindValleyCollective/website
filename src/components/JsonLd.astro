---
// Escaping `<` prevents a value containing a literal "</script>" from
// breaking out of the script tag - JSON.stringify alone doesn't guard
// against that.
interface Props {
  items: Record<string, unknown>[];
}

const { items } = Astro.props as Props;
const payloads = items.map((item) => JSON.stringify(item).replace(/</g, '\\u003c'));
---

{payloads.map((payload) => (
  <script type="application/ld+json" set:html={payload} />
))}
