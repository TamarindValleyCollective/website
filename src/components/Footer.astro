---
import { LEGAL_ENTITY_NAME, LEGAL_ENTITY_CIN } from '../data/site-facts';
import { useTranslations, type Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const localizedHref = (href: string) => getRelativeLocaleUrl(lang, href);

const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/farm.tvc', icon: 'facebook' },
  { label: 'Twitter', href: 'https://twitter.com/TVCFarm', icon: 'twitter' },
  { label: 'Instagram', href: 'https://www.instagram.com/tamarindvalleycollective/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/tvcfarm/', icon: 'linkedin' },
] as const;

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrapper footer__top">
    <a class="footer__brand" href={localizedHref('/')}>
      <img src="/images/brand/tvc-logo-horizontal-footer.svg" alt="Tamarind Valley Collective" width="247" height="44" />
    </a>
    <p class="footer__blurb">{t('footer.tagline')}</p>
    <div class="footer__social">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
          {link.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
              <path d="M14 8.5h-1.5c-.9 0-1.5.6-1.5 1.5v1.5h3l-.4 2.5h-2.6V19h-2.5v-5h-1.8v-2.5h1.8V9.7c0-1.9 1.2-3.2 3.2-3.2H14v2Z" fill="currentColor" />
            </svg>
          )}
          {link.icon === 'twitter' && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
              <path d="M8 8l8 8M16 8l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          )}
          {link.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
              <circle cx="16.8" cy="7.2" r="1" fill="currentColor" />
            </svg>
          )}
          {link.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
              <path d="M7.2 10.2V17M7.2 7.4v.05M11 17v-4.3c0-1.5 1-2.4 2.3-2.4 1.3 0 2.1.9 2.1 2.4V17M11 10.2V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
  <div class="wrapper footer__bottom">
    <p class="footer__copy">{t('footer.copyright', { year, legalName: LEGAL_ENTITY_NAME, cin: LEGAL_ENTITY_CIN })}</p>
    <p class="footer__legal">
      {/* Unprefixed - Terms, Refund Policy, and Privacy are English-only
          legal boilerplate with no kn/ta translation (see BaseLayout's
          `translated` prop), so every locale links to the same page. */}
      <a href="/terms">{t('footer.terms')}</a>
      <span aria-hidden="true">·</span>
      <a href="/refund-policy">{t('footer.refundPolicy')}</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">{t('footer.privacy')}</a>
      <span aria-hidden="true">·</span>
      <button type="button" id="footer-cookie-prefs">{t('footer.cookiePreferences')}</button>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--tvc-green-dark);
    color: #eef5ee;
    margin-top: 64px;
  }

  .footer__top {
    padding: 20px 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer__blurb {
    margin: 0;
    font-size: 0.8rem;
    color: #b9d0bc;
    max-width: 46ch;
    flex: 1 1 320px;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #eef5ee;
    transition: color 0.15s ease;
  }

  .footer__social a:hover {
    color: var(--tvc-orange);
  }

  .footer__bottom {
    padding: 10px 24px;
    border-top: 1px solid rgba(238, 245, 238, 0.12);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .footer__copy {
    font-size: 0.75rem;
    color: #b9d0bc;
    margin: 0;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: #b9d0bc;
    margin: 0;
  }

  .footer__legal a {
    color: #eef5ee;
  }

  .footer__legal a:hover {
    color: var(--tvc-orange);
  }

  .footer__legal button {
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: none;
    padding: 0;
    color: #eef5ee;
    font: inherit;
    font-size: 0.75rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .footer__legal button:hover {
    color: var(--tvc-orange);
  }

  @media (max-width: 640px) {
    .footer__top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 20px 24px 14px;
    }

    .footer__blurb {
      max-width: 40ch;
      flex: 0 1 auto;
    }

    .footer__social {
      justify-content: center;
    }

    .footer__bottom {
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 12px 24px 20px;
    }
  }
</style>

<script>
  document.getElementById('footer-cookie-prefs')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('tvc:open-cookie-preferences'));
  });
</script>
