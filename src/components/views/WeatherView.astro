---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import WeatherWidget from '../WeatherWidget.astro';
import { type Locale } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { NIGHT_SKY_BRIGHTNESS_UCD_M2 } from '../../data/site-facts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Rainfall is logged daily at the farm into a shared Google Sheet; the
// numbers below (chart, table, "monsoon so far" stat) are fetched live from
// it client-side via netlify/functions/rainfall.mts — see src/utils/
// rainfall.ts — rather than hardcoded here, so a new row logged in the
// Sheet shows up on the site without a code change or rebuild.

// Month abbreviations for the chart axis and table - calendar month names
// are ordinary translatable prose, not machine-parsed dates, so unlike the
// day-numbers/years elsewhere on this page these do get localized.
const MONTH_ABBR: Record<Locale, Record<string, string>> = {
  en: { Apr: 'Apr', May: 'May', Jun: 'Jun', Jul: 'Jul', Aug: 'Aug', Sep: 'Sep', Oct: 'Oct', Nov: 'Nov', Dec: 'Dec', Jan: 'Jan', Feb: 'Feb', Mar: 'Mar' },
  kn: { Apr: 'ಏಪ್ರಿ', May: 'ಮೇ', Jun: 'ಜೂನ್', Jul: 'ಜುಲೈ', Aug: 'ಆಗ', Sep: 'ಸೆಪ್ಟೆಂ', Oct: 'ಅಕ್ಟೋ', Nov: 'ನವೆಂ', Dec: 'ಡಿಸೆಂ', Jan: 'ಜನ', Feb: 'ಫೆಬ್ರ', Mar: 'ಮಾರ್ಚ್' },
  ta: { Apr: 'ஏப்', May: 'மே', Jun: 'ஜூன்', Jul: 'ஜூலை', Aug: 'ஆக', Sep: 'செப்', Oct: 'அக்', Nov: 'நவ', Dec: 'டிச', Jan: 'ஜன', Feb: 'பிப்', Mar: 'மார்' },
};

const content = {
  en: {
    metaTitle: 'Weather',
    metaDescription: 'Live weather at TVC, and the rainfall and monsoon patterns that shape the seasons.',
    heroEyebrow: 'The TVC Ecosystem',
    heroTitle: 'Weather',
    heroIntro: 'Live conditions at TVC, and how rainfall moves through the year.',
    heroImageAlt: 'Sunset over the Melagiri Hills',
    introText: "Rainfall is logged daily on-site and follows the region's monsoon pattern: wet from April through October, dry the rest of the year.",
    monsoonLabel: 'This monsoon so far',
    monsoonSublabel: '(1 {apr} – {cutoffDay} {cutoffMonth} {cutoffYear})',
    monsoonDeltaLess: 'less',
    monsoonDeltaMore: 'more',
    monsoonDeltaSuffix: 'than the same stretch last year ({mm}mm)',
    chartHeading: 'Monthly rainfall, {startYear}–{endYear}',
    chartAriaLabel: 'Monthly rainfall in millimetres by calendar year, {startYear} to {endYear} — one line per year. Full figures in the table below.',
    unit: 'mm',
    tableSummary: 'Full monthly figures',
    tableMonth: 'Month',
    toDate: '(to date)',
    rainSummaryBehind: "This {year} monsoon is running {pct}% behind the same stretch last year ({mm}mm) — in line with the {enso} conditions forecasters have been tracking, which typically suppress India's southwest monsoon.",
    rainSummarySource: 'Source: {source}',
    rainfallUnavailable: "Rainfall data isn't available right now — please check back soon.",
    nightSkyStatLabel: 'Artificial sky brightness',
    nightSkyStatSublabel: '(near-zero light pollution)',
    nightSkyCta: 'See stargazing on the Visit page',
  },
  kn: {
    metaTitle: 'ಹವಾಮಾನ',
    metaDescription: 'TVC ಯಲ್ಲಿ ನೇರ ಹವಾಮಾನ, ಮತ್ತು ಋತುಗಳನ್ನು ರೂಪಿಸುವ ಮಳೆ ಮತ್ತು ಮಾನ್ಸೂನ್ ಮಾದರಿಗಳು.',
    heroEyebrow: 'TVC ಪರಿಸರ ವ್ಯವಸ್ಥೆ',
    heroTitle: 'ಹವಾಮಾನ',
    heroIntro: 'TVC ಯಲ್ಲಿ ನೇರ ಪರಿಸ್ಥಿತಿಗಳು, ಮತ್ತು ವರ್ಷವಿಡೀ ಮಳೆ ಹೇಗೆ ಚಲಿಸುತ್ತದೆ.',
    heroImageAlt: 'ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ಮೇಲೆ ಸೂರ್ಯಾಸ್ತ',
    introText: 'ಮಳೆಯನ್ನು ಸ್ಥಳದಲ್ಲೇ ಪ್ರತಿದಿನ ದಾಖಲಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಇದು ಪ್ರದೇಶದ ಮಾನ್ಸೂನ್ ಮಾದರಿಯನ್ನು ಅನುಸರಿಸುತ್ತದೆ: ಏಪ್ರಿಲ್‌ನಿಂದ ಅಕ್ಟೋಬರ್‌ವರೆಗೆ ಆರ್ದ್ರ, ಉಳಿದ ವರ್ಷ ಶುಷ್ಕ.',
    monsoonLabel: 'ಈ ಮಾನ್ಸೂನ್ ಇಲ್ಲಿಯವರೆಗೆ',
    monsoonSublabel: '(1 {apr} – {cutoffDay} {cutoffMonth} {cutoffYear})',
    monsoonDeltaLess: 'ಕಡಿಮೆ',
    monsoonDeltaMore: 'ಹೆಚ್ಚು',
    monsoonDeltaSuffix: 'ಕಳೆದ ವರ್ಷದ ಇದೇ ಅವಧಿಗಿಂತ ({mm}ಮಿಮೀ)',
    chartHeading: 'ಮಾಸಿಕ ಮಳೆ, {startYear}–{endYear}',
    chartAriaLabel: '{startYear} ಇಂದ {endYear} ವರೆಗಿನ ಪ್ರತಿ ಕ್ಯಾಲೆಂಡರ್ ವರ್ಷದ ಮಾಸಿಕ ಮಳೆ ಮಿಲಿಮೀಟರ್‌ಗಳಲ್ಲಿ — ಪ್ರತಿ ವರ್ಷಕ್ಕೂ ಒಂದು ರೇಖೆ. ಪೂರ್ಣ ಅಂಕಿಅಂಶಗಳು ಕೆಳಗಿನ ಕೋಷ್ಟಕದಲ್ಲಿವೆ.',
    unit: 'ಮಿಮೀ',
    tableSummary: 'ಪೂರ್ಣ ಮಾಸಿಕ ಅಂಕಿಅಂಶಗಳು',
    tableMonth: 'ತಿಂಗಳು',
    toDate: '(ಇಲ್ಲಿಯವರೆಗೆ)',
    rainSummaryBehind: 'ಈ {year} ಮಾನ್ಸೂನ್ ಕಳೆದ ವರ್ಷದ ಇದೇ ಅವಧಿಗಿಂತ {pct}% ಹಿಂದುಳಿದಿದೆ ({mm}ಮಿಮೀ) — ಇದು ಹವಾಮಾನ ತಜ್ಞರು ಗಮನಿಸುತ್ತಿರುವ {enso} ಪರಿಸ್ಥಿತಿಗಳಿಗೆ ಅನುಗುಣವಾಗಿದೆ, ಇದು ಸಾಮಾನ್ಯವಾಗಿ ಭಾರತದ ನೈऋತ್ಯ ಮಾನ್ಸೂನ್ ಅನ್ನು ಕುಂಠಿತಗೊಳಿಸುತ್ತದೆ.',
    rainSummarySource: 'ಮೂಲ: {source}',
    rainfallUnavailable: 'ಮಳೆಯ ಮಾಹಿತಿ ಸದ್ಯಕ್ಕೆ ಲಭ್ಯವಿಲ್ಲ — ದಯವಿಟ್ಟು ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಪರಿಶೀಲಿಸಿ.',
    nightSkyStatLabel: 'ಕೃತಕ ಆಕಾಶ ಪ್ರಕಾಶಮಾನತೆ',
    nightSkyStatSublabel: '(ಬಹುತೇಕ ಶೂನ್ಯ ಬೆಳಕಿನ ಮಾಲಿನ್ಯ)',
    nightSkyCta: 'ಭೇಟಿ ಪುಟದಲ್ಲಿ ನಕ್ಷತ್ರ ವೀಕ್ಷಣೆ ನೋಡಿ',
  },
  ta: {
    metaTitle: 'வானிலை',
    metaDescription: 'TVC-யில் நேரடி வானிலை, மற்றும் பருவங்களை வடிவமைக்கும் மழை மற்றும் பருவமழை முறைகள்.',
    heroEyebrow: 'TVC சூழலமைப்பு',
    heroTitle: 'வானிலை',
    heroIntro: 'TVC-யில் நேரடி நிலைமைகள், மற்றும் ஆண்டு முழுவதும் மழை எவ்வாறு நகர்கிறது.',
    heroImageAlt: 'மேலகிரி மலைகளின் மேல் சூரிய அஸ்தமனம்',
    introText: 'மழை தளத்திலேயே தினமும் பதிவு செய்யப்படுகிறது, மேலும் இது பிராந்தியத்தின் பருவமழை முறையைப் பின்பற்றுகிறது: ஏப்ரல் முதல் அக்டோபர் வரை ஈரம், மீதமுள்ள ஆண்டு உலர்ந்தது.',
    monsoonLabel: 'இந்த பருவமழை இதுவரை',
    monsoonSublabel: '(1 {apr} – {cutoffDay} {cutoffMonth} {cutoffYear})',
    monsoonDeltaLess: 'குறைவு',
    monsoonDeltaMore: 'அதிகம்',
    monsoonDeltaSuffix: 'கடந்த ஆண்டு இதே காலகட்டத்தை விட ({mm}மிமீ)',
    chartHeading: 'மாதாந்திர மழைப்பொழிவு, {startYear}–{endYear}',
    chartAriaLabel: '{startYear} முதல் {endYear} வரையிலான ஒவ்வொரு நாட்காட்டி ஆண்டின் மாதாந்திர மழைப்பொழிவு மில்லிமீட்டரில் — ஒவ்வொரு ஆண்டிற்கும் ஒரு கோடு. முழு புள்ளிவிவரங்கள் கீழே உள்ள அட்டவணையில்.',
    unit: 'மிமீ',
    tableSummary: 'முழு மாதாந்திர புள்ளிவிவரங்கள்',
    tableMonth: 'மாதம்',
    toDate: '(இதுவரை)',
    rainSummaryBehind: 'இந்த {year} பருவமழை கடந்த ஆண்டு இதே காலகட்டத்தை விட {pct}% குறைவாக உள்ளது ({mm}மிமீ) — வானிலை நிபுணர்கள் கண்காணித்து வரும் {enso} நிலைமைகளுக்கு இணங்க, இது பொதுவாக இந்தியாவின் தென்மேற்கு பருவமழையை பலவீனப்படுத்துகிறது.',
    rainSummarySource: 'ஆதாரம்: {source}',
    rainfallUnavailable: 'மழை தரவு இப்போது கிடைக்கவில்லை — சிறிது நேரம் கழித்து மீண்டும் பாருங்கள்.',
    nightSkyStatLabel: 'செயற்கை வான பிரகாசம்',
    nightSkyStatSublabel: '(கிட்டத்தட்ட பூஜ்ஜிய ஒளி மாசுபாடு)',
    nightSkyCta: 'விசிட் பக்கத்தில் நட்சத்திர பார்வையைப் பார்க்கவும்',
  },
} as const;

const c = content[lang];
const monthAbbrJson = JSON.stringify(MONTH_ABBR[lang]);
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDescription} image="/images/pages/home/gallery-4.jpg" imageWidth={1280} imageHeight={960}>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} image="/images/pages/home/gallery-4.jpg" imageAlt={c.heroImageAlt} />

  <section
    class="section wrapper"
    id="rainfall-section"
    data-month-abbr={monthAbbrJson}
    data-apr-label={MONTH_ABBR[lang].Apr}
    data-fmt-monsoon-sublabel={c.monsoonSublabel}
    data-fmt-delta={c.monsoonDeltaSuffix}
    data-less={c.monsoonDeltaLess}
    data-more={c.monsoonDeltaMore}
    data-fmt-chart-heading={c.chartHeading}
    data-fmt-aria-label={c.chartAriaLabel}
    data-unit={c.unit}
    data-to-date={c.toDate}
    data-fmt-rain-summary-behind={c.rainSummaryBehind}
    data-fmt-rain-summary-source={c.rainSummarySource}
    data-unavailable={c.rainfallUnavailable}
  >
    <p>{c.introText}</p>

    <div class="tile-row">
      <WeatherWidget lang={lang} />

      <div class="stat-tile">
        <p class="stat-label">{c.monsoonLabel} <span class="stat-sublabel" id="rainfall-monsoon-sublabel"></span></p>
        <p class="stat-value"><span id="rainfall-monsoon-value">–</span><span class="stat-unit">mm</span></p>
        <p class="stat-delta" id="rainfall-monsoon-delta"></p>
      </div>

      <div class="stat-tile">
        <p class="stat-label">{c.nightSkyStatLabel} <span class="stat-sublabel">{c.nightSkyStatSublabel}</span></p>
        <p class="stat-value">{NIGHT_SKY_BRIGHTNESS_UCD_M2}<span class="stat-unit">μcd/m²</span></p>
        <p class="stat-delta"><a href={getRelativeLocaleUrl(lang, '/visit')}>{c.nightSkyCta}</a></p>
      </div>
    </div>

    <p class="rainfall-summary" id="rainfall-summary" hidden>
      <span id="rainfall-summary-text"></span>
      <a id="rainfall-summary-source" href="#" target="_blank" rel="noopener noreferrer"></a>
    </p>

    <div id="rainfall-chart-section" class="rainfall-chart-wrap">
      <h2 id="rainfall-chart-heading">&nbsp;</h2>
      <ul class="rainfall-legend" id="rainfall-legend"></ul>
      <div class="rainfall-chart-frame">
        <svg class="rainfall-chart" id="rainfall-chart-svg" viewBox="0 0 720 240" role="img"></svg>
        <div class="rainfall-tooltip" id="rainfall-tooltip" role="status" aria-live="polite" hidden></div>
      </div>

      <details class="rainfall-table-details">
        <summary>{c.tableSummary}</summary>
        <div class="rainfall-table-scroll">
          <table class="rainfall-table">
            <thead>
              <tr id="rainfall-table-head">
                <th>{c.tableMonth}</th>
              </tr>
            </thead>
            <tbody id="rainfall-table-body"></tbody>
          </table>
        </div>
      </details>
    </div>

    <p class="rainfall-error" id="rainfall-error" hidden>{c.rainfallUnavailable}</p>
  </section>
</BaseLayout>

<style>
  .tile-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 20px;
    margin: 20px 0;
  }

  .tile-row .stat-tile,
  :global(.tile-row .weather-widget) {
    flex: 1 1 260px;
    max-width: 340px;
    margin: 0;
  }

  .stat-tile {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 20px 24px;
    max-width: 360px;
    margin: 20px 0;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tvc-ink-soft);
    margin: 0;
  }

  .stat-sublabel {
    font-weight: 400;
  }

  .stat-value {
    font-family: var(--font-display, inherit);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--tvc-green-dark);
    margin: 4px 0;
    line-height: 1;
  }

  .stat-unit {
    font-size: 1.1rem;
    font-weight: 600;
    margin-left: 4px;
    color: var(--tvc-ink-soft);
  }

  .stat-delta {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 0;
  }

  /* Categorical line colors — dataviz skill's validated default palette,
     first 5 slots, assigned by chronological order among the years shown
     (never by value) so a year keeps its color as new years arrive. Only
     line charts need adjacent-pair separation (not all-pairs, per the
     skill), and this site has no dark mode, so light-mode hexes only. */
  .rainfall-chart-wrap {
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --series-4: #eda100;
    --series-5: #e87ba4;
    --series-6: #008300;
    --series-7: #4a3aa7;
    --series-8: #e34948;
    --chart-surface: #faf7ee;
  }

  .rainfall-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .rainfall-legend :global(li) {
    display: flex;
    align-items: center;
  }

  .rainfall-legend :global(label) {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .rainfall-legend :global(input[type='checkbox']) {
    margin: 0;
    accent-color: var(--tvc-green);
    cursor: pointer;
  }

  .rainfall-legend :global(.swatch) {
    display: inline-block;
    width: 16px;
    height: 2px;
    border-radius: 1px;
  }

  .rainfall-chart :global(.year-hidden),
  .rainfall-table :global(.year-hidden) {
    display: none;
  }

  .rainfall-summary {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 12px 0 0;
  }

  .rainfall-summary #rainfall-summary-source {
    margin-left: 6px;
    white-space: nowrap;
  }

  .rainfall-chart-frame {
    position: relative;
  }

  .rainfall-chart {
    width: 100%;
    max-width: 720px;
    height: auto;
    margin-top: 8px;
  }

  .rainfall-chart :global(.grid-line) {
    stroke: var(--tvc-line);
    stroke-width: 1;
  }

  .rainfall-chart :global(.axis-label) {
    font-size: 11px;
    fill: var(--tvc-ink-soft);
  }

  .rainfall-chart :global(.year-line) {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rainfall-chart :global(.end-dot) {
    stroke: var(--chart-surface);
    stroke-width: 2;
  }

  .rainfall-chart :global(.end-label) {
    font-size: 12px;
    font-weight: 700;
    fill: var(--tvc-ink);
  }

  .rainfall-chart :global(.crosshair) {
    stroke: var(--tvc-line);
    stroke-width: 1;
  }

  .rainfall-chart :global(.hit-col) {
    fill: transparent;
  }

  .rainfall-chart :global(.hit-col:focus-visible) {
    outline: 2px solid var(--tvc-green);
    outline-offset: -2px;
  }

  .rainfall-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
    box-shadow: var(--shadow-soft);
    padding: 8px 10px;
    font-size: 0.8rem;
    min-width: 110px;
    transform: translate(-50%, -100%);
    z-index: 2;
  }

  .rainfall-tooltip :global(.tooltip-month) {
    font-weight: 600;
    color: var(--tvc-ink);
    margin: 0 0 4px;
  }

  .rainfall-tooltip :global(.tooltip-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0;
  }

  .rainfall-tooltip :global(.tooltip-key) {
    display: inline-block;
    width: 10px;
    height: 2px;
    border-radius: 1px;
    flex-shrink: 0;
  }

  .rainfall-tooltip :global(.tooltip-year) {
    color: var(--tvc-ink-soft);
  }

  .rainfall-tooltip :global(.tooltip-value) {
    font-weight: 700;
    color: var(--tvc-ink);
    margin-left: auto;
  }

  .rainfall-table-details {
    margin-top: 20px;
  }

  .rainfall-table-details summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .rainfall-table-scroll {
    overflow-x: auto;
  }

  .rainfall-table {
    width: 100%;
    max-width: 560px;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 0.9rem;
  }

  .rainfall-table th,
  .rainfall-table td {
    text-align: left;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--tvc-line);
    font-variant-numeric: tabular-nums;
  }

  .rainfall-table th {
    color: var(--tvc-ink-soft);
    font-weight: 600;
  }

  .rainfall-error {
    color: var(--tvc-ink-soft);
    font-style: italic;
  }
</style>

<script>
  import { fetchRainfall, buildLineChartGeometry, CALENDAR_MONTH_ORDER, type CalendarYearSeries, type CalendarMonthEntry } from '../../utils/rainfall';

  const svgNS = 'http://www.w3.org/2000/svg';

  interface DisplayYear {
    year: number;
    monthly: CalendarMonthEntry[];
    colorVar: string;
  }

  // General, verified context for the "This monsoon so far" stat — not a
  // claim about this one farm's rain gauge specifically, just the national
  // ENSO backdrop for years where it's actually been reported. Years without
  // a verified entry here simply don't get the extra sentence (see below) —
  // no source, no claim, rather than guessing.
  const ENSO_CONTEXT: Record<number, { phase: string; sourceLabel: string; sourceUrl: string }> = {
    2023: {
      phase: 'El Niño',
      sourceLabel: 'Down To Earth, Jun 2026',
      sourceUrl: 'https://www.downtoearth.org.in/climate-change/monsoon-2026-has-arrived-but-indias-rain-season-begins-under-el-ni%C3%B1o-shadow',
    },
    2026: {
      phase: 'El Niño',
      sourceLabel: 'Down To Earth, Jun 2026',
      sourceUrl: 'https://www.downtoearth.org.in/climate-change/monsoon-2026-has-arrived-but-indias-rain-season-begins-under-el-ni%C3%B1o-shadow',
    },
  };

  function fmt(template: string, params: Record<string, string | number>): string {
    return Object.entries(params).reduce((s, [k, v]) => s.replaceAll(`{${k}}`, String(v)), template);
  }

  function renderChart(svg: SVGSVGElement, calendarYears: CalendarYearSeries[], monthAbbr: (m: string) => string, unitLabel: string) {
    const geometry = buildLineChartGeometry(calendarYears);
    svg.setAttribute('viewBox', `0 0 ${geometry.chartWidth} ${geometry.chartHeight}`);
    svg.innerHTML = '';

    for (const tick of geometry.yTicks) {
      const ty = geometry.chartPadTop + (geometry.plotHeight - (tick / geometry.maxMm) * geometry.plotHeight);

      const line = document.createElementNS(svgNS, 'line');
      line.setAttribute('x1', String(geometry.chartPadLeft));
      line.setAttribute('x2', String(geometry.chartWidth - 16));
      line.setAttribute('y1', String(ty));
      line.setAttribute('y2', String(ty));
      line.setAttribute('class', 'grid-line');
      svg.appendChild(line);

      const label = document.createElementNS(svgNS, 'text');
      label.setAttribute('x', String(geometry.chartPadLeft - 8));
      label.setAttribute('y', String(ty + 4));
      label.setAttribute('class', 'axis-label');
      label.setAttribute('text-anchor', 'end');
      label.textContent = String(tick);
      svg.appendChild(label);
    }

    CALENDAR_MONTH_ORDER.forEach((month, i) => {
      const label = document.createElementNS(svgNS, 'text');
      label.setAttribute('x', String(geometry.monthX[i]));
      label.setAttribute('y', String(geometry.chartHeight - 6));
      label.setAttribute('class', 'axis-label');
      label.setAttribute('text-anchor', i === 0 ? 'start' : i === CALENDAR_MONTH_ORDER.length - 1 ? 'end' : 'middle');
      label.textContent = monthAbbr(month);
      svg.appendChild(label);
    });

    for (const year of geometry.years) {
      if (!year.pathD) continue;
      const path = document.createElementNS(svgNS, 'path');
      path.setAttribute('d', year.pathD);
      path.setAttribute('class', 'year-line');
      path.setAttribute('data-year', String(year.year));
      path.setAttribute('style', `stroke: var(${year.colorVar})`);
      svg.appendChild(path);
    }

    // Direct end-label: only the most recent year, and only when it's still
    // in progress (doesn't reach December) — the one line whose stopping
    // point is itself the story. Complete years already read as "reaches
    // the right edge" without needing a label.
    const lastYear = geometry.years[geometry.years.length - 1];
    if (lastYear?.endPoint && lastYear.endPoint.month !== 'Dec') {
      const dot = document.createElementNS(svgNS, 'circle');
      dot.setAttribute('cx', String(lastYear.endPoint.x));
      dot.setAttribute('cy', String(lastYear.endPoint.y));
      dot.setAttribute('r', '4');
      dot.setAttribute('class', 'end-dot');
      dot.setAttribute('data-year', String(lastYear.year));
      dot.setAttribute('style', `fill: var(${lastYear.colorVar})`);
      svg.appendChild(dot);

      const label = document.createElementNS(svgNS, 'text');
      label.setAttribute('x', String(lastYear.endPoint.x));
      label.setAttribute('y', String(lastYear.endPoint.y - 10));
      label.setAttribute('class', 'end-label');
      label.setAttribute('data-year', String(lastYear.year));
      label.setAttribute('text-anchor', lastYear.endPoint.month === 'Jan' ? 'start' : 'middle');
      label.textContent = `${lastYear.endPoint.mm}${unitLabel}`;
      svg.appendChild(label);
    }

    return geometry;
  }

  // Legend doubles as the year filter — each row is a real checkbox (native
  // keyboard/AT support for free), checked by default. onToggle re-applies
  // visibility to the chart and table, which stay built once and just show
  ///hide their per-year elements rather than re-rendering (see
  // applyVisibility() below) — that's also what keeps a year's color fixed
  // when other years are toggled off, instead of re-assigning slots by the
  // now-smaller series count.
  function renderLegend(container: HTMLElement, years: DisplayYear[], onToggle: (year: number, visible: boolean) => void) {
    container.innerHTML = '';
    for (const year of years) {
      const li = document.createElement('li');
      const label = document.createElement('label');

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = true;
      checkbox.addEventListener('change', () => onToggle(year.year, checkbox.checked));
      label.appendChild(checkbox);

      const swatch = document.createElement('span');
      swatch.className = 'swatch';
      swatch.style.background = `var(${year.colorVar})`;
      label.appendChild(swatch);

      const text = document.createElement('span');
      text.textContent = String(year.year);
      label.appendChild(text);

      li.appendChild(label);
      container.appendChild(li);
    }
  }

  function renderTable(
    theadRow: HTMLTableRowElement,
    tbody: HTMLElement,
    years: DisplayYear[],
    monthAbbr: (m: string) => string,
    toDateLabel: string,
    unitLabel: string
  ) {
    theadRow.querySelectorAll('th.year-col').forEach((el) => el.remove());
    for (const y of years) {
      const th = document.createElement('th');
      th.className = 'year-col';
      th.dataset.year = String(y.year);
      th.textContent = `${y.year} (${unitLabel})`;
      theadRow.appendChild(th);
    }

    const lastYear = years[years.length - 1];
    const lastRealMonth = lastYear?.monthly.filter((m) => m.mm != null).at(-1)?.month;

    tbody.innerHTML = '';
    CALENDAR_MONTH_ORDER.forEach((month, i) => {
      const tr = document.createElement('tr');
      const tdMonth = document.createElement('td');
      tdMonth.textContent = monthAbbr(month);
      tr.appendChild(tdMonth);

      for (const y of years) {
        const entry = y.monthly[i];
        const td = document.createElement('td');
        td.dataset.year = String(y.year);
        if (entry.mm == null) {
          td.textContent = '—';
        } else {
          const suffix = y === lastYear && month === lastRealMonth ? ` ${toDateLabel}` : '';
          td.textContent = `${entry.mm.toFixed(1)}${suffix}`;
        }
        tr.appendChild(td);
      }

      tbody.appendChild(tr);
    });
  }

  // Hover/focus crosshair + tooltip, one hit target per calendar month,
  // showing every year's value at that month — "one tooltip, every series"
  // (see the dataviz skill's interaction guidance). Keyboard focus mirrors
  // hover exactly, via the same show/hide pair.
  function attachInteraction(
    svg: SVGSVGElement,
    frame: HTMLElement,
    tooltip: HTMLElement,
    geometry: ReturnType<typeof buildLineChartGeometry>,
    years: DisplayYear[],
    monthAbbr: (m: string) => string,
    unitLabel: string,
    isHidden: (year: number) => boolean
  ) {
    const crosshair = document.createElementNS(svgNS, 'line');
    crosshair.setAttribute('class', 'crosshair');
    crosshair.setAttribute('y1', String(geometry.chartPadTop));
    crosshair.setAttribute('y2', String(geometry.chartPadTop + geometry.plotHeight));
    crosshair.setAttribute('visibility', 'hidden');
    svg.appendChild(crosshair);

    const bounds = geometry.monthX.map((x, i) => {
      const prev = geometry.monthX[i - 1];
      const next = geometry.monthX[i + 1];
      const left = prev !== undefined ? (prev + x) / 2 : geometry.chartPadLeft;
      const right = next !== undefined ? (x + next) / 2 : geometry.chartWidth - 16;
      return { left, right };
    });

    function showMonth(i: number) {
      const month = CALENDAR_MONTH_ORDER[i];
      const rows = years
        .filter((y) => !isHidden(y.year))
        .map((y) => ({ year: y.year, colorVar: y.colorVar, mm: y.monthly[i]?.mm ?? null }))
        .filter((r) => r.mm != null);
      if (rows.length === 0) return;

      crosshair.setAttribute('x1', String(geometry.monthX[i]));
      crosshair.setAttribute('x2', String(geometry.monthX[i]));
      crosshair.setAttribute('visibility', 'visible');

      tooltip.innerHTML = '';
      const monthEl = document.createElement('p');
      monthEl.className = 'tooltip-month';
      monthEl.textContent = monthAbbr(month);
      tooltip.appendChild(monthEl);

      for (const row of rows) {
        const rowEl = document.createElement('p');
        rowEl.className = 'tooltip-row';
        const key = document.createElement('span');
        key.className = 'tooltip-key';
        key.style.background = `var(${row.colorVar})`;
        rowEl.appendChild(key);
        const yearEl = document.createElement('span');
        yearEl.className = 'tooltip-year';
        yearEl.textContent = String(row.year);
        rowEl.appendChild(yearEl);
        const valueEl = document.createElement('span');
        valueEl.className = 'tooltip-value';
        valueEl.textContent = `${row.mm!.toFixed(1)}${unitLabel}`;
        rowEl.appendChild(valueEl);
        tooltip.appendChild(rowEl);
      }

      const svgRect = svg.getBoundingClientRect();
      const frameRect = frame.getBoundingClientRect();
      const scale = svgRect.width / geometry.chartWidth;
      tooltip.style.left = `${svgRect.left - frameRect.left + geometry.monthX[i] * scale}px`;
      tooltip.style.top = `${svgRect.top - frameRect.top + geometry.chartPadTop * scale}px`;
      tooltip.hidden = false;
    }

    function hide() {
      crosshair.setAttribute('visibility', 'hidden');
      tooltip.hidden = true;
    }

    function ariaLabelFor(i: number): string {
      const month = CALENDAR_MONTH_ORDER[i];
      const summary = years
        .filter((y) => !isHidden(y.year))
        .map((y) => (y.monthly[i]?.mm != null ? `${y.year}: ${y.monthly[i].mm!.toFixed(1)}${unitLabel}` : null))
        .filter(Boolean)
        .join(', ');
      return `${monthAbbr(month)}: ${summary || '—'}`;
    }

    const rects = bounds.map((b, i) => {
      const rect = document.createElementNS(svgNS, 'rect');
      rect.setAttribute('x', String(b.left));
      rect.setAttribute('y', String(geometry.chartPadTop));
      rect.setAttribute('width', String(Math.max(0, b.right - b.left)));
      rect.setAttribute('height', String(geometry.plotHeight));
      rect.setAttribute('class', 'hit-col');
      rect.setAttribute('tabindex', '0');
      rect.setAttribute('aria-label', ariaLabelFor(i));
      rect.addEventListener('pointerenter', () => showMonth(i));
      rect.addEventListener('pointermove', () => showMonth(i));
      rect.addEventListener('pointerleave', hide);
      rect.addEventListener('focus', () => showMonth(i));
      rect.addEventListener('blur', hide);
      svg.appendChild(rect);
      return rect;
    });

    return {
      refreshAria() {
        rects.forEach((rect, i) => rect.setAttribute('aria-label', ariaLabelFor(i)));
      },
    };
  }

  (async () => {
    const section = document.getElementById('rainfall-section');
    const svg = document.getElementById('rainfall-chart-svg') as SVGSVGElement | null;
    const frame = document.querySelector('.rainfall-chart-frame') as HTMLElement | null;
    const tooltip = document.getElementById('rainfall-tooltip');
    const legend = document.getElementById('rainfall-legend');
    const theadRow = document.getElementById('rainfall-table-head') as HTMLTableRowElement | null;
    const tableBody = document.getElementById('rainfall-table-body');
    if (!section || !svg || !frame || !tooltip || !legend || !theadRow || !tableBody) return;

    const monthAbbrMap: Record<string, string> = JSON.parse(section.dataset.monthAbbr || '{}');
    const monthAbbr = (m: string) => monthAbbrMap[m] ?? m;

    try {
      const data = await fetchRainfall();

      // Monsoon-to-date stat tile — unchanged, still the agricultural-year framing
      document.getElementById('rainfall-monsoon-value')!.textContent =
        data.monsoonToDate != null ? data.monsoonToDate.toFixed(1) : '—';
      document.getElementById('rainfall-monsoon-sublabel')!.textContent = fmt(section.dataset.fmtMonsoonSublabel || '', {
        apr: section.dataset.aprLabel || 'Apr',
        cutoffDay: data.cutoffDay,
        cutoffMonth: monthAbbr(data.cutoffMonth),
        cutoffYear: data.cutoffCalendarYear,
      });
      if (data.monsoonToDate != null && data.sameSpanLastYear != null && data.sameSpanLastYear > 0) {
        const deltaPct = Math.round(((data.monsoonToDate - data.sameSpanLastYear) / data.sameSpanLastYear) * 100);
        const deltaWord = deltaPct < 0 ? section.dataset.less : section.dataset.more;
        const deltaSuffix = fmt(section.dataset.fmtDelta || '', { mm: data.sameSpanLastYear.toFixed(1) });
        document.getElementById('rainfall-monsoon-delta')!.textContent = `${Math.abs(deltaPct)}% ${deltaWord} ${deltaSuffix}`;

        // Short context sentence, live off the same numbers as the stat
        // tile above — only shown for a year with a verified ENSO source
        // (see ENSO_CONTEXT), so it goes quiet rather than guessing once
        // that source falls out of date.
        const enso = deltaPct < 0 ? ENSO_CONTEXT[data.cutoffCalendarYear] : undefined;
        if (enso) {
          const summaryEl = document.getElementById('rainfall-summary');
          const textEl = document.getElementById('rainfall-summary-text');
          const sourceEl = document.getElementById('rainfall-summary-source') as HTMLAnchorElement | null;
          if (summaryEl && textEl && sourceEl) {
            textEl.textContent = fmt(section.dataset.fmtRainSummaryBehind || '', {
              year: data.cutoffCalendarYear,
              pct: Math.abs(deltaPct),
              mm: data.sameSpanLastYear.toFixed(1),
              enso: enso.phase,
            });
            sourceEl.textContent = fmt(section.dataset.fmtRainSummarySource || '', { source: enso.sourceLabel });
            sourceEl.href = enso.sourceUrl;
            summaryEl.hidden = false;
          }
        }
      }

      if (data.calendarYears.length === 0) throw new Error('No calendar-year rainfall data');

      const unitLabel = section.dataset.unit || 'mm';

      // Chart: one smooth line per calendar year, Jan-Dec
      const geometry = renderChart(svg, data.calendarYears, monthAbbr, unitLabel);
      const years: DisplayYear[] = data.calendarYears.map((y, i) => ({ year: y.year, monthly: y.monthly, colorVar: geometry.years[i].colorVar }));

      const startYear = years[0].year;
      const endYear = years[years.length - 1].year;
      document.getElementById('rainfall-chart-heading')!.textContent = fmt(section.dataset.fmtChartHeading || '', { startYear, endYear });
      svg.setAttribute('aria-label', fmt(section.dataset.fmtAriaLabel || '', { startYear, endYear }));

      // Year filter: the legend's checkboxes toggle a `year-hidden` class on
      // that year's pre-built chart/table elements (matched via
      // `data-year`) rather than re-rendering — keeps every year's color
      // and the y-axis scale fixed regardless of what's shown or hidden.
      const hiddenYears = new Set<number>();
      function applyVisibility(year: number, visible: boolean) {
        if (visible) hiddenYears.delete(year);
        else hiddenYears.add(year);
        svg!.querySelectorAll(`[data-year="${year}"]`).forEach((el) => el.classList.toggle('year-hidden', !visible));
        theadRow!.querySelectorAll(`[data-year="${year}"]`).forEach((el) => el.classList.toggle('year-hidden', !visible));
        tableBody!.querySelectorAll(`[data-year="${year}"]`).forEach((el) => el.classList.toggle('year-hidden', !visible));
        interaction.refreshAria();
      }

      const interaction = attachInteraction(svg, frame, tooltip, geometry, years, monthAbbr, unitLabel, (year) => hiddenYears.has(year));
      renderLegend(legend, years, applyVisibility);
      renderTable(theadRow, tableBody, years, monthAbbr, section.dataset.toDate || '', unitLabel);
    } catch (err) {
      console.warn('Could not load live rainfall data', err);
      const chartSection = document.getElementById('rainfall-chart-section');
      const errorEl = document.getElementById('rainfall-error');
      const deltaEl = document.getElementById('rainfall-monsoon-delta');
      if (chartSection) chartSection.hidden = true;
      if (errorEl) errorEl.hidden = false;
      if (deltaEl) deltaEl.textContent = section.dataset.unavailable || '';
    }
  })();
</script>
