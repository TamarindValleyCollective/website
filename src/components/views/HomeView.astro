<script>
  // Fades the fixed background image+scrim out over the first stretch of
  // scroll -- the page's actual content (hero heading/intro/stats, and
  // everything after) is normal, unanimated document flow that simply
  // scrolls over this backdrop, per the brief: only the background
  // picture fades, nothing in the foreground does.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const imageEl = document.getElementById('hero-image');
  const scrimEl = document.getElementById('hero-scrim');

  // No `autoplay` attribute in the markup on purpose -- reduced-motion
  // visitors should just see the poster frame, never the moving video, so
  // playback is only ever started here, gated on the same check the
  // scroll-fade below is gated on.
  if (imageEl instanceof HTMLVideoElement && !reduceMotion) {
    const video = imageEl;
    video.play().catch(() => {
      // Safari can reject this even for a muted, playsinline video -- iOS
      // Low Power Mode disables all video autoplay outright, and Safari's
      // own per-site "Auto-Play" setting can too. Neither blocks playback
      // started from a user gesture, so retry on the visitor's first
      // interaction instead of leaving the poster frame up for good.
      const retry = () => {
        video.play().catch(() => {});
        events.forEach((e) => window.removeEventListener(e, retry));
      };
      const events = ['touchstart', 'scroll', 'click'];
      events.forEach((e) => window.addEventListener(e, retry, { once: true, passive: true }));
    });
  }

  // Smoothstep ease -- a linear opacity ramp reads as mechanical; this
  // makes the same scroll distance feel like a deliberate, settling fade.
  function ease(t: number) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  if (imageEl && scrimEl && !reduceMotion) {
    const heroImage = imageEl;
    const heroScrim = scrimEl;
    let ticking = false;

    function update() {
      ticking = false;
      // Fully faded by one viewport height of scroll -- roughly the point
      // the hero's own content has scrolled out of view anyway, so the
      // backdrop is gone by the time it'd otherwise show through gaps in
      // whatever comes next. Recomputed each time rather than cached, so
      // a resize (e.g. rotating a tablet) doesn't leave a stale distance.
      const fadeDistance = window.innerHeight;
      const progress = Math.min(Math.max(window.scrollY / fadeDistance, 0), 1);
      const opacity = String(1 - ease(progress));
      heroImage.style.opacity = opacity;
      heroScrim.style.opacity = opacity;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
