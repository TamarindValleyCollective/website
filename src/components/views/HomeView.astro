---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeStats from '../HomeStats.astro';
import WhatsNextBanner from '../WhatsNextBanner.astro';
import { PRINCIPLES } from '../../data/principles';
import { FARM_AREA_ACRES } from '../../data/site-facts';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Card/rung data is locale-agnostic (href, img, step, tone) - only the
// prose per card/rung lives in the content object below, keyed by the same
// index as its English counterpart.
const exploreLinks = [
  { href: '/about', img: '/images/pages/home/gallery-1.jpg' },
  { href: '/people', img: '/images/members/ananth-and-manasa.jpg' },
  { href: '/our-journey', img: '/images/pages/journey/hero.jpg' },
  { href: '/in-pictures', img: 'https://media.tvc.farm/photos/2024/2024-08-18-img-1880-display.jpg' },
  { href: '/ecosystem/biodiversity', img: '/images/pages/trekking/watering-hole.jpg' },
  { href: '/ecosystem/landscape', img: '/images/pages/home/gallery-2.jpg' },
  { href: '/ecosystem/weather', img: '/images/pages/home/gallery-4.jpg' },
  { href: '/resource-centre', img: '/images/products/tamarind-chutney.jpeg' },
  { href: '/events', img: '/images/events/2026-08-01-foraging-day/hero.jpeg' },
];

// Deliberately 5 curated rungs, not a 1:1 mirror of every ENGAGE_LINKS page
// the way exploreLinks mirrors EXPLORE_LINKS -- this ladder is "levels of
// engagement" (day visit -> overnight -> work with us -> host an event ->
// join), not a page index. Trekking Trails and How to Reach are folded
// into the "Come for a day"/"Spend the night" rungs they support; Contact
// Us has no rung since it isn't a level of engagement in its own right.
// Host an Event breaks that "not a page index" rule on purpose -- it's a
// revenue goal, not just another page, so it gets the same homepage
// prominence as the other paid stays.
const engageLinks = [
  { step: '01', href: '/visit/day-visit', img: '/images/pages/home/gallery-2.jpg', tone: 'tone-1' },
  { step: '02', href: '/visit/camping', img: '/images/pages/while-at-farm/hero.jpg', tone: 'tone-2' },
  { step: '03', href: '/visit', img: '/images/pages/home/gallery-3.jpg', tone: 'tone-3' },
  { step: '04', href: '/visit/host-an-event', img: '/images/pages/trekking/hilltop.jpg', tone: 'tone-4' },
  { step: '05', href: '/join', img: '/images/members/reva-and-ranjan.jpg', tone: 'tone-5' },
];

// Page-specific prose only - shared chrome (nav/footer/principle names)
// comes from src/i18n/*.ts via t() above. The two closing quotes are an
// AI-assisted rendering of Fukuoka's/Krishnamurti's words into
// Kannada/Tamil, not an authoritative translation (flagged for review like
// the rest of this pass) - the attribution names stay unchanged.
const content = {
  en: {
    metaDescription: `Not just a farm — a regenerative ecosystem: ${FARM_AREA_ACRES} acres of the Melagiri Hills near Kanakapura, regenerated by 53 families since 2017 through permaculture and reforestation.`,
    heroEyebrow: 'Not just a farm — a regenerative ecosystem.',
    heroTitle: 'Regenerating a Corner of the Melagiris',
    heroIntro: 'Once stripped bare by exploitative farming, now a thriving food forest and wildlife habitat — permaculture and reforestation turned it around.',
    forkEyebrow: 'How would you like to spend time here?',
    forkTitle: 'Explore, or engage',
    forkIntro: 'Learn about the land and the people, or come experience it yourself — from a first visit to joining the collective.',
    doorExploreTag: 'Learn',
    doorExploreTitle: 'Explore TVC',
    doorExploreDesc: 'Our story, the land, the journey so far, and the life it holds — nine years of it.',
    doorExploreArrow: 'See everything ↓',
    doorEngageTag: 'Take part',
    doorEngageTitle: 'Engage with TVC',
    doorEngageDesc: 'Visit for a day, stay the night, work alongside us, or learn how membership works.',
    doorEngageArrow: 'Find your level ↓',
    principlesMore: 'More on what we stand for →',
    exploreLabel: 'Explore',
    exploreHint: 'Every informational page on the site',
    exploreCards: [
      { title: 'About Us', desc: 'Why TVC exists, what we stand for, and how the land is laid out.' },
      { title: 'People', desc: 'The member families, local staff, partners, and community that make TVC possible.' },
      { title: 'Our Journey', desc: 'From degraded land to a regenerating ecosystem, walked year by year in photos.' },
      { title: 'In Pictures', desc: "Pictures are worth 10,000 words — an old proverb, still true." },
      { title: 'Biodiversity', desc: 'Over 100 bird species — live sightings from iNaturalist.' },
      { title: 'Geography', desc: "Where TVC sits in the Melagiri Hills, and its place in a wider wildlife corridor." },
      { title: 'Weather', desc: 'Live weather at TVC, and the rainfall and monsoon patterns that shape the seasons.' },
      { title: 'Resource Centre', desc: 'Lantana furniture and learning programs from TVC.' },
      { title: 'Events', desc: 'Camps, workshops, biodiversity walks, and retreats — upcoming and past.' },
    ],
    engageLabel: 'Engage',
    engageHint: 'Four levels, one ladder',
    engageRungs: [
      { tag: 'Visit us — a day trip', title: 'Come for a day', desc: 'A farm tour, bird watching, star gazing, board games by the fire — a Picnic, a Hike, or a Do Nothing day, hour by hour.', cta: 'Plan a day visit →' },
      { tag: 'Stay with us — overnight', title: 'Spend the night', desc: 'A two-day stay under some of the darkest skies around — sunset hike, campfire, and a guided farm tour.', cta: 'Book an overnight stay →' },
      { tag: 'Work with us — events & volunteering', title: 'Bring your team, or your hands', desc: 'Team outings for up to 20, workshops on permaculture and bamboo craft, or volunteer — chopping, planting, harvesting.', cta: 'See events & volunteering →' },
      { tag: 'Bring your own — retreats & camps', title: 'Host your event here', desc: "Nature retreats, biodiversity walks, or a week-long deep-focus tech camp like The Lambda Retreat — bring your own event, camping included.", cta: 'See how to host an event →' },
      { tag: 'Joining the collective', title: 'A note on membership', desc: "We're unlikely to expand — 53 families is likely as large as we'll get. Occasionally a member moves on, and their place passes privately to someone new. Here's how that actually works.", cta: 'Read how it works →' },
    ],
    quote1Text: '"Modern research divides nature into tiny pieces and conducts tests that conform neither with natural law nor with practical experience. The results are arranged for the convenience of research, not according to the needs of the farmer."',
    quote2Text: '"Have you ever woken up in the morning and looked out of the window, or gone out and looked at the trees and the spring dawn? Live with it. Listen to all the sounds, to the whisper, the slight breeze among the leaves... When you have such communion with nature, then your relationship with another person becomes simple, clear, without conflict."',
  },
  kn: {
    metaDescription: `ಇದು ಕೇವಲ ಒಂದು ಫಾರ್ಮ್ ಅಲ್ಲ — ಒಂದು ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿರುವ ಪರಿಸರ ವ್ಯವಸ್ಥೆ: ಕನಕಪುರದ ಬಳಿಯ ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ${FARM_AREA_ACRES} ಎಕರೆಗಳು, 2017ರಿಂದ 53 ಕುಟುಂಬಗಳಿಂದ ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಮರು ಅರಣ್ಯೀಕರಣದ ಮೂಲಕ ಪುನರುಜ್ಜೀವನಗೊಂಡಿದೆ.`,
    heroEyebrow: 'ಇದು ಕೇವಲ ಒಂದು ಫಾರ್ಮ್ ಅಲ್ಲ — ಒಂದು ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿರುವ ಪರಿಸರ ವ್ಯವಸ್ಥೆ.',
    heroTitle: 'ಮೇಲಗಿರಿಗಳ ಒಂದು ಮೂಲೆಯನ್ನು ಪುನರುಜ್ಜೀವನಗೊಳಿಸುವುದು',
    heroIntro: 'ಒಮ್ಮೆ ಶೋಷಣಾತ್ಮಕ ಕೃಷಿಯಿಂದ ಬರಿದಾಗಿ ಸುಲಿದಿತ್ತು, ಈಗ ಒಂದು ಸಮೃದ್ಧ ಆಹಾರ ಅರಣ್ಯ ಮತ್ತು ವನ್ಯಜೀವಿ ಆವಾಸಸ್ಥಾನ — ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಮರು ಅರಣ್ಯೀಕರಣ ಇದನ್ನು ಬದಲಾಯಿಸಿತು.',
    forkEyebrow: 'ನೀವು ಇಲ್ಲಿ ಸಮಯವನ್ನು ಹೇಗೆ ಕಳೆಯಲು ಬಯಸುತ್ತೀರಿ?',
    forkTitle: 'ಅನ್ವೇಷಿಸಿ, ಅಥವಾ ಭಾಗಿಯಾಗಿ',
    forkIntro: 'ಭೂಮಿ ಮತ್ತು ಜನರ ಬಗ್ಗೆ ತಿಳಿದುಕೊಳ್ಳಿ, ಅಥವಾ ಸ್ವತಃ ಬಂದು ಅನುಭವಿಸಿ — ಮೊದಲ ಭೇಟಿಯಿಂದ ಹಿಡಿದು ಸಂಘಟನೆಗೆ ಸೇರುವವರೆಗೆ.',
    doorExploreTag: 'ಕಲಿಯಿರಿ',
    doorExploreTitle: 'TVC ಅನ್ನು ಅನ್ವೇಷಿಸಿ',
    doorExploreDesc: 'ನಮ್ಮ ಕಥೆ, ಭೂಮಿ, ಇಲ್ಲಿಯವರೆಗಿನ ಪಯಣ, ಮತ್ತು ಅದು ಹೊಂದಿರುವ ಜೀವನ — ಒಂಬತ್ತು ವರ್ಷಗಳ ಪಯಣ.',
    doorExploreArrow: 'ಎಲ್ಲವನ್ನೂ ನೋಡಿ ↓',
    doorEngageTag: 'ಭಾಗವಹಿಸಿ',
    doorEngageTitle: 'TVC ಜೊತೆ ಭಾಗಿಯಾಗಿ',
    doorEngageDesc: 'ಒಂದು ದಿನ ಭೇಟಿ ನೀಡಿ, ರಾತ್ರಿ ಉಳಿಯಿರಿ, ನಮ್ಮೊಂದಿಗೆ ಕೆಲಸ ಮಾಡಿ, ಅಥವಾ ಸದಸ್ಯತ್ವ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ.',
    doorEngageArrow: 'ನಿಮ್ಮ ಮಟ್ಟವನ್ನು ಹುಡುಕಿ ↓',
    principlesMore: 'ನಾವು ಏನನ್ನು ಪ್ರತಿಪಾದಿಸುತ್ತೇವೆ ಎಂಬುದರ ಕುರಿತು ಇನ್ನಷ್ಟು →',
    exploreLabel: 'ಅನ್ವೇಷಿಸಿ',
    exploreHint: 'ಸೈಟ್‌ನ ಪ್ರತಿಯೊಂದು ಮಾಹಿತಿ ಪುಟ',
    exploreCards: [
      { title: 'ನಮ್ಮ ಬಗ್ಗೆ', desc: 'TVC ಏಕೆ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ, ನಾವು ಏನನ್ನು ಪ್ರತಿಪಾದಿಸುತ್ತೇವೆ, ಮತ್ತು ಭೂಮಿಯನ್ನು ಹೇಗೆ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ.' },
      { title: 'ಜನರು', desc: 'TVC ಅನ್ನು ಸಾಧ್ಯವಾಗಿಸುವ ಸದಸ್ಯ ಕುಟುಂಬಗಳು, ಸ್ಥಳೀಯ ಸಿಬ್ಬಂದಿ, ಪಾಲುದಾರರು ಮತ್ತು ಸಮುದಾಯ.' },
      { title: 'ನಮ್ಮ ಪಯಣ', desc: 'ಅವನತಿ ಹೊಂದಿದ ಭೂಮಿಯಿಂದ ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿರುವ ಪರಿಸರ ವ್ಯವಸ್ಥೆಯವರೆಗೆ, ವರ್ಷದಿಂದ ವರ್ಷಕ್ಕೆ ಚಿತ್ರಗಳಲ್ಲಿ ನಡೆದ ಪಯಣ.' },
      { title: 'ಚಿತ್ರಗಳಲ್ಲಿ', desc: 'ಚಿತ್ರಗಳು 10,000 ಪದಗಳಿಗೆ ಸಮ — ಒಂದು ಹಳೆಯ ಗಾದೆ, ಇನ್ನೂ ನಿಜ.' },
      { title: 'ಜೀವವೈವಿಧ್ಯ', desc: '100ಕ್ಕೂ ಹೆಚ್ಚು ಪಕ್ಷಿ ಪ್ರಭೇದಗಳು — iNaturalist ನಿಂದ ನೇರ ವೀಕ್ಷಣೆಗಳು.' },
      { title: 'ಭೂಗೋಳ', desc: 'ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳಲ್ಲಿ TVC ಎಲ್ಲಿದೆ, ಮತ್ತು ವಿಶಾಲ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್‌ನಲ್ಲಿ ಅದರ ಸ್ಥಾನ.' },
      { title: 'ಹವಾಮಾನ', desc: 'TVC ಯಲ್ಲಿ ನೇರ ಹವಾಮಾನ, ಮತ್ತು ಋತುಗಳನ್ನು ರೂಪಿಸುವ ಮಳೆ ಹಾಗೂ ಮಾನ್ಸೂನ್ ಮಾದರಿಗಳು.' },
      { title: 'ಸಂಪನ್ಮೂಲ ಕೇಂದ್ರ', desc: 'TVC ಯ ಲಂಟಾನಾ ಪೀಠೋಪಕರಣಗಳು ಮತ್ತು ಕಲಿಕಾ ಕಾರ್ಯಕ್ರಮಗಳು.' },
      { title: 'ಕಾರ್ಯಕ್ರಮಗಳು', desc: 'ಶಿಬಿರಗಳು, ಕಾರ್ಯಾಗಾರಗಳು, ಜೀವವೈವಿಧ್ಯ ನಡಿಗೆಗಳು ಮತ್ತು ರಿಟ್ರೀಟ್‌ಗಳು — ಮುಂಬರುವ ಮತ್ತು ಹಿಂದಿನ.' },
    ],
    engageLabel: 'ಭಾಗಿಯಾಗಿ',
    engageHint: 'ನಾಲ್ಕು ಹಂತಗಳು, ಒಂದು ಏಣಿ',
    engageRungs: [
      { tag: 'ನಮ್ಮನ್ನು ಭೇಟಿ ಮಾಡಿ — ಒಂದು ದಿನದ ಪ್ರವಾಸ', title: 'ಒಂದು ದಿನಕ್ಕೆ ಬನ್ನಿ', desc: 'ಒಂದು ಫಾರ್ಮ್ ಪ್ರವಾಸ, ಪಕ್ಷಿ ವೀಕ್ಷಣೆ, ನಕ್ಷತ್ರ ವೀಕ್ಷಣೆ, ಬೆಂಕಿಯ ಬಳಿ ಬೋರ್ಡ್ ಆಟಗಳು — ಒಂದು ಪಿಕ್ನಿಕ್, ಒಂದು ಹೈಕ್, ಅಥವಾ ಗಂಟೆ ಗಂಟೆಗೂ ಏನೂ ಮಾಡದ ದಿನ.', cta: 'ಒಂದು ದಿನದ ಭೇಟಿಯನ್ನು ಯೋಜಿಸಿ →' },
      { tag: 'ನಮ್ಮೊಂದಿಗೆ ಉಳಿಯಿರಿ — ರಾತ್ರಿಯಿಡೀ', title: 'ರಾತ್ರಿ ಕಳೆಯಿರಿ', desc: 'ಸುತ್ತಮುತ್ತಲಿನ ಅತ್ಯಂತ ಕತ್ತಲೆಯ ಆಕಾಶದ ಕೆಳಗೆ ಎರಡು ದಿನಗಳ ವಾಸ್ತವ್ಯ — ಸೂರ್ಯಾಸ್ತ ನಡಿಗೆ, ಕ್ಯಾಂಪ್‌ಫೈರ್, ಮತ್ತು ಮಾರ್ಗದರ್ಶಿತ ಫಾರ್ಮ್ ಪ್ರವಾಸ.', cta: 'ರಾತ್ರಿ ವಾಸ್ತವ್ಯವನ್ನು ಬುಕ್ ಮಾಡಿ →' },
      { tag: 'ನಮ್ಮೊಂದಿಗೆ ಕೆಲಸ ಮಾಡಿ — ಕಾರ್ಯಕ್ರಮಗಳು ಮತ್ತು ಸ್ವಯಂಸೇವೆ', title: 'ನಿಮ್ಮ ತಂಡವನ್ನು ತನ್ನಿ, ಅಥವಾ ನಿಮ್ಮ ಕೈಗಳನ್ನು', desc: '20 ಜನರವರೆಗಿನ ತಂಡದ ಪ್ರವಾಸಗಳು, ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಬಿದಿರು ಕರಕುಶಲ ಕಾರ್ಯಾಗಾರಗಳು, ಅಥವಾ ಸ್ವಯಂಸೇವೆ — ಕತ್ತರಿಸುವುದು, ನೆಡುವುದು, ಕೊಯ್ಲು ಮಾಡುವುದು.', cta: 'ಕಾರ್ಯಕ್ರಮಗಳು ಮತ್ತು ಸ್ವಯಂಸೇವೆಯನ್ನು ನೋಡಿ →' },
      { tag: 'ನಿಮ್ಮದೇ ಆದದ್ದನ್ನು ತನ್ನಿ — ರಿಟ್ರೀಟ್‌ಗಳು ಮತ್ತು ಶಿಬಿರಗಳು', title: 'ನಿಮ್ಮ ಕಾರ್ಯಕ್ರಮವನ್ನು ಇಲ್ಲಿ ಆಯೋಜಿಸಿ', desc: 'ಪ್ರಕೃತಿ ರಿಟ್ರೀಟ್‌ಗಳು, ಜೀವವೈವಿಧ್ಯ ನಡಿಗೆಗಳು, ಅಥವಾ ದ ಲ್ಯಾಂಬ್ಡಾ ರಿಟ್ರೀಟ್‌ನಂತಹ ವಾರವಿಡೀ ಆಳವಾದ-ಗಮನ ಟೆಕ್ ಶಿಬಿರ — ನಿಮ್ಮದೇ ಕಾರ್ಯಕ್ರಮವನ್ನು ತನ್ನಿ, ಕ್ಯಾಂಪಿಂಗ್ ಸೇರಿಸಿ.', cta: 'ಕಾರ್ಯಕ್ರಮವನ್ನು ಹೇಗೆ ಆಯೋಜಿಸುವುದು ಎಂಬುದನ್ನು ನೋಡಿ →' },
      { tag: 'ಸಂಘಟನೆಗೆ ಸೇರುವುದು', title: 'ಸದಸ್ಯತ್ವದ ಬಗ್ಗೆ ಒಂದು ಟಿಪ್ಪಣಿ', desc: 'ನಾವು ವಿಸ್ತರಿಸುವ ಸಾಧ್ಯತೆ ಕಡಿಮೆ — 53 ಕುಟುಂಬಗಳು ನಾವು ತಲುಪಬಹುದಾದ ಗರಿಷ್ಠ ಗಾತ್ರ. ಒಮ್ಮೊಮ್ಮೆ ಒಬ್ಬ ಸದಸ್ಯ ಮುಂದೆ ಸಾಗುತ್ತಾರೆ, ಮತ್ತು ಅವರ ಸ್ಥಾನ ಖಾಸಗಿಯಾಗಿ ಹೊಸಬರಿಗೆ ಹಸ್ತಾಂತರಗೊಳ್ಳುತ್ತದೆ. ಅದು ನಿಜವಾಗಿ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದು ಇಲ್ಲಿದೆ.', cta: 'ಅದು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಓದಿ →' },
    ],
    quote1Text: '"ಆಧುನಿಕ ಸಂಶೋಧನೆಯು ಪ್ರಕೃತಿಯನ್ನು ಸಣ್ಣ ಸಣ್ಣ ತುಣುಕುಗಳಾಗಿ ವಿಭಜಿಸಿ, ನೈಸರ್ಗಿಕ ನಿಯಮಕ್ಕಾಗಲಿ ಪ್ರಾಯೋಗಿಕ ಅನುಭವಕ್ಕಾಗಲಿ ಹೊಂದಿಕೆಯಾಗದ ಪರೀಕ್ಷೆಗಳನ್ನು ನಡೆಸುತ್ತದೆ. ಫಲಿತಾಂಶಗಳನ್ನು ರೈತನ ಅಗತ್ಯಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ಅಲ್ಲ, ಸಂಶೋಧನೆಯ ಅನುಕೂಲಕ್ಕಾಗಿ ಜೋಡಿಸಲಾಗುತ್ತದೆ."',
    quote2Text: '"ನೀವು ಎಂದಾದರೂ ಬೆಳಿಗ್ಗೆ ಎಚ್ಚರಗೊಂಡು ಕಿಟಕಿಯಿಂದ ಹೊರಗೆ ನೋಡಿದ್ದೀರಾ, ಅಥವಾ ಹೊರಗೆ ಹೋಗಿ ಮರಗಳನ್ನು ಮತ್ತು ವಸಂತದ ಮುಂಜಾವನ್ನು ನೋಡಿದ್ದೀರಾ? ಅದರೊಂದಿಗೆ ಬದುಕಿ. ಎಲ್ಲಾ ಶಬ್ದಗಳನ್ನು ಆಲಿಸಿ, ಪಿಸುಮಾತನ್ನು, ಎಲೆಗಳ ನಡುವಿನ ಮೃದು ಗಾಳಿಯನ್ನು... ಪ್ರಕೃತಿಯೊಂದಿಗೆ ಅಂತಹ ಸಖ್ಯ ಹೊಂದಿದಾಗ, ಇನ್ನೊಬ್ಬ ವ್ಯಕ್ತಿಯೊಂದಿಗಿನ ನಿಮ್ಮ ಸಂಬಂಧವು ಸರಳ, ಸ್ಪಷ್ಟ, ಸಂಘರ್ಷವಿಲ್ಲದಂತಾಗುತ್ತದೆ."',
  },
  ta: {
    metaDescription: `இது வெறும் பண்ணை அல்ல — ஒரு மீட்டெடுக்கப்படும் சுற்றுச்சூழல் அமைப்பு: கனகபுரா அருகே மேலகிரி மலைகளின் ${FARM_AREA_ACRES} ஏக்கர்கள், 2017 முதல் 53 குடும்பங்களால் இயற்கை வேளாண்மை மற்றும் மறு காடாக்கம் மூலம் மீட்டெடுக்கப்பட்டுள்ளது.`,
    heroEyebrow: 'இது வெறும் பண்ணை அல்ல — ஒரு மீட்டெடுக்கப்படும் சுற்றுச்சூழல் அமைப்பு.',
    heroTitle: 'மேலகிரிகளின் ஒரு மூலையை மீட்டெடுத்தல்',
    heroIntro: 'சுரண்டல் விவசாயத்தால் தரிசான நிலம், இப்போது செழிப்பானதோர் உணவுக் காடாகவும் வனவிலங்கு வாழிடமாகவும் — இயற்கை வேளாண்மையும் மறு காடாக்கமும் இணைந்த மாற்றம்.',
    forkEyebrow: 'நீங்கள் இங்கே நேரத்தை எப்படி செலவிட விரும்புகிறீர்கள்?',
    forkTitle: 'ஆராயுங்கள், அல்லது ஈடுபடுங்கள்',
    forkIntro: 'நிலம் மற்றும் மக்களைப் பற்றி அறியுங்கள், அல்லது நேரில் வந்து அனுபவியுங்கள் — முதல் வருகையிலிருந்து கூட்டமைப்பில் இணைவது வரை.',
    doorExploreTag: 'கற்றுக்கொள்ளுங்கள்',
    doorExploreTitle: 'TVC-யை ஆராயுங்கள்',
    doorExploreDesc: 'எங்கள் கதை, நிலம், இதுவரையிலான பயணம், மற்றும் அது கொண்டிருக்கும் வாழ்க்கை — ஒன்பது வருட பயணம்.',
    doorExploreArrow: 'அனைத்தையும் காண்க ↓',
    doorEngageTag: 'பங்கேற்கவும்',
    doorEngageTitle: 'TVC-உடன் இணையுங்கள்',
    doorEngageDesc: 'ஒரு நாள் வருகை தாருங்கள், இரவு தங்குங்கள், எங்களுடன் இணைந்து பணியாற்றுங்கள், அல்லது உறுப்பினர் நிலை எப்படி செயல்படுகிறது என்பதை அறியுங்கள்.',
    doorEngageArrow: 'உங்கள் நிலையைக் கண்டறியுங்கள் ↓',
    principlesMore: 'நாங்கள் எதை பிரதிநிதித்துவப்படுத்துகிறோம் என்பது பற்றி மேலும் →',
    exploreLabel: 'ஆராயுங்கள்',
    exploreHint: 'தளத்தில் உள்ள ஒவ்வொரு தகவல் பக்கமும்',
    exploreCards: [
      { title: 'எங்களைப் பற்றி', desc: 'TVC ஏன் இருக்கிறது, நாங்கள் எதை பிரதிநிதித்துவப்படுத்துகிறோம், மற்றும் நிலம் எப்படி வடிவமைக்கப்பட்டுள்ளது.' },
      { title: 'மக்கள்', desc: 'TVC-ஐ சாத்தியமாக்கும் உறுப்பினர் குடும்பங்கள், உள்ளூர் ஊழியர்கள், கூட்டாளர்கள் மற்றும் சமூகம்.' },
      { title: 'எங்கள் பயணம்', desc: 'சிதைந்த நிலத்திலிருந்து மீட்டெடுக்கப்படும் சுற்றுச்சூழல் அமைப்பு வரை, ஆண்டுதோறும் புகைப்படங்களில் நடந்த பயணம்.' },
      { title: 'படங்களில்', desc: 'படங்கள் 10,000 வார்த்தைகளுக்கு சமம் — ஒரு பழைய பழமொழி, இன்னும் உண்மை.' },
      { title: 'பல்லுயிர் பெருக்கம்', desc: '100க்கும் மேற்பட்ட பறவை இனங்கள் — iNaturalist இலிருந்து நேரடி பார்வைகள்.' },
      { title: 'புவியியல்', desc: 'மேலகிரி மலைகளில் TVC எங்கே அமைந்துள்ளது, மற்றும் பரந்த வனவிலங்கு தாழ்வாரத்தில் அதன் இடம்.' },
      { title: 'வானிலை', desc: 'TVC-யில் நேரடி வானிலை, மற்றும் பருவங்களை வடிவமைக்கும் மழை மற்றும் பருவமழை முறைகள்.' },
      { title: 'வள மையம்', desc: 'TVC-யின் லாண்டானா மரச்சாமான்கள் மற்றும் கற்றல் திட்டங்கள்.' },
      { title: 'நிகழ்வுகள்', desc: 'முகாம்கள், பட்டறைகள், பல்லுயிர் நடைப்பயணங்கள் மற்றும் தியான முகாம்கள் — வரவிருக்கும் மற்றும் கடந்த.' },
    ],
    engageLabel: 'ஈடுபடுங்கள்',
    engageHint: 'நான்கு நிலைகள், ஒரு ஏணி',
    engageRungs: [
      { tag: 'எங்களைப் பார்வையிடுங்கள் — ஒரு நாள் பயணம்', title: 'ஒரு நாளுக்கு வாருங்கள்', desc: 'ஒரு பண்ணை சுற்றுப்பயணம், பறவை பார்வையிடல், நட்சத்திர பார்வையிடல், நெருப்பின் அருகே பலகை விளையாட்டுகள் — ஒரு பிக்னிக், ஒரு நடைபயணம், அல்லது மணிக்கு மணி ஒன்றும் செய்யாத நாள்.', cta: 'ஒரு நாள் வருகையைத் திட்டமிடுங்கள் →' },
      { tag: 'எங்களுடன் தங்குங்கள் — இரவு தங்குமிடம்', title: 'இரவைக் கழியுங்கள்', desc: 'சுற்றியுள்ள மிக இருண்ட வானங்களின் கீழ் ஒரு இரண்டு நாள் தங்குமிடம் — சூரிய அஸ்தமன நடைபயணம், முகாம் நெருப்பு, மற்றும் வழிகாட்டப்பட்ட பண்ணை சுற்றுப்பயணம்.', cta: 'இரவு தங்குமிடத்தை முன்பதிவு செய்யுங்கள் →' },
      { tag: 'எங்களுடன் பணியாற்றுங்கள் — நிகழ்வுகள் மற்றும் தன்னார்வத் தொண்டு', title: 'உங்கள் அணியை, அல்லது உங்கள் கைகளைக் கொண்டு வாருங்கள்', desc: '20 பேர் வரையிலான குழு உல்லாசப் பயணங்கள், இயற்கை வேளாண்மை மற்றும் மூங்கில் கைவினை பட்டறைகள், அல்லது தன்னார்வத் தொண்டு — வெட்டுதல், நடுதல், அறுவடை.', cta: 'நிகழ்வுகள் மற்றும் தன்னார்வத் தொண்டைக் காண்க →' },
      { tag: 'உங்கள் சொந்தத்தைக் கொண்டு வாருங்கள் — தியான முகாம்கள்', title: 'உங்கள் நிகழ்வை இங்கே நடத்துங்கள்', desc: 'இயற்கை தியான முகாம்கள், பல்லுயிர் நடைப்பயணங்கள், அல்லது தி லாம்ப்டா ரிட்ரீட் போன்ற ஒரு வார கால ஆழ்-கவனம் தொழில்நுட்ப முகாம் — உங்கள் சொந்த நிகழ்வைக் கொண்டு வாருங்கள், முகாமிடுதல் உட்பட.', cta: 'நிகழ்வை எப்படி நடத்துவது என்பதைக் காண்க →' },
      { tag: 'கூட்டமைப்பில் இணைதல்', title: 'உறுப்பினர் நிலை பற்றிய ஒரு குறிப்பு', desc: 'நாங்கள் விரிவடையும் வாய்ப்பு குறைவு — 53 குடும்பங்கள் நாங்கள் அடையக்கூடிய அதிகபட்ச அளவாக இருக்கலாம். எப்போதாவது ஒரு உறுப்பினர் முன்னேறுகிறார், அவரது இடம் தனிப்பட்ட முறையில் புதியவருக்கு மாற்றப்படுகிறது. அது உண்மையில் எப்படி வேலை செய்கிறது என்பது இங்கே.', cta: 'அது எப்படி வேலை செய்கிறது என்பதைப் படிக்கவும் →' },
    ],
    quote1Text: '"நவீன ஆராய்ச்சி இயற்கையை சிறு சிறு துண்டுகளாகப் பிரித்து, இயற்கை விதிக்கோ நடைமுறை அனுபவத்திற்கோ பொருந்தாத சோதனைகளை நடத்துகிறது. முடிவுகள் விவசாயியின் தேவைகளுக்கு ஏற்ப அல்ல, ஆராய்ச்சியின் வசதிக்காக வடிவமைக்கப்படுகின்றன."',
    quote2Text: '"நீங்கள் எப்போதாவது காலையில் விழித்து ஜன்னல் வழியே பார்த்திருக்கிறீர்களா, அல்லது வெளியே சென்று மரங்களையும் வசந்த கால விடியலையும் பார்த்திருக்கிறீர்களா? அதனுடன் வாழுங்கள். எல்லா ஒலிகளையும், கிசுகிசுப்பையும், இலைகளுக்கிடையே வீசும் லேசான காற்றையும் கேளுங்கள்... இயற்கையுடன் அத்தகைய ஐக்கியம் கொள்ளும்போது, மற்றொரு நபருடனான உங்கள் உறவு எளிமையாகவும், தெளிவாகவும், மோதலின்றியும் மாறுகிறது."',
  },
} as const;

const c = content[lang];

const exploreCards = exploreLinks.map((link, i) => ({ ...link, ...c.exploreCards[i] }));
const engageRungs = engageLinks.map((link, i) => ({ ...link, ...c.engageRungs[i] }));
---

<BaseLayout lang={lang} title={t('common.home')} description={c.metaDescription}>
  <div class="hero-bg" id="hero-bg">
    <video
      class="hero-bg__image"
      id="hero-image"
      src="/videos/home-hero.mp4"
      poster="/images/pages/home/hero.jpg"
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Aerial view of the Tamarind Valley Collective's hills"
    ></video>
    <div class="hero-bg__scrim" id="hero-scrim"></div>
  </div>

  <section class="hero">
    <div class="wrapper hero__content">
      <p class="eyebrow eyebrow--light">{c.heroEyebrow}</p>
      <h1>{c.heroTitle}</h1>
      <p class="hero__intro">{c.heroIntro}</p>
    </div>
    <HomeStats lang={lang} />
  </section>

  <WhatsNextBanner lang={lang} />

  <section class="section fork-section">
    <div class="wrapper">
      <div class="fork-head">
        <p class="eyebrow center">{c.forkEyebrow}</p>
        <h2>{c.forkTitle}</h2>
