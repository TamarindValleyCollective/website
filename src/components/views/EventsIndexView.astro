---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';
import { formatDateRange, durationTag, durationDays, daysUntil, countdownLabel } from '../../utils/events';
import { organizationId } from '../../utils/schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Translations live under kn/ and ta/ subfolders as sibling entries with the
// same bare filename (id prefixed "kn/"/"ta/") - same convention as
// communityOutreach (see CommunityOutreachIndexView.astro). Filter down to
// this locale's entries and strip the prefix to get the bare slug shared
// across all three locales' routes.
function bareSlug(id: string) {
  return id.replace(/^(kn|ta)\//, '');
}

const allEventsRaw = await getCollection('events', (e) => !e.data.draft);
const allEventsForLang =
  lang === 'en' ? allEventsRaw.filter((e) => !e.id.startsWith('kn/') && !e.id.startsWith('ta/')) : allEventsRaw.filter((e) => e.id.startsWith(`${lang}/`));
const allEvents = allEventsForLang.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const today = new Date();

// Completed 3Bs&1H editions collapse into one "stack" card linking to the
// series hub (/events/3bs1h, English only for now - see Bs1hSeriesView.astro)
// instead of appearing as several anonymous, near-duplicate past cards. An
// UPCOMING 3bs1h edition is deliberately left alone in `upcoming` below and
// renders as a normal card like any other event - only completed editions
// get folded away, positioned by the most recently completed one's date.
const bs1hPast = lang === 'en' ? allEvents.filter((e) => e.data.series === '3bs1h' && e.data.date < today) : [];
const bs1hLatestPast = bs1hPast.length > 0 ? bs1hPast.reduce((a, b) => (a.data.date > b.data.date ? a : b)) : null;

// Soonest-first, the opposite of allEvents' newest-first order above - an
// upcoming list exists to answer "what's happening next", so the nearest
// date belongs at the top, not the furthest-out one.
const upcoming = allEvents.filter((e) => e.data.date >= today).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = allEvents.filter((e) => e.data.date < today && !bs1hPast.includes(e));

type PastCard =
  | { kind: 'event'; event: (typeof past)[number]; date: Date }
  | { kind: 'bs1hStack'; latest: NonNullable<typeof bs1hLatestPast>; count: number; date: Date };

const pastCards: PastCard[] = [
  ...past.map((event) => ({ kind: 'event' as const, event, date: event.data.date })),
  ...(bs1hLatestPast ? [{ kind: 'bs1hStack' as const, latest: bs1hLatestPast, count: bs1hPast.length, date: bs1hLatestPast.data.date }] : []),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// 3bs1h editions live at the versioned /events/3bs1h/<edition> route instead
// of the flat /events/<slug> route (see src/pages/events/3bs1h/[edition].astro
// and src/pages/events/[slug].astro's exclusion of series==='3bs1h') - only
// relevant for English, since that versioned route is English-only for now
// and kn/ta 3bs1h editions still live at their original flat URLs.
function eventHref(e: (typeof allEvents)[number]) {
  if (lang === 'en' && e.data.series === '3bs1h') return `/events/3bs1h/${e.data.edition}`;
  return getRelativeLocaleUrl(lang, `/events/${bareSlug(e.id)}`);
}

// Every filterable tag, derived from real content rather than hardcoded -
// content tags (workshop, biodiversity, ...) most-used first (ties broken
// alphabetically), duration tags (Day event, Overnight event (N days))
// sorted shortest-first. Most-used-first, rather than plain alphabetical,
// keeps the handful of tags an actual visitor is likely to want up front
// instead of every tag competing for equal attention regardless of how rare
// it is. Content tags come out already translated since they're read
// straight off this locale's content collection entries.
const tagCounts = new Map<string, number>();
allEvents.forEach((e) => e.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const contentTags = [...tagCounts.keys()].sort((a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b));
const durationTagDays = new Map<string, number>();
allEvents.forEach((e) => {
  const tag = durationTag(e.data.date, e.data.endDate, lang);
  if (!durationTagDays.has(tag)) durationTagDays.set(tag, durationDays(e.data.date, e.data.endDate));
});
const durationTags = [...durationTagDays.entries()].sort((a, b) => a[1] - b[1]).map(([tag]) => tag);

function tagsAttr(e: (typeof allEvents)[number]) {
  return [...e.data.tags, durationTag(e.data.date, e.data.endDate, lang)].join('|');
}

const content = {
  en: {
    metaDescription: 'Upcoming and past events at Tamarind Valley Collective — camps, workshops, biodiversity walks, and retreats.',
    heroEyebrow: 'Events',
    heroTitle: 'Camps, Workshops & Gatherings',
    heroIntro: 'Nine years of camps, workshops, biodiversity walks, and retreats — from a single afternoon to a week at a time.',
    heroImageAlt: "A group foraging walk through the property's greenery",
    upcomingHeading: 'Upcoming',
    upcomingHint: 'The next thing happening at TVC.',
    emptyUpcoming: 'No events currently planned — check back soon.',
    filterByType: 'Filter by type',
    allChip: 'All',
    lengthLabel: 'Length',
    gridLabel: 'Grid',
    timelineLabel: 'Timeline',
    pastHeading: 'Past',
    pastHint: 'Nine years of it, newest first.',
    emptyPast: 'No past events match that filter.',
    msgTotalTemplate: '{n} events total',
    msgFilteredTemplate: 'Filtered to "{tag}"',
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್‌ನಲ್ಲಿ ಮುಂಬರುವ ಮತ್ತು ಹಿಂದಿನ ಕಾರ್ಯಕ್ರಮಗಳು — ಶಿಬಿರಗಳು, ಕಾರ್ಯಾಗಾರಗಳು, ಜೀವವೈವಿಧ್ಯ ನಡಿಗೆಗಳು ಮತ್ತು ರಿಟ್ರೀಟ್‌ಗಳು.',
    heroEyebrow: 'ಕಾರ್ಯಕ್ರಮಗಳು',
    heroTitle: 'ಶಿಬಿರಗಳು, ಕಾರ್ಯಾಗಾರಗಳು & ಸಮಾವೇಶಗಳು',
    heroIntro: 'ಒಂಬತ್ತು ವರ್ಷಗಳ ಶಿಬಿರಗಳು, ಕಾರ್ಯಾಗಾರಗಳು, ಜೀವವೈವಿಧ್ಯ ನಡಿಗೆಗಳು ಮತ್ತು ರಿಟ್ರೀಟ್‌ಗಳು — ಒಂದೇ ಮಧ್ಯಾಹ್ನದಿಂದ ಒಂದು ವಾರದವರೆಗೆ.',
    heroImageAlt: 'ಆಸ್ತಿಯ ಹಸಿರಿನ ಮೂಲಕ ಒಂದು ಗುಂಪಿನ ಫೊರೇಜಿಂಗ್ ನಡಿಗೆ',
    upcomingHeading: 'ಮುಂಬರುವ',
    upcomingHint: 'TVC ಯಲ್ಲಿ ಮುಂದೆ ನಡೆಯಲಿರುವುದು.',
    emptyUpcoming: 'ಪ್ರಸ್ತುತ ಯಾವುದೇ ಕಾರ್ಯಕ್ರಮಗಳು ಯೋಜಿಸಿಲ್ಲ — ಶೀಘ್ರದಲ್ಲೇ ಮತ್ತೆ ಪರಿಶೀಲಿಸಿ.',
    filterByType: 'ಪ್ರಕಾರದ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ',
    allChip: 'ಎಲ್ಲಾ',
    lengthLabel: 'ಅವಧಿ',
    gridLabel: 'ಗ್ರಿಡ್',
    timelineLabel: 'ಟೈಮ್‌ಲೈನ್',
    pastHeading: 'ಹಿಂದಿನ',
    pastHint: 'ಒಂಬತ್ತು ವರ್ಷಗಳ ಕಾರ್ಯಕ್ರಮಗಳು, ಹೊಸದರಿಂದ ಮೊದಲಿಗೆ.',
    emptyPast: 'ಆ ಫಿಲ್ಟರ್‌ಗೆ ಹೊಂದುವ ಯಾವುದೇ ಹಿಂದಿನ ಕಾರ್ಯಕ್ರಮಗಳಿಲ್ಲ.',
    msgTotalTemplate: '{n} ಒಟ್ಟು ಕಾರ್ಯಕ್ರಮಗಳು',
    msgFilteredTemplate: '"{tag}" ಗೆ ಫಿಲ್ಟರ್ ಮಾಡಲಾಗಿದೆ',
  },
  ta: {
    metaDescription: 'Tamarind Valley Collective-இல் வரவிருக்கும் மற்றும் கடந்த நிகழ்வுகள் — முகாம்கள், பட்டறைகள், பல்லுயிர் நடைபயணங்கள், மற்றும் ரிட்ரீட்கள்.',
    heroEyebrow: 'நிகழ்வுகள்',
    heroTitle: 'முகாம்கள், பட்டறைகள் & கூடல்கள்',
    heroIntro: 'ஒன்பது ஆண்டுகளின் முகாம்கள், பட்டறைகள், பல்லுயிர் நடைபயணங்கள் மற்றும் ரிட்ரீட்கள் — ஒரு மதியம் முதல் ஒரு வாரம் வரை.',
    heroImageAlt: 'சொத்தின் பசுமையின் வழியாக ஒரு குழு உணவு தேடும் நடைபயணம்',
    upcomingHeading: 'வரவிருக்கும்',
    upcomingHint: 'TVC-யில் அடுத்து நடக்கவிருப்பது.',
    emptyUpcoming: 'தற்போது எந்த நிகழ்வுகளும் திட்டமிடப்படவில்லை — விரைவில் மீண்டும் பாருங்கள்.',
    filterByType: 'வகை மூலம் வடிகட்டவும்',
    allChip: 'அனைத்தும்',
    lengthLabel: 'கால அளவு',
    gridLabel: 'கிரிட்',
    timelineLabel: 'காலவரிசை',
    pastHeading: 'கடந்தவை',
    pastHint: 'ஒன்பது ஆண்டுகளின் நிகழ்வுகள், புதியது முதலில்.',
    emptyPast: 'அந்த வடிப்பானுக்கு பொருந்தும் கடந்த நிகழ்வுகள் இல்லை.',
    msgTotalTemplate: '{n} மொத்த நிகழ்வுகள்',
    msgFilteredTemplate: '"{tag}" க்கு வடிகட்டப்பட்டது',
  },
} as const;

const c = content[lang];

// The full Event schema (location, organizer, ...) lives on each event's own
// detail page (see EventDetailView) - this index just needs to point at the
// upcoming ones, as a CollectionPage whose ItemList links out to them rather
// than duplicating their facts. Past events are left out of the list (their
// own pages still carry full Event schema) since this is a calendar of
// what's coming up, not an archive listing.
const eventsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.heroTitle,
  description: c.metaDescription,
  about: { '@id': organizationId(Astro.site) },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: upcoming.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Event',
        name: e.data.title,
        startDate: e.data.date.toISOString().slice(0, 10),
        endDate: e.data.endDate ? e.data.endDate.toISOString().slice(0, 10) : undefined,
        url: new URL(eventHref(e), Astro.site).toString(),
      },
    })),
  },
};
---

<BaseLayout
  lang={lang}
  title={c.heroTitle}
  description={c.metaDescription}
  schema={[eventsSchema]}
  image="/images/events/2026-08-01-foraging-day/hero.jpeg"
  imageWidth={720}
  imageHeight={480}
>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} image="/images/events/2026-08-01-foraging-day/hero.jpeg" imageAlt={c.heroImageAlt} />

  <section class="section wrapper">
    <h2>{c.upcomingHeading}</h2>
    <p class="section-hint">{c.upcomingHint}</p>
    <div class="upcoming-list" id="upcoming-list">
      {upcoming.length > 0 ? (
        upcoming.map((e) => {
          const daysAway = daysUntil(e.data.date, today);
          return (
            <a class="upcoming-card" href={eventHref(e)} data-tags={tagsAttr(e)}>
              <div class="countdown">
                <span class="countdown__num">{countdownLabel(daysAway, lang)}</span>
              </div>
              <div class:list={['upcoming-card__media', { 'upcoming-card__media--empty': !e.data.coverImage }]}>
                {e.data.coverImage && <img src={e.data.coverImage} alt={e.data.coverImageAlt ?? e.data.title} loading="lazy" />}
              </div>
              <div>
                <p class="date">{formatDateRange(e.data.date, e.data.endDate, lang)}</p>
                <h3>{e.data.title}</h3>
                <p class="excerpt">{e.data.excerpt}</p>
                <ul class="tags">
                  {e.data.tags.map((t) => <li class="tag">{t}</li>)}
                  <li class="tag tag--duration">{durationTag(e.data.date, e.data.endDate, lang)}</li>
                </ul>
              </div>
            </a>
          );
        })
      ) : (
        <p class="empty-upcoming">{c.emptyUpcoming}</p>
      )}
    </div>
  </section>

  <div class="controls wrapper">
    <div class="filter-groups">
      <div>
        <p class="filter-group__label">{c.filterByType}</p>
        <div class="chips" id="tag-chips">
          <button type="button" class="chip is-active" data-tag="all">{c.allChip}</button>
          {contentTags.map((t) => <button type="button" class="chip" data-tag={t}>{t}</button>)}
        </div>
      </div>
      <div>
        <p class="filter-group__label">{c.lengthLabel}</p>
        <div class="chips" id="duration-chips">
          {durationTags.map((t) => <button type="button" class="chip chip--duration" data-tag={t}>{t}</button>)}
        </div>
      </div>
    </div>
    <div class="view-toggle">
      <button type="button" class="view-toggle__btn is-active" data-view="grid">{c.gridLabel}</button>
      <button type="button" class="view-toggle__btn" data-view="timeline">{c.timelineLabel}</button>
    </div>
    <p class="result-count" id="result-count" data-msg-total-template={c.msgTotalTemplate} data-msg-filtered-template={c.msgFilteredTemplate}></p>
  </div>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.pastHeading}</h2>
      <p class="section-hint">{c.pastHint}</p>

      <div class="grid" id="grid-past">
        {pastCards.map((item) =>
          item.kind === 'event' ? (
            <a class="card" href={eventHref(item.event)} data-tags={tagsAttr(item.event)}>
              {item.event.data.coverImage && (
                <img src={item.event.data.coverImage} alt={item.event.data.coverImageAlt ?? item.event.data.title} loading="lazy" />
              )}
              <p class="date">{formatDateRange(item.event.data.date, item.event.data.endDate, lang)}</p>
              <h3>{item.event.data.title}</h3>
              <p class="excerpt">{item.event.data.excerpt}</p>
              <ul class="tags">
                {item.event.data.tags.map((t) => <li class="tag">{t}</li>)}
                <li class="tag tag--duration">{durationTag(item.event.data.date, item.event.data.endDate, lang)}</li>
              </ul>
            </a>
          ) : (
            <a class="card card--stack" href="/events/3bs1h" data-tags={tagsAttr(item.latest)}>
              <div class="card-stack__media">
                {/* A dedicated clean photo, not item.latest.data.coverImage -
                    that's the 5th edition's own cover, one of the old mockup
                    graphics with baked-in text (see Bs1hSeriesView.astro's
                    hero for the same issue already fixed there). This card
                    represents the whole series, not one edition, so it gets
                    the same photo used on the hub's hero. */}
                <img class="card-stack__cover" src="/images/events/3bs1h/card.jpg" alt="An Indian Silverbill at TVC" loading="lazy" />
                {/* Overlaid on the photo itself, not sitting in flow below it
                    - the cream (reversed) mark, not the green one used
                    elsewhere, since it needs to read against a photo, not a
                    light background (see public/images/brand/3bs1h/README.md
                    on the two ink variants). */}
                <img src="/images/brand/3bs1h/3bs1h-quad-cream.svg" alt="" class="card-stack__icon" />
              </div>
              <p class="date">{formatDateRange(item.latest.data.date, item.latest.data.endDate, lang)}</p>
              {/* Title + "N editions" on one row, right-aligned - reads more
                  naturally as one fact about the series than crowding the
                  icon row above or getting lost among the topical tags
                  below. */}
              <div class="card-stack__title-row">
                <h3>3Bs&amp;1H</h3>
                <span class="tag card-stack__badge">{item.count} editions</span>
              </div>
              <p class="excerpt">TVC's recurring biodiversity walk — see every edition on its own page →</p>
              <ul class="tags">
                {item.latest.data.tags.map((t) => <li class="tag">{t}</li>)}
                <li class="tag tag--duration">{durationTag(item.latest.data.date, item.latest.data.endDate, lang)}</li>
              </ul>
            </a>
          ),
        )}
      </div>

      <div class="timeline" id="timeline-past" hidden>
        {pastCards.map((item) =>
          item.kind === 'event' ? (
            <div class="tl-item" data-tags={tagsAttr(item.event)}>
              <p class="date">{formatDateRange(item.event.data.date, item.event.data.endDate, lang)}</p>
              <h3><a href={eventHref(item.event)}>{item.event.data.title}</a></h3>
              <p class="excerpt">{item.event.data.excerpt}</p>
              <ul class="tags">
                {item.event.data.tags.map((t) => <li class="tag">{t}</li>)}
                <li class="tag tag--duration">{durationTag(item.event.data.date, item.event.data.endDate, lang)}</li>
              </ul>
            </div>
          ) : (
            <div class="tl-item tl-item--stack" data-tags={tagsAttr(item.latest)}>
              <span class="card-stack__num">
                <img src="/images/brand/3bs1h/3bs1h-quad-green.svg" alt="" class="card-stack__icon" />
              </span>
              <p class="date">{formatDateRange(item.latest.data.date, item.latest.data.endDate, lang)}</p>
              <div class="card-stack__title-row">
                <h3><a href="/events/3bs1h">3Bs&amp;1H</a></h3>
                <span class="tag card-stack__badge">{item.count} editions</span>
              </div>
              <p class="excerpt">TVC's recurring biodiversity walk — see every edition on its own page →</p>
              <ul class="tags">
                {item.latest.data.tags.map((t) => <li class="tag">{t}</li>)}
                <li class="tag tag--duration">{durationTag(item.latest.data.date, item.latest.data.endDate, lang)}</li>
              </ul>
            </div>
          ),
        )}
      </div>

      <p class="empty-state" id="past-empty" hidden>{c.emptyPast}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .section-hint {
    color: var(--tvc-ink-soft);
    font-size: 0.92rem;
    margin: -8px 0 20px;
  }

  /* Renders as a plain single card now - an earlier layered "stack" effect
     (two offset cream rectangles behind the card) was dropped: it added a
     stacking context + negative-margin interactions that were the root of
     several rendering bugs here, for a decorative cue that wasn't earning
     its complexity. */
  .card-stack__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .card-stack__title-row h3 {
    margin: 0;
  }

  /* Timeline-only now (no photo there to overlay on to - see
     .card-stack__media below for the grid card's version). Just an inline
     icon wrapper. */
  .card-stack__num {
    margin-bottom: 10px;
  }

  /* Layered on top of the plain .tag styling (background/padding/font-size/
     border-radius already come from there) - just recolors it to stand out
     as the one brand-specific fact among the topical tags. */
  .card-stack__badge {
    font-family: var(--font-3bs1h-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tvc-green-vivid);
    background: var(--tvc-3bs1h-cream);
  }

  .card--stack h3 {
    font-family: var(--font-3bs1h-display);
  }

  /* The grid card's photo + overlaid mark. .grid img (above) would otherwise
     also match both images here as plain descendants of .grid and force its
     own bleed/160px-cover sizing onto them - tag+class selectors below tie
     it on specificity and win on source order (defined later in this file),
     confirmed against the actual compiled output, not assumed. */
  .card-stack__media {
    position: relative;
    margin: -28px -28px 16px;
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    height: 160px;
  }

  /* Scoped under .card-stack__media (not just img.card-stack__cover alone)
     for the same reason as the icon below - a tie with .grid img was won by
     .grid img regardless of source order, confirmed against the compiled
     output. Without this, .grid img's own -28px/-28px/16px margin would
     apply on top of the margin already carried by the .card-stack__media
     wrapper itself, pushing the photo taller than every sibling card's. */
  .card-stack__media img.card-stack__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
  }

  /* Base size shared with the timeline's inline usage above - the
     four-creature mark reads as a scribble under ~120px wide (see public/
     images/brand/3bs1h/README.md), so 30px height is the smallest legible
     size, same as the hub's own edition cards (Bs1hSeriesView.astro). */
  img.card-stack__icon {
    height: 30px;
    width: auto;
  }

  /* Overlay positioning only applies inside the grid card's photo, not the
     timeline's plain inline usage above. Also repeats height/width at this
     higher specificity (two classes + element, beats .grid img outright
     instead of tying with it) - a tie with .grid img was won by .grid img
     regardless of source order, confirmed against the compiled output, so
     this can't rely on the plain img.card-stack__icon rule above alone. */
  .card-stack__media img.card-stack__icon {
    position: absolute;
    /* Not 12px/12px - .card-stack__media's own -28px top/right margin (used
       to bleed the photo to the card's edge) shifts the effective containing-
       block origin for absolutely-positioned children by that same -28px on
       BOTH axes, confirmed empirically in a live page (getBoundingClientRect
       showed the icon 28px higher than intended, and its right edge 28px
       further right than intended - clipped on both sides by
       .card-stack__media's overflow:hidden before this fix). 12+28=40 lands
       it at the intended 12px from the *visible* photo edges. */
    top: 40px;
    right: 40px;
    height: 30px;
    width: auto;
  }

  .tl-item--stack::before {
    border-color: var(--tvc-green-vivid);
  }

  /* ---- upcoming highlight ---- */
  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .upcoming-card {
    display: grid;
    grid-template-columns: 130px 140px 1fr;
    align-items: center;
    gap: 24px;
    background: #fff;
    border: 1px solid rgba(247, 133, 32, 0.35);
    border-radius: 18px;
    padding: 22px 26px;
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease;
  }

  .upcoming-card:hover {
    transform: translateY(-2px);
  }

  .countdown { text-align: center; }

  .countdown__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--tvc-orange);
    line-height: 1.15;
  }

  .upcoming-card__media {
    height: 96px;
    border-radius: 12px;
    overflow: hidden;
  }

  .upcoming-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .upcoming-card__media--empty {
    background: linear-gradient(135deg, var(--tvc-green-tint), var(--tvc-orange-tint));
  }

  .upcoming-card h3 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }

  .upcoming-card .excerpt {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 10px;
  }

  .empty-upcoming {
    border: 1px dashed var(--tvc-line);
    border-radius: 14px;
    padding: 22px 26px;
    color: var(--tvc-ink-soft);
  }

  /* ---- controls ---- */
  .controls {
    /* This band sits between two .section blocks but isn't one itself -
       needs the same opaque background they get from global.css, or the
       page's fixed, still-fading hero photo (see PageHero.astro) shows
       through behind the filter chips for however much of this section
       falls within the first viewport-height of scroll. */
    background: var(--tvc-cream);
    /* Longhand top/bottom only, same reason .section in global.css does
       this - .controls is combined with .wrapper on the same element
       (`class="controls wrapper"`), and a shorthand `padding` here would
       silently overwrite .wrapper's `padding: 0 24px` entirely (shorthands
       don't merge), flattening the left/right edges against the viewport. */
    padding-top: 24px;
    padding-bottom: 24px;
    border-top: 1px solid var(--tvc-line);
    border-bottom: 1px solid var(--tvc-line);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .filter-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .filter-group__label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tvc-ink-soft);
    margin: 0 0 8px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    color: var(--tvc-ink-soft);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .chip:hover {
    border-color: var(--tvc-green);
    color: var(--tvc-green-dark);
  }

  .chip.is-active {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: #fff;
  }

  .chip--duration.is-active {
    background: var(--tvc-orange);
    border-color: var(--tvc-orange);
    color: #2a1400;
  }

  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    padding: 3px;
    background: #fff;
    flex-shrink: 0;
  }

  .view-toggle__btn {
    appearance: none;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--tvc-ink-soft);
    padding: 7px 16px;
    border-radius: 999px;
    cursor: pointer;
  }

  .view-toggle__btn.is-active {
    background: var(--tvc-green-dark);
    color: #fff;
  }

  .result-count {
    width: 100%;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
    margin: 4px 0 0;
  }

  /* ---- grid ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }

  .grid a {
    text-decoration: none;
    color: inherit;
  }

  .grid img {
    border-radius: var(--radius) var(--radius) 0 0;
    margin: -28px -28px 16px;
    /* Global img { max-width: 100% } would otherwise clamp this calc'd
       width right back down to 100%, undoing the negative-margin bleed on
       the right edge (the left edge looks fine regardless, since the
       margin offset alone doesn't depend on width). */
    max-width: none;
    width: calc(100% + 56px);
    height: 160px;
    object-fit: cover;
  }

  .card .excerpt {
    color: var(--tvc-ink-soft);
    margin: 0 0 4px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .tag {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .tag--duration {
    background: var(--tvc-orange-tint);
    color: #a85712;
  }

  .date {
    color: var(--tvc-orange);
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }

  /* ---- timeline ---- */
  .timeline {
    position: relative;
    padding-left: 28px;
    margin-top: 20px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--tvc-line);
  }

  .tl-item {
    position: relative;
    padding: 0 0 30px 22px;
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--tvc-green);
  }

  .tl-item h3 {
    font-size: 1.12rem;
    margin: 0 0 6px;
  }

  .tl-item h3 a {
    color: var(--tvc-ink);
    text-decoration: none;
  }

  .tl-item h3 a:hover {
    color: var(--tvc-green-dark);
  }

  .tl-item .excerpt {
    color: var(--tvc-ink-soft);
    margin: 0;
    max-width: 62ch;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: var(--tvc-ink-soft);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 700px) {
    .upcoming-card {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .countdown { text-align: left; }
  }

  @media (max-width: 620px) {
    .controls { flex-direction: column; }
    .view-toggle { align-self: flex-start; }
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-toggle__btn'));
  const upcomingItems = Array.from(document.querySelectorAll<HTMLElement>('#upcoming-list [data-tags]'));
  const pastItems = Array.from(document.querySelectorAll<HTMLElement>('#grid-past [data-tags], #timeline-past [data-tags]'));
  const gridPast = document.getElementById('grid-past');
  const timelinePast = document.getElementById('timeline-past');
  const pastEmpty = document.getElementById('past-empty');
  const resultCount = document.getElementById('result-count');
  const totalCount = upcomingItems.length + pastItems.length / 2; // each past item is rendered twice (grid + timeline)

  let activeTag = 'all';
  let activeView: 'grid' | 'timeline' = 'grid';

  function matches(el: HTMLElement) {
    if (activeTag === 'all') return true;
    return (el.dataset.tags ?? '').split('|').includes(activeTag);
  }

  function render() {
    let visiblePast = 0;
    upcomingItems.forEach((el) => {
      el.hidden = !matches(el);
    });
    pastItems.forEach((el) => {
      const show = matches(el);
      el.hidden = !show;
      if (show && el.closest('#grid-past')) visiblePast++;
    });

    if (gridPast) gridPast.hidden = activeView !== 'grid';
    if (timelinePast) timelinePast.hidden = activeView !== 'timeline';
    if (pastEmpty) pastEmpty.hidden = visiblePast > 0;

    if (resultCount) {
      const template = activeTag === 'all' ? resultCount.dataset.msgTotalTemplate : resultCount.dataset.msgFilteredTemplate;
      resultCount.textContent = (template ?? '').replace('{n}', String(totalCount)).replace('{tag}', activeTag);
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag ?? 'all';
      activeTag = activeTag === tag ? 'all' : tag;
      chips.forEach((c) => {
        const t = c.dataset.tag ?? 'all';
        c.classList.toggle('is-active', t === activeTag || (activeTag === 'all' && t === 'all'));
      });
      render();
    });
  });

  viewButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeView = (btn.dataset.view as 'grid' | 'timeline') ?? 'grid';
      viewButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
      render();
    });
  });

  render();
</script>
