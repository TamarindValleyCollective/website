function initials(name: string) {
  const parts = name.split('&').map((p) => p.trim()).filter(Boolean);
  if (parts.length > 1) {
    return parts.map((p) => p.split(/\s+/)[0][0]).join('').toUpperCase();
  }
  const words = parts[0].split(/\s+/);
  return (words[0][0] + (words[1]?.[0] ?? '')).toUpperCase();
}

// Partner cards prefer the AI-drafted Kannada/Tamil title/excerpt when a
// parallel effort has filled them in on the partner's markdown frontmatter,
// falling back to English until then (fields are optional on the schema).
function partnerTitle(p: (typeof partners)[number]) {
  if (lang === 'kn') return p.data.title_kn || p.data.title;
  if (lang === 'ta') return p.data.title_ta || p.data.title;
  return p.data.title;
}

function partnerExcerpt(p: (typeof partners)[number]) {
  if (lang === 'kn') return p.data.excerpt_kn || p.data.excerpt;
  if (lang === 'ta') return p.data.excerpt_ta || p.data.excerpt;
  return p.data.excerpt;
}
