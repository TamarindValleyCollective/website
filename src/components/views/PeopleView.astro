// unchanged).
const staffContent = {
  en: [
    { name: 'Madhavan', role: 'Farm lead & naturalist', bio: "A passionate naturalist who has been tirelessly working on rejuvenating the land, documenting the flora and fauna, gathering seeds from the forest, maintaining a nursery, and nurturing the ecosystem. He knows every tree, bird, and reptile you'll run into here, and lives on-site with his wife Krithika and daughter Shashtika." },
    { name: 'Ramdoss', role: 'Master craftsman', bio: 'A master craftsman when it comes to making bamboo baskets, grown up in the Odhipuram/Thaggatti village.' },
