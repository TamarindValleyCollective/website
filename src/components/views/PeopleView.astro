  }

  .partner-card h4 {
    margin: 0;
  }

  .partner-card p {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 8px 0 0;
  }

  .join {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
  }
</style>
