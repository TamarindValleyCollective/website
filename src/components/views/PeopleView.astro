<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/members/reva-and-ranjan.jpg" imageWidth={768} imageHeight={576}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/members/reva-and-ranjan.jpg"
    imageAlt="Two of TVC's member families at the farm"
  />

  <section class="section wrapper" id="members">
    <h2>{c.membersHeading}</h2>
    <p>{c.membersIntro}</p>
    <div class="members-grid">
      {members.map((m) => (
        <div class="member-card">
          {m.photo ? (
            <img src={m.photo} alt={m.name} class="member-photo" loading="lazy" />
          ) : (
            <div class="member-photo member-photo--placeholder" aria-hidden="true">{initials(m.name)}</div>
          )}
          <h4>{m.name}</h4>
          {m.bio && <p>{m.bio}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.staffHeading}</h2>
      <p>{c.staffIntro}</p>
      <div class="staff-grid">
        {staff.map((s) => (
          <div class="card">
            <h4>{s.name}</h4>
            <p class="staff-role">{s.role}</p>
            <p>{s.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrapper" id="partners">
    <h2>{c.partnersHeading}</h2>
    <p>{c.partnersIntro}</p>
    <div class="partners-grid">
      {partners.map((p) => (
        <a class="partner-card" href={p.data.url} target="_blank" rel="noopener noreferrer">
          {p.data.coverImage && <img src={p.data.coverImage} alt={partnerTitle(p)} loading="lazy" />}
          <h4>{partnerTitle(p)}</h4>
          <p>{partnerExcerpt(p)}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.outreachHeading}</h2>
      <p>{c.outreachIntro}</p>
      <a class="button button--outline" href={getRelativeLocaleUrl(lang, '/people/community-outreach')}>{c.outreachLink}</a>
    </div>
  </section>

  <section class="section wrapper">
    <div class="join">
      <h2>{c.joinHeading}</h2>
      <p>{c.joinText}</p>
      <a class="button" href={getRelativeLocaleUrl(lang, '/join')}>{c.joinLink}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .member-card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 16px;
    text-align: center;
  }

  .member-card h4 {
    font-size: 0.88rem;
    margin: 0;
  }

  .member-card p {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    margin: 6px 0 0;
  }

  .member-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 10px;
    display: block;
  }

  .member-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 700;
    font-size: 1rem;
  }

  .staff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .staff-role {
    color: var(--tvc-orange);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }

  /* Each partner links straight out to its own site (see the url field on
     the partners collection) rather than to a TVC-hosted detail page --
     with only 88-130 words of content per partner, a dedicated route
     wasn't earning its keep. */
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .partner-card {
    display: block;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .partner-card:hover {
    transform: translateY(-2px);
