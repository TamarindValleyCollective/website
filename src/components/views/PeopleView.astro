---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const partners = await getCollection('partners');

// Structural copy for this page (headings, intros, CTAs) is fully
// translated. The 5 local-staff bios are short and worth translating in
// full too - see staffContent below. The 53 member-family bios are NOT
// translated (see `members` below) - a deliberate scope decision, not an
// oversight; see PeopleView's note above `members`.
const content = {
  en: {
    metaDescription: "The people of Tamarind Valley Collective — the 53 member families, the local staff who run things day to day, our partners, and our work with the neighboring community.",
    heroEyebrow: 'People',
    heroTitle: "Who's part of TVC",
    heroIntro: 'The member families who own the land collectively, the local staff who run it day to day, and the partners and neighboring community who make it all work.',
    membersHeading: 'Member families',
    membersIntro: 'The 53 families who make up the collective — most joined between the founding in 2017 and today.',
    staffHeading: 'Our local staff',
    staffIntro: 'The day-to-day activities at TVC are managed by a small, dedicated team living on-site.',
    partnersHeading: 'Partners & collaborators',
    partnersIntro: "Beyond TVC's own community, a handful of organizations have supported us along the way — from hospitality to permaculture design.",
    outreachHeading: 'Community outreach',
    outreachIntro: 'Our ongoing work with the local community around TVC, in Odhipuram and Thaggatti village.',
    outreachLink: 'See our outreach →',
    joinHeading: 'Interested in becoming a member?',
    joinText: "Membership isn't really open — 53 families is close to as large as this community will get. When a spot does open, it passes privately between members rather than through any application process. Here's exactly how that works.",
    joinLink: 'Read how it works →',
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್‌ನ ಜನರು — 53 ಸದಸ್ಯ ಕುಟುಂಬಗಳು, ದಿನನಿತ್ಯದ ಕೆಲಸಗಳನ್ನು ನಡೆಸುವ ಸ್ಥಳೀಯ ಸಿಬ್ಬಂದಿ, ನಮ್ಮ ಪಾಲುದಾರರು, ಮತ್ತು ನೆರೆಯ ಸಮುದಾಯದೊಂದಿಗಿನ ನಮ್ಮ ಕೆಲಸ.',
    heroEyebrow: 'ಜನರು',
    heroTitle: 'TVC ಯ ಭಾಗವಾಗಿರುವವರು ಯಾರು',
    heroIntro: 'ಭೂಮಿಯನ್ನು ಸಾಮೂಹಿಕವಾಗಿ ಹೊಂದಿರುವ ಸದಸ್ಯ ಕುಟುಂಬಗಳು, ದಿನನಿತ್ಯ ಇದನ್ನು ನಡೆಸುವ ಸ್ಥಳೀಯ ಸಿಬ್ಬಂದಿ, ಮತ್ತು ಇದೆಲ್ಲವನ್ನೂ ಕಾರ್ಯಗತಗೊಳಿಸುವ ಪಾಲುದಾರರು ಮತ್ತು ನೆರೆಹೊರೆಯ ಸಮುದಾಯ.',
