const c = content[lang];
---

<BaseLayout lang={lang} title={t('nav.about')} description={c.metaDescription} image="/images/pages/home/hero.jpg" imageWidth={4204} imageHeight={1330}>
  <PageHero
    eyebrow={t('nav.about')}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/pages/home/hero.jpg"
    imageAlt="Panoramic view of the Tamarind Valley Collective's hills"
  />

  <section class="section wrapper">
    <h2>{c.standForHeading}</h2>

    <h3>{c.visionHeading}</h3>
    <p>{c.visionText}</p>

    <h3>{c.missionHeading}</h3>
    <p>{c.missionText1}</p>

    <p set:html={c.missionText2} />
    <p>{c.missionText3}</p>

    <h3>{c.farmingHeading}</h3>
    <p>{c.farmingText}</p>

    <div class="two-col">
      <div class="card">
        <h4>{c.corePrinciplesHeading}</h4>
        <ul>
          {PRINCIPLES.map((p) => (
            <li><strong>{t(`principles.${p.key}.name`)}:</strong> {t(`principles.${p.key}.desc`)}</li>
          ))}
        </ul>
      </div>
