---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { PRINCIPLES } from '../../data/principles';
import { FARM_AREA_ACRES } from '../../data/site-facts';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Prose content for this page only - shared chrome (nav/footer/principle
// names) comes from src/i18n/*.ts via t() above. Paragraphs that contain an
// inline link keep the <a> in the string itself (rendered with set:html)
// rather than splitting into pre/link/post fragments - simpler to keep in
// sync across 3 languages for a one-off link like this.
const content = {
  en: {
    metaDescription: 'Why Tamarind Valley Collective exists, what we stand for, and how the land is laid out.',
    heroTitle: 'Why TVC?',
    heroIntro: `A collective of 53 families regenerating ${FARM_AREA_ACRES} acres of the Melagiri Hills.`,
    standForHeading: 'What we stand for',
    visionHeading: 'Vision',
    visionText: 'To be a model for regenerating land as one ecosystem — sharing knowledge freely, and proving that a small, disciplined community can create outsized positive impact.',
    missionHeading: 'Mission',
    missionText1: 'We unite individuals committed to sustainable living to regenerate a low-energy landscape that connects rather than competes with nature, ensuring a fair share for birds and beasts alongside our own. Through shared labor, native seed banking, and disciplined land stewardship, we aim to demonstrate that regeneration can uplift both ecosystems and neighboring communities.',
    missionText2: 'As the name indicates, TVC is a collective of like-minded people who have come together to evolve a sustainable living concept. We are currently <a href="/people/members">53 families</a> that care about the degradation of natural resources globally and would like to experiment with a living style that reduces consumption and incorporates naturally supported cyclical systems.',
    missionText3: `TVC is ${FARM_AREA_ACRES} acres of the Melagiri Hills, collectively owned by these families — a range straddling Tamil Nadu's Dharmapuri and Krishnagiri districts where the Eastern and Western Ghats meet, bordering Karnataka along the Cauvery. Part of the range was declared the Cauvery North Wildlife Sanctuary in 2014, and the whole landscape is a live elephant corridor connecting Bannerghatta National Park to the Cauvery — one link in a wider chain that also ties in MM Hills, BR Hills, Sathyamangalam, and the Nilgiri Biosphere Reserve. Wide-ranging animals, elephants especially, move through it freely, since they don't recognize human-drawn boundaries; farms, roads, and settlements that fragment the corridor choke off that movement and worsen human-elephant conflict. Due to exploitative farming practices, the land was degraded when we bought it — exactly the kind of fragmentation this corridor can't afford. Since 2017, the community has been using permaculture principles to regenerate its fertility naturally: one small, verifiable piece of restoring habitat quality inside one of India's most important wildlife corridors, not just claiming to. Conservationists who've visited have remarked that there's now no visible difference between TVC's regenerated land and the adjoining forest.`,
    farmingHeading: 'Farming, the TVC way',
    farmingText: "One of the core principles of the community is to practice sustainable living — meeting current food needs without harming the environment or compromising future generations' ability to meet theirs, using methods like crop rotation, integrated pest management, water conservation, and reducing chemical inputs to create resilient food systems.",
    corePrinciplesHeading: 'Core principles & goals',
    commonPracticesHeading: 'Common practices',
    commonPractices: [
      'Crop rotation to replenish soil nutrients.',
      'Integrated pest management using natural predators.',
      'Cover crops to prevent erosion and improve soil.',
      'Water conservation via drip irrigation and rainwater harvesting.',
      'Composting & mulching to build soil organic matter.',
      'Agroecology — designing the farm to mimic natural ecosystems.',
    ],
    closingText: 'Industrial agriculture often prioritizes high yields through monocultures and heavy chemical use. Sustainable living aims for a holistic system instead — producing healthy food while regenerating natural resources and supporting local economies.',
    designHeading: 'The design',
    designText: "The permaculture principles behind the land's layout — the wildlife corridor, food forests, cultivated zones, and water works — mapped out, plus a drone flyover.",
    designLink: 'See the design →',
    peopleHeading: "Who's part of TVC",
    peopleText: 'The 53 member families who own the land collectively, the local staff who run it day to day, and the partners and neighboring community who make it all work.',
    peopleLink: 'Meet the people →',
    joinHeading: 'Interested in becoming a member?',
    joinText: "Membership isn't really open — 53 families is close to as large as this community will get. When a spot does open, it passes privately between members rather than through any application process. Here's exactly how that works.",
    joinLink: 'Read how it works →',
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್ ಏಕೆ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ, ನಾವು ಏನನ್ನು ಪ್ರತಿಪಾದಿಸುತ್ತೇವೆ, ಮತ್ತು ಭೂಮಿಯನ್ನು ಹೇಗೆ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ.',
    heroTitle: 'ಏಕೆ TVC?',
    heroIntro: `ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ${FARM_AREA_ACRES} ಎಕರೆಗಳನ್ನು ಪುನರುಜ್ಜೀವನಗೊಳಿಸುತ್ತಿರುವ 53 ಕುಟುಂಬಗಳ ಒಂದು ಸಂಘಟನೆ.`,
    standForHeading: 'ನಾವು ಏನನ್ನು ಪ್ರತಿಪಾದಿಸುತ್ತೇವೆ',
    visionHeading: 'ದೃಷ್ಟಿಕೋನ',
    visionText: 'ಭೂಮಿಯನ್ನು ಒಂದೇ ಪರಿಸರ ವ್ಯವಸ್ಥೆಯಾಗಿ ಪುನರುಜ್ಜೀವನಗೊಳಿಸುವ ಮಾದರಿಯಾಗುವುದು — ಜ್ಞಾನವನ್ನು ಮುಕ್ತವಾಗಿ ಹಂಚಿಕೊಳ್ಳುವುದು, ಮತ್ತು ಒಂದು ಚಿಕ್ಕ, ಶಿಸ್ತುಬದ್ಧ ಸಮುದಾಯವು ಅಸಾಧಾರಣ ಸಕಾರಾತ್ಮಕ ಪರಿಣಾಮವನ್ನು ಸೃಷ್ಟಿಸಬಲ್ಲದು ಎಂದು ಸಾಬೀತುಪಡಿಸುವುದು.',
    missionHeading: 'ಧ್ಯೇಯ',
    missionText1: 'ಸುಸ್ಥಿರ ಜೀವನಶೈಲಿಗೆ ಬದ್ಧರಾದ ವ್ಯಕ್ತಿಗಳನ್ನು ಒಗ್ಗೂಡಿಸಿ, ಪ್ರಕೃತಿಯೊಂದಿಗೆ ಸ್ಪರ್ಧಿಸುವ ಬದಲು ಅದರೊಂದಿಗೆ ಸಂಪರ್ಕ ಸಾಧಿಸುವ ಕಡಿಮೆ-ಶಕ್ತಿಯ ಭೂಪ್ರದೇಶವನ್ನು ಪುನರುಜ್ಜೀವನಗೊಳಿಸುವುದು, ನಮ್ಮ ಜೊತೆಗೆ ಪಕ್ಷಿಗಳಿಗೂ ಪ್ರಾಣಿಗಳಿಗೂ ನ್ಯಾಯಯುತ ಪಾಲನ್ನು ಖಚಿತಪಡಿಸುವುದು ನಮ್ಮ ಗುರಿ. ಹಂಚಿಕೆಯ ಶ್ರಮ, ಸ್ಥಳೀಯ ಬೀಜ ಸಂಗ್ರಹಣೆ ಮತ್ತು ಶಿಸ್ತುಬದ್ಧ ಭೂ ನಿರ್ವಹಣೆಯ ಮೂಲಕ, ಪುನರುಜ್ಜೀವನವು ಪರಿಸರ ವ್ಯವಸ್ಥೆಗಳನ್ನು ಮತ್ತು ನೆರೆಯ ಸಮುದಾಯಗಳನ್ನು ಎರಡನ್ನೂ ಮೇಲೆತ್ತಬಲ್ಲದು ಎಂದು ತೋರಿಸಲು ನಾವು ಬಯಸುತ್ತೇವೆ.',
    missionText2: 'TVC ಎಂಬ ಹೆಸರೇ ಸೂಚಿಸುವಂತೆ, ಇದು ಸುಸ್ಥಿರ ಜೀವನ ಪರಿಕಲ್ಪನೆಯನ್ನು ರೂಪಿಸಲು ಒಗ್ಗೂಡಿದ ಸಮಾನ ಮನಸ್ಕ ಜನರ ಒಂದು ಸಂಘಟನೆ. ಪ್ರಸ್ತುತ ನಾವು <a href="/people/members">53 ಕುಟುಂಬಗಳು</a> — ಜಾಗತಿಕ ನೈಸರ್ಗಿಕ ಸಂಪನ್ಮೂಲಗಳ ಅವನತಿಯ ಬಗ್ಗೆ ಕಾಳಜಿ ವಹಿಸುವ ಮತ್ತು ಬಳಕೆಯನ್ನು ಕಡಿಮೆ ಮಾಡುವ, ನೈಸರ್ಗಿಕವಾಗಿ ಬೆಂಬಲಿತ ಆವರ್ತಕ ವ್ಯವಸ್ಥೆಗಳನ್ನು ಅಳವಡಿಸಿಕೊಳ್ಳುವ ಜೀವನಶೈಲಿಯನ್ನು ಪ್ರಯೋಗಿಸಲು ಬಯಸುತ್ತೇವೆ.',
    missionText3: `TVC ಎಂಬುದು ಈ ಕುಟುಂಬಗಳ ಸಾಮೂಹಿಕ ಒಡೆತನದ ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ${FARM_AREA_ACRES} ಎಕರೆ ಭೂಮಿ — ಪೂರ್ವ ಮತ್ತು ಪಶ್ಚಿಮ ಘಟ್ಟಗಳು ಸಂಧಿಸುವ, ತಮಿಳುನಾಡಿನ ಧರ್ಮಪುರಿ ಮತ್ತು ಕೃಷ್ಣಗಿರಿ ಜಿಲ್ಲೆಗಳಲ್ಲಿ ಹರಡಿರುವ, ಕಾವೇರಿಯ ಉದ್ದಕ್ಕೂ ಕರ್ನಾಟಕದ ಗಡಿಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವ ಶ್ರೇಣಿ. ಈ ಶ್ರೇಣಿಯ ಒಂದು ಭಾಗವನ್ನು 2014ರಲ್ಲಿ ಕಾವೇರಿ ಉತ್ತರ ವನ್ಯಜೀವಿ ಅಭಯಾರಣ್ಯ ಎಂದು ಘೋಷಿಸಲಾಯಿತು, ಮತ್ತು ಇಡೀ ಭೂಪ್ರದೇಶವು ಬನ್ನೇರುಘಟ್ಟ ರಾಷ್ಟ್ರೀಯ ಉದ್ಯಾನವನ್ನು ಕಾವೇರಿಗೆ ಸಂಪರ್ಕಿಸುವ ಜೀವಂತ ಆನೆ ಕಾರಿಡಾರ್ ಆಗಿದೆ — ಇದು MM ಬೆಟ್ಟಗಳು, BR ಬೆಟ್ಟಗಳು, ಸತ್ಯಮಂಗಲಂ ಮತ್ತು ನೀಲಗಿರಿ ಜೀವಗೋಳ ಮೀಸಲು ಪ್ರದೇಶವನ್ನೂ ಜೋಡಿಸುವ ವಿಶಾಲ ಸರಪಳಿಯ ಒಂದು ಕೊಂಡಿ. ವ್ಯಾಪಕವಾಗಿ ಸಂಚರಿಸುವ ಪ್ರಾಣಿಗಳು, ವಿಶೇಷವಾಗಿ ಆನೆಗಳು, ಮಾನವ ನಿರ್ಮಿತ ಗಡಿಗಳನ್ನು ಗುರುತಿಸದ ಕಾರಣ ಇಲ್ಲಿ ಮುಕ್ತವಾಗಿ ಸಂಚರಿಸುತ್ತವೆ; ಕಾರಿಡಾರ್ ಅನ್ನು ಛಿದ್ರಗೊಳಿಸುವ ಫಾರ್ಮ್‌ಗಳು, ರಸ್ತೆಗಳು ಮತ್ತು ವಸಾಹತುಗಳು ಆ ಸಂಚಾರವನ್ನು ಉಸಿರುಗಟ್ಟಿಸಿ ಮಾನವ-ಆನೆ ಸಂಘರ್ಷವನ್ನು ಹೆಚ್ಚಿಸುತ್ತವೆ. ಶೋಷಣಾತ್ಮಕ ಕೃಷಿ ಪದ್ಧತಿಗಳಿಂದಾಗಿ, ನಾವು ಇದನ್ನು ಖರೀದಿಸಿದಾಗ ಭೂಮಿ ಅವನತಿ ಹೊಂದಿತ್ತು — ಈ ಕಾರಿಡಾರ್‌ಗೆ ಸಹಿಸಲಾಗದ ರೀತಿಯ ಛಿದ್ರೀಕರಣ. 2017ರಿಂದ, ಸಮುದಾಯವು ಪರ್ಮಾಕಲ್ಚರ್ ತತ್ವಗಳನ್ನು ಬಳಸಿ ಅದರ ಫಲವತ್ತತೆಯನ್ನು ನೈಸರ್ಗಿಕವಾಗಿ ಪುನರುಜ್ಜೀವನಗೊಳಿಸುತ್ತಿದೆ: ಭಾರತದ ಪ್ರಮುಖ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್‌ಗಳಲ್ಲಿ ಒಂದರ ಆವಾಸಸ್ಥಾನದ ಗುಣಮಟ್ಟವನ್ನು ಪುನಃಸ್ಥಾಪಿಸುವ ಒಂದು ಚಿಕ್ಕ, ಪರಿಶೀಲಿಸಬಹುದಾದ ಭಾಗ, ಕೇವಲ ಹೇಳಿಕೆಯಲ್ಲ. ಭೇಟಿ ನೀಡಿದ ಪರಿಸರ ಸಂರಕ್ಷಣಾಕಾರರು TVC ಯ ಪುನರುಜ್ಜೀವನಗೊಂಡ ಭೂಮಿ ಮತ್ತು ಪಕ್ಕದ ಅರಣ್ಯದ ನಡುವೆ ಈಗ ಯಾವುದೇ ಗೋಚರ ವ್ಯತ್ಯಾಸವಿಲ್ಲ ಎಂದು ಅಭಿಪ್ರಾಯಪಟ್ಟಿದ್ದಾರೆ.`,
    farmingHeading: 'TVC ಶೈಲಿಯ ಕೃಷಿ',
    farmingText: 'ಪ್ರಸ್ತುತ ಆಹಾರ ಅಗತ್ಯಗಳನ್ನು ಪರಿಸರಕ್ಕೆ ಹಾನಿಯಾಗದಂತೆ ಅಥವಾ ಭವಿಷ್ಯದ ಪೀಳಿಗೆಗಳ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸುವ ಸಾಮರ್ಥ್ಯಕ್ಕೆ ಧಕ್ಕೆಯಾಗದಂತೆ ಪೂರೈಸುವುದು — ಬೆಳೆ ಸರದಿ, ಸಮಗ್ರ ಕೀಟ ನಿರ್ವಹಣೆ, ನೀರಿನ ಸಂರಕ್ಷಣೆ ಮತ್ತು ರಾಸಾಯನಿಕ ಬಳಕೆ ಕಡಿಮೆ ಮಾಡುವಂತಹ ವಿಧಾನಗಳ ಮೂಲಕ ಸ್ಥಿತಿಸ್ಥಾಪಕ ಆಹಾರ ವ್ಯವಸ್ಥೆಗಳನ್ನು ರೂಪಿಸುವುದು — ಸುಸ್ಥಿರ ಜೀವನವನ್ನು ಅಭ್ಯಾಸ ಮಾಡುವುದು ಸಮುದಾಯದ ಪ್ರಮುಖ ತತ್ವಗಳಲ್ಲಿ ಒಂದು.',
    corePrinciplesHeading: 'ಪ್ರಮುಖ ತತ್ವಗಳು ಮತ್ತು ಗುರಿಗಳು',
    commonPracticesHeading: 'ಸಾಮಾನ್ಯ ಆಚರಣೆಗಳು',
    commonPractices: [
      'ಬೆಳೆ ಸರದಿ ಮಣ್ಣಿನ ಪೋಷಕಾಂಶಗಳನ್ನು ಪುನಃ ತುಂಬಿಸಲು.',
      'ನೈಸರ್ಗಿಕ ಪರಭಕ್ಷಕಗಳನ್ನು ಬಳಸಿ ಸಮಗ್ರ ಕೀಟ ನಿರ್ವಹಣೆ.',
      'ಸವೆತ ತಡೆಗಟ್ಟಲು ಮತ್ತು ಮಣ್ಣನ್ನು ಸುಧಾರಿಸಲು ಹೊದಿಕೆ ಬೆಳೆಗಳು.',
      'ಹನಿ ನೀರಾವರಿ ಮತ್ತು ಮಳೆನೀರು ಕೊಯ್ಲಿನ ಮೂಲಕ ನೀರಿನ ಸಂರಕ್ಷಣೆ.',
      'ಮಣ್ಣಿನ ಸಾವಯವ ಪದಾರ್ಥವನ್ನು ನಿರ್ಮಿಸಲು ಕಾಂಪೋಸ್ಟಿಂಗ್ ಮತ್ತು ಮಲ್ಚಿಂಗ್.',
      'ಕೃಷಿಪರಿಸರ ವಿಜ್ಞಾನ — ನೈಸರ್ಗಿಕ ಪರಿಸರ ವ್ಯವಸ್ಥೆಗಳನ್ನು ಅನುಕರಿಸುವಂತೆ ಫಾರ್ಮ್ ಅನ್ನು ವಿನ್ಯಾಸಗೊಳಿಸುವುದು.',
    ],
    closingText: 'ಕೈಗಾರಿಕಾ ಕೃಷಿ ಸಾಮಾನ್ಯವಾಗಿ ಏಕಬೆಳೆ ಮತ್ತು ಭಾರೀ ರಾಸಾಯನಿಕ ಬಳಕೆಯ ಮೂಲಕ ಹೆಚ್ಚಿನ ಇಳುವರಿಗೆ ಆದ್ಯತೆ ನೀಡುತ್ತದೆ. ಸುಸ್ಥಿರ ಜೀವನವು ಬದಲಿಗೆ ಒಂದು ಸಮಗ್ರ ವ್ಯವಸ್ಥೆಯನ್ನು ಗುರಿಯಾಗಿಸುತ್ತದೆ — ಆರೋಗ್ಯಕರ ಆಹಾರವನ್ನು ಉತ್ಪಾದಿಸುತ್ತಲೇ ನೈಸರ್ಗಿಕ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಪುನರುಜ್ಜೀವನಗೊಳಿಸುವುದು ಮತ್ತು ಸ್ಥಳೀಯ ಆರ್ಥಿಕತೆಗಳನ್ನು ಬೆಂಬಲಿಸುವುದು.',
    designHeading: 'ವಿನ್ಯಾಸ',
    designText: 'ಭೂಮಿಯ ವಿನ್ಯಾಸದ ಹಿಂದಿನ ಪರ್ಮಾಕಲ್ಚರ್ ತತ್ವಗಳು — ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್, ಆಹಾರ ಅರಣ್ಯಗಳು, ಕೃಷಿ ವಲಯಗಳು ಮತ್ತು ಜಲ ಕಾಮಗಾರಿಗಳು — ನಕ್ಷೆ ಮಾಡಲಾಗಿದೆ, ಜೊತೆಗೆ ಡ್ರೋನ್ ಹಾರಾಟ.',
    designLink: 'ವಿನ್ಯಾಸ ನೋಡಿ →',
    peopleHeading: 'TVC ಯ ಭಾಗವಾಗಿರುವವರು ಯಾರು',
    peopleText: 'ಭೂಮಿಯನ್ನು ಸಾಮೂಹಿಕವಾಗಿ ಹೊಂದಿರುವ 53 ಸದಸ್ಯ ಕುಟುಂಬಗಳು, ದಿನನಿತ್ಯ ಇದನ್ನು ನಡೆಸುವ ಸ್ಥಳೀಯ ಸಿಬ್ಬಂದಿ, ಮತ್ತು ಇದೆಲ್ಲವನ್ನೂ ಕಾರ್ಯಗತಗೊಳಿಸುವ ಪಾಲುದಾರರು ಮತ್ತು ನೆರೆಹೊರೆಯ ಸಮುದಾಯ.',
    peopleLink: 'ಜನರನ್ನು ಭೇಟಿ ಮಾಡಿ →',
    joinHeading: 'ಸದಸ್ಯರಾಗಲು ಆಸಕ್ತಿ ಇದೆಯೇ?',
    joinText: 'ಸದಸ್ಯತ್ವ ನಿಜವಾಗಿಯೂ ಮುಕ್ತವಾಗಿಲ್ಲ — 53 ಕುಟುಂಬಗಳು ಈ ಸಮುದಾಯ ಬೆಳೆಯಬಹುದಾದ ಗರಿಷ್ಠ ಗಾತ್ರಕ್ಕೆ ಹತ್ತಿರವಾಗಿದೆ. ಒಂದು ಸ್ಥಾನ ತೆರೆದಾಗ, ಅದು ಯಾವುದೇ ಅರ್ಜಿ ಪ್ರಕ್ರಿಯೆಯ ಮೂಲಕ ಅಲ್ಲ, ಬದಲಾಗಿ ಸದಸ್ಯರ ನಡುವೆ ಖಾಸಗಿಯಾಗಿ ಹಸ್ತಾಂತರಗೊಳ್ಳುತ್ತದೆ. ಅದು ನಿಖರವಾಗಿ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದು ಇಲ್ಲಿದೆ.',
    joinLink: 'ಅದು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಓದಿ →',
  },
  ta: {
    metaDescription: 'டமரிண்ட் வேலி கலெக்டிவ் ஏன் இருக்கிறது, நாங்கள் எதை பிரதிநிதித்துவப்படுத்துகிறோம், மற்றும் நிலம் எப்படி வடிவமைக்கப்பட்டுள்ளது.',
    heroTitle: 'ஏன் TVC?',
    heroIntro: `மேலகிரி மலைகளின் ${FARM_AREA_ACRES} ஏக்கர்களை மீட்டெடுக்கும் 53 குடும்பங்களின் ஒரு கூட்டமைப்பு.`,
    standForHeading: 'நாங்கள் எதை பிரதிநிதித்துவப்படுத்துகிறோம்',
    visionHeading: 'நோக்கம்',
    visionText: 'நிலத்தை ஒற்றை சுற்றுச்சூழல் அமைப்பாக மீட்டெடுக்கும் ஒரு முன்மாதிரியாக இருப்பது — அறிவை சுதந்திரமாக பகிர்ந்துகொள்வது, மற்றும் ஒரு சிறிய, ஒழுங்குமிக்க சமூகம் மிகப்பெரிய நேர்மறையான தாக்கத்தை உருவாக்க முடியும் என்பதை நிரூபிப்பது.',
    missionHeading: 'பணி',
    missionText1: 'நிலைத்தன்மையான வாழ்க்கை முறைக்கு அர்ப்பணிப்புள்ள நபர்களை ஒன்றிணைத்து, இயற்கையுடன் போட்டியிடுவதற்குப் பதிலாக அதனுடன் இணைந்திருக்கும் குறைந்த-ஆற்றல் நிலப்பரப்பை மீட்டெடுப்பது, நமக்கு மட்டுமல்லாமல் பறவைகள் மற்றும் விலங்குகளுக்கும் நியாயமான பங்கை உறுதிசெய்வது எங்கள் நோக்கம். பகிரப்பட்ட உழைப்பு, உள்நாட்டு விதை சேமிப்பு, மற்றும் ஒழுங்குமிக்க நில மேலாண்மை மூலம், மீட்டெடுப்பு சுற்றுச்சூழல் அமைப்புகளையும் அண்டை சமூகங்களையும் மேம்படுத்த முடியும் என்பதை நிரூபிக்க விரும்புகிறோம்.',
    missionText2: 'TVC என்ற பெயர் குறிப்பிடுவது போல, இது நிலைத்தன்மையான வாழ்க்கை கருத்தை உருவாக்க ஒன்றிணைந்த ஒரே எண்ணம் கொண்ட மக்களின் ஒரு கூட்டமைப்பு. தற்போது நாங்கள் <a href="/people/members">53 குடும்பங்கள்</a> — உலகளாவிய இயற்கை வளங்களின் சிதைவைப் பற்றி அக்கறை கொண்டு, நுகர்வைக் குறைத்து, இயற்கையாக ஆதரிக்கப்படும் சுழற்சி முறைகளை உள்ளடக்கிய ஒரு வாழ்க்கை முறையை பரிசோதிக்க விரும்புகிறோம்.',
    missionText3: `TVC என்பது இந்த குடும்பங்களின் கூட்டு உரிமையிலான மேலகிரி மலைகளின் ${FARM_AREA_ACRES} ஏக்கர் நிலம் — கிழக்கு மற்றும் மேற்கு தொடர்ச்சி மலைகள் சந்திக்கும், தமிழ்நாட்டின் தர்மபுரி மற்றும் கிருஷ்ணகிரி மாவட்டங்களில் பரவியிருக்கும், காவேரி நதியோரம் கர்நாடகாவுடன் எல்லையைப் பகிரும் மலைத்தொடர். இந்த தொடர்ச்சியின் ஒரு பகுதி 2014 இல் காவேரி வடக்கு வனவிலங்கு சரணாலயமாக அறிவிக்கப்பட்டது, மேலும் முழு நிலப்பரப்பும் பன்னேர்காட்டா தேசிய பூங்காவை காவேரியுடன் இணைக்கும் ஒரு வாழும் யானை தாழ்வாரமாகும் — MM மலைகள், BR மலைகள், சத்தியமங்கலம் மற்றும் நீலகிரி உயிர்க்கோள இருப்பு ஆகியவற்றையும் இணைக்கும் ஒரு பரந்த சங்கிலியின் ஒரு இணைப்பு. நீண்ட தூரம் நகரும் விலங்குகள், குறிப்பாக யானைகள், மனிதன் வரையறுத்த எல்லைகளை அறியாதவை என்பதால் இங்கு சுதந்திரமாக நகர்கின்றன; தாழ்வாரத்தை துண்டாக்கும் பண்ணைகள், சாலைகள் மற்றும் குடியிருப்புகள் அந்த நகர்வை தடுத்து மனிதன்-யானை மோதலை மோசமாக்குகின்றன. சுரண்டல் விவசாய முறைகளால், நாங்கள் இதை வாங்கியபோது நிலம் சிதைந்திருந்தது — இந்த தாழ்வாரத்திற்கு தாங்க முடியாத வகையான துண்டாக்கம். 2017 முதல், சமூகம் இயற்கை வேளாண்மை கொள்கைகளைப் பயன்படுத்தி அதன் வளத்தன்மையை இயற்கையாக மீட்டெடுத்து வருகிறது: இந்தியாவின் மிக முக்கியமான வனவிலங்கு தாழ்வாரங்களில் ஒன்றின் வாழ்விட தரத்தை மீட்டெடுக்கும் ஒரு சிறிய, சரிபார்க்கக்கூடிய பங்கு, வெறும் கூற்று அல்ல. வருகை தந்த பாதுகாவலர்கள் TVC-யின் மீட்டெடுக்கப்பட்ட நிலத்திற்கும் அருகிலுள்ள காடுகளுக்கும் இடையே இப்போது எந்த காணக்கூடிய வேறுபாடும் இல்லை என்று குறிப்பிட்டுள்ளனர்.`,
    farmingHeading: 'TVC பாணி விவசாயம்',
    farmingText: 'தற்போதைய உணவு தேவைகளை சுற்றுச்சூழலுக்கு தீங்கு விளைவிக்காமல் அல்லது எதிர்கால சந்ததியினரின் தேவைகளை பூர்த்தி செய்யும் திறனை பாதிக்காமல் நிறைவேற்றுவது — பயிர் சுழற்சி, ஒருங்கிணைந்த பூச்சி மேலாண்மை, நீர் சேமிப்பு மற்றும் இரசாயன உள்ளீடுகளை குறைத்தல் போன்ற முறைகளைப் பயன்படுத்தி நெகிழ்வான உணவு அமைப்புகளை உருவாக்குவது — சமூகத்தின் முக்கிய கொள்கைகளில் ஒன்று நிலைத்தன்மையான வாழ்க்கையை கடைப்பிடிப்பதாகும்.',
    corePrinciplesHeading: 'முக்கிய கொள்கைகள் மற்றும் இலக்குகள்',
