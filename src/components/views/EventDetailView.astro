---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import AddToCalendar from '../AddToCalendar.astro';
import BookingInquiry from '../BookingInquiry.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { formatDateRange, durationTag } from '../../utils/events';
import { icsDataUri, googleCalendarUrl } from '../../utils/calendar';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  event: CollectionEntry<'events'>;
}

const { lang, event } = Astro.props;
const { Content } = await render(event);

// kn/ta translations live as sibling entries with a "kn/"/"ta/" id prefix
// (see EventsIndexView.astro) - the interest-widget counter and the
// "add to calendar" .ics UID key off this bare id instead, so a click from
// any language page counts toward the same real-world event rather than
// fragmenting the tally per locale.
const canonicalId = event.id.replace(/^(kn|ta)\//, '');

// Only worth offering on events that haven't happened yet -- adding a past
// event to your calendar is a dead end, not a conversion.
const isUpcoming = event.data.date >= new Date();
// The "at a glance" sidebar only earns its place once there's a real price
// to show and something still bookable -- a past event's price is no longer
// actionable, and an event with no `price` set has nothing to summarize.
const showSidebar = isUpcoming && Boolean(event.data.price?.length);
// Only pass a custom social-preview image when its real dimensions are also
// known - BaseLayout's og:image:width/height must match the actual file or
// WhatsApp's crawler silently discards the image and falls back to the
// site's apple-touch-icon (the bug this guards against). An event missing
// coverImageWidth/Height degrades to BaseLayout's own sitewide default
// image+dimensions instead of repeating that failure.
const hasSizedCoverImage = Boolean(event.data.coverImage && event.data.coverImageWidth && event.data.coverImageHeight);
const calendarEvent = {
  uid: canonicalId,
  title: event.data.title,
  description: event.data.excerpt,
  date: event.data.date,
  endDate: event.data.endDate,
};

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.data.title,
  startDate: event.data.date.toISOString().slice(0, 10),
  endDate: event.data.endDate ? event.data.endDate.toISOString().slice(0, 10) : undefined,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  description: event.data.excerpt,
  image: event.data.coverImage ? new URL(event.data.coverImage, Astro.site).toString() : undefined,
  location: {
    '@type': 'Place',
    name: 'Tamarind Valley Collective',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Thaggatti village',
      addressLocality: 'Kanakapura',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
  },
  organizer: event.data.organizer
    ? { '@type': 'Organization', name: event.data.organizer }
    : { '@type': 'Organization', name: 'Tamarind Valley Collective', url: new URL(getRelativeLocaleUrl(lang, '/'), Astro.site).toString() },
};

const content = {
  en: {
    organizedBy: (organizer: string) => `Organized by ${organizer}`,
    wantAgainHeading: 'Want this to happen again?',
    wantAgainText: "Let us know and we'll factor it into what we plan next.",
    emailPlaceholder: 'you@example.com (optional)',
    emailAriaLabel: 'Email (optional)',
    interestButton: "I'm interested",
    seeItHere: 'See it here →',
    msgCountSingular: '1 person wants this again.',
    msgCountPluralTemplate: '{n} people want this again.',
    msgRegistered: "You're in — we'll factor this into what we plan next.",
  },
  kn: {
    organizedBy: (organizer: string) => `ಆಯೋಜಕರು: ${organizer}`,
    wantAgainHeading: 'ಇದು ಮತ್ತೆ ನಡೆಯಬೇಕೆಂದು ಬಯಸುವಿರಾ?',
    wantAgainText: 'ನಮಗೆ ತಿಳಿಸಿ, ಮುಂದಿನ ಯೋಜನೆಯಲ್ಲಿ ನಾವು ಇದನ್ನು ಪರಿಗಣಿಸುತ್ತೇವೆ.',
    emailPlaceholder: 'you@example.com (ಐಚ್ಛಿಕ)',
    emailAriaLabel: 'ಇಮೇಲ್ (ಐಚ್ಛಿಕ)',
    interestButton: 'ನನಗೆ ಆಸಕ್ತಿ ಇದೆ',
    seeItHere: 'ಇಲ್ಲಿ ನೋಡಿ →',
    msgCountSingular: '1 ವ್ಯಕ್ತಿ ಇದು ಮತ್ತೆ ಆಗಬೇಕೆಂದು ಬಯಸುತ್ತಾರೆ.',
    msgCountPluralTemplate: '{n} ಜನರು ಇದು ಮತ್ತೆ ಆಗಬೇಕೆಂದು ಬಯಸುತ್ತಾರೆ.',
    msgRegistered: 'ನೀವು ಸೇರಿದ್ದೀರಿ — ಮುಂದಿನ ಯೋಜನೆಯಲ್ಲಿ ನಾವು ಇದನ್ನು ಪರಿಗಣಿಸುತ್ತೇವೆ.',
  },
  ta: {
    organizedBy: (organizer: string) => `ஏற்பாட்டாளர்: ${organizer}`,
    wantAgainHeading: 'இது மீண்டும் நடக்க வேண்டுமா?',
    wantAgainText: 'எங்களுக்குத் தெரியப்படுத்துங்கள், அடுத்த திட்டமிடலில் இதைக் கருத்தில் கொள்வோம்.',
    emailPlaceholder: 'you@example.com (விருப்பத்தேர்வு)',
    emailAriaLabel: 'மின்னஞ்சல் (விருப்பத்தேர்வு)',
    interestButton: 'எனக்கு ஆர்வம் உள்ளது',
    seeItHere: 'இங்கே பாருங்கள் →',
    msgCountSingular: '1 நபர் இது மீண்டும் நடக்க வேண்டும் என விரும்புகிறார்.',
    msgCountPluralTemplate: '{n} பேர் இது மீண்டும் நடக்க வேண்டும் என விரும்புகிறார்கள்.',
    msgRegistered: 'நீங்கள் இணைந்துவிட்டீர்கள் — அடுத்த திட்டமிடலில் இதைக் கருத்தில் கொள்வோம்.',
  },
} as const;

const c = content[lang];

// Opt-in sub-brand treatment (see `series` on the events schema) - currently
// only 3bs1h has a kit; any future recurring series would add its own case
// here rather than each getting bespoke wiring through PageHero/BaseLayout.
const brand =
  event.data.series === '3bs1h'
    ? // Cream (reversed) mark, not the green ink variant - the hero sits on a
      // dark photo scrim (see PageHero's .hero-bg__scrim), where the kit's own
      // green ink has too little contrast to read as a bird rather than a blob.
      { brandClass: 'hero--3bs1h', logo: '/images/brand/3bs1h/3bs1h-quad-cream.svg', logoAlt: '3Bs&1H — Birds, Butterflies, Bees & Herps' }
    : {};
---

<BaseLayout
  lang={lang}
  title={event.data.title}
  description={event.data.excerpt}
  image={hasSizedCoverImage ? event.data.coverImage : undefined}
  imageWidth={hasSizedCoverImage ? event.data.coverImageWidth : undefined}
  imageHeight={hasSizedCoverImage ? event.data.coverImageHeight : undefined}
  schema={[eventSchema]}
>
  <PageHero eyebrow={formatDateRange(event.data.date, event.data.endDate, lang)} title={event.data.title} image={event.data.coverImage} imageAlt={event.data.coverImageAlt ?? event.data.title} {...brand} />
  <article class={`section wrapper prose ${event.data.series === '3bs1h' ? 'event--3bs1h' : ''} ${!showSidebar ? 'prose--wide' : ''}`.trim()}>
    {event.data.series === '3bs1h' && (
      <a class="series-link" href="/events/3bs1h">Part of 3Bs&amp;1H →</a>
    )}

    {/* Any upcoming event with a `price` set (see content.config.ts) gets a
        sticky "at a glance" sidebar alongside the main column, instead of
        the plain single-column layout below - the standard template for
        every event going forward, not a 3bs1h-only treatment. Explored as
        five options in a throwaway prototype (widen the text, this sidebar,
        and three image treatments) before landing here: it directly answers
        "the price is a repeat"/"almost hidden" by being the ONE place price
        is stated, using data already on the page rather than a new image
        that would need sourcing per event. The sidebar's "Request to book"
        link always points at #cta - pair `price` with a call-to-action
        element carrying that id somewhere in the event (this component
        renders one itself for 3bs1h; other events put it on their own
        body's Register/booking block, see _template.md).

        Markup order below is aside-then-main, not main-then-aside, even
        though the aside renders as the right-hand column on desktop (see
        .layout-grid using grid-template-areas to place it there regardless
        of source order): on the single-column mobile layout, `<Content />`
        always ends with its own booking CTA at #cta (see _template.md), so
        a literal main-then-aside markup order stacked the price/"book"
        summary card AFTER that CTA - a visitor had to scroll past the
        booking form to reach the card that was supposed to summarize it,
        and the card's own "book" link then jumped backward, up the page,
        to a form already behind them. Aside-first markup makes the summary
        the first thing after the tags on mobile (matching its "at a
        glance" purpose) and makes its "book" link jump forward, down the
        page, to the CTA - the direction a scroll link should point. */}
    {showSidebar ? (
      <div class="layout-grid">
        <aside class="layout-grid__aside">
          <div class="info-card">
            <p class="info-card__label">At a glance</p>
            <p class="info-card__date">{formatDateRange(event.data.date, event.data.endDate, lang)}</p>
            <ul class="info-card__prices">
              {event.data.price!.map((p) => <li><strong>{p.amount}</strong> {p.label}</li>)}
            </ul>
            {/* Not "Book now" - that read as an instant online checkout to
                at least one visitor, when this is actually an offline
                request TVC (or, for 3bs1h, Linger) follows up on by hand;
                see BookingInquiry's own submit button, which says "Send
                booking request" for the same reason. */}
            <a class="button info-card__cta" href="#cta">Request to book ↓</a>
          </div>
        </aside>
        <div class="layout-grid__main">
          <div class="meta">
            {event.data.organizer && <p class="organizer">{c.organizedBy(event.data.organizer)}</p>}
            <ul class="tags">
              {event.data.tags.map((t) => <li class="tag">{t}</li>)}
              <li class="tag tag--duration">{durationTag(event.data.date, event.data.endDate, lang)}</li>
            </ul>
          </div>
          <Content />
          {/* 3Bs&1H editions book through TVC's hospitality partner Linger,
              not through TVC directly - reuses the same visit-inquiry
              Netlify form as /visit/camping etc. (already wired to notify
              stay@linger.in) rather than a bespoke booking flow. Other
              events carry their own CTA inside `<Content />` itself (see
              #cta above), so nothing extra renders here for them. */}
          {event.data.series === '3bs1h' && (
            <div id="cta">
              <BookingInquiry
                lang={lang}
                type={event.data.title}
                heading="Request to book"
                packageOptions={['Deck-based tent / bamboo hut — ₹3,500 per person', 'Campground tent / DIY camping — ₹3,200 per person']}
                note="Choose your accommodation tier, then send your details to Linger by form or WhatsApp."
                whatsappMessage={`Hi! I'd like to book a spot for ${event.data.title} (${formatDateRange(event.data.date, event.data.endDate, lang)}).`}
                fixedDates={formatDateRange(event.data.date, event.data.endDate, lang)}
              />
            </div>
          )}
        </div>
      </div>
    ) : (
      <>
        <div class="meta">
          {event.data.organizer && <p class="organizer">{c.organizedBy(event.data.organizer)}</p>}
          <ul class="tags">
            {event.data.tags.map((t) => <li class="tag">{t}</li>)}
            <li class="tag tag--duration">{durationTag(event.data.date, event.data.endDate, lang)}</li>
          </ul>
        </div>
        <Content />
      </>
    )}

    {/* Calendaring only makes sense once you're actually going - kept below
        the booking CTA (or below the content, for events with no CTA of
        their own) rather than at the top, where it used to sit as if it were
        the page's primary action before there was anything to commit to. */}
    {isUpcoming && (
      <div class="add-to-cal-section">
        <span class="add-to-cal-label">{event.data.series === '3bs1h' ? 'Already booked? Add it to your calendar:' : 'Add this to your calendar:'}</span>
        <AddToCalendar
          lang={lang}
          googleUrl={googleCalendarUrl(calendarEvent)}
          icsHref={icsDataUri(calendarEvent)}
          icsFilename={`${canonicalId}.ics`}
        />
      </div>
    )}

    {!isUpcoming && (
      event.data.interestNote ? (
        <div class="interest-widget card interest-widget--closed">
          <p>
            {event.data.interestNote}
            {event.data.interestNoteHref && <> <a href={event.data.interestNoteHref}>{c.seeItHere}</a></>}
          </p>
        </div>
      ) : (
        <div
          class="interest-widget card"
          data-event={canonicalId}
          data-event-title={event.data.title}
          data-msg-count-singular={c.msgCountSingular}
          data-msg-count-plural-template={c.msgCountPluralTemplate}
          data-msg-registered={c.msgRegistered}
        >
          <h2>{c.wantAgainHeading}</h2>
          <p>{c.wantAgainText}</p>
          <form class="interest-form">
            <input type="email" name="email" placeholder={c.emailPlaceholder} aria-label={c.emailAriaLabel} />
            <button type="submit" class="button">{c.interestButton}</button>
          </form>
          <p class="interest-count" hidden></p>
        </div>
      )
    )}

    {/* Static form for Netlify's build-time bot to detect and register -- the
        actual submission (see the script below) is an AJAX POST mirroring
        these same fields, not a direct submit of this hidden form. Present
        on every past event page regardless of interestNote, so detection
        doesn't depend on any one specific page. Field names/labels are not
        user-visible (the form is hidden), so left as-is across locales. */}
    {!isUpcoming && (
      <form name="event-interest" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
        <input type="text" name="event" />
        <input type="text" name="event-title" />
        <input type="email" name="email" />
        <input name="bot-field" />
      </form>
    )}
  </article>

  {!isUpcoming && !event.data.interestNote && (
  <script>
    const widget = document.querySelector<HTMLElement>('.interest-widget[data-event]');

    if (widget) {
      const eventId = widget.dataset.event!;
      const eventTitle = widget.dataset.eventTitle ?? '';
      const form = widget.querySelector<HTMLFormElement>('.interest-form');
      const emailInput = widget.querySelector<HTMLInputElement>('input[name="email"]');
      const submitBtn = widget.querySelector<HTMLButtonElement>('button[type="submit"]');
      const countEl = widget.querySelector<HTMLElement>('.interest-count');
      const storageKey = `tvc-event-interest-${eventId}`;

      function showCount(count: number) {
        if (!countEl) return;
        const singular = widget!.dataset.msgCountSingular ?? '';
        const pluralTemplate = widget!.dataset.msgCountPluralTemplate ?? '';
        countEl.textContent = count === 1 ? singular : pluralTemplate.replace('{n}', String(count));
        countEl.hidden = false;
      }

      function markRegistered() {
        form?.setAttribute('hidden', '');
        if (!widget!.querySelector('.interest-done')) {
          const done = document.createElement('p');
          done.className = 'interest-done';
          done.textContent = widget!.dataset.msgRegistered ?? '';
          form?.insertAdjacentElement('afterend', done);
        }
      }

      fetch(`/api/event-interest?event=${encodeURIComponent(eventId)}`)
        .then((r) => r.json())
        .then((data) => showCount(data.count ?? 0))
        .catch(() => {});

      if (localStorage.getItem(storageKey)) {
        markRegistered();
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        const email = emailInput?.value.trim() ?? '';

        try {
          const res = await fetch('/api/event-interest', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ event: eventId, email }),
          });
          const data = await res.json();

          if (res.ok) {
            showCount(data.count);
            localStorage.setItem(storageKey, '1');
            markRegistered();

            if (email && !data.deduped) {
              // Fire-and-forget: gives the farm team an actionable entry via
              // the same Netlify Forms mechanism as /contact and
              // /visit/host-an-event -- see the hidden form above.
              fetch('/', {
                method: 'POST',
                headers: { 'content-type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                  'form-name': 'event-interest',
                  event: eventId,
                  'event-title': eventTitle,
                  email,
                }).toString(),
              }).catch(() => {});
            }
          }
        } catch {
          // Leave the form enabled so they can retry.
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  </script>
  )}
</BaseLayout>

<style>
  .series-link {
    display: inline-block;
    font-family: var(--font-3bs1h-label);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-green-vivid);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .organizer {
    margin: 0;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .tag--duration {
    background: var(--tvc-orange-tint);
    color: #a85712;
  }

  /* 3Bs&1H sub-brand body — opt-in via the `event--3bs1h` class, only ever
     applied when event.data.series === '3bs1h' (see the brand const above).
     Restyles headings within .prose rather than forking a new template.
     Tag pills deliberately stay the same green/orange scheme every other
     event uses (see .tag/.tag--duration above) - a past attempt to give
     3bs1h its own cream/green tag colors also had a specificity bug that
     silently swallowed the orange duration pill into the same cream look,
     which is what actually got flagged as inconsistent. */
  .event--3bs1h.prose :global(h2) {
    font-family: var(--font-3bs1h-display);
    font-weight: 500;
  }

  .prose :global(h2) {
    margin-top: 32px;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--tvc-orange);
    padding-left: 20px;
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .prose :global(img) {
    border-radius: var(--radius);
    margin: 16px 0;
  }

  .prose :global(table) {
    width: 100%;
    max-width: 72ch;
    border-collapse: collapse;
    margin: 16px 0 32px;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 10px 16px;
    border-bottom: 1px solid var(--tvc-line);
  }

  .prose :global(th) {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--tvc-orange);
  }

  .prose :global(td:first-child) {
    color: var(--tvc-ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(.cta) {
    max-width: 72ch;
    margin: 32px 0;
  }

  .prose :global(.cta h3) {
    margin-top: 0;
  }

  .prose :global(.cta .button) {
    margin: 12px 0;
  }

  /* Keeps the booking CTA aligned with this article's own reading column -
     BookingInquiry.astro has no opinion on width (its other callers sit in
     plain, non-.prose sections that stretch full-width), so without this it
     would stretch past where every paragraph and table above it stops,
     reading as a mismatched, wider "box" rather than the column's own close. */
  .prose :global(.booking-inquiry) {
    max-width: 72ch;
  }

  /* The 72ch reading-column cap above exists to leave room for the "at a
     glance" sidebar beside it - on a past event there's no sidebar (see
     showSidebar), so the cap alone just leaves an unbalanced gap on wide
     screens instead. prose--wide (applied only when the sidebar is absent)
     lets the column fill the wrapper instead, same as content outside
     .prose already does by default. */
  .prose--wide :global(p),
  .prose--wide :global(table),
  .prose--wide :global(.cta),
  .prose--wide :global(.booking-inquiry) {
    max-width: none;
  }

  /* Fills the space next to the reading column with a live summary instead
     of leaving it as bare page background - the sticky positioning keeps
     dates/prices/the booking link in view for the whole read, which is the
     actual point (not just decoration): see the "price is almost hidden"
     fix this was built to answer. */
  .layout-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    /* Named areas, not source order, decide visual placement - the markup
       puts <aside> before .layout-grid__main (see the comment above that
       markup) so it appears first when this collapses to one column on
       mobile, but on this two-column desktop layout it still needs to sit
       on the right, beside the reading column, as before. */
    grid-template-areas: 'main aside';
    gap: 48px;
    align-items: start;
  }

  .layout-grid__main {
    grid-area: main;
  }

  .layout-grid__aside {
    grid-area: aside;
    position: sticky;
    top: 100px;
  }

  .info-card {
    background: var(--tvc-3bs1h-cream);
    border-radius: var(--radius);
    padding: 22px;
    box-shadow: var(--shadow-soft);
  }

  .info-card__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tvc-green-vivid);
    font-weight: 700;
    margin: 0 0 8px;
  }

  .info-card__date {
    font-weight: 700;
    margin: 0 0 14px;
  }

  .info-card__prices {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }

  .info-card__prices li {
    font-size: 0.92rem;
    margin-bottom: 6px;
  }

  .info-card__prices li:last-child {
    margin-bottom: 0;
  }

  .info-card__cta {
    width: 100%;
    text-align: center;
  }

  /* Offsets the jump-link landing spot below the site's sticky header, same
     reason any anchor target on this site needs it. Targets both the
     BookingInquiry wrapper this component renders for 3bs1h and any other
     event's own #cta element inside <Content /> (see _template.md). */
  :global(#cta) {
    scroll-margin-top: 90px;
