    reviewsHeading: 'ಭೇಟಿ ನೀಡಿದವರು ಏನು ಹೇಳುತ್ತಾರೆ',
    reviewsText: 'TVC ಯಲ್ಲಿನ ತಮ್ಮ ವಾಸ್ತವ್ಯದ ಬಗ್ಗೆ ಹಿಂದಿನ ಅತಿಥಿಗಳು ಏನು ಹೇಳುತ್ತಾರೆ ಎಂಬುದನ್ನು ಓದಿ, ಅಥವಾ ನಿಮ್ಮ ಸ್ವಂತ ಅನುಭವವನ್ನು ಹಂಚಿಕೊಳ್ಳಿ.',
    reviewsLink: 'Google ನಲ್ಲಿ ವಿಮರ್ಶೆಗಳನ್ನು ಓದಿ →',
    faqHeading: 'FAQ',
    faqs: [
      { q: 'ನನ್ನ ಭೇಟಿಯನ್ನು ನಾನು ಹೇಗೆ ಯೋಜಿಸಬಹುದು?', a: 'ಕೆಳಗಿನ ಸಂಬಂಧಿತ ಪುಟದಲ್ಲಿ ವಿಚಾರಣೆ ಫಾರ್ಮ್ ಅನ್ನು ಭರ್ತಿ ಮಾಡಿ (ಅಥವಾ WhatsApp ನಲ್ಲಿ ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ) — ಅಲ್ಲಿಂದ ನಾವು ನಮ್ಮ ಆತಿಥ್ಯ ಪಾಲುದಾರ Linger ಜೊತೆ ವಾಸ್ತವ್ಯವನ್ನು ಸಂಯೋಜಿಸುತ್ತೇವೆ.' },
      { q: 'ಈ ಸ್ಥಳ ಹಿರಿಯರಿಗೆ ಸ್ನೇಹಪರವೇ?', a: 'ಸಾಕಷ್ಟು ನಡಿಗೆ ಇದೆ — ಕ್ಯಾಂಪ್ ಸೈಟ್ ಪಾರ್ಕಿಂಗ್ ಲಾಟ್‌ನಿಂದ 5-7 ನಿಮಿಷದ ನಡಿಗೆ. ಸಕ್ರಿಯ ಹಿರಿಯರಿಗೆ ಸೂಕ್ತ, ಆದರೆ ಅತ್ಯಂತ ಪ್ರವೇಶಿಸಬಹುದಾದ ಸ್ಥಳವಲ್ಲ.' },
      { q: 'ಆಹಾರದ ಬಗ್ಗೆ ಏನು?', a: 'ಆಹಾರ ಶುಲ್ಕದಲ್ಲಿ ಸೇರಿದೆ. ಊಟಗಳು ತಾಜಾವಾಗಿ ತಯಾರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಹೆಚ್ಚಾಗಿ ಸಸ್ಯಾಹಾರಿ; ವಿನಂತಿಯ ಮೇರೆಗೆ ಮಾಂಸಾಹಾರಿ. ನೀವು ಪಡೆಯುವುದು ಋತುಮಾನ ಮತ್ತು ಲಭ್ಯತೆಯನ್ನು ಅವಲಂಬಿಸಿರುತ್ತದೆ — ಅ ಲಾ ಕಾರ್ಟೆ ಆಯ್ಕೆಗಳಿಲ್ಲ.' },
      { q: 'ಭೇಟಿ ನೀಡಲು ಉತ್ತಮ ಸಮಯ ಯಾವುದು?', a: 'ಜೂನ್‌ನಿಂದ ಜನವರಿ ಉತ್ತಮ. ಈ ತಿಂಗಳುಗಳಲ್ಲಿ ಇದು ಹೆಚ್ಚಾಗಿ ಆಹ್ಲಾದಕರವಾಗಿರುತ್ತದೆ, ಆದರೂ ಗಾಳಿ ಇಲ್ಲದೆ ಬೆಚ್ಚಗೆ ಅನಿಸಬಹುದು.' },
      { q: 'ವನ್ಯಜೀವಿ ದೃಶ್ಯ ಹೇಗಿದೆ?', a: 'ಯಾವುದೇ ಕಠಿಣ ಗಡಿಗಳಿಲ್ಲ — ಮೊಲಗಳು ಮತ್ತು ಕಾಡುಹಂದಿಗಳು ಸಾಮಾನ್ಯ ಸಂದರ್ಶಕರು. ಬೇಸಿಗೆಯಲ್ಲಿ ಆನೆಗಳು ಭೇಟಿ ನೀಡುತ್ತವೆ, ಹುಣಸೆಹಣ್ಣು ಮತ್ತು ರಾಗಿಯಿಂದ ಆಕರ್ಷಿತವಾಗಿ; TVC ಮೇಲಗಿರಿಗಳ ಆನೆ ಕಾರಿಡಾರ್‌ನೊಳಗೆ ಇದೆ, ಕಾವೇರಿ ಉತ್ತರ ವನ್ಯಜೀವಿ ಅಭಯಾರಣ್ಯ, ಬನ್ನೇರುಘಟ್ಟ ಮತ್ತು ನೀಲಗಿರಿ ಜೀವಗೋಳ ಮೀಸಲು ಪ್ರದೇಶದಂತೆಯೇ ಸಂಪರ್ಕಿತ ಭೂಪ್ರದೇಶದ ಭಾಗ.' },
