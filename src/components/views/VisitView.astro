  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const trekkingHref = getRelativeLocaleUrl(lang, '/visit/trekking-trails');
const trekLinkHtml = c.trekLinkText.replace('{href}', trekkingHref);
---

<BaseLayout lang={lang} title={t('nav.visitTvc')} description={c.metaDescription} schema={[faqSchema]} image="/images/pages/home/gallery-3.jpg" imageWidth={768} imageHeight={768}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/pages/home/gallery-3.jpg"
    imageAlt="A collage of freshly harvested farm produce"
  />

  <section class="section wrapper">
    <h2>{c.whatToExpectHeading}</h2>
    <p set:html={c.whatToExpectText} />

    <h3>{c.foodHeading}</h3>
    <p>{c.foodText}</p>

    <h3>{c.facilitiesHeading}</h3>
    <p>{c.facilitiesText1}</p>
    <p>{c.facilitiesText2}</p>

    <h3>{c.activitiesHeading}</h3>
    <div class="activity-grid">
      {c.activities.map((a) => (
        <div class="card">
          <h4>{a.name}</h4>
          <p>{a.desc}</p>
        </div>
      ))}
    </div>
    <p set:html={trekLinkHtml} />
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.chooseHeading}</h2>
      <div class="visit-options">
        {c.options.map((opt) => (
          <a class="card" href={getRelativeLocaleUrl(lang, opt.href)}>
            <h3>{opt.title}</h3>
            <p>{opt.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrapper">
    <h2>{c.nearbyHeading}</h2>
    <p set:html={c.nearbyText} />
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.etiquetteHeading}</h2>
      <div class="two-col">
        <div>
          <h4>{c.etiquetteSubheading}</h4>
          <ul>
            {c.etiquetteList.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h4>{c.precautionsSubheading}</h4>
          <ul>
            {c.precautionsList.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrapper">
    <h2>{c.reviewsHeading}</h2>
    <div class="review-cta card">
      <p>{c.reviewsText}</p>
      <a class="button" href="https://www.google.com/maps?cid=12716822598495943685" target="_blank" rel="noopener noreferrer">{c.reviewsLink}</a>
    </div>
  </section>

  <section class="section wrapper">
    <h2>{c.faqHeading}</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
    margin: 16px 0;
  }

  /* Capped at 3 columns (not auto-fit) so 5 cards wrap 3+2 instead of
     stranding a lone 5th card alone on a mostly-empty row 2 at desktop
     widths — auto-fit's "however many fit" doesn't account for how many
     items there actually are. */
  .visit-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(230px, 1fr));
    gap: 18px;
    margin: 16px 0;
  }

  .visit-options a {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 780px) {
    .visit-options {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .faq-list details {
    border-bottom: 1px solid var(--tvc-line);
    padding: 14px 0;
  }

  .faq-list summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--tvc-green-dark);
  }

  .faq-list p {
    margin-top: 10px;
    color: var(--tvc-ink-soft);
  }

  .review-cta {
    max-width: 560px;
    text-align: center;
  }

  .review-cta p {
    margin: 0 0 16px;
    color: var(--tvc-ink-soft);
  }
</style>
