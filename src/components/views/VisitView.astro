---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/utils';
import { NIGHT_SKY_BRIGHTNESS_UCD_M2 } from '../../data/site-facts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Prose content for this page only - shared chrome (nav labels etc.) comes
// from src/i18n/*.ts via t() above. The FAQ array feeds both the rendered
// <details> list and the JSON-LD FAQPage schema below, built from the same
// per-locale array so the two can't drift apart.
const content = {
  en: {
    metaDescription: 'Day trips, overnight camps, workshops, and volunteering at Tamarind Valley Collective — what to expect, activities, and how to plan your visit.',
    heroEyebrow: 'Visit TVC',
    heroTitle: 'Come spend time in the hills',
    heroIntro: "We're on a hillslope facing west with stunning sunset views across the valley. Depending on the season, you'll see everything from deep green foliage to a golden brown hillside.",
    whatToExpectHeading: 'What to expect',
    whatToExpectText: `The land is laid out in <a href="${getRelativeLocaleUrl(lang, '/about/design')}">three zones</a> — wildlife corridor, food forest, and cultivated land — regenerating naturally over the last several years. Hike up to the Chikkamma-Doddamma temple and you'll get a panoramic view of the whole valley. You'll be greeted with a cacophony of bird songs early in the morning and again in the evening — and if you're visiting after Dussehra, expect the morning dew to leave your trousers wet on early walks.`,
    foodHeading: 'The food',
    foodText: 'We keep the food as local as possible, cooked using recipes from the local community that runs our kitchen — ragi mudde, tangy rasam and sambhar with farm-harvested tamarind, soppu from whatever greens are in season, and seasonal fruit depending on what the elephants and monkeys have left us.',
    facilitiesHeading: 'The facilities',
    facilitiesText1: "Tented accommodation across the Malabar hut (two tents, each fitting up to 3 adults or a family of 2 adults + 2 kids, plus a large common space) and the Banyan hut (one tent + deck), plus two bamboo huts (2 adults each) and dome tents for a more adventurous camping experience — all weatherproof, usable year-round, and laid out with mattresses and sheets. There's a lunch hut next to the kitchen to sit, chat, and learn about farming — and yes, there's WiFi via BSNL, which should tell you all you need to know about its reliability.",
    facilitiesText2: "Common toilets have western closets, a closed shower and an open one (no hot water at the showers, but the kitchen can heat some up on request), and minimal lighting — grid-powered with a solar backup and a generator for the rare bad day. Ask for a torch if your phone isn't cutting it.",
    activitiesHeading: 'Activities',
    activities: [
      { name: 'Farm Tour', desc: 'A ~2 hour walk through the kitchen garden, the water works, the food forest, and the trees and birds along the way.' },
      { name: 'Bird Watching', desc: 'Over 100 species have been sighted here — early morning is best for spotting and identifying them.' },
      { name: 'Basket Making', desc: "Our expert basket maker Ramdoss can teach you bamboo craft — this needs advance notice so we can set it up." },
      { name: 'Star Gazing', desc: `The valley measures just ${NIGHT_SKY_BRIGHTNESS_UCD_M2} μcd/m² of artificial brightness — on a clear night (most nights here), the stars and galaxies are bright and unmistakable.` },
      { name: 'Chop & Drop', desc: "An integral part of our permaculture system — happy to hand you a machete if you'd like to help." },
      { name: 'Board Games', desc: "A relaxed way to spend time with family and friends when you'd rather save your energy." },
      { name: 'Campfire', desc: 'Weather permitting, we can light a campfire and set up a small vegetarian barbeque.' },
    ],
    trekLinkText: 'Plus <a href="{href}">hiking on three trails</a> into the adjacent forest.',
    chooseHeading: 'Choose how you visit',
    options: [
      { title: 'Day Visit', desc: 'Picnic at the Farm, a Hiking Adventure, or a Do Nothing day — hour-by-hour itineraries.', href: '/visit/day-visit' },
      { title: 'Overnight Camping', desc: 'A two-day stay with a hike to the sunset viewpoint, campfire, and a guided farm tour.', href: '/visit/camping' },
      { title: 'Events at TVC', desc: 'Team outings, workshops on permaculture and bamboo craft, nature retreats, tech camps — up to 20 people, with camping included.', href: '/visit/host-an-event' },
      { title: 'Volunteering', desc: 'Learn by doing — contribute to day-to-day farm activities (chopping, planting, digging, sowing, harvesting). Accommodation is in the guest house, charged for basic food and stay.', href: '/contact' },
      { title: 'How to Reach', desc: 'Directions from both the Tamil Nadu and Karnataka sides.', href: '/visit/how-to-reach' },
    ],
    nearbyHeading: 'Nearby attractions',
    nearbyText: 'The Cauvery river is just over 10 km away. <strong>Hogenekal Falls</strong> is about 55 km / 1.5 hours, winding through Anchetty, Natrapalayam and Bingundala. <strong>Chunchi Falls / Mekedatu</strong> is about 53 km / 1.25 hours — a good detour via Kanakapura on the way to or from TVC.',
    etiquetteHeading: 'Etiquette & precautions',
    etiquetteSubheading: 'Etiquette',
    etiquetteList: [
      'Treat the farm staff and local villagers with respect, including their right of way.',
      'Watch for domestic animals (cows, goats, hens) when driving in.',
      'No alcohol or other intoxicants on-site.',
      'Avoid littering plastic — take it back with you or hand it to farm staff.',
      'Avoid trampling saplings or damaging plants.',
    ],
    precautionsSubheading: 'Precautions',
    precautionsList: [
      "We're in the elephant corridor — don't wander into the jungle without farm staff.",
      "You may encounter reptiles; leave them undisturbed and inform staff if you're concerned.",
      'It can get hot — wear a hat and carry water on walks and hikes.',
      'If staying overnight, keep your tent/room closed and dark from 6:30–7:30pm, when bugs are drawn to light.',
    ],
    reviewsHeading: 'What visitors say',
    reviewsText: 'Read what past guests have to say about their stay at TVC, or share your own experience.',
    reviewsLink: 'Read reviews on Google →',
    faqHeading: 'FAQ',
    faqs: [
      { q: 'How can I plan my visit?', a: 'Fill in the enquiry form on the relevant page below (or message us on WhatsApp) — we coordinate the stay with our hospitality partner, Linger, from there.' },
      { q: 'Is the place senior friendly?', a: "There's a fair bit of walking — the camp site is a 5-7 minute walk from the parking lot. Fine for active seniors, but not the most accessible place." },
      { q: 'How about food?', a: 'Food is included in the charges. Meals are freshly prepared and mostly vegetarian; non-veg on request. What you get depends on seasonality and availability — no à la carte options.' },
      { q: 'What is the best time to visit?', a: "June to January is best. It's mostly pleasant during these months, though it can feel warm without a breeze." },
      { q: 'What is the wildlife scene?', a: "There are no hard boundaries — rabbits and wild boar are common visitors. Elephants visit in the dry season, drawn by the tamarind and ragi; TVC sits inside the Melagiris' elephant corridor, part of the same connected landscape as the Cauvery North Wildlife Sanctuary, Bannerghatta, and the Nilgiri Biosphere Reserve." },
    ],
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್‌ನಲ್ಲಿ ಒಂದು ದಿನದ ಪ್ರವಾಸಗಳು, ರಾತ್ರಿ ವಾಸ್ತವ್ಯ ಶಿಬಿರಗಳು, ಕಾರ್ಯಾಗಾರಗಳು ಮತ್ತು ಸ್ವಯಂಸೇವೆ — ಏನನ್ನು ನಿರೀಕ್ಷಿಸಬಹುದು, ಚಟುವಟಿಕೆಗಳು, ಮತ್ತು ನಿಮ್ಮ ಭೇಟಿಯನ್ನು ಹೇಗೆ ಯೋಜಿಸುವುದು.',
    heroEyebrow: 'TVC ಗೆ ಭೇಟಿ ನೀಡಿ',
    heroTitle: 'ಬೆಟ್ಟಗಳಲ್ಲಿ ಸಮಯ ಕಳೆಯಲು ಬನ್ನಿ',
    heroIntro: 'ನಾವು ಪಶ್ಚಿಮಾಭಿಮುಖವಾದ ಬೆಟ್ಟದ ಇಳಿಜಾರಿನಲ್ಲಿದ್ದೇವೆ, ಕಣಿವೆಯಾದ್ಯಂತ ಅದ್ಭುತ ಸೂರ್ಯಾಸ್ತದ ದೃಶ್ಯಗಳೊಂದಿಗೆ. ಋತುವನ್ನು ಅವಲಂಬಿಸಿ, ನೀವು ಆಳವಾದ ಹಸಿರು ಎಲೆಗಳಿಂದ ಚಿನ್ನದ ಕಂದು ಬಣ್ಣದ ಬೆಟ್ಟದವರೆಗೆ ಎಲ್ಲವನ್ನೂ ನೋಡುತ್ತೀರಿ.',
    whatToExpectHeading: 'ಏನನ್ನು ನಿರೀಕ್ಷಿಸಬಹುದು',
    whatToExpectText: `ಭೂಮಿಯನ್ನು <a href="${getRelativeLocaleUrl(lang, '/about/design')}">ಮೂರು ವಲಯಗಳಲ್ಲಿ</a> ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ — ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್, ಆಹಾರ ಅರಣ್ಯ, ಮತ್ತು ಕೃಷಿ ಭೂಮಿ — ಕಳೆದ ಹಲವು ವರ್ಷಗಳಿಂದ ನೈಸರ್ಗಿಕವಾಗಿ ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿದೆ. ಚಿಕ್ಕಮ್ಮ-ದೊಡ್ಡಮ್ಮ ದೇವಸ್ಥಾನದವರೆಗೆ ಹೈಕ್ ಮಾಡಿ, ನಿಮಗೆ ಇಡೀ ಕಣಿವೆಯ ಪನೋರಮಿಕ್ ನೋಟ ಸಿಗುತ್ತದೆ. ಬೆಳಿಗ್ಗೆ ಮತ್ತು ಸಂಜೆ ಪಕ್ಷಿಗಳ ಕಲರವದೊಂದಿಗೆ ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸಲಾಗುತ್ತದೆ — ಮತ್ತು ದಸರಾ ನಂತರ ಭೇಟಿ ನೀಡುತ್ತಿದ್ದರೆ, ಬೆಳಗಿನ ವಾಕ್‌ಗಳಲ್ಲಿ ಇಬ್ಬನಿಯಿಂದ ನಿಮ್ಮ ಪ್ಯಾಂಟ್ ಒದ್ದೆಯಾಗುವ ನಿರೀಕ್ಷೆ ಇಡಿ.`,
    foodHeading: 'ಆಹಾರ',
    foodText: 'ಆಹಾರವನ್ನು ಸಾಧ್ಯವಾದಷ್ಟು ಸ್ಥಳೀಯವಾಗಿರಿಸಿಕೊಳ್ಳುತ್ತೇವೆ, ನಮ್ಮ ಅಡುಗೆಮನೆಯನ್ನು ನಡೆಸುವ ಸ್ಥಳೀಯ ಸಮುದಾಯದ ಪಾಕವಿಧಾನಗಳಿಂದ ಬೇಯಿಸಲಾಗುತ್ತದೆ — ರಾಗಿ ಮುದ್ದೆ, ಫಾರ್ಮ್‌ನಲ್ಲಿ ಕೊಯ್ಲು ಮಾಡಿದ ಹುಣಸೆಹಣ್ಣಿನೊಂದಿಗೆ ಘಮಘಮಿಸುವ ರಸಂ ಮತ್ತು ಸಾಂಬಾರ್, ಋತುವಿನಲ್ಲಿರುವ ಸೊಪ್ಪು, ಮತ್ತು ಆನೆಗಳು ಮತ್ತು ಕೋತಿಗಳು ನಮಗೆ ಬಿಟ್ಟಿರುವುದನ್ನು ಅವಲಂಬಿಸಿ ಋತುಮಾನದ ಹಣ್ಣುಗಳು.',
    facilitiesHeading: 'ಸೌಲಭ್ಯಗಳು',
    facilitiesText1: 'ಮಲಬಾರ್ ಗುಡಿಸಲಿನಾದ್ಯಂತ (ಎರಡು ಟೆಂಟ್‌ಗಳು, ಪ್ರತಿಯೊಂದೂ 3 ವಯಸ್ಕರು ಅಥವಾ 2 ವಯಸ್ಕರು + 2 ಮಕ್ಕಳ ಕುಟುಂಬಕ್ಕೆ ಸೂಕ್ತ, ಜೊತೆಗೆ ದೊಡ್ಡ ಸಾಮಾನ್ಯ ಸ್ಥಳ) ಮತ್ತು ಆಲದ ಗುಡಿಸಲಿನಲ್ಲಿ (ಒಂದು ಟೆಂಟ್ + ಡೆಕ್) ಟೆಂಟ್ ವಸತಿ, ಜೊತೆಗೆ ಎರಡು ಬಿದಿರಿನ ಗುಡಿಸಲುಗಳು (ತಲಾ 2 ವಯಸ್ಕರು) ಮತ್ತು ಹೆಚ್ಚು ಸಾಹಸಮಯ ಕ್ಯಾಂಪಿಂಗ್ ಅನುಭವಕ್ಕಾಗಿ ಡೋಮ್ ಟೆಂಟ್‌ಗಳು — ಎಲ್ಲವೂ ಹವಾಮಾನ ನಿರೋಧಕ, ವರ್ಷಪೂರ್ತಿ ಬಳಸಬಹುದಾದ, ಹಾಸಿಗೆಗಳು ಮತ್ತು ಹಾಳೆಗಳೊಂದಿಗೆ ಜೋಡಿಸಲಾಗಿದೆ. ಅಡುಗೆಮನೆಯ ಪಕ್ಕದಲ್ಲಿ ಕುಳಿತು, ಮಾತನಾಡಲು ಮತ್ತು ಕೃಷಿಯ ಬಗ್ಗೆ ಕಲಿಯಲು ಊಟದ ಗುಡಿಸಲು ಇದೆ — ಮತ್ತು ಹೌದು, BSNL ಮೂಲಕ ವೈಫೈ ಇದೆ, ಅದರ ವಿಶ್ವಾಸಾರ್ಹತೆಯ ಬಗ್ಗೆ ನಿಮಗೆ ಬೇಕಾದ ಎಲ್ಲವನ್ನೂ ಅದು ಹೇಳಬೇಕು.',
    facilitiesText2: 'ಸಾಮಾನ್ಯ ಶೌಚಾಲಯಗಳಲ್ಲಿ ವೆಸ್ಟರ್ನ್ ಕಮೋಡ್, ಒಂದು ಮುಚ್ಚಿದ ಶವರ್ ಮತ್ತು ಒಂದು ತೆರೆದ ಶವರ್ (ಶವರ್‌ಗಳಲ್ಲಿ ಬಿಸಿನೀರಿಲ್ಲ, ಆದರೆ ವಿನಂತಿಯ ಮೇರೆಗೆ ಅಡುಗೆಮನೆ ಸ್ವಲ್ಪ ಬಿಸಿ ಮಾಡಬಹುದು), ಮತ್ತು ಕನಿಷ್ಠ ಬೆಳಕು — ಗ್ರಿಡ್ ಶಕ್ತಿ, ಸೌರ ಬ್ಯಾಕಪ್ ಮತ್ತು ಅಪರೂಪದ ಕೆಟ್ಟ ದಿನಕ್ಕೆ ಜನರೇಟರ್ ಇದೆ. ನಿಮ್ಮ ಫೋನ್ ಸಾಕಾಗದಿದ್ದರೆ ಟಾರ್ಚ್ ಕೇಳಿ.',
    activitiesHeading: 'ಚಟುವಟಿಕೆಗಳು',
    activities: [
      { name: 'ಫಾರ್ಮ್ ಪ್ರವಾಸ', desc: 'ಅಡುಗೆ ತೋಟ, ಜಲ ಕಾಮಗಾರಿಗಳು, ಆಹಾರ ಅರಣ್ಯ, ಮತ್ತು ದಾರಿಯುದ್ದಕ್ಕೂ ಇರುವ ಮರಗಳು ಮತ್ತು ಪಕ್ಷಿಗಳ ಮೂಲಕ ~2 ಗಂಟೆಗಳ ನಡಿಗೆ.' },
      { name: 'ಪಕ್ಷಿ ವೀಕ್ಷಣೆ', desc: 'ಇಲ್ಲಿ 100ಕ್ಕೂ ಹೆಚ್ಚು ಪ್ರಭೇದಗಳು ಕಂಡುಬಂದಿವೆ — ಅವುಗಳನ್ನು ಗುರುತಿಸಲು ಮತ್ತು ಗುರುತಿಸಲು ಮುಂಜಾನೆ ಉತ್ತಮ.' },
      { name: 'ಬುಟ್ಟಿ ನೇಯ್ಗೆ', desc: 'ನಮ್ಮ ಪರಿಣತ ಬುಟ್ಟಿ ನೇಯ್ಗಾರ ರಾಮ್‌ದಾಸ್ ನಿಮಗೆ ಬಿದಿರಿನ ಕರಕುಶಲತೆಯನ್ನು ಕಲಿಸಬಲ್ಲರು — ಇದನ್ನು ಸಿದ್ಧಪಡಿಸಲು ಮುಂಚಿತವಾಗಿ ಸೂಚನೆ ಬೇಕು.' },
      { name: 'ನಕ್ಷತ್ರ ವೀಕ್ಷಣೆ', desc: `ಕಣಿವೆಯಲ್ಲಿ ಕೇವಲ ${NIGHT_SKY_BRIGHTNESS_UCD_M2} μcd/m² ಕೃತಕ ಪ್ರಕಾಶಮಾನತೆ ಇದೆ — ಸ್ಪಷ್ಟ ರಾತ್ರಿಯಲ್ಲಿ (ಇಲ್ಲಿ ಹೆಚ್ಚಿನ ರಾತ್ರಿಗಳಂತೆ), ನಕ್ಷತ್ರಗಳು ಮತ್ತು ಗ್ಯಾಲಕ್ಸಿಗಳು ಪ್ರಕಾಶಮಾನವಾಗಿ ಮತ್ತು ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುತ್ತವೆ.` },
      { name: 'ಚಾಪ್ & ಡ್ರಾಪ್', desc: 'ನಮ್ಮ ಪರ್ಮಾಕಲ್ಚರ್ ವ್ಯವಸ್ಥೆಯ ಅವಿಭಾಜ್ಯ ಭಾಗ — ನೀವು ಸಹಾಯ ಮಾಡಲು ಬಯಸಿದರೆ ಸಂತೋಷದಿಂದ ಮಚ್ಚು ಕೊಡುತ್ತೇವೆ.' },
      { name: 'ಬೋರ್ಡ್ ಗೇಮ್ಸ್', desc: 'ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನು ಉಳಿಸಲು ಬಯಸಿದಾಗ ಕುಟುಂಬ ಮತ್ತು ಸ್ನೇಹಿತರೊಂದಿಗೆ ಸಮಯ ಕಳೆಯಲು ಒಂದು ವಿಶ್ರಾಂತ ಮಾರ್ಗ.' },
      { name: 'ಕ್ಯಾಂಪ್‌ಫೈರ್', desc: 'ಹವಾಮಾನ ಅನುಮತಿಸಿದರೆ, ನಾವು ಕ್ಯಾಂಪ್‌ಫೈರ್ ಹಚ್ಚಿ ಸಣ್ಣ ಸಸ್ಯಾಹಾರಿ ಬಾರ್ಬೆಕ್ಯೂ ಸಿದ್ಧಪಡಿಸಬಹುದು.' },
    ],
    trekLinkText: 'ಜೊತೆಗೆ ಪಕ್ಕದ ಅರಣ್ಯಕ್ಕೆ <a href="{href}">ಮೂರು ಮಾರ್ಗಗಳಲ್ಲಿ ಚಾರಣ</a>.',
    chooseHeading: 'ನೀವು ಹೇಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ',
    options: [
      { title: 'ಒಂದು ದಿನದ ಭೇಟಿ', desc: 'ಫಾರ್ಮ್‌ನಲ್ಲಿ ಪಿಕ್‌ನಿಕ್, ಒಂದು ಚಾರಣ ಸಾಹಸ, ಅಥವಾ ಏನೂ ಮಾಡದ ದಿನ — ಗಂಟೆ-ಗಂಟೆಗೆ ಪ್ರಯಾಣ ಯೋಜನೆಗಳು.', href: '/visit/day-visit' },
      { title: 'ರಾತ್ರಿ ವಾಸ್ತವ್ಯ ಶಿಬಿರ', desc: 'ಸೂರ್ಯಾಸ್ತದ ವೀಕ್ಷಣಾ ಸ್ಥಳಕ್ಕೆ ಚಾರಣ, ಕ್ಯಾಂಪ್‌ಫೈರ್, ಮತ್ತು ಮಾರ್ಗದರ್ಶಿತ ಫಾರ್ಮ್ ಪ್ರವಾಸದೊಂದಿಗೆ ಎರಡು ದಿನಗಳ ವಾಸ್ತವ್ಯ.', href: '/visit/camping' },
      { title: 'TVC ಯಲ್ಲಿ ಕಾರ್ಯಕ್ರಮಗಳು', desc: 'ತಂಡದ ಪ್ರವಾಸಗಳು, ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಬಿದಿರಿನ ಕರಕುಶಲತೆಯ ಕಾರ್ಯಾಗಾರಗಳು, ಪ್ರಕೃತಿ ಶಿಬಿರಗಳು, ಟೆಕ್ ಕ್ಯಾಂಪ್‌ಗಳು — 20 ಜನರವರೆಗೆ, ಕ್ಯಾಂಪಿಂಗ್ ಸೇರಿದಂತೆ.', href: '/visit/host-an-event' },
      { title: 'ಸ್ವಯಂಸೇವೆ', desc: 'ಮಾಡುವ ಮೂಲಕ ಕಲಿಯಿರಿ — ದೈನಂದಿನ ಫಾರ್ಮ್ ಚಟುವಟಿಕೆಗಳಿಗೆ (ಕತ್ತರಿಸುವುದು, ನೆಡುವುದು, ಅಗೆಯುವುದು, ಬಿತ್ತನೆ, ಕೊಯ್ಲು) ಕೊಡುಗೆ ನೀಡಿ. ವಾಸ್ತವ್ಯ ಅತಿಥಿ ಗೃಹದಲ್ಲಿ, ಮೂಲಭೂತ ಆಹಾರ ಮತ್ತು ವಾಸ್ತವ್ಯಕ್ಕೆ ಶುಲ್ಕ ವಿಧಿಸಲಾಗುತ್ತದೆ.', href: '/contact' },
