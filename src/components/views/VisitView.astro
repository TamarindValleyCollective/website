  ta: {
    metaDescription: 'டமரிண்ட் வேலி கலெக்டிவில் ஒரு நாள் பயணங்கள், இரவு தங்கும் முகாம்கள், பட்டறைகள் மற்றும் தன்னார்வத் தொண்டு — என்ன எதிர்பார்க்கலாம், செயல்பாடுகள், மற்றும் உங்கள் வருகையை எப்படி திட்டமிடுவது.',
    heroEyebrow: 'TVC-ஐ பார்வையிடுங்கள்',
    heroTitle: 'மலைகளில் நேரம் செலவிட வாருங்கள்',
    heroIntro: 'நாங்கள் மேற்கு நோக்கிய மலைச்சரிவில் இருக்கிறோம், பள்ளத்தாக்கு முழுவதும் அற்புதமான சூரிய அஸ்தமன காட்சிகளுடன். பருவத்தைப் பொறுத்து, ஆழமான பச்சை இலைகளிலிருந்து தங்க பழுப்பு நிற மலைவரை நீங்கள் அனைத்தையும் காண்பீர்கள்.',
    whatToExpectHeading: 'என்ன எதிர்பார்க்கலாம்',
    whatToExpectText: `நிலம் <a href="${getRelativeLocaleUrl(lang, '/about/design')}">மூன்று மண்டலங்களாக</a> வடிவமைக்கப்பட்டுள்ளது — வனவிலங்கு தாழ்வாரம், உணவு காடு, மற்றும் பயிரிடப்பட்ட நிலம் — கடந்த பல ஆண்டுகளாக இயற்கையாக மீட்டெடுக்கப்பட்டு வருகிறது. சிக்கம்மா-தொட்டம்மா கோவிலுக்கு ஏறிச் சென்றால், முழு பள்ளத்தாக்கின் பரந்த காட்சி கிடைக்கும். காலையிலும் மாலையிலும் பறவைகளின் இசையால் நீங்கள் வரவேற்கப்படுவீர்கள் — தசராவுக்குப் பிறகு வருகை தருகிறீர்கள் என்றால், காலை நடைப்பயிற்சிகளில் பனித்துளிகள் உங்கள் காலணிகளை ஈரமாக்கும் என்று எதிர்பார்க்கவும்.`,
    foodHeading: 'உணவு',
    foodText: 'உணவை முடிந்தவரை உள்ளூரானதாக வைத்திருக்கிறோம், எங்கள் சமையலறையை நடத்தும் உள்ளூர் சமூகத்தின் செய்முறைகளைப் பயன்படுத்தி சமைக்கப்படுகிறது — ராகி முத்தே, பண்ணையில் அறுவடை செய்யப்பட்ட புளியுடன் காரமான ரசம் மற்றும் சாம்பார், பருவத்தில் கிடைக்கும் கீரைகளிலிருந்து சொப்பு, மற்றும் யானைகளும் குரங்குகளும் எங்களுக்கு விட்டுச் சென்றதைப் பொறுத்து பருவகால பழங்கள்.',
    facilitiesHeading: 'வசதிகள்',
    facilitiesText1: 'மலபார் குடிசை முழுவதும் (இரண்டு கூடாரங்கள், ஒவ்வொன்றும் 3 பெரியவர்கள் அல்லது 2 பெரியவர்கள் + 2 குழந்தைகள் கொண்ட குடும்பத்திற்கு ஏற்றது, மேலும் ஒரு பெரிய பொது இடம்) மற்றும் ஆலமரம் குடிசை (ஒரு கூடாரம் + தளம்) கூடார தங்குமிடம், மேலும் இரண்டு மூங்கில் குடிசைகள் (தலா 2 பெரியவர்கள்) மற்றும் மிகவும் சாகச முகாமிடும் அனுபவத்திற்கு டோம் கூடாரங்கள் — அனைத்தும் வானிலை தாங்கும், ஆண்டு முழுவதும் பயன்படுத்தக்கூடியவை, மெத்தைகள் மற்றும் விரிப்புகளுடன் அமைக்கப்பட்டவை. சமையலறைக்கு அடுத்து அமர்ந்து, பேசி, விவசாயத்தைப் பற்றி அறிய ஒரு மதிய உண்டி குடிசை உள்ளது — ஆம், BSNL மூலம் WiFi உள்ளது, அதன் நம்பகத்தன்மையைப் பற்றி உங்களுக்குத் தெரிய வேண்டியதை அது சொல்லும்.',
    facilitiesText2: 'பொது கழிவறைகளில் மேற்கத்திய கழிப்பறைகள், ஒரு மூடிய குளியலறை மற்றும் ஒரு திறந்த குளியலறை (குளியலறைகளில் சூடான நீர் இல்லை, ஆனால் கேட்டால் சமையலறை சிறிது சூடாக்கும்), மற்றும் குறைந்தபட்ச விளக்குகள் — கட்டமைப்பு மின்சாரம், சூரிய காப்பு, மற்றும் அரிதான மோசமான நாளுக்கு ஜெனரேட்டர். உங்கள் தொலைபேசி போதவில்லை என்றால் ஒரு டார்ச் கேளுங்கள்.',
