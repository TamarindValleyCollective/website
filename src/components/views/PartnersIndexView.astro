---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const partners = await getCollection('partners');
const rendered = await Promise.all(partners.map((p) => render(p)));

// The expanded profile (this page's whole reason to exist) is English-only
// across all locales - see TRANSLATIONS_REVIEW.md's "Known gaps". Title and
// excerpt keep their existing kn/ta fields for the /people teaser card.
function partnerTitle(p: (typeof partners)[number]) {
  if (lang === 'kn') return p.data.title_kn || p.data.title;
  if (lang === 'ta') return p.data.title_ta || p.data.title;
  return p.data.title;
}

const content = {
  en: {
    metaDescription: "TVC's partners and collaborators — the organizations who've supported us, from conservation to permaculture design to hospitality.",
    heroEyebrow: 'People',
    heroTitle: 'Partners & collaborators',
    heroIntro: "Beyond TVC's own community, a handful of organizations have supported us along the way — from hospitality to permaculture design.",
    visitLink: 'Visit their site →',
    backLink: '← Back to People',
  },
  kn: {
    metaDescription: 'TVC ಯ ಪಾಲುದಾರರು ಮತ್ತು ಸಹಯೋಗಿಗಳು — ಸಂರಕ್ಷಣೆಯಿಂದ ಪರ್ಮಾಕಲ್ಚರ್ ವಿನ್ಯಾಸದಿಂದ ಆತಿಥ್ಯದವರೆಗೆ ನಮಗೆ ಬೆಂಬಲ ನೀಡಿದ ಸಂಸ್ಥೆಗಳು.',
    heroEyebrow: 'ಜನರು',
    heroTitle: 'ಪಾಲುದಾರರು ಮತ್ತು ಸಹಯೋಗಿಗಳು',
    heroIntro: 'TVC ಯ ಸ್ವಂತ ಸಮುದಾಯದ ಆಚೆಗೂ, ಕೆಲವು ಸಂಸ್ಥೆಗಳು ಆತಿಥ್ಯದಿಂದ ಪರ್ಮಾಕಲ್ಚರ್ ವಿನ್ಯಾಸದವರೆಗೆ ನಮಗೆ ಬೆಂಬಲ ನೀಡಿವೆ.',
    visitLink: 'ಅವರ ಸೈಟ್ ನೋಡಿ →',
    backLink: '← ಜನರಿಗೆ ಹಿಂತಿರುಗಿ',
  },
  ta: {
    metaDescription: 'TVC-யின் கூட்டாளர்கள் மற்றும் ஒத்துழைப்பாளர்கள் — பாதுகாப்பிலிருந்து இயற்கை வேளாண்மை வடிவமைப்பு மற்றும் விருந்தோம்பல் வரை எங்களுக்கு ஆதரவளித்த அமைப்புகள்.',
    heroEyebrow: 'மக்கள்',
    heroTitle: 'கூட்டாளர்கள் மற்றும் ஒத்துழைப்பாளர்கள்',
    heroIntro: 'TVC-யின் சொந்த சமூகத்திற்கு அப்பால், சில அமைப்புகள் விருந்தோம்பலில் இருந்து இயற்கை வேளாண்மை வடிவமைப்பு வரை எங்களுக்கு ஆதரவளித்துள்ளன.',
    visitLink: 'அவர்களின் தளத்தைப் பார்வையிடவும் →',
    backLink: '← மக்களுக்குத் திரும்பு',
  },
} as const;

const c = content[lang];
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/partners/biome-solutions.png" imageWidth={768} imageHeight={576}>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} />
  <section class="section wrapper">
    <div class="partners">
      {partners.map((p, i) => {
        const { Content } = rendered[i];
        return (
          <article class="partner">
            {p.data.coverImage && <img src={p.data.coverImage} alt={partnerTitle(p)} loading="lazy" />}
            <div class="partner__body">
              <h2>{partnerTitle(p)}</h2>
              <div class="prose">
                <Content />
              </div>
              <a class="button button--outline" href={p.data.url} target="_blank" rel="noopener noreferrer">{c.visitLink}</a>
            </div>
          </article>
        );
      })}
    </div>
    <p class="back-line"><a href={getRelativeLocaleUrl(lang, '/people')}>{c.backLink}</a></p>
  </section>
</BaseLayout>

<style>
  .partners {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 20px;
  }

  .partner {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    align-items: start;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 24px;
  }

  .partner img {
    width: 100%;
    max-width: 160px;
    object-fit: contain;
    justify-self: center;
  }

  .partner__body h2 {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 12px;
  }

  .prose :global(p:last-child) {
    margin-bottom: 16px;
  }

  .back-line {
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .partner {
      grid-template-columns: 1fr;
    }

    .partner img {
      max-width: 120px;
    }
  }
</style>
