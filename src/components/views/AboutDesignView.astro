---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Prose content for this page only - shared chrome comes from src/i18n/*.ts
// via BaseLayout/Nav/Footer.
const content = {
  en: {
    metaDescription: "How TVC's land is laid out — the wildlife corridor, food forests, cultivated zones, and water works — plus a drone flyover.",
    heroEyebrow: 'About TVC',
    heroTitle: 'The Design',
    intro1: "The land's regeneration follows permaculture and regenerative design principles: a wildlife corridor higher on the hill closer to the forest is left to grow by itself, food forests combine supporting plants with fruit-bearing trees, and the rest is actively cultivated. The last several years have been dedicated to land rejuvenation, letting vegetation grow in whatever form it takes.",
    intro2: "The land's layout — the housing clusters, the food forest zones, the water works — is mapped out below.",
    mapTitle: 'TVC land plans and design map',
    aerialHeading: 'Aerial view',
    aerialText: 'A drone flight over the property, showing the food forest and the surrounding hills from above.',
    videoTitle: 'TVC Aerial View',
  },
  kn: {
    metaDescription: 'TVC ಯ ಭೂಮಿಯನ್ನು ಹೇಗೆ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ — ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್, ಆಹಾರ ಅರಣ್ಯಗಳು, ಕೃಷಿ ವಲಯಗಳು ಮತ್ತು ಜಲ ಕಾಮಗಾರಿಗಳು — ಜೊತೆಗೆ ಡ್ರೋನ್ ಹಾರಾಟ.',
    heroEyebrow: 'TVC ಬಗ್ಗೆ',
    heroTitle: 'ವಿನ್ಯಾಸ',
    intro1: 'ಭೂಮಿಯ ಪುನರುಜ್ಜೀವನವು ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಪುನರುತ್ಪಾದಕ ವಿನ್ಯಾಸ ತತ್ವಗಳನ್ನು ಅನುಸರಿಸುತ್ತದೆ: ಅರಣ್ಯಕ್ಕೆ ಹತ್ತಿರವಾದ ಬೆಟ್ಟದ ಮೇಲ್ಭಾಗದ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್ ಅನ್ನು ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಬೆಳೆಯಲು ಬಿಡಲಾಗಿದೆ, ಆಹಾರ ಅರಣ್ಯಗಳು ಪೋಷಕ ಸಸ್ಯಗಳನ್ನು ಹಣ್ಣಿನ ಮರಗಳೊಂದಿಗೆ ಸಂಯೋಜಿಸುತ್ತವೆ, ಮತ್ತು ಉಳಿದ ಭಾಗವನ್ನು ಸಕ್ರಿಯವಾಗಿ ಬೇಸಾಯ ಮಾಡಲಾಗುತ್ತದೆ. ಕಳೆದ ಹಲವಾರು ವರ್ಷಗಳು ಭೂ ಪುನಶ್ಚೇತನಕ್ಕೆ ಮೀಸಲಾಗಿದ್ದು, ಸಸ್ಯವರ್ಗವು ಯಾವುದೇ ರೂಪದಲ್ಲಿ ಬೆಳೆಯಲಿ ಎಂದು ಬಿಡಲಾಗಿದೆ.',
    intro2: 'ಭೂಮಿಯ ವಿನ್ಯಾಸ — ವಸತಿ ಸಮೂಹಗಳು, ಆಹಾರ ಅರಣ್ಯ ವಲಯಗಳು, ಜಲ ಕಾಮಗಾರಿಗಳು — ಕೆಳಗೆ ನಕ್ಷೆ ಮಾಡಲಾಗಿದೆ.',
    mapTitle: 'TVC ಭೂಮಿ ಯೋಜನೆಗಳು ಮತ್ತು ವಿನ್ಯಾಸ ನಕ್ಷೆ',
    aerialHeading: 'ವೈಮಾನಿಕ ನೋಟ',
    aerialText: 'ಆಸ್ತಿಯ ಮೇಲಿನ ಡ್ರೋನ್ ಹಾರಾಟ, ಆಹಾರ ಅರಣ್ಯ ಮತ್ತು ಸುತ್ತಮುತ್ತಲಿನ ಬೆಟ್ಟಗಳನ್ನು ಮೇಲಿನಿಂದ ತೋರಿಸುತ್ತದೆ.',
    videoTitle: 'TVC ವೈಮಾನಿಕ ನೋಟ',
  },
  ta: {
    metaDescription: 'TVC-யின் நிலம் எப்படி வடிவமைக்கப்பட்டுள்ளது — வனவிலங்கு தாழ்வாரம், உணவு காடுகள், பயிரிடப்பட்ட மண்டலங்கள் மற்றும் நீர் பணிகள் — மேலும் ஒரு ட்ரோன் பறப்பு.',
    heroEyebrow: 'TVC பற்றி',
    heroTitle: 'வடிவமைப்பு',
    intro1: 'நிலத்தின் மீட்டெடுப்பு இயற்கை வேளாண்மை மற்றும் மீட்டெடுப்பு வடிவமைப்பு கொள்கைகளைப் பின்பற்றுகிறது: காட்டிற்கு அருகில் மலையின் மேற்பகுதியில் உள்ள வனவிலங்கு தாழ்வாரம் தானாகவே வளர விடப்படுகிறது, உணவு காடுகள் ஆதரவு தாவரங்களை பழம் தரும் மரங்களுடன் இணைக்கின்றன, மீதமுள்ளவை தீவிரமாக பயிரிடப்படுகின்றன. கடந்த சில ஆண்டுகள் நில புத்துயிர்ப்பிற்காக அர்ப்பணிக்கப்பட்டுள்ளன, தாவரங்கள் எந்த வடிவத்திலும் வளர அனுமதிக்கப்படுகின்றன.',
    intro2: 'நிலத்தின் அமைப்பு — வீட்டு தொகுப்புகள், உணவு காடு மண்டலங்கள், நீர் பணிகள் — கீழே வரைபடமாக்கப்பட்டுள்ளது.',
    mapTitle: 'TVC நில திட்டங்கள் மற்றும் வடிவமைப்பு வரைபடம்',
    aerialHeading: 'வான்வழி காட்சி',
    aerialText: 'சொத்தின் மீதான ட்ரோன் பறப்பு, உணவு காடு மற்றும் சுற்றியுள்ள மலைகளை மேலிருந்து காட்டுகிறது.',
    videoTitle: 'TVC வான்வழி காட்சி',
  },
} as const;

const c = content[lang];
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/pages/home/hero.jpg" imageWidth={4204} imageHeight={1330}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    image="/images/pages/home/hero.jpg"
    imageAlt="Aerial view of the land's layout, with housing clusters and zones labeled"
  />

  <section class="section wrapper">
    <p>{c.intro1}</p>
    <p>{c.intro2}</p>
    <div class="map-embed">
      <iframe
        loading="lazy"
        src="https://www.google.com/maps/d/u/0/embed?mid=1b_d-2ZOwDBRTJjbDZ2ovJ7QsdPiqnYrA"
        width="640"
        height="480"
        style="border:0"
        title={c.mapTitle}
      ></iframe>
    </div>

    <h3>{c.aerialHeading}</h3>
    <p>{c.aerialText}</p>
    <div class="video-embed">
      <iframe
        loading="lazy"
        src="https://www.youtube.com/embed/ixHNXOiQ9vM"
        title={c.videoTitle}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .map-embed iframe {
    width: 100%;
    max-width: 640px;
    border-radius: var(--radius);
  }

  .video-embed {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
