---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const content = {
  en: {
    metaTitle: 'Geography',
    metaDescription: "TVC's physical setting in the Melagiri Hills, and its place in a wider wildlife corridor.",
    heroEyebrow: 'The TVC Ecosystem',
    heroTitle: 'Geography',
    heroIntro: "The land's physical setting — where TVC sits, and its place in a wider wildlife corridor.",
    heroImageAlt: 'Looking out over the valley from the hills above TVC',
    introText: "TVC sits on a west-facing hillslope on the Tamil Nadu–Karnataka border, with sunset views across the valley. It's part of the Melagiri Hills, the range where the Eastern and Western Ghats meet — a geographic seam that makes the range biodiversity-rich and, for wildlife moving between habitats, a through-route rather than a dead end.",
    corridorHeading: 'Where this sits in the wider corridor',
    corridorText: "The Melagiris alone cover roughly 1,295 km² of forest. TVC sits inside a live elephant corridor connecting Bannerghatta National Park to the Cauvery — one link in a wider chain also tying in MM Hills, BR Hills, Sathyamangalam, and the Nilgiri Biosphere Reserve, together one of South India's larger contiguous elephant landscapes. More on what that means for the land and its wildlife on",
    corridorCaption: 'Marker positions are each protected area’s approximate reference point, shown here for scale and relative position — not a traced boundary.',
    rangeHeading: 'How far elephants range',
    rangeText1: 'Radio-telemetry studies elsewhere in this same corridor — collared female clans and bulls in the Nilgiri Biosphere Reserve — found average home ranges of around 677 km² for female clans (550–700 km²) and 293 km² for lone bulls (211–375 km²), shifting with rainfall and food availability. Dry-season ranges stay tight around perennial water; monsoon and post-monsoon ranges (roughly July–February) expand as temporary water opens up and crops ripen — the same window in which elephants are most likely to move through a corridor like this one toward farmland.',
    rangeText2: 'Villages and farms within 1.5–2 km of a forest edge see the most of that movement, elsewhere in the corridor — one reason keeping it unbroken, rather than fragmented by farms and roads, matters for reducing conflict.',
  },
  kn: {
    metaTitle: 'ಭೂಗೋಳ',
    metaDescription: 'TVC ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳಲ್ಲಿ ಎಲ್ಲಿದೆ, ಮತ್ತು ವಿಶಾಲ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್‌ನಲ್ಲಿ ಅದರ ಸ್ಥಾನ.',
    heroEyebrow: 'TVC ಪರಿಸರ ವ್ಯವಸ್ಥೆ',
    heroTitle: 'ಭೂಗೋಳ',
    heroIntro: 'ಭೂಮಿಯ ಭೌತಿಕ ಸ್ವರೂಪ — TVC ಎಲ್ಲಿ ನೆಲೆಗೊಂಡಿದೆ, ಮತ್ತು ವಿಶಾಲ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್‌ನಲ್ಲಿ ಅದರ ಸ್ಥಾನ.',
    heroImageAlt: 'TVC ಯ ಮೇಲಿನ ಬೆಟ್ಟಗಳಿಂದ ಕಣಿವೆಯ ನೋಟ',
    introText: 'TVC ತಮಿಳುನಾಡು–ಕರ್ನಾಟಕ ಗಡಿಯಲ್ಲಿ, ಕಣಿವೆಯಾದ್ಯಂತ ಸೂರ್ಯಾಸ್ತದ ನೋಟಗಳೊಂದಿಗೆ ಪಶ್ಚಿಮಾಭಿಮುಖ ಗುಡ್ಡದ ಇಳಿಜಾರಿನಲ್ಲಿದೆ. ಇದು ಪೂರ್ವ ಮತ್ತು ಪಶ್ಚಿಮ ಘಟ್ಟಗಳು ಸಂಧಿಸುವ ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ಶ್ರೇಣಿಯ ಭಾಗ — ಈ ಭೌಗೋಳಿಕ ಸಂಧಿಯು ಶ್ರೇಣಿಯನ್ನು ಜೀವವೈವಿಧ್ಯ-ಸಮೃದ್ಧವಾಗಿಸುತ್ತದೆ ಮತ್ತು ಆವಾಸಸ್ಥಾನಗಳ ನಡುವೆ ಚಲಿಸುವ ವನ್ಯಜೀವಿಗಳಿಗೆ ಇದು ಕೊನೆಗೊಳ್ಳುವ ಸ್ಥಳಕ್ಕಿಂತ ಹಾದುಹೋಗುವ ಮಾರ್ಗವಾಗಿದೆ.',
    corridorHeading: 'ವಿಶಾಲ ಕಾರಿಡಾರ್‌ನಲ್ಲಿ ಇದು ಎಲ್ಲಿ ಸೇರಿಕೊಳ್ಳುತ್ತದೆ',
    corridorText: 'ಮೇಲಗಿರಿ ಶ್ರೇಣಿ ಒಂದೇ ಸುಮಾರು 1,295 ಚದರ ಕಿ.ಮೀ ಅರಣ್ಯವನ್ನು ಹೊಂದಿದೆ. TVC ಬನ್ನೇರುಘಟ್ಟ ರಾಷ್ಟ್ರೀಯ ಉದ್ಯಾನವನ್ನು ಕಾವೇರಿಗೆ ಸಂಪರ್ಕಿಸುವ ಜೀವಂತ ಆನೆ ಕಾರಿಡಾರ್‌ನ ಒಳಗಿದೆ — MM ಬೆಟ್ಟಗಳು, BR ಬೆಟ್ಟಗಳು, ಸತ್ಯಮಂಗಲಂ ಮತ್ತು ನೀಲಗಿರಿ ಜೀವಗೋಳ ಮೀಸಲು ಪ್ರದೇಶವನ್ನೂ ಜೋಡಿಸುವ ವಿಶಾಲ ಸರಪಳಿಯ ಒಂದು ಕೊಂಡಿ, ಒಟ್ಟಾಗಿ ದಕ್ಷಿಣ ಭಾರತದ ಅತಿದೊಡ್ಡ ನಿರಂತರ ಆನೆ ಭೂಪ್ರದೇಶಗಳಲ್ಲಿ ಒಂದಾಗಿದೆ. ಭೂಮಿ ಮತ್ತು ಅದರ ವನ್ಯಜೀವಿಗಳಿಗೆ ಇದರ ಅರ್ಥವೇನೆಂದು ಹೆಚ್ಚಿನದನ್ನು',
    corridorCaption: 'ಗುರುತು ಸ್ಥಾನಗಳು ಪ್ರತಿ ಸಂರಕ್ಷಿತ ಪ್ರದೇಶದ ಅಂದಾಜು ಉಲ್ಲೇಖ ಬಿಂದುಗಳಾಗಿವೆ, ಪ್ರಮಾಣ ಮತ್ತು ಸಾಪೇಕ್ಷ ಸ್ಥಾನಕ್ಕಾಗಿ ಇಲ್ಲಿ ತೋರಿಸಲಾಗಿದೆ — ಇದು ಗುರುತಿಸಲಾದ ಗಡಿಯಲ್ಲ.',
    rangeHeading: 'ಆನೆಗಳು ಎಷ್ಟು ದೂರ ಸಂಚರಿಸುತ್ತವೆ',
    rangeText1: 'ಇದೇ ಕಾರಿಡಾರ್‌ನ ಇತರೆಡೆ ನಡೆಸಿದ ರೇಡಿಯೊ-ಟೆಲಿಮೆಟ್ರಿ ಅಧ್ಯಯನಗಳು — ನೀಲಗಿರಿ ಜೀವಗೋಳ ಮೀಸಲು ಪ್ರದೇಶದಲ್ಲಿ ಕಾಲರ್ ಅಳವಡಿಸಿದ ಹೆಣ್ಣಾನೆ ಗುಂಪುಗಳು ಮತ್ತು ಗಂಡಾನೆಗಳ ಮೇಲೆ — ಸರಾಸರಿ ಸುಮಾರು 677 ಚದರ ಕಿ.ಮೀ (550–700 ಚದರ ಕಿ.ಮೀ) ಹೆಣ್ಣಾನೆ ಗುಂಪುಗಳ ಸಂಚಾರ ವ್ಯಾಪ್ತಿ ಮತ್ತು 293 ಚದರ ಕಿ.ಮೀ (211–375 ಚದರ ಕಿ.ಮೀ) ಒಂಟಿ ಗಂಡಾನೆಗಳ ವ್ಯಾಪ್ತಿಯನ್ನು ಕಂಡುಕೊಂಡಿವೆ, ಇದು ಮಳೆ ಮತ್ತು ಆಹಾರ ಲಭ್ಯತೆಗೆ ಅನುಗುಣವಾಗಿ ಬದಲಾಗುತ್ತದೆ. ಬೇಸಿಗೆಯಲ್ಲಿ ಸಂಚಾರ ವ್ಯಾಪ್ತಿ ದೀರ್ಘಕಾಲಿಕ ನೀರಿನ ಮೂಲಗಳ ಸುತ್ತ ಸೀಮಿತವಾಗಿರುತ್ತದೆ; ಮುಂಗಾರು ಮತ್ತು ಮುಂಗಾರಿನ ನಂತರದ ಅವಧಿಯಲ್ಲಿ (ಸುಮಾರು ಜುಲೈ–ಫೆಬ್ರವರಿ) ತಾತ್ಕಾಲಿಕ ನೀರಿನ ಮೂಲಗಳು ತೆರೆದುಕೊಂಡು ಬೆಳೆಗಳು ಫಸಲಿಗೆ ಬರುತ್ತಿದ್ದಂತೆ ವ್ಯಾಪ್ತಿ ವಿಸ್ತಾರಗೊಳ್ಳುತ್ತದೆ — ಇದೇ ಅವಧಿಯಲ್ಲಿ ಆನೆಗಳು ಇಂತಹ ಕಾರಿಡಾರ್‌ಗಳ ಮೂಲಕ ಕೃಷಿ ಭೂಮಿಯತ್ತ ಚಲಿಸುವ ಸಾಧ್ಯತೆ ಹೆಚ್ಚು.',
    rangeText2: 'ಕಾರಿಡಾರ್‌ನ ಇತರೆಡೆ, ಅರಣ್ಯದ ಅಂಚಿನಿಂದ 1.5–2 ಕಿ.ಮೀ ಒಳಗಿರುವ ಹಳ್ಳಿಗಳು ಮತ್ತು ಜಮೀನುಗಳು ಈ ಚಲನೆಯನ್ನು ಹೆಚ್ಚು ಎದುರಿಸುತ್ತವೆ — ಕಾರಿಡಾರ್ ಅನ್ನು ಜಮೀನುಗಳು ಮತ್ತು ರಸ್ತೆಗಳಿಂದ ಛಿದ್ರಗೊಳಿಸದೆ ಅಖಂಡವಾಗಿಡುವುದು ಸಂಘರ್ಷ ತಗ್ಗಿಸಲು ಮುಖ್ಯವಾಗಿರುವುದಕ್ಕೆ ಇದೂ ಒಂದು ಕಾರಣ.',
  },
  ta: {
    metaTitle: 'புவியியல்',
    metaDescription: 'TVC மேலகிரி மலைகளில் எங்கே அமைந்துள்ளது, மற்றும் பரந்த வனவிலங்கு தாழ்வாரத்தில் அதன் இடம்.',
    heroEyebrow: 'TVC சூழலமைப்பு',
    heroTitle: 'புவியியல்',
    heroIntro: 'நிலத்தின் இயற்பியல் அமைப்பு — TVC எங்கே அமைந்துள்ளது, மற்றும் பரந்த வனவிலங்கு தாழ்வாரத்தில் அதன் இடம்.',
    heroImageAlt: 'TVC-யின் மேலுள்ள மலைகளிலிருந்து பள்ளத்தாக்கின் காட்சி',
    introText: 'TVC தமிழ்நாடு–கர்நாடக எல்லையில், பள்ளத்தாக்கு முழுவதும் சூரிய அஸ்தமன காட்சிகளுடன் மேற்கு நோக்கிய மலைச்சரிவில் அமைந்துள்ளது. இது கிழக்கு மற்றும் மேற்கு தொடர்ச்சி மலைகள் சந்திக்கும் மேலகிரி மலைத்தொடரின் ஒரு பகுதி — இந்த புவியியல் சந்திப்பு தொடரை பல்லுயிர் செழிப்பானதாக ஆக்குகிறது, மேலும் வாழ்விடங்களுக்கு இடையே நகரும் வனவிலங்குகளுக்கு இது ஒரு முடிவிடமாக இல்லாமல் ஒரு கடந்து செல்லும் பாதையாக உள்ளது.',
    corridorHeading: 'இது பரந்த தாழ்வாரத்தில் எங்கே அமைந்துள்ளது',
    corridorText: 'மேலகிரி மலைத்தொடர் மட்டும் சுமார் 1,295 சதுர கி.மீ காடுகளைக் கொண்டுள்ளது. TVC பன்னேர்காட்டா தேசிய பூங்காவை காவேரியுடன் இணைக்கும் ஒரு வாழும் யானை தாழ்வாரத்திற்குள் அமைந்துள்ளது — MM மலைகள், BR மலைகள், சத்தியமங்கலம் மற்றும் நீலகிரி உயிர்க்கோள இருப்பையும் இணைக்கும் ஒரு பரந்த சங்கிலியின் ஒரு இணைப்பு, இவை அனைத்தும் இணைந்து தென்னிந்தியாவின் மிகப்பெரிய தொடர்ச்சியான யானை வாழிடங்களில் ஒன்றாக உள்ளது. நிலத்திற்கும் அதன் வனவிலங்குகளுக்கும் இதன் பொருள் என்ன என்பது பற்றி மேலும்',
    corridorCaption: 'குறி இடங்கள் ஒவ்வொரு பாதுகாக்கப்பட்ட பகுதியின் தோராயமான குறிப்புப் புள்ளிகள் ஆகும், அளவு மற்றும் சார்பு நிலைக்காக இங்கே காட்டப்பட்டுள்ளன — இது ஒரு வரையப்பட்ட எல்லை அல்ல.',
    rangeHeading: 'யானைகள் எவ்வளவு தூரம் நகர்கின்றன',
    rangeText1: 'இதே தாழ்வாரத்தில் வேறு இடங்களில் நடத்தப்பட்ட ரேடியோ-டெலிமெட்ரி ஆய்வுகள் — நீலகிரி உயிர்க்கோள இருப்பில் காலர் பொருத்தப்பட்ட பெண் யானைக் கூட்டங்கள் மற்றும் தனி ஆண் யானைகள் மீது — சராசரியாக பெண் யானைக் கூட்டங்களுக்கு சுமார் 677 சதுர கி.மீ (550–700 சதுர கி.மீ) மற்றும் தனி ஆண் யானைகளுக்கு 293 சதுர கி.மீ (211–375 சதுர கி.மீ) சுற்றுலா வீச்சைக் கண்டறிந்துள்ளன, இது மழை மற்றும் உணவு கிடைப்பதற்கு ஏற்ப மாறுபடுகிறது. வறட்சி காலத்தில் சுற்றுலா வீச்சு நிரந்தர நீர் ஆதாரங்களைச் சுற்றி குறுகியதாக இருக்கும்; பருவமழை மற்றும் பருவமழைக்குப் பின்னரான காலத்தில் (சுமார் ஜூலை–பிப்ரவரி) தற்காலிக நீர் ஆதாரங்கள் திறந்துவிடவும், பயிர்கள் விளையவும் செய்யும் போது வீச்சு விரிவடைகிறது — இதே காலகட்டத்தில் யானைகள் இது போன்ற தாழ்வாரங்கள் வழியாக விவசாய நிலங்களை நோக்கி நகரும் வாய்ப்பு அதிகம்.',
    rangeText2: 'தாழ்வாரத்தில் வேறு இடங்களில், காடு ஓரத்திலிருந்து 1.5–2 கி.மீ தொலைவில் உள்ள கிராமங்களும் விவசாய நிலங்களும் இந்த நகர்வை அதிகம் எதிர்கொள்கின்றன — தாழ்வாரத்தை பண்ணைகள் மற்றும் சாலைகளால் துண்டாடாமல் தொடர்ச்சியாக வைத்திருப்பது மோதலைக் குறைப்பதற்கு முக்கியமானதற்கான ஒரு காரணம் இதுவும்.',
  },
} as const;

const c = content[lang];
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDescription} image="/images/pages/home/gallery-2.jpg" imageWidth={768} imageHeight={329}>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} image="/images/pages/home/gallery-2.jpg" imageAlt={c.heroImageAlt} />

  <section class="section wrapper">
    <p>{c.introText}</p>

    <h2>{c.corridorHeading}</h2>
    <p>{c.corridorText} <a href={getRelativeLocaleUrl(lang, '/about')}>{t('nav.about')}</a>.</p>
    <div class="corridor-map-wrap">
      <div id="corridor-map" data-lang={lang}></div>
    </div>
    <p class="map-caption">{c.corridorCaption}</p>

    <h2>{c.rangeHeading}</h2>
    <p>{c.rangeText1}</p>
    <p>{c.rangeText2}</p>
  </section>
</BaseLayout>

<style>
  .corridor-map-wrap {
    margin: 16px auto 6px;
    max-width: 720px;
  }

  #corridor-map {
    height: 340px;
    width: 100%;
    border-radius: var(--radius);
    z-index: 0;
  }

  .map-caption {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
