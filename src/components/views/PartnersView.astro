---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getCollection, render } from 'astro:content';
import { type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const partners = await getCollection('partners');
// Each partner's markdown body is English-only (see content.config.ts) -
// rendered as-is on every locale for now, same as the rest of this page's
// AI-drafted-pending-review kn/ta chrome around it.
const partnersWithContent = await Promise.all(
  partners.map(async (p) => {
    const { Content } = await render(p);
    return { entry: p, Content };
  })
);

function partnerTitle(p: (typeof partners)[number]) {
  if (lang === 'kn') return p.data.title_kn || p.data.title;
  if (lang === 'ta') return p.data.title_ta || p.data.title;
  return p.data.title;
}

// May contain simple inline HTML (e.g. Linger's link to TVC's own listing)
// - rendered with set:html below, same as AboutView's inline prose links.
function tvcConnection(p: (typeof partners)[number]) {
  if (lang === 'kn') return p.data.tvcConnection_kn || p.data.tvcConnection;
  if (lang === 'ta') return p.data.tvcConnection_ta || p.data.tvcConnection;
  return p.data.tvcConnection;
}

// Page-specific prose only - shared chrome comes from src/i18n/*.ts via
// t() in the components this page uses (BaseLayout, Nav, Footer).
const content = {
  en: {
    metaDescription: "TVC's partners — conservation, land design, architecture, foraging, hospitality, and the real estate partner who helped found TVC.",
    heroEyebrow: 'People',
    heroTitle: 'Partners',
    heroIntro: "Beyond TVC's own community, a handful of organizations have supported us along the way — from hospitality to permaculture design.",
    tvcLabel: 'With TVC',
    visitLink: 'Visit site ↗',
  },
  kn: {
    metaDescription: 'TVC ಯ ಪಾಲುದಾರರು — ಸಂರಕ್ಷಣೆ, ಭೂ ವಿನ್ಯಾಸ, ವಾಸ್ತುಶಿಲ್ಪ, ಫೊರೇಜಿಂಗ್, ಆತಿಥ್ಯ, ಮತ್ತು TVC ಸ್ಥಾಪನೆಗೆ ಸಹಾಯ ಮಾಡಿದ ರಿಯಲ್ ಎಸ್ಟೇಟ್ ಪಾಲುದಾರ.',
    heroEyebrow: 'ಜನರು',
    heroTitle: 'ಪಾಲುದಾರರು',
    heroIntro: 'TVC ಯ ಸ್ವಂತ ಸಮುದಾಯದ ಆಚೆಗೂ, ಕೆಲವು ಸಂಸ್ಥೆಗಳು ಆತಿಥ್ಯದಿಂದ ಪರ್ಮಾಕಲ್ಚರ್ ವಿನ್ಯಾಸದವರೆಗೆ ನಮಗೆ ಬೆಂಬಲ ನೀಡಿವೆ.',
    tvcLabel: 'TVC ಜೊತೆ',
    visitLink: 'ಸೈಟ್‌ಗೆ ಭೇಟಿ ↗',
  },
  ta: {
    metaDescription: 'TVC-யின் கூட்டாளர்கள் — பாதுகாப்பு, நில வடிவமைப்பு, கட்டிடக்கலை, ஃபோரேஜிங், விருந்தோம்பல், மற்றும் TVC நிறுவப்பட உதவிய ரியல் எஸ்டேட் கூட்டாளர்.',
    heroEyebrow: 'மக்கள்',
    heroTitle: 'கூட்டாளர்கள்',
    heroIntro: 'TVC-யின் சொந்த சமூகத்திற்கு அப்பால், சில அமைப்புகள் விருந்தோம்பலில் இருந்து இயற்கை வேளாண்மை வடிவமைப்பு வரை எங்களுக்கு ஆதரவளித்துள்ளன.',
    tvcLabel: 'TVC உடன்',
    visitLink: 'தளத்தைப் பார்க்க ↗',
  },
} as const;

const c = content[lang];
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/members/reva-and-ranjan.jpg" imageWidth={768} imageHeight={576}>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} />

  <section class="section wrapper">
    <div class="partners-list">
      {partnersWithContent.map(({ entry: p, Content }) => (
        <article class="partner">
          <div class="partner__head">
            {p.data.coverImage && <img src={p.data.coverImage} alt={partnerTitle(p)} class="partner__logo" loading="lazy" />}
            <div class="partner__heading">
              <h2>{partnerTitle(p)}</h2>
              <a class="partner__sitelink" href={p.data.url} target="_blank" rel="noopener noreferrer">{c.visitLink}</a>
            </div>
          </div>
          <div class="prose">
            <Content />
          </div>
          <p class="partner__tvc"><span class="partner__tvc-label">{c.tvcLabel}</span> <span set:html={tvcConnection(p)} /></p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .partners-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .partner {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--tvc-line);
  }

  .partner:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .partner__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .partner__logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    padding: 6px;
    background: #fff;
    flex-shrink: 0;
  }

  .partner__heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .partner__heading h2 {
    margin: 0;
  }

  .partner__sitelink {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tvc-green-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  .partner__sitelink:hover {
    text-decoration: underline;
  }

  .prose :global(p) {
    margin: 0 0 10px;
    color: var(--tvc-ink-soft);
  }

  /* The one fact readers actually scan for on a partner listing - kept
     visually distinct from the general-description prose above instead of
     buried as its last sentence (see content.config.ts's tvcConnection
     comment). */
  .partner__tvc {
    margin: 10px 0 0;
    padding: 10px 14px;
    background: var(--tvc-green-tint);
    border-radius: var(--radius);
    font-size: 0.92rem;
  }

  .partner__tvc-label {
    font-weight: 700;
    color: var(--tvc-green-dark);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    margin-right: 4px;
  }

  .partner__tvc :global(a) {
    color: var(--tvc-green-dark);
  }
</style>
