---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  post: CollectionEntry<'communityOutreach'>;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

const content = {
  en: { eyebrow: 'People', outreachTitle: 'Community Outreach' },
  kn: { eyebrow: 'ಜನರು', outreachTitle: 'ಸಮುದಾಯ ಸಂಪರ್ಕ' },
  ta: { eyebrow: 'மக்கள்', outreachTitle: 'சமூக தொடர்பு' },
} as const;

const c = content[lang];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  datePublished: post.data.date.toISOString().slice(0, 10),
  description: post.data.excerpt,
  image: post.data.coverImage ? new URL(post.data.coverImage, Astro.site).toString() : undefined,
  author: { '@type': 'Organization', name: 'Tamarind Valley Collective' },
  publisher: {
    '@type': 'Organization',
    name: 'Tamarind Valley Collective',
    logo: { '@type': 'ImageObject', url: new URL('/images/brand/tvc-logo-mark.png', Astro.site).toString() },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('common.home'), item: new URL(getRelativeLocaleUrl(lang, '/'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: c.outreachTitle, item: new URL(getRelativeLocaleUrl(lang, '/people/community-outreach'), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: post.data.title },
  ],
};
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.excerpt} image={post.data.coverImage} schema={[articleSchema, breadcrumbSchema]}>
  <PageHero eyebrow={c.eyebrow} title={post.data.title} image={post.data.coverImage} imageAlt={post.data.title} />
  <article class="section wrapper prose">
    <Content />
  </article>
</BaseLayout>

<style>
  .prose :global(img) {
    border-radius: var(--radius);
    margin: 16px 0;
  }
</style>
