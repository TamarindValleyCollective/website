---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const content = {
  en: {
    title: 'Thanks',
    metaDescription: "We've received your inquiry.",
    heroEyebrow: 'Visit TVC',
    heroTitle: "We've got your inquiry",
    bodyText: "Thanks for reaching out — we'll get back to you shortly with availability and any details you asked about. If it's urgent, message us on WhatsApp and we'll reply faster.",
    backLink: '← Back to Visit',
  },
  kn: {
    title: 'ಧನ್ಯವಾದಗಳು',
    metaDescription: 'ನಿಮ್ಮ ವಿಚಾರಣೆಯನ್ನು ನಾವು ಸ್ವೀಕರಿಸಿದ್ದೇವೆ.',
    heroEyebrow: 'TVC ಗೆ ಭೇಟಿ ನೀಡಿ',
    heroTitle: 'ನಿಮ್ಮ ವಿಚಾರಣೆ ನಮಗೆ ತಲುಪಿದೆ',
    bodyText: 'ಸಂಪರ್ಕಿಸಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು — ಲಭ್ಯತೆ ಮತ್ತು ನೀವು ಕೇಳಿದ ಯಾವುದೇ ವಿವರಗಳೊಂದಿಗೆ ನಾವು ಶೀಘ್ರದಲ್ಲೇ ನಿಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸುತ್ತೇವೆ. ಇದು ತುರ್ತಾಗಿದ್ದರೆ, WhatsApp ನಲ್ಲಿ ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ, ನಾವು ವೇಗವಾಗಿ ಪ್ರತ್ಯುತ್ತರ ನೀಡುತ್ತೇವೆ.',
    backLink: '← ಭೇಟಿಗೆ ಹಿಂತಿರುಗಿ',
  },
  ta: {
    title: 'நன்றி',
    metaDescription: 'உங்கள் விசாரணையை நாங்கள் பெற்றுள்ளோம்.',
    heroEyebrow: 'TVC-ஐ பார்வையிடுங்கள்',
    heroTitle: 'உங்கள் விசாரணை எங்களுக்குக் கிடைத்துவிட்டது',
    bodyText: 'தொடர்பு கொண்டதற்கு நன்றி — கிடைக்கும் தன்மை மற்றும் நீங்கள் கேட்ட எந்த விவரங்களுடனும் விரைவில் உங்களைத் தொடர்பு கொள்வோம். அவசரமாக இருந்தால், WhatsApp-இல் எங்களுக்கு செய்தி அனுப்புங்கள், நாங்கள் வேகமாக பதிலளிப்போம்.',
    backLink: '← வருகைக்குத் திரும்பு',
  },
} as const;

const c = content[lang];
---

<BaseLayout lang={lang} title={c.title} description={c.metaDescription} image="/images/pages/home/gallery-4.jpg" imageWidth={1280} imageHeight={960} noindex>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} image="/images/pages/home/gallery-4.jpg" imageAlt="Sunset over the Melagiri Hills" />

  <section class="section wrapper">
    <p>{c.bodyText}</p>
    <p><a href={getRelativeLocaleUrl(lang, '/visit')}>{c.backLink}</a></p>
  </section>
</BaseLayout>
