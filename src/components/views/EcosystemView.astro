---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { organizationId } from '../../utils/schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Prose content for this page only - shared chrome (nav labels etc.) comes
// from src/i18n/*.ts via t() above. This page is the Ecosystem hub: an
// overview of the land as one connected system, plus cards into its three
// leaves (Biodiversity, Geography, Weather) - mirroring how VisitView's
// "choose how you visit" section fronts its own children.
const content = {
  en: {
    metaDescription: "How TVC's 98 acres work as one ecosystem — a wildlife corridor, food forest, and farmland regenerating together — with live biodiversity sightings, geography, and weather.",
    heroTitle: 'Corridor, Food Forest, Farm',
    heroIntro: "TVC's land is laid out in three zones — a wildlife corridor left to grow on its own, a food forest of fruit trees and support species, and actively cultivated land — regenerating together since 2017 through permaculture and reforestation. Explore what that regeneration looks like below: the species it now supports, the terrain and corridor it sits within, and the weather that drives it all.",
    heroImageAlt: 'Sunflowers in a cultivated field with the Melagiri Hills behind',
    overviewHeading: 'Three zones, one system',
    overviewText: "The wildlife corridor sits highest on the hill, closest to the reserve forest, and is left alone to regrow. Below it, food forest zones interplant fruit-bearing trees with the support species that feed and shade them. The rest is actively farmed. All three have been regenerating together since 2017 — not managed as separate projects, but as one connected system, each part shaping what the others can support.",
    cardsHeading: 'Explore the ecosystem',
    cards: [
      { title: 'Biodiversity', desc: 'Live sightings from iNaturalist — over 100 bird species, and everything else that’s been spotted here.', href: '/ecosystem/biodiversity' },
      { title: 'Geography', desc: 'Where TVC sits in the Melagiri Hills, and its place in a wider wildlife corridor connecting Bannerghatta to the Nilgiris.', href: '/ecosystem/landscape' },
      { title: 'Weather', desc: 'Live conditions at TVC, and the rainfall and monsoon patterns that shape the seasons.', href: '/ecosystem/weather' },
    ],
  },
  kn: {
    metaDescription: 'TVC ಯ 98 ಎಕರೆಗಳು ಒಂದೇ ಪರಿಸರ ವ್ಯವಸ್ಥೆಯಾಗಿ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ — ಒಟ್ಟಿಗೆ ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿರುವ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್, ಆಹಾರ ಅರಣ್ಯ ಮತ್ತು ಕೃಷಿ ಭೂಮಿ — ನೇರ ಜೀವವೈವಿಧ್ಯ ಪ್ರೇಕ್ಷಣೆಗಳು, ಭೂಗೋಳ ಮತ್ತು ಹವಾಮಾನದೊಂದಿಗೆ.',
    heroTitle: 'ಕಾರಿಡಾರ್, ಆಹಾರ ಅರಣ್ಯ, ಫಾರ್ಮ್',
    heroIntro: 'TVC ಯ ಭೂಮಿಯನ್ನು ಮೂರು ವಲಯಗಳಲ್ಲಿ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ — ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಬೆಳೆಯಲು ಬಿಟ್ಟಿರುವ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್, ಹಣ್ಣಿನ ಮರಗಳು ಮತ್ತು ಪೋಷಕ ಸಸ್ಯಗಳ ಆಹಾರ ಅರಣ್ಯ, ಮತ್ತು ಸಕ್ರಿಯವಾಗಿ ಬೇಸಾಯ ಮಾಡುವ ಭೂಮಿ — 2017ರಿಂದ ಪರ್ಮಾಕಲ್ಚರ್ ಮತ್ತು ಮರು ಅರಣ್ಯೀಕರಣದ ಮೂಲಕ ಒಟ್ಟಿಗೆ ಪುನರುಜ್ಜೀವನಗೊಳ್ಳುತ್ತಿವೆ. ಆ ಪುನರುಜ್ಜೀವನ ಹೇಗೆ ಕಾಣುತ್ತದೆ ಎಂಬುದನ್ನು ಕೆಳಗೆ ಅನ್ವೇಷಿಸಿ — ಅದು ಈಗ ಬೆಂಬಲಿಸುವ ಪ್ರಭೇದಗಳು, ಅದು ಇರುವ ಭೂಪ್ರದೇಶ ಮತ್ತು ಕಾರಿಡಾರ್, ಮತ್ತು ಎಲ್ಲವನ್ನೂ ಮುನ್ನಡೆಸುವ ಹವಾಮಾನ.',
    heroImageAlt: 'ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಕೃಷಿ ಭೂಮಿಯಲ್ಲಿ ಸೂರ್ಯಕಾಂತಿ ಹೂವುಗಳು',
    overviewHeading: 'ಮೂರು ವಲಯಗಳು, ಒಂದು ವ್ಯವಸ್ಥೆ',
    overviewText: 'ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್ ಬೆಟ್ಟದ ಮೇಲ್ಭಾಗದಲ್ಲಿ, ಮೀಸಲು ಅರಣ್ಯಕ್ಕೆ ಹತ್ತಿರದಲ್ಲಿದೆ, ಮತ್ತು ಅದನ್ನು ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಮರುಬೆಳೆಯಲು ಬಿಡಲಾಗಿದೆ. ಅದರ ಕೆಳಗೆ, ಆಹಾರ ಅರಣ್ಯ ವಲಯಗಳು ಹಣ್ಣಿನ ಮರಗಳನ್ನು ಅವುಗಳಿಗೆ ಆಹಾರ ಮತ್ತು ನೆರಳು ನೀಡುವ ಪೋಷಕ ಪ್ರಭೇದಗಳೊಂದಿಗೆ ಬೆರೆಸುತ್ತವೆ. ಉಳಿದ ಭಾಗವನ್ನು ಸಕ್ರಿಯವಾಗಿ ಬೇಸಾಯ ಮಾಡಲಾಗುತ್ತದೆ. ಮೂರೂ 2017ರಿಂದ ಒಟ್ಟಿಗೆ ಪುನಶ್ಚೇತನಗೊಳ್ಳುತ್ತಿವೆ — ಪ್ರತ್ಯೇಕ ಯೋಜನೆಗಳಾಗಿ ಅಲ್ಲ, ಬದಲಿಗೆ ಒಂದು ಸಂಪರ್ಕಿತ ವ್ಯವಸ್ಥೆಯಾಗಿ, ಪ್ರತಿ ಭಾಗವೂ ಇತರರು ಏನನ್ನು ಬೆಂಬಲಿಸಬಹುದು ಎಂಬುದನ್ನು ರೂಪಿಸುತ್ತದೆ.',
    cardsHeading: 'ಪರಿಸರ ವ್ಯವಸ್ಥೆಯನ್ನು ಅನ್ವೇಷಿಸಿ',
    cards: [
      { title: 'ಜೀವವೈವಿಧ್ಯ', desc: 'iNaturalist ನಿಂದ ನೇರ ಪ್ರೇಕ್ಷಣೆಗಳು — 100ಕ್ಕೂ ಹೆಚ್ಚು ಪಕ್ಷಿ ಪ್ರಭೇದಗಳು, ಮತ್ತು ಇಲ್ಲಿ ಕಂಡುಬಂದ ಎಲ್ಲವೂ.', href: '/ecosystem/biodiversity' },
      { title: 'ಭೂಗೋಳ', desc: 'ಮೇಲಗಿರಿ ಬೆಟ್ಟಗಳಲ್ಲಿ TVC ಎಲ್ಲಿದೆ, ಮತ್ತು ಬನ್ನೇರುಘಟ್ಟವನ್ನು ನೀಲಗಿರಿಗಳಿಗೆ ಸಂಪರ್ಕಿಸುವ ವಿಶಾಲ ವನ್ಯಜೀವಿ ಕಾರಿಡಾರ್‌ನಲ್ಲಿ ಅದರ ಸ್ಥಾನ.', href: '/ecosystem/landscape' },
      { title: 'ಹವಾಮಾನ', desc: 'TVC ಯಲ್ಲಿ ನೇರ ಪರಿಸ್ಥಿತಿಗಳು, ಮತ್ತು ಋತುಗಳನ್ನು ರೂಪಿಸುವ ಮಳೆ ಮತ್ತು ಮಾನ್ಸೂನ್ ಮಾದರಿಗಳು.', href: '/ecosystem/weather' },
    ],
  },
  ta: {
    metaDescription: 'TVC-யின் 98 ஏக்கர்கள் ஒரே சூழலமைப்பாக எப்படி செயல்படுகின்றன — ஒன்றாக மீட்டெடுக்கப்படும் வனவிலங்கு தாழ்வாரம், உணவு காடு மற்றும் பண்ணை நிலம் — நேரடி பல்லுயிர் காட்சிகள், புவியியல் மற்றும் வானிலையுடன்.',
    heroTitle: 'தாழ்வாரம், உணவு காடு, பண்ணை',
    heroIntro: 'TVC-யின் நிலம் மூன்று மண்டலங்களாக வடிவமைக்கப்பட்டுள்ளது — தானாகவே வளர விடப்பட்ட வனவிலங்கு தாழ்வாரம், பழம் தரும் மரங்கள் மற்றும் ஆதரவு தாவரங்களின் உணவு காடு, மற்றும் தீவிரமாக பயிரிடப்படும் நிலம் — 2017 முதல் இயற்கை வேளாண்மை மற்றும் மறு காடாக்கம் மூலம் ஒன்றாக மீட்டெடுக்கப்பட்டு வருகின்றன. அந்த மீட்டெடுப்பு எப்படி இருக்கிறது என்பதை கீழே ஆராயுங்கள் — அது இப்போது ஆதரிக்கும் இனங்கள், அது அமைந்துள்ள நிலப்பரப்பு மற்றும் தாழ்வாரம், மற்றும் அனைத்தையும் இயக்கும் வானிலை.',
    heroImageAlt: 'மேலகிரி மலைகளின் பின்னணியில் பயிரிடப்பட்ட வயலில் சூரியகாந்தி பூக்கள்',
    overviewHeading: 'மூன்று மண்டலங்கள், ஒரு அமைப்பு',
    overviewText: 'வனவிலங்கு தாழ்வாரம் மலையின் மேற்பகுதியில், காப்பு காட்டிற்கு அருகில் அமைந்துள்ளது, மேலும் அது தானாகவே மீண்டும் வளர விடப்பட்டுள்ளது. அதற்குக் கீழே, உணவு காடு மண்டலங்கள் பழம் தரும் மரங்களை அவற்றுக்கு உணவும் நிழலும் தரும் ஆதரவு இனங்களுடன் இணைக்கின்றன. மீதமுள்ளவை தீவிரமாக பயிரிடப்படுகின்றன. மூன்றும் 2017 முதல் ஒன்றாக புத்துயிர் பெற்று வருகின்றன — தனித்தனி திட்டங்களாக அல்ல, மாறாக ஒரு இணைந்த அமைப்பாக, ஒவ்வொரு பகுதியும் மற்றவை என்ன ஆதரிக்க முடியும் என்பதை வடிவமைக்கிறது.',
    cardsHeading: 'சூழலமைப்பை ஆராயுங்கள்',
    cards: [
      { title: 'பல்லுயிர் பெருக்கம்', desc: 'iNaturalist இலிருந்து நேரடி காட்சிகள் — 100க்கும் மேற்பட்ட பறவை இனங்கள், மற்றும் இங்கு காணப்பட்ட அனைத்தும்.', href: '/ecosystem/biodiversity' },
      { title: 'புவியியல்', desc: 'மேலகிரி மலைகளில் TVC எங்கே அமைந்துள்ளது, மற்றும் பன்னேர்காட்டாவை நீலகிரிகளுடன் இணைக்கும் பரந்த வனவிலங்கு தாழ்வாரத்தில் அதன் இடம்.', href: '/ecosystem/landscape' },
      { title: 'வானிலை', desc: 'TVC-யில் நேரடி நிலைமைகள், மற்றும் பருவங்களை வடிவமைக்கும் மழை மற்றும் பருவமழை முறைகள்.', href: '/ecosystem/weather' },
    ],
  },
} as const;

const c = content[lang];

// This hub's 3 cards are its whole structure - a CollectionPage listing
// them as `hasPart` mirrors that 1:1, same real hrefs the cards below link
// to, rather than restating any of Biodiversity/Landscape/Weather's own
// facts here.
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.heroTitle,
  description: c.metaDescription,
  about: { '@id': organizationId(Astro.site) },
  hasPart: c.cards.map((card) => ({
    '@type': 'WebPage',
    name: card.title,
    description: card.desc,
    url: new URL(getRelativeLocaleUrl(lang, card.href), Astro.site).toString(),
  })),
};
---

<BaseLayout lang={lang} title={t('nav.ecosystem')} description={c.metaDescription} schema={[collectionSchema]} image="/images/pages/while-at-farm/hero.jpg" imageWidth={1280} imageHeight={960}>
  <PageHero eyebrow={t('nav.ecosystem')} title={c.heroTitle} intro={c.heroIntro} image="/images/pages/while-at-farm/hero.jpg" imageAlt={c.heroImageAlt} />

  <section class="section wrapper">
    <h2>{c.overviewHeading}</h2>
    <p>{c.overviewText}</p>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>{c.cardsHeading}</h2>
      <div class="ecosystem-cards">
        {c.cards.map((card) => (
          <a class="card ecosystem-card" href={getRelativeLocaleUrl(lang, card.href)}>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ecosystem-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(230px, 1fr));
    gap: 18px;
    margin-top: 16px;
  }

  @media (max-width: 780px) {
    .ecosystem-cards {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }
  }

  .ecosystem-card {
    display: block;
    text-decoration: none;
  }

  .ecosystem-card h3 {
    margin-bottom: 8px;
  }

  .ecosystem-card p {
    color: var(--tvc-ink-soft);
    margin: 0;
  }
</style>
