// A card normally has one photo, but when separate family members each
// submit their own for the same shared card, `photos` holds all of them;
// this is what every photo-rendering spot below actually reads from, with
// the single legacy `photo` field as the fallback for the ~53 cards that
// only ever had one.
function photosFor(m: Member): string[] {
  if (m.photos && m.photos.length) return m.photos;
  return m.photo ? [m.photo] : [];
}

function initials(name: string) {
  const parts = name.split('&').map((p) => p.trim()).filter(Boolean);
  if (parts.length > 1) {
    return parts.map((p) => p.split(/\s+/)[0][0]).join('').toUpperCase();
  }
  const words = parts[0].split(/\s+/);
  return (words[0][0] + (words[1]?.[0] ?? '')).toUpperCase();
}

// Renders as the platform's icon rather than spelling out "LinkedIn" /
// "Instagram", detected from the URL's host - the form field accepts any
// social profile, not just LinkedIn, so this can't be hardcoded.
function socialIcon(url: string): 'linkedin' | 'instagram' | 'twitter' | 'link' {
  let host = '';
  try {
    host = new URL(url).hostname.replace(/^www\./, '').toLowerCase();
  } catch {
    return 'link';
  }
  if (host.includes('linkedin.com')) return 'linkedin';
  if (host.includes('instagram.com')) return 'instagram';
  if (host.includes('twitter.com') || host === 'x.com') return 'twitter';
  return 'link';
}

// Pairs each profile with the corresponding first name when a card lists
// more than one (e.g. a couple's two separate profiles), so the icon alone
// doesn't leave it ambiguous whose it is; a single profile needs no name
// since there's no one else on the card to confuse it with.
function socialLinks(name: string, urls: string[]) {
  const firstNames = name.split('&').map((p) => p.trim().split(/\s+/)[0]);
  return urls.map((url, i) => ({
    url,
    icon: socialIcon(url),
    name: urls.length > 1 ? (firstNames[i] ?? '') : '',
  }));
}

// The card shows only a summary - the popup is where the full bio lives.
// Cuts at the last word boundary before maxLen rather than mid-word, unless
// that would chop off more than half the target length (a bio with no
// early spaces, e.g. one long clause).
function summarize(text: string, maxLen = 90) {
  if (text.length <= maxLen) return text;
  const cut = text.slice(0, maxLen);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > maxLen / 2 ? lastSpace : maxLen)}…`;
}

// Cards only get a "More" trigger (and an entry in the detail-popup data
// below) when there's actually more to show than what's already on the
// card - either the bio itself got truncated, or there's a family/why-TVC/
// social answer that doesn't fit on the card at all. The ~20 members with
// no bio and no extra answers stay exactly as before, same height as every
// other plain card, since a popup would have nothing new to show them.
const detailed = members
  .map((m, i) => ({ i, m, summary: m.bio ? summarize(m.bio) : '' }))
  .filter(({ m, summary }) => summary !== m.bio || m.family || m.whyTVC || (m.social && m.social.length))
  .map(({ i, m }) => ({
    i,
    name: m.name,
    photos: photosFor(m),
    initials: initials(m.name),
    bio: m.bio,
    family: m.family ?? '',
    whyTVC: m.whyTVC ?? '',
    links: m.social ? socialLinks(m.name, m.social) : [],
  }));
const detailedById = new Set(detailed.map((d) => d.i));
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/journey/journey-43.jpg" imageWidth={1400} imageHeight={787}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/journey/journey-43.jpg"
    imageAlt="TVC members at the 2026 city meet-up, hosted by Kiran & Zainab"
  />

  <section class="section wrapper">
    <div class="members-grid">
      {members.map((m, i) => {
        const photos = photosFor(m);
        const photoBlock = photos.length > 1 ? (
          <div class="member-photo-stack">
            {photos.slice(0, 3).map((src) => (
              <img src={src} alt="" class="member-photo member-photo--stacked" loading="lazy" />
            ))}
          </div>
        ) : photos.length === 1 ? (
          <img src={photos[0]} alt={detailedById.has(i) ? '' : m.name} class="member-photo" loading="lazy" />
        ) : (
          <div class="member-photo member-photo--placeholder" aria-hidden="true">{initials(m.name)}</div>
        );

        return detailedById.has(i) ? (
          <button type="button" class="member-card member-card--has-details" data-member-id={i} aria-label={`More about ${m.name}`}>
            {photoBlock}
            <h2>{m.name}</h2>
            {m.bio && <p>{summarize(m.bio)}</p>}
            <span class="member-more" aria-hidden="true">More →</span>
          </button>
        ) : (
          <div class="member-card">
            {photoBlock}
            <h2>{m.name}</h2>
            {m.bio && <p>{m.bio}</p>}
          </div>
        );
      })}
    </div>
  </section>

  <div id="member-overlay" class="member-overlay" hidden>
    <div class="member-panel" role="dialog" aria-modal="true" aria-label="Member details">
      {/* Close button lives outside .member-panel-scroll (below) so it's a
          sibling of the scrolling content, not a descendant - otherwise on
          a long card it scrolls out of view along with everything else and
          there's no way to close the popup except Escape or the backdrop. */}
      <button type="button" id="member-close" class="member-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <div class="member-panel-scroll">
        <img id="member-detail-photo" class="member-photo" alt="" hidden />
        <div id="member-detail-initials" class="member-photo member-photo--placeholder" aria-hidden="true" hidden></div>
        <div id="member-detail-photos" class="member-detail-photos" hidden></div>
        <h2 id="member-detail-name"></h2>
        <p id="member-detail-bio"></p>
        <p id="member-detail-family" class="member-family" hidden></p>
        <p id="member-detail-quote" class="member-quote" hidden></p>
        <div id="member-detail-links" class="member-links"></div>
      </div>
    </div>
  </div>

  <script type="application/json" id="member-detail-data" set:html={JSON.stringify(detailed)} />

  <script>
    interface MemberDetail {
      i: number;
      name: string;
      photos: string[];
      initials: string;
      bio: string;
      family: string;
      whyTVC: string;
      links: { url: string; icon: string; name: string }[];
    }

    // Same rounded-square icon language as Footer.astro's social links -
    // reused rather than reinvented so the two spots agree visually.
    const socialIcons: Record<string, string> = {
      linkedin: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6"/><path d="M7.2 10.2V17M7.2 7.4v.05M11 17v-4.3c0-1.5 1-2.4 2.3-2.4 1.3 0 2.1.9 2.1 2.4V17M11 10.2V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      instagram: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"/><circle cx="16.8" cy="7.2" r="1" fill="currentColor"/></svg>',
      twitter: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6"/><path d="M8 8l8 8M16 8l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      link: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6"/><path d="M10 14.5l4-4M11 9.5l.5-.5a2.6 2.6 0 013.7 3.7l-.5.5M13 14.5l-.5.5a2.6 2.6 0 01-3.7-3.7l.5-.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };

    const iconAriaLabel: Record<string, string> = {
      linkedin: 'LinkedIn',
      instagram: 'Instagram',
      twitter: 'Twitter',
      link: 'Profile link',
    };

    const dataEl = document.getElementById('member-detail-data');
    const details: MemberDetail[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];
    const byId = new Map(details.map((d) => [d.i, d]));

    const overlay = document.getElementById('member-overlay');
    const closeBtn = document.getElementById('member-close');
    const photoEl = document.getElementById('member-detail-photo') as HTMLImageElement | null;
    const initialsEl = document.getElementById('member-detail-initials');
    const photosEl = document.getElementById('member-detail-photos');
    const nameEl = document.getElementById('member-detail-name');
    const bioEl = document.getElementById('member-detail-bio');
    const familyEl = document.getElementById('member-detail-family');
    const quoteEl = document.getElementById('member-detail-quote');
    const linksEl = document.getElementById('member-detail-links');

    function open(detail: MemberDetail) {
      if (!overlay) return;

      if (nameEl) nameEl.textContent = detail.name;
      if (bioEl) bioEl.textContent = detail.bio;

      if (photoEl && initialsEl && photosEl) {
        // Reset all three each time - only one of single photo / initials /
        // stacked photos should show, depending on how many this member has.
        photoEl.hidden = true;
        initialsEl.hidden = true;
        photosEl.hidden = true;
        photosEl.innerHTML = '';

        if (detail.photos.length > 1) {
          photosEl.hidden = false;
          detail.photos.forEach((src) => {
            const img = document.createElement('img');
            img.src = src;
            img.alt = '';
            img.className = 'member-photo-dynamic';
            photosEl.appendChild(img);
          });
        } else if (detail.photos.length === 1) {
          photoEl.src = detail.photos[0];
          photoEl.alt = detail.name;
          photoEl.hidden = false;
        } else {
          initialsEl.textContent = detail.initials;
          initialsEl.hidden = false;
        }
      }

      if (familyEl) {
        familyEl.textContent = detail.family;
        familyEl.hidden = !detail.family;
      }
      if (quoteEl) {
        quoteEl.textContent = detail.whyTVC ? `“${detail.whyTVC}”` : '';
        quoteEl.hidden = !detail.whyTVC;
      }
      if (linksEl) {
        linksEl.innerHTML = '';
        detail.links.forEach((link) => {
          const a = document.createElement('a');
          a.href = link.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'member-social-link';
          const platform = iconAriaLabel[link.icon] ?? iconAriaLabel.link;
          a.setAttribute('aria-label', link.name ? `${link.name}'s ${platform}` : platform);
          a.innerHTML = socialIcons[link.icon] ?? socialIcons.link;
          if (link.name) {
            const span = document.createElement('span');
            span.className = 'member-social-name';
            span.textContent = link.name;
            a.appendChild(span);
          }
          linksEl.appendChild(a);
        });
      }

      overlay.hidden = false;
      closeBtn?.focus();
    }

    function close() {
      if (!overlay) return;
      overlay.hidden = true;
    }

    document.querySelectorAll<HTMLButtonElement>('.member-card--has-details').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.dataset.memberId);
        const detail = byId.get(id);
        if (detail) open(detail);
      });
    });

    closeBtn?.addEventListener('click', close);

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.hidden) close();
    });
  </script>
</BaseLayout>

<style>
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
  }

  .member-card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 16px;
    text-align: center;
  }

  /* Cards with a popup render as a <button> (see the aria-label on it) so
     the whole card is one click/tap target, not just the "More" text -
     reset the default button chrome back to matching the plain div cards. */
  button.member-card {
    appearance: none;
    font: inherit;
    color: inherit;
    width: 100%;
  }

  .member-card--has-details {
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .member-card--has-details:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 20, 10, 0.12);
    border-color: var(--tvc-green-dark);
  }

  .member-card--has-details:focus-visible {
    outline: 2px solid var(--tvc-green-dark);
    outline-offset: 2px;
  }

  .member-card h2 {
    font-size: 0.88rem;
    margin: 0;
  }

  .member-card p {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    margin: 6px 0 0;
  }

  .member-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 10px;
    display: block;
  }

  /* [hidden] normally beats any author display rule via the UA stylesheet,
     but that's specificity-based, not origin-based - .member-photo's own
     `display: block`/`flex` above is an author rule of equal specificity
     and wins by source order, silently leaving a hidden photo/placeholder
     visible (see SiteSearch.astro's .search-overlay[hidden] for the same
     issue). Needs its own explicit override here. */
  .member-photo[hidden] {
    display: none;
  }

  .member-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 700;
    font-size: 1rem;
  }

  /* When separate family members each submit their own photo for one
     card, up to 3 render as a small overlapping cluster instead of
     picking just one. */
  .member-photo-stack {
    display: flex;
    justify-content: center;
    margin: 0 auto 10px;
  }

  .member-photo--stacked {
    width: 56px;
    height: 56px;
    margin: 0;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px var(--tvc-line);
  }

  .member-photo--stacked:not(:first-child) {
    margin-left: -18px;
  }

  .member-more {
    display: block;
    margin: 8px 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .member-card--has-details:hover .member-more {
    text-decoration: underline;
  }

  /* Popup - mirrors the overlay/panel pattern used by SiteSearch.astro
     (fixed overlay, role=dialog panel, Escape/backdrop-click/close-button
     to dismiss) rather than inventing a second modal convention. */
  .member-overlay {
    position: fixed;
    inset: 0;
    background: rgba(34, 41, 31, 0.45);
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .member-overlay[hidden] {
    display: none;
  }

  .member-panel {
    position: relative;
    width: 100%;
    max-width: 420px;
    max-height: 85vh;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(15, 20, 10, 0.3);
    text-align: center;
    overflow: hidden;
  }

  .member-panel-scroll {
    max-height: 85vh;
    overflow-y: auto;
    padding: 32px 24px 24px;
  }

  .member-panel .member-photo {
    width: 96px;
    height: 96px;
    font-size: 1.4rem;
  }

  .member-detail-photos {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 auto 10px;
  }

  /* Same [hidden]-vs-author-display-rule issue as .member-photo above. */
  .member-detail-photos[hidden] {
    display: none;
  }

  .member-panel h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .member-panel p {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 8px 0 0;
  }

  .member-close {
    position: absolute;
    top: 12px;
    right: 12px;
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-soft);
    padding: 8px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
  }

  .member-close:hover {
    color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
  }

  .member-family {
    color: var(--tvc-ink-soft);
  }

  .member-quote {
    font-style: italic;
    color: var(--tvc-ink);
    border-top: 1px solid var(--tvc-line);
    padding-top: 12px;
    margin-top: 12px !important;
  }

  .member-links {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
</style>

<style is:global>
  /* Not scoped: .member-social-link/-name are assigned via className on
     elements built with document.createElement (see the script above),
     which never receive Astro's data-astro-cid attribute - a scoped rule
     here would silently fail to match any of them, same issue documented
     on SiteSearch.astro's overlay markup (also injected at runtime). */
  .member-social-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--tvc-ink-soft);
