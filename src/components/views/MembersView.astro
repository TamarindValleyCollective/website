---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import type { Locale } from '../../i18n/utils';
import { members as membersData, memberSlug, type Member } from '../../data/members';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Cards are sorted here (by first name) rather than in the data file so a
// new entry appended to src/data/members.ts lands in the right spot on the
// page without anyone having to hand-place it in the array.
function firstName(name: string): string {
  return name.split(/[\s&]+/)[0];
}
const members = [...membersData].sort((a, b) => firstName(a.name).localeCompare(firstName(b.name)));

const content = {
  en: {
    metaDescription: 'The 53 member families who make up the Tamarind Valley Collective.',
    heroEyebrow: 'People',
    heroTitle: 'Members',
    heroIntro: 'The 53 families who make up the collective — most joined between the founding in 2017 and today.',
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್ ಅನ್ನು ರೂಪಿಸುವ 53 ಸದಸ್ಯ ಕುಟುಂಬಗಳು.',
    heroEyebrow: 'ಜನರು',
    heroTitle: 'ಸದಸ್ಯರು',
    heroIntro: 'ಈ ಸಂಘಟನೆಯನ್ನು ರೂಪಿಸುವ 53 ಕುಟುಂಬಗಳು — ಹೆಚ್ಚಿನವರು 2017ರ ಸ್ಥಾಪನೆಯಿಂದ ಇಂದಿನವರೆಗೆ ಸೇರಿದವರು.',
  },
  ta: {
    metaDescription: 'டமரிண்ட் வேலி கலெக்டிவை உருவாக்கும் 53 உறுப்பினர் குடும்பங்கள்.',
    heroEyebrow: 'மக்கள்',
    heroTitle: 'உறுப்பினர்கள்',
    heroIntro: 'இந்த கூட்டமைப்பை உருவாக்கும் 53 குடும்பங்கள் — பெரும்பாலோர் 2017 நிறுவனத்திலிருந்து இன்று வரை சேர்ந்தவர்கள்.',
  },
} as const;

const c = content[lang];

// A card normally has one photo, but when separate family members each
// submit their own for the same shared card, `photos` holds all of them;
// this is what every photo-rendering spot below actually reads from, with
// the single legacy `photo` field as the fallback for the ~53 cards that
// only ever had one.
function photosFor(m: Member): string[] {
  if (m.photos && m.photos.length) return m.photos;
  return m.photo ? [m.photo] : [];
}

// Normalizes `whyTVC` to a list so the rest of the code doesn't need to
// special-case the single-quote-vs-per-person-array distinction described
// on the Member interface above.
function whyTVCList(m: Member): string[] {
  if (!m.whyTVC) return [];
  return Array.isArray(m.whyTVC) ? m.whyTVC : [m.whyTVC];
}

function initials(name: string) {
  const parts = name.split('&').map((p) => p.trim()).filter(Boolean);
  if (parts.length > 1) {
    return parts.map((p) => p.split(/\s+/)[0][0]).join('').toUpperCase();
  }
  const words = parts[0].split(/\s+/);
  return (words[0][0] + (words[1]?.[0] ?? '')).toUpperCase();
}

// The names the popup should highlight inline wherever they appear in the
// bio/family prose (e.g. "Sharath" and "Deepa" from "Sharath & Deepa") -
// same split used by socialLinks() below, kept separate since this applies
// even to cards with no social links at all. Combined with `familyNames`
// (children/pets) below into one flat list sent to the client - only the
// card's own name(s) are ever link-eligible (via socialLinks() pairing by
// position), but highlightNames() itself doesn't need to know the
// difference, it just bolds every name it's given and links the ones that
// happen to match an entry in `links`.
function highlightedNamesFor(m: Member): string[] {
  const own = m.name.split('&').map((p) => p.trim().split(/\s+/)[0]).filter(Boolean);
  return [...own, ...(m.familyNames ?? [])];
}

// Pairs each profile with the corresponding first name (by position) so
// highlightNames() below can turn that name, wherever it's mentioned in the
// bio/family text, into a link - the card's own inline name-linking is now
// the only place these links surface (there used to also be a row of
// platform icons at the bottom of the popup; removed as redundant once
// names linked inline). Doesn't handle one person submitting more than one
// profile - a second URL for the same name has nowhere else to go and is
// simply not linked, but no current submission does this.
function socialLinks(name: string, urls: string[]) {
  const firstNames = name.split('&').map((p) => p.trim().split(/\s+/)[0]);
  return urls.map((url, i) => ({
    url,
    name: firstNames[i] ?? '',
  }));
}

// Fallback only - blindly truncating at a character count reads badly for
// the longer, first-person form-sourced bios (cuts mid-sentence), which is
// why new entries should get a hand-written `summary` instead (see the
// Member interface). Still used as a safety cap for the ~53 legacy bios,
// which are already card-length and essentially never hit it, and as a cap
// on `summary` itself in case one runs long.
// Cuts at the last word boundary before maxLen rather than mid-word, unless
// that would chop off more than half the target length (a bio with no
// early spaces, e.g. one long clause).
function summarize(text: string, maxLen = 90) {
  if (text.length <= maxLen) return text;
  const cut = text.slice(0, maxLen);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > maxLen / 2 ? lastSpace : maxLen)}…`;
}

// What the card front actually shows: the curated summary if there is one,
// otherwise the truncated bio.
function cardText(m: Member): string {
  return m.summary ? summarize(m.summary) : m.bio ? summarize(m.bio) : '';
}

// Cards only get a "More" trigger (and an entry in the detail-popup data
// below) when there's actually more to show than what's already on the
// card - either the card text is shorter than the full bio, or there's a
// family/why-TVC/social answer that doesn't fit on the card at all. The
// ~20 members with no bio and no extra answers stay exactly as before,
// same height as every other plain card, since a popup would have nothing
// new to show them.
const detailed = members
  .map((m, i) => ({ i, m, summary: cardText(m) }))
  .filter(({ m, summary }) => summary !== m.bio || m.family || whyTVCList(m).length || (m.social && m.social.length))
  .map(({ i, m }) => ({
    i,
    name: m.name,
    photos: photosFor(m),
    initials: initials(m.name),
    names: highlightedNamesFor(m),
    bio: m.bio,
    family: m.family ?? '',
    whyTVC: whyTVCList(m),
    links: m.social ? socialLinks(m.name, m.social) : [],
  }));
const detailedById = new Set(detailed.map((d) => d.i));
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/journey/journey-43.jpg" imageWidth={1400} imageHeight={787}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/journey/journey-43.jpg"
    imageAlt="TVC members at the 2026 city meet-up, hosted by Kiran & Zainab"
  />

  <section class="section wrapper">
    <div class="members-grid">
      {members.map((m, i) => {
        const photos = photosFor(m);
        const photoBlock = photos.length > 1 ? (
          <div class="member-photo-stack">
            {photos.slice(0, 3).map((src) => (
              <img src={src} alt="" class="member-photo member-photo--stacked" loading="lazy" />
            ))}
          </div>
        ) : photos.length === 1 ? (
          <img src={photos[0]} alt={detailedById.has(i) ? '' : m.name} class="member-photo" loading="lazy" />
        ) : (
          <div class="member-photo member-photo--placeholder" aria-hidden="true">{initials(m.name)}</div>
        );

        return detailedById.has(i) ? (
          <button type="button" id={memberSlug(m.name)} class="member-card member-card--has-details" data-member-id={i} aria-label={`More about ${m.name}`}>
            {photoBlock}
            <h2>{m.name}</h2>
            {m.bio && <p>{cardText(m)}</p>}
            <span class="member-more" aria-hidden="true">More →</span>
          </button>
        ) : (
          <div id={memberSlug(m.name)} class="member-card">
            {photoBlock}
            <h2>{m.name}</h2>
            {m.bio && <p>{m.bio}</p>}
          </div>
        );
      })}
    </div>
  </section>

  <div id="member-overlay" class="member-overlay" hidden>
    <div class="member-panel" role="dialog" aria-modal="true" aria-label="Member details">
      {/* Close button lives outside .member-panel-scroll (below) so it's a
          sibling of the scrolling content, not a descendant - otherwise on
          a long card it scrolls out of view along with everything else and
          there's no way to close the popup except Escape or the backdrop. */}
      <button type="button" id="member-close" class="member-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <div class="member-panel-scroll">
        <img id="member-detail-photo" class="member-photo" alt="" hidden />
        <div id="member-detail-initials" class="member-photo member-photo--placeholder" aria-hidden="true" hidden></div>
        <div id="member-detail-photos" class="member-detail-photos" hidden></div>
        <h2 id="member-detail-name"></h2>
        <p id="member-detail-bio" class="member-bio"></p>
        <p id="member-detail-family" class="member-family" hidden>
          <svg class="member-family-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.6" />
            <circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6" />
            <path d="M3 19c0-3 2.2-5 5-5s5 2 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path d="M14.5 19c0-2.2 1.6-4 4-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span id="member-detail-family-text"></span>
        </p>
        <div id="member-detail-quotes" class="member-quotes" hidden></div>
      </div>
    </div>
  </div>

  <script type="application/json" id="member-detail-data" set:html={JSON.stringify(detailed)} />

  <script>
    interface MemberDetail {
      i: number;
      name: string;
      photos: string[];
      initials: string;
      names: string[];
      bio: string;
      family: string;
      whyTVC: string[];
      links: { url: string; name: string }[];
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function escapeRegExp(text: string): string {
      return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Bolds every given name (the card's own people, plus any children/pets
    // named in `familyNames`) wherever it appears in the bio/family text,
    // and turns it into a link straight to their own social profile when
    // one exists - e.g. on a couple's card, "Sharath" links to his LinkedIn,
    // "Deepa" gets just the bold treatment if she has none, and a child's
    // or pet's name is always bold-only (no social profile is ever
    // collected for them). Longest name first so "Deepa" doesn't
    // accidentally match inside a longer name that happens to contain it.
    function highlightNames(text: string, names: string[], links: MemberDetail['links']): string {
      const escaped = escapeHtml(text);
      const linkByName = new Map(links.filter((l) => l.name).map((l) => [l.name, l.url]));
      const sorted = [...names].sort((a, b) => b.length - a.length);
      if (!sorted.length) return escaped;
      const pattern = new RegExp(`\\b(${sorted.map(escapeRegExp).join('|')})\\b`, 'g');
      return escaped.replace(pattern, (match) => {
        const url = linkByName.get(match);
        return url
          ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="member-name member-name--link">${match}</a>`
          : `<span class="member-name">${match}</span>`;
      });
    }

    const QUOTE_MARK_SVG =
      '<svg class="member-quote-mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7.5 6.5C4.9 8 3.5 10.3 3.5 13.1c0 2.6 1.8 4.4 4 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.7-1.2-3-2.9-3-.3 0-.6 0-.8.1.3-1.7 1.7-3.3 3.4-4.2L7.5 6.5Zm9 0c-2.6 1.5-4 3.8-4 6.6 0 2.6 1.8 4.4 4 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.7-1.2-3-2.9-3-.3 0-.6 0-.8.1.3-1.7 1.7-3.3 3.4-4.2L16.5 6.5Z" fill="currentColor" /></svg>';

    // One quote bubble per why-TVC answer. A single shared quote (the
    // common case) renders unattributed, same as before - a name caption
    // only appears once there's more than one quote, so a reader can tell
    // whose words are whose, paired by position with the card's own name
    // split (same convention socialLinks() uses server-side).
    function renderQuotes(quotes: string[], name: string, links: MemberDetail['links']): string {
      if (!quotes.length) return '';
      const firstNames = name.split('&').map((p) => p.trim().split(/\s+/)[0]);
      return quotes
        .map((text, i) => {
          const quoteName = quotes.length > 1 ? firstNames[i] ?? '' : '';
          const link = links.find((l) => l.name === quoteName);
          const nameHtml = link
            ? `<a href="${escapeHtml(link.url)}" target="_blank" rel="noopener noreferrer" class="member-name member-name--link">${escapeHtml(quoteName)}</a>`
            : `<span class="member-name">${escapeHtml(quoteName)}</span>`;
          const cite = quoteName ? `<span class="member-quote-name">— ${nameHtml}</span>` : '';
          return `<div class="member-quote">${QUOTE_MARK_SVG}<div class="member-quote-body"><p>“${escapeHtml(text)}”</p>${cite}</div></div>`;
        })
        .join('');
    }

    const dataEl = document.getElementById('member-detail-data');
    const details: MemberDetail[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];
    const byId = new Map(details.map((d) => [d.i, d]));

    const overlay = document.getElementById('member-overlay');
    const closeBtn = document.getElementById('member-close');
    const photoEl = document.getElementById('member-detail-photo') as HTMLImageElement | null;
    const initialsEl = document.getElementById('member-detail-initials');
    const photosEl = document.getElementById('member-detail-photos');
    const nameEl = document.getElementById('member-detail-name');
    const bioEl = document.getElementById('member-detail-bio');
    const familyEl = document.getElementById('member-detail-family');
    const familyTextEl = document.getElementById('member-detail-family-text');
    const quotesEl = document.getElementById('member-detail-quotes');

    function open(detail: MemberDetail) {
      if (!overlay) return;

      if (nameEl) nameEl.textContent = detail.name;
      if (bioEl) bioEl.innerHTML = highlightNames(detail.bio, detail.names, detail.links);

      if (photoEl && initialsEl && photosEl) {
        // Reset all three each time - only one of single photo / initials /
        // stacked photos should show, depending on how many this member has.
        photoEl.hidden = true;
        initialsEl.hidden = true;
        photosEl.hidden = true;
        photosEl.innerHTML = '';

        if (detail.photos.length > 1) {
          photosEl.hidden = false;
          detail.photos.forEach((src) => {
            const img = document.createElement('img');
            img.src = src;
            img.alt = '';
            img.className = 'member-photo-dynamic';
            photosEl.appendChild(img);
          });
        } else if (detail.photos.length === 1) {
          photoEl.src = detail.photos[0];
          photoEl.alt = detail.name;
          photoEl.hidden = false;
        } else {
          initialsEl.textContent = detail.initials;
          initialsEl.hidden = false;
        }
      }

      if (familyEl && familyTextEl) {
        familyTextEl.innerHTML = highlightNames(detail.family, detail.names, detail.links);
        familyEl.hidden = !detail.family;
      }
      if (quotesEl) {
        // Left first-person on purpose - this is the one place it's framed
        // as a direct quote (speech-bubble styling below), unlike the bio/
        // family narration which is normalized to third person.
        quotesEl.innerHTML = renderQuotes(detail.whyTVC, detail.name, detail.links);
        quotesEl.hidden = detail.whyTVC.length === 0;
      }

      overlay.hidden = false;
      closeBtn?.focus();
    }

    function close() {
      if (!overlay) return;
      overlay.hidden = true;
    }

    document.querySelectorAll<HTMLButtonElement>('.member-card--has-details').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.dataset.memberId);
        const detail = byId.get(id);
        if (detail) open(detail);
      });
    });

    closeBtn?.addEventListener('click', close);

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.hidden) close();
    });

    // Lands on the member a search result (or any other #anchor link)
    // pointed at - a detailed card opens straight into its popup, since
    // whatever text matched the search (family/why-TVC/etc.) usually only
    // shows there, not on the collapsed card; a plain card just gets
    // smooth-scrolled into view since it has no popup to open. Runs on
    // initial load and on same-page hash changes (search while already on
    // this page doesn't trigger a full navigation).
    function focusFromHash() {
      const id = location.hash.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      if (el instanceof HTMLButtonElement && el.classList.contains('member-card--has-details')) {
        const detail = byId.get(Number(el.dataset.memberId));
        if (detail) open(detail);
      } else {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    focusFromHash();
    window.addEventListener('hashchange', focusFromHash);
  </script>
</BaseLayout>

<style>
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
  }

  .member-card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 16px;
    text-align: center;
    /* Every card carries a stable id (see memberSlug() in src/data/members.ts)
       so a member-name search hit (SiteSearch.astro) - or any other
       #anchor link - can jump straight to it; without this the sticky nav
       (Nav.astro, ~64px tall) would land right on top of whichever card
       the browser scrolls to. */
    scroll-margin-top: 90px;
  }

  /* Cards with a popup render as a <button> (see the aria-label on it) so
     the whole card is one click/tap target, not just the "More" text -
     reset the default button chrome back to matching the plain div cards.
     Grid's default stretch already equalizes each button's outer height to
     its row's tallest card, but a plain block-flow button leaves that extra
     space dangling below "More →" instead of using it - flex column plus
     .member-more's margin-top: auto below pins "More" to the bottom of
     every card in a row, so a card with a short curated summary (e.g. a
     couple's two-line "X does A; Y does B") doesn't strand its "More" link
     far above its row's taller neighbors. */
  button.member-card {
    appearance: none;
    font: inherit;
    color: inherit;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .member-card--has-details {
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .member-card--has-details:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 20, 10, 0.12);
    border-color: var(--tvc-green-dark);
  }

  .member-card--has-details:focus-visible {
    outline: 2px solid var(--tvc-green-dark);
    outline-offset: 2px;
  }

  .member-card h2 {
    font-size: 0.88rem;
    margin: 0;
  }

  .member-card p {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    margin: 6px 0 0;
  }

  .member-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 10px;
    display: block;
  }

  /* [hidden] normally beats any author display rule via the UA stylesheet,
     but that's specificity-based, not origin-based - .member-photo's own
     `display: block`/`flex` above is an author rule of equal specificity
     and wins by source order, silently leaving a hidden photo/placeholder
     visible (see SiteSearch.astro's .search-overlay[hidden] for the same
     issue). Needs its own explicit override here. */
  .member-photo[hidden] {
    display: none;
  }

  .member-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 700;
    font-size: 1rem;
  }

  /* When separate family members each submit their own photo for one
     card, up to 3 render as a small overlapping cluster instead of
     picking just one. */
  .member-photo-stack {
    display: flex;
    justify-content: center;
    margin: 0 auto 10px;
  }

  .member-photo--stacked {
    width: 56px;
    height: 56px;
    margin: 0;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px var(--tvc-line);
  }

  .member-photo--stacked:not(:first-child) {
    margin-left: -18px;
  }

  .member-more {
    display: block;
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .member-card--has-details:hover .member-more {
    text-decoration: underline;
  }

  /* Popup - mirrors the overlay/panel pattern used by SiteSearch.astro
     (fixed overlay, role=dialog panel, Escape/backdrop-click/close-button
     to dismiss) rather than inventing a second modal convention. */
  .member-overlay {
    position: fixed;
    inset: 0;
    background: rgba(34, 41, 31, 0.45);
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .member-overlay[hidden] {
    display: none;
  }

  .member-panel {
    position: relative;
    width: 100%;
    max-width: 420px;
    max-height: 85vh;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(15, 20, 10, 0.3);
    text-align: center;
    overflow: hidden;
  }

  .member-panel-scroll {
    max-height: 85vh;
    overflow-y: auto;
    padding: 32px 24px 24px;
  }

  .member-panel .member-photo {
    width: 96px;
    height: 96px;
    font-size: 1.4rem;
  }

  .member-detail-photos {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 auto 10px;
  }

  /* Same [hidden]-vs-author-display-rule issue as .member-photo above. */
  .member-detail-photos[hidden] {
    display: none;
  }

  .member-panel h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .member-panel p {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 8px 0 0;
  }

  .member-close {
    position: absolute;
    top: 12px;
    right: 12px;
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-soft);
    padding: 8px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
  }

  .member-close:hover {
    color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
  }

  /* Left-aligned and full-ink, unlike the secondary .member-family below -
     this is the primary description, so it gets the stronger hierarchy.
     Centered multi-line paragraphs are hard to scan; only the short,
     single-line bits above (photo/name) stay centered.
     Selector is `.member-panel .member-bio`, not just `.member-bio` - a
     bare class selector loses to `.member-panel p` above on specificity
     (class+type beats class alone) regardless of source order, which
     silently kept bio stuck at the muted ink-soft color despite this rule. */
  .member-panel .member-bio {
    text-align: left;
    color: var(--tvc-ink);
    line-height: 1.55;
  }

  /* Icon-prefixed rather than a text label ("Family:") - enough to read as
     a distinct, secondary fact at a glance without adding more copy.
     `.member-panel .member-family`, not a bare class, for the same
     specificity reason as .member-bio above - otherwise `.member-panel p`
     silently wins the font-size tug-of-war. */
  .member-panel .member-family {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    text-align: left;
    font-size: 0.8rem;
    line-height: 1.5;
    margin-top: 18px !important;
  }

  .member-family[hidden] {
    display: none;
  }

  .member-family-icon {
    flex: none;
    margin-top: 2px;
    color: var(--tvc-green-dark);
  }

  /* Speech-bubble treatment for the why-TVC field(s) - the one part of the
     card that's an actual first-person quote (everything else is
     normalized to third person). Wrapper for one or more `.member-quote`
     bubbles (see renderQuotes() in the script below) - itself static
     markup (see the Astro template above) so it can stay scoped, unlike
     its dynamically-injected children below in the global block. */
  .member-quotes {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 20px 0 0 !important;
  }

  .member-quotes[hidden] {
    display: none;
  }
</style>

<style is:global>
  /* Not scoped: .member-name/-name--link are assigned via innerHTML (see
