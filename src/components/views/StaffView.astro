const staff = staffContent[lang];
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} image="/images/pages/staff/hero.jpg" imageWidth={1280} imageHeight={683}>
  <PageHero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    intro={c.heroIntro}
    image="/images/pages/staff/hero.jpg"
    imageAlt="The TVC staff team standing together on the farm"
  />

  <section class="section wrapper">
    <div class="staff-grid">
      {staff.map((group) => (
        <div class="card">
          <div class="card-photo">
            <img src={group.image} alt={group.imageAlt} loading="lazy" />
          </div>
          <div class="card-body">
            {group.people.map((p) => (
              <div class="person">
                <h4>{p.name}</h4>
                <p class="staff-role">{p.role}</p>
                <p>{p.bio}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .staff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--tvc-green-tint);
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .card-body {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .person + .person {
    padding-top: 14px;
    border-top: 1px solid var(--tvc-line);
  }

  .staff-role {
    color: var(--tvc-orange);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }
</style>
