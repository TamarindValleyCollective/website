---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import BookingInquiry from '../BookingInquiry.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/utils';
import { organizationId } from '../../utils/schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const content = {
  en: {
    metaDescription: 'A two-day overnight camp at Tamarind Valley Collective — arrival, a hike to the sunset viewpoint, campfire, and a guided farm tour the next morning.',
    heroTitle: 'Overnight Stay',
    heroIntro: 'Everything you need for a memorable camp — tented accommodation, home-cooked meals, and a hike to catch the sunset.',
    day1Heading: 'Day 1',
    day1Text1: "Arrive post breakfast, refresh yourself with some juice made from our own produce. Check out your accommodation and settle in. Lunch is ready by 1:30pm — local cuisine, sourced on-site as far as possible. Post-lunch, relax and wait for the temperature to come down. Have your tea/coffee and start the hike up to the Chikkamma-Doddamma Temple, reaching the top around 4:30-5pm to watch the sun go down across the hills, then hike back to camp.",
    day1Text2: "Once back, enjoy some refreshments. Request a campfire and barbeque if you'd like — or skip it and let your conversation sync with the sound of crickets instead.",
    day2Heading: 'Day 2',
    day2Text1: "Wake up early for a bird watching tour with Madhavan. Back at camp, have breakfast and relax, then go on a farm tour — the kitchen garden, the food forest, the check dams, the bunds and swales built to harvest water. Refresh with some juice or buttermilk afterward. Through the various discussions along the way, you'll pick up the principles of permaculture and how to harmonize with nature rather than fight it. Have lunch, then depart.",
    day2Text2: "You can extend your trip by a day for a forest appreciation walk, guided by our team, through the adjacent Thaggatti Reserve Forest.",
    pricingHeading: 'Pricing',
    pricingRows: [
      ['Bamboo cottage or tent, per couple/night', '₹4,300'],
      ['Extended overnight stay', '₹5,950'],
      ['Kids under 5', '₹750/night'],
      ['Kids 5–12', '50% of the adult rate'],
      ['Extra adult, per weekend', '₹2,150'],
      ['Bring your own tent, per person/weekend', '₹2,450'],
    ],
    pricingNote: 'Rates include meals, the sunset hike, and the guided farm tour. Confirm current pricing and availability when you send your inquiry below.',
    bookingWhatsapp: "Hi! I'd like to know more about overnight camping at TVC.",
    bookingNote: "Camping stays are coordinated with our hospitality partner, Linger — send an inquiry or message us and we'll take it from there.",
    checkAvailability: 'Check rough availability by month',
  },
  kn: {
    metaDescription: 'ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್‌ನಲ್ಲಿ ಎರಡು ದಿನಗಳ ರಾತ್ರಿ ವಾಸ್ತವ್ಯ ಶಿಬಿರ — ಆಗಮನ, ಸೂರ್ಯಾಸ್ತದ ವೀಕ್ಷಣಾ ಸ್ಥಳಕ್ಕೆ ಚಾರಣ, ಕ್ಯಾಂಪ್‌ಫೈರ್, ಮತ್ತು ಮಾರನೆಯ ಬೆಳಿಗ್ಗೆ ಮಾರ್ಗದರ್ಶಿತ ಫಾರ್ಮ್ ಪ್ರವಾಸ.',
    heroTitle: 'ರಾತ್ರಿ ವಾಸ್ತವ್ಯ',
    heroIntro: 'ಸ್ಮರಣೀಯ ಶಿಬಿರಕ್ಕೆ ಬೇಕಾದ ಎಲ್ಲವೂ — ಟೆಂಟ್ ವಸತಿ, ಮನೆಯಲ್ಲಿ ಬೇಯಿಸಿದ ಊಟಗಳು, ಮತ್ತು ಸೂರ್ಯಾಸ್ತವನ್ನು ಕಾಣಲು ಚಾರಣ.',
    day1Heading: '1ನೇ ದಿನ',
    day1Text1: 'ಉಪಾಹಾರದ ನಂತರ ಆಗಮಿಸಿ, ನಮ್ಮದೇ ಉತ್ಪನ್ನಗಳಿಂದ ಮಾಡಿದ ಜ್ಯೂಸ್‌ನೊಂದಿಗೆ ಸ್ವಲ್ಪ ರಿಫ್ರೆಶ್ ಆಗಿ. ನಿಮ್ಮ ವಸತಿಯನ್ನು ಪರಿಶೀಲಿಸಿ ನೆಲೆಸಿ. ಮಧ್ಯಾಹ್ನ 1:30 ರ ವೇಳೆಗೆ ಊಟ ಸಿದ್ಧವಿರುತ್ತದೆ — ಸಾಧ್ಯವಾದಷ್ಟು ಸ್ಥಳದಲ್ಲೇ ಸಂಗ್ರಹಿಸಿದ ಸ್ಥಳೀಯ ಪಾಕಪದ್ಧತಿ. ಊಟದ ನಂತರ, ವಿಶ್ರಾಂತಿ ಪಡೆದು ತಾಪಮಾನ ಇಳಿಯುವವರೆಗೆ ಕಾಯಿರಿ. ನಿಮ್ಮ ಚಹಾ/ಕಾಫಿ ಕುಡಿದು ದೊಡ್ಡಮ್ಮ/ಚಿಕ್ಕಮ್ಮ ದೇವಸ್ಥಾನದವರೆಗೆ ಚಾರಣ ಪ್ರಾರಂಭಿಸಿ, ಸುಮಾರು 4:30-5 ಗಂಟೆಗೆ ಶಿಖರ ತಲುಪಿ ಬೆಟ್ಟಗಳಾದ್ಯಂತ ಸೂರ್ಯಾಸ್ತವನ್ನು ವೀಕ್ಷಿಸಿ, ನಂತರ ಶಿಬಿರಕ್ಕೆ ಹಿಂತಿರುಗಿ.',
    day1Text2: 'ಹಿಂತಿರುಗಿದ ನಂತರ, ಸ್ವಲ್ಪ ಉಪಹಾರವನ್ನು ಆನಂದಿಸಿ. ನೀವು ಬಯಸಿದರೆ ಕ್ಯಾಂಪ್‌ಫೈರ್ ಮತ್ತು ಬಾರ್ಬೆಕ್ಯೂ ಕೇಳಿ — ಅಥವಾ ಅದನ್ನು ಬಿಟ್ಟು ಜೀರುಂಡೆಗಳ ಶಬ್ದದೊಂದಿಗೆ ನಿಮ್ಮ ಮಾತುಕತೆಯನ್ನು ಸಿಂಕ್ ಮಾಡಿ.',
    day2Heading: '2ನೇ ದಿನ',
    day2Text1: 'ಮಾಧವನ್ ಜೊತೆ ಪಕ್ಷಿ ವೀಕ್ಷಣಾ ಪ್ರವಾಸಕ್ಕೆ ಬೇಗ ಎದ್ದೇಳಿ. ಶಿಬಿರಕ್ಕೆ ಹಿಂತಿರುಗಿ, ಉಪಾಹಾರ ಸೇವಿಸಿ ವಿಶ್ರಾಂತಿ ಪಡೆಯಿರಿ, ನಂತರ ಫಾರ್ಮ್ ಪ್ರವಾಸಕ್ಕೆ ಹೋಗಿ — ಅಡುಗೆ ತೋಟ, ಆಹಾರ ಅರಣ್ಯ, ಚೆಕ್ ಡ್ಯಾಮ್‌ಗಳು, ನೀರು ಸಂಗ್ರಹಿಸಲು ನಿರ್ಮಿಸಿದ ಬಂಡ್‌ಗಳು ಮತ್ತು ಸ್ವೇಲ್‌ಗಳು. ನಂತರ ಜ್ಯೂಸ್ ಅಥವಾ ಮಜ್ಜಿಗೆಯೊಂದಿಗೆ ರಿಫ್ರೆಶ್ ಆಗಿ. ದಾರಿಯುದ್ದಕ್ಕೂ ವಿವಿಧ ಚರ್ಚೆಗಳ ಮೂಲಕ, ನೀವು ಪರ್ಮಾಕಲ್ಚರ್‌ನ ತತ್ವಗಳನ್ನು ಮತ್ತು ಪ್ರಕೃತಿಯೊಂದಿಗೆ ಹೋರಾಡುವ ಬದಲು ಹೊಂದಾಣಿಕೆ ಮಾಡಿಕೊಳ್ಳುವುದು ಹೇಗೆ ಎಂಬುದನ್ನು ಕಲಿಯುವಿರಿ. ಊಟ ಮಾಡಿ, ನಂತರ ಹೊರಡಿ.',
    day2Text2: 'ಪಕ್ಕದ ತಗ್ಗಟ್ಟಿ ಮೀಸಲು ಅರಣ್ಯದ ಮೂಲಕ ನಮ್ಮ ತಂಡದ ಮಾರ್ಗದರ್ಶನದಲ್ಲಿ ಅರಣ್ಯ ಮೆಚ್ಚುಗೆ ನಡಿಗೆಗಾಗಿ ನಿಮ್ಮ ಪ್ರವಾಸವನ್ನು ಒಂದು ದಿನ ವಿಸ್ತರಿಸಬಹುದು.',
    pricingHeading: 'ಬೆಲೆ',
    pricingRows: [
      ['ಬಿದಿರಿನ ಕಾಟೇಜ್ ಅಥವಾ ಟೆಂಟ್, ಜೋಡಿಗೆ/ರಾತ್ರಿಗೆ', '₹4,300'],
      ['ವಿಸ್ತೃತ ರಾತ್ರಿ ವಾಸ್ತವ್ಯ', '₹5,950'],
      ['5ಕ್ಕಿಂತ ಕಡಿಮೆ ವಯಸ್ಸಿನ ಮಕ್ಕಳು', '₹750/ರಾತ್ರಿ'],
      ['5–12 ವಯಸ್ಸಿನ ಮಕ್ಕಳು', 'ವಯಸ್ಕರ ದರದ 50%'],
      ['ಹೆಚ್ಚುವರಿ ವಯಸ್ಕರು, ವಾರಾಂತ್ಯಕ್ಕೆ', '₹2,150'],
      ['ನಿಮ್ಮದೇ ಟೆಂಟ್ ತನ್ನಿ, ಪ್ರತಿ ವ್ಯಕ್ತಿಗೆ/ವಾರಾಂತ್ಯಕ್ಕೆ', '₹2,450'],
    ],
    pricingNote: 'ದರಗಳಲ್ಲಿ ಊಟ, ಸೂರ್ಯಾಸ್ತದ ಚಾರಣ ಮತ್ತು ಮಾರ್ಗದರ್ಶಿತ ಫಾರ್ಮ್ ಪ್ರವಾಸ ಸೇರಿದೆ. ಕೆಳಗೆ ನಿಮ್ಮ ವಿಚಾರಣೆಯನ್ನು ಕಳುಹಿಸುವಾಗ ಪ್ರಸ್ತುತ ಬೆಲೆ ಮತ್ತು ಲಭ್ಯತೆಯನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.',
    bookingWhatsapp: 'ಹಾಯ್! TVC ಯಲ್ಲಿ ರಾತ್ರಿ ವಾಸ್ತವ್ಯ ಶಿಬಿರದ ಬಗ್ಗೆ ಇನ್ನಷ್ಟು ತಿಳಿಯಲು ಬಯಸುತ್ತೇನೆ.',
    bookingNote: 'ಶಿಬಿರ ವಾಸ್ತವ್ಯಗಳನ್ನು ನಮ್ಮ ಆತಿಥ್ಯ ಪಾಲುದಾರ Linger ಜೊತೆ ಸಂಯೋಜಿಸಲಾಗುತ್ತದೆ — ವಿಚಾರಣೆ ಕಳುಹಿಸಿ ಅಥವಾ ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ, ನಾವು ಅಲ್ಲಿಂದ ನಿರ್ವಹಿಸುತ್ತೇವೆ.',
    checkAvailability: 'ತಿಂಗಳವಾರು ಅಂದಾಜು ಲಭ್ಯತೆಯನ್ನು ಪರಿಶೀಲಿಸಿ',
  },
  ta: {
    metaDescription: 'டமரிண்ட் வேலி கலெக்டிவில் இரண்டு நாள் இரவு தங்கும் முகாம் — வருகை, சூரிய அஸ்தமன பார்வையிடத்திற்கு மலையேற்றம், கேம்ப்ஃபயர், மற்றும் மறுநாள் காலை வழிகாட்டப்பட்ட பண்ணை சுற்றுலா.',
    heroTitle: 'இரவு தங்குமிடம்',
    heroIntro: 'மறக்க முடியாத முகாமிற்குத் தேவையான அனைத்தும் — கூடார தங்குமிடம், வீட்டில் சமைத்த உணவுகள், மற்றும் சூரிய அஸ்தமனத்தைக் காண மலையேற்றம்.',
    day1Heading: 'நாள் 1',
    day1Text1: 'காலை உணவுக்குப் பிறகு வந்து, எங்கள் சொந்த விளைபொருட்களிலிருந்து தயாரிக்கப்பட்ட ஜூஸ் மூலம் புத்துணர்ச்சி பெறுங்கள். உங்கள் தங்குமிடத்தை பார்வையிட்டு குடியேறுங்கள். மதிய உணவு 1:30 மணிக்குள் தயாராகிவிடும் — முடிந்தவரை இடத்திலேயே பெறப்பட்ட உள்ளூர் உணவு வகைகள். மதிய உணவுக்குப் பிறகு, ஓய்வெடுத்து வெப்பநிலை குறையும் வரை காத்திருங்கள். உங்கள் தேநீர்/காபி அருந்திய பிறகு தொட்டம்மா/சிக்கம்மா கோவிலுக்கு மலையேற்றத்தைத் தொடங்குங்கள், மாலை 4:30-5 மணியளவில் உச்சியை அடைந்து மலைகள் முழுவதும் சூரியன் மறைவதைக் காண்பீர்கள், பின்னர் முகாமிற்குத் திரும்பி நடந்து செல்லுங்கள்.',
    day1Text2: 'திரும்பியதும், சிறிது சிற்றுண்டி அனுபவியுங்கள். நீங்கள் விரும்பினால் கேம்ப்ஃபயர் மற்றும் பார்பிக்யூ கேளுங்கள் — அல்லது அதைத் தவிர்த்து, உங்கள் உரையாடலை வெட்டுக்கிளிகளின் சத்தத்துடன் ஒத்திசைக்க விடுங்கள்.',
    day2Heading: 'நாள் 2',
    day2Text1: 'மாதவனுடன் பறவை பார்வை சுற்றுலாவிற்கு அதிகாலையில் எழுந்திருங்கள். முகாமிற்குத் திரும்பி, காலை உணவு சாப்பிட்டு ஓய்வெடுத்து, பின்னர் பண்ணை சுற்றுலா செல்லுங்கள் — சமையல் தோட்டம், உணவு காடு, செக் அணைகள், நீரை சேகரிக்க கட்டப்பட்ட வரப்புகள் மற்றும் நீர்வழிகள். பின்னர் ஜூஸ் அல்லது மோர் மூலம் புத்துணர்ச்சி பெறுங்கள். வழியிலுள்ள பல்வேறு உரையாடல்கள் மூலம், இயற்கை வேளாண்மையின் கொள்கைகளையும், இயற்கையுடன் போராடுவதற்குப் பதிலாக அதனுடன் இணக்கமாக இருப்பது எப்படி என்பதையும் நீங்கள் கற்றுக்கொள்வீர்கள். மதிய உணவு சாப்பிட்டு, பின்னர் புறப்படுங்கள்.',
    day2Text2: 'எங்கள் குழுவின் வழிகாட்டுதலின் கீழ், அருகிலுள்ள தగ்கட்டி ஒதுக்கு காடு வழியாக ஒரு காடு பாராட்டு நடைக்காக உங்கள் பயணத்தை ஒரு நாள் நீட்டிக்கலாம்.',
    pricingHeading: 'விலை',
    pricingRows: [
      ['மூங்கில் காட்டேஜ் அல்லது கூடாரம், ஜோடிக்கு/இரவுக்கு', '₹4,300'],
      ['நீட்டிக்கப்பட்ட இரவு தங்குமிடம்', '₹5,950'],
      ['5 வயதுக்குட்பட்ட குழந்தைகள்', '₹750/இரவு'],
      ['5–12 வயது குழந்தைகள்', 'பெரியவர் விகிதத்தில் 50%'],
      ['கூடுதல் பெரியவர், வார இறுதிக்கு', '₹2,150'],
      ['உங்கள் சொந்த கூடாரத்தைக் கொண்டு வாருங்கள், ஒரு நபருக்கு/வார இறுதிக்கு', '₹2,450'],
    ],
    pricingNote: 'விலைகளில் உணவு, சூரிய அஸ்தமன மலையேற்றம், மற்றும் வழிகாட்டப்பட்ட பண்ணை சுற்றுலா அடங்கும். கீழே உங்கள் விசாரணையை அனுப்பும்போது தற்போதைய விலை மற்றும் கிடைக்கும் தன்மையை உறுதிப்படுத்தவும்.',
    bookingWhatsapp: 'வணக்கம்! TVC-யில் இரவு தங்கும் முகாம் பற்றி மேலும் அறிய விரும்புகிறேன்.',
    bookingNote: 'முகாம் தங்குமிடங்கள் எங்கள் விருந்தோம்பல் கூட்டாளர் Linger உடன் ஒருங்கிணைக்கப்படுகின்றன — விசாரணையை அனுப்பவும் அல்லது எங்களுக்கு செய்தி அனுப்பவும், நாங்கள் அங்கிருந்து கவனித்துக்கொள்வோம்.',
    checkAvailability: 'மாத வாரியான தோராயமான கிடைக்கும் தன்மையைச் சரிபார்க்கவும்',
  },
} as const;

const c = content[lang];
const availabilityHref = getRelativeLocaleUrl(lang, '/visit/availability');

// Real, fixed-price rows only (e.g. skips "50% of the adult rate", which
// isn't itself a price) - straight off the same pricingRows the table below
// renders, so the two can't drift apart.
const campingOffers = c.pricingRows.flatMap(([label, priceText]) => {
  const match = priceText.match(/₹([\d,]+)/);
  if (!match) return [];
  return [{ '@type': 'Offer', name: label, price: match[1].replace(/,/g, ''), priceCurrency: 'INR' }];
});
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Overnight camping stay',
  name: c.heroTitle,
  description: c.metaDescription,
  image: new URL('/images/pages/home/gallery-1.jpg', Astro.site).toString(),
  provider: { '@id': organizationId(Astro.site) },
  offers: campingOffers,
};
---

<BaseLayout lang={lang} title={t('nav.camping')} description={c.metaDescription} schema={[serviceSchema]} image="/images/pages/home/gallery-1.jpg" imageWidth={768} imageHeight={576}>
  <PageHero eyebrow={t('nav.visitTvc')} title={c.heroTitle} intro={c.heroIntro} image="/images/pages/home/gallery-1.jpg" imageAlt="Aerial view of TVC's camping huts and firepit clearing on the hillside" />

  <section class="section wrapper">
    <h2>{c.day1Heading}</h2>
    <p>{c.day1Text1}</p>
    <p>{c.day1Text2}</p>

    <h2>{c.day2Heading}</h2>
    <p>{c.day2Text1}</p>
    <p>{c.day2Text2}</p>

    <h2>{c.pricingHeading}</h2>
    <table class="pricing-table">
      <tbody>
        {c.pricingRows.map(([label, price]) => (
          <tr><td>{label}</td><td>{price}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="pricing-note">{c.pricingNote}</p>
    <p class="pricing-note"><a href={availabilityHref}>{c.checkAvailability}</a></p>

    <BookingInquiry
      lang={lang}
      type="Overnight Stay"
      whatsappMessage={c.bookingWhatsapp}
      note={c.bookingNote}
    />
  </section>
</BaseLayout>

<style>
  .pricing-table {
    width: 100%;
    max-width: 520px;
    border-collapse: collapse;
    margin: 16px 0;
  }

  .pricing-table td {
    padding: 8px 0;
    border-top: 1px dashed var(--tvc-line);
  }

  .pricing-table td:last-child {
    text-align: right;
    font-weight: 600;
    color: var(--tvc-green);
    white-space: nowrap;
    padding-left: 16px;
  }

  .pricing-note {
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }
</style>
