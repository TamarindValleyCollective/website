---
// Public accommodation-calendar prototype: hotel-booking-site-style
// aggregate availability (rooms/person-capacity free per day), never
// per-tent detail or guest data - see
// netlify/functions/accommodation-availability.mts for the endpoint this
// fetches, which enforces that boundary server-side. Lets Linger (TVC's
// hospitality partner) check availability themselves instead of calling the
// farm manager, Madhavan, who remains the only one who *writes* to this (see
// src/pages/internal/accommodation-calendar.astro).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const content = {
  en: {
    metaDescription: "See rough accommodation availability at Tamarind Valley Collective before sending a booking inquiry.",
    heroEyebrow: 'Visit',
    heroTitle: 'Accommodation Availability',
    heroIntro: "A rough month-by-month view of tent/room availability — not a booking system. Send an inquiry from the camping or day-visit page to confirm and book.",
    legendOpen: 'Open',
    legendLimited: 'Limited',
    legendFull: 'Full',
    legendClosed: 'Closed',
    loading: 'Loading…',
    error: 'Failed to load availability — try refreshing.',
    roomsSuffix: 'rooms free',
    ctaText: 'Send a booking inquiry',
  },
  kn: {
    metaDescription: 'ವಿಚಾರಣೆ ಕಳುಹಿಸುವ ಮೊದಲು ತಮರಿಂಡ್ ವ್ಯಾಲಿ ಕಲೆಕ್ಟಿವ್‌ನಲ್ಲಿ ಅಂದಾಜು ವಸತಿ ಲಭ್ಯತೆಯನ್ನು ನೋಡಿ.',
    heroEyebrow: 'ಭೇಟಿ',
    heroTitle: 'ವಸತಿ ಲಭ್ಯತೆ',
    heroIntro: 'ಟೆಂಟ್/ಕೋಣೆ ಲಭ್ಯತೆಯ ಸ್ಥೂಲ ತಿಂಗಳ-ವಾರು ನೋಟ — ಬುಕಿಂಗ್ ವ್ಯವಸ್ಥೆಯಲ್ಲ. ದೃಢೀಕರಿಸಲು ಮತ್ತು ಬುಕ್ ಮಾಡಲು ಕ್ಯಾಂಪಿಂಗ್ ಅಥವಾ ಒಂದು ದಿನದ ಭೇಟಿ ಪುಟದಿಂದ ವಿಚಾರಣೆ ಕಳುಹಿಸಿ.',
    legendOpen: 'ಲಭ್ಯವಿದೆ',
    legendLimited: 'ಸೀಮಿತ',
    legendFull: 'ಪೂರ್ಣ',
    legendClosed: 'ಮುಚ್ಚಲಾಗಿದೆ',
    loading: 'ಲೋಡ್ ಆಗುತ್ತಿದೆ…',
    error: 'ಲಭ್ಯತೆಯನ್ನು ಲೋಡ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ — ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.',
    roomsSuffix: 'ಕೋಣೆಗಳು ಲಭ್ಯ',
    ctaText: 'ಬುಕಿಂಗ್ ವಿಚಾರಣೆ ಕಳುಹಿಸಿ',
  },
  ta: {
    metaDescription: 'ஒரு முன்பதிவு விசாரணையை அனுப்பும் முன் Tamarind Valley Collective-இல் தங்குமிட லభ்யத்தன்மையைப் பார்க்கவும்.',
    heroEyebrow: 'வருகை',
    heroTitle: 'தங்குமிட கிடைக்கும் தன்மை',
    heroIntro: 'கூடாரம்/அறை கிடைக்கும் தன்மையின் தோராயமான மாத வாரியான காட்சி — ஒரு முன்பதிவு அமைப்பு அல்ல. உறுதிப்படுத்தி முன்பதிவு செய்ய முகாம் அல்லது ஒரு நாள் பயணப் பக்கத்திலிருந்து விசாரணை அனுப்பவும்.',
    legendOpen: 'திறந்துள்ளது',
    legendLimited: 'குறைவு',
    legendFull: 'முழு',
    legendClosed: 'மூடப்பட்டது',
    loading: 'ஏற்றுகிறது…',
    error: 'கிடைக்கும் தன்மையை ஏற்ற முடியவில்லை — மீண்டும் முயற்சிக்கவும்.',
    roomsSuffix: 'அறைகள் காலி',
    ctaText: 'முன்பதிவு விசாரணையை அனுப்பவும்',
  },
} as const;

const c = content[lang];
const campingHref = getRelativeLocaleUrl(lang, '/visit/camping');
---

<BaseLayout lang={lang} title={c.heroTitle} description={c.metaDescription} noindex>
  <PageHero eyebrow={c.heroEyebrow} title={c.heroTitle} intro={c.heroIntro} image="/images/pages/home/gallery-1.jpg" imageAlt="Tented accommodation at TVC" />

  <section class="section wrapper">
    <div class="month-nav">
      <button type="button" id="prev-month" class="button" aria-label="Previous month">←</button>
      <h2 id="month-label"></h2>
      <button type="button" id="next-month" class="button" aria-label="Next month">→</button>
    </div>

    <ul class="legend">
      <li><span class="dot dot--open"></span>{c.legendOpen}</li>
      <li><span class="dot dot--limited"></span>{c.legendLimited}</li>
      <li><span class="dot dot--full"></span>{c.legendFull}</li>
      <li><span class="dot dot--closed"></span>{c.legendClosed}</li>
    </ul>

    <p id="status" class="hint" data-loading-text={c.loading} data-error-text={c.error} hidden></p>
    <div id="calendar" class="calendar" data-rooms-suffix={c.roomsSuffix}></div>

    <p class="cta"><a href={campingHref}>{c.ctaText}</a></p>
  </section>
</BaseLayout>

<style>
  .month-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 16px;
  }

  .month-nav h2 {
    margin: 0;
    min-width: 200px;
    text-align: center;
  }

  .button {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 16px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .legend {
    display: flex;
    justify-content: center;
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot--open {
    background: var(--tvc-green);
  }

  .dot--limited {
    background: var(--tvc-orange);
  }

  .dot--full {
    background: #b3261e;
  }

  .dot--closed {
    background: #999;
  }

  .hint {
    text-align: center;
    color: var(--tvc-ink-soft);
  }

  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta {
    text-align: center;
    margin-top: 24px;
  }
</style>

<!--
  The day cells inside #calendar are built by the client script below
  (calendar.innerHTML = ...), not written in this component's own template -
  Astro's scoped-style attribute selector (data-astro-cid-*) only lands on
  elements it renders itself, so a normal scoped <style> block silently fails
  to match anything created at runtime. is:global is required here for that
  reason; none of these class names collide with anything in global.css
  (checked before adding this).
-->
<style is:global>
  .day {
    border-radius: 10px;
    padding: 8px 4px;
    text-align: center;
    font-size: 0.78rem;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }

  .day .num {
    font-weight: 700;
  }

  .day .rooms {
    font-size: 0.7rem;
  }

  .day--open {
    background: var(--tvc-green-tint);
  }

  .day--limited {
    background: var(--tvc-orange-tint);
  }

  .day--full {
    background: #fbebe9;
    color: #b3261e;
  }

  .day--closed {
    background: #ececec;
    color: #777;
  }
</style>

<script>
  interface DayAvailability {
    date: string;
    status: 'open' | 'limited' | 'full' | 'closed';
    roomsAvailable: number;
    totalRooms: number;
    capacityAvailable: number;
    totalCapacity: number;
    labels: string[];
  }

  const monthLabel = document.getElementById('month-label') as HTMLElement;
  const calendar = document.getElementById('calendar') as HTMLElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const roomsSuffix = calendar.dataset.roomsSuffix ?? 'rooms free';

  let currentMonth = new Date().toISOString().slice(0, 7);

  function monthDisplayLabel(monthStr: string): string {
    const [y, m] = monthStr.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString(document.documentElement.lang || 'en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  }

  function shiftMonth(monthStr: string, delta: number): string {
    const [y, m] = monthStr.split('-').map(Number);
    const d = new Date(Date.UTC(y, m - 1 + delta, 1));
    return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  }

  async function loadMonth() {
    monthLabel.textContent = monthDisplayLabel(currentMonth);
    statusEl.hidden = false;
    statusEl.textContent = statusEl.dataset.loadingText ?? 'Loading…';
    calendar.innerHTML = '';

    try {
      const res = await fetch(`/api/accommodation-availability?month=${currentMonth}`);
      if (!res.ok) throw new Error('Request failed');
      const data = (await res.json()) as { days: DayAvailability[] };
      statusEl.hidden = true;
      calendar.innerHTML = data.days
        .map((day) => {
          const dayNum = Number(day.date.slice(-2));
          const roomsText = day.status === 'closed' ? (day.labels[0] ?? '') : `${day.roomsAvailable} ${roomsSuffix}`;
          return `<div class="day day--${day.status}"><span class="num">${dayNum}</span><span class="rooms">${roomsText}</span></div>`;
        })
        .join('');
    } catch {
      statusEl.hidden = false;
      statusEl.textContent = statusEl.dataset.errorText ?? 'Failed to load availability — try refreshing.';
    }
  }

  document.getElementById('prev-month')!.addEventListener('click', () => {
    currentMonth = shiftMonth(currentMonth, -1);
    loadMonth();
  });
  document.getElementById('next-month')!.addEventListener('click', () => {
    currentMonth = shiftMonth(currentMonth, 1);
    loadMonth();
  });

  loadMonth();
</script>
