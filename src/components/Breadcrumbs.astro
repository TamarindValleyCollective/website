---
import { sectionFor } from '../data/site-map';
import { useTranslations, stripLocalePrefix, type Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import JsonLd from './JsonLd.astro';

interface Props {
  pathname: string;
  pageTitle: string;
  lang: Locale;
}

const { pathname, pageTitle, lang } = Astro.props;
const t = useTranslations(lang);

// No section (the homepage itself, or a page outside Explore/Engage) means
// there's no useful trail to show — skip rendering rather than show a
// half-empty breadcrumb. sectionFor() only knows about bare (locale-less)
// paths, so strip the /kn or /ta prefix before matching.
const barePathname = stripLocalePrefix(pathname);
const section = barePathname === '/' ? null : sectionFor(barePathname);
const sectionLabelKey = section?.label === 'Explore' ? 'nav.explore' : 'nav.engage';

// getRelativeLocaleUrl unconditionally appends a trailing slash, which
// would land after the hash (`/kn/#explore/`) and break the anchor if
// passed the raw `/#explore` — split the hash off first and reattach it to
// the already-slashed path instead.
const sectionHref = section ? (() => {
  const [bare, hash] = section.href.split('#');
  const localized = getRelativeLocaleUrl(lang, bare || '/');
  return hash ? `${localized}#${hash}` : localized;
})() : '';

// Mirrors the visual trail above 1:1 so the two never drift apart - same
// three stops (Home / section / current page), just as schema.org
// BreadcrumbList instead of markup. Last item's `item` URL is included too;
// Google's guidance treats omitting it on the current page as optional, not
// required.
const breadcrumbSchema = section ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('common.home'), item: new URL(getRelativeLocaleUrl(lang, '/'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t(sectionLabelKey), item: new URL(sectionHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: pageTitle, item: new URL(pathname, Astro.site).toString() },
  ],
} : null;
---

{section && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="wrapper breadcrumbs__inner">
      <a href={getRelativeLocaleUrl(lang, '/')}>{t('common.home')}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <a href={sectionHref}>{t(sectionLabelKey)}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span class="breadcrumbs__current" aria-current="page">{pageTitle}</span>
    </div>
  </nav>
)}
{breadcrumbSchema && <JsonLd items={[breadcrumbSchema]} />}

<style>
  .breadcrumbs {
    background: #fff;
    border-bottom: 1px solid var(--tvc-line);
  }

  .breadcrumbs__inner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 0.82rem;
    flex-wrap: wrap;
  }

  .breadcrumbs a {
    color: var(--tvc-ink-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumbs a:hover {
    color: var(--tvc-green);
  }

  .breadcrumbs__sep {
    color: var(--tvc-line);
  }

  .breadcrumbs__current {
    color: var(--tvc-ink);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60ch;
  }
</style>
