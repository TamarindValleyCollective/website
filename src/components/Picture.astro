---
// Wraps an <img> (passed as slot content, unmodified) in a <picture> that
// offers AVIF/WebP siblings ahead of it. Deliberately a *slot*, not a
// component that re-renders the <img> itself from props: Astro scopes CSS
// per-file via a data-astro-cid-* attribute stamped onto elements written
// directly in that file's own template - an <img> rendered from inside
// Picture.astro's own template would carry Picture's scope id, not the
// caller's, silently breaking every caller's scoped `.some-class { ... }`
// rule sizing/cropping that image (shipped and had to be reverted - see
// CHANGELOG). Slotted content keeps the AUTHORING file's own scope id, so
// the caller's existing <img> tag and its existing scoped CSS are both
// completely untouched; this component only ever adds the two <source>s
// around whatever <img> the caller already wrote.
//
// Usage: <Picture src="/images/foo.jpg"><img src="/images/foo.jpg" alt="..." class="whatever" /></Picture>
// (yes, `src` is repeated - once here to compute the sibling paths, once on
// the real <img> exactly as it was before this component existed.)
//
// See scripts/generate-image-variants.mjs, which writes the sibling
// .webp/.avif files these <source>s point at.
interface Props {
  src: string;
}

const { src } = Astro.props as Props;
// Some callers map over a mixed array of local paths and full remote URLs
// (e.g. HomeView's explore cards, some of which point at media.tvc.farm) -
// the generator script only ever writes siblings for local files, so a
// remote src skips straight to the plain <img>.
const isLocal = src.startsWith('/');
const withExt = (ext: string) => src.replace(/\.[^./]+$/, `.${ext}`);
---

<picture>
  {isLocal && <source srcset={withExt('avif')} type="image/avif" />}
  {isLocal && <source srcset={withExt('webp')} type="image/webp" />}
  <slot />
</picture>

<style is:global>
  /* Global, not scoped: this rule needs to reach a <picture> wherever one
     of these ends up in the DOM tree, not just ones written literally in
     this file (there are none - the element itself comes from the template
     above, which *is* in this file, but scoping it here would be redundant
     with no downside either way; is:global keeps this component's only
     styling rule trivially easy to reason about as "always applies"). Every
     call site had a plain <img> sitting directly in a flex/grid container,
     sized via rules on the img itself (width:100%, object-fit, aspect-ratio,
     or grid-item placement) - <picture> defaults to display:inline, which
     would otherwise become the flex/grid item instead of the <img>,
     breaking that sizing. `contents` removes the <picture> from the box
     tree entirely, so the <img> behaves exactly as if it were still the
     direct child. */
  picture {
    display: contents;
  }
</style>
