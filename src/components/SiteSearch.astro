---
// Client-side trigger + overlay for site search. All actual searching
// happens server-side in netlify/functions/search-ai.mts: submitting the
// search form (Enter, a mobile keyboard's "Go"/"Search" action, or tapping
// the magnifying-glass icon) calls /api/search-ai, which grounds an LLM
// answer in the site's content (see lib/site-retrieval.ts) and returns a
// short reply plus source-page links. There is no client-side keyword index
// (Pagefind was removed along with this component's old keyword-results
// list - see CHANGELOG for the "AI search by default" change) - the AI
// answer is the only result type now. Deliberately submit-triggered rather
// than firing as the visitor types: this endpoint is rate-limited and every
// request costs a real LLM call, so auto-firing on every half-typed query
// would burn through that budget for no benefit.
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" id="site-search-trigger" class="search-trigger" aria-label={t('search.trigger')}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
    <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<div id="site-search-overlay" class="search-overlay" hidden data-lang={lang}>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search tvc.farm">
    <form id="site-search-form" class="search-pill">
      <input
        id="site-search-input"
        type="text"
        enterkeyhint="search"
        placeholder={t('search.placeholder')}
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" id="site-search-close" class="search-pill__close" aria-label={t('search.close')}>
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <button type="submit" id="site-search-submit" aria-label={t('search.trigger')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.8" />
          <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </form>
    <div
      id="site-search-ai-answer"
      class="search-ai-answer"
      hidden
      data-msg-thinking={t('search.aiThinking')}
      data-msg-error={t('search.aiError')}
      data-msg-disclaimer={t('search.aiDisclaimer')}
    ></div>
  </div>
</div>

<style is:global>
  /* Global rather than scoped: the AI-answer markup is injected at runtime
     via innerHTML (see the script below), so it never carries the
     data-astro-cid attribute Astro's scoping relies on - a scoped style
     here would silently fail to match any of it. Class names below
     (search-*) are specific enough to this feature that de-scoping the
     whole block is safe. */
  .search-trigger {
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-soft);
    padding: 8px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .search-trigger:hover {
    color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(34, 41, 31, 0.45);
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 20px 20px;
  }

  /* [hidden] normally beats any author display rule via the UA stylesheet,
     but that's specificity-based, not origin-based — .search-overlay's own
     `display: flex` above is an author rule and always outranks a
     same-or-lower-specificity UA rule regardless of source order, so it
     silently wins over plain [hidden] and leaves the overlay visible.
     Needs its own explicit override here. */
  .search-overlay[hidden] {
    display: none;
  }

  /* Unlike the old design (a single bordered white box holding both the
     input row and the results below it), the panel itself carries no
     chrome - the pill and the answer card below it are each their own
     floating surface, stacked with a gap, closer to how a search-engine
     results page separates the search box from its answer. */
  .search-panel {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .search-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #fff;
    border: 1.5px solid var(--tvc-line);
    border-radius: 999px;
    padding: 6px 6px 6px 24px;
    box-shadow: 0 10px 30px rgba(15, 20, 10, 0.16);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-pill:focus-within {
    border-color: var(--tvc-green);
    box-shadow: 0 12px 34px rgba(61, 110, 82, 0.28);
  }

  /* The site-wide focus-visible ring (see global.css) draws a hard-edged
     rectangle straight through this rounded pill, since it targets the bare
     input rather than the pill shape around it - the pill's own
     border-color/shadow change above is this input's focus indicator
     instead. */
  #site-search-input:focus-visible {
    outline: none;
  }

  .search-pill input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font: inherit;
    font-size: 1.05rem;
    color: var(--tvc-ink);
    background: none;
    padding: 12px 0;
  }

  .search-pill__close {
    appearance: none;
    flex-shrink: 0;
    background: none;
    border: none;
    border-radius: 50%;
    color: var(--tvc-ink-faint, var(--tvc-ink-soft));
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .search-pill__close:hover {
    color: var(--tvc-ink);
    background: var(--tvc-cream);
  }

  #site-search-submit {
    appearance: none;
    flex-shrink: 0;
    background: var(--tvc-green);
    border: none;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  #site-search-submit:hover {
    background: var(--tvc-green-dark);
  }

  #site-search-submit:active {
    transform: scale(0.94);
  }

  .search-ai-answer {
    background: var(--tvc-cream);
    border-radius: var(--radius);
    padding: 20px 24px;
    box-shadow: 0 10px 30px rgba(15, 20, 10, 0.14);
  }

  .search-ai-answer[hidden] {
    display: none;
  }

  .search-ai-status {
    margin: 0;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .search-ai-status--loading {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .search-ai-status--loading::before {
    content: '';
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--tvc-line);
    border-top-color: var(--tvc-green);
    animation: search-ai-spin 0.7s linear infinite;
  }

  @keyframes search-ai-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .search-ai-status--error {
    color: var(--tvc-orange-text);
  }

  .search-ai-reply {
    margin: 0;
    color: var(--tvc-ink);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .search-ai-sources {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search-ai-sources a {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--tvc-green-tint);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tvc-green-dark);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .search-ai-sources a:hover {
    background: var(--tvc-green);
    color: #fff;
  }

  .search-ai-disclaimer {
    margin: 14px 0 0;
    color: var(--tvc-ink-faint, var(--tvc-ink-soft));
    font-size: 0.75rem;
  }

  @media (max-width: 480px) {
    .search-pill input {
      font-size: 1rem;
    }
  }
</style>

<script>
  interface AiSearchSource {
    title: string;
    url: string;
  }

  interface AiSearchResponse {
    reply?: string;
    sources?: AiSearchSource[];
    error?: string;
  }

  const trigger = document.getElementById('site-search-trigger');
  const overlay = document.getElementById('site-search-overlay');
  const form = document.getElementById('site-search-form') as HTMLFormElement | null;
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('site-search-close');
  const aiAnswerEl = document.getElementById('site-search-ai-answer');
  const searchLang = overlay?.dataset.lang ?? 'en';

  // Guards against a stale request resolving after a newer one was
  // submitted (or the panel closed) and overwriting a newer answer.
  let requestToken = 0;

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function resetAnswer() {
    requestToken++;
    if (aiAnswerEl) {
      aiAnswerEl.hidden = true;
      aiAnswerEl.innerHTML = '';
    }
  }

  function renderThinking() {
    if (!aiAnswerEl) return;
    aiAnswerEl.hidden = false;
    aiAnswerEl.innerHTML = `<p class="search-ai-status search-ai-status--loading">${escapeHtml(aiAnswerEl.dataset.msgThinking ?? '')}</p>`;
  }

  function renderError(message?: string) {
    if (!aiAnswerEl) return;
    aiAnswerEl.hidden = false;
    aiAnswerEl.innerHTML = `<p class="search-ai-status search-ai-status--error">${escapeHtml(message || aiAnswerEl.dataset.msgError || '')}</p>`;
  }

  function renderReply(reply: string, sources: AiSearchSource[]) {
    if (!aiAnswerEl) return;
    aiAnswerEl.hidden = false;
    const sourcesHtml = sources.length
      ? `<ul class="search-ai-sources">${sources.map((s) => `<li><a href="${s.url}">${escapeHtml(s.title)}</a></li>`).join('')}</ul>`
      : '';
    aiAnswerEl.innerHTML = `<p class="search-ai-reply">${escapeHtml(reply)}</p>${sourcesHtml}<p class="search-ai-disclaimer">${escapeHtml(aiAnswerEl.dataset.msgDisclaimer ?? '')}</p>`;
  }

  async function askAi(query: string) {
    const token = ++requestToken;
    renderThinking();
    try {
      const res = await fetch('/api/search-ai', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ query, lang: searchLang }),
      });
      const data: AiSearchResponse = await res.json();
      if (token !== requestToken) return; // panel closed or query changed since
      if (!res.ok || !data.reply) {
        renderError(data.error);
        return;
      }
      renderReply(data.reply, Array.isArray(data.sources) ? data.sources : []);
    } catch {
      if (token !== requestToken) return;
      renderError();
    }
  }

  function open() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    input.value = '';
    resetAnswer();
    input.focus();
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    trigger?.focus();
    resetAnswer();
  }

  trigger?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  // Covers Enter in the input, and a mobile keyboard's "Go"/"Search" action
  // button - some mobile keyboards don't reliably fire a real Enter keydown,
  // but always trigger the enclosing form's submit. The magnifying-glass
  // icon is also a type="submit" button, giving touch users an explicit tap
  // target that doesn't depend on the keyboard at all.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = input?.value.trim();
    if (query) askAi(query);
  });

  document.addEventListener('keydown', (e) => {
    const isOpen = overlay && !overlay.hidden;

    if (!isOpen) {
      const target = e.target as HTMLElement;
      const typing = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable;
      if (e.key === '/' && !typing) {
        e.preventDefault();
        open();
      }
      return;
    }

    if (e.key === 'Escape') close();
  });
</script>
