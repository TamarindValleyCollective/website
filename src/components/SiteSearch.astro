---
// Client-side site search — no backend. Backed by Pagefind
// (https://pagefind.app), which indexes the full rendered content of every
// non-noindex page (see BaseLayout's data-pagefind-body on <main>) as a
// post-`astro build` step and writes a static, chunked index to
// dist/pagefind/. This component dynamically imports dist/pagefind/pagefind.js
// on first open and searches entirely in the browser/web worker — no
// backend, no dist/search-index.json (the old title/description-only
// index) anymore. Rendered from Nav.astro so the trigger button sits
// naturally in the header bar's flex row; the overlay itself is
// position:fixed, so its place in the DOM doesn't matter for where it
// actually appears on screen.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';
import { members, memberSlug } from '../data/members';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

// A separate, always-correct lookup over the ~130 Members-page cards,
// searched client-side alongside Pagefind. Pagefind's own chunking merges
// many of these near-identical cards together on that one page, so a
// full-text hit on e.g. "Prameela" can come back titled after a totally
// different, later card in the same chunk with no in-page anchor at all -
// fine for prose pages, not for a flat grid of ~130 short entries. This
// index is tiny (name + url + blurb per member) and matches by substring
// against the name only, so it's always attributed to the right person and
// always deep-links to their actual card via memberSlug (see
// MembersView.astro, which anchors each card with the same id).
const memberIndex = members.map((m) => ({
  name: m.name,
  url: `${getRelativeLocaleUrl(lang, '/people/members')}#${memberSlug(m.name)}`,
  blurb: m.summary ?? m.bio ?? '',
}));
---

<button type="button" id="site-search-trigger" class="search-trigger" aria-label={t('search.trigger')}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
    <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<div id="site-search-overlay" class="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search tvc.farm">
    <div class="search-input-row">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
        <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input id="site-search-input" type="text" placeholder={t('search.placeholder')} autocomplete="off" spellcheck="false" />
      <button type="button" id="site-search-close" aria-label={t('search.close')}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul id="site-search-results" class="search-results"></ul>
    <p
      id="site-search-status"
      class="search-status"
      hidden
      data-msg-unavailable={t('search.unavailable')}
      data-msg-no-results={t('search.noResults')}
      data-msg-loading={t('search.loading')}
    ></p>
  </div>
</div>

<script type="application/json" id="site-search-members" set:html={JSON.stringify(memberIndex)} />

<style is:global>
  /* Global rather than scoped: the results <li>/<a> markup is injected at
     runtime via innerHTML (see the script below), so it never carries the
     data-astro-cid attribute Astro's scoping relies on — a scoped style
     here would silently fail to match any of it. Class names below
     (search-*) are specific enough to this feature that de-scoping the
     whole block is safe. */
  .search-trigger {
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-soft);
    padding: 8px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .search-trigger:hover {
    color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(34, 41, 31, 0.45);
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 20px 20px;
  }

  /* [hidden] normally beats any author display rule via the UA stylesheet,
     but that's specificity-based, not origin-based — .search-overlay's own
     `display: flex` above is an author rule and always outranks a
     same-or-lower-specificity UA rule regardless of source order, so it
     silently wins over plain [hidden] and leaves the overlay visible.
     Needs its own explicit override here. */
  .search-overlay[hidden] {
    display: none;
  }

  .search-panel {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(15, 20, 10, 0.3);
    overflow: hidden;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--tvc-line);
    color: var(--tvc-ink-soft);
  }

  .search-input-row input {
    flex: 1;
    border: none;
    outline: none;
    font: inherit;
    font-size: 1rem;
    color: var(--tvc-ink);
    background: none;
  }

  #site-search-close {
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-faint, var(--tvc-ink-soft));
    cursor: pointer;
    padding: 4px;
    display: inline-flex;
  }

  #site-search-close:hover {
    color: var(--tvc-ink);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    max-height: 55vh;
    overflow-y: auto;
  }

  .search-results li {
    border-radius: 10px;
  }

  .search-results a {
    display: block;
    padding: 10px 12px;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
  }

  .search-results li.is-active a,
  .search-results a:hover {
    background: var(--tvc-green-tint);
  }

  .search-result__title {
    font-weight: 600;
    color: var(--tvc-ink);
    font-size: 0.95rem;
  }

  .search-result__desc {
    color: var(--tvc-ink-soft);
    font-size: 0.85rem;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-status {
    padding: 18px;
    text-align: center;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
    margin: 0;
  }

  mark {
    background: var(--tvc-orange-tint);
    color: inherit;
    border-radius: 3px;
  }
</style>

<script>
  // Shape of the object each Pagefind result's async .data() resolves to —
  // see https://pagefind.app/docs/api/#the-search-fragment. `excerpt` is
  // already-escaped HTML with <mark> around the matched terms; `meta.title`
  // defaults to the page's first <h1>, so unlike the old title-tag based
  // index this doesn't need to strip a " · Tamarind Valley Collective"
  // suffix.
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }

  interface PagefindApi {
    search: (query: string) => Promise<{ results: { data: () => Promise<PagefindResultData> }[] }>;
  }

  interface MemberIndexEntry {
    name: string;
    url: string;
    blurb: string;
  }

  const trigger = document.getElementById('site-search-trigger');
  const overlay = document.getElementById('site-search-overlay');
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('site-search-close');
  const resultsEl = document.getElementById('site-search-results');
  const statusEl = document.getElementById('site-search-status');
  const membersDataEl = document.getElementById('site-search-members');
  const memberIndex: MemberIndexEntry[] = membersDataEl ? JSON.parse(membersDataEl.textContent ?? '[]') : [];

  let pagefind: PagefindApi | null = null;
  let loadFailed = false;
  let activeIndex = -1;
  let currentResults: PagefindResultData[] = [];
  // Guards against an older, slower keystroke's search resolving after a
  // newer one and clobbering its results.
  let searchToken = 0;

  async function loadPagefind(): Promise<PagefindApi | null> {
    if (pagefind) return pagefind;
    if (loadFailed) return null;
    try {
      // Only exists at dist/pagefind/pagefind.js after `pagefind --site
      // dist` runs post-build (see package.json) — not a source module, so
      // neither Vite nor tsc can resolve it ahead of time. The path is held
      // in a variable rather than passed as a literal: Vite's import-
      // analysis plugin statically pre-resolves literal `import('...')`
      // specifiers regardless of a `/* @vite-ignore */` comment (a Vite 8
      // regression from when that comment alone was enough), throwing a
      // fatal dev-only HMR overlay when resolution fails — a non-literal
      // specifier is never statically analyzed at all.
      const pagefindUrl = '/pagefind/pagefind.js';
      // @ts-expect-error - runtime-only asset, no module for TS to resolve
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      return pagefind;
    } catch {
      loadFailed = true;
      return null;
    }
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  // Wraps the first case-insensitive occurrence of `query` in <mark>,
  // matching the styling of Pagefind's own excerpts (see the PagefindResultData
  // comment above) even though this text never goes through Pagefind.
  function highlightMatch(text: string, query: string): string {
    const idx = text.toLowerCase().indexOf(query.toLowerCase());
    if (idx === -1) return escapeHtml(text);
    return (
      escapeHtml(text.slice(0, idx)) +
      '<mark>' + escapeHtml(text.slice(idx, idx + query.length)) + '</mark>' +
      escapeHtml(text.slice(idx + query.length))
    );
  }

  // Matches by substring against member names only (not the full bio) - see
  // the memberIndex comment in the frontmatter above for why this exists
  // separately from Pagefind. Capped at 3 so it can't crowd out every other
  // page's results for a common name fragment.
  function searchMembers(query: string): PagefindResultData[] {
    const q = query.trim();
    if (!q) return [];
    return memberIndex
      .filter((m) => m.name.toLowerCase().includes(q.toLowerCase()))
      .slice(0, 3)
      .map((m) => ({
        url: m.url,
        excerpt: highlightMatch(m.blurb || 'TVC member', q),
        meta: { title: m.name },
      }));
  }

  async function search(query: string): Promise<PagefindResultData[]> {
    const q = query.trim();
    if (!q) return [];
    const memberMatches = searchMembers(q);
    const api = await loadPagefind();
    if (!api) return memberMatches;
    const { results } = await api.search(q);
    const pageMatches = await Promise.all(results.slice(0, 8 - memberMatches.length).map((r) => r.data()));
    return [...memberMatches, ...pageMatches];
  }

  function render(query: string) {
    if (!resultsEl || !statusEl) return;
    resultsEl.innerHTML = '';
    activeIndex = -1;

    if (!query.trim()) {
      statusEl.hidden = true;
      currentResults = [];
      return;
    }
    // Member-name matches don't depend on Pagefind, so they can still
    // render even when it failed to load (loadFailed) - only fall back to
    // the unavailable/no-results message once there's truly nothing to show.
    if (currentResults.length === 0) {
      statusEl.textContent = loadFailed ? (statusEl.dataset.msgUnavailable ?? '') : (statusEl.dataset.msgNoResults ?? '');
      statusEl.hidden = false;
      return;
    }

    statusEl.hidden = true;
    currentResults.forEach((entry, i) => {
      const li = document.createElement('li');
      li.innerHTML = `<a href="${entry.url}">
        <div class="search-result__title">${escapeHtml(entry.meta.title ?? '')}</div>
        ${entry.excerpt ? `<div class="search-result__desc">${entry.excerpt}</div>` : ''}
      </a>`;
      li.dataset.index = String(i);
      resultsEl.appendChild(li);
    });
  }

  function setActive(i: number) {
    const items = resultsEl?.querySelectorAll('li') ?? [];
    items.forEach((el) => el.classList.remove('is-active'));
    if (i >= 0 && i < items.length) {
      items[i].classList.add('is-active');
      items[i].scrollIntoView({ block: 'nearest' });
    }
    activeIndex = i;
  }

  async function open() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    input.value = '';
    input.focus();
    if (!pagefind && !loadFailed) {
      if (statusEl) {
        statusEl.textContent = statusEl.dataset.msgLoading ?? '';
        statusEl.hidden = false;
      }
      await loadPagefind();
      if (statusEl) statusEl.hidden = true;
    }
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    trigger?.focus();
  }

  trigger?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  input?.addEventListener('input', async () => {
    const token = ++searchToken;
    const query = input.value;
    const results = await search(query);
    if (token !== searchToken) return; // a newer keystroke already resolved
    currentResults = results;
    render(query);
  });

  document.addEventListener('keydown', (e) => {
    const isOpen = overlay && !overlay.hidden;

    if (!isOpen) {
      const target = e.target as HTMLElement;
      const typing = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable;
      if (e.key === '/' && !typing) {
        e.preventDefault();
        open();
      }
      return;
    }

    if (e.key === 'Escape') {
      close();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(activeIndex + 1, currentResults.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(activeIndex - 1, 0));
    } else if (e.key === 'Enter') {
      const target = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
      if (target) window.location.href = target.url;
    }
  });
</script>
