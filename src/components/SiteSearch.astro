---
// Client-side site search — no backend. Fetches dist/search-index.json
// (built post-`astro build` by scripts/build-search-index.mjs from every
// page's actual rendered <title>/<meta description>) once, on first open,
// and searches it entirely in the browser. Rendered from Nav.astro so the
// trigger button sits naturally in the header bar's flex row; the overlay
// itself is position:fixed, so its place in the DOM doesn't matter for
// where it actually appears on screen.
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" id="site-search-trigger" class="search-trigger" aria-label={t('search.trigger')}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
    <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<div id="site-search-overlay" class="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search tvc.farm">
    <div class="search-input-row">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
        <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input id="site-search-input" type="text" placeholder={t('search.placeholder')} autocomplete="off" spellcheck="false" />
      <button type="button" id="site-search-close" aria-label={t('search.close')}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul id="site-search-results" class="search-results"></ul>
    <p
      id="site-search-status"
      class="search-status"
      hidden
      data-msg-unavailable={t('search.unavailable')}
      data-msg-no-results={t('search.noResults')}
      data-msg-loading={t('search.loading')}
    ></p>
  </div>
</div>

<style is:global>
  /* Global rather than scoped: the results <li>/<a> markup is injected at
     runtime via innerHTML (see the script below), so it never carries the
     data-astro-cid attribute Astro's scoping relies on — a scoped style
     here would silently fail to match any of it. Class names below
     (search-*) are specific enough to this feature that de-scoping the
     whole block is safe. */
  .search-trigger {
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-soft);
    padding: 8px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .search-trigger:hover {
    color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(34, 41, 31, 0.45);
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 20px 20px;
  }

  /* [hidden] normally beats any author display rule via the UA stylesheet,
     but that's specificity-based, not origin-based — .search-overlay's own
     `display: flex` above is an author rule and always outranks a
     same-or-lower-specificity UA rule regardless of source order, so it
     silently wins over plain [hidden] and leaves the overlay visible.
     Needs its own explicit override here. */
  .search-overlay[hidden] {
    display: none;
  }

  .search-panel {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(15, 20, 10, 0.3);
    overflow: hidden;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--tvc-line);
    color: var(--tvc-ink-soft);
  }

  .search-input-row input {
    flex: 1;
    border: none;
    outline: none;
    font: inherit;
    font-size: 1rem;
    color: var(--tvc-ink);
    background: none;
  }

  #site-search-close {
    appearance: none;
    background: none;
    border: none;
    color: var(--tvc-ink-faint, var(--tvc-ink-soft));
    cursor: pointer;
    padding: 4px;
    display: inline-flex;
  }

  #site-search-close:hover {
    color: var(--tvc-ink);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    max-height: 55vh;
    overflow-y: auto;
  }

  .search-results li {
    border-radius: 10px;
  }

  .search-results a {
    display: block;
    padding: 10px 12px;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
  }

  .search-results li.is-active a,
  .search-results a:hover {
    background: var(--tvc-green-tint);
  }

  .search-result__title {
    font-weight: 600;
    color: var(--tvc-ink);
    font-size: 0.95rem;
  }

  .search-result__desc {
    color: var(--tvc-ink-soft);
    font-size: 0.85rem;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-status {
    padding: 18px;
    text-align: center;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
    margin: 0;
  }

  mark {
    background: var(--tvc-orange-tint);
    color: inherit;
    border-radius: 3px;
  }
</style>

<script>
  interface SearchEntry {
    title: string;
    description: string;
    url: string;
  }

  const trigger = document.getElementById('site-search-trigger');
  const overlay = document.getElementById('site-search-overlay');
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('site-search-close');
  const resultsEl = document.getElementById('site-search-results');
  const statusEl = document.getElementById('site-search-status');

  let index: SearchEntry[] | null = null;
  let loadFailed = false;
  let activeIndex = -1;
  let currentResults: SearchEntry[] = [];

  async function loadIndex(): Promise<SearchEntry[]> {
    if (index) return index;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error(String(res.status));
      index = await res.json();
      return index ?? [];
    } catch {
      loadFailed = true;
      return [];
    }
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function highlight(text: string, query: string) {
    const escaped = escapeHtml(text);
    if (!query) return escaped;
    const i = escaped.toLowerCase().indexOf(query.toLowerCase());
    if (i === -1) return escaped;
    return `${escaped.slice(0, i)}<mark>${escaped.slice(i, i + query.length)}</mark>${escaped.slice(i + query.length)}`;
  }

  function search(query: string, entries: SearchEntry[]): SearchEntry[] {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    const scored = entries
      .map((e) => {
        const title = e.title.toLowerCase();
        const desc = e.description.toLowerCase();
        let score = 0;
        if (title === q) score = 100;
        else if (title.startsWith(q)) score = 80;
        else if (title.includes(q)) score = 60;
        else if (desc.includes(q)) score = 20;
        return { entry: e, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8)
      .map((r) => r.entry);
    return scored;
  }

  function render(query: string) {
    if (!resultsEl || !statusEl) return;
    resultsEl.innerHTML = '';
    activeIndex = -1;

    if (loadFailed) {
      statusEl.textContent = statusEl.dataset.msgUnavailable ?? '';
      statusEl.hidden = false;
      return;
    }
    if (!query.trim()) {
      statusEl.hidden = true;
      currentResults = [];
      return;
    }
    if (currentResults.length === 0) {
      statusEl.textContent = statusEl.dataset.msgNoResults ?? '';
      statusEl.hidden = false;
      return;
    }

    statusEl.hidden = true;
    currentResults.forEach((entry, i) => {
      const li = document.createElement('li');
      li.innerHTML = `<a href="${entry.url}">
        <div class="search-result__title">${highlight(entry.title, query)}</div>
        ${entry.description ? `<div class="search-result__desc">${highlight(entry.description, query)}</div>` : ''}
      </a>`;
      li.dataset.index = String(i);
      resultsEl.appendChild(li);
    });
  }

  function setActive(i: number) {
    const items = resultsEl?.querySelectorAll('li') ?? [];
    items.forEach((el) => el.classList.remove('is-active'));
    if (i >= 0 && i < items.length) {
      items[i].classList.add('is-active');
      items[i].scrollIntoView({ block: 'nearest' });
    }
    activeIndex = i;
  }

  async function open() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    input.value = '';
    input.focus();
    if (!index && !loadFailed) {
      if (statusEl) {
        statusEl.textContent = statusEl.dataset.msgLoading ?? '';
        statusEl.hidden = false;
      }
      await loadIndex();
      if (statusEl) statusEl.hidden = true;
    }
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    trigger?.focus();
  }

  trigger?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  input?.addEventListener('input', async () => {
    const entries = index ?? (await loadIndex());
    currentResults = search(input.value, entries);
    render(input.value);
  });

  document.addEventListener('keydown', (e) => {
    const isOpen = overlay && !overlay.hidden;

    if (!isOpen) {
      const target = e.target as HTMLElement;
      const typing = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable;
      if (e.key === '/' && !typing) {
        e.preventDefault();
        open();
      }
      return;
    }

    if (e.key === 'Escape') {
      close();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(activeIndex + 1, currentResults.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(activeIndex - 1, 0));
    } else if (e.key === 'Enter') {
      const target = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
      if (target) window.location.href = target.url;
    }
  });
</script>
