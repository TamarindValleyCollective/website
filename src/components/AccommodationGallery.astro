---
// Renders a list of {name, description, capacity?, images} items as a grid
// of cards with a click-to-enlarge lightbox - built for the
// `accommodationTypes` collection (see content.config.ts) but generic over
// any gallery-shaped item, so `facilities` (toilets, etc.) reuses the same
// component instead of a near-duplicate. Caller fetches+sorts+maps its
// collection to plain data itself (same convention as PhotoGallery.astro
// taking `photos` as a prop) rather than this component self-querying, so a
// page can filter/reorder before rendering.
//
// A page may render more than one instance (e.g. CampingView shows both
// accommodation types and facilities) - every DOM lookup below is scoped to
// its own root element (no id="..." anywhere) so instances don't collide.
import { type Locale } from '../i18n/utils';

interface GalleryItem {
  name: string;
  description: string;
  capacity?: string;
  images: { src: string; alt: string }[];
}

interface Props {
  items: GalleryItem[];
  lang?: Locale;
}

const { items, lang = 'en' } = Astro.props;

const content = {
  en: { tapToEnlarge: 'Tap a photo to enlarge', close: 'Close', previousPhoto: 'Previous photo', nextPhoto: 'Next photo' },
  kn: { tapToEnlarge: 'ದೊಡ್ಡದಾಗಿ ನೋಡಲು ಫೋಟೋ ಟ್ಯಾಪ್ ಮಾಡಿ', close: 'ಮುಚ್ಚಿ', previousPhoto: 'ಹಿಂದಿನ ಫೋಟೋ', nextPhoto: 'ಮುಂದಿನ ಫೋಟೋ' },
  ta: { tapToEnlarge: 'பெரிதாக்க புகைப்படத்தைத் தட்டவும்', close: 'மூடு', previousPhoto: 'முந்தைய படம்', nextPhoto: 'அடுத்த படம்' },
} as const;
const t = content[lang];

// One flat photo list for the lightbox (each entry knows its own item index
// range) - keeps the client script's prev/next math to simple array
// arithmetic instead of juggling nested per-item arrays.
const allPhotos = items.flatMap((item) =>
  item.images.map((img) => ({ src: img.src, alt: img.alt, itemName: item.name }))
);
let offset = 0;
const itemRanges = items.map((item) => {
  const start = offset;
  offset += item.images.length;
  return { start, count: item.images.length };
});

const photosJson = JSON.stringify(allPhotos).replace(/<\/script/gi, '<\\/script');
---

<div class="gallery" data-photos={photosJson}>
  <p class="tap-hint">{t.tapToEnlarge}</p>
  <div class="item-grid">
    {items.map((item, i) => (
      <div class="item-card card">
        <h3>{item.name}</h3>
        {item.capacity && <p class="capacity">{item.capacity}</p>}
        <p class="description">{item.description}</p>
        <div class="thumb-row">
          {item.images.map((img, j) => (
            <button type="button" class="thumb-btn" data-photo-index={itemRanges[i].start + j} aria-label={img.alt}>
              <img src={img.src} alt={img.alt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label={t.close}>&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label={t.previousPhoto}>&#8249;</button>
    <img class="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" aria-label={t.nextPhoto}>&#8250;</button>
    <p class="lightbox-caption"></p>
  </div>
</div>

<style>
  .gallery {
    margin: 16px 0 24px;
  }

  .tap-hint {
    color: var(--tvc-ink-soft);
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .item-card {
    padding: 16px;
  }

  .item-card h3 {
    margin: 0 0 2px;
  }

  .capacity {
    color: var(--tvc-green);
    font-weight: 600;
    font-size: 0.85rem;
    margin: 0 0 8px;
  }

  .description {
    margin: 0 0 12px;
    font-size: 0.92rem;
  }

  .thumb-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 6px;
  }

  .thumb-btn {
    padding: 0;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 1;
    background: var(--tvc-line);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.15s ease;
  }

  .thumb-btn:hover img,
  .thumb-btn:focus-visible img {
    transform: scale(1.06);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  /* Without this, the class's own `display: flex` (author, normal
     importance) beats the UA stylesheet's `[hidden] { display: none }` -
     same origin-precedence footgun already worked around in
     PhotoGallery.astro's .lightbox[hidden] rule - so the lightbox stayed
     visible (and unclosable, since close() only ever toggled the `hidden`
     attribute) from first page load, not just after a thumbnail click. */
  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: min(90vw, 1100px);
    max-height: 78vh;
    object-fit: contain;
    border-radius: 4px;
  }

  .lightbox-caption {
    color: #fff;
    margin-top: 12px;
    font-size: 0.9rem;
    text-align: center;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .lightbox-close {
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    font-size: 1.6rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 2rem;
  }

  .lightbox-prev {
    left: 16px;
  }

  .lightbox-next {
    right: 16px;
  }

  @media (max-width: 600px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 1.6rem;
    }
  }
</style>

<script>
  interface GalleryPhoto {
    src: string;
    alt: string;
    itemName: string;
  }

  // Scoped per root (via closest-descendant queries, no ids) rather than a
  // single document-wide lookup, since a page can render more than one
  // <AccommodationGallery> (e.g. accommodation types + facilities) - a
  // fixed-id version of this would have the second instance's lightbox
  // silently do nothing (or worse, hijack the first instance's DOM).
  document.querySelectorAll<HTMLElement>('.gallery').forEach((root) => {
    const photos: GalleryPhoto[] = JSON.parse(root.dataset.photos ?? '[]');
    const lightbox = root.querySelector<HTMLDivElement>('.lightbox');
    const lightboxImg = root.querySelector<HTMLImageElement>('.lightbox-img');
    const lightboxCaption = root.querySelector<HTMLParagraphElement>('.lightbox-caption');
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    let currentIndex = 0;

    const show = (index: number) => {
      currentIndex = (index + photos.length) % photos.length;
      const photo = photos[currentIndex];
      lightboxImg.src = photo.src;
      lightboxImg.alt = photo.alt;
      lightboxCaption.textContent = `${photo.itemName} — ${photo.alt}`;
    };

    const open = (index: number) => {
      show(index);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    root.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.photoIndex)));
    });

    root.querySelector('.lightbox-close')?.addEventListener('click', close);
    root.querySelector('.lightbox-prev')?.addEventListener('click', () => show(currentIndex - 1));
    root.querySelector('.lightbox-next')?.addEventListener('click', () => show(currentIndex + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(currentIndex - 1);
      if (e.key === 'ArrowRight') show(currentIndex + 1);
    });
  });
</script>
