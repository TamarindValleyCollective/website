---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import { getCollection, render } from 'astro:content';
import { formatDateRange, durationTag } from '../../utils/events';
import { icsDataUri, googleCalendarUrl } from '../../utils/calendar';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);

// Only worth offering on events that haven't happened yet -- adding a past
// event to your calendar is a dead end, not a conversion.
const isUpcoming = event.data.date >= new Date();
const calendarEvent = {
  uid: event.id,
  title: event.data.title,
  description: event.data.excerpt,
  date: event.data.date,
  endDate: event.data.endDate,
};

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.data.title,
  startDate: event.data.date.toISOString().slice(0, 10),
  endDate: event.data.endDate ? event.data.endDate.toISOString().slice(0, 10) : undefined,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  description: event.data.excerpt,
  image: event.data.coverImage ? new URL(event.data.coverImage, Astro.site).toString() : undefined,
  location: {
    '@type': 'Place',
    name: 'Tamarind Valley Collective',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Thaggatti village',
      addressLocality: 'Kanakapura',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
  },
  organizer: event.data.organizer
    ? { '@type': 'Organization', name: event.data.organizer }
    : { '@type': 'Organization', name: 'Tamarind Valley Collective', url: new URL('/', Astro.site).toString() },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Events', item: new URL('/events', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: event.data.title },
  ],
};
---

<BaseLayout title={event.data.title} description={event.data.excerpt} image={event.data.coverImage} schema={[eventSchema, breadcrumbSchema]}>
  <PageHero eyebrow={formatDateRange(event.data.date, event.data.endDate)} title={event.data.title} image={event.data.coverImage} imageAlt={event.data.title} />
  <article class="section wrapper prose">
    <div class="meta">
      {event.data.organizer && <p class="organizer">Organized by {event.data.organizer}</p>}
      <ul class="tags">
        {event.data.tags.map((t) => <li class="tag">{t}</li>)}
        <li class="tag tag--duration">{durationTag(event.data.date, event.data.endDate)}</li>
      </ul>
    </div>
    {isUpcoming && (
      <AddToCalendar
        googleUrl={googleCalendarUrl(calendarEvent)}
        icsHref={icsDataUri(calendarEvent)}
        icsFilename={`${event.id}.ics`}
      />
    )}
    <Content />

    {!isUpcoming && (
      event.data.interestNote ? (
        <div class="interest-widget card interest-widget--closed">
          <p>
            {event.data.interestNote}
            {event.data.interestNoteHref && <> <a href={event.data.interestNoteHref}>See it here →</a></>}
          </p>
        </div>
      ) : (
        <div class="interest-widget card" data-event={event.id} data-event-title={event.data.title}>
          <h3>Want this to happen again?</h3>
          <p>Let us know and we'll factor it into what we plan next.</p>
          <form class="interest-form">
            <input type="email" name="email" placeholder="you@example.com (optional)" aria-label="Email (optional)" />
            <button type="submit" class="button">I'm interested</button>
          </form>
          <p class="interest-count" hidden></p>
        </div>
      )
    )}

    {/* Static form for Netlify's build-time bot to detect and register -- the
        actual submission (see the script below) is an AJAX POST mirroring
        these same fields, not a direct submit of this hidden form. Present
        on every past event page regardless of interestNote, so detection
        doesn't depend on any one specific page. */}
    {!isUpcoming && (
      <form name="event-interest" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
        <input type="text" name="event" />
        <input type="text" name="event-title" />
        <input type="email" name="email" />
        <input name="bot-field" />
      </form>
    )}
  </article>

  {!isUpcoming && !event.data.interestNote && (
  <script>
    const widget = document.querySelector<HTMLElement>('.interest-widget[data-event]');

    if (widget) {
      const eventId = widget.dataset.event!;
      const eventTitle = widget.dataset.eventTitle ?? '';
      const form = widget.querySelector<HTMLFormElement>('.interest-form');
      const emailInput = widget.querySelector<HTMLInputElement>('input[name="email"]');
      const submitBtn = widget.querySelector<HTMLButtonElement>('button[type="submit"]');
      const countEl = widget.querySelector<HTMLElement>('.interest-count');
      const storageKey = `tvc-event-interest-${eventId}`;

      function showCount(count: number) {
        if (!countEl) return;
        countEl.textContent = count === 1 ? '1 person wants this again.' : `${count} people want this again.`;
        countEl.hidden = false;
      }

      function markRegistered() {
        form?.setAttribute('hidden', '');
        if (!widget!.querySelector('.interest-done')) {
          const done = document.createElement('p');
          done.className = 'interest-done';
          done.textContent = "You're in — we'll factor this into what we plan next.";
          form?.insertAdjacentElement('afterend', done);
        }
      }

      fetch(`/api/event-interest?event=${encodeURIComponent(eventId)}`)
        .then((r) => r.json())
        .then((data) => showCount(data.count ?? 0))
        .catch(() => {});

      if (localStorage.getItem(storageKey)) {
        markRegistered();
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        const email = emailInput?.value.trim() ?? '';

        try {
          const res = await fetch('/api/event-interest', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ event: eventId, email }),
          });
          const data = await res.json();

          if (res.ok) {
            showCount(data.count);
            localStorage.setItem(storageKey, '1');
            markRegistered();

            if (email && !data.deduped) {
              // Fire-and-forget: gives the farm team an actionable entry via
              // the same Netlify Forms mechanism as /contact and
              // /visit/host-an-event -- see the hidden form above.
              fetch('/', {
                method: 'POST',
                headers: { 'content-type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                  'form-name': 'event-interest',
                  event: eventId,
                  'event-title': eventTitle,
                  email,
                }).toString(),
              }).catch(() => {});
            }
          }
        } catch {
          // Leave the form enabled so they can retry.
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  </script>
  )}
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .organizer {
    margin: 0;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .tag--duration {
    background: var(--tvc-orange-tint);
    color: #a85712;
  }

  .prose :global(h2) {
    margin-top: 32px;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--tvc-orange);
    padding-left: 20px;
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .prose :global(img) {
    border-radius: var(--radius);
    margin: 16px 0;
  }

  .prose :global(table) {
    width: 100%;
    max-width: 72ch;
    border-collapse: collapse;
    margin: 16px 0 32px;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 10px 16px;
    border-bottom: 1px solid var(--tvc-line);
  }

  .prose :global(th) {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--tvc-orange);
  }

  .prose :global(td:first-child) {
    color: var(--tvc-ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(.cta) {
    max-width: 72ch;
    margin: 32px 0;
  }

  .prose :global(.cta h3) {
    margin-top: 0;
  }

  .prose :global(.cta .button) {
    margin: 12px 0;
  }

  .prose :global(.poster) {
    width: 100%;
    max-width: 360px;
    margin: 16px auto 32px;
  }

  .prose :global(.poster img) {
    margin: 0;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--tvc-line);
  }

  .prose :global(.poster figcaption) {
    margin-top: 8px;
    text-align: center;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
  }

  /* Not inside .prose's reading column -- a UI card, not article content. */
  .interest-widget {
    max-width: 72ch;
    margin-top: 40px;
  }

  .interest-widget h3 {
    margin-top: 0;
  }

  .interest-widget--closed p {
    margin: 0;
  }

  .interest-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  /* [hidden] must win over the display: flex rule above -- without this,
     setting the hidden attribute after a successful submit (see the script
     below) has no visible effect, since both rules have equal specificity
     and this one needs to come last. Same fix as .header-weather[hidden]
     in HeaderWeather.astro. */
  .interest-form[hidden] {
    display: none;
  }

  .interest-form input {
    flex: 1 1 220px;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    font: inherit;
  }

  .interest-count {
    margin: 12px 0 0;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .interest-done {
    margin: 12px 0 0;
    font-weight: 600;
    color: var(--tvc-green-dark);
  }
</style>
