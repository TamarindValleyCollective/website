---
import CommunityOutreachDetailView from '../../../components/views/CommunityOutreachDetailView.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('communityOutreach', (entry) => !entry.id.startsWith('kn/') && !entry.id.startsWith('ta/'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
---

<CommunityOutreachDetailView lang="en" post={post} />
