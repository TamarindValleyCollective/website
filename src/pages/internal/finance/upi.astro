---
// Finance (internal): UPI payments. Every row from the BHIM history and the Paytm export, whether paid directly by an operator
// of the account or by a delegate (UPI Circle), whether it is joined to a bank line in the ledger, and the delegated spend per
// calendar month against the allowance. Backed by
// netlify/functions/finance-admin.mts (/upi-lines, lib/finance-upi-view.ts); the rules are scripts/lib/finance-upi-circle.mjs.
// Files are added on the Import page; here an admin adds the delegates (who they are, from when, an optional limit) and
// picks the delegate for the payments the dates cannot decide (scripts/lib/finance-delegates.mjs, lib/finance-delegates.ts).
//
// Same shell as the other internal tools: Google Sign-In gated, unlinked, noindex. Everything the server returns is
// placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import SignInGate from '../../../components/SignInGate.astro';
import '../../../styles/data-table.css';
import '../../../styles/money.css';
---

<StaffLayout title="UPI" description="UPI payments." current="finance" currentPage="finance-upi">
  <section class="finance finance-upi section wrapper">
    <h1>UPI</h1>
    <p id="intro" class="hint">Sign in to see the UPI payments.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <!-- Only what needs doing: each notice shows when it applies, so a quiet month has none and the table is the first thing. -->
      <div id="attention" class="attention">
        <div id="delegate-queue" class="notice" hidden>
          <p id="delegate-queue-text"></p>
          <button type="button" class="button button--outline" id="delegate-queue-show">Show them</button>
        </div>
        <div id="over-card" class="notice notice--crit" hidden></div>
        <div id="bank-only" class="notice" hidden></div>
      </div>

      <div id="upi-table"></div>

      <div class="setup">
        <details class="setup-panel">
          <summary><span class="setup-title">Delegated spend by month</span><span class="setup-sum" id="months-summary"></span></summary>
          <ul class="list" id="months"></ul>
          <p class="hint" id="months-note"></p>
        </details>

        <details class="setup-panel">
          <summary><span class="setup-title">Operators</span><span class="setup-sum" id="operators-summary"></span></summary>
          <ul class="list" id="operators"></ul>
          <p class="hint" id="operators-note"></p>
          <p class="delegate-actions"><button type="button" class="button button--outline" id="operator-add" hidden>Add an operator</button></p>
        </details>

        <details class="setup-panel">
          <summary><span class="setup-title">Delegates</span><span class="setup-sum" id="delegates-summary"></span></summary>
          <ul class="list" id="delegates"></ul>
          <p class="hint" id="delegates-note"></p>
          <p class="delegate-actions"><button type="button" class="button button--outline" id="delegate-add" hidden>Add a delegate</button></p>
        </details>
      </div>
    </div>

    <dialog id="operator-dialog" class="sheet delegate-sheet" aria-labelledby="operator-title">
      <form id="operator-form" class="delegate-form" novalidate>
        <h2 id="operator-title">Add an operator</h2>
        <p class="sheet-text">An operator is a person whose UPI setup the account's UPI payments go out through. Each UPI file you import is one operator's, and each delegate belongs to one operator's circle.</p>
        <label>
          <span>Name</span>
          <input id="operator-name" autocomplete="off" maxlength="60" />
        </label>
        <p class="error" id="operator-error" role="alert" hidden></p>
        <div class="sheet-actions">
          <button type="button" class="button button--outline" id="operator-cancel">Cancel</button>
          <button type="submit" class="button" id="operator-save">Save</button>
        </div>
      </form>
    </dialog>

    <dialog id="delegate-dialog" class="sheet delegate-sheet" aria-labelledby="delegate-title">
      <form id="delegate-form" class="delegate-form" novalidate>
        <h2 id="delegate-title">Add a delegate</h2>
        <p class="sheet-text" id="delegate-lead">A delegate pays with a spend right the account's operator gave them (UPI Circle). They are known by the number the UPI app shows after "Paid for".</p>
        <label id="delegate-operator-field" hidden>
          <span>Whose UPI circle</span>
          <select id="delegate-operator"></select>
        </label>
        <label id="delegate-number-field">
          <span>Number</span>
          <input id="delegate-number" inputmode="numeric" autocomplete="off" maxlength="15" />
        </label>
        <label>
          <span>Name <small>(optional: shown instead of the number)</small></span>
          <input id="delegate-name" autocomplete="off" maxlength="60" />
        </label>
        <div class="delegate-dates">
          <label>
            <span>Started</span>
            <input id="delegate-from" type="date" />
          </label>
          <label>
            <span>Ended <small>(empty while active)</small></span>
            <input id="delegate-to" type="date" />
          </label>
        </div>
        <label>
          <span>Monthly limit in rupees <small>(optional)</small></span>
          <input id="delegate-cap" inputmode="numeric" autocomplete="off" />
        </label>
        <p class="error" id="delegate-error" role="alert" hidden></p>
        <div class="sheet-actions">
          <button type="button" class="button button--outline" id="delegate-cancel">Cancel</button>
          <button type="submit" class="button" id="delegate-save">Save</button>
        </div>
      </form>
    </dialog>

    <dialog id="party-detail" class="sheet delegate-sheet" aria-labelledby="party-detail-title">
      <div class="delegate-form">
        <h2 id="party-detail-title"></h2>
        <p class="sheet-text" id="party-detail-sub"></p>
        <p class="note" id="party-detail-diff" hidden></p>
        <dl class="detail-list" id="party-detail-list"></dl>
        <div class="sheet-actions">
          <a class="button button--outline" href="/internal/finance/parties/">Open in Parties</a>
          <button type="button" class="button" id="party-detail-close">Close</button>
        </div>
      </div>
    </dialog>

    <dialog id="ledger-peek" class="sheet delegate-sheet" aria-labelledby="ledger-peek-title">
      <div class="delegate-form">
        <h2 id="ledger-peek-title"></h2>
        <p class="sheet-text" id="ledger-peek-sub"></p>
        <dl class="detail-list" id="ledger-peek-list"></dl>
        <div class="sheet-actions">
          <a class="button button--outline" id="ledger-peek-open" href="/internal/finance/ledger/">Open in Ledger</a>
          <button type="button" class="button" id="ledger-peek-close">Close</button>
        </div>
      </div>
    </dialog>

    <dialog id="party-dialog" class="sheet delegate-sheet party-sheet" aria-labelledby="party-title">
      <form id="party-form" class="delegate-form" novalidate>
        <h2 id="party-title">Add to Parties</h2>
        <p class="sheet-text" id="party-lead"></p>
        <div id="party-list" class="party-list"></div>
        <p class="error" id="party-error" role="alert" hidden></p>
        <div class="sheet-actions">
          <button type="button" class="button button--outline" id="party-cancel">Cancel</button>
          <button type="submit" class="button" id="party-save">Add</button>
        </div>
      </form>
    </dialog>
  </section>
</StaffLayout>

<script>
  import { StaffAuthError, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';
  import { createDataTable } from '../../../../scripts/lib/data-table-ui.mjs';
  import { VPA_LOOKUP_LIMIT } from '../../../../scripts/lib/finance-vpa.mjs';
  import { icon } from '../../../../scripts/lib/admin-icons.mjs';
  import { niceName } from '../../../../scripts/lib/finance-party-suggestions.mjs';
  import { amountKind, kindClass, moneyNode } from '../../../../scripts/lib/finance-ui.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(paise / 100);
  const day = (iso: string | null) => (iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '—');
  const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

  const monthName = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const APP = { bhim: 'BHIM', paytm: 'Paytm' } as const;
  const STATE = { matched: { text: 'In the ledger', kind: 'ok' }, waiting: { text: 'Waiting for statement', kind: 'warn' }, unmatched: { text: 'Not in the statement', kind: 'crit' } } as const;

  // Whether the person behind a payment is in the Parties register (the server works it out: scripts/lib/finance-upi-parties.mjs).
  type PartyState = { state: 'matches' | 'onfile' | 'differs' | 'attach' | 'missing' | 'gateway' | 'lookup' | 'noname' | 'unnamed'; partyId?: string; partyName?: string; partyKind?: string | null; accountStatus?: string | null; verifiedName?: string | null; registeredName?: string; name?: string; kind?: string; by?: string };
  // The ledger line a payment is joined to, as much as the popup behind the bank's icon shows (the server works it out; the narration is masked for some viewers).
  type LedgerSummary = { id: string; date: string; direction: 'debit' | 'credit'; amountPaise: number; narration: string; status: 'posted' | 'open'; parts: number; category: string | null; party: string | null };
  type Badge = { label: string; short: string | null; kind: string | null; logoUrl: string | null };
  type Upi = { operatorId?: string | null; id: string; paidAt: string; time: string | null; app: 'bhim' | 'paytm'; counterparty: string | null; upiId: string | null; vpaName: string | null; vpaState: 'named' | 'asked' | 'new' | null; vpaGroup: number | null; party: PartyState; bankBadge: string | null; ledger: LedgerSummary | null; remark: string | null; amountPaise: number; direction: 'debit' | 'credit'; isCircle: boolean; upiRef: string; note: string | null; purpose: string | null; bankLineId: string | null; account: string | null; delegateId: string | null; delegate: string | null; delegateHow: 'assigned' | 'auto' | 'ambiguous' | 'none' | null; state: 'matched' | 'waiting' | 'unmatched' };
  type Delegate = { id: string; identifier: string; displayName: string | null; activeFrom: string; activeTo: string | null; capPaise: number | null; operatorId?: string | null };
  type Operator = { id: string; name: string };
  let all: Upi[] = [];
  let canEdit = false;
  let canConfigure = false;
  let delegates: Delegate[] = [];
  let operators: Operator[] = []; // whose UPI a payment went through (migration 0101); empty until it is applied
  const operatorName = (id?: string | null) => operators.find((o) => o.id === id)?.name ?? null;
  let defaultCapPaise = 0;
  let badges: Record<string, Badge> = {}; // the bank's and the app's small icons (fin_source_badges)
  // A link from the ledger arrives as ?ref=<UPI reference>: the table opens filtered to that one payment.
  const askedRef = new URLSearchParams(location.search).get('ref')?.replace(/\D/g, '').slice(0, 12) ?? '';

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    intro.hidden = false;
    intro.textContent = 'Sign in to see the UPI payments.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }

  function fail(err: unknown) {
    if (err instanceof StaffAuthError) {
      if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
      else showForbidden();
      return true;
    }
    return false;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (className) e.className = className;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function row(title: string, details: string[], pill?: { text: string; kind: 'ok' | 'warn' | 'crit' }): HTMLElement {
    const li = el('li');
    const r = el('div', 'row');
    const grow = el('span', 'grow');
    grow.append(el('span', 'title', title));
    for (const d of details) grow.append(el('span', 'detail', d));
    r.append(grow);
    if (pill) r.append(el('span', `pill pill--${pill.kind}`, pill.text));
    li.append(r);
    return li;
  }

  function renderMonths(data: any) {
    const list = $('months');
    list.replaceChildren(
      ...data.months.map((m: any) => {
        // Each delegate is counted against their own limit; payments with no delegate yet are their own line.
        const buckets: any[] = m.byDelegate ?? [];
        const lines = buckets.length
          ? buckets.map((b) => `${buckets.length > 1 || b.label ? `${b.label ?? 'No delegate yet'}: ` : ''}${rupees(b.paise)} of ${rupees(b.capPaise)} · ${plural(b.count, 'payment')}`)
          : [`${rupees(m.paise)} of ${rupees(m.capPaise)} · ${plural(m.count, 'payment')}`];
        return row(monthName(m.month), lines, m.over ? { text: 'Over the allowance', kind: 'crit' } : { text: 'Within', kind: 'ok' });
      }),
    );
    // The heading carries the one fact worth seeing with the panel shut: the latest month, and whether it is over.
    const latest = [...data.months].sort((x: any, y: any) => (x.month < y.month ? 1 : -1))[0];
    $('months-summary').textContent = latest ? `${monthName(latest.month)}: ${rupees(latest.paise)} of ${rupees(latest.capPaise)}${latest.over ? ' · over the allowance' : ''}` : 'No delegated payments yet';
    const overs = data.months.filter((m: any) => m.over);
    const overCard = $('over-card');
    overCard.hidden = overs.length === 0;
    overCard.replaceChildren(...(overs.length ? [el('p', undefined, `${overs.map((m: any) => monthName(m.month)).join(', ')} ${overs.length === 1 ? 'is' : 'are'} over the delegated allowance. Open "Delegated spend by month" below for the figures.`)] : []));
    $('months-note').textContent = data.months.length
      ? 'A delegated payment is one a delegate made with the spend right given to them (UPI Circle). Paytm marks them with the “Pocket Money” tag; BHIM marks them with no bank named and CR. Every download is in the operator’s name, so the file does not say which delegate paid.'
      : 'No delegated payments yet.';
    const b = data.bankWithoutRow;
    const card = $('bank-only');
    const reversed = data.reversedCount ?? 0;
    card.hidden = b.count === 0 && reversed === 0;
    card.replaceChildren(
      ...(b.count ? [el('p', undefined, `${plural(b.count, 'bank UPI payment')} (${rupees(b.totalPaise)}) since the first UPI record ${b.count === 1 ? 'has' : 'have'} no BHIM or Paytm row: paid from another app, or missing from the files imported.`)] : []),
      ...(reversed ? [el('p', 'hint', `${plural(reversed, 'failed payment')} the bank reversed (a credit back under the same reference) ${reversed === 1 ? 'is' : 'are'} left out of that count.`)] : []),
    );
  }

  const today = () => new Date().toLocaleDateString('en-CA');
  const labelOf = (d: Delegate) => d.displayName || d.identifier;

  // Operators: the people whose UPI the payments go out through. An admin names them; the import asks which one each UPI file is.
  function renderOperators() {
    const list = $('operators');
    list.replaceChildren(
      ...operators.map((o) => {
        const mine = delegates.filter((d) => d.operatorId === o.id).length;
        const li = row(o.name, [mine ? `${plural(mine, 'delegate')} in their UPI circle` : 'No delegates in their UPI circle']);
        if (canConfigure) {
          const inner = li.querySelector<HTMLElement>('.row')!;
          const btn = el('button', 'row');
          btn.type = 'button';
          btn.title = 'Rename this operator';
          btn.append(...Array.from(inner.childNodes));
          btn.addEventListener('click', () => openOperator(o));
          li.replaceChildren(btn);
        }
        return li;
      }),
    );
    $('operators-note').textContent = !operators.length
      ? 'Operators appear here once the database has them. Until then every UPI file is imported without asking whose it is.'
      : 'Every UPI payment went out through one operator’s UPI: directly by them, or by a delegate in their UPI circle. The import asks whose each UPI file is.';
    $('operators-summary').textContent = operators.length ? operators.map((o) => o.name).join(', ') : 'None yet';
    $('operator-add').hidden = !canConfigure || !operators.length;
  }

  const odlg = $<HTMLDialogElement>('operator-dialog');
  let editingOperator: Operator | null = null;
  $('operator-cancel').addEventListener('click', () => odlg.close());
  $('operator-add').addEventListener('click', () => openOperator(null));
  function openOperator(o: Operator | null) {
    editingOperator = o;
    $('operator-title').textContent = o ? 'Rename operator' : 'Add an operator';
    $<HTMLInputElement>('operator-name').value = o?.name ?? '';
    $('operator-error').hidden = true;
    odlg.showModal();
    $('operator-name').focus();
  }
  $('operator-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const err = $('operator-error');
    const save = $<HTMLButtonElement>('operator-save');
    save.disabled = true;
    try {
      const { status, data } = await staffFetch(editingOperator ? `/api/finance-admin/upi-operators/${editingOperator.id}` : '/api/finance-admin/upi-operators', { method: editingOperator ? 'PATCH' : 'POST', body: { name: $<HTMLInputElement>('operator-name').value } });
      if (status !== 200 && status !== 201) throw new Error(data?.error ?? 'failed');
      odlg.close();
      showToast(editingOperator ? 'Operator renamed.' : 'Operator added.');
      await load();
    } catch (e) {
      if (fail(e)) return;
      err.textContent = e instanceof Error && e.message !== 'failed' ? e.message : 'Could not save the operator. Nothing was changed.';
      err.hidden = false;
    } finally {
      save.disabled = false;
    }
  });

  function renderDelegates(data: any) {
    const list = $('delegates');
    const now = today();
    list.replaceChildren(
      ...delegates.map((d) => {
        const details = [`${d.displayName ? `Number ${d.identifier} · ` : ''}From ${day(d.activeFrom)}${d.activeTo ? ` to ${day(d.activeTo)}` : ', still active'}`, `Monthly limit ${rupees(d.capPaise ?? defaultCapPaise)}${d.capPaise ? '' : ' (the default)'} · ${plural(all.filter((u) => u.delegateId === d.id).length, 'payment')}`];
        const ended = d.activeTo !== null && d.activeTo < now;
        if (operators.length > 1 && operatorName(d.operatorId)) details.push(`UPI circle of ${operatorName(d.operatorId)}`);
        const li = row(labelOf(d), details, ended ? { text: 'Ended', kind: 'warn' } : { text: 'Active', kind: 'ok' });
        if (canConfigure) {
          const inner = li.querySelector<HTMLElement>('.row')!;
          const btn = el('button', 'row');
          btn.type = 'button';
          btn.title = 'Edit this delegate';
          btn.append(...Array.from(inner.childNodes));
          btn.addEventListener('click', () => openDelegate(d));
          li.replaceChildren(btn);
        }
        return li;
      }),
    );
    const none = data.notIdentified ?? 0;
    $('delegates-note').textContent = !delegates.length
      ? `${none ? `${plural(none, 'delegated payment')} ${none === 1 ? 'has' : 'have'} no delegate yet. ` : ''}${canConfigure ? 'Add the person who pays with the UPI Circle, from the date they started: their payments are then attributed to them automatically.' : 'An admin can add the people who pay with the UPI Circle.'}`
      : none
        ? `${plural(none, 'delegated payment')} ${none === 1 ? 'was' : 'were'} made on a day when no delegate was active (before the first start date or after an end date).`
        : 'A payment belongs to the one delegate who was active that day. When two were active at once, you choose on the payment.';
    const needs = data.needsDelegate ?? 0;
    $('delegate-queue').hidden = needs === 0;
    $('delegate-queue-text').textContent = needs ? `${plural(needs, 'delegated payment')} ${needs === 1 ? 'was' : 'were'} made while more than one delegate was active, so the dates cannot say who paid. Choose the delegate on each one.` : '';
    const activeNow = delegates.filter((d) => d.activeTo === null || d.activeTo >= now).length;
    $('delegates-summary').textContent = delegates.length ? `${plural(delegates.length, 'delegate')}, ${activeNow} active` : 'None yet';
    $('delegate-add').hidden = !canConfigure;
  }

  const dlg = $<HTMLDialogElement>('delegate-dialog');
  let editing: Delegate | null = null;
  closeOnBackdrop(dlg);
  $('delegate-cancel').addEventListener('click', () => dlg.close());
  $('delegate-add').addEventListener('click', () => openDelegate(null));
  $('delegate-queue-show').addEventListener('click', () => {
    table.setChips(['needs']);
    $('upi-table').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function openDelegate(d: Delegate | null) {
    editing = d;
    $('delegate-title').textContent = d ? 'Edit delegate' : 'Add a delegate';
    $('delegate-number-field').hidden = d !== null;
    $<HTMLInputElement>('delegate-number').value = '';
    $<HTMLInputElement>('delegate-name').value = d?.displayName ?? '';
    $<HTMLInputElement>('delegate-from').value = d?.activeFrom ?? '';
    $<HTMLInputElement>('delegate-to').value = d?.activeTo ?? '';
    $<HTMLInputElement>('delegate-cap').value = d?.capPaise ? String(d.capPaise / 100) : '';
    $<HTMLInputElement>('delegate-cap').placeholder = `${rupees(defaultCapPaise)} if empty`;
    // Whose UPI circle: asked when there is more than one operator (with one, the delegate is theirs).
    const opSelect = $<HTMLSelectElement>('delegate-operator');
    opSelect.replaceChildren(...(d ? [] : [new Option('Choose…', '')]), ...operators.map((o) => new Option(o.name, o.id)));
    opSelect.value = d?.operatorId ?? '';
    $('delegate-operator-field').hidden = operators.length < 2 || d !== null;
    $('delegate-error').hidden = true;
    dlg.showModal();
    (d ? $('delegate-name') : $('delegate-number')).focus();
  }

  $('delegate-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const err = $('delegate-error');
    const capText = $<HTMLInputElement>('delegate-cap').value.trim().replace(/[,\s₹]/g, '');
    const body: Record<string, unknown> = {
      displayName: $<HTMLInputElement>('delegate-name').value,
      activeFrom: $<HTMLInputElement>('delegate-from').value,
      activeTo: $<HTMLInputElement>('delegate-to').value,
      capPaise: capText === '' ? null : Math.round(Number(capText) * 100),
    };
    if (!editing) body.identifier = $<HTMLInputElement>('delegate-number').value;
    if (!editing && operators.length > 1) body.operatorId = $<HTMLSelectElement>('delegate-operator').value;
    if (capText !== '' && !Number.isFinite(Number(capText))) {
      err.textContent = 'The monthly limit must be an amount in rupees.';
      err.hidden = false;
      return;
    }
    const save = $<HTMLButtonElement>('delegate-save');
    save.disabled = true;
    try {
      const { status, data } = await staffFetch(editing ? `/api/finance-admin/delegates/${editing.id}` : '/api/finance-admin/delegates', { method: editing ? 'PATCH' : 'POST', body });
      if (status !== 200 && status !== 201) throw new Error(data?.error ?? 'failed');
      dlg.close();
      showToast(editing ? 'Delegate saved.' : 'Delegate added.');
      await load();
    } catch (e) {
      if (fail(e)) return;
      err.textContent = e instanceof Error && e.message !== 'failed' ? e.message : 'Could not save the delegate. Nothing was changed.';
      err.hidden = false;
    } finally {
      save.disabled = false;
    }
  });

  // Who paid, for one payment. A settled payment (the one delegate active that day) is just its label; one the dates cannot
  // decide, or one an admin picked, is a select so it can be chosen or taken back.
  const paidByText = (u: Upi) => (u.isCircle ? `Delegate · ${u.delegate ?? 'no delegate yet'}` : operators.length > 1 && operatorName(u.operatorId) ? `Direct · ${operatorName(u.operatorId)}` : 'Direct');
  function paidByCell(u: Upi): Node {
    const settled = u.delegateHow === 'auto' || !canEdit || !delegates.length;
    if (!u.isCircle || settled) return el('span', u.isCircle && !u.delegate ? 'dim' : undefined, paidByText(u));
    const pick = el('select', 'pick');
    pick.setAttribute('aria-label', `Who made the payment to ${u.counterparty ?? 'an unnamed payee'}`);
    pick.append(Object.assign(el('option', undefined, u.delegateHow === 'assigned' ? 'Let the dates decide' : 'Which delegate?'), { value: '' }));
    for (const d of delegates) pick.append(Object.assign(el('option', undefined, labelOf(d)), { value: d.id }));
    pick.value = u.delegateHow === 'assigned' ? (u.delegateId ?? '') : '';
    if (u.delegateHow !== 'assigned') pick.classList.add('open');
    pick.addEventListener('change', async () => {
      pick.disabled = true;
      try {
        const { status, data } = await staffFetch('/api/finance-admin/delegates/assign', { method: 'POST', body: { delegateId: pick.value || null, upiRefs: [u.upiRef] } });
        if (status !== 200) throw new Error(data?.error ?? 'failed');
        showToast(pick.value ? 'Delegate chosen.' : 'The dates decide again.');
        await load();
      } catch (e) {
        pick.disabled = false;
        if (!fail(e)) showToast(e instanceof Error && e.message !== 'failed' ? e.message : 'Could not save the choice.');
      }
    });
    return pick;
  }

  // Like Paid to / from in the ledger: at rest the note is quiet text (the app's own wording, such as a Paytm remark, shows in
  // italics until a note is written, the way a suggestion does there); click it to edit, Enter or leaving the field saves,
  // Escape cancels. It is the same note the ledger shows for this payment (keyed on the UPI reference).
  function noteCell(u: Upi): HTMLElement {
    const td = document.createElement('span');
    td.className = 'note-cell';
    const given = u.purpose ?? u.remark ?? '';
    const paint = () => {
      const text = u.note ?? given;
      if (!canEdit) {
        td.textContent = text;
        return;
      }
      const peek = el('button', `peek${u.note ? '' : ' ghost'}`, text || 'Add a note');
      peek.type = 'button';
      peek.title = u.note ? 'Click to edit the note' : given ? (u.purpose ? 'From the payment request or log. Click to write your own note' : 'From the payment app. Click to write your own note') : 'Click to add a note';
      peek.addEventListener('click', edit);
      td.replaceChildren(peek);
    };
    function edit() {
      const input = el('input', 'note-input');
      input.type = 'text';
      input.maxLength = 300;
      input.value = u.note ?? given;
      input.setAttribute('aria-label', `Note on the payment to ${u.counterparty ?? 'an unnamed payee'}`);
      let done = false;
      const finish = async (save: boolean) => {
        if (done) return;
        done = true;
        const text = input.value.trim() === given && !u.note ? '' : input.value;
        if (!save || text.trim() === (u.note ?? '')) return paint();
        input.disabled = true;
        try {
          const { status, data } = await staffFetch('/api/finance-admin/payment-note', { method: 'POST', body: { key: `upi:${u.upiRef}`, note: text } });
          if (status !== 200) throw new Error(data?.error ?? 'failed');
          u.note = data.note ?? null;
          showToast(u.note ? 'Note saved.' : 'Note removed.');
        } catch (err) {
          if (!fail(err)) showToast(err instanceof Error && err.message !== 'failed' ? err.message : 'Could not save the note.');
        }
        paint();
      };
      input.addEventListener('blur', () => void finish(true));
      input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') void finish(true);
        if (ev.key === 'Escape') void finish(false);
      });
      td.replaceChildren(input);
      input.focus();
      input.select();
    }
    paint();
    return td;
  }

  // ---- Name, Party and the actions that fill them in (docs/finance/FINANCE.md, "UPI ID names"). The server decides each row's state; this only shows it.
  // The Party cell says one thing: a party exists, so its name, as a link to its details; none, so just an Add button; the name matches a party but the ID
  // is not on it yet, so the party's name and Add ID. Nothing says in words what a button already says. A name that differs from what Razorpay says is the
  // same link in amber with a mark. Row actions are the shell's soft buttons: green when they change the register, neutral when they only read.
  function action(label: string, iconName: string, tone: 'change' | 'read', aria: string, onClick: (b: HTMLButtonElement) => void): HTMLButtonElement {
    const b = el('button', `button ${tone === 'change' ? 'button--soft' : 'button--soft-neutral'}`);
    b.type = 'button';
    b.append(icon(iconName, 12), document.createTextNode(label));
    b.setAttribute('aria-label', aria);
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      onClick(b);
    });
    return b;
  }

  // Razorpay gives names in capitals; they are shown in readable case here (the popup quotes Razorpay exactly).
  const nameText = (u: Upi) => (u.party.state === 'gateway' ? 'Payment gateway' : null) ?? (u.vpaName ? niceName(u.vpaName) : null) ?? (u.party.state === 'lookup' ? 'Not looked up yet' : u.vpaState === 'asked' ? 'No name on file' : (u.counterparty ?? ''));
  function nameCell(u: Upi): Node | string {
    // A gateway's registered name (Razorpay...) is not the payee's, so it is not shown as the name.
    if (u.party.state === 'gateway') {
      const g = el('span', 'dim', 'Payment gateway');
      g.title = 'This UPI ID belongs to a payment gateway, which serves many merchants, so it says nothing about who was paid.';
      return g;
    }
    if (u.vpaName) {
      const s = el('span', undefined, niceName(u.vpaName));
      s.title = 'The name registered for this UPI ID, from Razorpay';
      return s;
    }
    if (u.party.state === 'lookup') {
      const cell = el('span', 'name-new');
      cell.append(el('span', 'dim', 'Not looked up yet'));
      // One ID at a time: the same call as the toolbar button, for just this row (the server reads the row's own "Paid to"; the page never needs the ID).
      if (canEdit) cell.append(action('Look up', 'search', 'read', `Look up the registered name for ${u.counterparty ?? 'this UPI ID'}`, (b) => void runLookUp([u.id], b)));
      return cell;
    }
    return u.vpaState === 'asked' ? el('span', 'dim', 'No name on file') : (u.counterparty ?? '');
  }
  const lookUpButton = el('button', 'button button--outline button--small', '');
  lookUpButton.type = 'button';
  lookUpButton.hidden = true;
  // A billed call, so it is a button and never automatic: the payments whose "Paid to" is a UPI ID not looked up yet, at most VPA_LOOKUP_LIMIT IDs a click
  // (the server counts IDs, not payments). A gateway's ID is never worth a lookup, and the server marks it so.
  const toLookUp = () => all.filter((u) => u.party.state === 'lookup');
  function renderLookUp() {
    const n = canEdit ? new Set(toLookUp().map((u) => u.vpaGroup ?? u.id)).size : 0;
    lookUpButton.hidden = n === 0;
    if (n) {
      const k = Math.min(n, VPA_LOOKUP_LIMIT);
      lookUpButton.textContent = `Look up ${k} UPI ${k === 1 ? 'name' : 'names'}${n > VPA_LOOKUP_LIMIT ? ` (of ${n})` : ''}`;
    }
  }
  lookUpButton.addEventListener('click', () => void runLookUp(toLookUp().map((u) => u.id), lookUpButton));
  // Asks about the UPI IDs of these payments (the server skips any already looked up, stops at the first failure, and caps one request), then reloads.
  // `trigger` is the button that was pressed, disabled while it runs.
  async function runLookUp(upiRowIds: string[], trigger: HTMLButtonElement) {
    trigger.disabled = true;
    const label = trigger.textContent;
    trigger.textContent = 'Looking up…';
    try {
      const { status, data: res } = await staffFetch('/api/finance-admin/vpa-names', { method: 'POST', body: { upiRowIds } });
      if (status !== 200) showToast(res?.error ?? 'Could not look up the names.');
      else {
        const parts = [res.named ? `${res.named} named` : '', res.noName ? `${res.noName} with no name on file` : '', res.notFound ? `${res.notFound} not found` : ''].filter(Boolean);
        showToast(`${res.stoppedBecause ? `Stopped: ${res.stoppedBecause} ` : ''}${parts.length ? `${parts.join(', ')}.` : res.asked ? '' : 'Nothing new to look up.'}`.trim());
        if (res.asked) await load();
      }
    } catch (err) {
      if (!fail(err)) showToast('Could not look up the names.');
    } finally {
      trigger.disabled = false;
      if (trigger.isConnected) trigger.textContent = label; // a row button is rebuilt by the reload; the toolbar one is relabelled below
      renderLookUp();
    }
  }

  const PARTY_TEXT: Record<PartyState['state'], string> = { matches: 'In Parties', onfile: 'In Parties', differs: 'Name differs', attach: 'ID not on file', missing: 'Not in Parties', gateway: 'Payment gateway', lookup: 'Not looked up yet', noname: 'No name on file', unnamed: 'No name' };
  // The words for filtering, grouping and search; the cell itself shows only a link or a button.
  const partyText = (u: Upi) => PARTY_TEXT[u.party.state];
  function partyCell(u: Upi): Node | string {
    const p = u.party;
    const cell = el('span', 'party-cell');
    const link = (differs: boolean) => {
      const b = el('button', `link-button plink${differs ? ' differs' : ''}`, p.partyName ?? '');
      b.type = 'button';
      b.setAttribute('aria-haspopup', 'dialog');
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        openPartyDetail(u, b);
      });
      return b;
    };
    if (p.state === 'matches' || p.state === 'onfile') cell.append(link(false));
    else if (p.state === 'differs') {
      const mark = el('span', 'mark', '≠');
      mark.setAttribute('role', 'img');
      mark.setAttribute('aria-label', 'Razorpay says a different name');
      mark.title = `Razorpay says this UPI ID is registered to "${p.registeredName}"`;
      cell.append(link(true), mark);
    } else if (canEdit && p.state === 'attach') cell.append(link(false), action('Add ID', 'plus', 'change', `Add this UPI ID to ${p.partyName}`, () => openReview(pendingAdds().filter((x) => x.key === pendingKey(u)))));
    else if (p.state === 'attach') cell.append(link(false));
    else if (canEdit && (p.state === 'missing' || p.state === 'gateway')) cell.append(action('Add', 'plus', 'change', p.state === 'gateway' ? 'Add the payee of this payment to Parties' : `Add ${p.name} to Parties`, () => openReview(pendingAdds().filter((x) => x.key === pendingKey(u)))));
    return cell.childNodes.length ? cell : '';
  }

  // A party's details, behind its name: who it is, the UPI ID it holds and whether that is verified, what Razorpay says, and where to go next.
  const detailDialog = $<HTMLDialogElement>('party-detail');
  closeOnBackdrop(detailDialog);
  let detailOpener: HTMLElement | null = null;
  detailDialog.addEventListener('close', () => detailOpener?.focus());
  $('party-detail-close').addEventListener('click', () => detailDialog.close());
  const KIND_WORDS: Record<string, string> = { vendor: 'Vendor', customer: 'Customer', member: 'Member', employee: 'Employee', government: 'Government', bank: 'Bank', director: 'Director', other: 'Other' };
  function openPartyDetail(u: Upi, trigger: HTMLElement) {
    const p = u.party;
    detailOpener = trigger;
    const payments = all.filter((x) => p.partyId && x.party.partyId === p.partyId).length;
    $('party-detail-title').textContent = p.partyName ?? '';
    $('party-detail-sub').textContent = `${KIND_WORDS[p.partyKind ?? ''] ?? 'Party'} · ${plural(payments, 'UPI payment')} here`;
    const diff = $('party-detail-diff');
    diff.hidden = p.state !== 'differs';
    diff.textContent = p.state === 'differs' ? `Razorpay says this UPI ID is registered to “${p.registeredName}”, not “${p.partyName}”. Check which is right; the party can be renamed on the Parties page.` : '';
    const idStatus = p.accountStatus === 'verified' ? 'Verified' : p.accountStatus === 'unverified' ? 'Added, waiting for someone else to verify' : '';
    const rows: [string, string, string][] = [['UPI ID', u.upiId ? u.upiId : 'Not on this party', idStatus]];
    rows.push(['Razorpay says', p.registeredName ?? 'Not looked up yet', p.state === 'matches' && p.registeredName ? 'The registered name fits this party.' : '']);
    if (p.verifiedName) rows.push(['Name the bank showed', p.verifiedName, 'Recorded when the UPI ID was verified.']);
    $('party-detail-list').replaceChildren(
      ...rows.flatMap(([k, v, sub]) => {
        const dd = el('dd', undefined, v);
        if (sub) dd.append(el('br'), el('span', 'dim', sub));
        return [el('dt', undefined, k), dd];
      }),
    );
    detailDialog.showModal();
  }

  // The cross-reference to the ledger: the bank's icon (a button) opens a popup about the ledger line this payment is joined to, with a link to open it there.
  const ledgerDialog = $<HTMLDialogElement>('ledger-peek');
  closeOnBackdrop(ledgerDialog);
  let ledgerOpener: HTMLElement | null = null;
  ledgerDialog.addEventListener('close', () => ledgerOpener?.focus());
  $('ledger-peek-close').addEventListener('click', () => ledgerDialog.close());
  function bankIcon(u: Upi): HTMLElement {
    const b = badges[u.bankBadge ?? 'bank'];
    const label = b?.label ?? 'Bank';
    const btn = el('button', `badge badge--${b?.kind ?? 'bank'} ${b?.logoUrl ? 'badge--icon' : 'badge--text'}`);
    btn.type = 'button';
    btn.title = `${label}: see the ledger line for this payment`;
    btn.setAttribute('aria-label', `${label}: see the ledger line for this payment`);
    btn.setAttribute('aria-haspopup', 'dialog');
    if (b?.logoUrl) {
      const img = el('img');
      img.src = b.logoUrl;
      img.alt = '';
      img.width = 17;
      img.height = 17;
      btn.append(img);
    } else btn.append(document.createTextNode(b?.short ?? label));
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLedgerPeek(u, btn);
    });
    return btn;
  }
  function openLedgerPeek(u: Upi, trigger: HTMLElement) {
    const l = u.ledger;
    if (!l) return;
    ledgerOpener = trigger;
    $('ledger-peek-title').textContent = `Ledger line of ${day(l.date)}`;
    $('ledger-peek-sub').textContent = [u.account, `${l.direction === 'debit' ? '−' : '+'}${rupees(l.amountPaise)}`].filter(Boolean).join(' · ');
    const posted = l.status === 'posted' ? `${[l.category, l.party].filter(Boolean).join(' · ') || 'Posted'}${l.parts > 1 ? ` (and ${l.parts - 1} more part${l.parts === 2 ? '' : 's'})` : ''}` : 'Not allocated yet';
    const rows: [string, string][] = [['Bank narration', l.narration], ['In the ledger as', posted], ['UPI reference', u.upiRef]];
    $('ledger-peek-list').replaceChildren(...rows.flatMap(([k, v]) => [el('dt', undefined, k), el('dd', undefined, v)]));
    $<HTMLAnchorElement>('ledger-peek-open').href = `/internal/finance/ledger/?line=${l.id}`;
    ledgerDialog.showModal();
  }

  // One entry per person, not per payment, and per UPI ID (two IDs are two entries even for one name): people who are not in Parties (to add) and IDs that
  // belong to a party already there (to attach). A gateway's ID serves many merchants, so each of its payments is its own entry.
  const pendingKey = (u: Upi) => (u.party.state === 'gateway' ? `gateway:${u.id}` : `${u.party.state}:${u.vpaGroup !== null ? `id${u.vpaGroup}` : (u.party.name ?? u.party.partyId ?? '').toLowerCase()}`);
  const toolbarTools = el('span', 'upi-tools');
  const addPartiesButton = el('button', 'button button--outline button--small', '');
  addPartiesButton.type = 'button';
  addPartiesButton.hidden = true;
  toolbarTools.append(lookUpButton, addPartiesButton);

  // `gateway`: the payee behind a payment gateway is unknown, so the name starts empty, must be typed, and no UPI ID is attached. `hasId`: there is a
  // UPI ID the reviewer may choose to attach (a person nobody matches, not a gateway). `idShown`: that ID as this viewer may see it (masked or full).
  type Pending = { key: string; action: 'add' | 'attach'; rowId: string; name: string; kind: string; partyName?: string; payments: number; gateway: boolean; hasId: boolean; idShown: string | null };
  function pendingAdds(): Pending[] {
    const out = new Map<string, Pending>();
    for (const u of all) {
      const p = u.party;
      if (p.state !== 'missing' && p.state !== 'attach' && p.state !== 'gateway') continue;
      const key = pendingKey(u);
      const hit = out.get(key);
      if (hit) hit.payments++;
      else out.set(key, { key, action: p.state === 'attach' ? 'attach' : 'add', rowId: u.id, name: p.state === 'gateway' ? '' : (p.name ?? p.registeredName ?? ''), kind: p.kind ?? 'vendor', partyName: p.partyName, payments: 1, gateway: p.state === 'gateway', hasId: p.state === 'missing' && Boolean(p.registeredName), idShown: u.upiId });
    }
    return [...out.values()];
  }
  function renderAddParties() {
    const n = canEdit ? pendingAdds().length : 0;
    addPartiesButton.hidden = n === 0;
    if (n) addPartiesButton.textContent = `Add ${n} to Parties`;
  }
  const PARTY_KINDS_SHOWN: [string, string][] = [['vendor', 'Vendor'], ['customer', 'Customer'], ['employee', 'Employee'], ['government', 'Government'], ['bank', 'Bank'], ['director', 'Director'], ['other', 'Other']];
  const partyDialog = $<HTMLDialogElement>('party-dialog');
  closeOnBackdrop(partyDialog);
  $('party-cancel').addEventListener('click', () => partyDialog.close());
  const saveButton = $<HTMLButtonElement>('party-save');
  let reviewing: { item: Pending; tick: HTMLInputElement; name: HTMLInputElement; kind: HTMLSelectElement; attach: HTMLInputElement | null }[] = [];
  // The confirm button says how many will be added and cannot be pressed with none selected.
  function syncSave() {
    const n = reviewing.filter((r) => r.tick.checked).length;
    saveButton.disabled = n === 0;
    saveButton.textContent = n ? `Add ${n}` : 'Add';
  }
  addPartiesButton.addEventListener('click', () => openReview(pendingAdds()));
  // The review list for these people (everyone waiting, or the one a row's button names): select, edit the name and kind, confirm.
  function openReview(items: Pending[]) {
    if (!items.length) return;
    const toAdd = items.filter((i) => i.action === 'add' && !i.gateway).length;
    const toAttach = items.filter((i) => i.action === 'attach').length;
    const byGateway = items.filter((i) => i.gateway).length;
    $('party-lead').textContent = [
      toAdd ? `${plural(toAdd, 'person', 'people')} to add, unverified, with their UPI ID where there is one.` : '',
      toAttach ? `${plural(toAttach, 'UPI ID')} to add to a party already in Parties.` : '',
      byGateway ? `${plural(byGateway, 'payment')} through a payment gateway: type who it was for. The gateway's name and ID are not used.` : '',
      'Deselect anyone you do not want. Someone else verifies each UPI ID.',
    ].filter(Boolean).join(' ');
    reviewing = items.map((item) => {
      const tick = el('input');
      tick.type = 'checkbox';
      tick.checked = !item.gateway; // a gateway's payee has no name yet: it is selected once one is typed
      tick.setAttribute('aria-label', item.gateway ? 'Add the payee of this payment' : item.action === 'add' ? `Add ${item.name}` : `Add the UPI ID to ${item.partyName}`);
      tick.addEventListener('change', syncSave);
      const name = el('input');
      name.value = item.name;
      name.maxLength = 120;
      name.setAttribute('aria-label', item.gateway ? 'Who this payment was for' : 'Name');
      if (item.gateway) {
        name.placeholder = 'Who was this payment for?';
        name.addEventListener('input', () => {
          tick.checked = name.value.trim().length >= 2;
          syncSave();
        });
      }
      const kind = el('select');
      for (const [value, label] of PARTY_KINDS_SHOWN) kind.append(Object.assign(el('option', undefined, label), { value }));
      kind.value = item.kind;
      kind.setAttribute('aria-label', 'What kind of party');
      // A UPI ID can be left off: for an ID that is not really this person's.
      let attach: HTMLInputElement | null = null;
      if (item.hasId) {
        attach = el('input');
        attach.type = 'checkbox';
        attach.checked = true;
      }
      return { item, tick, name, kind, attach };
    });
    $('party-list').replaceChildren(
      ...reviewing.map((r) => {
        const row = el('div', 'party-row');
        const meta = el('span', 'dim party-meta', r.item.gateway ? 'One payment, through a payment gateway' : plural(r.item.payments, 'payment'));
        if (r.item.action === 'add') row.append(r.tick, r.name, r.kind);
        else row.append(r.tick, el('span', 'party-what', `Add ${r.item.idShown ? `UPI ID ${r.item.idShown}` : 'the UPI ID'} to ${r.item.partyName}`));
        row.append(meta);
        if (r.attach) {
          const label = el('label', 'party-attach');
          label.append(r.attach, el('span', undefined, `Attach their UPI ID${r.item.idShown ? ` (${r.item.idShown})` : ''}`));
          row.append(label);
        }
        return row;
      }),
    );
    syncSave();
    $('party-error').hidden = true;
    partyDialog.showModal();
  }
  $('party-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const chosen = reviewing.filter((r) => r.tick.checked);
    const err = $('party-error');
    if (!chosen.length) {
      err.textContent = 'Select at least one, or cancel.';
      err.hidden = false;
      return;
    }
    if (chosen.some((r) => r.item.gateway && r.name.value.trim().length < 2)) {
      err.textContent = 'Type who each payment through a payment gateway was for, or deselect it.';
      err.hidden = false;
      return;
    }
    saveButton.disabled = true;
    try {
      const items = chosen.map((r) => ({ rowId: r.item.rowId, ...(r.item.action === 'add' ? { name: r.name.value, kind: r.kind.value, ...(r.attach && !r.attach.checked ? { attachId: false } : {}) } : {}) }));
      const { status, data: res } = await staffFetch('/api/finance-admin/upi-lines/add-parties', { method: 'POST', body: { items } });
      if (status !== 200) throw new Error(res?.error ?? 'failed');
      partyDialog.close();
      const parts = [res.added ? `${res.added} added to Parties` : '', res.attached ? `${res.attached} UPI ID${res.attached === 1 ? '' : 's'} added to a party` : '', res.skipped ? `${res.skipped} skipped (${(res.reasons ?? []).join(' ')})` : ''].filter(Boolean);
      showToast(`${parts.join(', ')}.`);
      await load();
    } catch (e) {
      if (fail(e)) return;
      err.textContent = e instanceof Error && e.message !== 'failed' ? e.message : 'Could not add them. Nothing was changed.';
      err.hidden = false;
    } finally {
      syncSave();
    }
  });

  const monthOf = (u: Upi) => u.paidAt.slice(0, 7);
  const needsDelegate = (u: Upi) => u.delegateHow === 'ambiguous' || u.delegateHow === 'none';
  const table = createDataTable({
    root: $('upi-table'),
    rowId: (u: Upi) => u.id,
    noun: ['payment', 'payments'],
    cap: 500,
    rowKind: (u: Upi) => kindClass(amountKind(u.direction)),
    searchPlaceholder: 'Search who, remark, reference, account…',
    favoritesKey: `tvc-upi-favorites:${decodeTokenEmail(getToken() ?? '')}`,
    layoutKey: `tvc-upi-columns:${decodeTokenEmail(getToken() ?? '')}`,
    defaultGroup: 'month',
    defaultSort: ['date', -1],
    searchText: (u: Upi) => [u.counterparty, u.vpaName ?? '', u.party.partyName ?? '', u.upiId ?? '', u.remark, u.purpose ?? '', u.note, u.upiRef, u.account ?? '', u.delegate ?? ''].join(' '),
    toolbarEnd: toolbarTools,
    empty: { title: 'No UPI payments yet', text: 'Add the BHIM history or the Paytm export on the Import page.' },
    columns: [
      { id: 'date', label: 'Date', type: 'date', value: (u: Upi) => u.paidAt, sortValue: (u: Upi) => `${u.paidAt} ${u.time ?? ''}`, render: (u: Upi) => `${day(u.paidAt)}${u.time ? ` ${u.time}` : ''}` },
      { id: 'counterparty', label: 'Paid to', value: (u: Upi) => u.counterparty ?? 'Unnamed payee' },
      // Name: the registered name Razorpay gave for the UPI ID in "Paid to" when it has been looked up, else the name the app showed; a UPI ID
      // not looked up yet says so. Derived on the server, never stored on the (locked) UPI row; the ledger suggestion reads the same answers.
      { id: 'name', label: 'Name', value: (u: Upi) => nameText(u), render: (u: Upi) => nameCell(u) },
      // Party: whether this person is in the Parties register. Matched by the UPI ID first (a party holding it), the name only checking it; a
      // name that does not fit is flagged, and anyone nobody matches can be added from the toolbar (a reviewed add).
      { id: 'party', label: 'Party', value: (u: Upi) => partyText(u), render: (u: Upi) => partyCell(u) },
      // UPI ID: the ID found in "Paid to", masked (p••••@bank) unless the person may see payee bank details. Hidden until turned on in Columns.
      { id: 'upiId', label: 'UPI ID', hiddenByDefault: true, value: (u: Upi) => u.upiId ?? '', render: (u: Upi) => (u.upiId ? u.upiId : el('span', 'dim', 'None')) },
      // The sign and colour say debit or credit (the Debits and Credits chips still filter); a credit also gets a stripe down its row.
      { id: 'amount', label: 'Amount', type: 'amount', align: 'end', value: (u: Upi) => u.amountPaise, signOf: (u: Upi) => (u.direction === 'credit' ? 1 : -1), render: (u: Upi) => moneyNode(u.amountPaise, amountKind(u.direction)) },
      { id: 'app', label: 'App', value: (u: Upi) => APP[u.app] },
      { id: 'paidBy', label: 'Paid by', value: (u: Upi) => paidByText(u), render: (u: Upi) => paidByCell(u) },
      { id: 'account', label: 'Account', value: (u: Upi) => u.account ?? '', render: (u: Upi) => (u.account ? u.account : el('span', 'dim', 'Not known yet')) },
      { id: 'note', label: 'Note', value: (u: Upi) => u.note ?? u.purpose ?? u.remark ?? '', render: (u: Upi) => noteCell(u) },
      { id: 'state', label: 'Bank statement', value: (u: Upi) => STATE[u.state].text, render: (u: Upi) => el('span', `pill pill--${STATE[u.state].kind}`, STATE[u.state].text) },
      // Ledger: a payment joined to a bank line shows that bank's icon, a button that opens a popup about the ledger line (and a link to it). The same
      // cross-reference as the party's name. Filtering and search still use the reference number, which the next column shows plainly.
      { id: 'ref', label: 'Ledger', value: (u: Upi) => u.upiRef, render: (u: Upi) => (u.ledger ? bankIcon(u) : el('span', 'dim', '–')) },
      { id: 'refNo', label: 'Reference', hiddenByDefault: true, value: (u: Upi) => u.upiRef },
    ],
    // Chips of one group are alternatives (BHIM or Paytm); different groups all have to hold.
    filters: [
      { id: 'bhim', group: 'app', label: 'BHIM', test: (u: Upi) => u.app === 'bhim' },
      { id: 'paytm', group: 'app', label: 'Paytm', test: (u: Upi) => u.app === 'paytm' },
      { id: 'debit', group: 'dir', label: 'Debits', test: (u: Upi) => u.direction === 'debit' },
      { id: 'credit', group: 'dir', label: 'Credits', test: (u: Upi) => u.direction === 'credit' },
      { id: 'direct', group: 'by', label: 'Paid directly', test: (u: Upi) => !u.isCircle },
      { id: 'delegate', group: 'by', label: 'Paid by a delegate', test: (u: Upi) => u.isCircle },
      { id: 'needs', group: 'by', label: 'Needs a delegate', test: needsDelegate },
      { id: 'matched', group: 'state', label: 'In the ledger', test: (u: Upi) => u.state === 'matched' },
      { id: 'waiting', group: 'state', label: 'Waiting for statement', test: (u: Upi) => u.state === 'waiting' },
      { id: 'unmatched', group: 'state', label: 'Not in the statement', test: (u: Upi) => u.state === 'unmatched' },
      { id: 'p-missing', group: 'party', label: 'Not in Parties', test: (u: Upi) => u.party.state === 'missing' },
      { id: 'p-differs', group: 'party', label: 'Name differs', test: (u: Upi) => u.party.state === 'differs' },
      { id: 'p-attach', group: 'party', label: 'ID not on file', test: (u: Upi) => u.party.state === 'attach' },
      { id: 'p-gateway', group: 'party', label: 'Payment gateway', test: (u: Upi) => u.party.state === 'gateway' },
      { id: 'p-in', group: 'party', label: 'In Parties', test: (u: Upi) => u.party.state === 'matches' || u.party.state === 'onfile' },
    ],
    groups: [
      { id: 'month', label: 'Month', key: monthOf, descending: true, format: monthName },
      { id: 'app', label: 'App', key: (u: Upi) => APP[u.app] },
      { id: 'paidBy', label: 'Paid by', key: (u: Upi) => (u.isCircle ? 'Delegate' : 'Direct') },
      { id: 'account', label: 'Account', key: (u: Upi) => u.account ?? 'No account yet' },
      { id: 'state', label: 'Bank statement', key: (u: Upi) => STATE[u.state].text },
      { id: 'party', label: 'Party', key: (u: Upi) => partyText(u) },
    ],
    card: (u: Upi) => {
      const c = el('div', 'upi-card');
      const top = el('div', 'upi-card-top');
      top.append(el('span', 'title', (u.party.state === 'gateway' ? null : u.vpaName) ?? u.counterparty ?? 'Unnamed payee'), moneyNode(u.amountPaise, amountKind(u.direction)));
      c.append(top, el('div', 'sub', `${day(u.paidAt)}${u.time ? ` ${u.time}` : ''} · ${APP[u.app]} · ${paidByText(u)}`), el('span', `pill pill--${STATE[u.state].kind}`, STATE[u.state].text));
      const note = u.note ?? u.purpose ?? u.remark;
      if (note) c.append(el('div', 'sub', note));
      // The same next step as the table row, so a phone can do it too: the party's name as a link, or Add; Look up for an ID not looked up yet.
      const next = el('div', 'upi-card-next');
      const pc = partyCell(u);
      if (typeof pc !== 'string') next.append(pc);
      if (u.ledger) next.append(bankIcon(u));
      if (u.party.state === 'lookup') {
        const n = nameCell(u);
        if (typeof n !== 'string') next.append(n);
      }
      if (next.childNodes.length) c.append(next);
      return c;
    },
  });
  let refApplied = false;

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    showLoading(statusEl);
    try {
      const { status, data } = await staffFetch('/api/finance-admin/upi-lines');
      if (status !== 200) throw new Error('load failed');
      clearState(statusEl);
      intro.hidden = false;
      intro.textContent = data.lines.length
        ? `${plural(data.lines.length, 'UPI payment')} from the BHIM history and the Paytm export, set against the bank statement${data.lastBankDate ? ` held to ${day(data.lastBankDate)}` : ''}. Add files on the Import page.`
        : 'No UPI payments yet. Add the BHIM history or the Paytm export on the Import page.';
      all = data.lines;
      canEdit = Boolean(data.canEdit);
      canConfigure = Boolean(data.canConfigure);
      delegates = data.delegates ?? [];
      operators = data.operators ?? [];
      badges = data.badges ?? {};
      defaultCapPaise = data.capPaise;
      renderMonths(data);
      renderOperators();
      renderDelegates(data);
      table.setRows(all);
      renderLookUp();
      renderAddParties();
      if (!refApplied) {
        refApplied = true;
        if (askedRef) table.setText(askedRef);
      }
      content.hidden = false;
    } catch (err) {
      if (fail(err)) return;
      console.error('[upi] load failed', err);
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the UPI payments", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: load });
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }

  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  if (getToken()) load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
