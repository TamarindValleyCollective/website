    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-height: min(70vh, 540px);
    overflow-y: auto;
    padding: 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    box-shadow: var(--shadow-soft);
  }

  .ledger .spop[hidden] {
    display: none;
  }

  .ledger .spop h3 {
    margin: 0 0 6px;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .ledger .spop h4 {
    margin: 10px 0 2px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .ledger .spop .hint {
    margin: 6px 6px 0;
    font-size: var(--text-sm);
  }

  .ledger .sopt {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 34px;
    padding: 4px 6px;
    border-radius: 7px;
    font-size: var(--text-sm);
  }

  .ledger .sopt:hover {
    background: var(--tvc-cream);
  }

  .ledger .sopt-tick {
    flex: none;
    width: 16px;
    color: var(--tvc-green-dark);
    font-weight: 700;
  }

  .ledger .sopt-extra {
    margin-left: auto;
    color: var(--tvc-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .ledger .sfav {
    display: flex;
    align-items: center;
  }

  .ledger .sfav .sopt {
    flex: 1;
  }

  .ledger .sopt-del {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    text-align: center;
    line-height: 32px;
    border-radius: 6px;
    color: var(--tvc-ink-soft);
  }

  .ledger .sopt-del:hover {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .ledger .ssave {
    display: flex;
    gap: 6px;
    margin-top: 10px;
  }

  .ledger .ssave input {
    flex: 1;
    min-width: 0;
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 8px;
  }

  /* A group heading in the list. Same absolute placement as a line. */
  .ledger .lgroup {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--tvc-line);
    background: var(--tvc-cream);
  }

  .ledger .lgroup--2 {
    background: var(--tvc-white);
  }

  .ledger .ggroup-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 6px 14px;
    font-weight: 650;
  }

  .ledger .lgroup--2 .ggroup-btn {
    padding-left: 34px;
    font-weight: 600;
  }

  .ledger .ggroup-tri {
    flex: none;
    width: 14px;
    transition: transform 0.15s;
  }

  .ledger .lgroup.is-open .ggroup-tri {
    transform: rotate(90deg);
  }

  .ledger .ggroup-count {
    color: var(--tvc-ink-soft);
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .ledger .ggroup-net {
    margin-left: auto;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger .ggroup-tri {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .ledger .spop {
      grid-template-columns: 1fr;
    }
  }

  .ledger .twostep {
    margin: 0 0 10px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .ledger .progress {
    margin: 0 0 10px;
    color: var(--tvc-ink-soft);
    font-size: var(--text-sm);
    min-height: 1.4em;
  }

  .ledger .grid {
    overflow-x: auto;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
  }

  /* Working: the table dims and a bar runs along its top while the lines are fetched. */
  .ledger .grid {
    position: relative;
  }

  .ledger .grid.is-loading .gscroll {
    opacity: 0.5;
    pointer-events: none;
  }

  .ledger .grid.is-loading::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    height: 3px;
    width: 40%;
    background: var(--tvc-green);
    animation: ledger-slide 1.1s ease-in-out infinite;
  }

  @keyframes ledger-slide {
    from {
      left: -40%;
    }

    to {
      left: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger .grid.is-loading::before {
      animation: none;
      width: 100%;
    }
  }

  .ledger input:focus-visible,
  .ledger select:focus-visible,
  .abar input:focus-visible,
  .abar select:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .tips {
    margin: 0 0 12px;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-surface);
    font-size: var(--text-sm);
  }

  .ledger .tips p {
    margin: 0 0 6px;
  }

  .ledger .tips .tips-title {
    margin: 0 0 6px;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .ledger .tips .tips-tree {
    margin: 0 0 8px;
  }

  .ledger .tips .tips-tree ul {
    margin: 2px 0 6px;
  }

  .ledger .tips ul {
    margin: 0;
    padding-left: 1.2em;
  }

  .ledger .tips code {
    font-size: inherit;
    padding: 1px 4px;
    border-radius: 4px;
    background: var(--tvc-line);
  }

  .ledger .tips[hidden] {
    display: none;
  }

  .ledger .skiplink {
    position: absolute;
    left: -9999px;
    top: 0;
  }

  .ledger .skiplink:focus {
    position: static;
    display: inline-block;
    margin: 0 0 8px;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--tvc-surface);
    border: 1px solid var(--tvc-line-strong);
  }

  .ledger .list-title {
    margin: 26px 0 8px 14px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .ledger.section dialog.sheet {
    width: min(620px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }

  .ledger.section dialog.sheet .sheet-actions {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .ledger .sheet .hint,
  .ledger .sheet .note {
    margin: 10px 0;
    font-size: var(--text-sm);
  }


  .ledger .suggest-note {
    margin: 10px 0;
  }

  .ledger .suggest-note .field-label {
    margin: 0 0 4px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .ledger .why {
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .ledger .new-party {
    padding: 10px 12px;
    border: 1px dashed var(--tvc-line-strong);
    border-radius: var(--radius-sm);
  }

  .ledger .alloc-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* A fieldset will not shrink below its widest child, and a select is as wide as its longest option ("Refund of" has long ones), which
     pushed the whole sheet wider than a phone. Let them shrink; the select shows its text cut off. */
  .ledger .alloc-edit {
    min-width: 0;
  }

  .ledger .alloc-edit label,
  .ledger .alloc-edit .stack-form,
  .ledger .alloc-edit select,
  .ledger .alloc-edit input {
    min-width: 0;
    max-width: 100%;
  }

  .ledger .alloc-edit {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .ledger .alloc-edit .alloc-top.stack-form {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px;
  }

  .ledger .alloc-edit .alloc-top.stack-form > label {
    flex: 1 1 9rem;
  }

  .ledger .more summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 4px 0;
  }

  .ledger .more > .stack-form {
    margin-top: 8px;
  }

  .ledger .editor-tools {
    margin: 12px 0 0;
  }

  .ledger .remaining {
    margin: 12px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ledger .remaining--ok {
    color: var(--tvc-green);
  }

  .ledger .remaining--over {
    color: var(--tvc-error-text);
  }

  @media (max-width: 560px) {
    .ledger.section dialog.sheet .sheet-actions .button {
      flex: 1 1 auto;
    }
  }

  .ledger .sortpick {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
  }

  .ledger .sortpick select {
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    padding: 4px 8px;
  }

  .ledger .postnote {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 10px;
    padding: 10px 14px;
    border: 1px solid var(--tvc-error-border);
    border-radius: var(--radius);
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .ledger .applyprompt {
    border-color: var(--tvc-line-strong);
    background: var(--tvc-surface);
    color: var(--tvc-ink);
  }

  .ledger .postnote[hidden] {
    display: none;
  }

  .ledger .colfilter[aria-invalid='true'] {
    border-color: var(--tvc-error-border);
  }

  .ledger .ghead,
  .ledger .gfilter,
  .ledger .lrow {
    display: grid;
    grid-template-columns: 34px 76px 112px minmax(170px, 1fr) minmax(170px, 1fr) 124px;
    align-items: center;
    gap: 10px;
    padding: 4px 14px;
  }

  .ledger .ghead,
  .ledger .gfilter,
  .ledger .gscroll {
    min-width: 920px;
  }

  .ledger .ghead {
    background: var(--tvc-surface);
    border-bottom: 1px solid var(--tvc-line);
    font-weight: 650;
    font-size: var(--text-sm);
  }

  .ledger .gfilter {
    border-bottom: 1px solid var(--tvc-line);
  }

  .ledger .sorthead {
    all: unset;
    cursor: pointer;
    font-weight: 650;
    padding: 6px 2px;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  .ledger .sorthead:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .colfilter,
  .ledger .cellfield {
    width: 100%;
    min-height: 36px;
    box-sizing: border-box;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 8px;
  }

  .ledger .cellfield.ghost,
  .ledger .cellfield.ghost::placeholder {
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .ledger .gscroll {
    position: relative;
    height: min(62vh, 760px);
    min-height: 320px;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .ledger .gspacer {
    position: relative;
    width: 100%;
  }

  .ledger .lrow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--tvc-line);
    background: var(--tvc-white);
  }

  .ledger .lrow.is-selected {
    background: var(--tvc-green-tint);
  }

  .ledger .pill-button { all: unset; cursor: pointer; border-radius: 999px; }
  .ledger .pill-button:focus-visible { outline: 2px solid var(--tvc-green); outline-offset: 2px; }
  .ledger .lrow.is-locked {
    color: var(--tvc-ink-soft);
  }

  .ledger .lrow input[type='checkbox'],
  .ledger .ghead input[type='checkbox'] {
    width: 24px;
    height: 24px;
  }

  main .ledger.section .select-all-btn {
    display: none;
  }

  .ledger .gcell {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ledger .gcell--narration {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .ledger .narr {
    all: unset;
    cursor: pointer;
    font-weight: 500;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
    overflow-wrap: anywhere;
    min-height: 24px;
    color: var(--tvc-ink);
  }

  .ledger .narr:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .detail {
    display: block;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ledger .detail--upi,
  .ledger .detail--unit {
    color: var(--tvc-ink);
  }

  .ledger .detail--unit,
  .ledger .detail--wrap {
    white-space: normal;
  }

  .ledger .detail--dim {
    font-style: italic;
  }

  .ledger .detail--warn,
  .ledger .noparty {
    color: var(--tvc-error-text);
  }

  .ledger .noparty {
    font-weight: 600;
  }

  .ledger .gcell--amount {
    justify-content: flex-end;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ledger .amount--credit {
    color: var(--tvc-green-dark);
  }

  .ledger .gcell--category,
  .ledger .gcell--party,
  .ledger .gcell--nature {
    flex-wrap: wrap;
  }

  /* A line at rest is plain text. Its fields appear when it is ticked, opened or has a problem to show. */
  .ledger .lrow {
    min-height: 44px;
  }

  .ledger .lrow:hover {
    background: var(--tvc-cream);
  }

  .ledger .lrow.is-active {
    background: var(--tvc-cream);
    padding-block: 8px;
  }

  .ledger .lrow.is-selected {
    background: var(--tvc-green-tint);
  }

  .ledger .gcell--nature {
    grid-column: 2 / -1;
  }

  /* The narration is a reference: not a column unless asked for, shown full width under the fields when a line is open. */
  .ledger.show-narr .ghead,
  .ledger.show-narr .gfilter,
  .ledger.show-narr .lrow {
    grid-template-columns: 34px 76px 112px minmax(150px, 1fr) minmax(150px, 1fr) 124px minmax(200px, 1.4fr);
  }

  .ledger:not(.show-narr) .gcell--narration {
    display: none;
  }

  .ledger:not(.show-narr) .lrow.is-active .gcell--narration {
    display: flex;
    grid-column: 2 / -1;
    color: var(--tvc-ink-soft);
  }

  .ledger:not(.show-narr) .lrow.is-active .narr {
    -webkit-line-clamp: 3;
    line-clamp: 3;
    color: var(--tvc-ink-soft);
  }

  .ledger .gcell--narration .narr {
    color: var(--tvc-ink-soft);
  }

  .ltip {
    position: fixed;
    z-index: 15;
    max-width: min(460px, calc(100vw - 16px));
    padding: 8px 12px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    color: var(--tvc-ink);
    box-shadow: var(--shadow-soft);
    font-size: var(--text-sm);
    pointer-events: none;
  }

  .ltip[hidden] {
    display: none;
  }

  .ltip p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .ltip .ltip-sub {
    margin-top: 4px;
    color: var(--tvc-ink-soft);
  }

  .ledger .datebtn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  .ledger .datebtn:hover {
    text-decoration: underline;
    text-decoration-color: var(--tvc-line-strong);
  }

  .ledger .datebtn:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .colmenu-wrap {
    position: relative;
    display: inline-block;
  }

  .ledger .colmenu {
    position: absolute;
    z-index: 30;
    right: 0;
    top: calc(100% + 4px);
    min-width: 200px;
    padding: 6px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    box-shadow: var(--shadow-soft);
  }

  .ledger .colmenu[hidden] {
    display: none;
  }

  .ledger .gcell--meta {
    display: none;
  }

  .ledger .peek {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: block;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 0;
  }

  .ledger .peek[hidden] {
    display: none;
  }

  .ledger .peek.ghost {
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .ledger .peek:hover {
    text-decoration: underline;
    text-decoration-color: var(--tvc-line-strong);
  }

  .ledger .peek:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .lrow:not(.is-active) .detail--upi,
  .ledger .lrow:not(.is-active) .detail--dim {
    display: none;
  }

  .ledger:not(.show-colsearch) .gfilter {
    display: none;
  }

  .ledger .lcell-text {
    display: block;
    min-width: 0;
  }

  .ledger .tick {
    all: unset;
    cursor: pointer;
    flex: none;
    width: 32px;
    height: 32px;
    box-sizing: border-box;
    text-align: center;
    line-height: 30px;
    border: 1px solid var(--tvc-green);
    border-radius: 6px;
    color: var(--tvc-green-dark);
    font-weight: 700;
  }

  .ledger .tick[hidden] {
    display: none;
  }

  .ledger .tick:hover {
    background: var(--tvc-green-tint);
  }

  .ledger .tick:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .gcell--category .cellfield,
  .ledger .gcell--party .cellfield,
  .ledger .gcell--nature .cellfield,
  .ledger .gcell--category .combo,
  .ledger .gcell--party .combo {
    flex: 1 1 0;
    min-width: 0;
    width: auto;
  }

  .ledger .lrow .combo-input {
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 26px 4px 8px;
  }

  .ledger .combo.ghost .combo-input::placeholder {
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .abar .combo {
    width: 200px;
  }

  .abar .combo .combo-input {
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 26px 4px 8px;
  }

  /* The note under a maintenance line's category that still needs its year and unit. */
  .ledger .follow-hint {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .ledger .follow-hint--warn {
    color: var(--tvc-orange-text);
  }

  .ledger .follow-hint[hidden] {
    display: none;
  }

  /* The bar for selected lines: docked, in the same theme as the page, and it says why Post is off. */
  .abar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--tvc-surface);
    border-top: 1px solid var(--tvc-line-strong);
  }

  .abar[hidden] {
    display: none;
  }

  .abar .abar-count {
    font-weight: 650;
  }

  .abar .abar-why {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .abar select,
  .abar input[type='text'] {
    min-height: 36px;
    max-width: 200px;
