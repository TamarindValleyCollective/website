---
// Finance (internal): the ledger. Backed by netlify/functions/finance-admin.mts (lib/finance-ledger.ts). Bank lines come first, the ones
// nothing explains yet at the top; each is given a category, a party (the person or organisation on the other side), and what it was for.
//
// Built on TanStack Table (column, sort and selection state) and TanStack Virtual (only the rows on screen exist in the page). Every line
// comes down once (GET /api/finance-admin/ledger/all) and search, sort and the chips run in the browser, so they are instant. Edits change
// one cell, never the row; typed-but-unposted work is kept in this browser; a bulk change can be undone (toast or Ctrl+Z); posting is a
// separate, confirmed step. Below 1,240px the table is a list of cards. Opening a narration shows the line's sheet: split into rows, refund,
// maintenance unit and year, add a party, review decisions. Months, with Close month, are under the table.
//
// Same shell as the other internal tools: Google Sign-In gated, unlinked from the public site, noindex. Everything the server returns is
// placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import '../../../styles/linked-picker.css';
import SignInGate from '../../../components/SignInGate.astro';
---

<StaffLayout title="Finance ledger" description="Finance ledger." current="finance" currentPage="finance-ledger">
  <section class="ledger section wrapper">
    <h1>Ledger</h1>
    <p id="intro" class="hint">Sign in to open the ledger.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <div class="lbar">
        <div class="lsearch">
          <div class="sbox" id="sbox">
            <span class="sbox-chips" id="schips"></span>
            <input id="q" type="search" placeholder="Search every column" aria-label="Search every column. Press Enter to keep it as a chip." autocomplete="off" />
            <button type="button" id="sopen" class="sbox-caret" aria-expanded="false" aria-controls="spop" aria-label="Filters, group by and favorites">▾</button>
          </div>
          <div id="spop" class="spop" hidden></div>
        </div>
        <label class="sortpick">
          <span>Sort</span>
          <select id="sortpick" aria-label="Sort the lines">
            <option value="date:desc">Newest first</option>
            <option value="date:asc">Oldest first</option>
            <option value="amount:desc">Largest first</option>
            <option value="amount:asc">Smallest first</option>
            <option value="narration:asc">Narration A to Z</option>
            <option value="category:asc">Category</option>
            <option value="party:asc">Party</option>
          </select>
        </label>
        <button type="button" id="more-tools" class="button button--outline button--small more-tools" aria-expanded="false">More</button>
        <button type="button" id="select-all-btn" class="button button--outline button--small select-all-btn" hidden>Select all</button>
        <span class="colmenu-wrap">
          <button type="button" id="cols-toggle" class="button button--outline button--small" aria-expanded="false" aria-controls="colmenu">Columns</button>
          <div id="colmenu" class="colmenu" hidden></div>
        </span>
        <button type="button" id="colsearch-toggle" class="button button--outline button--small colsearch-toggle" aria-expanded="false">Column search</button>
        <button type="button" id="tips-toggle" class="button button--outline button--small" aria-expanded="false" aria-controls="tips">Help and shortcuts</button>
        <button type="button" id="accept-all" class="button button--outline" hidden>Fill in the confident suggestions</button>
      </div>
      <div id="tips" class="tips" hidden>
        <h3 class="tips-title">How a line is described</h3>
        <p>Every bank line gets four answers. Each answer has a level above it, and the level above narrows the list below it.</p>
        <ul class="tips-tree">
          <li><strong>What it was.</strong> Category group (Member money, Running costs, Capital purchases, Income…), then the <strong>category</strong>.
            <ul>
              <li>The category field opens one level at a time. A row marked <strong>⟹</strong> opens the next level (Maintenance ⟹ the year ⟹ the unit), the levels above stay on screen, and typing searches only the rows you can see.</li>
              <li>Maintenance is decided in this order: the <strong>maintenance year</strong> (the payment date's year is listed first: pick another when someone pays another year's), then <strong>which unit's maintenance</strong> it is. The unit is required: a maintenance line is not ready without it. Units can be found by the names of the people living in them.</li>
              <li>A capital purchase (Plantation, Nursery…) can also be given a <strong>project</strong>.</li>
            </ul>
          </li>
          <li><strong>Who was on the other side.</strong> Kind of party (Member, Vendor, Employee…), then the <strong>party</strong>.
            <ul>
              <li>The party field works the same way: the kind (Members, Vendors, Employees… or <em>All parties</em>), then the party. After the category it opens on the kind that goes with it: vendors for running costs, government for taxes. Go back up to the top to see every kind.</li>
              <li><strong>Maintenance can be paid by anybody</strong>: a member, a relative, a company paying for a unit. So the unit says whose maintenance it is, and the payer is chosen after it. The party list opens on the people living in the chosen unit. If the payer is a member, their own unit is listed first in the unit list (marked "the payer's unit"): it is offered, never filled in for you.</li>
            </ul>
          </li>
          <li><strong>What it was for</strong>, in your own words.</li>
          <li><strong>The bank's narration</strong> is the evidence, not an answer. Hover a line to read it, open the line to see it under the fields, click the date for the full line, or switch on <em>Columns → Bank narration</em>.</li>
        </ul>
        <p>Members come from the member records: everyone in a unit already has a party, and a person added to a unit gets one automatically, so a member is never added here by typing a name. Someone who leaves becomes a <strong>former member</strong>. Their old payments stay under their name and unit.</p>
        <p><strong>Keyboard:</strong> <code>Ctrl+Enter</code> on a line accepts its suggestions and moves to the next · <code>Alt+Up</code> / <code>Alt+Down</code> go to the same cell on the line above or below · <code>Tab</code> walks every line · <code>Shift</code>-click a tick box for a range · <code>Ctrl+Z</code> undoes the last bulk change (for two minutes).</p>
        <p>The box above looks in every column. Under a heading you can be exact:</p>
        <ul>
          <li><strong>Words</strong> (narration, category, party, wording): <code>fuel</code> contains · <code>=Fuel</code> exactly · <code>!=Bank charges</code> is not · <code>^UPI</code> starts with · <code>!tax</code> does not contain · <code>=</code> is empty · <code>!=</code> is not empty</li>
          <li><strong>Amount</strong> (rupees): <code>2500</code> · <code>&gt;1000</code> · <code>&lt;=500</code> · <code>1000..3000</code> · <code>!=295</code></li>
          <li><strong>Date</strong>: <code>2026-10</code> · <code>oct</code> · <code>&gt;2026-10-15</code> · <code>2026-10-01..2026-10-31</code></li>
        </ul>
      </div>
      <div id="postnote" class="postnote" role="alert" hidden></div>
      <div id="applyprompt" class="postnote applyprompt" role="status" hidden></div>
      <p id="progress" class="progress"></p>
      <span id="announce" class="visually-hidden" role="status"></span>
      <span id="selcount" class="visually-hidden" role="status"></span>
      <p class="hint twostep">A tick only fills a field in. Nothing is saved until you tick the lines and press <strong>Post</strong>.</p>
      <div id="restorenote" class="postnote applyprompt" hidden></div>
      <div id="draftnote" class="postnote applyprompt" role="status" hidden></div>
      <div id="monthstrip" class="postnote applyprompt" role="status" hidden></div>

      <a class="skiplink" href="#months-title">Skip the table</a>
      <div class="grid" id="grid" role="table" aria-label="Bank lines" aria-colcount="7">
        <div class="ghead" id="ghead" role="row" aria-rowindex="1"></div>
        <div class="gfilter" id="gfilter" role="row" aria-rowindex="2" aria-label="Column searches"></div>
        <div class="gscroll" id="gscroll">
          <div class="gspacer" id="gspacer" role="rowgroup"></div>
        </div>
      </div>
      <div id="empty" class="hint" aria-live="polite" hidden></div>
      <h2 class="list-title" id="months-title" tabindex="-1">Months</h2>
      <ul class="list" id="months"></ul>
      <p class="hint">Click a heading to sort, type under one to search that column; click a narration to split the line, refund it, or see its history. Tab moves through the cells; Alt+Up and Alt+Down go to the same cell on the line above or below; Ctrl+Enter on a line accepts its suggestions and moves to the next.</p>
    </div>
    <div id="ltip" class="ltip" role="tooltip" hidden></div>
    <div id="actionbar" class="abar" role="region" aria-label="Selected lines" hidden></div>
    <dialog id="party-sheet" class="sheet" aria-labelledby="party-title"></dialog>
    <dialog id="line-sheet" class="sheet" aria-labelledby="line-title"></dialog>
  </section>
</StaffLayout>

<script>
  import { createTable, getCoreRowModel } from '@tanstack/table-core';
  import { Virtualizer, elementScroll, observeElementOffset, observeElementRect } from '@tanstack/virtual-core';
  import { StaffAuthError, askSheet, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';
  import { linkedPicker } from '../../../../scripts/lib/linked-picker.mjs';
  import { categoryNodes, categoryPath, partyNodes, partyPath, partyStart, readCategoryPath } from '../../../../scripts/lib/finance-picker-nodes.mjs';
  import { button, categoryOptions, combo, h, input, labelled, niceDate, niceMonth, parseRupees, partyOptions, pill, present, rupees, unitOptions } from '../../../../scripts/lib/finance-ui.mjs';
  import { GROUP_FIELDS, buildItems, defaultUnitFor, financialYearOf, groupLabel, matchOptions, kindLabel, kindsInOrder, optionCounts, optionKeys, optionLabel, passesChips, passesWords, readFavorites, withFavorite } from '../../../../scripts/lib/finance-search.mjs';
  import { compareRows, describeCondition, matchAmount, matchDate, matchText, parseAmount, parseDate, parseText } from '../../../../scripts/lib/finance-columns.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  type Suggestion = { categoryId: string | null; partyId: string | null; nature: string; confidence: string; newPartyName: string | null };
  type Line = {
    id: string; date: string; narration: string; direction: 'debit' | 'credit'; amountPaise: number; account: string; remark: string | null; counterparty: string | null;
    allocatedPaise: number; state: 'unallocated' | 'partly_allocated' | 'allocated'; review: boolean; missingParty: boolean; suggestion: Suggestion | null;
    allocation: { categoryId: string; partyId: string | null; nature: string; count: number; householdLabel: string | null; maintenanceYear: string | null } | null;
    hay?: string; // lower-case text the search box looks in, worked out once
    effective: { category: string; party: string; nature: string }; // what it was posted to, or is suggested: what the column searches read
  };
  type Category = { id: string; name: string; type: string; active: boolean };
  type Party = { id: string; name: string; kind: string; household_id?: string | null; former_since?: string | null };
  type Project = { id: string; name: string; kind: string; financial_year: number; status: string };
  type Lookups = { categories: Category[]; parties: Party[]; projects: Project[]; requesterPartyId: string | null; closedMonths: string[]; households: { id: string; label: string; people?: string[] }[] };
  type Filter = 'unallocated' | 'review' | 'noparty' | 'all';
  type ListData = { canAllocate: boolean; lines: Line[]; lookups: Lookups };
  type Field = 'categoryId' | 'partyId' | 'nature';
  // Members come from the member records: while the list is limited to members, it says so instead of offering to add one.
  // Members come from the member records: inside "Members" the party list says so instead of offering to add one.
  const NO_MEMBER_ADD = 'Members come from the member records. Add a new member in the member portal, and they appear here.';
  type ComboEl = HTMLElement & { value: string; path: string[]; input: HTMLInputElement; setNodes(list: any[]): void; setStartAt(fn: (() => string[] | null) | null): void; setBlank(text: string): void; setPlaceholder(text: string | null): void; setOptions(list: { value: string; label: string; group?: string }[]): void };
  type Draft = Record<Field, string>;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');
  const scrollEl = $('gscroll');
  const spacer = $('gspacer');

  let data: ListData | null = null;
  let all: Line[] = []; // every bank line, fetched once
  let byId = new Map<string, Line>();
  let lines: Line[] = []; // the ones the chips, search and column conditions leave and that are showing (not inside a closed group), in order
  let counts: Record<Filter, number> = { unallocated: 0, review: 0, noparty: 0, all: 0 };
  let filterErrors: Record<string, string> = {};
  // The address can name the chip to open on (the Overview links to ?filter=review).
  const startFilter = new URLSearchParams(location.search).get('filter');
  let chips: [string, string][] = startFilter === 'all' ? [] : [['status', ['unallocated', 'review', 'noparty'].includes(startFilter ?? '') ? startFilter! : 'unallocated']];
  let words: string[] = []; // word chips kept with Enter
  let query = ''; // what is being typed right now; it filters live
  let groupBy: string[] = [];
  const collapsed = new Set<string>();
  type Item = { kind: 'line'; line: Line } | { kind: 'group'; key: string; depth: number; field: string; label: string; count: number; netPaise: number; open: boolean };
  let items: Item[] = []; // what the list shows: group headings and the lines of the groups that are open
  let itemIndexOfLine = new Map<string, number>();
  let matched = 0; // lines the search leaves, including those inside collapsed groups
  const today = () => new Date().toISOString().slice(0, 10);
  // The bank's narration is the evidence the suggestions come from, not what you decide, so it is not a column until asked for (Columns).
  // It is always one tap away: open a line (its date) for the full text, or open the row to see it under the fields.
  const narrationKey = 'tvc-ledger-narration-column';
  let showNarration = false;
  try {
    showNarration = localStorage.getItem(narrationKey) === '1';
  } catch {
    // storage blocked: the column is off for this visit
  }
  const colFilters: Record<string, string> = {};
  let loadSeq = 0;
  let postedThisSitting = 0;

  // ---- sign-in (same as the real ledger)
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to open the ledger.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    if (typeof google !== 'undefined') {
      google.accounts.id.initialize({ client_id: CLIENT_ID, callback: (r: { credential: string }) => { setToken(r.credential); void load(); } });
      google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
    }
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });
  // After any write the next list read asks the server for fresh data (it keeps a few seconds of reads otherwise).
  let wantFresh = false;
  async function call(path: string, method = 'GET', body?: unknown) {
    if (method !== 'GET') wantFresh = true;
    try {
      return await staffFetch(path, { method, body });
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else {
          gate.hidden = true;
          content.hidden = true;
          forbidden.hidden = false;
          $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
        }
      }
      throw err;
    }
  }

  // ---- drafts: what you have typed but not posted. They live in this page only.
  const drafts = new Map<string, Draft>();
  const rowErrors = new Map<string, string>();
  const draftOf = (id: string): Draft => drafts.get(id) ?? { categoryId: '', partyId: '', nature: '' };
  const setDraft = (id: string, patch: Partial<Draft>) => {
    drafts.set(id, { ...draftOf(id), ...patch });
    rowErrors.delete(id);
    persistDrafts();
  };
  // What has been typed but not posted is kept in this browser (category, party and wording of each line, never an amount), so a
  // refresh, a crash or a phone going to sleep does not lose a sitting. It is offered back on the next visit.
  const draftsKey = () => `tvc-ledger-drafts:${decodeTokenEmail(getToken() ?? '')}`;
  let draftsTimer: ReturnType<typeof setTimeout> | undefined;
  function saveDraftsNow() {
    clearTimeout(draftsTimer);
    try {
      const kept: Record<string, Draft> = {};
      for (const [id, d] of drafts) if (d.categoryId || d.partyId || d.nature) kept[id] = d;
      if (Object.keys(kept).length) localStorage.setItem(draftsKey(), JSON.stringify({ at: Date.now(), drafts: kept }));
      else localStorage.removeItem(draftsKey());
    } catch {
      // storage can be blocked (private window): the page still works, it just cannot remember
    }
  }
  function persistDrafts() {
    clearTimeout(draftsTimer);
    draftsTimer = setTimeout(saveDraftsNow, 400);
  }
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) saveDraftsNow();
  });
  window.addEventListener('pagehide', saveDraftsNow);
  let restoreChecked = false;
  function offerRestore() {
    if (restoreChecked) return;
    restoreChecked = true;
    try {
      const raw = localStorage.getItem(draftsKey());
      if (!raw) return;
      const saved = JSON.parse(raw) as { at: number; drafts: Record<string, Draft> };
      const usable = Object.entries(saved.drafts).filter(([id]) => {
        const l = byId.get(id);
        return Boolean(l) && editable(l!);
      });
      if (!usable.length) {
        localStorage.removeItem(draftsKey());
        return;
      }
      const when = new Date(saved.at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
      const box = $('restorenote');
      box.replaceChildren(
        h('span', { text: `On ${when} you chose a category or party for ${usable.length} ${usable.length === 1 ? 'line' : 'lines'} but did not post ${usable.length === 1 ? 'it' : 'them'}. These choices are only kept in this browser. Nothing is in the ledger yet.` }),
        button(usable.length === 1 ? 'Fill it in again' : 'Fill them in again', () => {
          const lk = data!.lookups;
          for (const [id, d] of usable) {
            drafts.set(id, { categoryId: lk.categories.some((c) => c.id === d.categoryId) ? d.categoryId : '', partyId: lk.parties.some((x) => x.id === d.partyId) ? d.partyId : '', nature: d.nature ?? '' });
          }
          box.hidden = true;
          for (const el of mounted.values()) el.remove();
          mounted.clear();
          applyView();
          showToast(`Restored ${usable.length} ${usable.length === 1 ? 'line' : 'lines'}. Nothing is posted yet.`);
        }, 'button button--small'),
        button('Forget them', () => {
          try {
            localStorage.removeItem(draftsKey());
          } catch {
            // nothing to remove
          }
          box.hidden = true;
        }, 'button button--outline button--small'),
      );
      box.hidden = false;
    } catch {
      // an unreadable saved draft is ignored
    }
  }
  // What a line is described with beyond its category, party and wording: the maintenance year, the unit and the project. Only what a person
  // set is kept here; the rest is worked out (the year of the date, the payer's own unit), so changing the party or category changes it too.
  type Extra = { householdId?: string; maintenanceYear?: string; projectId?: string };
  const extras = new Map<string, Extra>();
  const extraOf = (id: string): Extra => extras.get(id) ?? {};
  const setExtra = (id: string, patch: Extra) => extras.set(id, { ...extraOf(id), ...patch });
  let unitLabelsCache: Map<string, string> | null = null;
  const unitLabels = () => (unitLabelsCache ??= new Map((data?.lookups.households ?? []).map((x) => [x.id, x.label])));
  const typeOfCategory = (categoryId: string) => data?.lookups.categories.find((c) => c.id === categoryId)?.type ?? '';
  const partyById = (id: string) => data?.lookups.parties.find((p) => p.id === id) ?? null;
  // The category a line is being described with (typed, or the one suggested and shown), so the party list and the follow-up fields can follow it.
  const categoryShown = (l: Line) => draftOf(l.id).categoryId || ghostOf(l, 'categoryId');
  // What would be posted for the unit, year and project of a line: the person's choice, else the sensible default for this payer and date.
  function describedWith(l: Line) {
    const d = draftOf(l.id);
    const type = typeOfCategory(d.categoryId);
    const x = extraOf(l.id);
    const maintenance = type === 'member_contribution';
    return {
      type,
      maintenance,
      capital: type === 'capex',
      year: maintenance ? x.maintenanceYear ?? financialYearOf(l.date) : '',
      unit: maintenance ? x.householdId ?? '' : '',
      suggestedUnit: maintenance ? defaultUnitFor(partyById(d.partyId)) ?? '' : '', // only offered, never filled in: the payer can be anybody
      project: type === 'capex' ? x.projectId ?? '' : '',
    };
  }
  const editable = (l: Line) => Boolean(data?.canAllocate) && l.state === 'unallocated' && !l.review;
  const nameOf = (list: { id: string; name: string }[], id: string | null) => list.find((x) => x.id === id)?.name ?? '';
  const ghostOf = (l: Line, f: Field): string => {
    const s = l.suggestion;
    if (!s || draftOf(l.id)[f]) return '';
    return f === 'categoryId' ? s.categoryId ?? '' : f === 'partyId' ? s.partyId ?? '' : s.nature ?? '';
  };
  const strangerOf = (l: Line) => (!draftOf(l.id).partyId && !l.suggestion?.partyId ? l.suggestion?.newPartyName ?? '' : '');
  // Confident or fairly sure: safe to fill in for many lines at once. A weak suggestion is a guess and is left for a person.
  const isStrong = (l: Line) => ['high', 'medium'].includes(l.suggestion?.confidence ?? '');
  const hasGhost = (l: Line) => Boolean(ghostOf(l, 'categoryId') || ghostOf(l, 'partyId') || ghostOf(l, 'nature'));
  const partyNeeded = (categoryId: string) => {
    const c = data?.lookups.categories.find((x) => x.id === categoryId);
    return Boolean(c) && !['interest', 'transfer'].includes(c!.type) && !/bank charges/i.test(c!.name);
  };
  const isReady = (l: Line) => {
    const d = draftOf(l.id);
    if (!(d.categoryId && d.nature.trim())) return false;
    const dw = describedWith(l);
    return !(dw.maintenance && !dw.unit); // a maintenance line must say whose maintenance it is
  };
  window.addEventListener('beforeunload', (e) => {
    if ([...drafts.values()].some((d) => d.categoryId || d.partyId || d.nature)) e.preventDefault();
  });

  // ---- TanStack Table: the column model, the sort state and the selection state. The server sorts and searches (manual mode).
  const table = createTable<Line>({
    data: [],
    columns: [
      { id: 'select', header: '', enableSorting: false },
      { id: 'date', header: 'Date', accessorFn: (l: Line) => l.date },
      { id: 'amount', header: 'Amount', accessorFn: (l: Line) => l.amountPaise },
      { id: 'category', header: 'Category', accessorFn: (l: Line) => l.allocation?.categoryId ?? '' },
      { id: 'party', header: 'Paid to / from', accessorFn: (l: Line) => l.allocation?.partyId ?? '' },
      { id: 'status', header: 'Status', accessorFn: (l: Line) => (l.review ? 'review' : l.state) },
      { id: 'narration', header: 'Bank narration', accessorFn: (l: Line) => l.narration },
    ],
    getRowId: (l: Line) => l.id,
    getCoreRowModel: getCoreRowModel(),
    manualSorting: true,
    enableSortingRemoval: false,
    enableMultiSort: false,
    sortDescFirst: false,
    enableRowSelection: (row: any) => editable(row.original),
    state: {},
    onStateChange: () => {},
    renderFallbackValue: null,
  } as any);
  let tstate: any = { ...table.initialState, sorting: [{ id: 'date', desc: true }] };
  const syncTable = () =>
    table.setOptions((prev: any) => ({
      ...prev,
      data: lines,
      state: tstate,
      onStateChange: (updater: any) => {
        tstate = typeof updater === 'function' ? updater(tstate) : updater;
        syncTable();
      },
      onSortingChange: (updater: any) => {
        tstate = { ...tstate, sorting: typeof updater === 'function' ? updater(tstate.sorting) : updater };
        syncTable();
        applyView(true);
      },
      onRowSelectionChange: (updater: any) => {
        tstate = { ...tstate, rowSelection: typeof updater === 'function' ? updater(tstate.rowSelection) : updater };
        syncTable();
        refreshSelection();
      },
    }));
  syncTable();
  const sortOf = () => ({ key: tstate.sorting[0]?.id ?? 'date', dir: tstate.sorting[0]?.desc === false ? 'asc' : 'desc' });
  const selectedLines = () => lines.filter((l) => tstate.rowSelection[l.id] && editable(l));

  // ---- TanStack Virtual: only the rows near the screen are in the page.
  const phone = window.matchMedia('(max-width: 1240px)'); // below this the page is a list of cards (the table needs about 1,000px beside the shell)
  let painting = false;
  let repaint = false; // a measurement changed a row's height while painting: place the rows again
  let pendingFocus: { index: number; field: Field | 'start' | 'end' } | null = null;
  const mounted = new Map<string, HTMLElement>();
  const mountedGroups = new Map<string, HTMLElement>();
  const virtualizer = new Virtualizer<HTMLElement, HTMLElement>({
    count: 0,
    getScrollElement: () => scrollEl,
    estimateSize: (i) => (items[i]?.kind === 'group' ? 44 : phone.matches ? 64 : 46),
    overscan: 8,
    getItemKey: (i) => { const it = items[i]; return !it ? i : it.kind === 'group' ? `g:${it.key}` : it.line.id; },
    scrollToFn: elementScroll,
    observeElementRect,
    observeElementOffset,
    onChange: () => (painting ? (repaint = true) : paint()),
  });
  virtualizer._didMount();
  virtualizer._willUpdate();
  phone.addEventListener('change', () => {
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    virtualizer.measure();
    paint();
  });

  function setCount() {
    syncTable();
    virtualizer.setOptions({ ...virtualizer.options, count: items.length });
    virtualizer._willUpdate();
    paint();
  }

  // ---- loading: every line comes down once (about two seconds); sorting, searching and the chips then happen here, instantly.
  const setBusy = (on: boolean, message = '') => {
    $('grid').classList.toggle('is-loading', on);
    $('grid').setAttribute('aria-busy', String(on));
    if (on) $('progress').textContent = message;
  };
  async function load(silent = false) {
    gate.hidden = true;
    forbidden.hidden = true;
    if (!data) showLoading(statusEl);
    else if (!silent) setBusy(true, 'Refreshing from the bank records…');
    const seq = ++loadSeq;
    try {
      const { status, data: out } = await call(`/api/finance-admin/ledger/all${wantFresh ? '?fresh=1' : ''}`);
      wantFresh = false;
      if (seq !== loadSeq) return;
      if (status !== 200) throw new Error('load failed');
      data = out as ListData;
      all = data.lines;
      unitLabelsCache = null;
      byId = new Map(all.map((l) => [l.id, l]));
      clearState(statusEl);
      intro.hidden = false;
      intro.textContent = 'Every line the bank has told us about, and what it was for.';
      content.hidden = false;
      applyView();
      offerRestore();
      void loadMonths();
    } catch (err) {
      if (err instanceof StaffAuthError) return;
      content.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the ledger", text: "The server didn't answer. Nothing was changed. Check your connection and try again.", onRetry: () => load() });
    } finally {
      if (seq === loadSeq) setBusy(false);
    }
  }

  const CONFIDENCE_WORDS: Record<string, string> = { high: 'confident', medium: 'fairly sure', low: 'a guess' };
  // ---- one line: what it says, and the allocation editor
  type Alloc = { id: string; partyId: string | null; categoryId: string; projectId: string | null; amountPaise: number; period: string; nature: string; remarks: string | null; source: string; reviewState: string; reviewReason: string | null; householdId: string | null; maintenanceYear: string | null; reversesAllocationId: string | null; reversalReason: string | null; posted: boolean };
  type Reversible = { id: string; date: string; partyId: string | null; categoryId: string; nature: string; remainingPaise: number };
  type Detail = {
    canAllocate: boolean;
    line: { id: string; date: string; narration: string; direction: 'debit' | 'credit'; amountPaise: number };
    upi: { counterparty: string | null; remark: string | null; isCircle: boolean } | null;
    state: string;
    allocations: Alloc[];
    proposal: { categoryId: string | null; partyId: string | null; nature: string; amountPaise: number; period: string; source: string; ruleId: string | null } | null;
    suggestion: (Suggestion & { reasons: string[]; newParty: { name: string; kind: string } | null }) | null;
    reasons: string[];
    reversible: Reversible[];
    lookups: Lookups;
    reasonLabels: Record<string, string>;
  };

  const monthOf = (iso: string) => iso.slice(0, 7);

  // The party picker in the cell of a posted line that has none. Saving goes through the same route as the sheet's "Add party"; a closed month, a split
  // line or anything unexpected falls back to the sheet, which can ask for a reason.
  async function editPartyInline(l: Line, cell: HTMLElement) {
    const { status, data: d } = await call(`/api/finance-admin/ledger/${l.id}`);
    const missing = status === 200 ? (d as Detail).allocations.filter((a) => a.posted && !a.partyId && !a.reversesAllocationId) : [];
    if (missing.length !== 1) return void openLine(l.id);
    const picker = combo({ options: partyOptions(data!.lookups.parties), value: '', blank: 'Choose a party', matcher: matchOptions, ariaLabel: l.direction === 'debit' ? 'Paid to (party)' : 'Received from (party)' }) as ComboEl;
    const restore = () => {
      const el = mounted.get(l.id);
      if (el) fill(el, byId.get(l.id) ?? l);
    };
    picker.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') restore();
    });
    picker.addEventListener('change', async () => {
      if (!picker.value) return;
      const res = await call(`/api/finance-admin/allocations/${missing[0].id}/party`, 'POST', { partyId: picker.value });
      if (res.status === 200) {
        showToast('Party added.');
        void load();
      } else if (res.status === 403) {
        showToast(res.data?.error ?? 'That month is closed.');
        void openLine(l.id);
      } else {
        showToast(res.data?.error ?? 'Could not do that.');
        restore();
      }
    });
    cell.replaceChildren(picker);
    picker.input.focus();
  }

  async function openLine(id: string) {
    const dlg = $<HTMLDialogElement>('line-sheet');
    const { status, data: d } = await call(`/api/finance-admin/ledger/${id}`);
    if (status !== 200) {
      showToast(d?.error ?? 'Could not open that line.');
      return;
    }
    const detail = d as Detail;
    const { line, upi } = detail;
    const head = [
      h('h2', { text: `${line.direction === 'debit' ? 'Paid' : 'Received'} ${rupees(line.amountPaise)}`, attrs: { id: 'line-title' } }),
      h('p', { class: 'sheet-text', text: `${niceDate(line.date)} · ${line.narration}` }),
      upi?.remark || upi?.counterparty ? h('p', { class: 'hint', text: [upi.counterparty ? `Paytm says: ${upi.counterparty}` : '', upi.remark ? `remark "${upi.remark}"` : '', upi.isCircle ? 'a circle payment' : ''].filter(Boolean).join(', ') }) : null,
    ];
    const posted = detail.allocations.some((a) => a.posted);
    dlg.addEventListener('close', () => dlg.replaceChildren(), { once: true });
    if (posted || !detail.canAllocate) present(dlg, closeOnBackdrop, ...head, postedView(dlg, detail), h('div', { class: 'sheet-actions' }, button('Close', () => dlg.close())));
    else present(dlg, closeOnBackdrop, ...head, editor(dlg, detail));
  }

  // A posted line: what explains it, with review decisions for anything flagged.
  function postedView(dlg: HTMLDialogElement, d: Detail): HTMLElement {
    const lk = d.lookups;
    if (!d.allocations.length) return h('p', { class: 'note', text: 'Nothing explains this line yet.' });
    return h(
      'ul',
      { class: 'list' },
      ...d.allocations.map((a) => {
        const reasons = (a.reviewReason ?? '').split(',').filter(Boolean).map((r) => d.reasonLabels[r] ?? r);
        const actions: HTMLElement[] = [];
        if (d.canAllocate && a.reviewState !== 'ok') {
          actions.push(
            button('Mark as checked', async () => {
              const { status, data: out } = await call(`/api/finance-admin/allocations/${a.id}/review`, 'POST', { action: 'resolve' });
              if (status === 200) {
                dlg.close();
                showToast('Marked as checked.');
                void load();
              } else showToast(out?.error ?? 'Could not do that.');
            }),
          );
        } else if (d.canAllocate && a.posted) {
          actions.push(
            button('Flag for review', async () => {
              const { status, data: out } = await call(`/api/finance-admin/allocations/${a.id}/review`, 'POST', { action: 'flag' });
              if (status === 200) {
                dlg.close();
                showToast('Flagged for review.');
                void load();
              } else showToast(out?.error ?? 'Could not do that.');
            }, 'button button--outline button--small'),
          );
        }
        // A posted line with no party can be given one here; an existing party is only changed by reversing the line.
        const fillBox = h('div', { class: 'stack-form', attrs: { hidden: '' } });
        if (d.canAllocate && a.posted && !a.partyId && !a.reversesAllocationId) {
          const closedMonth = lk.closedMonths.some((m) => m.slice(0, 7) === a.period.slice(0, 7));
          const picker = combo({ options: partyOptions(lk.parties), value: '', blank: 'Choose a party', matcher: matchOptions, ariaLabel: d.line.direction === 'debit' ? 'Paid to (party)' : 'Received from (party)' }) as ComboEl;
          const why = input('closedReason', { placeholder: 'Why is a closed month being changed?' }) as HTMLInputElement;
          const note = h('p', { class: 'error', attrs: { hidden: '' } });
          fillBox.append(
            labelled(d.line.direction === 'debit' ? 'Paid to' : 'Received from', picker),
            closedMonth ? labelled('Reason for changing a closed month', why) : h('span'),
            note,
            h('div', { class: 'sheet-actions' }, button('Save party', async () => {
              note.hidden = true;
              if (!picker.value) {
                note.textContent = 'Choose a party first.';
                note.hidden = false;
                return;
              }
              const { status, data: out } = await call(`/api/finance-admin/allocations/${a.id}/party`, 'POST', { partyId: picker.value, overrideReason: why.value });
              if (status === 200) {
                dlg.close();
                showToast('Party added.');
                void load();
              } else {
                note.textContent = out?.error ?? 'Could not do that.';
                note.hidden = false;
              }
            })),
          );
          actions.push(button('Add party', () => { fillBox.hidden = !fillBox.hidden; }, 'button button--outline button--small'));
        }
        return h(
          'li',
          {},
          h(
            'div',
            { class: 'row alloc-row' },
            h(
              'span',
              { class: 'grow' },
              h('span', { class: 'title', text: a.reversesAllocationId ? `Refund: ${a.nature}` : a.nature }),
              h('span', { class: 'detail', text: [nameOf(lk.categories, a.categoryId), nameOf(lk.parties, a.partyId), a.householdId ? `Unit ${lk.households.find((x) => x.id === a.householdId)?.label ?? ''}` : '', a.maintenanceYear ?? '', niceMonth(a.period)].filter(Boolean).join(' · ') }),
              reasons.length ? h('span', { class: 'detail detail--warn', text: reasons.join('. ') }) : null,
            ),
            h('span', { class: 'amount', text: rupees(a.amountPaise) }),
            ...actions,
          ),
          fillBox,
        );
      }),
    );
  }


  // Why the form is filled in the way it is, in plain words. Nothing here is posted until a person presses Post.
  function suggestionNote(d: Detail): HTMLElement | null {
    const sg = d.suggestion;
    if (!sg || !sg.reasons.length) return null;
    return h('div', { class: 'suggest-note' }, h('p', { class: 'field-label', text: `Why this suggestion (${CONFIDENCE_WORDS[sg.confidence] ?? 'a guess'})` }), h('ul', { class: 'why' }, ...sg.reasons.map((r) => h('li', { text: r }))));
  }

  // ---- the editor: rows that add up to the line
  function editor(dlg: HTMLDialogElement, d: Detail): HTMLElement {
    const lk = d.lookups;
    const line = d.line;
    type RowUi = { el: HTMLElement; household: ComboEl; year: HTMLInputElement; unitBox: HTMLElement; amount: HTMLInputElement; category: ComboEl; party: ComboEl; nature: HTMLInputElement; period: HTMLInputElement; project: ComboEl | null; reverses: ComboEl | null; reason: HTMLInputElement; ruleId: string | null; source: string };
    const rowsUi: RowUi[] = [];
    const rowsBox = h('div', { class: 'alloc-rows' });
    const remainingEl = h('p', { class: 'remaining', attrs: { 'aria-live': 'polite' } });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const closedReason = input('closedReason', { placeholder: 'Why is a closed month being changed?' }) as HTMLInputElement;
    const closedBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, labelled('Reason for changing a closed month', closedReason));

    // Every party picker in this sheet, so a party added in one row is available in all of them.
    const partySelects: ComboEl[] = [];
    function addPartyEverywhere(p: Party) {
      lk.parties.push(p);
      lk.parties.sort((a, b) => a.name.localeCompare(b.name));
      for (const sel of partySelects) sel.setOptions(partyOptions(lk.parties));
    }
    // Add a party that is not in the register yet, right here. Bank details are added later on the Parties page and verified there.
    function openNewParty(box: HTMLElement, name: string, kind: string, onAdded: (id: string) => void) {
      const nameInput = input('newPartyName', { placeholder: 'Name as it should appear in the register' }) as HTMLInputElement;
      nameInput.value = name;
      const kindSel = h('select', { attrs: { name: 'newPartyKind' } }, ...Object.entries(PARTY_KINDS).filter(([k]) => k !== 'member').map(([k, label]) => h('option', { text: label, attrs: { value: k } }))) as HTMLSelectElement;
      kindSel.value = kind;
      const note = h('p', { class: 'error', attrs: { hidden: '' } });
      const add = button('Add to register', async () => {
        const typed = nameInput.value.trim().replace(/\s+/g, ' ');
        const twin = lk.parties.find((x) => x.name.toLowerCase() === typed.toLowerCase());
        if (twin) {
          note.hidden = false;
          note.textContent = `${twin.name} is already in the register. Choose them from the list.`;
          return;
        }
        const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: typed, kind: kindSel.value });
        if (status !== 201) {
          note.hidden = false;
          note.textContent = out?.error ?? 'Could not add that.';
          return;
        }
        addPartyEverywhere({ id: out.party.id, name: out.party.name, kind: out.party.kind });
        box.hidden = true;
        onAdded(out.party.id);
        showToast(`${out.party.name} added to the register. Add their bank details on the Parties page.`);
      }, 'button button--primary button--small');
      box.replaceChildren(labelled('Name', nameInput), labelled('What kind of party', kindSel), note, h('div', { class: 'sheet-actions' }, add, button('Cancel', () => (box.hidden = true), 'button button--outline button--small')));
      box.hidden = false;
      nameInput.focus();
    }

    const sumPaise = () => rowsUi.reduce((n, r) => n + (parseRupees(r.amount.value) ?? 0), 0);
    function refresh() {
      const left = line.amountPaise - sumPaise();
      remainingEl.textContent = left === 0 ? 'Adds up to the line. Ready to post.' : left > 0 ? `${rupees(left)} still to allocate.` : `${rupees(-left)} more than the line.`;
      remainingEl.className = `remaining${left === 0 ? ' remaining--ok' : left < 0 ? ' remaining--over' : ''}`;
      const closedUsed = rowsUi.some((r) => lk.closedMonths.some((m) => m.slice(0, 7) === r.period.value));
      closedBox.hidden = !closedUsed;
    }

    function addRow(init: Partial<{ amountPaise: number; categoryId: string; partyId: string; nature: string; period: string; ruleId: string | null; source: string }> = {}) {
      const amount = input('amount', { inputmode: 'decimal', placeholder: '0.00', 'aria-label': 'Amount' }) as HTMLInputElement;
      amount.value = init.amountPaise ? (init.amountPaise / 100).toFixed(2) : '';
      const category = combo({ options: categoryOptions(lk.categories, { selected: init.categoryId ?? '' }), value: init.categoryId ?? '', blank: 'Choose a category', matcher: matchOptions, ariaLabel: 'Category' }) as ComboEl;
      const newBox = h('div', { class: 'stack-form new-party', attrs: { hidden: '' } });
      const party = combo({
        options: partyOptions(lk.parties),
        value: init.partyId ?? '',
        blank: 'No one in particular',
        matcher: matchOptions,
        ariaLabel: line.direction === 'debit' ? 'Paid to (party)' : 'Received from (party)',
        addNewLabel: 'Add as a new party',
        addNew: (typed) => openNewParty(newBox, typed || d.suggestion?.newParty?.name || '', d.suggestion?.newParty?.kind ?? (line.direction === 'credit' ? 'customer' : 'vendor'), (id) => {
          party.value = id;
          refresh();
        }),
      }) as ComboEl;
      party.addEventListener('change', () => (newBox.hidden = true));
      partySelects.push(party);
      const nature = input('nature', { placeholder: 'What it was for, in plain words' }) as HTMLInputElement;
      nature.value = init.nature ?? '';
      const period = input('period', { type: 'month', 'aria-label': 'Month it belongs to' }) as HTMLInputElement;
      period.value = monthOf(init.period ?? line.date);
      const project = lk.projects.length ? (combo({ options: lk.projects.map((p) => ({ value: p.id, label: `${p.name} (${p.financial_year})` })), blank: 'Not part of a project', matcher: matchOptions, ariaLabel: 'Project' }) as ComboEl) : null;
      const reverses = d.reversible.length
        ? (combo({ options: d.reversible.map((r) => ({ value: r.id, label: `${niceDate(r.date)} · ${r.nature} · ${rupees(r.remainingPaise)} left` })), blank: 'This is not a refund', matcher: matchOptions, ariaLabel: 'Refund of' }) as ComboEl)
        : null;
      const reason = input('reason', { placeholder: 'Why is it being refunded?' }) as HTMLInputElement;
      const reasonBox = labelled('Reason', reason);
      reasonBox.hidden = true;
      // Maintenance is paid by anybody and allocated to a unit: the unit and the year it pays for are asked for when the category is maintenance.
      const isMaintenance = () => lk.categories.find((c) => c.id === category.value)?.type === 'member_contribution';
      const household = combo({ options: unitOptions(lk.households), blank: 'Choose the unit…', matcher: matchOptions, ariaLabel: 'Unit' }) as ComboEl;
      const fyOf = (iso: string) => {
        const start = Number(iso.slice(5, 7)) >= 4 ? Number(iso.slice(0, 4)) : Number(iso.slice(0, 4)) - 1;
        return `${start}-${String((start + 1) % 100).padStart(2, '0')}`;
      };
      const year = input('maintenanceYear', { placeholder: '2025-26', 'aria-label': 'Maintenance year' }) as HTMLInputElement;
      year.value = fyOf(line.date);
      const unitBox = h('div', { class: 'stack-form alloc-top' }, labelled('Unit', household), labelled('Maintenance year', year));
      unitBox.hidden = !isMaintenance();
      category.addEventListener('change', () => (unitBox.hidden = !isMaintenance()));
      const normal = h('div', { class: 'stack-form' }, labelled('Category', category), labelled(line.direction === 'debit' ? 'Paid to (party)' : 'Received from (party)', party), newBox, unitBox, labelled('What it was for', nature));
      // Month, refund and project: needed for a refund, a line that belongs to another month, or a project, so not shown on every line.
      const more = h('details', { class: 'more' }, h('summary', { text: reverses ? 'Refund, month or project' : 'Month or project' }), h('div', { class: 'stack-form' }, labelled('Month', period), reverses ? labelled('Refund of', reverses) : null, reasonBox, project ? labelled('Project', project) : null));
      const el = h('fieldset', { class: 'alloc-edit' });
      const ui: RowUi = { el, household, year, unitBox, amount, category, party, nature, period, project, reverses, reason, ruleId: init.ruleId ?? null, source: init.source ?? 'manual' };
      reverses?.addEventListener('change', () => {
        const refund = Boolean(reverses.value);
        if (refund) more.open = true;
        normal.hidden = refund;
        reasonBox.hidden = !refund;
        if (refund) {
          const target = d.reversible.find((r) => r.id === reverses.value);
          if (target && !parseRupees(amount.value)) amount.value = (Math.min(target.remainingPaise, line.amountPaise) / 100).toFixed(2);
          refresh();
        }
      });
      for (const f of [amount, period]) f.addEventListener('input', refresh);
      el.append(
        ...[
        h('div', { class: 'stack-form alloc-top' }, labelled('Amount (₹)', amount), rowsUi.length ? button('Remove', () => { rowsUi.splice(rowsUi.indexOf(ui), 1); el.remove(); refresh(); }, 'button button--outline button--small') : h('span')),
        normal,
        more,
        ].filter((n): n is HTMLElement => n !== null),
      );
      rowsUi.push(ui);
      rowsBox.append(el);
      refresh();
      return ui;
    }

    // Start from the rule's suggestion when there is one, otherwise a blank row for the whole line.
    const p = d.proposal;
    addRow({ amountPaise: line.amountPaise, categoryId: p?.categoryId ?? '', partyId: p?.partyId ?? '', nature: p?.nature ?? '', ruleId: p?.ruleId ?? null, source: p?.source === 'rule' ? 'rule' : p?.source === 'upi_remark' ? 'upi_remark' : 'manual' });
    // A name in the narration that is not in the register: open the add-party form for the first row, ready to confirm.
    if (d.suggestion?.newParty && !p?.partyId) {
      const first = rowsUi[0];
      openNewParty(first.el.querySelector<HTMLElement>('.new-party')!, d.suggestion.newParty.name, d.suggestion.newParty.kind ?? (line.direction === 'credit' ? 'customer' : 'vendor'), (id) => {
        first.party.value = id;
        refresh();
      });
    }
    const why = d.reasons.map((r) => d.reasonLabels[r]).filter(Boolean);

    async function submit(post: boolean) {
      msg.hidden = true;
      const payload = rowsUi.map((r) => ({
        amountPaise: parseRupees(r.amount.value) ?? 0,
        period: r.period.value ? `${r.period.value}-01` : undefined,
        ...(r.reverses?.value ? { reversesAllocationId: r.reverses.value, reversalReason: r.reason.value, nature: r.nature.value } : { categoryId: r.category.value, partyId: r.party.value || null, projectId: r.project?.value || null, nature: r.nature.value, ruleId: r.ruleId, source: r.source, ...(r.unitBox.hidden ? {} : { householdId: r.household.value || null, maintenanceYear: r.year.value.trim() || null }) }),
      }));
      const { status, data: out } = await call(`/api/finance-admin/ledger/${line.id}/allocations`, 'POST', { rows: payload, post, overrideReason: closedReason.value });
      if (status === 200) {
        dlg.close();
        showToast(post ? 'Posted.' : 'Draft saved.');
        void load();
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not save that.';
      }
    }

    const wrap = h(
      'div',
      { class: 'editor' },
      suggestionNote(d),
      why.length ? h('p', { class: 'note', text: `${why.join('. ')}.` }) : null,
      rowsBox,
      h('div', { class: 'editor-tools' }, button('Add another row', () => { const left = line.amountPaise - sumPaise(); addRow({ amountPaise: left > 0 ? left : undefined }); })),
      remainingEl,
      closedBox,
      msg,
      h('div', { class: 'sheet-actions' }, button('Cancel', () => dlg.close()), button('Save draft', () => void submit(false)), button('Post', () => void submit(true), 'button button--primary')),
    );
    refresh();
    return wrap;
  }


  // ---- months: what is left in each, and closing one once everything in it is posted and checked
  type Month = { month: string; status: 'open' | 'closed'; unallocated: number; review: number };
  async function closeMonth(month: string) {
    const res = await call(`/api/finance-admin/periods/${month}/close`, 'POST');
    showToast(res.status === 200 ? `${niceMonth(month)} closed.` : res.data?.error ?? 'Could not close it.');
    void loadMonths();
  }
  // The month to finish is the previous calendar month (if it is still open, else the newest open one): what is left in it, or a
  // Close month button when it is done. Older months left open for good reasons are in the Months list, not nagging here.
  function renderMonthStrip(months: Month[], canClose: boolean) {
    const box = $('monthstrip');
    const open = months.filter((m) => m.status === 'open');
    const now = new Date();
    const previous = new Date(now.getFullYear(), now.getMonth() - 1, 1);
