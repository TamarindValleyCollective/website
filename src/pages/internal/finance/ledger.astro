      if (paidByUpiWithoutRecord(l)) counts.noupi++;
    }
    markFilled();
    const shown = base.filter((l) => passesChips(l, chips, now));
    const sort = sortOf();
    const compare = compareRows(sort.key, sort.dir as 'asc' | 'desc');
    const row = (l: Line) => ({ id: l.id, date: l.date, origin: originText(l), narration: l.narration, amount: l.amountPaise, category: l.effective.category, party: l.effective.party, nature: l.effective.nature, status: l.review ? 'review' : l.state });
    const sorted = shown.map((l) => ({ l, r: row(l) })).sort((a, b) => compare(a.r, b.r)).map((x) => x.l);
    matched = sorted.length;
    const built = buildItems(sorted, groupBy, collapsed, niceMonth, { isTransfer: isTransferLine });
    items = built.items as Item[];
    lines = built.visible as Line[];
