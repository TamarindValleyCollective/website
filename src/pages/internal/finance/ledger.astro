      r.catText.replaceChildren(document.createTextNode(a ? `${nameOf(lk.categories, a.categoryId)}${a.count > 1 ? ` +${a.count - 1} more` : ''}` : ''), ...(forWhom ? [h('span', { class: 'detail detail--unit', text: forWhom })] : []));
      r.partyText.replaceChildren(a?.partyId ? document.createTextNode(partyShown(a.partyId)) : l.missingParty ? h('span', { class: 'noparty', text: 'No party', attrs: { title: 'Double-click to choose a party' } }) : document.createTextNode(''));
