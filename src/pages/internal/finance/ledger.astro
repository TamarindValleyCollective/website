  }
  function focusRow(index: number, field: Field, step = 1) {
    let i = index;
    while (lines[i] && !editable(lines[i])) i += step;
    if (!lines[i]) return;
    pendingFocus = { index: i, field };
    virtualizer.scrollToIndex(itemIndexOfLine.get(lines[i].id) ?? i, { align: 'auto' });
    paint();
  }

  // Hovering a line (a mouse, not a touch screen) shows the bank's narration and what the Paytm report says, so the evidence is there without
  // taking a column. Text only. It is skipped when the narration is already on screen (its column, or the line is open).
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const tip = $('ltip');
  let tipTimer: ReturnType<typeof setTimeout> | undefined;
  const hideTip = () => {
    clearTimeout(tipTimer);
    tip.hidden = true;
  };
  spacer.addEventListener('mouseover', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.lrow');
    if (!row || !canHover.matches || narrationShown() || row.classList.contains('is-active') || row.contains(e.relatedTarget as Node | null) || spacer.contains(document.activeElement)) return;
    const l = byId.get(row.dataset.id ?? '');
    if (!l) return;
    clearTimeout(tipTimer);
    tipTimer = setTimeout(() => {
      const upi = [l.counterparty, l.remark ? `“${l.remark}”` : ''].filter(Boolean).join(' · ');
      tip.replaceChildren(
        h('p', { class: 'ltip-text', text: l.narration }),
        ...(upi ? [h('p', { class: 'ltip-sub', text: `${l.origin ? originLabel(l.origin) : 'UPI'}: ${upi}` })] : []),
        ...(l.account ? [h('p', { class: 'ltip-sub', text: l.account })] : []),
      );
      tip.hidden = false;
      const r = row.getBoundingClientRect();
      const w = tip.offsetWidth;
      tip.style.left = `${Math.max(8, Math.min(r.left + 90, window.innerWidth - w - 8))}px`;
      // Never over the bar of selected lines at the bottom: below the line if it fits above the bar, else above the line.
      const limit = $('actionbar').hidden ? window.innerHeight : $('actionbar').getBoundingClientRect().top;
      const below = r.bottom + 4;
      tip.style.top = `${below + tip.offsetHeight > limit - 8 ? Math.max(8, r.top - tip.offsetHeight - 4) : below}px`;
    }, 350);
  });
  spacer.addEventListener('mouseout', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.lrow');
    if (row && !row.contains(e.relatedTarget as Node | null)) hideTip();
  });
  scrollEl.addEventListener('scroll', hideTip, { passive: true });
  // Working in a line (clicking, tabbing into a field) hides the card, and it stays away until focus leaves the list.
  spacer.addEventListener('mousedown', hideTip);
  spacer.addEventListener('focusin', hideTip);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && hideTip());

  // A group heading: a button that opens or closes the group, with how many lines it holds and what they add up to.
  function makeGroup(g: Extract<Item, { kind: 'group' }>): HTMLElement {
    const net = `${g.netPaise < 0 ? '−' : '+'}${rupees(Math.abs(g.netPaise))}`;
    const month = g.field === 'month' ? monthOfKey(g.key) : null;
    const m = month ? monthStatus.get(month) : undefined;
    const ready = Boolean(m && m.status === 'open' && m.unallocated === 0 && m.review === 0);
    const state = !m ? null : m.status === 'closed' ? pill('🔒 Closed', 'ok') : ready ? pill('Ready to close', 'ok') : pill(monthLeft(m), 'warn');
    const b = h(
      'button',
      { class: 'ggroup-btn', attrs: { type: 'button', 'aria-expanded': String(g.open) } },
      h('span', { class: 'ggroup-tri', text: '▸' }),
      h('span', { class: 'ggroup-label', text: g.label }),
      state,
      h('span', { class: 'ggroup-count', text: `${g.count} ${g.count === 1 ? 'line' : 'lines'}` }),
      h('span', { class: 'ggroup-net', text: `Net ${net}${g.transfers ? ` · ${g.transfers} ${g.transfers === 1 ? 'transfer' : 'transfers'} not counted` : ''}`, attrs: { title: g.transfers ? 'Money in minus money out. Transfers between TVC\'s own accounts net to nothing, so they are left out.' : 'Money in minus money out for these lines' } }),
    );
    b.addEventListener('click', () => {
      if (collapsed.has(g.key)) collapsed.delete(g.key);
      else collapsed.add(g.key);
      applyView();
    });
    // A button cannot sit inside the heading button, so Close month sits beside it.
    const close = month && ready && canCloseMonths ? button('Close month', () => void closeMonth(month), 'button button--small') : null;
    return h('div', { class: `lgroup lgroup--${g.depth + 1}${g.open ? ' is-open' : ''}${m?.status === 'closed' ? ' is-closed' : ''}`, attrs: { role: 'row' } }, b, close);
  }

  function paint() {
    if (painting) return;
    painting = true;
    try {
      spacer.style.height = `${virtualizer.getTotalSize()}px`;
      const keep = new Set<string>();
      const keepGroups = new Set<string>();
      const inOrder: HTMLElement[] = [];
      for (const item of virtualizer.getVirtualItems()) {
        const it = items[item.index];
        if (!it) continue;
        if (it.kind === 'group') {
          keepGroups.add(it.key);
          const g = mountedGroups.get(it.key) ?? makeGroup(it);
          if (!mountedGroups.has(it.key)) {
            mountedGroups.set(it.key, g);
            spacer.append(g);
          }
          g.dataset.index = String(item.index);
          g.setAttribute('aria-rowindex', String(item.index + 3));
          inOrder.push(g);
          g.style.transform = `translateY(${item.start}px)`;
          virtualizer.measureElement(g);
          continue;
        }
        const l = it.line;
        keep.add(l.id);
        let el = mounted.get(l.id);
        if (!el) {
          el = makeRow(l);
          mounted.set(l.id, el);
          spacer.append(el);
        }
        el.dataset.index = String(item.index);
        el.setAttribute('aria-rowindex', String(item.index + 3)); // the two heading rows come first
        inOrder.push(el);
        el.style.transform = `translateY(${item.start}px)`;
        virtualizer.measureElement(el);
      }
      for (const [id, el] of mounted) {
        if (!keep.has(id)) {
          el.remove();
          mounted.delete(id);
        }
      }
      for (const [key, el] of mountedGroups) {
        if (!keepGroups.has(key)) {
          el.remove();
          mountedGroups.delete(key);
        }
      }
      // Keep the page's order the same as the table's, so Tab and a screen reader go down the lines in order (never while focus is inside).
      if (!spacer.contains(document.activeElement) && inOrder.some((el, i) => spacer.children[i] !== el)) spacer.append(...inOrder);
      $('grid').setAttribute('aria-rowcount', String(items.length + 2));
      if (pendingFocus && typeof pendingFocus.field === 'object') {
        // The keyboard's cell cursor moved to a line that was not on the page yet.
        const el = mounted.get(lines[pendingFocus.index]?.id ?? '');
        if (el) {
          const target = el.querySelector<HTMLElement>(`.gcell[data-col="${pendingFocus.field.cell}"]`);
          if (target) {
            park(target);
            target.focus();
          }
          pendingFocus = null;
        }
      } else if (pendingFocus) {
        const l = lines[pendingFocus.index];
        const el = l && mounted.get(l.id);
        if (el) {
          const r = refs.get(el)!;
          if (pendingFocus.field !== 'start' && pendingFocus.field !== 'end' && editable(l)) {
            el.dataset.open = '1';
            fill(el, l);
          }
          if (pendingFocus.field === 'start' || pendingFocus.field === 'end') {
            const stops = [...el.querySelectorAll<HTMLElement>('input, select, button')].filter((x) => !(x as HTMLInputElement).disabled && !x.hidden && x.offsetParent !== null);
            (pendingFocus.field === 'start' ? stops[0] : stops[stops.length - 1])?.focus();
          } else (pendingFocus.field === 'nature' ? (r.wordText.offsetParent !== null ? r.wordText : r.nature) : pendingFocus.field === 'partyId' ? r.party : r.cat).focus();
          pendingFocus = null;
        }
      }
      ensureCursor();
    } finally {
      painting = false;
    }
    if (repaint) {
      repaint = false;
      paint();
    }
  }

  // ---- selection (shift-click for a range) and the action bar
  let lastPicked: string | null = null;
  function pick(id: string, range: boolean) {
    const pickable = lines.filter(editable);
    const on = !tstate.rowSelection[id];
    const next = { ...tstate.rowSelection };
    if (range && lastPicked) {
      const a = pickable.findIndex((x) => x.id === lastPicked);
      const b = pickable.findIndex((x) => x.id === id);
      if (a >= 0 && b >= 0) for (const x of pickable.slice(Math.min(a, b), Math.max(a, b) + 1)) next[x.id] = on;
    } else next[id] = on;
    for (const k of Object.keys(next)) if (!next[k]) delete next[k];
    lastPicked = id;
    table.setRowSelection(next);
  }
  function refreshSelection() {
    renderDraftNote();
    syncSelectAll();
    for (const [id, el] of mounted) {
      const l = lines.find((x) => x.id === id);
      if (l) fill(el, l);
    }
    renderBar();
  }

  // The bar is fixed to the window, so it starts where the page's own area starts (after the rail and the Finance panel), not under them.
  const staffMain = document.getElementById('staff-main');
  function placeBar() {
    $('actionbar').style.left = staffMain ? `${Math.max(0, staffMain.getBoundingClientRect().left)}px` : '0px';
  }
  if (staffMain) new ResizeObserver(placeBar).observe(staffMain);
  window.addEventListener('resize', placeBar);
  let barFields = { categoryId: '', partyId: '', nature: '' };
  // Maintenance year and unit chosen in the bar for the selected lines. Empty: each line keeps its own default (the year of its date, its payer's unit).
  const barExtra = { year: '', unit: '' };
  function renderBar() {
    const bar = $('actionbar');
    const sel = selectedLines();
    if (!data || !sel.length) {
      bar.hidden = true;
      bar.replaceChildren();
      document.documentElement.style.setProperty('--abar-h', '0px');
      $('selcount').textContent = '';
      return;
    }
    const ready = sel.filter(isReady).length;
    if ($('selcount').textContent !== `${sel.length} selected, ${ready} ready to post`) $('selcount').textContent = `${sel.length} selected, ${ready} ready to post`;
    placeBar();
    const lk = data.lookups;
    // The same linked pickers as on a line. Here the year and the unit may be left to each line, so Maintenance and each year can also be picked as they are; what is
    // chosen applies to every selected line.
    const barPath = categoryPath({ categoryId: barFields.categoryId, type: typeOfCategory(barFields.categoryId), year: barExtra.year, unit: barExtra.unit });
    const barType = typeOfCategory(barFields.categoryId);
    const maint = barType === 'member_contribution';
    const cat = linkedPicker({
      nodes: categoryNodes({ categories: lk.categories, households: lk.households, projects: lk.projects, date: today(), bar: true }),
      path: maint && !barExtra.unit ? [barFields.categoryId, ...(barExtra.year ? [barExtra.year] : [])] : barPath,
      blank: 'Category…',
      ariaLabel: 'Category for the selected lines',
      rootLabel: 'All categories',
    }) as ComboEl;
    // Adding a party here is the same as on a line: the new one is chosen for all the selected lines (nothing is saved to them until they are posted).
    const kind = sel.every((l) => l.direction === 'credit') ? 'customer' : 'vendor';
    const party = linkedPicker({
      nodes: partyNodes({ parties: lk.parties, unitId: maint ? barExtra.unit : '', unitLabels: unitLabels() }),
      path: partyPath(partyById(barFields.partyId)),
      blank: 'Party…',
      ariaLabel: 'Party for the selected lines',
      rootLabel: 'All kinds',
      startAt: () => partyStart({ categoryType: barType, unitId: maint ? barExtra.unit : '', unitHasPeople: lk.parties.some((q) => q.household_id === barExtra.unit && !q.former_since), parties: lk.parties }),
      addNew: {
        label: 'Add as a new party',
        blockedAt: (path) => (path[0] === 'member' || path[0] === 'unit' ? NO_MEMBER_ADD : null),
        onAdd: (typed) =>
          openAddParty(typed, kind, (id) => {
            barFields.partyId = id;
            renderBar();
          }),
      },
    }) as ComboEl;
    const words = h('input', { attrs: { type: 'text', placeholder: 'What it was for…', 'aria-label': 'What it was for, for the selected lines', autocomplete: 'off', value: barFields.nature } }) as HTMLInputElement;
    cat.addEventListener('change', () => {
      const path = cat.path;
      const got = readCategoryPath(path, typeOfCategory(path[0] ?? ''));
      barFields.categoryId = got.categoryId;
      barExtra.year = got.year;
      barExtra.unit = got.householdId;
      renderBar();
      if (got.categoryId && !barFields.partyId) setTimeout(() => $('actionbar').querySelectorAll<HTMLInputElement>('.combo-input')[1]?.focus(), 0);
    });
    let syncApply: () => void = () => {};
    party.addEventListener('change', () => {
      barFields.partyId = party.value;
      syncApply();
    });
    words.addEventListener('input', () => {
      barFields.nature = words.value;
      syncApply();
    });
    const post = button(`Post ${ready} ready`, () => void postReady(), 'button abar-post') as HTMLButtonElement;
    post.disabled = ready === 0;
    const plural = (n: number) => (n === 1 ? 'line' : 'lines');
    const needReason = sel.filter((l) => draftOf(l.id).categoryId && !draftOf(l.id).nature.trim()).length;
    // Accepting takes every suggestion, weak ones too; say how many of the selected lines rest on a guess, so they get a second look.
    const weakGuesses = sel.filter((l) => hasGhost(l) && !isStrong(l)).length;
    const anyField = () => Boolean(barFields.categoryId || barFields.partyId || barFields.nature.trim() || (maint && (barExtra.year || barExtra.unit)));
    const apply = button(`Apply to ${sel.length} ${plural(sel.length)}`, async () => {
        const patch = Object.fromEntries(Object.entries(barFields).filter(([, v]) => String(v).trim())) as Partial<Draft>;
        const extraPatch: Extra = { ...(maint && barExtra.year ? { maintenanceYear: barExtra.year } : {}), ...(maint && barExtra.unit ? { householdId: barExtra.unit } : {}) };
        if (!Object.keys(patch).length && !Object.keys(extraPatch).length) {
          showToast('Choose a category, party or what it was for first.');
          return;
        }
        const clash = sel.filter((l) => (Object.entries(patch) as [Field, string][]).some(([f, v]) => draftOf(l.id)[f] && draftOf(l.id)[f] !== v)).length;
        if (clash) {
          const ok = await askSheet({ title: `Replace what ${clash} of ${sel.length} lines already have?`, text: 'They already have a different value in a field you are applying. You can undo this afterwards.', actions: [{ label: 'Replace', value: true, kind: 'primary' }, { label: 'Cancel', value: false }] });
          if (!ok) return;
        }
        withUndo(`Applied to ${sel.length} ${sel.length === 1 ? 'line' : 'lines'}.`, sel.map((l) => l.id), () => {
          for (const l of sel) {
            setDraft(l.id, patch);
            if (Object.keys(extraPatch).length) setExtra(l.id, extraPatch);
            syncRow(l);
          }
        });
      }, 'button button--small') as HTMLButtonElement;
    syncApply = () => {
      apply.disabled = !anyField();
      apply.classList.toggle('button--outline', !anyField());
      applyNote.hidden = anyField();
    };
    const applyNote = h('span', { class: 'abar-note', text: 'Fill in at least one box to apply it.' });
    const showThose = button('Show those', () => {
      if (!chips.some((c) => c[0] === 'status' && c[1] === 'needswording')) chips.push(['status', 'needswording']);
      searchChange();
    }, 'button button--outline button--small');
    const step = (title: string, ...kids: (Node | null)[]) => h('div', { class: 'abar-step' }, h('h3', { text: title }), h('div', { class: 'abar-body' }, ...(kids.filter(Boolean) as Node[])));
    syncApply();
    bar.replaceChildren(
      h(
        'div',
        { class: 'abar-top' },
        h('span', { class: 'abar-count', text: `${sel.length} selected · ${ready} ready${needReason ? ` · ${needReason} need what it was for` : ''}` }),
        needReason ? showThose : null,
        h('span', { class: 'abar-spacer' }),
        button('Clear', () => table.resetRowSelection(), 'button button--outline button--small'),
      ),
      step('1 · Set for all', party, cat, words, apply, applyNote),
      step('2 · Or use suggestions', button('Accept suggestions', () => withUndo('Suggestions accepted.', sel.map((l) => l.id), () => { for (const l of sel) acceptRow(l, true); }), 'button button--outline button--small'), h('span', { class: `abar-note${weakGuesses ? ' abar-note--warn' : ''}`, text: `Fills empty cells only. It never replaces what you set.${weakGuesses ? ` ${weakGuesses} of these ${weakGuesses === 1 ? 'is a guess' : 'are guesses'}: check ${weakGuesses === 1 ? 'it' : 'them'} before posting.` : ''}` })),
      step('3 · Post', h('span', { class: 'abar-note', text: ready === 0 ? 'Needs a category and what it was for on at least one line.' : ready < sel.length ? `${sel.length - ready} ${plural(sel.length - ready)} not ready, and will stay as drafts. Posting asks you to confirm.` : 'Posting asks you to confirm first.' }), post),
    );
    bar.hidden = false;
    // Keep the last rows and the hint under the table clear of the docked bar.
    document.documentElement.style.setProperty('--abar-h', `${bar.offsetHeight}px`); // on the root: the toast sits outside .ledger
  }
  $('accept-all').addEventListener('click', () => {
    const todo = lines.filter((l) => editable(l) && hasGhost(l) && isStrong(l));
    const weak = lines.filter((l) => editable(l) && hasGhost(l) && !isStrong(l)).length;
    withUndo(`Filled in ${todo.length} ${todo.length === 1 ? 'line' : 'lines'}.${weak ? ` ${weak} weaker ${weak === 1 ? 'guess is' : 'guesses are'} left for you to check.` : ''} Nothing is posted yet.`, todo.map((l) => l.id), () => { for (const l of todo) acceptRow(l); });
  });

  // ---- posting: the second step, confirmed first
  let posting = false;
  async function postReady() {
    if (posting) return;
    const ready = selectedLines().filter(isReady);
    if (!ready.length) return;
    const lk = data!.lookups;
    const total = ready.reduce((n, l) => n + l.amountPaise, 0);
    const byCat = new Map<string, number>();
    for (const l of ready) byCat.set(nameOf(lk.categories, draftOf(l.id).categoryId), (byCat.get(nameOf(lk.categories, draftOf(l.id).categoryId)) ?? 0) + 1);
    const mix = [...byCat.entries()].map(([n, c]) => `${c} × ${n}`).join(', ');
    const noParty = ready.filter((l) => !draftOf(l.id).partyId && partyNeeded(draftOf(l.id).categoryId)).length;
    const unreviewed = ready.filter((l) => l.suggestion && (l.suggestion.confidence === 'low' || l.suggestion.confidence === 'none')).length;
    const ok = await askSheet({
      title: `Post ${ready.length} ${ready.length === 1 ? 'line' : 'lines'}?`,
      text: `Together ${rupees(total)}: ${mix}.${noParty ? `\n${noParty} have no party.` : ''}${unreviewed ? `\n${unreviewed} rest on a weak suggestion.` : ''}\n\nPosted lines cannot be edited, only refunded or reversed.`,
      actions: [{ label: 'Post them', value: true, kind: 'primary' }, { label: 'Cancel', value: false }],
    });
    if (!ok) return;
    posting = true; // a second press while this runs would send the same lines again
    lastUndo = null; // an earlier undo must not touch lines that are about to be posted
    const postButton = document.querySelector<HTMLButtonElement>('#actionbar .abar-post');
    if (postButton) postButton.disabled = true;
    let posted = 0;
    let flagged = 0;
    let dropped = false;
    const failed: { lineId: string; error: string }[] = [];
    try {
      for (let i = 0; i < ready.length; i += 10) {
        const chunk = ready.slice(i, i + 10);
        showToast(`Posting ${Math.min(i + 10, ready.length)} of ${ready.length}…`);
        const items = chunk.map((l) => {
          const dw = describedWith(l);
          return { lineId: l.id, categoryId: draftOf(l.id).categoryId, partyId: draftOf(l.id).partyId || null, nature: draftOf(l.id).nature.trim(), householdId: dw.unit || null, maintenanceYear: dw.year || null, projectId: dw.project || null };
        });
        let res: { status: number; data: any };
        try {
          res = await call('/api/finance-admin/ledger/post', 'POST', { items });
        } catch {
          // The connection dropped or the session ended. Whether this batch reached the server is not known, so these lines are not marked
          // posted here; the refresh below shows what the server holds. Nothing after this batch is sent.
          dropped = true;
          for (const l of ready.slice(i)) failed.push({ lineId: l.id, error: 'Not confirmed: the connection dropped. The list is being checked against the server.' });
          break;
        }
        const { status, data: out } = res;
        if (status !== 200) {
          for (const l of chunk) failed.push({ lineId: l.id, error: out?.error ?? 'Could not post this line.' });
          continue;
        }
        posted += out.posted;
        flagged += out.flagged;
        failed.push(...(out.failed as { lineId: string; error: string }[]));
      }
    } finally {
      posting = false;
    }
    const failedIds = new Set(failed.map((f) => f.lineId));
    const resumeAt = Math.max(0, Math.min(...ready.filter((l) => !failedIds.has(l.id)).map((l) => lines.indexOf(l)).filter((i) => i >= 0), lines.length));
    const nextSelection = { ...tstate.rowSelection };
    for (const l of ready) {
      if (failedIds.has(l.id)) continue;
      const d = draftOf(l.id);
      l.state = 'allocated';
      l.allocation = { categoryId: d.categoryId, partyId: d.partyId || null, nature: d.nature.trim(), count: 1, householdLabel: null, maintenanceYear: null };
      l.effective = { category: nameOf(data!.lookups.categories, d.categoryId), party: d.partyId ? nameOf(data!.lookups.parties, d.partyId) : '', nature: d.nature.trim() };
      l.missingParty = !d.partyId && partyNeeded(d.categoryId);
      l.suggestion = null;
      l.hay = hayOf(l);
      delete nextSelection[l.id];
      drafts.delete(l.id);
    }
    saveDraftsNow();
    tstate = { ...tstate, rowSelection: nextSelection };
    rowErrors.clear();
    for (const f of failed) rowErrors.set(f.lineId, f.error);
    postedThisSitting += posted;
    const summary = [`${posted} posted`, flagged ? `${flagged} sent to review` : '', failed.length ? (dropped ? `${failed.length} not confirmed because the connection dropped: check them in the refreshed list before posting again` : `${failed.length} could not be posted (see the red notes on those lines)`) : ''].filter(Boolean).join(', ') + '.';
    showToast(summary);
    if (failed.length || flagged) {
      const note = $('postnote');
      note.replaceChildren(h('span', { text: summary }), button('Dismiss', () => (note.hidden = true), 'button button--outline button--small'));
      note.hidden = false;
    }
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    applyView();
    if (lines.length) goToLine(Math.min(resumeAt, lines.length - 1), 'start');
    void load(true); // confirms against the server (it knows which lines went to review) without dimming the page
  }

  if (getToken()) void load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .ledger .lbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  /* The search box: chips inside the field, and the arrow that opens Filters / Group by / Favorites. */
  .ledger .lsearch {
    position: relative;
    flex: 1 1 360px;
    min-width: 0;
  }

  .ledger .sbox {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 40px;
    padding: 3px 4px 3px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
  }

  .ledger .sbox:focus-within {
    border-color: var(--tvc-orange);
    box-shadow: 0 0 0 3px var(--tvc-orange-tint);
  }

  .ledger .sbox-chips {
    display: contents;
  }

  .ledger .sbox input {
    flex: 1 1 60px;
    min-width: 50px;
    min-height: 32px;
    border: 0;
    outline: 0;
    background: none;
    color: var(--tvc-ink);
    font: inherit;
    padding: 0;
  }

  .ledger .sbox input:focus-visible {
    outline: 0;
  }

  .ledger .schip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    padding: 2px 2px 2px 9px;
    border-radius: 7px;
    background: var(--tvc-cream);
    color: var(--tvc-ink);
    font-size: var(--text-sm);
  }

  .ledger .schip--group {
    background: var(--tvc-green-tint);
  }

  .ledger .schip-kind {
    color: var(--tvc-ink-soft);
    margin-right: 3px;
  }

  .ledger .schip button,
  .ledger .sbox-caret {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    border-radius: 6px;
    color: var(--tvc-ink-soft);
  }

  .ledger .sbox-caret {
    min-width: 36px;
    min-height: 34px;
  }

  .ledger .schip button:hover,
  .ledger .sbox-caret:hover {
    background: var(--tvc-line);
  }

  .ledger .schip button:focus-visible,
  .ledger .sbox-caret:focus-visible,
  .ledger .sopt:focus-visible,
  .ledger .sopt-del:focus-visible,
  .ledger .ggroup-btn:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .spop {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-height: min(70vh, 540px);
    overflow-y: auto;
    padding: 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    box-shadow: var(--shadow-soft);
  }

  .ledger .spop[hidden] {
    display: none;
  }

  .ledger .spop h3 {
    margin: 0 0 6px;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .ledger .spop h4 {
    margin: 10px 0 2px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .ledger .spop .hint {
    margin: 6px 6px 0;
    font-size: var(--text-sm);
  }

  .ledger .sopt {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 34px;
    padding: 4px 6px;
    border-radius: 7px;
    font-size: var(--text-sm);
  }

  .ledger .sopt:hover {
    background: var(--tvc-cream);
  }

  .ledger .sopt-tick {
    flex: none;
    width: 16px;
    color: var(--tvc-green-dark);
    font-weight: 700;
  }

  .ledger .sopt-extra {
    margin-left: auto;
    color: var(--tvc-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .ledger .sfav {
    display: flex;
    align-items: center;
  }

  .ledger .sfav .sopt {
    flex: 1;
  }

  .ledger .sopt-del {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    text-align: center;
    line-height: 32px;
    border-radius: 6px;
    color: var(--tvc-ink-soft);
  }

  .ledger .sopt-del:hover {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .ledger .ssave {
    display: flex;
    gap: 6px;
    margin-top: 10px;
  }

  .ledger .ssave input {
    flex: 1;
    min-width: 0;
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 8px;
  }

  /* A group heading in the list. Same absolute placement as a line. */
  .ledger .lgroup {
    display: flex;
    align-items: center;
    padding-right: 14px;
    gap: 10px;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--tvc-line);
    background: var(--tvc-cream);
  }

  .ledger .lgroup--2 {
    background: var(--tvc-white);
  }

  .ledger .lgroup.is-closed .ggroup-label {
    color: var(--tvc-ink-soft);
  }

  .ledger .ggroup-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    gap: 10px;
    min-height: 44px;
    padding: 6px 14px;
    font-weight: 650;
  }

  .ledger .lgroup--2 .ggroup-btn {
    padding-left: 34px;
    font-weight: 600;
  }

  .ledger .ggroup-tri {
    flex: none;
    width: 14px;
    transition: transform 0.15s;
  }

  .ledger .lgroup.is-open .ggroup-tri {
    transform: rotate(90deg);
  }

  .ledger .ggroup-count {
    color: var(--tvc-ink-soft);
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .ledger .ggroup-net {
    margin-left: auto;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger .ggroup-tri {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .ledger .spop {
      grid-template-columns: 1fr;
    }
  }

  .ledger .twostep {
    margin: 0 0 10px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  /* A queue count in the progress line: a button that shows just those lines. */
  .ledger .qlink {
    font: inherit;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .ledger .qlink[aria-pressed='true'] {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }

  .ledger .qlink:focus-visible {
    outline: 3px solid var(--tvc-green);
    outline-offset: 2px;
  }

  .ledger .progress {
    margin: 0 0 10px;
    color: var(--tvc-ink-soft);
    font-size: var(--text-sm);
    min-height: 1.4em;
  }

  .ledger .grid {
    overflow-x: auto;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
  }

  /* The shell gives every .hint a -8px top margin (it tucks under a heading); under the table that put the text on top of the last row. */
  .ledger #ledger-end,
  .ledger #empty {
    margin-top: 12px;
  }

  /* The same shell margin made the second sentence of a note ("They are selected: press Post…") float above the first. */
  .ledger .postnote .hint {
    margin: 0;
  }

  /* Working: the table dims and a bar runs along its top while the lines are fetched. */
  .ledger .grid {
    position: relative;
  }

  .ledger .grid.is-loading .gscroll {
    opacity: 0.5;
    pointer-events: none;
  }

  .ledger .grid.is-loading::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    height: 3px;
    width: 40%;
    background: var(--tvc-green);
    animation: ledger-slide 1.1s ease-in-out infinite;
  }

  @keyframes ledger-slide {
    from {
      left: -40%;
    }

    to {
      left: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger .grid.is-loading::before {
      animation: none;
      width: 100%;
    }
  }

  .ledger input:focus-visible,
  .ledger select:focus-visible,
  .abar input:focus-visible,
  .abar select:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .tips {
    margin: 0 0 12px;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-surface);
    font-size: var(--text-sm);
  }

  .ledger .tips p {
    margin: 0 0 6px;
  }

  .ledger .tips .tips-title {
    margin: 0 0 6px;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .ledger .tips .tips-tree {
    margin: 0 0 8px;
  }

  .ledger .tips .tips-tree ul {
    margin: 2px 0 6px;
  }

  .ledger .tips ul {
    margin: 0;
    padding-left: 1.2em;
  }

  .ledger .tips code {
    font-size: inherit;
    padding: 1px 4px;
    border-radius: 4px;
    background: var(--tvc-line);
  }

  .ledger .tips[hidden] {
    display: none;
  }

  .ledger .skiplink {
    position: absolute;
    left: -9999px;
    top: 0;
  }

  .ledger .skiplink:focus {
    position: static;
    display: inline-block;
    margin: 0 0 8px;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--tvc-surface);
    border: 1px solid var(--tvc-line-strong);
  }

  .ledger .list-title {
    margin: 26px 0 8px 14px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .ledger.section dialog.sheet {
    width: min(620px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }

  .ledger.section dialog.sheet .sheet-actions {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .ledger .sheet .hint,
  .ledger .sheet .note {
    margin: 10px 0;
    font-size: var(--text-sm);
  }


  .ledger .suggest-note {
    margin: 10px 0;
  }

  .ledger .suggest-note .field-label {
    margin: 0 0 4px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .ledger .why {
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .ledger .new-party {
    padding: 10px 12px;
    border: 1px dashed var(--tvc-line-strong);
    border-radius: var(--radius-sm);
  }

  .ledger .alloc-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* A fieldset will not shrink below its widest child, and a select is as wide as its longest option ("Refund of" has long ones), which
     pushed the whole sheet wider than a phone. Let them shrink; the select shows its text cut off. */
  .ledger .alloc-edit {
    min-width: 0;
  }

  .ledger .alloc-edit label,
  .ledger .alloc-edit .stack-form,
  .ledger .alloc-edit select,
  .ledger .alloc-edit input {
    min-width: 0;
    max-width: 100%;
  }

  .ledger .alloc-edit {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .ledger .alloc-edit .alloc-top.stack-form {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px;
  }

  .ledger .alloc-edit .alloc-top.stack-form > label {
    flex: 1 1 9rem;
  }

  .ledger .more summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 4px 0;
  }

  .ledger .more > .stack-form {
    margin-top: 8px;
  }

  .ledger .editor-tools {
    margin: 12px 0 0;
  }

  .ledger .remaining {
    margin: 12px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ledger .remaining--ok {
    color: var(--tvc-green);
  }

  .ledger .remaining--over {
    color: var(--tvc-error-text);
  }

  @media (max-width: 560px) {
    .ledger.section dialog.sheet .sheet-actions .button {
      flex: 1 1 auto;
    }
  }

  .ledger .sortpick {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
  }

  .ledger .sortpick select {
    min-height: 36px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    padding: 4px 8px;
  }

  .ledger .postnote {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 10px;
    padding: 10px 14px;
    border: 1px solid var(--tvc-error-border);
    border-radius: var(--radius);
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .ledger .applyprompt {
    border-color: var(--tvc-line-strong);
    background: var(--tvc-surface);
    color: var(--tvc-ink);
  }

  .ledger .postnote[hidden] {
    display: none;
  }

  .ledger .colfilter[aria-invalid='true'] {
    border-color: var(--tvc-error-border);
  }

  .ledger .ghead,
  .ledger .gfilter,
  .ledger .lrow {
    display: grid;
    grid-template-columns: var(--ledger-cols, 34px 76px 136px 112px minmax(160px, 1fr) minmax(160px, 1fr) 124px);
    align-items: center;
    gap: 10px;
    padding: 4px 14px;
  }

  .ledger .ghead,
  .ledger .gfilter,
  .ledger .gscroll {
    min-width: 920px;
  }

  .ledger .ghead {
    background: var(--tvc-surface);
    border-bottom: 1px solid var(--tvc-line);
    font-weight: 650;
    font-size: var(--text-sm);
  }

  .ledger .gfilter {
    border-bottom: 1px solid var(--tvc-line);
  }

  .ledger .sorthead {
    all: unset;
    cursor: pointer;
    font-weight: 650;
    padding: 6px 2px;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  /* The ▾ in a heading (Sort, Group by): quiet until the heading is hovered or focused, and always there on a touch screen. */
  /* The Date heading is only 76px wide: its words, its sort arrow and the ▾ stay on one line. */
  .ledger .ghead .gcell {
    white-space: nowrap;
  }

  .ledger .ghead .hmenu {
    width: 20px;
    height: 24px;
    margin-inline-start: 0;
    border-color: transparent;
    background: none;
    color: var(--tvc-ink-soft);
    vertical-align: middle;
    opacity: 0;
  }

  .ledger .ghead .gcell:hover .hmenu,
  .ledger .ghead .gcell:focus-within .hmenu,
  .ledger .ghead .hmenu[aria-expanded='true'] {
    opacity: 1;
  }

  @media (pointer: coarse) {
    .ledger .ghead .hmenu {
      opacity: 1;
    }
  }

  /* The keyboard's cell cursor (scripts/lib/cell-nav.mjs). */
  .ledger .lrow .gcell[data-col]:focus-visible {
    outline: 2px solid var(--tvc-green);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .ledger .sorthead:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .colfilter,
  .ledger .cellfield {
    width: 100%;
    min-height: 36px;
    box-sizing: border-box;
    border: 1px solid var(--tvc-line-strong);
    border-radius: 6px;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    padding: 4px 8px;
  }

  .ledger .cellfield.ghost,
  .ledger .cellfield.ghost::placeholder {
    font-style: italic;
    color: var(--tvc-ink-soft);
  }

  .ledger .gscroll {
    position: relative;
    height: min(62vh, 760px);
    min-height: 320px;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .ledger .gspacer {
    position: relative;
    width: 100%;
  }

  .ledger .lrow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--tvc-line);
    background: var(--tvc-white);
  }

  .ledger .lrow.is-selected {
    background: var(--tvc-green-tint);
  }

  .ledger .fp-list { max-height: 50vh; overflow-y: auto; }
  .ledger .fp-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-block: 10px; }
  .ledger .fp-tabs [aria-pressed='true'] { background: var(--tvc-green); border-color: var(--tvc-green); color: var(--tvc-white); }
  .ledger .fp-row { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.4fr) auto; gap: 8px 14px; align-items: center; }
  .ledger .fp-row.is-done, .ledger li.is-done .fp-row { background: var(--tvc-green-tint); }
  @media (max-width: 640px) { .ledger .fp-row { grid-template-columns: 1fr; } }
  .ledger .lrow.is-locked .gcell--party,
  .ledger .lrow.is-locked .gcell--category,
  .ledger .lrow.is-locked .gcell--status { user-select: none; }
  .ledger .pill-button { all: unset; cursor: pointer; border-radius: 999px; }
  .ledger .pill-button:focus-visible { outline: 2px solid var(--tvc-green); outline-offset: 2px; }
  .ledger .lrow.is-locked {
    color: var(--tvc-ink-soft);
  }

  /* The box is drawn small whatever the screen; the finger-sized target on touch screens is an invisible extension of it, so the
     box itself never grows. */
  .ledger .lrow input[type='checkbox'],
  .ledger .ghead input[type='checkbox'] {
    appearance: none;
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    border: 2px solid var(--tvc-line-strong);
    border-radius: 5px;
    background: var(--tvc-white);
    cursor: pointer;
  }

  .ledger .lrow input[type='checkbox']::before,
  .ledger .ghead input[type='checkbox']::before {
    content: '';
    position: absolute;
    inset: -12px;
  }

  .ledger .lrow input[type='checkbox']:checked,
  .ledger .ghead input[type='checkbox']:checked {
    border-color: var(--tvc-green);
    background: var(--tvc-green);
  }

  .ledger .lrow input[type='checkbox']:checked::after,
  .ledger .ghead input[type='checkbox']:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--tvc-white);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .ledger .lrow input[type='checkbox']:focus-visible,
  .ledger .ghead input[type='checkbox']:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  main .ledger.section .select-all-btn {
    display: none;
  }

  .ledger .gcell {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ledger .gcell--narration {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .ledger .narr {
    all: unset;
    cursor: pointer;
    font-weight: 500;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
    overflow-wrap: anywhere;
    min-height: 24px;
    color: var(--tvc-ink);
  }

  .ledger .narr:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .detail {
    display: block;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ledger .detail--upi,
  .ledger .detail--unit {
    color: var(--tvc-ink);
  }

  .ledger .detail--unit,
  .ledger .detail--wrap {
    white-space: normal;
  }

  .ledger .detail--dim {
    font-style: italic;
  }

  /* On a wide screen the Origin column says it; the label under the narration is for the phone cards. */
  .ledger .detail--origin {
    display: none;
    color: var(--tvc-ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .ledger .detail--note {
    color: var(--tvc-ink);
  }

  /* The wording a payment request or logged spend gave, until a person writes a note (as a suggestion shows). */
  .ledger .detail--given {
    font-style: italic;
  }

  .ledger .detail--reversal {
    all: unset;
    cursor: pointer;
    color: var(--tvc-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--tvc-line-strong);
  }

  .ledger .detail--reversal:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .ledger .badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* A source badge is a small icon in a circle, as in a payment app's receipt: no border, the name on hover. A badge with no logo yet
     is its short name in quiet text. */
  .ledger .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--tvc-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  .ledger .badge--icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--tvc-white);
    box-shadow: 0 0 0 1px var(--tvc-line);
  }

  .ledger .badge--text {
    padding: 0 4px;
    color: var(--tvc-ink-soft);
