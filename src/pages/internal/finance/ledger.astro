    const narr = h('button', { class: 'narr', text: shortNarration(l.narration), attrs: { type: 'button', title: l.account ? `${l.narration}\n${l.account}` : l.narration } }) as HTMLButtonElement;
    narr.addEventListener('click', () => void openLine(l.id));
    const dateBtn = h('button', { class: 'datebtn', text: shortDate(l.date), attrs: { type: 'button', title: `Open this line: ${l.narration}`, 'aria-label': `Open the line of ${shortDate(l.date)}: ${who}` } }) as HTMLButtonElement;
    dateBtn.addEventListener('click', () => void openLine(l.id));
    const details = h('span', { class: 'detail' });

    // Linked pickers, not drop-downs: category > year > unit (maintenance) or > project (capital), and kind > party. You type to search the rows being shown, a row
    // marked ⟹ opens the next level, and a name that is not in the list can be added from it.
    const cat = linkedPicker({ nodes: [], blank: 'Choose…', ariaLabel: `Category for ${who}`, rootLabel: 'All categories' }) as ComboEl;
    cat.addEventListener('change', () => {
      const path = cat.path;
      const type = typeOfCategory(path[0] ?? '');
      const got = readCategoryPath(path, type);
      if (got.year) setExtra(l.id, { maintenanceYear: got.year });
      if (got.householdId) setExtra(l.id, { householdId: got.householdId });
      if (type === 'capex') setExtra(l.id, { projectId: got.projectId });
      // Choosing only a year or unit leaves the category as it was: no "apply to the others" prompt for a category that did not change.
      if (got.categoryId === draftOf(l.id).categoryId) syncRow(l);
      else edit(l, 'categoryId', got.categoryId);
      // On to who paid, when nobody is chosen yet.
      if (got.categoryId && !draftOf(l.id).partyId) setTimeout(() => party.focus(), 0);
    });
    const catTick = tick(`Accept the suggested category for ${who}`, () => edit(l, 'categoryId', ghostOf(l, 'categoryId')));
    const catText = h('span', { class: 'lcell-text' });
    const catHint = h('span', { class: 'follow-hint follow-hint--warn', attrs: { hidden: '' } });

    const party = linkedPicker({
      nodes: [],
      blank: 'No one in particular',
      ariaLabel: `Party for ${who}`,
      rootLabel: 'All kinds',
      addNew: { label: 'Add as a new party', onAdd: (typed) => openAddParty(typed || strangerOf(l), kindFor(l), (id) => afterPartyAdded(l, id)), blockedAt: (path) => (path[0] === 'member' || path[0] === 'unit' ? NO_MEMBER_ADD : null) },
    }) as ComboEl;
    party.addEventListener('change', () => edit(l, 'partyId', party.value)); // the party is the last part of the path (kind, then the party)
    const partyTick = tick(`Accept the suggested party for ${who}`, async () => {
      const gp = ghostOf(l, 'partyId');
      if (gp) return edit(l, 'partyId', gp);
      const stranger = strangerOf(l);
      const id = stranger ? await createParty(stranger, kindFor(l)) : null;
      if (id) afterPartyAdded(l, id);
    });
    const partyText = h('span', { class: 'lcell-text' });

    const nature = h('input', { class: 'cellfield', attrs: { type: 'text', 'aria-label': `What it was for: ${who}`, placeholder: 'What it was for', autocomplete: 'off' } }) as HTMLInputElement;
    nature.addEventListener('input', () => {
      setDraft(l.id, { nature: nature.value });
      syncRow(l);
    });
    nature.addEventListener('change', () => offerToOthers(l, 'nature', nature.value));
    const natureTick = tick(`Accept the suggested wording for ${who}`, () => edit(l, 'nature', ghostOf(l, 'nature')));
    const natureText = h('span', { class: 'lcell-text' });
    const pillSlot = h('span', { class: 'pillslot' });
    // A line at rest is one quiet row of text. The fields appear when the line is ticked, has something typed in it, or is opened
    // (click its category or party, or Tab to it).
    const peek = () => h('button', { class: 'peek', attrs: { type: 'button' } }) as HTMLButtonElement;
    const catPeek = peek();
    const partyPeek = peek();
    const meta = h('span', { class: 'gcell gcell--meta', attrs: { role: 'cell' } });

    const rowEl = h(
      'div',
      { class: 'lrow', attrs: { role: 'row', 'data-id': l.id } },
      cell('select', '', check),
      cell('date', '', dateBtn),
      cell(`amount amount--${l.direction}`, '', document.createTextNode(`${l.direction === 'debit' ? '−' : '+'}${rupees(l.amountPaise)}`)),
      cell('category', 'Category', catPeek, cat, catTick, catText, catHint),
      cell('party', l.direction === 'debit' ? 'Paid to' : 'Received from', partyPeek, party, partyTick, partyText),
      cell('status', '', pillSlot),
      cell('narration', '', narr, details),
      meta,
    );
    const natureCell = cell('nature', 'What it was for', nature, natureTick, natureText);
    rowEl.append(natureCell);
    const open = (focus: HTMLElement) => {
      rowEl.dataset.open = '1';
      fill(rowEl, l);
      focus.focus();
    };
    catPeek.addEventListener('click', () => open(cat));
    partyPeek.addEventListener('click', () => open(party));
    // Leaving the line closes it again, unless it has something in it that must stay visible.
    // (Checked a moment later: hiding the button that was clicked blurs it before the field takes focus.)
    rowEl.addEventListener('focusout', () => {
      setTimeout(() => {
        if (rowEl.contains(document.activeElement) || !rowEl.dataset.open) return;
        delete rowEl.dataset.open;
        fill(rowEl, l);
      }, 0);
    });
    const onKey = (e: KeyboardEvent) => {
      const index = lines.findIndex((x) => x.id === l.id);
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        acceptRow(l);
        focusRow(index + 1, 'categoryId');
      } else if (e.altKey && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        e.preventDefault();
        const field: Field = e.target === nature ? 'nature' : e.target === party.input ? 'partyId' : 'categoryId';
        const step = e.key === 'ArrowDown' ? 1 : -1;
        focusRow(index + step, field, step);
      } else if (e.key === 'Tab') {
        // Only some lines exist in the page, so Tab from the last control of a line goes to the next line (and Shift+Tab back to the one above).
        const stops = [...(rowEl as HTMLElement).querySelectorAll<HTMLElement>('input, select, button')].filter((x) => !(x as HTMLInputElement).disabled && !x.hidden && x.offsetParent !== null);
        if (!e.shiftKey && e.target === stops[stops.length - 1] && index < lines.length - 1) {
          e.preventDefault();
          goToLine(index + 1, 'start');
        } else if (e.shiftKey && e.target === stops[0] && index > 0) {
          e.preventDefault();
          goToLine(index - 1, 'end');
        }
      } else if (e.key === 'Enter' && e.target === nature) {
        e.preventDefault();
        focusRow(index + 1, 'nature');
      }
    };
    rowEl.addEventListener('keydown', onKey);
    // Double-click a cell of a line that cannot be edited in its row: a posted line with no party gets its party picker right there; anything else (partly
    // allocated, flagged, posted) opens its sheet. Lines that can be edited in the row keep the single click.
    rowEl.addEventListener('dblclick', (e: MouseEvent) => {
      const now = byId.get(l.id) ?? l;
      if (editable(now) || !data?.canAllocate || (e.target as HTMLElement).closest('button, input, a, .combo')) return;
      if (now.missingParty && now.state === 'allocated' && partyText.contains(e.target as Node)) void editPartyInline(now, partyText);
      else void openLine(l.id);
    });
    refs.set(rowEl, { catHint, check, narr, details, cat, catTick, catText, party, partyTick, partyText, nature, natureTick, natureText, pillSlot, catPeek, partyPeek, natureCell, meta });
    fill(rowEl, l);
    return rowEl;
  }

  function pillFor(l: Line): HTMLElement {
    if (l.review) return pill('To review', 'crit');
    if (l.state === 'allocated') return l.missingParty ? pill('No party', 'crit') : pill('Posted', 'ok');
    if (l.state === 'partly_allocated') return pill('Partly', 'warn');
    if (!editable(l)) return pill('To allocate');
    const d = draftOf(l.id);
    const dwNow = describedWith(l);
    if (dwNow.maintenance && !dwNow.unit) return pill('Needs unit', 'warn');
    if (isReady(l)) {
      return !d.partyId && partyNeeded(d.categoryId) ? pill('Ready, no party', 'warn') : pill('Ready', 'ok');
    }
    if (hasGhost(l)) {
      // Says what is suggested and how sure the app is; the suggested values are the italic ones in the cells.
      const fields = [ghostOf(l, 'categoryId') ? 'category' : '', ghostOf(l, 'partyId') || strangerOf(l) ? (l.direction === 'debit' ? 'who was paid' : 'who paid') : '', ghostOf(l, 'nature') ? 'wording' : ''].filter(Boolean);
      const sure = CONFIDENCE_WORDS[l.suggestion?.confidence ?? ''] ?? 'a guess';
      const p = pill(isStrong(l) ? 'Suggested' : 'A guess', 'warn');
      p.title = `Suggested ${fields.join(', ')} (${sure}), shown in italics. Tick a value to accept it; nothing is saved until you tick the line and press Post.`;
      return p;
    }
    return pill(d.categoryId ? 'Needs wording' : 'Needs category');
  }

  // Sets every cell of a mounted row from the line and its draft, without replacing any element.
  function fill(el: HTMLElement, l: Line) {
    const r = refs.get(el)!;
    const lk = data!.lookups;
    const can = editable(l);
    const d = draftOf(l.id);
    el.classList.toggle('is-locked', !can);
    el.classList.toggle('is-selected', Boolean(tstate.rowSelection[l.id]));
    r.check.disabled = !can;
    r.check.checked = Boolean(tstate.rowSelection[l.id]);
    const upiSays = [l.counterparty, l.remark ? `“${l.remark}”` : ''].filter(Boolean).join(' · ');
    const error = rowErrors.get(l.id);
    r.details.replaceChildren(
      ...[
        error ? h('span', { class: 'detail detail--warn', text: error }) : null,
        l.state === 'partly_allocated' ? h('span', { class: 'detail detail--warn detail--wrap', text: `${rupees(l.amountPaise - l.allocatedPaise)} still to allocate: open the line to finish` }) : null,
        upiSays ? h('span', { class: 'detail detail--upi', text: `Paytm: ${upiSays}`, attrs: { title: 'From the Paytm UPI report' } }) : /\bUPI\b/i.test(l.narration) ? h('span', { class: 'detail detail--dim', text: 'No Paytm record for this payment' }) : null,
      ].filter(Boolean) as Node[],
    );
    // Ticking is for the bar at the bottom (one change to many lines), so a ticked line stays a quiet row; only opening a line (click its category or party) or an error expands it.
    const active = can && (Boolean(error) || el.dataset.open === '1');
    el.classList.toggle('is-active', active);
    for (const x of [r.cat, r.party, r.nature]) x.hidden = !active;
    const dw = describedWith(l);
    // The pickers' trees are rebuilt only when what they depend on changes: the payer's own unit (offered first in the unit list) and, for the party list, the unit
    // being paid for (its people come first). The line's date and the lists never change while it is on screen.
    if (r.cat.dataset.treeKey !== dw.suggestedUnit) {
      r.cat.dataset.treeKey = dw.suggestedUnit;
      r.cat.setNodes(categoryNodes({ categories: lk.categories, households: lk.households, projects: lk.projects, date: l.date, suggestedUnit: dw.suggestedUnit }));
    }
    const unitForList = dw.maintenance ? dw.unit : '';
    if (r.party.dataset.unitFor !== unitForList) {
      r.party.dataset.unitFor = unitForList;
      r.party.setNodes(partyNodes({ parties: lk.parties, unitId: unitForList, unitLabels: unitLabels() }));
    }
    // Where each list opens: a maintenance category without its year and unit opens on the years; the party list opens on the people of the unit being paid for,
    // or on the kind that goes with the category (members for nothing in particular: the top, all kinds).
    r.cat.setStartAt(() => {
      const x = describedWith(l);
      return x.maintenance && !x.unit ? [draftOf(l.id).categoryId] : null;
    });
    r.party.setStartAt(() => {
      const x = describedWith(l);
      return partyStart({ categoryType: typeOfCategory(categoryShown(l)), unitId: x.unit, unitHasPeople: lk.parties.some((q) => q.household_id === x.unit && !q.former_since), parties: lk.parties });
    });
    r.catHint.hidden = !(active && dw.maintenance && !dw.unit);
    if (!r.catHint.hidden) {
      const p = partyById(d.partyId);
      r.catHint.textContent = dw.suggestedUnit ? `${p?.name ?? 'The payer'} lives in ${unitLabels().get(dw.suggestedUnit) ?? 'a unit'}, which is listed first. Choose the year, then the unit.` : 'Choose the year, then which unit’s maintenance this is. Whoever paid, it is booked to the unit.';
    }
    for (const x of [r.catPeek, r.partyPeek]) x.hidden = !(can && !active);
    for (const x of [r.catText, r.partyText]) x.hidden = can;
    r.natureText.hidden = can;
    r.natureCell.hidden = can ? !active : true;
    if (can) {
      const gc = ghostOf(l, 'categoryId');
      r.cat.path = categoryPath({ categoryId: d.categoryId, type: dw.type, year: dw.year, unit: dw.unit, project: dw.project });
      r.cat.setPlaceholder(gc ? nameOf(lk.categories, gc) : null);
      r.cat.classList.toggle('ghost', Boolean(gc));
      r.catTick.hidden = !(gc && active);
      const gp = ghostOf(l, 'partyId');
      const stranger = strangerOf(l);
      r.party.path = partyPath(partyById(d.partyId));
      r.party.setPlaceholder(gp ? nameOf(lk.parties, gp) : stranger ? `New: ${stranger}` : null);
      r.party.classList.toggle('ghost', Boolean(gp || stranger));
      r.partyTick.hidden = !((gp || stranger) && active);
      const tickLabel = gp ? `Accept the suggested party for ${l.narration.slice(0, 40)}` : `Add ${stranger} to the register and use them`;
      r.partyTick.setAttribute('aria-label', tickLabel);
      r.partyTick.title = tickLabel;
      const gn = ghostOf(l, 'nature');
      if (r.nature.value !== d.nature && document.activeElement !== r.nature) r.nature.value = d.nature;
      r.nature.placeholder = gn || 'What it was for';
      r.nature.classList.toggle('ghost', Boolean(gn));
      r.natureTick.hidden = !(gn && active);
      if (!active) {
        r.catPeek.textContent = d.categoryId ? `${nameOf(lk.categories, d.categoryId)}${dw.maintenance && dw.unit ? ` · ${unitLabels().get(dw.unit) ?? ''} · ${dw.year}` : dw.capital && dw.project ? ` · ${lk.projects.find((p) => p.id === dw.project)?.name ?? ''}` : ''}` : gc ? nameOf(lk.categories, gc) : 'Choose…';
        r.catPeek.classList.toggle('ghost', !d.categoryId);
        r.catPeek.setAttribute('aria-label', `Category for ${l.narration.slice(0, 40)}: ${r.catPeek.textContent}. Press to edit.`);
        r.partyPeek.textContent = d.partyId ? nameOf(lk.parties, d.partyId) : gp ? nameOf(lk.parties, gp) : stranger ? `New: ${stranger}` : 'No one in particular';
        r.partyPeek.classList.toggle('ghost', !d.partyId);
        r.partyPeek.setAttribute('aria-label', `Party for ${l.narration.slice(0, 40)}: ${r.partyPeek.textContent}. Press to edit.`);
      }
    } else {
      for (const t of [r.catTick, r.partyTick, r.natureTick]) t.hidden = true;
      const a = l.allocation;
      const forWhom = [a?.householdLabel ? `Unit ${a.householdLabel}` : '', a?.maintenanceYear ?? ''].filter(Boolean).join(' · ');
      r.catText.replaceChildren(document.createTextNode(a ? `${nameOf(lk.categories, a.categoryId)}${a.count > 1 ? ` +${a.count - 1} more` : ''}` : ''), ...(forWhom ? [h('span', { class: 'detail detail--unit', text: forWhom })] : []));
      r.partyText.replaceChildren(a?.partyId ? document.createTextNode(nameOf(lk.parties, a.partyId)) : l.missingParty ? h('span', { class: 'noparty', text: 'No party' }) : document.createTextNode(''));
      r.natureText.textContent = a?.nature ?? '';
    }
    // A line that cannot be edited in its row (partly allocated, flagged, or posted without a party) is finished or fixed in its sheet:
    // its pill opens it, so the way in is visible and not only the narration.
    const pillNode = pillFor(l);
    if (!can && data!.canAllocate && (l.review || l.state === 'partly_allocated' || l.missingParty)) {
      const open = h('button', { class: 'pill-button', text: '', attrs: { type: 'button', title: l.state === 'partly_allocated' ? 'Open to finish allocating this line' : l.missingParty ? 'Open to add the missing party' : 'Open to review' } }) as HTMLButtonElement;
      open.append(pillNode);
      open.addEventListener('click', () => void openLine(l.id));
      r.pillSlot.replaceChildren(open);
    } else r.pillSlot.replaceChildren(pillNode);
    // On a phone a line at rest is two lines: the narration and amount, then date, category and party in one grey line.
    const catWords = can ? (d.categoryId ? nameOf(lk.categories, d.categoryId) : ghostOf(l, 'categoryId') ? nameOf(lk.categories, ghostOf(l, 'categoryId')) : '') : l.allocation ? nameOf(lk.categories, l.allocation.categoryId) : '';
    const partyWords = can ? (d.partyId ? nameOf(lk.parties, d.partyId) : '') : l.allocation?.partyId ? nameOf(lk.parties, l.allocation.partyId) : '';
    r.meta.textContent = [catWords, partyWords].filter(Boolean).join(' · ') || 'Nothing chosen yet';
  }
  const syncRow = (l: Line) => {
    const el = mounted.get(l.id);
    if (el) fill(el, l);
    renderBar();
    renderDraftNote();
    renderFillButton();
  };
  function renderFillButton() {
    const btn = $('accept-all');
    const strong = lines.filter((l) => editable(l) && hasGhost(l) && isStrong(l)).length;
    btn.hidden = !(data?.canAllocate && chips.some((c) => c[0] === 'status' && c[1] === 'unallocated') && strong > 0);
    btn.textContent = `Fill in ${strong} confident ${strong === 1 ? 'suggestion' : 'suggestions'}`;
  }
  // Lines that are filled in but not posted, with the one step that is left. Rebuilt only when what it says changes.
  let draftNoteKey = '';
  function renderDraftNote() {
    const box = $('draftnote');
    const ready = lines.filter((l) => editable(l) && isReady(l));
    const unticked = ready.filter((l) => !tstate.rowSelection[l.id]);
    const key = `${ready.length}:${unticked.length}`;
    if (key === draftNoteKey) return;
    draftNoteKey = key;
    if (!ready.length) {
      box.hidden = true;
      return;
    }
    box.replaceChildren(
      h('span', { text: `${ready.length} ${ready.length === 1 ? 'line is' : 'lines are'} filled in but not posted yet.` }),
      unticked.length
        ? button(`Select ${unticked.length === ready.length ? 'them' : `the other ${unticked.length}`} to post`, () => {
            const next = { ...tstate.rowSelection };
            for (const l of ready) next[l.id] = true;
            table.setRowSelection(next);
          }, 'button button--small')
        : h('span', { class: 'hint', text: 'They are ticked: press Post in the bar at the bottom.' }),
    );
    box.hidden = false;
  }
  function edit(l: Line, field: Field, value: string) {
    setDraft(l.id, { [field]: value } as Partial<Draft>);
    syncRow(l);
    offerToOthers(l, field, value);
  }
  // A bulk change can be undone: the drafts of the lines it touches are kept first, and the toast offers to put them back.
  // Ctrl+Z (Cmd+Z) undoes the last bulk change for two minutes, so it does not depend on reaching a toast that disappears.
  let lastUndo: { at: number; run: () => void } | null = null;
  function withUndo(message: string, ids: string[], change: () => void) {
    const before = new Map(ids.map((id) => [id, drafts.has(id) ? { ...drafts.get(id)! } : null]));
    change();
    const undo = () => {
      if (lastUndo?.run === undo) lastUndo = null;
      for (const [id, d] of before) {
        const l = byId.get(id);
        if (l && !editable(l)) continue; // already posted since: leave it alone
        if (d) drafts.set(id, d);
        else drafts.delete(id);
        if (l) syncRow(l);
      }
      persistDrafts();
      renderDraftNote();
    };
    lastUndo = { at: Date.now(), run: undo };
    showToast(message, undo);
  }
  document.addEventListener('keydown', (e) => {
    if (!(e.ctrlKey || e.metaKey) || e.shiftKey || e.key.toLowerCase() !== 'z') return;
    if ((e.target as HTMLElement).matches?.('input[type=text], input[type=search], textarea')) return; // those keep their own undo
    if (!lastUndo || Date.now() - lastUndo.at > 120000) return;
    e.preventDefault();
    lastUndo.run();
    showToast('Undone.');
  });
  // Changing a cell on a line that is ticked, with others ticked too, asks whether to set the same on all of them (never silently).
  function offerToOthers(l: Line, field: Field, value: string) {
    const box = $('applyprompt');
    const others = selectedLines().filter((x) => x.id !== l.id);
    if (!value || !tstate.rowSelection[l.id] || !others.length) {
      box.hidden = true;
      return;
    }
    const lk = data!.lookups;
    const clash = others.filter((x) => draftOf(x.id)[field] && draftOf(x.id)[field] !== value).length;
    const what = field === 'categoryId' ? `category ${nameOf(lk.categories, value)}` : field === 'partyId' ? `party ${nameOf(lk.parties, value)}` : `the wording “${value}”`;
    box.replaceChildren(
      h('span', { text: `Also set ${what} on the other ${others.length} selected ${others.length === 1 ? 'line' : 'lines'}?${clash ? ` ${clash} already ${clash === 1 ? 'has' : 'have'} a different value, which would be replaced.` : ''}` }),
      button('Apply', () => {
        box.hidden = true;
        withUndo(`Applied to ${others.length} ${others.length === 1 ? 'line' : 'lines'}.`, others.map((x) => x.id), () => {
          for (const x of others) {
            setDraft(x.id, { [field]: value } as Partial<Draft>);
            syncRow(x);
          }
        });
      }, 'button button--small'),
      button('No', () => (box.hidden = true), 'button button--outline button--small'),
    );
    box.hidden = false;
  }
  // ---- adding a party that is not in the register, from the cell or the suggestion
  const PARTY_KINDS: Record<string, string> = { vendor: 'Vendor', customer: 'Customer', member: 'Member', employee: 'Employee', bank: 'Bank', government: 'Government', director: 'Director', other: 'Other' };
  const kindFor = (l: Line) => (l.direction === 'credit' ? 'customer' : 'vendor');
  async function createParty(name: string, kind: string): Promise<string | null> {
    const typed = name.trim().replace(/\s+/g, ' ');
    const twin = data!.lookups.parties.find((x) => x.name.toLowerCase() === typed.toLowerCase());
    if (twin) return twin.id;
    const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: typed, kind });
    if (status !== 201) {
      showToast(out?.error ?? 'Could not add that party.');
      return null;
    }
    const lk = data!.lookups;
    lk.parties.push({ id: out.party.id, name: out.party.name, kind: out.party.kind });
    lk.parties.sort((a, b) => a.name.localeCompare(b.name));
    showToast(`${out.party.name} added to the register. Add their bank details on the Parties page.`);
    return out.party.id as string;
  }
  function openAddParty(name: string, kind: string, onAdded: (id: string) => void) {
    const dlg = $<HTMLDialogElement>('party-sheet');
    const nameInput = input('newPartyName', { placeholder: 'Name as it should appear in the register' }) as HTMLInputElement;
    nameInput.value = name;
    const kindSel = h('select', { attrs: { name: 'newPartyKind' } }, ...Object.entries(PARTY_KINDS).filter(([k]) => k !== 'member').map(([k, label]) => h('option', { text: label, attrs: { value: k } }))) as HTMLSelectElement;
    kindSel.value = kind;
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      h('p', { class: 'hint', text: 'Bank details are added and verified later, on the Parties page.' }),
      labelled('Name', nameInput),
      labelled('What kind of party', kindSel),
      msg,
      h('div', { class: 'sheet-actions' }, button('Cancel', () => dlg.close()), h('button', { class: 'button button--primary', text: 'Add to register', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (nameInput.value.trim().length < 2) {
        msg.hidden = false;
        msg.textContent = 'Enter the name.';
        return;
      }
      const id = await createParty(nameInput.value, kindSel.value);
      if (!id) return;
      dlg.close();
      onAdded(id);
    });
    dlg.addEventListener('close', () => dlg.replaceChildren(), { once: true });
    present(dlg, closeOnBackdrop, h('h2', { text: 'Add a party', attrs: { id: 'party-title' } }), form);
  }
  // The new party must be in every row's list: rows are made again (they are cheap), and the line takes the party.
  function afterPartyAdded(l: Line, id: string) {
    setDraft(l.id, { partyId: id });
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    paint();
    renderBar();
  }

  // `withUnit`: also take the payer's own unit as the unit of a maintenance line. Only when the person asks for the suggestions of the selected lines
  // (the bar's "Accept suggestions"); the automatic "fill in the confident ones" leaves the unit to a person, since the payer can be anybody.
  function acceptRow(l: Line, withUnit = false) {
    if (!editable(l)) return;
    const patch: Partial<Draft> = {};
    for (const f of ['categoryId', 'partyId', 'nature'] as Field[]) {
      const g = ghostOf(l, f);
      if (g) patch[f] = g;
    }
    setDraft(l.id, patch);
    if (withUnit) {
      const dw = describedWith(l);
      if (dw.maintenance && !dw.unit && dw.suggestedUnit) setExtra(l.id, { householdId: dw.suggestedUnit });
    }
    syncRow(l);
  }
  function goToLine(index: number, field: 'start' | 'end') {
    pendingFocus = { index, field };
    virtualizer.scrollToIndex(itemIndexOfLine.get(lines[index]?.id) ?? index, { align: 'auto' });
    paint();
  }
  function focusRow(index: number, field: Field, step = 1) {
    let i = index;
    while (lines[i] && !editable(lines[i])) i += step;
    if (!lines[i]) return;
    pendingFocus = { index: i, field };
    virtualizer.scrollToIndex(itemIndexOfLine.get(lines[i].id) ?? i, { align: 'auto' });
    paint();
  }

  // Hovering a line (a mouse, not a touch screen) shows the bank's narration and what the Paytm report says, so the evidence is there without
  // taking a column. Text only. It is skipped when the narration is already on screen (its column, or the line is open).
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const tip = $('ltip');
  let tipTimer: ReturnType<typeof setTimeout> | undefined;
  const hideTip = () => {
    clearTimeout(tipTimer);
    tip.hidden = true;
  };
  spacer.addEventListener('mouseover', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.lrow');
    if (!row || !canHover.matches || showNarration || row.classList.contains('is-active') || row.contains(e.relatedTarget as Node | null) || spacer.contains(document.activeElement)) return;
    const l = byId.get(row.dataset.id ?? '');
    if (!l) return;
    clearTimeout(tipTimer);
    tipTimer = setTimeout(() => {
      const upi = [l.counterparty, l.remark ? `“${l.remark}”` : ''].filter(Boolean).join(' · ');
      tip.replaceChildren(
        h('p', { class: 'ltip-text', text: l.narration }),
        ...(upi ? [h('p', { class: 'ltip-sub', text: `Paytm: ${upi}` })] : []),
        ...(l.account ? [h('p', { class: 'ltip-sub', text: l.account })] : []),
      );
      tip.hidden = false;
      const r = row.getBoundingClientRect();
      const w = tip.offsetWidth;
      tip.style.left = `${Math.max(8, Math.min(r.left + 90, window.innerWidth - w - 8))}px`;
      // Never over the bar of selected lines at the bottom: below the line if it fits above the bar, else above the line.
      const limit = $('actionbar').hidden ? window.innerHeight : $('actionbar').getBoundingClientRect().top;
      const below = r.bottom + 4;
      tip.style.top = `${below + tip.offsetHeight > limit - 8 ? Math.max(8, r.top - tip.offsetHeight - 4) : below}px`;
    }, 350);
  });
  spacer.addEventListener('mouseout', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.lrow');
    if (row && !row.contains(e.relatedTarget as Node | null)) hideTip();
  });
  scrollEl.addEventListener('scroll', hideTip, { passive: true });
  // Working in a line (clicking, tabbing into a field) hides the card, and it stays away until focus leaves the list.
  spacer.addEventListener('mousedown', hideTip);
  spacer.addEventListener('focusin', hideTip);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && hideTip());

  // A group heading: a button that opens or closes the group, with how many lines it holds and what they add up to.
  function makeGroup(g: Extract<Item, { kind: 'group' }>): HTMLElement {
    const net = `${g.netPaise < 0 ? '−' : '+'}${rupees(Math.abs(g.netPaise))}`;
    const b = h(
      'button',
      { class: 'ggroup-btn', attrs: { type: 'button', 'aria-expanded': String(g.open) } },
      h('span', { class: 'ggroup-tri', text: '▸' }),
      h('span', { class: 'ggroup-label', text: g.label }),
      h('span', { class: 'ggroup-count', text: `${g.count} ${g.count === 1 ? 'line' : 'lines'}` }),
      h('span', { class: 'ggroup-net', text: `Net ${net}`, attrs: { title: 'Money in minus money out for these lines' } }),
    );
    b.addEventListener('click', () => {
      if (collapsed.has(g.key)) collapsed.delete(g.key);
      else collapsed.add(g.key);
      applyView();
    });
    return h('div', { class: `lgroup lgroup--${g.depth + 1}${g.open ? ' is-open' : ''}`, attrs: { role: 'row' } }, b);
  }

  function paint() {
    if (painting) return;
    painting = true;
    try {
      spacer.style.height = `${virtualizer.getTotalSize()}px`;
      const keep = new Set<string>();
      const keepGroups = new Set<string>();
      const inOrder: HTMLElement[] = [];
      for (const item of virtualizer.getVirtualItems()) {
        const it = items[item.index];
        if (!it) continue;
        if (it.kind === 'group') {
          keepGroups.add(it.key);
          const g = mountedGroups.get(it.key) ?? makeGroup(it);
          if (!mountedGroups.has(it.key)) {
            mountedGroups.set(it.key, g);
            spacer.append(g);
          }
          g.dataset.index = String(item.index);
          g.setAttribute('aria-rowindex', String(item.index + 3));
          inOrder.push(g);
          g.style.transform = `translateY(${item.start}px)`;
          virtualizer.measureElement(g);
          continue;
        }
        const l = it.line;
        keep.add(l.id);
        let el = mounted.get(l.id);
        if (!el) {
          el = makeRow(l);
          mounted.set(l.id, el);
          spacer.append(el);
        }
        el.dataset.index = String(item.index);
        el.setAttribute('aria-rowindex', String(item.index + 3)); // the two heading rows come first
        inOrder.push(el);
        el.style.transform = `translateY(${item.start}px)`;
        virtualizer.measureElement(el);
      }
      for (const [id, el] of mounted) {
        if (!keep.has(id)) {
          el.remove();
          mounted.delete(id);
        }
      }
      for (const [key, el] of mountedGroups) {
        if (!keepGroups.has(key)) {
          el.remove();
          mountedGroups.delete(key);
        }
      }
      // Keep the page's order the same as the table's, so Tab and a screen reader go down the lines in order (never while focus is inside).
      if (!spacer.contains(document.activeElement) && inOrder.some((el, i) => spacer.children[i] !== el)) spacer.append(...inOrder);
      $('grid').setAttribute('aria-rowcount', String(items.length + 2));
      if (pendingFocus) {
        const l = lines[pendingFocus.index];
        const el = l && mounted.get(l.id);
        if (el) {
          const r = refs.get(el)!;
          if (pendingFocus.field !== 'start' && pendingFocus.field !== 'end' && editable(l)) {
            el.dataset.open = '1';
            fill(el, l);
          }
          if (pendingFocus.field === 'start' || pendingFocus.field === 'end') {
            const stops = [...el.querySelectorAll<HTMLElement>('input, select, button')].filter((x) => !(x as HTMLInputElement).disabled && !x.hidden && x.offsetParent !== null);
            (pendingFocus.field === 'start' ? stops[0] : stops[stops.length - 1])?.focus();
          } else (pendingFocus.field === 'nature' ? r.nature : pendingFocus.field === 'partyId' ? r.party : r.cat).focus();
          pendingFocus = null;
        }
      }
    } finally {
      painting = false;
    }
    if (repaint) {
      repaint = false;
      paint();
    }
  }

  // ---- selection (shift-click for a range) and the action bar
  let lastPicked: string | null = null;
  function pick(id: string, range: boolean) {
    const pickable = lines.filter(editable);
    const on = !tstate.rowSelection[id];
    const next = { ...tstate.rowSelection };
    if (range && lastPicked) {
      const a = pickable.findIndex((x) => x.id === lastPicked);
      const b = pickable.findIndex((x) => x.id === id);
      if (a >= 0 && b >= 0) for (const x of pickable.slice(Math.min(a, b), Math.max(a, b) + 1)) next[x.id] = on;
    } else next[id] = on;
    for (const k of Object.keys(next)) if (!next[k]) delete next[k];
    lastPicked = id;
    table.setRowSelection(next);
  }
  function refreshSelection() {
    renderDraftNote();
    syncSelectAll();
    for (const [id, el] of mounted) {
      const l = lines.find((x) => x.id === id);
      if (l) fill(el, l);
    }
    renderBar();
  }

  // The bar is fixed to the window, so it starts where the page's own area starts (after the rail and the Finance panel), not under them.
  const staffMain = document.getElementById('staff-main');
  function placeBar() {
    $('actionbar').style.left = staffMain ? `${Math.max(0, staffMain.getBoundingClientRect().left)}px` : '0px';
  }
  if (staffMain) new ResizeObserver(placeBar).observe(staffMain);
  window.addEventListener('resize', placeBar);
  let barFields = { categoryId: '', partyId: '', nature: '' };
  // Maintenance year and unit chosen in the bar for the selected lines. Empty: each line keeps its own default (the year of its date, its payer's unit).
  const barExtra = { year: '', unit: '' };
  function renderBar() {
    const bar = $('actionbar');
    const sel = selectedLines();
    if (!data || !sel.length) {
      bar.hidden = true;
      bar.replaceChildren();
      $('selcount').textContent = '';
      return;
    }
    const ready = sel.filter(isReady).length;
    if ($('selcount').textContent !== `${sel.length} selected, ${ready} ready to post`) $('selcount').textContent = `${sel.length} selected, ${ready} ready to post`;
    placeBar();
    const lk = data.lookups;
    // The same linked pickers as on a line. Here the year and the unit may be left to each line, so Maintenance and each year can also be picked as they are; what is
    // chosen applies to every selected line.
    const barPath = categoryPath({ categoryId: barFields.categoryId, type: typeOfCategory(barFields.categoryId), year: barExtra.year, unit: barExtra.unit });
    const barType = typeOfCategory(barFields.categoryId);
    const maint = barType === 'member_contribution';
    const cat = linkedPicker({
      nodes: categoryNodes({ categories: lk.categories, households: lk.households, projects: lk.projects, date: today(), bar: true }),
      path: maint && !barExtra.unit ? [barFields.categoryId, ...(barExtra.year ? [barExtra.year] : [])] : barPath,
      blank: 'Category…',
      ariaLabel: 'Category for the selected lines',
      rootLabel: 'All categories',
    }) as ComboEl;
    // Adding a party here is the same as on a line: the new one is chosen for all the selected lines (nothing is saved to them until they are posted).
    const kind = sel.every((l) => l.direction === 'credit') ? 'customer' : 'vendor';
    const party = linkedPicker({
      nodes: partyNodes({ parties: lk.parties, unitId: maint ? barExtra.unit : '', unitLabels: unitLabels() }),
      path: partyPath(partyById(barFields.partyId)),
      blank: 'Party…',
      ariaLabel: 'Party for the selected lines',
      rootLabel: 'All kinds',
      startAt: () => partyStart({ categoryType: barType, unitId: maint ? barExtra.unit : '', unitHasPeople: lk.parties.some((q) => q.household_id === barExtra.unit && !q.former_since), parties: lk.parties }),
      addNew: {
        label: 'Add as a new party',
        blockedAt: (path) => (path[0] === 'member' || path[0] === 'unit' ? NO_MEMBER_ADD : null),
        onAdd: (typed) =>
          openAddParty(typed, kind, (id) => {
            barFields.partyId = id;
            renderBar();
          }),
      },
    }) as ComboEl;
    const words = h('input', { attrs: { type: 'text', placeholder: 'What it was for…', 'aria-label': 'Wording for the selected lines', autocomplete: 'off', value: barFields.nature } }) as HTMLInputElement;
    cat.addEventListener('change', () => {
      const path = cat.path;
      const got = readCategoryPath(path, typeOfCategory(path[0] ?? ''));
      barFields.categoryId = got.categoryId;
      barExtra.year = got.year;
      barExtra.unit = got.householdId;
      renderBar();
      if (got.categoryId && !barFields.partyId) setTimeout(() => $('actionbar').querySelectorAll<HTMLInputElement>('.combo-input')[1]?.focus(), 0);
    });
    party.addEventListener('change', () => (barFields.partyId = party.value));
    words.addEventListener('input', () => (barFields.nature = words.value));
    const post = button(`Post ${ready} ready`, () => void postReady(), 'button abar-post') as HTMLButtonElement;
    post.disabled = ready === 0;
    const why = ready === 0 ? 'Post is off until a selected line has a category and wording.' : ready < sel.length ? `${sel.length - ready} selected can't post yet: they need a category and wording.` : 'Posting asks you to confirm first.';
    bar.replaceChildren(
      h('span', { class: 'abar-count', text: `${sel.length} selected · ${ready} ready` }),
      cat,
      party,
      words,
      button('Apply to selected', async () => {
        const patch = Object.fromEntries(Object.entries(barFields).filter(([, v]) => String(v).trim())) as Partial<Draft>;
        const extraPatch: Extra = { ...(maint && barExtra.year ? { maintenanceYear: barExtra.year } : {}), ...(maint && barExtra.unit ? { householdId: barExtra.unit } : {}) };
        if (!Object.keys(patch).length && !Object.keys(extraPatch).length) {
          showToast('Choose a category, party or wording first.');
          return;
        }
        const clash = sel.filter((l) => (Object.entries(patch) as [Field, string][]).some(([f, v]) => draftOf(l.id)[f] && draftOf(l.id)[f] !== v)).length;
        if (clash) {
          const ok = await askSheet({ title: `Replace what ${clash} of ${sel.length} lines already have?`, text: 'They already have a different value in a field you are applying. You can undo this afterwards.', actions: [{ label: 'Replace', value: true, kind: 'primary' }, { label: 'Cancel', value: false }] });
          if (!ok) return;
        }
        withUndo(`Applied to ${sel.length} ${sel.length === 1 ? 'line' : 'lines'}.`, sel.map((l) => l.id), () => {
          for (const l of sel) {
            setDraft(l.id, patch);
            if (Object.keys(extraPatch).length) setExtra(l.id, extraPatch);
            syncRow(l);
          }
        });
      }, 'button button--outline button--small'),
      button('Accept suggestions', () => withUndo('Suggestions accepted.', sel.map((l) => l.id), () => { for (const l of sel) acceptRow(l, true); }), 'button button--outline button--small'),
      post,
      button('Clear', () => table.resetRowSelection(), 'button button--outline button--small'),
      h('span', { class: 'abar-why', text: why }),
    );
    bar.hidden = false;
  }
  $('accept-all').addEventListener('click', () => {
    const todo = lines.filter((l) => editable(l) && hasGhost(l) && isStrong(l));
    const weak = lines.filter((l) => editable(l) && hasGhost(l) && !isStrong(l)).length;
    withUndo(`Filled in ${todo.length} ${todo.length === 1 ? 'line' : 'lines'}.${weak ? ` ${weak} weaker ${weak === 1 ? 'guess is' : 'guesses are'} left for you to check.` : ''} Nothing is posted yet.`, todo.map((l) => l.id), () => { for (const l of todo) acceptRow(l); });
  });

  // ---- posting: the second step, confirmed first
  let posting = false;
  async function postReady() {
    if (posting) return;
    const ready = selectedLines().filter(isReady);
    if (!ready.length) return;
    const lk = data!.lookups;
    const total = ready.reduce((n, l) => n + l.amountPaise, 0);
    const byCat = new Map<string, number>();
    for (const l of ready) byCat.set(nameOf(lk.categories, draftOf(l.id).categoryId), (byCat.get(nameOf(lk.categories, draftOf(l.id).categoryId)) ?? 0) + 1);
    const mix = [...byCat.entries()].map(([n, c]) => `${c} × ${n}`).join(', ');
    const noParty = ready.filter((l) => !draftOf(l.id).partyId && partyNeeded(draftOf(l.id).categoryId)).length;
    const unreviewed = ready.filter((l) => l.suggestion && (l.suggestion.confidence === 'low' || l.suggestion.confidence === 'none')).length;
    const ok = await askSheet({
      title: `Post ${ready.length} ${ready.length === 1 ? 'line' : 'lines'}?`,
      text: `Together ${rupees(total)}: ${mix}.${noParty ? `\n${noParty} have no party.` : ''}${unreviewed ? `\n${unreviewed} rest on a weak suggestion.` : ''}\n\nPosted lines cannot be edited, only refunded or reversed.`,
      actions: [{ label: 'Post them', value: true, kind: 'primary' }, { label: 'Cancel', value: false }],
    });
    if (!ok) return;
    posting = true; // a second press while this runs would send the same lines again
    lastUndo = null; // an earlier undo must not touch lines that are about to be posted
    const postButton = document.querySelector<HTMLButtonElement>('#actionbar .abar-post');
    if (postButton) postButton.disabled = true;
    let posted = 0;
    let flagged = 0;
    let dropped = false;
    const failed: { lineId: string; error: string }[] = [];
    try {
      for (let i = 0; i < ready.length; i += 10) {
        const chunk = ready.slice(i, i + 10);
        showToast(`Posting ${Math.min(i + 10, ready.length)} of ${ready.length}…`);
        const items = chunk.map((l) => {
          const dw = describedWith(l);
          return { lineId: l.id, categoryId: draftOf(l.id).categoryId, partyId: draftOf(l.id).partyId || null, nature: draftOf(l.id).nature.trim(), householdId: dw.unit || null, maintenanceYear: dw.year || null, projectId: dw.project || null };
        });
        let res: { status: number; data: any };
        try {
          res = await call('/api/finance-admin/ledger/post', 'POST', { items });
        } catch {
          // The connection dropped or the session ended. Whether this batch reached the server is not known, so these lines are not marked
          // posted here; the refresh below shows what the server holds. Nothing after this batch is sent.
          dropped = true;
          for (const l of ready.slice(i)) failed.push({ lineId: l.id, error: 'Not confirmed: the connection dropped. The list is being checked against the server.' });
          break;
        }
        const { status, data: out } = res;
        if (status !== 200) {
          for (const l of chunk) failed.push({ lineId: l.id, error: out?.error ?? 'Could not post this line.' });
          continue;
        }
        posted += out.posted;
        flagged += out.flagged;
        failed.push(...(out.failed as { lineId: string; error: string }[]));
      }
    } finally {
      posting = false;
    }
    const failedIds = new Set(failed.map((f) => f.lineId));
    const resumeAt = Math.max(0, Math.min(...ready.filter((l) => !failedIds.has(l.id)).map((l) => lines.indexOf(l)).filter((i) => i >= 0), lines.length));
    const nextSelection = { ...tstate.rowSelection };
    for (const l of ready) {
      if (failedIds.has(l.id)) continue;
      const d = draftOf(l.id);
      l.state = 'allocated';
      l.allocation = { categoryId: d.categoryId, partyId: d.partyId || null, nature: d.nature.trim(), count: 1, householdLabel: null, maintenanceYear: null };
      l.effective = { category: nameOf(data!.lookups.categories, d.categoryId), party: d.partyId ? nameOf(data!.lookups.parties, d.partyId) : '', nature: d.nature.trim() };
      l.missingParty = !d.partyId && partyNeeded(d.categoryId);
      l.suggestion = null;
      l.hay = hayOf(l);
      delete nextSelection[l.id];
      drafts.delete(l.id);
    }
    saveDraftsNow();
    tstate = { ...tstate, rowSelection: nextSelection };
    rowErrors.clear();
    for (const f of failed) rowErrors.set(f.lineId, f.error);
    postedThisSitting += posted;
    const summary = [`${posted} posted`, flagged ? `${flagged} sent to review` : '', failed.length ? (dropped ? `${failed.length} not confirmed because the connection dropped: check them in the refreshed list before posting again` : `${failed.length} could not be posted (see the red notes on those lines)`) : ''].filter(Boolean).join(', ') + '.';
    showToast(summary);
    if (failed.length || flagged) {
      const note = $('postnote');
      note.replaceChildren(h('span', { text: summary }), button('Dismiss', () => (note.hidden = true), 'button button--outline button--small'));
      note.hidden = false;
    }
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    applyView();
    if (lines.length) goToLine(Math.min(resumeAt, lines.length - 1), 'start');
    void load(true); // confirms against the server (it knows which lines went to review) without dimming the page
  }

  if (getToken()) void load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

