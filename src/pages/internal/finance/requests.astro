---
// Finance (internal), session 08: every payment request and logged spend, for the people who approve and match them. Backed by
// netlify/functions/finance-admin.mts (/requests, lib/finance-requests.ts); the rules are scripts/lib/finance-requests.mjs.
//   * approve or reject a request (approving needs the same unlock as verifying a payee; whoever raised it cannot decide it)
//   * match a record to the UPI row or bank line it became: an exact UPI reference is shown as matched; anything else is a
//     suggestion that a person accepts, never linked on a guess
//   * look at the bill or payment photo; clear the flag on a payment to the requester's own party
// What a record says it was for is shown on the UPI page and in the ledger once it is matched.
//
// Same shell as the other internal tools: Google Sign-In gated, unlinked, noindex. Everything the server returns is
// placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import '../../../styles/data-table.css';
import '../../../styles/request-cells.css';
import SignInGate from '../../../components/SignInGate.astro';
import StepUpSheet from '../../../components/StepUpSheet.astro';
---

<StaffLayout title="Approvals" description="Finance payment requests." current="finance" currentPage="finance-approvals">
  <button slot="toolbar" type="button" id="lock" class="lock-pill" hidden></button>

  <section class="finance finance-appr section wrapper">
    <h1>Payment requests</h1>
    <p id="intro" class="hint">Sign in to see the payment requests.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <div id="rq-table"></div>
      <p id="footnote" class="hint" hidden>* From the old transfer-request sheet.</p>
    </div>
    <StepUpSheet />
  </section>
</StaffLayout>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { matchWords } from '../../../../scripts/lib/finance-requests.mjs';
  import { initStepUpLock } from '../../../../scripts/lib/staff-stepup-ui.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';
  import { createDataTable } from '../../../../scripts/lib/data-table-ui.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  type Proposal = { type: 'upi' | 'bank'; targetId: string; reasons: string[]; via: string | null; alsoBank: boolean; date: string; who: string | null };
  type Rec = {
    id: string; kind: 'request' | 'log'; status: string; source: 'app' | 'history'; requester: string | null; requesterId: string | null; payee: string | null; amountPaise: number; mode: string | null; purpose: string;
    neededBy: string | null; reimbursement: boolean; paidOn: string | null; paidVia: string | null; upiRef: string | null; decidedBy: string | null; decisionReason: string | null; reviewFlag: string | null;
    vouchers: number; createdAt: string; fulfilled: { method: string; label: string } | null; matched: 'reference' | 'accepted' | null; linked: { upi: boolean; bank: boolean; upiRef: string | null; bankLineId: string | null } | null; mismatch: boolean; proposals: Proposal[]; ownParty: boolean;
  };
  let data: { me: { id: string; ready: boolean; hasPasskey: boolean; stepUpValid: boolean }; can: { approve: boolean; allocate: boolean }; records: Rec[]; agingCount: number } | null = null;
  let defaulted = false; // the first view with something in it opens once; after that the person's own choice stays

  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(paise / 100);
  const day = (iso: string | null) => (iso ? new Date(`${iso.slice(0, 10)}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '');
  const MODE: Record<string, string> = { neft: 'NEFT', upi: 'UPI', imps: 'IMPS', rtgs: 'RTGS' };
  const STATUS: Record<string, { text: string; kind: string }> = {
    submitted: { text: 'To approve', kind: 'warn' },
    approved: { text: 'Approved', kind: 'ok' },
    paid: { text: 'Paid', kind: 'ok' },
    rejected: { text: 'Rejected', kind: 'crit' },
    cancelled: { text: 'Cancelled', kind: 'dim' },
  };
  const VIEWS: { id: string; label: string; test: (r: Rec) => boolean }[] = [
    { id: 'waiting', label: 'To approve', test: (r) => r.kind === 'request' && r.status === 'submitted' },
    { id: 'tomatch', label: 'To match', test: (r) => !r.matched && r.status !== 'rejected' && r.status !== 'cancelled' && (r.kind === 'log' || r.status === 'approved' || r.status === 'paid') },
    { id: 'review', label: 'To review', test: (r) => Boolean(r.reviewFlag) },
  ];

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (className) e.className = className;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    intro.hidden = false;
    intro.textContent = 'Sign in to see the payment requests.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function fail(err: unknown) {
    if (err instanceof StaffAuthError) {
      if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
      else showForbidden();
      return true;
    }
    return false;
  }

  const lock = initStepUpLock({ getMe: () => data?.me ?? null, onChange: () => {} });

  // A record someone has just acted on stays in the list, highlighted, even though it no longer fits the tab it was in (a matched
  // record leaves "To match"): it would otherwise vanish with no sign it worked. It is let go when the tab or the search changes.
  const recent = new Set<string>();

  async function act(path: string, body: unknown, done: string, id?: string) {
    try {
      const { status, data: out } = await staffFetch(path, { method: 'POST', body });
      if (status === 403 && out?.code === 'STEP_UP_REQUIRED') return void (showToast(data?.me?.ready ? 'Unlock first.' : 'Set up two second factors first (see Security).'), lock.open());
      if (status >= 400) return void showToast(out?.error ?? 'Could not do that.');
      showToast(done);
      if (id) recent.add(id);
      await load();
    } catch (err) {
      if (!fail(err)) showToast('Could not do that.');
    }
  }

  // A bill or payment photo is fetched with the token and opened from memory; there is no link to it.
  async function openVoucher(id: string) {
    const res = await fetch(`/api/finance-admin/vouchers/${id}`, { headers: { authorization: `Bearer ${getToken() ?? ''}` } });
    if (!res.ok) return void showToast('Could not open the file.');
    window.open(URL.createObjectURL(await res.blob()), '_blank', 'noopener');
  }

  const pill = (text: string, kind = '') => el('span', `pill${kind ? ` pill--${kind}` : ''}`, text);

  // Words to light up where they appear in a suggested payment: the payee's name and what the record says it was for.
  function highlighted(text: string, words: string[]): HTMLElement {
    const out = el('span', 'suggest-text');
    if (!words.length) return (out.textContent = text), out;
    const re = new RegExp(`(${words.join('|')})`, 'ig'); // the words are letters and digits only
    text.split(re).forEach((part, i) => out.append(i % 2 ? el('mark', 'hl', part) : document.createTextNode(part)));
    return out;
  }

  const openIds = new Set<string>(); // records whose suggested payments are showing

  const whenOf = (r: Rec) => (r.kind === 'log' ? r.paidOn : r.paidOn ?? r.createdAt);
  const methodText = (r: Rec) => r.fulfilled?.label ?? (r.mode ? MODE[r.mode] ?? r.mode : '');
  const matchText = (r: Rec) => (r.mismatch ? 'Amount differs' : r.matched ? 'Matched' : r.proposals.length ? `${r.proposals.length} ${r.proposals.length === 1 ? 'suggestion' : 'suggestions'}` : '');

  function dateCell(r: Rec): HTMLElement {
    const out = el('span', 'nowrap', day(whenOf(r)));
    if (r.source === 'history') {
      // Loaded from the old transfer-request sheet: a small asterisk, explained by the footnote under the table.
      const star = el('abbr', 'star', '*');
      star.title = 'From the old transfer-request sheet';
      out.append(star);
    } else if (r.requester) out.append(el('span', 'sub', `by ${r.requester}`));
    return out;
  }
  function payeeCell(r: Rec): HTMLElement {
    const out = el('span', undefined, r.payee ?? 'Unknown');
    // A request is the usual case and says nothing; only a spend already made is marked, since it was never approved.
    if (r.kind === 'log') out.append(el('span', 'sub', `Logged spend${r.paidVia ? `, ${r.paidVia === 'delegate' ? 'by a delegate' : 'from the account'}` : ''}`));
    return out;
  }
  function purposeCell(r: Rec): HTMLElement {
    const out = el('span', undefined, r.purpose);
    if (r.decisionReason) out.append(el('span', 'sub', `${r.status === 'rejected' ? 'Rejected' : 'Note'}: ${r.decisionReason}`));
    return out;
  }
  // How it was paid, in its own column: the method of the payment it is tied to; until then what was asked for, in grey.
  function methodCell(r: Rec): HTMLElement {
    const f = r.fulfilled;
    const out = el('span', f ? undefined : 'dim', f ? f.label : r.mode ? MODE[r.mode] ?? r.mode : '—');
    if (!f && r.mode) out.title = `Asked for ${MODE[r.mode] ?? r.mode}. How it was paid shows once a payment is matched.`;
    if (f && r.kind === 'request' && r.mode && f.method !== r.mode && !(['bank', 'ift'].includes(f.method) && ['neft', 'imps', 'rtgs'].includes(r.mode))) out.append(el('span', 'sub warnsub', `asked for ${MODE[r.mode] ?? r.mode}`));
    return out;
  }
  function statusCell(r: Rec): HTMLElement {
    const st = STATUS[r.status] ?? { text: r.status, kind: 'dim' };
    const tags = el('div', 'tags');
    tags.append(pill(r.kind === 'log' ? 'Paid' : st.text, st.kind));
    if (r.reviewFlag) tags.append(pill('Own party', 'warn'));
    if (r.reimbursement) tags.append(pill(r.vouchers ? 'Reimbursement' : 'Reimbursement: no bill', r.vouchers ? '' : 'warn'));
    return tags;
  }
  function matchCell(r: Rec): HTMLElement {
    const out = el('span');
    if (r.mismatch) out.append(pill('Amount differs', 'crit'));
    else if (r.matched) {
      // One pill for each place the payment is tied (the UPI payment, the bank line), each a link to it. One link is enough: the
      // other side is derived. Hover says whether it was matched by reference or by a person.
      const how = r.matched === 'reference' ? 'Matched by the UPI reference' : 'Matched by a person';
      const pills = el('div', 'tags');
      const link = (label: string, href: string, title: string) => {
        const a = el('a', 'pill pill--ok pill--link', label);
        a.href = href;
        a.title = `${title}. ${how}.`;
        pills.append(a);
      };
      if (r.linked?.upi && r.linked.upiRef) link('UPI', `/internal/finance/upi/?ref=${r.linked.upiRef}`, 'Open this payment on the UPI page');
      if (r.linked?.bank && r.linked.bankLineId) link('Bank', `/internal/finance/ledger/?line=${r.linked.bankLineId}`, 'Open this line in the ledger');
      if (!pills.children.length) pills.append(pill('Matched', 'ok'));
      out.append(pills);
    } else if (r.proposals.length && data?.can.allocate) {
      const open = openIds.has(r.id);
      const t = el('button', 'linklike', `${r.proposals.length} ${r.proposals.length === 1 ? 'suggestion' : 'suggestions'} ${open ? '▴' : '▾'}`);
      t.type = 'button';
      t.setAttribute('aria-expanded', String(open));
      t.addEventListener('click', () => {
        if (open) openIds.delete(r.id);
        else openIds.add(r.id);
        table.render();
      });
      out.append(t);
    } else out.append(el('span', 'dim', '—'));
    return out;
  }
  function actionsCell(r: Rec): HTMLElement {
    const box = el('div', 'acts');
    const btn = (label: string, fn: () => void, primary = false) => {
      const b = el('button', `button button--small${primary ? ' button--primary' : ''}`, label);
      b.type = 'button';
      b.addEventListener('click', fn);
      box.append(b);
    };
    if (data?.can.approve && r.kind === 'request' && r.status === 'submitted') {
      if (r.requesterId === data.me.id) box.append(el('span', 'dim', 'Someone else must approve'));
      else {
        btn('Approve', () => act(`/api/finance-admin/requests/${r.id}/decide`, { action: 'approve' }, 'Approved.', r.id), true);
        btn('Reject', () => {
          const reason = prompt('Why is it rejected?');
          if (reason) void act(`/api/finance-admin/requests/${r.id}/decide`, { action: 'reject', reason }, 'Rejected.', r.id);
        });
      }
    }
    if (data?.can.allocate && r.reviewFlag && r.requesterId !== data.me.id) btn('Reviewed', () => act(`/api/finance-admin/requests/${r.id}/review`, {}, 'Reviewed.', r.id));
    if (r.vouchers)
      btn(`File${r.vouchers > 1 ? 's' : ''}`, async () => {
        // The list does not carry voucher ids (they are fetched by the request): ask the server once.
        const res = await staffFetch(`/api/finance-admin/requests/${r.id}/files`);
        for (const f of res.data.files ?? []) await openVoucher(f.id);
      });
    if (data?.can.allocate && r.matched === 'accepted') btn('Unmatch', () => confirm('Remove the match?') && void act(`/api/finance-admin/requests/${r.id}/unmatch`, {}, 'Unmatched.', r.id));
    return box;
  }
  // The suggested payments for a record, opened from its own "suggestions" link and drawn as part of it.
  function suggestBlock(r: Rec): HTMLElement | null {
    if (!(data?.can.allocate && !r.matched && r.proposals.length && openIds.has(r.id))) return null;
    const box = el('div', 'rq-suggest');
    box.append(el('div', 'suggest-head', `Possible payments for ${r.payee ?? 'this record'}, ${rupees(r.amountPaise)} (the same amount in each)`));
    const words = matchWords(r.payee, r.purpose) as string[];
    for (const p of r.proposals) {
      const row = el('div', 'suggest-row');
      const line = el('div', 'suggest-line');
      line.append(el('span', 'suggest-kind', `${p.via ?? (p.type === 'upi' ? 'UPI' : 'Bank')}${p.alsoBank ? ' + bank statement' : ''}`));
      const gap = p.reasons.find((x) => /apart|same day/.test(x));
      const when = el('span', 'nowrap', `${day(p.date)}${gap && gap !== 'same day' ? ` (${gap.replace(' apart', ' off')})` : ''}`);
      if (gap === 'same day') when.classList.add('hl');
      line.append(when);
      if (p.who) line.append(highlighted(p.who.slice(0, 80), words));
      const b = el('button', 'button button--small', 'Match');
      b.type = 'button';
      b.setAttribute('aria-label', `Match ${r.payee ?? 'this record'} to the ${p.type === 'upi' ? 'UPI payment' : 'bank line'} of ${day(p.date)}`);
      b.addEventListener('click', () => act(`/api/finance-admin/requests/${r.id}/match`, { type: p.type, targetId: p.targetId }, 'Matched.', r.id));
      row.append(line, b);
      box.append(row);
    }
    return box;
  }

  const statusText = (r: Rec) => (r.kind === 'log' ? 'Paid' : (STATUS[r.status] ?? { text: r.status }).text);
  const monthOf = (r: Rec) => whenOf(r)?.slice(0, 7) ?? 'No date';
  const monthName = (m: string) => (/^\d{4}-\d{2}$/.test(m) ? new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : m);
  const table = createDataTable({
    root: $('rq-table'),
    rowId: (r: Rec) => r.id,
    noun: ['record', 'records'],
    cap: 300,
    searchPlaceholder: 'Search payee, purpose, reference, requester…',
    favoritesKey: `tvc-requests-favorites:${decodeTokenEmail(getToken() ?? '')}`,
    defaultGroup: 'month',
    defaultSort: ['date', -1],
    searchText: (r: Rec) => [r.payee, r.purpose, r.upiRef, r.requester, r.decisionReason].join(' '),
    empty: { title: 'No requests yet', text: 'Requests and logged spends show here.' },
    // A record someone has just acted on stays in the list, highlighted, until the filters change.
    rowClass: (r: Rec) => (recent.has(r.id) ? 'just-done' : ''),
    onUserFilter: () => recent.clear(),
    onChange: (shown: Rec[]) => { $('footnote').hidden = !shown.some((r) => r.source === 'history'); },
    detail: suggestBlock,
    columns: [
      { id: 'date', label: 'Date', type: 'date', value: (r: Rec) => whenOf(r)?.slice(0, 10) ?? '', render: dateCell },
      { id: 'payee', label: 'Payee', value: (r: Rec) => r.payee ?? 'Unknown', render: payeeCell },
      { id: 'purpose', label: 'Purpose', wrap: true, value: (r: Rec) => r.purpose, render: purposeCell },
      { id: 'amount', label: 'Amount', type: 'amount', align: 'end', value: (r: Rec) => r.amountPaise, render: (r: Rec) => rupees(r.amountPaise) },
      { id: 'method', label: 'Method', value: methodText, render: methodCell },
      { id: 'status', label: 'Status', value: statusText, render: statusCell },
      { id: 'match', label: 'Match', sortable: false, value: matchText, render: matchCell },
      { id: 'actions', label: 'Actions', sortable: false, sticky: true, filter: 'none', value: () => '', render: actionsCell },
    ],
    // Chips of one group are alternatives: "To approve" and "To match" together show both.
    filters: [
      ...VIEWS.map((v) => ({ id: v.id, group: 'view', label: v.label, test: (r: Rec) => v.test(r) || recent.has(r.id) })),
      { id: 'requests', group: 'kind', label: 'Requests', test: (r: Rec) => r.kind === 'request' },
      { id: 'logs', group: 'kind', label: 'Logged spends', test: (r: Rec) => r.kind === 'log' },
      { id: 'approved', group: 'status', label: 'Approved', test: (r: Rec) => r.status === 'approved' },
      { id: 'paid', group: 'status', label: 'Paid', test: (r: Rec) => r.status === 'paid' || r.kind === 'log' },
      { id: 'rejected', group: 'status', label: 'Rejected', test: (r: Rec) => r.status === 'rejected' },
      { id: 'cancelled', group: 'status', label: 'Cancelled', test: (r: Rec) => r.status === 'cancelled' },
      { id: 'matched', group: 'match', label: 'Matched', test: (r: Rec) => Boolean(r.matched) },
      { id: 'unmatched', group: 'match', label: 'Not matched', test: (r: Rec) => !r.matched },
      { id: 'differs', group: 'amount', label: 'Amount differs', test: (r: Rec) => r.mismatch },
      { id: 'history', group: 'source', label: 'From the old sheet', test: (r: Rec) => r.source === 'history' },
    ],
    groups: [
      { id: 'month', label: 'Month', key: monthOf, descending: true, format: monthName },
      { id: 'status', label: 'Status', key: statusText },
      { id: 'payee', label: 'Payee', key: (r: Rec) => r.payee ?? 'No payee' },
      { id: 'kind', label: 'Kind', key: (r: Rec) => (r.kind === 'log' ? 'Logged spends' : 'Requests') },
      { id: 'requester', label: 'Requester', key: (r: Rec) => r.requester ?? 'No requester' },
    ],
    // On a phone each record is a card holding the same cells.
    card: (r: Rec) => {
      const c = el('div', 'rq-card');
      const top = el('div', 'rq-card-top');
      top.append(el('span', undefined, r.payee ?? 'Unknown'), el('span', undefined, rupees(r.amountPaise)));
      c.append(top, dateCell(r), purposeCell(r), statusCell(r), matchCell(r), actionsCell(r));
      if (recent.has(r.id)) c.classList.add('just-done');
      return c;
    },
  });

  function render() {
    if (!data) return;
    table.setRows(data.records);
    // Open on the first view that has something in it, once; after that the person's own choice stays.
    if (!defaulted) {
      defaulted = true;
      const first = VIEWS.find((v) => data!.records.some(v.test));
      if (first) table.setChips([first.id]);
    }
    lock.render();
  }

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    showLoading(statusEl);
    try {
      const { status, data: out } = await staffFetch('/api/finance-admin/requests');
      if (status !== 200) throw new Error('load failed');
      clearState(statusEl);
      data = out;
      intro.hidden = false;
      intro.textContent = out.agingCount ? `${out.agingCount} approved ${out.agingCount === 1 ? 'request has' : 'requests have'} waited over two weeks for a payment to match.` : 'What each record was for shows on the UPI page and in the ledger once it is matched.';
      render();
      content.hidden = false;
    } catch (err) {
      if (fail(err)) return;
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the requests", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: load });
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  if (getToken()) load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>
