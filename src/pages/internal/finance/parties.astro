---
// Finance (internal), session 04: the parties directory. Backed by netlify/functions/finance-admin.mts
// (lib/finance-parties.ts). Everyone TVC pays or receives from, with bank or UPI details that are verified, never
// overwritten and never casually visible: the list shows "ending 0123" only. Revealing the full details and verifying
// them is for `verify-payee` holders behind the same unlock (MFA step-up) as the Access page.
//
// Same shell as the other internal tools: Google Sign-In gated, unlinked, noindex. Everything the server returns is
// placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import '../../../styles/linked-picker.css';
import SignInGate from '../../../components/SignInGate.astro';
import StepUpSheet from '../../../components/StepUpSheet.astro';
---

<StaffLayout title="Finance parties" description="Finance parties." current="finance" currentPage="finance-parties">
  <button slot="toolbar" type="button" id="lock" class="lock-pill" hidden></button>

  <section class="parties section wrapper">
    <h1>Parties</h1>
    <p id="intro" class="hint">Sign in to open the directory.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <div class="bar">
        <label class="field">
          <span class="visually-hidden">Search parties</span>
          <input id="q" type="search" placeholder="Search by name" autocomplete="off" />
        </label>
        <button type="button" id="add" class="button button--primary add-button" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
          <span class="add-label">Add party</span>
        </button>
      </div>
      <div class="segmented chips" id="chips" role="group" aria-label="Show"></div>
      <ul class="list" id="list"></ul>
      <p id="legend" class="legend" hidden>
        <span class="dot dot--verified" aria-hidden="true"></span> verified
        <span class="dot dot--unverified" aria-hidden="true"></span> not verified yet
        <span class="dot dot--review" aria-hidden="true"></span> needs review
      </p>
      <div id="empty" aria-live="polite" hidden></div>
    </div>

    <dialog id="party-sheet" class="sheet" aria-labelledby="party-title"></dialog>
    <dialog id="detail-sheet" class="sheet" aria-labelledby="detail-title"></dialog>
    <dialog id="account-sheet" class="sheet" aria-labelledby="account-title"></dialog>
    <dialog id="verify-sheet" class="sheet" aria-labelledby="verify-title"></dialog>
    <StepUpSheet />
  </section>
</StaffLayout>

<script>
  import { combo } from '../../../../scripts/lib/finance-ui.mjs';
  import { matchOptions } from '../../../../scripts/lib/finance-search.mjs';
  import { StaffAuthError, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { initStepUpLock } from '../../../../scripts/lib/staff-stepup-ui.mjs';
  import { markDiff, groupFromRight } from '../../../../scripts/lib/finance-diff.mjs';
  import { VERIFY_METHODS } from '../../../../scripts/lib/finance-parties.mjs';
  import { clearState, showEmpty, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  type Account = { id: string; method: 'bank' | 'upi'; shown: string; status: 'unverified' | 'verified'; shared: boolean; validFrom: string | null; retiredOn: string | null; payableNow: boolean; review: string[]; verification: { at: string | null; by: string | null; method: string | null; methodLabel: string; note: string | null } | null };
  type Party = { id: string; name: string; kind: string; active: boolean; householdId: string | null; formerSince: string | null; accounts: Account[]; earlierAccounts: number; needsReview: boolean; mergedCount: number };
  type Data = { kinds: string[]; canEdit: boolean; canVerify: boolean; me: { id: string; ready: boolean; hasPasskey: boolean; stepUpValid: boolean } | null; parties: Party[]; needsReviewCount: number };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const KIND_LABELS: Record<string, string> = { member: 'Member', vendor: 'Vendor', employee: 'Employee', customer: 'Customer', bank: 'Bank', government: 'Government', director: 'Director', other: 'Other' };
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');
  let data: Data | null = null;
  let query = '';
  type Filter = 'all' | 'review' | 'unverified' | 'verified';
  const asked = new URLSearchParams(location.search).get('filter');
  let filter: Filter = asked === 'review' || asked === 'unverified' || asked === 'verified' ? asked : 'all';

  function h(tag: string, props: { class?: string; text?: string; attrs?: Record<string, string>; on?: Record<string, (e: Event) => void> } = {}, ...kids: (Node | null)[]): HTMLElement {
    const el = document.createElement(tag);
    if (props.class) el.className = props.class;
    if (props.text !== undefined) el.textContent = props.text;
    for (const [k, v] of Object.entries(props.attrs ?? {})) el.setAttribute(k, v);
    for (const [k, v] of Object.entries(props.on ?? {})) el.addEventListener(k, v);
    el.append(...kids.filter((k): k is Node => k !== null));
    return el;
  }
  const pill = (text: string, kind?: 'ok' | 'warn' | 'crit') => h('span', { class: `pill${kind ? ` pill--${kind}` : ''}`, text });
  const button = (text: string, onClick: () => void, cls = 'button button--outline') => h('button', { class: cls, text, attrs: { type: 'button' }, on: { click: onClick } });

  // ---- sign-in
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to open the directory.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  // ---- the unlock for revealing and verifying
  const lock = initStepUpLock({ getMe: () => data?.me ?? null, onChange: () => {} });
  function mayVerify(): boolean {
    if (lock.canEdit()) return true;
    showToast(data?.me?.ready ? 'Unlock editing first.' : 'Set up two second factors first (see Security).');
    lock.open();
    return false;
  }

  // ---- calls
  async function call(path: string, method = 'GET', body?: unknown) {
    try {
      return await staffFetch(path, { method, body });
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      }
      throw err;
    }
  }

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (!data) showLoading(statusEl);
    try {
      const { status, data: out } = await call(`/api/finance-admin/parties${query ? `?q=${encodeURIComponent(query)}` : ''}`);
      if (status !== 200) throw new Error('load failed');
      data = out as Data;
      clearState(statusEl);
      intro.hidden = false;
      intro.textContent = 'Everyone TVC pays or receives from. Bank and UPI details show only their last four characters here.';
      $('add').hidden = !data.canEdit;
      lock.render();
      render();
      content.hidden = false;
    } catch (err) {
      if (err instanceof StaffAuthError) return;
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the parties", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: load });
    }
  }

  // ---- dates and review reasons
  const todayIST = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date()); // YYYY-MM-DD
  const niceDate = (iso: string) => new Date(`${iso}T00:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const isRetired = (a: Account) => Boolean(a.retiredOn && a.retiredOn <= todayIST());
  const REVIEW_TEXT: Record<string, string> = {
    multiple_live_accounts: 'This payee has two bank accounts in use. Retire the old one, or confirm that keeping both is intended.',
    missing_ifsc: 'No IFSC code yet. Add it before these details can be verified.',
    shared_account: 'Another party uses the same account. Check this is intended.',
    no_replacement: 'This account is being retired and no other account is set up to replace it.',
  };
  // ---- the list: what needs doing first. A payee is in one of four states, shown as a quiet dot, so the one loud signal is
  // "Needs review"; the chips above give the counts and filter the list.
  type PState = 'review' | 'unverified' | 'verified' | 'none';
  const hasLiveUnverified = (p: Party) => p.accounts.some((a) => a.status === 'unverified' && !isRetired(a));
  const stateOf = (p: Party): PState => (p.needsReview ? 'review' : hasLiveUnverified(p) ? 'unverified' : p.accounts.length ? 'verified' : 'none');
  const STATE_TEXT: Record<PState, string> = { review: 'Needs review', unverified: 'Not verified yet', verified: 'Verified', none: 'No payment details' };
  const FILTERS: [Filter, string][] = [['all', 'All'], ['review', 'Needs review'], ['unverified', 'Unverified'], ['verified', 'Verified']];
  const inFilter = (p: Party, f: Filter) => f === 'all' || (f === 'review' && p.needsReview) || (f === 'unverified' && hasLiveUnverified(p)) || (f === 'verified' && !hasLiveUnverified(p) && p.accounts.length > 0);

  function accountSummary(p: Party): string {
    const live = p.accounts.filter((a) => !isRetired(a));
    const banks = live.filter((a) => a.method === 'bank').length;
    const upis = live.filter((a) => a.method === 'upi').length;
    const parts = [banks ? `${banks} bank account${banks === 1 ? '' : 's'}` : '', upis ? (upis === 1 ? 'UPI' : `${upis} UPI ids`) : ''].filter(Boolean);
    return parts.length ? parts.join(' and ') : 'No payment details';
  }

  // The kind, changed in place: most imported payees are still "Other", and setting 120 of them one sheet at a time would be a chore.
  function kindSelect(p: Party): HTMLSelectElement {
    const sel = h('select', { class: 'kind-select', attrs: { 'aria-label': `Kind of ${p.name}` } }, ...(data?.kinds ?? []).map((k) => h('option', { text: KIND_LABELS[k] ?? k, attrs: { value: k } }))) as HTMLSelectElement;
    sel.value = p.kind;
    sel.addEventListener('click', (e) => e.stopPropagation());
    sel.addEventListener('change', async () => {
      const before = p.kind;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', { kind: sel.value });
      if (status === 200) {
        p.kind = sel.value;
        showToast('Saved.');
      } else {
        sel.value = before;
        showToast(out?.error ?? 'Could not change that.');
      }
    });
    return sel;
  }

  function render() {
    const all = data?.parties ?? [];
    $('chips').replaceChildren(
      ...FILTERS.map(([id, label]) => {
        const n = all.filter((p) => inFilter(p, id)).length;
        return h('button', { attrs: { type: 'button', 'aria-pressed': String(filter === id) }, on: { click: () => { filter = id; render(); } } }, h('span', { text: label }), h('span', { class: `chip-count${id === 'review' && n > 0 ? ' chip-count--crit' : ''}`, text: String(n) }));
      }),
    );
    const parties = all.filter((p) => inFilter(p, filter));
    $('list').replaceChildren(
      ...parties.map((p) => {
        const state = stateOf(p);
        return h(
          'li',
          {},
          h(
            'div',
            { class: 'row party-row' },
            h('span', { class: `dot dot--${state}`, attrs: { 'aria-hidden': 'true' } }),
            h('button', { class: 'party-main', attrs: { type: 'button' }, on: { click: () => openDetail(p.id) } }, h('span', { class: 'title', text: p.name }), h('span', { class: 'detail', text: accountSummary(p) }), h('span', { class: 'visually-hidden', text: STATE_TEXT[state] })),
            data?.canEdit ? kindSelect(p) : h('span', { class: 'detail kind-text', text: KIND_LABELS[p.kind] ?? p.kind }),
            h('span', { class: 'party-flag' }, p.active ? null : pill('Inactive'), p.formerSince ? pill('Former member') : null, p.needsReview ? pill('Needs review', 'crit') : null),
          ),
        );
      }),
    );
    $('legend').hidden = parties.length === 0;
    const empty = $('empty');
    if (parties.length) clearState(empty);
    else if (query) showEmpty(empty, { title: 'No party matches that search', text: 'Try a shorter name, or clear the search.' });
    else if (all.length === 0) showEmpty(empty, { title: 'No parties yet', text: 'Add the first one by hand, or load an existing list with the import script (the steps are in docs/finance/FINANCE.md).', action: data?.canEdit ? { label: 'Add party', onClick: openAddParty } : undefined });
    else showEmpty(empty, { title: 'Nothing in this view', text: 'No payees are in this group right now.', action: { label: 'Show everyone', onClick: () => { filter = 'all'; render(); } } });
  }
  let searchTimer: number | undefined;
  $<HTMLInputElement>('q').addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value.trim();
    clearTimeout(searchTimer);
    searchTimer = window.setTimeout(load, 250);
  });

  // ---- sheets
  function present(dlg: HTMLDialogElement, ...kids: (Node | null)[]) {
    dlg.replaceChildren(...kids.filter((k): k is Node => k !== null));
    if (!dlg.open) dlg.showModal();
    closeOnBackdrop(dlg);
  }
  const closeBtn = (dlg: HTMLDialogElement, label = 'Close') => button(label, () => dlg.close());
  function labelled(label: string, input: HTMLElement) {
    return h('label', {}, h('span', { text: label }), input);
  }
  const input = (name: string, attrs: Record<string, string> = {}) => h('input', { attrs: { name, autocomplete: 'off', ...attrs } }) as HTMLInputElement;

  // Which bank and branch an IFSC names, so a mistyped code shows at once. Only the IFSC is looked up, never the account
  // number, and a failed lookup never blocks saving. Stale answers (the field moved on) are dropped.
  async function showBranch(code: string, el: HTMLElement) {
    const ifsc = code.replace(/\s+/g, '').toUpperCase();
    el.hidden = true;
    el.classList.remove('error');
    if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(ifsc)) return;
    const { status, data: found } = await call(`/api/finance-admin/ifsc/${ifsc}`);
    if (code !== el.dataset.asked) return;
    if (status !== 200 || found?.unavailable) return;
    el.hidden = false;
    if (found?.found) el.textContent = [found.bank, found.branch, found.city].filter(Boolean).join(' · ');
    else {
      el.classList.add('error');
      el.textContent = 'No bank branch has this IFSC code. Check it against the cheque or letter.';
    }
  }
  const watchIfsc = (field: HTMLInputElement, el: HTMLElement) =>
    field.addEventListener('input', () => {
      el.dataset.asked = field.value;
      void showBranch(field.value, el);
    });

  function payeeFields() {
    const method = h('select', { attrs: { name: 'method' } }, h('option', { text: 'Bank transfer', attrs: { value: 'bank' } }), h('option', { text: 'UPI', attrs: { value: 'upi' } })) as HTMLSelectElement;
    const account = input('account', { inputmode: 'numeric' });
    const ifsc = input('ifsc');
    const upi = input('upi', { placeholder: 'name@bank' });
    const branch = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    watchIfsc(ifsc, branch);
    const bank = h('div', { class: 'stack-form' }, labelled('Account number', account), labelled('IFSC code', ifsc), branch);
    const upiBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, labelled('UPI id', upi));
    method.addEventListener('change', () => {
      bank.hidden = method.value !== 'bank';
      upiBox.hidden = method.value !== 'upi';
    });
    return {
      nodes: [labelled('How we pay them', method), bank, upiBox],
      value: () => (method.value === 'bank' ? { method: 'bank', account: account.value, ifsc: ifsc.value } : { method: 'upi', upi: upi.value }),
    };
  }

  function openAddParty() {
    const dlg = $<HTMLDialogElement>('party-sheet');
    const name = input('name');
    const kind = h('select', { attrs: { name: 'kind' } }, ...(data?.kinds ?? []).filter((k) => k !== 'member').map((k) => h('option', { text: KIND_LABELS[k] ?? k, attrs: { value: k } }))) as HTMLSelectElement;
    kind.value = 'vendor'; // most payees are vendors
    const withPayee = h('input', { attrs: { type: 'checkbox' } }) as HTMLInputElement;
    const payee = payeeFields();
    const payeeBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, ...payee.nodes);
    withPayee.addEventListener('change', () => (payeeBox.hidden = !withPayee.checked));
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled('Name', name),
      labelled('Kind', kind),
      h('label', {}, withPayee, h('span', { text: 'Add bank or UPI details now (they stay unverified until a director confirms)' })),
      payeeBox,
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Add party', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: name.value, kind: kind.value, ...(withPayee.checked ? { payee: payee.value() } : {}) });
      if (status === 201) {
        dlg.close();
        showToast('Party added.');
        load();
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not add that.';
      }
    });
    present(dlg, h('h2', { text: 'Add party', attrs: { id: 'party-title' } }), form);
  }
  $('add').addEventListener('click', openAddParty);

  // ---- comparing the accounts of one payee: the characters that differ are shown in red
  type Marked = { ch: string; differs: boolean }[];
  const last4Of = (a: Account) => a.shown.replace(/^ending /, '');
  const diffSpan = (m: { ch: string; differs: boolean }) => h('span', { class: m.differs ? 'diff' : '', text: m.ch });

  // A long number in groups of four from the right (for reading), as separate spans so copying it keeps no spaces.
  function numberNode(marks: Marked, grouped = true): HTMLElement {
    const sizes = grouped ? groupFromRight(marks.map((m) => m.ch).join('')).map((g) => g.length) : [marks.length];
    const out: HTMLElement[] = [];
    let at = 0;
    for (const size of sizes) {
      out.push(h('span', { class: 'grp' }, ...marks.slice(at, at + size).map(diffSpan)));
      at += size;
    }
    return h('span', { class: 'num' }, ...out);
  }

  // Reveal every account of this party at once (verify-payee + the unlock; each reveal is audited) and show the full
  // numbers lined up from the right with the differences in red. They disappear again after 30 seconds.
  async function showFullNumbers(p: Party, boxes: Map<string, HTMLElement>, dlg: HTMLDialogElement, note: HTMLElement) {
    if (!mayVerify()) return;
    const revealed = await Promise.all(p.accounts.map((a) => call(`/api/finance-admin/accounts/${a.id}/reveal`, 'POST')));
    const failed = revealed.find((r) => r.status !== 200);
    if (failed) {
      if (failed.data?.code === 'STEP_UP_REQUIRED') lock.open();
      else showToast(failed.data?.error ?? 'Could not show those details.');
      return;
    }
    const details = revealed.map((r) => r.data.details as { method: string; account?: string; ifsc?: string; upi?: string });
    const lines = new Map<string, HTMLElement[]>();
    const add = (id: string, label: string, node: HTMLElement) => lines.set(id, [...(lines.get(id) ?? []), h('div', { class: 'full-line' }, h('span', { class: 'full-label', text: label }), node)]);
    for (const method of ['bank', 'upi']) {
      const idx = details.map((d, i) => (d.method === method ? i : -1)).filter((i) => i >= 0);
      if (!idx.length) continue;
      if (method === 'bank') {
        const numbers = markDiff(idx.map((i) => details[i].account ?? ''));
        const ifscs = markDiff(idx.map((i) => details[i].ifsc ?? ''));
        idx.forEach((i, k) => {
          add(p.accounts[i].id, 'Account number', numberNode(numbers[k]));
          add(p.accounts[i].id, 'IFSC code', details[i].ifsc ? numberNode(ifscs[k], false) : h('span', { class: 'diff', text: 'Missing' }));
        });
      } else {
        const ids = markDiff(idx.map((i) => details[i].upi ?? ''));
        idx.forEach((i, k) => add(p.accounts[i].id, 'UPI id', numberNode(ids[k], false)));
      }
    }
    const hide = () => {
      boxes.forEach((box) => {
        box.replaceChildren();
        box.hidden = true;
      });
      note.hidden = true;
    };
    boxes.forEach((box, id) => {
      box.replaceChildren(...(lines.get(id) ?? []));
      box.hidden = false;
    });
    note.hidden = false;
    const timer = window.setTimeout(hide, 30_000);
    dlg.addEventListener('close', () => { clearTimeout(timer); hide(); }, { once: true });
  }

  function openDetail(id: string) {
    const p = data?.parties.find((x) => x.id === id);
    if (!p) return;
    const dlg = $<HTMLDialogElement>('detail-sheet');
    const boxes = new Map<string, HTMLElement>();
    const accounts = p.accounts.map((a) => {
      const retired = isRetired(a);
      const peers = p.accounts.filter((x) => x.method === a.method);
      const ending = markDiff(peers.map(last4Of))[peers.indexOf(a)];
      const full = h('div', { class: 'acct-full', attrs: { hidden: '' } });
      boxes.set(a.id, full);
      // "two bank accounts in use" is about the payee, not one account: it is shown once, above the list.
      const v = a.verification;
      const notes = [
        v ? `Verified${v.by ? ` by ${v.by}` : ''}${v.at ? ` on ${niceDate(v.at.slice(0, 10))}` : ''} · ${v.methodLabel}${v.note ? ` · ${v.note}` : ''}` : null,
        retired ? `Retired from ${niceDate(a.retiredOn!)}. Do not pay this account.` : a.retiredOn ? `Retires on ${niceDate(a.retiredOn)}; payable until the day before.` : null,
        a.validFrom && a.validFrom > todayIST() ? `Starts on ${niceDate(a.validFrom)}.` : null,
        ...(retired ? [] : a.review.filter((r) => r !== 'multiple_live_accounts').map((r) => REVIEW_TEXT[r] ?? r)),
      ].filter((t): t is string => Boolean(t));
      const status = retired ? pill('Retired', 'crit') : a.retiredOn ? pill('Retiring', 'warn') : a.status === 'verified' ? pill('Verified', 'ok') : pill('Unverified', 'warn');
      const verify = a.status === 'unverified' && !retired && data?.canVerify ? button('Verify…', () => openVerify(p, a)) : null;
      const retire = !retired && data?.canVerify ? button(a.retiredOn ? 'Move date…' : 'Retire…', () => openRetire(p, a)) : null;
      return h(
        'li',
        {},
        h(
          'div',
          { class: 'acct' },
          h('div', { class: 'acct-head' }, h('span', { class: 'title' }, document.createTextNode(`${a.method === 'bank' ? 'Bank account' : 'UPI'} ending `), ...ending.map(diffSpan)), status),
          full,
          ...notes.map((t) => h('span', { class: 'detail', text: t })),
          verify || retire ? h('div', { class: 'acct-actions' }, verify, retire) : null,
        ),
      );
    });
    const fullNote = h('p', { class: 'hint', text: 'Shown for 30 seconds. Showing them is logged. Red marks what differs between the accounts.', attrs: { hidden: '' } });
    const twoLive = p.accounts.some((a) => !isRetired(a) && a.review.includes('multiple_live_accounts'));
    const actions: Node[] = [closeBtn(dlg)];
    if (data?.canVerify) actions.unshift(button('Merge into…', () => openMerge(p)));
    if (data?.canVerify && p.accounts.length > 1) actions.unshift(button('Compare full numbers', () => void showFullNumbers(p, boxes, dlg, fullNote)));
    if (data?.canVerify && p.accounts.some((a) => a.review.includes('multiple_live_accounts'))) actions.unshift(button('Keep both: reviewed', () => keepBoth(p, dlg)));
    if (data?.canEdit) {
      actions.unshift(button('Add or change details', () => openAccount(p)), button(p.active ? 'Mark inactive' : 'Mark active', () => setActive(p, dlg)));
    }
    present(
      dlg,
      h('h2', { text: p.name, attrs: { id: 'detail-title' } }),
      data?.canEdit ? h('div', { class: 'stack-form' }, labelled('Kind', kindSelect(p))) : h('p', { class: 'sheet-text', text: `${KIND_LABELS[p.kind] ?? p.kind}${p.active ? '' : ' · inactive'}` }),
      twoLive ? h('p', { class: 'note', text: REVIEW_TEXT.multiple_live_accounts }) : null,
      fullNote,
      h('ul', { class: 'list' }, ...(accounts.length ? accounts : [h('li', {}, h('div', { class: 'acct' }, h('span', { class: 'detail', text: 'No payment details yet.' })))])),
      p.mergedCount ? h('p', { class: 'hint', text: `Includes the accounts of ${p.mergedCount} duplicate ${p.mergedCount === 1 ? 'party' : 'parties'} merged into this one.` }) : null,
      p.earlierAccounts ? h('p', { class: 'hint', text: `${p.earlierAccounts} earlier set${p.earlierAccounts === 1 ? '' : 's'} of details kept on record.` }) : null,
      h('div', { class: 'sheet-actions' }, ...actions),
    );
  }

  async function setActive(p: Party, dlg: HTMLDialogElement) {
    const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', { active: !p.active });
    if (status === 200) {
      dlg.close();
      showToast(p.active ? 'Marked inactive.' : 'Marked active.');
      load();
    } else showToast(out?.error ?? 'Could not change that.');
  }

  // Retire an account from a date. From that day nothing may be paid to it. A past date is fine (it stopped working
  // before we found out). Needs the unlock, like verifying.
  function openRetire(p: Party, a: Account) {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const on = input('on', { type: 'date', required: '' });
    const reason = input('reason', { placeholder: 'e.g. Bank merged; new account from 1 April', maxlength: '200', required: '' });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    // What this leaves the payee with, said before the button, because a payee with nothing to pay is the costly outcome.
    const kept = p.accounts.filter((x) => x.id !== a.id && x.method === a.method && !isRetired(x)).length;
    const kind = a.method === 'bank' ? 'bank' : 'UPI';
    const consequence = kept
      ? h('p', { class: 'hint', text: `${p.name} keeps ${kept} other ${kind} account${kept === 1 ? '' : 's'} to pay.` })
      : h('p', { class: 'note', text: `From this date ${p.name} will have no ${kind} account to pay. Add and verify a new one first.` });
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled('Do not pay this account from', on),
      labelled('Why', reason),
      consequence,
      h('p', { class: 'hint', text: a.retiredOn ? 'A retirement can only be moved earlier, never later.' : 'It stays on record. Make sure the payee has another account set up and verified before this date.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--danger', text: a.retiredOn ? 'Move the date' : 'Retire account', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/retire`, 'POST', { on: on.value, reason: reason.value });
      if (status === 200) {
        dlg.close();
        showToast('Retired.');
        load();
      } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not retire that.';
      }
    });
    present(dlg, h('h2', { text: `Retire ${a.method === 'bank' ? 'bank account' : 'UPI'} ${a.shown}`, attrs: { id: 'account-title' } }), form);
  }

  // Two parties that are really one payee. Nothing is deleted or moved: this party is hidden and its accounts appear under
  // the one you choose, where the old and new bank accounts are reviewed together. Needs the unlock, like verifying.
  function openMerge(p: Party) {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const others = (data?.parties ?? []).filter((x) => x.id !== p.id);
    const into = combo({ options: others.map((x) => ({ value: x.id, label: x.name })), blank: 'Choose the main party…', matcher: matchOptions, ariaLabel: 'The main party' }) as any;
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled(`"${p.name}" is the same payee as`, into),
      h('p', { class: 'hint', text: 'This party disappears from the list and its accounts show under the one you choose. Nothing is deleted and nothing is paid differently; if the payee then has two bank accounts, retire the old one.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Merge', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!into.value) return;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}/merge`, 'POST', { into: into.value });
      if (status === 200) {
        dlg.close();
        showToast('Merged.');
        load();
      } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not merge those.';
      }
    });
    present(dlg, h('h2', { text: `Merge ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  async function keepBoth(p: Party, dlg: HTMLDialogElement) {
    if (!mayVerify()) return;
    const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}/review`, 'POST');
    if (status === 200) {
      dlg.close();
      showToast('Recorded. This stays until another account is added.');
      load();
    } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
    else showToast(out?.error ?? 'Could not record that.');
  }

  function openAccount(p: Party) {
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const payee = payeeFields();
    const effective = input('effectiveOn', { type: 'date' });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      ...payee.nodes,
      data?.canVerify ? labelled('Takes effect on (optional)', effective) : null,
      h('p', { class: 'hint', text: data?.canVerify ? 'Leave the date empty to replace the current details now: nothing is paid to that payee until the new details are verified. With a date, the old account stays payable until that day and is retired from it; the new one starts that day.' : 'New or changed details start unverified and replace the current ones of that kind until a director confirms them. The old details are kept.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Save details', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (effective.value && !mayVerify()) return;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}/accounts`, 'POST', { ...payee.value(), ...(effective.value ? { effectiveOn: effective.value } : {}) });
      if (out?.code === 'STEP_UP_REQUIRED') {
        lock.open();
        return;
      }
      if (status === 200 || status === 201) {
        dlg.close();
        showToast(out?.unchanged ? 'Those details are already on record.' : 'Saved. A director needs to verify them.');
        load();
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not save that.';
      }
    });
    present(dlg, h('h2', { text: `Details for ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  // The payees still to verify, in list order: each with its first unverified account.
  function verifyQueue(): { p: Party; a: Account }[] {
    return (data?.parties ?? []).filter(hasLiveUnverified).map((p) => ({ p, a: p.accounts.find((x) => x.status === 'unverified' && !isRetired(x))! }));
  }

  // The verification screen: shows the full details once, asks how they were checked, records it with who and when, and
  // can carry straight on to the next payee. The details disappear from the page when the sheet closes.
  async function openVerify(p: Party, a: Account) {
    if (!mayVerify()) return;
    const dlg = $<HTMLDialogElement>('verify-sheet');
    const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/reveal`, 'POST');
    if (status !== 200) {
      if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else showToast(out?.error ?? 'Could not show those details.');
      return;
    }
    const d = out.details as { method: string; account?: string; ifsc?: string; upi?: string };
    const noIfsc = d.method === 'bank' && !d.ifsc;
    const lines = d.method === 'bank' ? [['Account number', d.account], ['IFSC code', d.ifsc || 'Missing: add it first']] : [['UPI id', d.upi]];
    const queue = verifyQueue();
    const at = queue.findIndex((x) => x.p.id === p.id);
    const others = p.accounts.filter((x) => x.id !== a.id && x.method === a.method && !isRetired(x));
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const branchNote = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    if (d.ifsc) {
      branchNote.dataset.asked = d.ifsc;
      void showBranch(d.ifsc, branchNote);
    }

    const radios = VERIFY_METHODS.map((m: { id: string; label: string }) => {
      const radio = h('input', { attrs: { type: 'radio', name: 'how', value: m.id } }) as HTMLInputElement;
      return { radio, node: h('label', { class: 'radio' }, radio, h('span', { text: m.label })) };
    });
    const note = input('note', { maxlength: '200', placeholder: 'For example, where the cheque photo is kept' });
    const hasNext = queue.length > 1;
    const verifyBtn = h('button', { class: hasNext ? 'button button--outline' : 'button button--primary', text: 'Verify', attrs: { type: 'button' } }) as HTMLButtonElement;
    const nextBtn = h('button', { class: 'button button--primary', text: 'Verify and open next', attrs: { type: 'button' } }) as HTMLButtonElement;
    if (!hasNext) nextBtn.hidden = true;

    const chosen = () => radios.find((r) => r.radio.checked)?.radio.value ?? '';
    const ready = () => !noIfsc && (chosen() === 'other' ? note.value.trim().length >= 3 : chosen() !== '');
    const sync = () => {
      verifyBtn.disabled = !ready();
      nextBtn.disabled = !ready();
    };
    radios.forEach((r) => r.radio.addEventListener('change', sync));
    note.addEventListener('input', sync);

    async function submit(openNext: boolean) {
      verifyBtn.disabled = true;
      nextBtn.disabled = true;
      const res = await call(`/api/finance-admin/accounts/${a.id}/verify`, 'POST', { method: chosen(), note: note.value });
      if (res.status === 200) {
        dlg.close();
        showToast('Verified.');
        const order = (data?.parties ?? []).map((x) => x.id);
        const here = order.indexOf(p.id);
        await load();
        if (openNext) {
          const after = verifyQueue();
          const next = after.find((x) => order.indexOf(x.p.id) >= here) ?? after[0];
          if (next) void openVerify(next.p, next.a);
          else showToast('That was the last one to verify.');
        }
      } else if (res.data?.code === 'STEP_UP_REQUIRED') {
        lock.open();
        sync();
      } else {
        msg.hidden = false;
        msg.textContent = res.data?.error ?? 'Could not verify.';
        sync();
      }
    }
    verifyBtn.addEventListener('click', () => void submit(false));
    nextBtn.addEventListener('click', () => void submit(true));
    sync();
    if (noIfsc) {
      msg.hidden = false;
      msg.textContent = 'These details have no IFSC code yet. Close this, choose "Add or change details", and enter the account again with its IFSC.';
    }
    dlg.addEventListener('close', () => dlg.replaceChildren(), { once: true });
    present(
      dlg,
      h('div', { class: 'verify-head' }, h('h2', { text: `Verify ${p.name}`, attrs: { id: 'verify-title' } }), at >= 0 ? h('span', { class: 'small-note', text: `${at + 1} of ${queue.length} to verify` }) : null),
      h('ul', { class: 'list' }, ...lines.map(([k, v]) => h('li', {}, h('div', { class: 'row' }, h('span', { class: 'grow' }, h('span', { class: 'detail', text: k }), h('span', { class: 'title', text: v ?? '' })))))),
      branchNote,
      others.length ? h('p', { class: 'note', text: `This payee also has an account ending ${others.map(last4Of).join(' and ')}. Check which one they use now before verifying.` }) : null,
      h('p', { class: 'field-label', text: 'How did you check these details?' }),
      h('div', { class: 'radios', attrs: { role: 'group', 'aria-label': 'How you checked' } }, ...radios.map((r) => r.node)),
      h('div', { class: 'stack-form' }, labelled('Note (optional)', note)),
      h('p', { class: 'hint', text: 'Showing these is logged. You cannot verify details you entered yourself.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), verifyBtn, nextBtn),
    );
  }

  if (getToken()) load();
  else showGate();
</script>
