---
// Finance (internal), session 04: the parties directory. Backed by netlify/functions/finance-admin.mts
// (lib/finance-parties.ts). Everyone TVC pays or receives from, with bank or UPI details that are verified, never
// overwritten and never casually visible: the list shows "ending 0123" only. Revealing the full details and verifying
// them is for `verify-payee` holders behind the same unlock (MFA step-up) as the Access page.
//
// Same shell as the other internal tools: Google Sign-In gated, unlinked, noindex. Everything the server returns is
// placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import '../../../styles/linked-picker.css';
import '../../../styles/data-table.css';
import SignInGate from '../../../components/SignInGate.astro';
import StepUpSheet from '../../../components/StepUpSheet.astro';
---

<StaffLayout title="Finance parties" description="Finance parties." current="finance" currentPage="finance-parties">
  <button slot="toolbar" type="button" id="lock" class="lock-pill" hidden></button>

  <section class="parties section wrapper">
    <h1>Parties</h1>
    <p id="intro" class="hint">Sign in to open the directory.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <section id="suggest" class="suggest" aria-label="Suggested changes" hidden>
        <button type="button" id="suggest-head" class="suggest-head" aria-expanded="true">
          <span class="pill pill--warn" id="suggest-count">0</span>
          <strong>Suggested changes</strong>
          <span class="hint">From the name the bank showed on verified accounts and what each payee's payments were booked under. Nothing changes until you accept.</span>
          <span class="suggest-caret" aria-hidden="true">▾</span>
        </button>
        <ul id="suggest-list" class="suggest-list"></ul>
        <button type="button" id="suggest-more" class="suggest-more" hidden></button>
      </section>
      <div id="table"></div>
      <button type="button" id="add" class="button button--primary add-button" hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
        <span class="add-label">Add party</span>
      </button>
      <p id="legend" class="legend" hidden>
        <span class="dot dot--verified" aria-hidden="true"></span> verified
        <span class="dot dot--unverified" aria-hidden="true"></span> not verified yet
        <span class="dot dot--review" aria-hidden="true"></span> needs review
        <span class="differs-key">Orange</span> name at the bank differs from ours
      </p>
    </div>

    <dialog id="party-sheet" class="sheet" aria-labelledby="party-title"></dialog>
    <dialog id="detail-sheet" class="sheet" aria-labelledby="detail-title"></dialog>
    <dialog id="account-sheet" class="sheet" aria-labelledby="account-title"></dialog>
    <dialog id="verify-sheet" class="sheet" aria-labelledby="verify-title"></dialog>
    <StepUpSheet />
  </section>
</StaffLayout>

<script>
  import { combo } from '../../../../scripts/lib/finance-ui.mjs';
  import { matchOptions } from '../../../../scripts/lib/finance-search.mjs';
  import { createDataTable } from '../../../../scripts/lib/data-table-ui.mjs';
  import { rupees, niceDate as niceIso } from '../../../../scripts/lib/finance-ui.mjs';
  import { StaffAuthError, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, getStepUp, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { initStepUpLock } from '../../../../scripts/lib/staff-stepup-ui.mjs';
  import { markDiff, groupFromRight } from '../../../../scripts/lib/finance-diff.mjs';
  import { VERIFY_METHODS, namesResemble } from '../../../../scripts/lib/finance-parties.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  type Account = { id: string; method: 'bank' | 'upi'; shown: string; status: 'unverified' | 'verified'; shared: boolean; validFrom: string | null; retiredOn: string | null; payableNow: boolean; review: string[]; verification: { at: string | null; by: string | null; method: string | null; methodLabel: string; note: string | null; name?: string | null } | null; evidence?: { payment: number; name_check: number; other: number } };
  type Party = { id: string; name: string; kind: string; active: boolean; householdId: string | null; formerSince: string | null; accounts: Account[]; earlierAccounts: number; needsReview: boolean; mergedCount: number; lastPaid: string | null; paidPaise: number; lastReceived: string | null; receivedPaise: number; lines: number; postings: number };
  type Suggestion = { id: string; type: 'merge' | 'rename' | 'kind'; partyId: string; targetId?: string; to?: string; what: string; why: string };
  type Data = { kinds: string[]; canEdit: boolean; canVerify: boolean; me: { id: string; ready: boolean; hasPasskey: boolean; stepUpValid: boolean } | null; parties: Party[]; suggestions: Suggestion[]; needsReviewCount: number };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const KIND_LABELS: Record<string, string> = { member: 'Member', vendor: 'Vendor', employee: 'Employee', customer: 'Customer', bank: 'Bank', government: 'Government', director: 'Director', other: 'Other' };
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');
  let data: Data | null = null;
  // ?filter=review|unverified|verified (links from the dashboard) opens with that filter on.
  const asked = new URLSearchParams(location.search).get('filter');

  function h(tag: string, props: { class?: string; text?: string; attrs?: Record<string, string>; on?: Record<string, (e: Event) => void> } = {}, ...kids: (Node | null)[]): HTMLElement {
    const el = document.createElement(tag);
    if (props.class) el.className = props.class;
    if (props.text !== undefined) el.textContent = props.text;
    for (const [k, v] of Object.entries(props.attrs ?? {})) el.setAttribute(k, v);
    for (const [k, v] of Object.entries(props.on ?? {})) el.addEventListener(k, v);
    el.append(...kids.filter((k): k is Node => k !== null));
    return el;
  }
  const pill = (text: string, kind?: 'ok' | 'warn' | 'crit') => h('span', { class: `pill${kind ? ` pill--${kind}` : ''}`, text });
  const button = (text: string, onClick: () => void, cls = 'button button--outline') => h('button', { class: cls, text, attrs: { type: 'button' }, on: { click: onClick } });

  // ---- sign-in
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to open the directory.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  // ---- the unlock for revealing and verifying
  const lock = initStepUpLock({ getMe: () => data?.me ?? null, onChange: () => {} });
  function mayVerify(): boolean {
    if (lock.canEdit()) return true;
    showToast(data?.me?.ready ? 'Unlock editing first.' : 'Set up two second factors first (see Security).');
    lock.open();
    return false;
  }

  // ---- calls
  async function call(path: string, method = 'GET', body?: unknown) {
    try {
      return await staffFetch(path, { method, body });
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      }
      throw err;
    }
  }

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (!data) showLoading(statusEl);
    try {
      const { status, data: out } = await call('/api/finance-admin/parties');
      if (status !== 200) throw new Error('load failed');
      data = out as Data;
      clearState(statusEl);
      intro.hidden = false;
      intro.textContent = 'Everyone TVC pays or receives from. Bank and UPI details show only their last four characters here.';
      $('add').hidden = !data.canEdit;
      lock.render();
      renderAll();
      content.hidden = false;
    } catch (err) {
      if (err instanceof StaffAuthError) return;
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the parties", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: load });
    }
  }

  // ---- dates and review reasons
  const todayIST = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date()); // YYYY-MM-DD
  const niceDate = (iso: string) => new Date(`${iso}T00:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const isRetired = (a: Account) => Boolean(a.retiredOn && a.retiredOn <= todayIST());
  const REVIEW_TEXT: Record<string, string> = {
    multiple_live_accounts: 'This payee has two bank accounts in use. Retire the old one, or confirm that keeping both is intended.',
    missing_ifsc: 'No IFSC code yet. Add it before these details can be verified.',
    shared_account: 'Another party uses the same account. Check this is intended.',
    no_replacement: 'This account is being retired and no other account is set up to replace it.',
  };
  // ---- the list: what needs doing first. A payee is in one of four states, shown as a quiet dot, so the one loud signal is
  // "Needs review".
  type PState = 'review' | 'unverified' | 'verified' | 'none';
  const hasLiveUnverified = (p: Party) => p.accounts.some((a) => a.status === 'unverified' && !isRetired(a));
  const stateOf = (p: Party): PState => (p.needsReview ? 'review' : hasLiveUnverified(p) ? 'unverified' : p.accounts.length ? 'verified' : 'none');
  const STATE_TEXT: Record<PState, string> = { review: 'Needs review', unverified: 'Not verified yet', verified: 'Verified', none: 'No payment details' };

  function accountSummary(p: Party): string {
    const live = p.accounts.filter((a) => !isRetired(a));
    const banks = live.filter((a) => a.method === 'bank').length;
    const upis = live.filter((a) => a.method === 'upi').length;
    const parts = [banks ? `${banks} bank account${banks === 1 ? '' : 's'}` : '', upis ? (upis === 1 ? 'UPI' : `${upis} UPI ids`) : ''].filter(Boolean);
    return parts.length ? parts.join(' and ') : 'No payment details';
  }
  const liveAccounts = (p: Party) => p.accounts.filter((a) => !isRetired(a));
  const bankNames = (p: Party) => [...new Set(p.accounts.map((a) => a.verification?.name).filter((n): n is string => Boolean(n)))];
  // The bank's name "differs" when no bank name is the label apart from case and punctuation.
  const squash = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '');
  const differs = (p: Party) => bankNames(p).length > 0 && !bankNames(p).some((n) => squash(n) === squash(p.name));
  // The latest line with this party, either way: its date and whether it was a payment or a receipt.
  const lastActivity = (p: Party): { date: string; what: string } | null => {
    if (p.lastPaid && (!p.lastReceived || p.lastPaid >= p.lastReceived)) return { date: p.lastPaid, what: 'paid' };
    return p.lastReceived ? { date: p.lastReceived, what: 'received' } : null;
  };
  const evidenceCount = (p: Party) => p.accounts.reduce((n, a) => n + (a.evidence ? a.evidence.payment + a.evidence.name_check + a.evidence.other : 0), 0);

  // The kind, changed in place: most imported payees are still "Other", and setting 120 of them one sheet at a time would be a chore.
  function kindSelect(p: Party): HTMLSelectElement {
    const sel = h('select', { class: 'kind-select', attrs: { 'aria-label': `Kind of ${p.name}` } }, ...(data?.kinds ?? []).map((k) => h('option', { text: KIND_LABELS[k] ?? k, attrs: { value: k } }))) as HTMLSelectElement;
    sel.value = p.kind;
    if (p.householdId) sel.disabled = true; // a member linked to a household stays a member
    sel.addEventListener('click', (e) => e.stopPropagation());
    sel.addEventListener('change', async () => {
      const before = p.kind;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', { kind: sel.value });
      if (status === 200) {
        p.kind = sel.value;
        showToast('Saved.');
        table.render();
      } else {
        sel.value = before;
        showToast(out?.error ?? 'Could not change that.');
      }
    });
    return sel;
  }

  // Parties some merge suggestion names (either side): the "Possible duplicate" filter and the pill on the row.
  let duplicateIds = new Set<string>();

  const KIND_ORDER = ['Member', 'Vendor', 'Employee', 'Customer', 'Bank', 'Government', 'Director', 'Other'];
  const table = createDataTable({
    root: $('table'),
    rowId: (p: Party) => p.id,
    noun: ['party', 'parties'],
    searchPlaceholder: 'Search names, bank names, notes…',
    favoritesKey: `tvc-party-favorites:${decodeTokenEmail(getToken() ?? '')}`,
    layoutKey: `tvc-party-columns:${decodeTokenEmail(getToken() ?? '')}`,
    defaultGroup: 'kind',
    defaultSort: ['name', 1],
    toolbarEnd: $('add'),
    searchText: (p: Party) => [p.name, KIND_LABELS[p.kind], ...bankNames(p), ...p.accounts.map((a) => a.shown), STATE_TEXT[stateOf(p)]].join(' '),
    onOpen: (p: Party) => openDetail(p.id),
    empty: { title: 'No parties yet', text: 'Add the first one by hand, or load an existing list with the import script (the steps are in docs/finance/FINANCE.md).' },
    columns: [
      {
        id: 'name', label: 'Name', value: (p: Party) => p.name,
        render: (p: Party) => h('span', { class: 'name-cell' }, h('button', { class: 'party-main', attrs: { type: 'button' }, on: { click: () => openDetail(p.id) } }, h('span', { class: 'title', text: p.name })), h('span', { class: 'party-flag' }, p.active ? null : pill('Inactive'), p.formerSince ? pill('Former member') : null, p.needsReview ? pill('Needs review', 'crit') : null, duplicateIds.has(p.id) ? pill('Possible duplicate', 'warn') : null)),
      },
      { id: 'kind', label: 'Kind', value: (p: Party) => KIND_LABELS[p.kind] ?? p.kind, render: (p: Party) => (data?.canEdit ? kindSelect(p) : h('span', { class: 'detail kind-text', text: KIND_LABELS[p.kind] ?? p.kind })) },
      { id: 'accounts', label: 'Accounts', value: (p: Party) => accountSummary(p), sortValue: (p: Party) => liveAccounts(p).length },
      {
        id: 'status', label: 'Status', value: (p: Party) => STATE_TEXT[stateOf(p)],
        render: (p: Party) => h('span', { class: 'status-cell' }, h('span', { class: `dot dot--${stateOf(p)}`, attrs: { 'aria-hidden': 'true' } }), document.createTextNode(STATE_TEXT[stateOf(p)])),
      },
      { id: 'bank', label: 'Name at the bank', value: (p: Party) => bankNames(p).join(', '), render: (p: Party) => (bankNames(p).length ? h('span', { class: differs(p) ? 'differs' : '', text: bankNames(p).join(', ') }) : '–') },
      { id: 'evidence', label: 'Evidence', type: 'count', align: 'end', value: (p: Party) => evidenceCount(p), render: (p: Party) => (evidenceCount(p) ? `${evidenceCount(p)} ${evidenceCount(p) === 1 ? 'file' : 'files'}` : '–') },
      // The latest line either way, with which way it was; totals are plain amounts under their headings (a total is not one transaction).
      { id: 'lastActivity', label: 'Last activity', type: 'date', value: (p: Party) => lastActivity(p)?.date ?? '', render: (p: Party) => { const a = lastActivity(p); return a ? h('span', {}, document.createTextNode(niceIso(a.date)), h('span', { class: 'detail', text: ` ${a.what}` })) : '–'; } },
      { id: 'paid', label: 'Paid in total', type: 'amount', align: 'end', value: (p: Party) => (p.paidPaise > 0 ? p.paidPaise : null), render: (p: Party) => (p.paidPaise > 0 ? rupees(p.paidPaise) : '–') },
      { id: 'received', label: 'Received in total', type: 'amount', align: 'end', value: (p: Party) => (p.receivedPaise > 0 ? p.receivedPaise : null), render: (p: Party) => (p.receivedPaise > 0 ? rupees(p.receivedPaise) : '–') },
    ],
    filters: [
      { id: 'review', label: 'Needs review', test: (p: Party) => p.needsReview },
      { id: 'unverified', label: 'Unverified', test: (p: Party) => hasLiveUnverified(p) },
      { id: 'verified', label: 'Verified', test: (p: Party) => !hasLiveUnverified(p) && p.accounts.length > 0 },
      { id: 'noaccount', label: 'No payment details', test: (p: Party) => liveAccounts(p).length === 0 },
      { id: 'noevidence', label: 'No evidence attached', test: (p: Party) => evidenceCount(p) === 0 },
      { id: 'differs', label: "Bank's name differs", test: differs },
      { id: 'duplicate', label: 'Possible duplicate', test: (p: Party) => duplicateIds.has(p.id) },
      { id: 'other', label: 'Kind is Other', test: (p: Party) => p.kind === 'other' },
      { id: 'paidsome', group: 'flow', label: 'We have paid them', test: (p: Party) => p.paidPaise > 0 },
      { id: 'receivedsome', group: 'flow', label: 'We have received from them', test: (p: Party) => p.receivedPaise > 0 },
      { id: 'inactive', label: 'Inactive', test: (p: Party) => !p.active },
    ],
    groups: [
      { id: 'kind', label: 'Kind', key: (p: Party) => KIND_LABELS[p.kind] ?? p.kind, order: KIND_ORDER },
      { id: 'status', label: 'Status', key: (p: Party) => STATE_TEXT[stateOf(p)], order: ['Needs review', 'Not verified yet', 'Verified', 'No payment details'] },
      { id: 'letter', label: 'First letter', key: (p: Party) => (p.name.trim()[0] ?? '#').toUpperCase() },
    ],
    card: (p: Party) =>
      h('div', { class: 'party-card', attrs: { role: 'button', tabindex: '0' }, on: { click: (e: Event) => { if (!(e.target as HTMLElement).closest('select,input,button')) openDetail(p.id); } } },
        h('div', { class: 'party-card-top' }, h('span', { class: 'title', text: p.name }), h('span', { class: 'status-cell' }, h('span', { class: `dot dot--${stateOf(p)}`, attrs: { 'aria-hidden': 'true' } }), document.createTextNode(STATE_TEXT[stateOf(p)]))),
        h('div', { class: 'detail', text: [KIND_LABELS[p.kind] ?? p.kind, accountSummary(p), p.paidPaise > 0 ? `Paid ${rupees(p.paidPaise)}` : '', p.receivedPaise > 0 ? `Received ${rupees(p.receivedPaise)}` : ''].filter(Boolean).join(' · ') }),
        bankNames(p).length ? h('div', { class: differs(p) ? 'differs' : 'detail', text: `Bank: ${bankNames(p).join(', ')}` }) : null,
        h('div', { class: 'party-flag' }, p.active ? null : pill('Inactive'), p.needsReview ? pill('Needs review', 'crit') : null, duplicateIds.has(p.id) ? pill('Possible duplicate', 'warn') : null)),
    bulk: [
      { id: 'kind', label: 'Set kind…', run: (rows: Party[]) => openBulkKind(rows) },
      { id: 'merge', label: 'Merge…', run: (rows: Party[]) => bulkMerge(rows) },
      { id: 'inactive', label: 'Mark inactive', run: (rows: Party[]) => openBulkInactive(rows) },
      { id: 'active', label: 'Mark active', run: (rows: Party[]) => bulkActive(rows) },
    ],
  });

  let askedApplied = false;
  function renderAll() {
    const all = data?.parties ?? [];
    duplicateIds = new Set((data?.suggestions ?? []).filter((x) => x.type === 'merge').flatMap((x) => [x.partyId, x.targetId ?? '']));
    table.setRows(all);
    if (!askedApplied) {
      askedApplied = true;
      if (asked === 'review' || asked === 'unverified' || asked === 'verified') table.setChips([asked]);
    }
    $('legend').hidden = all.length === 0;
    renderSuggestions();
  }

  // ---- suggested changes: each is accepted through the same routes as a manual change (rename, kind, merge), with their own rules
  const dismissedKey = () => `tvc-party-suggestions-dismissed:${decodeTokenEmail(getToken() ?? '')}`;
  const readDismissed = (): Set<string> => {
    try { return new Set(JSON.parse(localStorage.getItem(dismissedKey()) ?? '[]')); } catch { return new Set(); }
  };
  const dismiss = (id: string) => {
    try { localStorage.setItem(dismissedKey(), JSON.stringify([...readDismissed(), id])); } catch { /* blocked storage: it comes back next time */ }
    renderSuggestions();
  };
  const SUGGESTIONS_SHOWN = 3;
  let showAllSuggestions = false;
  function renderSuggestions() {
    const gone = readDismissed();
    const list = (data?.suggestions ?? []).filter((x) => !gone.has(x.id));
    $('suggest').hidden = list.length === 0;
    $('suggest-count').textContent = String(list.length);
    // Three at a time: a long list must not push the table off the screen.
    const shown = showAllSuggestions ? list : list.slice(0, SUGGESTIONS_SHOWN);
    $('suggest-more').hidden = list.length <= SUGGESTIONS_SHOWN;
    $('suggest-more').textContent = showAllSuggestions ? 'Show fewer' : `Show ${list.length - SUGGESTIONS_SHOWN} more`;
    $('suggest-list').replaceChildren(
      ...shown.map((x) =>
        h('li', {}, h('div', { class: 'suggest-what', text: x.what }), h('div', { class: 'hint', text: x.why }),
          h('div', { class: 'suggest-actions' },
            data?.canEdit ? button(x.type === 'merge' ? 'Review merge' : 'Accept', () => acceptSuggestion(x), 'button button--primary') : null,
            button('Dismiss', () => dismiss(x.id)))),
      ),
    );
  }
  $('suggest-more').addEventListener('click', () => {
    showAllSuggestions = !showAllSuggestions;
    renderSuggestions();
  });
  $('suggest-head').addEventListener('click', () => {
    const open = $('suggest-list').hidden;
    $('suggest-list').hidden = !open;
    if (!open) $('suggest-more').hidden = true;
    else renderSuggestions();
    $('suggest-head').setAttribute('aria-expanded', String(open));
  });
  async function acceptSuggestion(x: Suggestion) {
    const p = data?.parties.find((q) => q.id === x.partyId);
    if (!p) return;
    if (x.type === 'merge') return openMerge(p, x.targetId ?? '');
    const body = x.type === 'rename' ? { name: x.to } : { kind: x.to };
    const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', body);
    if (status === 200) {
      showToast('Saved.');
      load();
    } else showToast(out?.error ?? 'Could not change that.');
  }

  // ---- bulk actions on the ticked rows
  // Each is the same PATCH as changing one party by hand (so the same rules and audit entry per party), run five at a time so that
  // changing a hundred parties takes seconds, with the count shown as it goes.
  async function patchAll(items: Party[], bodyOf: (p: Party) => unknown, onProgress: (done: number, total: number) => void): Promise<{ done: number; failed: number }> {
    let next = 0;
    let finished = 0;
    let failed = 0;
    async function worker() {
      while (next < items.length) {
        const p = items[next++];
        try {
          const { status } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', bodyOf(p));
          if (status !== 200) failed += 1;
        } catch {
          failed += 1;
        }
        finished += 1;
        onProgress(finished, items.length);
      }
    }
    await Promise.all(Array.from({ length: Math.min(5, items.length) }, worker));
    return { done: items.length - failed, failed };
  }
  function openBulkKind(rows: Party[]) {
    const dlg = $<HTMLDialogElement>('account-sheet');
    const movable = rows.filter((p) => !p.householdId);
    const sel = h('select', { attrs: { name: 'kind' } }, ...(data?.kinds ?? []).filter((k) => k !== 'member').map((k) => h('option', { text: KIND_LABELS[k] ?? k, attrs: { value: k } }))) as HTMLSelectElement;
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const go = h('button', { class: 'button button--primary', text: 'Set kind', attrs: { type: 'submit' } }) as HTMLButtonElement;
    const form = h('form', { class: 'stack-form' },
      labelled(`Set the kind of ${movable.length} ${movable.length === 1 ? 'party' : 'parties'} to`, sel),
      movable.length < rows.length ? h('p', { class: 'hint', text: `${rows.length - movable.length} linked to a household stay a member.` }) : null,
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), go));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      go.disabled = true;
      const { done, failed } = await patchAll(movable.filter((p) => p.kind !== sel.value), () => ({ kind: sel.value }), (d, t) => { go.textContent = `Changing ${d} of ${t}…`; });
      dlg.close();
      table.clearSelection();
      showToast(failed ? `Changed ${done}; ${failed} could not be changed.` : `Changed ${done}.`);
      load();
    });
    present(dlg, h('h2', { text: 'Set kind', attrs: { id: 'account-title' } }), form);
  }
  function openBulkInactive(rows: Party[]) {
    const dlg = $<HTMLDialogElement>('account-sheet');
    const form = h('form', { class: 'stack-form' },
      h('p', { text: `Mark ${rows.length} ${rows.length === 1 ? 'party' : 'parties'} inactive?` }),
      h('p', { class: 'hint', text: 'They stay in the books and on the ledger lines they are already on. They are no longer offered when choosing who was paid, and nothing is deleted. To bring them back, show the Inactive filter, tick them and choose Mark active.' }),
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Mark inactive', attrs: { type: 'submit' } })));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const go = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      go.disabled = true;
      const { done, failed } = await patchAll(rows.filter((p) => p.active), () => ({ active: false }), (d, t) => { go.textContent = `Marking ${d} of ${t}…`; });
      dlg.close();
      table.clearSelection();
      showToast(failed ? `Marked ${done}; ${failed} could not be changed.` : `Marked ${done} inactive.`);
      load();
    });
    present(dlg, h('h2', { text: 'Mark inactive', attrs: { id: 'account-title' } }), form);
  }
  async function bulkActive(rows: Party[]) {
    const off = rows.filter((p) => !p.active);
    if (!off.length) {
      showToast('Those are already active.');
      return;
    }
    showToast(`Marking ${off.length} active…`);
    const { done, failed } = await patchAll(off, () => ({ active: true }), () => {});
    table.clearSelection();
    showToast(failed ? `Marked ${done} active; ${failed} could not be changed.` : `Marked ${done} active.`);
    load();
  }
  // Two ticked parties are the same payee: the one without payment details is merged into the other.
  function bulkMerge(rows: Party[]) {
    if (rows.length !== 2) {
      showToast('Select the two parties that are one payee.');
      return;
    }
    const [a, b] = rows;
    const [from, into] = a.accounts.length === 0 || b.accounts.length > 0 ? [a, b] : [b, a];
    table.clearSelection();
    openMerge(from, into.id);
  }

  // ---- sheets
  function present(dlg: HTMLDialogElement, ...kids: (Node | null)[]) {
    dlg.replaceChildren(...kids.filter((k): k is Node => k !== null));
    if (!dlg.open) dlg.showModal();
    closeOnBackdrop(dlg);
  }
  const closeBtn = (dlg: HTMLDialogElement, label = 'Close') => button(label, () => dlg.close());
  function labelled(label: string, input: HTMLElement) {
    return h('label', {}, h('span', { text: label }), input);
  }
  const input = (name: string, attrs: Record<string, string> = {}) => h('input', { attrs: { name, autocomplete: 'off', ...attrs } }) as HTMLInputElement;

  // Which bank and branch an IFSC names, so a mistyped code shows at once. Only the IFSC is looked up, never the account
  // number, and a failed lookup never blocks saving. Stale answers (the field moved on) are dropped.
  async function showBranch(code: string, el: HTMLElement) {
    const ifsc = code.replace(/\s+/g, '').toUpperCase();
    el.hidden = true;
    el.classList.remove('error');
    if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(ifsc)) return;
    const { status, data: found } = await call(`/api/finance-admin/ifsc/${ifsc}`);
    if (code !== el.dataset.asked) return;
    if (status !== 200 || found?.unavailable) return;
    el.hidden = false;
    if (found?.found) el.textContent = [found.bank, found.branch, found.city].filter(Boolean).join(' · ');
    else {
      el.classList.add('error');
      el.textContent = 'No bank branch has this IFSC code. Check it against the cheque or letter.';
    }
  }
  const watchIfsc = (field: HTMLInputElement, el: HTMLElement) =>
    field.addEventListener('input', () => {
      el.dataset.asked = field.value;
      void showBranch(field.value, el);
    });

  function payeeFields() {
    const method = h('select', { attrs: { name: 'method' } }, h('option', { text: 'Bank transfer', attrs: { value: 'bank' } }), h('option', { text: 'UPI', attrs: { value: 'upi' } })) as HTMLSelectElement;
    const account = input('account', { inputmode: 'numeric' });
    const ifsc = input('ifsc');
    const upi = input('upi', { placeholder: 'name@bank' });
    const branch = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    watchIfsc(ifsc, branch);
    const bank = h('div', { class: 'stack-form' }, labelled('Account number', account), labelled('IFSC code', ifsc), branch);
    const upiBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, labelled('UPI id', upi));
    method.addEventListener('change', () => {
      bank.hidden = method.value !== 'bank';
      upiBox.hidden = method.value !== 'upi';
    });
    return {
      nodes: [labelled('How we pay them', method), bank, upiBox],
      value: () => (method.value === 'bank' ? { method: 'bank', account: account.value, ifsc: ifsc.value } : { method: 'upi', upi: upi.value }),
    };
  }

  function openAddParty() {
    const dlg = $<HTMLDialogElement>('party-sheet');
    const name = input('name');
    const kind = h('select', { attrs: { name: 'kind' } }, ...(data?.kinds ?? []).filter((k) => k !== 'member').map((k) => h('option', { text: KIND_LABELS[k] ?? k, attrs: { value: k } }))) as HTMLSelectElement;
    kind.value = 'vendor'; // most payees are vendors
    const withPayee = h('input', { attrs: { type: 'checkbox' } }) as HTMLInputElement;
    const payee = payeeFields();
    const payeeBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, ...payee.nodes);
    withPayee.addEventListener('change', () => (payeeBox.hidden = !withPayee.checked));
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    // A name already in the directory: the matches are shown and the button becomes "Add anyway" (two real payees can share a name).
    const dupes = h('div', { class: 'note', attrs: { hidden: '', role: 'alert' } });
    const submitBtn = h('button', { class: 'button button--primary', text: 'Add party', attrs: { type: 'submit' } }) as HTMLButtonElement;
    let confirmDuplicate = false;
    const resetDuplicate = () => {
      confirmDuplicate = false;
      dupes.hidden = true;
      submitBtn.textContent = 'Add party';
    };
    name.addEventListener('input', resetDuplicate);
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled('Name', name),
      labelled('Kind', kind),
      h('label', {}, withPayee, h('span', { text: 'Add bank or UPI details now (they stay unverified until a director confirms)' })),
      payeeBox,
      dupes,
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), submitBtn),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.hidden = true;
      const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: name.value, kind: kind.value, ...(withPayee.checked ? { payee: payee.value() } : {}), ...(confirmDuplicate ? { confirmDuplicate: true } : {}) });
      if (status === 201) {
        dlg.close();
        showToast('Party added.');
        load();
      } else if (status === 409 && out?.code === 'DUPLICATE_NAME') {
        const matches = (out.matches ?? []) as { name: string; kind: string }[];
        dupes.replaceChildren(
          h('p', { text: matches.length === 1 ? 'This payee is already in the directory:' : 'These payees are already in the directory:' }),
          h('ul', {}, ...matches.map((m) => h('li', { text: `${m.name} (${KIND_LABELS[m.kind] ?? m.kind})` }))),
          h('p', { text: 'If this is the same payee, cancel and open them from the list (add a new bank or UPI there). If it is a different payee with a similar name, add anyway.' }),
        );
        dupes.hidden = false;
        confirmDuplicate = true;
        submitBtn.textContent = 'Add anyway';
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not add that.';
      }
    });
    present(dlg, h('h2', { text: 'Add party', attrs: { id: 'party-title' } }), form);
  }
  $('add').addEventListener('click', openAddParty);

  // ---- comparing the accounts of one payee: the characters that differ are shown in red
  type Marked = { ch: string; differs: boolean }[];
  const last4Of = (a: Account) => a.shown.replace(/^ending /, '');
  const diffSpan = (m: { ch: string; differs: boolean }) => h('span', { class: m.differs ? 'diff' : '', text: m.ch });

  // A long number in groups of four from the right (for reading), as separate spans so copying it keeps no spaces.
  function numberNode(marks: Marked, grouped = true): HTMLElement {
    const sizes = grouped ? groupFromRight(marks.map((m) => m.ch).join('')).map((g) => g.length) : [marks.length];
    const out: HTMLElement[] = [];
    let at = 0;
    for (const size of sizes) {
      out.push(h('span', { class: 'grp' }, ...marks.slice(at, at + size).map(diffSpan)));
      at += size;
    }
    return h('span', { class: 'num' }, ...out);
  }

  // Reveal every account of this party at once (verify-payee + the unlock; each reveal is audited) and show the full
  // numbers lined up from the right with the differences in red. They disappear again after 30 seconds.
  async function showFullNumbers(p: Party, boxes: Map<string, HTMLElement>, dlg: HTMLDialogElement, note: HTMLElement) {
    if (!mayVerify()) return;
    const revealed = await Promise.all(p.accounts.map((a) => call(`/api/finance-admin/accounts/${a.id}/reveal`, 'POST')));
    const failed = revealed.find((r) => r.status !== 200);
    if (failed) {
      if (failed.data?.code === 'STEP_UP_REQUIRED') lock.open();
      else showToast(failed.data?.error ?? 'Could not show those details.');
      return;
    }
    const details = revealed.map((r) => r.data.details as { method: string; account?: string; ifsc?: string; upi?: string });
    const lines = new Map<string, HTMLElement[]>();
    const add = (id: string, label: string, node: HTMLElement) => lines.set(id, [...(lines.get(id) ?? []), h('div', { class: 'full-line' }, h('span', { class: 'full-label', text: label }), node)]);
    for (const method of ['bank', 'upi']) {
      const idx = details.map((d, i) => (d.method === method ? i : -1)).filter((i) => i >= 0);
      if (!idx.length) continue;
      if (method === 'bank') {
        const numbers = markDiff(idx.map((i) => details[i].account ?? ''));
        const ifscs = markDiff(idx.map((i) => details[i].ifsc ?? ''));
        idx.forEach((i, k) => {
          add(p.accounts[i].id, 'Account number', numberNode(numbers[k]));
          add(p.accounts[i].id, 'IFSC code', details[i].ifsc ? numberNode(ifscs[k], false) : h('span', { class: 'diff', text: 'Missing' }));
        });
      } else {
        const ids = markDiff(idx.map((i) => details[i].upi ?? ''));
        idx.forEach((i, k) => add(p.accounts[i].id, 'UPI id', numberNode(ids[k], false)));
      }
    }
    const hide = () => {
      boxes.forEach((box) => {
        box.replaceChildren();
        box.hidden = true;
      });
      note.hidden = true;
    };
    boxes.forEach((box, id) => {
      box.replaceChildren(...(lines.get(id) ?? []));
      box.hidden = false;
    });
    note.hidden = false;
    const timer = window.setTimeout(hide, 30_000);
    dlg.addEventListener('close', () => { clearTimeout(timer); hide(); }, { once: true });
  }

  function openDetail(id: string) {
    const p = data?.parties.find((x) => x.id === id);
    if (!p) return;
    const dlg = $<HTMLDialogElement>('detail-sheet');
    const boxes = new Map<string, HTMLElement>();
    const accounts = p.accounts.map((a) => {
      const retired = isRetired(a);
      const peers = p.accounts.filter((x) => x.method === a.method);
      const ending = markDiff(peers.map(last4Of))[peers.indexOf(a)];
      const full = h('div', { class: 'acct-full', attrs: { hidden: '' } });
      boxes.set(a.id, full);
      // "two bank accounts in use" is about the payee, not one account: it is shown once, above the list.
      const v = a.verification;
      const notes = [
        v ? `Verified${v.by ? ` by ${v.by}` : ''}${v.at ? ` on ${niceDate(v.at.slice(0, 10))}` : ''} · ${v.methodLabel}${v.note ? ` · ${v.note}` : ''}` : null,
        v?.name ? `Name at the bank: ${v.name}${namesResemble(p.name, v.name) ? '' : ' (differs from the label)'}` : null,
        retired ? `Retired from ${niceDate(a.retiredOn!)}. Do not pay this account.` : a.retiredOn ? `Retires on ${niceDate(a.retiredOn)}; payable until the day before.` : null,
        a.validFrom && a.validFrom > todayIST() ? `Starts on ${niceDate(a.validFrom)}.` : null,
        ...(retired ? [] : a.review.filter((r) => r !== 'multiple_live_accounts').map((r) => REVIEW_TEXT[r] ?? r)),
      ].filter((t): t is string => Boolean(t));
      const status = retired ? pill('Retired', 'crit') : a.retiredOn ? pill('Retiring', 'warn') : a.status === 'verified' ? pill('Verified', 'ok') : pill('Unverified', 'warn');
      const verify = a.status === 'unverified' && !retired && data?.canVerify ? button('Check details…', () => openVerify(p, a)) : null;
      const retire = !retired && data?.canVerify ? button(a.retiredOn ? 'Move date…' : 'Retire…', () => openRetire(p, a)) : null;
      const evidenceCount = (a.evidence?.payment ?? 0) + (a.evidence?.name_check ?? 0) + (a.evidence?.other ?? 0);
      const viewEvidence = evidenceCount > 0 && data?.canVerify ? button(`View evidence (${evidenceCount})`, () => void openEvidence(p, a)) : null;
      const addIfsc = a.status === 'unverified' && !a.retiredOn && data?.canVerify && a.review.includes('missing_ifsc') ? button('Add IFSC…', () => openAddIfsc(p, a)) : null;
      return h(
        'li',
        {},
        h(
          'div',
          { class: 'acct' },
          h('div', { class: 'acct-head' }, h('span', { class: 'title' }, document.createTextNode(`${a.method === 'bank' ? 'Bank account' : 'UPI'} ending `), ...ending.map(diffSpan)), status),
          full,
          ...notes.map((t) => h('span', { class: 'detail', text: t })),
          verify || retire || addIfsc || viewEvidence ? h('div', { class: 'acct-actions' }, addIfsc, verify, viewEvidence, retire) : null,
        ),
      );
    });
    const fullNote = h('p', { class: 'hint', text: 'Shown for 30 seconds. Showing them is logged. Red marks what differs between the accounts.', attrs: { hidden: '' } });
    const twoLive = p.accounts.some((a) => !isRetired(a) && a.review.includes('multiple_live_accounts'));
    const actions: Node[] = [closeBtn(dlg)];
    if (data?.canVerify) actions.unshift(button('Merge into…', () => openMerge(p)));
    if (data?.canVerify && p.accounts.length > 1) actions.unshift(button('Compare full numbers', () => void showFullNumbers(p, boxes, dlg, fullNote)));
    if (data?.canVerify && p.accounts.some((a) => a.review.includes('multiple_live_accounts'))) actions.unshift(button('Keep both: reviewed', () => keepBoth(p, dlg)));
    if (data?.canEdit) {
      actions.unshift(button('Rename…', () => openRename(p)), button('Add or change details', () => openAccount(p)), button(p.active ? 'Mark inactive' : 'Mark active', () => setActive(p, dlg)));
    }
    present(
      dlg,
      h('h2', { text: p.name, attrs: { id: 'detail-title' } }),
      data?.canEdit ? h('div', { class: 'stack-form' }, labelled('Kind', kindSelect(p))) : h('p', { class: 'sheet-text', text: `${KIND_LABELS[p.kind] ?? p.kind}${p.active ? '' : ' · inactive'}` }),
      twoLive ? h('p', { class: 'note', text: REVIEW_TEXT.multiple_live_accounts }) : null,
      fullNote,
      h('ul', { class: 'list' }, ...(accounts.length ? accounts : [h('li', {}, h('div', { class: 'acct' }, h('span', { class: 'detail', text: 'No payment details yet.' })))])),
      p.mergedCount ? h('p', { class: 'hint', text: `Includes the accounts of ${p.mergedCount} duplicate ${p.mergedCount === 1 ? 'party' : 'parties'} merged into this one.` }) : null,
      p.earlierAccounts ? h('p', { class: 'hint', text: `${p.earlierAccounts} earlier set${p.earlierAccounts === 1 ? '' : 's'} of details kept on record.` }) : null,
      h('div', { class: 'sheet-actions' }, ...actions),
    );
  }

  async function setActive(p: Party, dlg: HTMLDialogElement) {
    const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', { active: !p.active });
    if (status === 200) {
      dlg.close();
      showToast(p.active ? 'Marked inactive.' : 'Marked active.');
      load();
    } else showToast(out?.error ?? 'Could not change that.');
  }

  // Retire an account from a date. From that day nothing may be paid to it. A past date is fine (it stopped working
  // before we found out). Needs the unlock, like verifying.
  function openRetire(p: Party, a: Account) {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const on = input('on', { type: 'date', required: '' });
    const reason = input('reason', { placeholder: 'e.g. Bank merged; new account from 1 April', maxlength: '200', required: '' });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    // What this leaves the payee with, said before the button, because a payee with nothing to pay is the costly outcome.
    const kept = p.accounts.filter((x) => x.id !== a.id && x.method === a.method && !isRetired(x)).length;
    const kind = a.method === 'bank' ? 'bank' : 'UPI';
    const consequence = kept
      ? h('p', { class: 'hint', text: `${p.name} keeps ${kept} other ${kind} account${kept === 1 ? '' : 's'} to pay.` })
      : h('p', { class: 'note', text: `From this date ${p.name} will have no ${kind} account to pay. Add and verify a new one first.` });
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled('Do not pay this account from', on),
      labelled('Why', reason),
      consequence,
      h('p', { class: 'hint', text: a.retiredOn ? 'A retirement can only be moved earlier, never later.' : 'It stays on record. Make sure the payee has another account set up and verified before this date.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--danger', text: a.retiredOn ? 'Move the date' : 'Retire account', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/retire`, 'POST', { on: on.value, reason: reason.value });
      if (status === 200) {
        dlg.close();
        showToast('Retired.');
        load();
      } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not retire that.';
      }
    });
    present(dlg, h('h2', { text: `Retire ${a.method === 'bank' ? 'bank account' : 'UPI'} ${a.shown}`, attrs: { id: 'account-title' } }), form);
  }

  // Two parties that are really one payee. Nothing is deleted or moved: this party is hidden and its accounts appear under
  // the one you choose, where the old and new bank accounts are reviewed together. Needs the unlock, like verifying.
  // What the person needs to see to decide which of two parties stays: the same facts for each, side by side.
  function mergeFacts(x: Party): string[] {
    const live = liveAccounts(x);
    const lines = [`${KIND_LABELS[x.kind] ?? x.kind}${x.active ? '' : ' · inactive'}${x.formerSince ? ' · former member' : ''}`];
    lines.push(live.length ? live.map((a) => `${a.method === 'bank' ? 'Bank' : 'UPI'} ${a.shown}${a.status === 'verified' ? ' (verified)' : ' (not verified)'}`).join(', ') : 'No payment details');
    if (bankNames(x).length) lines.push(`Name at the bank: ${bankNames(x).join(', ')}`);
    const files = evidenceCount(x);
    lines.push(files ? `${files} evidence ${files === 1 ? 'file' : 'files'}` : 'No evidence attached');
    // Money both ways. `lines`, `receivedPaise` and `lastReceived` arrive with the Received column; until then only the payments-out figures exist,
    // so each is read defensively and the sheet is right with or without them.
    const books = x as Party & { lines?: number; receivedPaise?: number; lastReceived?: string | null };
    const count = books.lines ?? x.postings;
    const last = [x.lastPaid, books.lastReceived ?? null].filter((d): d is string => Boolean(d)).sort().pop();
    lines.push(count ? [`${count} ${count === 1 ? 'line' : 'lines'} in the books`, x.paidPaise > 0 ? `${rupees(x.paidPaise)} paid` : '', (books.receivedPaise ?? 0) > 0 ? `${rupees(books.receivedPaise!)} received` : '', last ? `last ${niceIso(last)}` : ''].filter(Boolean).join(' · ') : 'Nothing in the books yet');
    if (x.mergedCount) lines.push(`Already holds ${x.mergedCount} merged ${x.mergedCount === 1 ? 'party' : 'parties'}`);
    return lines;
  }
  // The one merged away must not be a member linked to a household, nor already hold merged parties (the server enforces the same).
  const whyNotMergedAway = (x: Party): string | null => (x.householdId ? 'Linked to a household, so it has to be the one that stays.' : x.mergedCount > 0 ? 'Other parties were merged into it, so it has to be the one that stays.' : null);

  // Two parties that are really one payee. Nothing is deleted or moved: the one you do not keep is hidden and its accounts appear
  // under the one you keep, where the old and new bank accounts are reviewed together. Needs the unlock, like verifying.
  // Opened with both parties known (a suggestion, or two ticked rows) it shows them side by side; opened from one party it first
  // asks for the other. Either way the person chooses which stays.
  function openMerge(p: Party, presetId = '') {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const others = (data?.parties ?? []).filter((x) => x.id !== p.id);
    let other: Party | null = others.find((x) => x.id === presetId) ?? null;
    let keepId = other?.id ?? ''; // the suggestion's choice to start with; the person can change it
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const body = h('div', { class: 'merge-body' });
    const go = h('button', { class: 'button button--primary', text: 'Merge', attrs: { type: 'submit' } }) as HTMLButtonElement;
    const form = h('form', { class: 'stack-form' }, body, msg, h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), go));

    function paint() {
      msg.hidden = true;
      if (!other) {
        const pick = combo({ options: others.map((x) => ({ value: x.id, label: x.name })), value: '', blank: 'Choose the other party…', matcher: matchOptions, ariaLabel: 'The other party' }) as any;
        pick.addEventListener('change', () => {
          other = others.find((x) => x.id === pick.value) ?? null;
          keepId = other?.id ?? '';
          paint();
        });
        body.replaceChildren(labelled(`"${p.name}" is the same payee as`, pick), h('p', { class: 'hint', text: 'You will see both side by side and choose which one stays.' }));
        go.disabled = true;
        go.textContent = 'Merge';
        return;
      }
      const pair = [p, other];
      const allowed = pair.filter((x) => !whyNotMergedAway(pair.find((y) => y !== x)!)); // x may stay when the other can be merged away
      if (!allowed.length) {
        body.replaceChildren(h('p', { class: 'error', text: 'These two cannot be merged: each one is linked to a household or already holds merged parties. Undo or change that first.' }));
        go.disabled = true;
        return;
      }
      if (!allowed.some((x) => x.id === keepId)) keepId = allowed[0].id;
      const keep = pair.find((x) => x.id === keepId)!;
      const drop = pair.find((x) => x.id !== keepId)!;
      const card = (x: Party) => {
        const blocked = !allowed.includes(x);
        const radio = h('input', { attrs: { type: 'radio', name: 'keep', value: x.id, ...(blocked ? { disabled: '' } : {}) } }) as HTMLInputElement;
        radio.checked = x.id === keepId;
        radio.addEventListener('change', () => {
          keepId = x.id;
          paint();
        });
        return h('label', { class: `merge-card${x.id === keepId ? ' is-keep' : ''}${blocked ? ' is-blocked' : ''}` },
          h('span', { class: 'merge-pick' }, radio, h('span', { text: x.id === keepId ? 'Keep this one' : 'Merge this one away' })),
          h('span', { class: 'title', text: x.name }),
          ...mergeFacts(x).map((t) => h('span', { class: 'detail', text: t })),
          blocked ? h('span', { class: 'merge-note', text: `Cannot stay: ${whyNotMergedAway(pair.find((y) => y !== x)!)?.toLowerCase()}` }) : null);
      };
      body.replaceChildren(
        ...[
        h('div', { class: 'merge-cols' }, card(p), card(other)),
        h('p', { class: 'merge-summary' }, h('strong', { text: `"${drop.name}"` }), document.createTextNode(' will be hidden from the list and its payment details and history will show under '), h('strong', { text: `"${keep.name}"` }), document.createTextNode('. Nothing is deleted and nothing is paid differently; if the payee then has two bank accounts, retire the old one. The name that stays is the one shown, and you can rename it afterwards.')),
        !presetId ? h('button', { class: 'linklike', text: 'Choose a different party', attrs: { type: 'button' }, on: { click: () => { other = null; keepId = ''; paint(); } } }) : null,
        ].filter((n): n is HTMLElement => n !== null),
      );
      go.disabled = false;
      go.textContent = `Merge into "${keep.name}"`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!other || !keepId) return;
      const keep = [p, other].find((x) => x.id === keepId)!;
      const drop = [p, other].find((x) => x.id !== keepId)!;
      const { status, data: out } = await call(`/api/finance-admin/parties/${drop.id}/merge`, 'POST', { into: keep.id });
      if (status === 200) {
        dlg.close();
        showToast('Merged.');
        load();
      } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not merge those.';
      }
    });
    paint();
    present(dlg, h('h2', { text: other ? 'Merge two parties' : `Merge ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  // Rename: the name is a label (what is typed in the transfer sheet, and what is searched), so it can be fixed any time;
  // everything that points at the party does so by id. A name another party already has is a warning that offers merging.
  function openRename(p: Party) {
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const name = input('name', { maxlength: '120' });
    name.value = p.name;
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const dupes = h('div', { class: 'note', attrs: { hidden: '', role: 'alert' } });
    const submitBtn = h('button', { class: 'button button--primary', text: 'Rename', attrs: { type: 'submit' } }) as HTMLButtonElement;
    let confirmDuplicate = false;
    name.addEventListener('input', () => {
      confirmDuplicate = false;
      dupes.hidden = true;
      submitBtn.textContent = 'Rename';
    });
    const form = h(
      'form',
      { class: 'stack-form' },
      labelled('Name', name),
      p.kind === 'member' ? h('p', { class: 'hint', text: 'This name is matched to the member records. Change it only to fix a spelling.' }) : null,
      h('p', { class: 'hint', text: 'Payments, requests and ledger lines stay with this payee; only the name shown changes.' }),
      dupes,
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), submitBtn),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.hidden = true;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}`, 'PATCH', { name: name.value, ...(confirmDuplicate ? { confirmDuplicate: true } : {}) });
      if (status === 200) {
        dlg.close();
        showToast(out?.changed?.length ? 'Renamed.' : 'Nothing to change.');
        load();
      } else if (status === 409 && out?.code === 'DUPLICATE_NAME') {
        const matches = (out.matches ?? []) as { id: string; name: string; kind: string }[];
        dupes.replaceChildren(
          h('p', { text: matches.length === 1 ? 'Another payee already has this name:' : 'Other payees already have this name:' }),
          h('ul', {}, ...matches.map((m) => h('li', {}, document.createTextNode(`${m.name} (${KIND_LABELS[m.kind] ?? m.kind}) `), data?.canVerify ? button('Merge into this one…', () => openMerge(p, m.id)) : null))),
          h('p', { text: 'If they are the same payee, merge this one into it. If they are different people, use the name anyway.' }),
        );
        dupes.hidden = false;
        confirmDuplicate = true;
        submitBtn.textContent = 'Use this name anyway';
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not rename that.';
      }
    });
    present(dlg, h('h2', { text: `Rename ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  // Bank details loaded without an IFSC: the number stays on the server, the IFSC is typed here. The old row is kept as
  // "earlier details" and the new one starts unverified (the same account, so no date and no retired row).
  function openAddIfsc(p: Party, a: Account) {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const ifsc = input('ifsc');
    const branch = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    watchIfsc(ifsc, branch);
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      h('p', { class: 'sheet-text', text: `This bank account ending ${last4Of(a)} was loaded without an IFSC code, so it cannot be verified yet.` }),
      labelled('IFSC code', ifsc),
      branch,
      h('p', { class: 'hint', text: 'The account number stays as it is. The old entry is kept on record, and the completed one still has to be verified.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Add IFSC', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/ifsc`, 'POST', { ifsc: ifsc.value });
      if (status === 201) {
        dlg.close();
        showToast('IFSC added. Check the details to verify it.');
        load();
      } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not add that.';
      }
    });
    present(dlg, h('h2', { text: `Add IFSC for ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  async function keepBoth(p: Party, dlg: HTMLDialogElement) {
    if (!mayVerify()) return;
    const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}/review`, 'POST');
    if (status === 200) {
      dlg.close();
      showToast('Recorded. This stays until another account is added.');
      load();
    } else if (out?.code === 'STEP_UP_REQUIRED') lock.open();
    else showToast(out?.error ?? 'Could not record that.');
  }

  function openAccount(p: Party) {
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const payee = payeeFields();
    const effective = input('effectiveOn', { type: 'date' });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      ...payee.nodes,
      data?.canVerify ? labelled('Takes effect on (optional)', effective) : null,
      h('p', { class: 'hint', text: data?.canVerify ? 'Leave the date empty to replace the current details now: nothing is paid to that payee until the new details are verified. With a date, the old account stays payable until that day and is retired from it; the new one starts that day.' : 'New or changed details start unverified and replace the current ones of that kind until a director confirms them. The old details are kept.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), h('button', { class: 'button button--primary', text: 'Save details', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (effective.value && !mayVerify()) return;
      const { status, data: out } = await call(`/api/finance-admin/parties/${p.id}/accounts`, 'POST', { ...payee.value(), ...(effective.value ? { effectiveOn: effective.value } : {}) });
      if (out?.code === 'STEP_UP_REQUIRED') {
        lock.open();
        return;
      }
      if (status === 200 || status === 201) {
        dlg.close();
        showToast(out?.unchanged ? 'Those details are already on record.' : 'Saved. A director needs to verify them.');
        load();
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not save that.';
      }
    });
    present(dlg, h('h2', { text: `Details for ${p.name}`, attrs: { id: 'account-title' } }), form);
  }

  // The payees still to verify, in list order: each with its first unverified account.
  function verifyQueue(): { p: Party; a: Account }[] {
    return (data?.parties ?? []).filter(hasLiveUnverified).map((p) => ({ p, a: p.accounts.find((x) => x.status === 'unverified' && !isRetired(x))! }));
  }

  // The verification screen: shows the full details once, asks how they were checked, records it with who and when, and
  // can carry straight on to the next payee. The details disappear from the page when the sheet closes.
  const authHeaders = (): Record<string, string> => ({ authorization: `Bearer ${getToken() ?? ''}`, ...(getStepUp() ? { 'x-stepup-token': getStepUp()! } : {}) });
  const evidenceKindOf = (id: string): 'payment' | 'name_check' | null => (VERIFY_METHODS.find((m: { id: string }) => m.id === id) as { evidence?: 'payment' | 'name_check' } | undefined)?.evidence ?? null;
  const EVIDENCE_NAMES: Record<string, string> = { name_check: "The bank's payee-name screen", payment: 'The transfer success screen', other: 'Other file' };

  // The screenshots kept against one account. They are fetched with the same unlock as verifying (each view is logged) and shown
  // from in-memory copies that are released when the sheet closes; nothing is ever linked or cached.
  async function openEvidence(p: Party, a: Account) {
    if (!mayVerify()) return;
    $<HTMLDialogElement>('detail-sheet').close();
    const dlg = $<HTMLDialogElement>('account-sheet');
    const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/evidence`);
    if (status !== 200) {
      if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else showToast(out?.error ?? 'Could not open the files.');
      return;
    }
    const urls: string[] = [];
    const figures: Node[] = [];
    for (const f of (out.files ?? []) as { id: string; kind: string; mime: string }[]) {
      const res = await fetch(`/api/finance-admin/evidence/${f.id}`, { headers: authHeaders() });
      if (!res.ok) continue;
      const url = URL.createObjectURL(await res.blob());
      urls.push(url);
      figures.push(
        h('figure', { class: 'evidence-figure' }, f.mime === 'application/pdf' ? h('a', { text: 'Open the PDF', attrs: { href: url, target: '_blank', rel: 'noopener' } }) : h('img', { attrs: { src: url, alt: EVIDENCE_NAMES[f.kind] ?? 'Evidence' } }), h('figcaption', { class: 'hint', text: EVIDENCE_NAMES[f.kind] ?? 'File' })),
      );
    }
    dlg.addEventListener('close', () => urls.forEach((u) => URL.revokeObjectURL(u)), { once: true });
    present(dlg, h('h2', { text: `Evidence: ${p.name}`, attrs: { id: 'account-title' } }), h('p', { class: 'hint', text: `${a.method === 'bank' ? 'Bank account' : 'UPI'} ${a.shown}. Showing these is logged.` }), ...(figures.length ? figures : [h('p', { class: 'hint', text: 'No files could be loaded.' })]), h('div', { class: 'sheet-actions' }, closeBtn(dlg)));
  }

  async function openVerify(p: Party, a: Account) {
    if (!mayVerify()) return;
    const dlg = $<HTMLDialogElement>('verify-sheet');
    const { status, data: out } = await call(`/api/finance-admin/accounts/${a.id}/reveal`, 'POST');
    if (status !== 200) {
      if (out?.code === 'STEP_UP_REQUIRED') lock.open();
      else showToast(out?.error ?? 'Could not show those details.');
      return;
    }
    const d = out.details as { method: string; account?: string; ifsc?: string; upi?: string };
    const noIfsc = d.method === 'bank' && !d.ifsc;
    const lines = d.method === 'bank' ? [['Account number', d.account], ['IFSC code', d.ifsc || 'Missing: add it first']] : [['UPI id', d.upi]];
    const queue = verifyQueue();
    const at = queue.findIndex((x) => x.p.id === p.id);
    const others = p.accounts.filter((x) => x.id !== a.id && x.method === a.method && !isRetired(x));
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const branchNote = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    if (d.ifsc) {
      branchNote.dataset.asked = d.ifsc;
      void showBranch(d.ifsc, branchNote);
    }

    const radios = VERIFY_METHODS.map((m: { id: string; label: string }) => {
      const radio = h('input', { attrs: { type: 'radio', name: 'how', value: m.id } }) as HTMLInputElement;
      return { radio, node: h('label', { class: 'radio' }, radio, h('span', { text: m.label })) };
    });
    const note = input('note', { maxlength: '200', placeholder: 'For example, where the cheque photo is kept' });

    // The two screenshot methods: the file is attached (and kept against this account) before verifying, and the person says they
    // compared it with the details above. The name the bank showed is compared with the party label as a hint only.
    const attached: Record<string, number> = { payment: a.evidence?.payment ?? 0, name_check: a.evidence?.name_check ?? 0 };
    const fileInput = h('input', { attrs: { type: 'file', accept: 'image/jpeg,image/png,image/webp,application/pdf', 'aria-label': 'Choose the screenshot' } }) as HTMLInputElement;
    const evidenceLabel = h('p', { class: 'field-label' });
    const attachedNote = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    const previews = h('div', { class: 'evidence-previews' });
    const bankName = input('name', { maxlength: '120', placeholder: 'As the bank shows it' });
    const nameField = labelled('Name the bank showed', bankName);
    const nameHint = h('p', { class: 'hint', attrs: { hidden: '', 'aria-live': 'polite' } });
    const compared = h('input', { attrs: { type: 'checkbox' } }) as HTMLInputElement;
    const comparedText = h('span');
    const evidenceBox = h('div', { class: 'stack-form evidence-box', attrs: { hidden: '' } }, evidenceLabel, fileInput, attachedNote, previews, nameField, nameHint, h('label', {}, compared, comparedText));
    const last4 = last4Of(a);
    const tail = d.method === 'bank' ? `the account ending ${last4} and IFSC ${d.ifsc ?? ''}` : `the UPI id ending ${last4} and its @ part`;
    const showEvidence = () => {
      const kind = evidenceKindOf(chosen());
      evidenceBox.hidden = kind === null;
      if (!kind) return;
      evidenceLabel.textContent = kind === 'name_check' ? "Attach the bank's payee-name screen (\"Name as per Payee Bank\")" : 'Attach the transfer success screen';
      nameField.hidden = kind !== 'name_check';
      comparedText.textContent = `I checked that the screenshot shows ${tail}${kind === 'payment' ? ', and that the amount and date are right' : ''}.`;
      attachedNote.hidden = !attached[kind];
      attachedNote.textContent = `${attached[kind]} file${attached[kind] === 1 ? '' : 's'} attached to this account.`;
    };
    const syncName = () => {
      const typed = bankName.value.trim();
      nameHint.hidden = typed.length < 2;
      if (typed.length < 2) return;
      const ok = namesResemble(p.name, typed);
      nameHint.className = ok ? 'hint' : 'note';
      nameHint.textContent = ok ? 'This looks like the party label.' : `This does not look like "${p.name}". Check it is the right account, or rename the party if its label is wrong.`;
    };
    async function attach(file: File) {
      const kind = evidenceKindOf(chosen());
      if (!kind) return;
      msg.hidden = true;
      const form = new FormData();
      form.set('file', file);
      form.set('kind', kind);
      const res = await fetch(`/api/finance-admin/accounts/${a.id}/evidence`, { method: 'POST', headers: authHeaders(), body: form });
      const out = (await res.json().catch(() => ({}))) as { error?: string; code?: string };
      if (res.status === 401) return showGate('Your session expired. Sign in again.');
      if (out.code === 'STEP_UP_REQUIRED') return lock.open();
      if (res.status !== 201) {
        msg.hidden = false;
        msg.textContent = out.error ?? 'The file could not be saved.';
        return;
      }
      attached[kind] += 1;
      previews.append(file.type === 'application/pdf' ? h('span', { class: 'hint', text: `PDF attached: ${file.name}` }) : h('img', { attrs: { src: URL.createObjectURL(file), alt: 'The screenshot you attached' } }));
      showEvidence();
      sync();
    }
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (file) await attach(file);
      fileInput.value = '';
    });
    const hasNext = queue.length > 1;
    const verifyBtn = h('button', { class: hasNext ? 'button button--outline' : 'button button--primary', text: 'Mark as verified', attrs: { type: 'button' } }) as HTMLButtonElement;
    const nextBtn = h('button', { class: 'button button--primary', text: 'Mark as verified and open next', attrs: { type: 'button' } }) as HTMLButtonElement;
    if (!hasNext) nextBtn.hidden = true;

    const chosen = () => radios.find((r) => r.radio.checked)?.radio.value ?? '';
    const evidenceReady = () => {
      const kind = evidenceKindOf(chosen());
      return !kind || (attached[kind] > 0 && compared.checked && (kind !== 'name_check' || bankName.value.trim().length >= 2));
    };
    const ready = () => !noIfsc && evidenceReady() && (chosen() === 'other' ? note.value.trim().length >= 3 : chosen() !== '');
    const sync = () => {
      verifyBtn.disabled = !ready();
      nextBtn.disabled = !ready();
    };
    radios.forEach((r) =>
      r.radio.addEventListener('change', () => {
        showEvidence();
        sync();
      }),
    );
    note.addEventListener('input', sync);
    compared.addEventListener('change', sync);
    bankName.addEventListener('input', () => {
      syncName();
      sync();
    });

    async function submit(openNext: boolean) {
      verifyBtn.disabled = true;
      nextBtn.disabled = true;
      const res = await call(`/api/finance-admin/accounts/${a.id}/verify`, 'POST', { method: chosen(), note: note.value, ...(evidenceKindOf(chosen()) === 'name_check' ? { name: bankName.value } : {}) });
      if (res.status === 200) {
        dlg.close();
        showToast('Verified.');
        const order = (data?.parties ?? []).map((x) => x.id);
        const here = order.indexOf(p.id);
        await load();
        if (openNext) {
          const after = verifyQueue();
          const next = after.find((x) => order.indexOf(x.p.id) >= here) ?? after[0];
          if (next) void openVerify(next.p, next.a);
          else showToast('That was the last one to verify.');
        }
      } else if (res.data?.code === 'STEP_UP_REQUIRED') {
        lock.open();
        sync();
      } else {
        msg.hidden = false;
        msg.textContent = res.data?.error ?? 'Could not verify.';
        sync();
      }
    }
    verifyBtn.addEventListener('click', () => void submit(false));
    nextBtn.addEventListener('click', () => void submit(true));
    sync();
    if (noIfsc) {
      msg.hidden = false;
      msg.textContent = 'These details have no IFSC code yet. Close this, choose "Add or change details", and enter the account again with its IFSC.';
    }
    // Only a sheet that is really closed is emptied: the next payee's sheet may already be open when this one's close event lands.
    dlg.addEventListener('close', () => { if (!dlg.open) dlg.replaceChildren(); }, { once: true });
    present(
      dlg,
      h('div', { class: 'verify-head' }, h('h2', { text: `Check details: ${p.name}`, attrs: { id: 'verify-title' } }), at >= 0 ? h('span', { class: 'small-note', text: `${at + 1} of ${queue.length} to verify` }) : null),
      h('ul', { class: 'list' }, ...lines.map(([k, v]) => h('li', {}, h('div', { class: 'row' }, h('span', { class: 'grow' }, h('span', { class: 'detail', text: k }), h('span', { class: 'title', text: v ?? '' })))))),
      branchNote,
      others.length ? h('p', { class: 'note', text: `This payee also has an account ending ${others.map(last4Of).join(' and ')}. Check which one they use now before verifying.` }) : null,
      h('p', { class: 'hint', text: 'Marking as verified says these details match what the payee gave you, so they can be paid. This sheet does not pay anyone.' }),
      h('p', { class: 'field-label', text: 'How did you check these details?' }),
      h('div', { class: 'radios', attrs: { role: 'group', 'aria-label': 'How you checked' } }, ...radios.map((r) => r.node)),
      evidenceBox,
      h('div', { class: 'stack-form' }, labelled('Note (optional)', note)),
      h('p', { class: 'hint', text: 'Showing these is logged. You cannot verify details you entered yourself.' }),
      msg,
      h('div', { class: 'sheet-actions' }, closeBtn(dlg, 'Cancel'), verifyBtn, nextBtn),
    );
  }

  if (getToken()) load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .parties.section.wrapper {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .parties .bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .parties .bar .field {
    flex: 1;
  }

  /* The shared sheet is 420px; this one carries accounts and several actions, so it gets more room. */
  /* The layout styles .sheet with a scoped selector, so these carry extra specificity to win. */
  .parties.section dialog.sheet {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }

  /* One account: name and status on a line, notes beneath at full width, then its buttons. */
  .parties .acct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 12px 14px;
  }

  .parties .acct-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
