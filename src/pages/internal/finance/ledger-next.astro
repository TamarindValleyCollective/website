---
// PROTOTYPE (not linked from the navigation): the finance ledger rebuilt on TanStack Table (column, sort and selection state) and
// TanStack Virtual (only the rows on screen exist in the page), against the same /api/finance-admin/ledger endpoint as ledger.astro.
// What it tries out: edits that change one cell instead of rebuilding the row, a stable progress line, a status that says what a line
// still needs, row-specific control names, a themed action bar that says why Post is disabled, Ctrl+Enter to accept a row's
// suggestions and move to the next, and a card layout on a phone. It also adds a party from the cell, shows the months with Close
// month, and keeps a post failure on screen until dismissed. It has the line sheet too (split into rows, refunds,
// review decisions, add a party). Not here yet: the "apply to the other N" prompt.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import SignInGate from '../../../components/SignInGate.astro';
---

<StaffLayout title="Finance ledger (prototype)" description="Prototype of the ledger on TanStack Table." current="finance" currentPage="finance-ledger">
  <section class="lnext section wrapper">
    <h1>Ledger <span class="proto-tag">prototype</span></h1>
    <p id="intro" class="hint">Sign in to open the ledger.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <div class="lbar">
        <label class="field">
          <span class="visually-hidden">Search the narration</span>
          <input id="q" type="search" placeholder="Search the bank's narration" autocomplete="off" />
        </label>
        <div class="segmented" id="chips" role="group" aria-label="Show"></div>
        <label class="sortpick">
          <span>Sort</span>
          <select id="sortpick" aria-label="Sort the lines">
            <option value="date:desc">Newest first</option>
            <option value="date:asc">Oldest first</option>
            <option value="amount:desc">Largest first</option>
            <option value="amount:asc">Smallest first</option>
            <option value="narration:asc">Narration A to Z</option>
            <option value="category:asc">Category</option>
            <option value="party:asc">Party</option>
          </select>
        </label>
        <button type="button" id="accept-all" class="button button--outline" hidden>Fill in the suggestions</button>
      </div>
      <div id="postnote" class="postnote" role="alert" hidden></div>
      <p id="progress" class="progress" aria-live="polite"></p>

      <div class="grid" id="grid" role="table" aria-label="Bank lines">
        <div class="ghead" id="ghead" role="row"></div>
        <div class="gfilter" id="gfilter" role="row"></div>
        <div class="gscroll" id="gscroll">
          <div class="gspacer" id="gspacer" role="rowgroup"></div>
        </div>
      </div>
      <div id="empty" class="hint" aria-live="polite" hidden></div>
      <h2 class="list-title">Months</h2>
      <ul class="list" id="months"></ul>
      <p class="hint">Click a heading to sort, type under one to search that column; click a narration to split the line, refund it, or see its history. Tab moves through the cells; Ctrl+Enter on a line accepts its suggestions and moves to the next.</p>
    </div>
    <div id="actionbar" class="abar" role="region" aria-label="Selected lines" hidden></div>
    <dialog id="party-sheet" class="sheet" aria-labelledby="party-title"></dialog>
    <dialog id="line-sheet" class="sheet" aria-labelledby="line-title"></dialog>
  </section>
</StaffLayout>

<script>
  import { createTable, getCoreRowModel } from '@tanstack/table-core';
  import { Virtualizer, elementScroll, observeElementOffset, observeElementRect } from '@tanstack/virtual-core';
  import { StaffAuthError, askSheet, clearStepUp, clearToken, closeOnBackdrop, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';
  import { button, categorySelect, h, input, labelled, niceDate, niceMonth, parseRupees, partySelect, pill, present, rupees } from '../../../../scripts/lib/finance-ui.mjs';
  import { compareRows, describeCondition, matchAmount, matchDate, matchText, parseAmount, parseDate, parseText } from '../../../../scripts/lib/finance-columns.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  type Suggestion = { categoryId: string | null; partyId: string | null; nature: string; confidence: string; newPartyName: string | null };
  type Line = {
    id: string; date: string; narration: string; direction: 'debit' | 'credit'; amountPaise: number; account: string; remark: string | null; counterparty: string | null;
    state: 'unallocated' | 'partly_allocated' | 'allocated'; review: boolean; missingParty: boolean; suggestion: Suggestion | null;
    allocation: { categoryId: string; partyId: string | null; nature: string; count: number; householdLabel: string | null; maintenanceYear: string | null } | null;
    effective: { category: string; party: string; nature: string }; // what it was posted to, or is suggested: what the column searches read
  };
  type Category = { id: string; name: string; type: string; active: boolean };
  type Party = { id: string; name: string; kind: string };
  type Project = { id: string; name: string; kind: string; financial_year: number; status: string };
  type Lookups = { categories: Category[]; parties: Party[]; projects: Project[]; requesterPartyId: string | null; closedMonths: string[]; households: { id: string; label: string }[] };
  type Filter = 'unallocated' | 'review' | 'noparty' | 'all';
  type ListData = { canAllocate: boolean; lines: Line[]; lookups: Lookups };
  type Field = 'categoryId' | 'partyId' | 'nature';
  type Draft = Record<Field, string>;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');
  const scrollEl = $('gscroll');
  const spacer = $('gspacer');

  let data: ListData | null = null;
  let all: Line[] = []; // every bank line, fetched once
  let lines: Line[] = []; // the ones the chip, search and column conditions leave, in sort order
  let counts: Record<Filter, number> = { unallocated: 0, review: 0, noparty: 0, all: 0 };
  let filterErrors: Record<string, string> = {};
  let filter: Filter = 'unallocated';
  let query = '';
  const colFilters: Record<string, string> = {};
  let loadSeq = 0;
  let postedThisSitting = 0;

  // ---- sign-in (same as the real ledger)
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to open the ledger.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    if (typeof google !== 'undefined') {
      google.accounts.id.initialize({ client_id: CLIENT_ID, callback: (r: { credential: string }) => { setToken(r.credential); void load(); } });
      google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
    }
  }
  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });
  // After any write the next list read asks the server for fresh data (it keeps a few seconds of reads otherwise).
  let wantFresh = false;
  async function call(path: string, method = 'GET', body?: unknown) {
    if (method !== 'GET') wantFresh = true;
    try {
      return await staffFetch(path, { method, body });
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else {
          gate.hidden = true;
          content.hidden = true;
          forbidden.hidden = false;
          $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
        }
      }
      throw err;
    }
  }

  // ---- drafts: what you have typed but not posted. They live in this page only.
  const drafts = new Map<string, Draft>();
  const rowErrors = new Map<string, string>();
  const draftOf = (id: string): Draft => drafts.get(id) ?? { categoryId: '', partyId: '', nature: '' };
  const setDraft = (id: string, patch: Partial<Draft>) => {
    drafts.set(id, { ...draftOf(id), ...patch });
    rowErrors.delete(id);
  };
  const editable = (l: Line) => Boolean(data?.canAllocate) && l.state === 'unallocated' && !l.review;
  const nameOf = (list: { id: string; name: string }[], id: string | null) => list.find((x) => x.id === id)?.name ?? '';
  const ghostOf = (l: Line, f: Field): string => {
    const s = l.suggestion;
    if (!s || draftOf(l.id)[f]) return '';
    return f === 'categoryId' ? s.categoryId ?? '' : f === 'partyId' ? s.partyId ?? '' : s.nature ?? '';
  };
  const strangerOf = (l: Line) => (!draftOf(l.id).partyId && !l.suggestion?.partyId ? l.suggestion?.newPartyName ?? '' : '');
  const hasGhost = (l: Line) => Boolean(ghostOf(l, 'categoryId') || ghostOf(l, 'partyId') || ghostOf(l, 'nature'));
  const partyNeeded = (categoryId: string) => {
    const c = data?.lookups.categories.find((x) => x.id === categoryId);
    return Boolean(c) && !['interest', 'transfer'].includes(c!.type) && !/bank charges/i.test(c!.name);
  };
  const isReady = (l: Line) => {
    const d = draftOf(l.id);
    return Boolean(d.categoryId && d.nature.trim());
  };
  window.addEventListener('beforeunload', (e) => {
    if ([...drafts.values()].some((d) => d.categoryId || d.partyId || d.nature)) e.preventDefault();
  });

  // ---- TanStack Table: the column model, the sort state and the selection state. The server sorts and searches (manual mode).
  const table = createTable<Line>({
    data: [],
    columns: [
      { id: 'select', header: '', enableSorting: false },
      { id: 'date', header: 'Date', accessorFn: (l: Line) => l.date },
      { id: 'narration', header: 'Bank narration', accessorFn: (l: Line) => l.narration },
      { id: 'amount', header: 'Amount', accessorFn: (l: Line) => l.amountPaise },
      { id: 'category', header: 'Category', accessorFn: (l: Line) => l.allocation?.categoryId ?? '' },
      { id: 'party', header: 'Party', accessorFn: (l: Line) => l.allocation?.partyId ?? '' },
      { id: 'nature', header: 'What it was for', accessorFn: (l: Line) => l.allocation?.nature ?? '' },
      { id: 'status', header: 'Status', enableSorting: false },
    ],
    getRowId: (l: Line) => l.id,
    getCoreRowModel: getCoreRowModel(),
    manualSorting: true,
    enableSortingRemoval: false,
    enableMultiSort: false,
    sortDescFirst: false,
    enableRowSelection: (row: any) => editable(row.original),
    state: {},
    onStateChange: () => {},
    renderFallbackValue: null,
  } as any);
  let tstate: any = { ...table.initialState, sorting: [{ id: 'date', desc: true }] };
  const syncTable = () =>
    table.setOptions((prev: any) => ({
      ...prev,
      data: lines,
      state: tstate,
      onStateChange: (updater: any) => {
        tstate = typeof updater === 'function' ? updater(tstate) : updater;
        syncTable();
      },
      onSortingChange: (updater: any) => {
        tstate = { ...tstate, sorting: typeof updater === 'function' ? updater(tstate.sorting) : updater };
        syncTable();
        applyView(true);
      },
      onRowSelectionChange: (updater: any) => {
        tstate = { ...tstate, rowSelection: typeof updater === 'function' ? updater(tstate.rowSelection) : updater };
        syncTable();
        refreshSelection();
      },
    }));
  syncTable();
  const sortOf = () => ({ key: tstate.sorting[0]?.id ?? 'date', dir: tstate.sorting[0]?.desc === false ? 'asc' : 'desc' });
  const selectedLines = () => lines.filter((l) => tstate.rowSelection[l.id] && editable(l));

  // ---- TanStack Virtual: only the rows near the screen are in the page.
  const phone = window.matchMedia('(max-width: 900px)');
  let painting = false;
  let repaint = false; // a measurement changed a row's height while painting: place the rows again
  let pendingFocus: { index: number; field: Field } | null = null;
  const mounted = new Map<string, HTMLElement>();
  const virtualizer = new Virtualizer<HTMLElement, HTMLElement>({
    count: 0,
    getScrollElement: () => scrollEl,
    estimateSize: () => (phone.matches ? 270 : 66),
    overscan: 8,
    getItemKey: (i) => lines[i]?.id ?? i,
    scrollToFn: elementScroll,
    observeElementRect,
    observeElementOffset,
    onChange: () => (painting ? (repaint = true) : paint()),
  });
  virtualizer._didMount();
  virtualizer._willUpdate();
  phone.addEventListener('change', () => {
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    virtualizer.measure();
    paint();
  });

  function setCount() {
    syncTable();
    virtualizer.setOptions({ ...virtualizer.options, count: lines.length });
    virtualizer._willUpdate();
    paint();
  }

  // ---- loading: every line comes down once (about two seconds); sorting, searching and the chips then happen here, instantly.
  const setBusy = (on: boolean, message = '') => {
    $('grid').classList.toggle('is-loading', on);
    $('grid').setAttribute('aria-busy', String(on));
    if (on) $('progress').textContent = message;
  };
  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (!data) showLoading(statusEl);
    else setBusy(true, 'Refreshing from the bank records…');
    try {
      const seq = ++loadSeq;
      const { status, data: out } = await call(`/api/finance-admin/ledger/all${wantFresh ? '?fresh=1' : ''}`);
      wantFresh = false;
      if (seq !== loadSeq) return;
      if (status !== 200) throw new Error('load failed');
      data = out as ListData;
      all = data.lines;
      clearState(statusEl);
      intro.hidden = false;
      intro.textContent = 'Every line the bank has told us about, and what it was for.';
      content.hidden = false;
      applyView();
      void loadMonths();
    } catch (err) {
      if (err instanceof StaffAuthError) return;
      content.hidden = true;
      showFailure(statusEl, { title: "Couldn't load the ledger", text: "The server didn't answer. Nothing was changed. Check your connection and try again.", onRetry: () => load() });
    } finally {
      setBusy(false);
    }
  }

  const CONFIDENCE_WORDS: Record<string, string> = { high: 'confident', medium: 'fairly sure', low: 'a guess' };
  // ---- one line: what it says, and the allocation editor
  type Alloc = { id: string; partyId: string | null; categoryId: string; projectId: string | null; amountPaise: number; period: string; nature: string; remarks: string | null; source: string; reviewState: string; reviewReason: string | null; householdId: string | null; maintenanceYear: string | null; reversesAllocationId: string | null; reversalReason: string | null; posted: boolean };
  type Reversible = { id: string; date: string; partyId: string | null; categoryId: string; nature: string; remainingPaise: number };
  type Detail = {
    canAllocate: boolean;
    line: { id: string; date: string; narration: string; direction: 'debit' | 'credit'; amountPaise: number };
    upi: { counterparty: string | null; remark: string | null; isCircle: boolean } | null;
    state: string;
    allocations: Alloc[];
    proposal: { categoryId: string | null; partyId: string | null; nature: string; amountPaise: number; period: string; source: string; ruleId: string | null } | null;
    suggestion: (Suggestion & { reasons: string[]; newParty: { name: string; kind: string } | null }) | null;
    reasons: string[];
    reversible: Reversible[];
    lookups: Lookups;
    reasonLabels: Record<string, string>;
  };

  const monthOf = (iso: string) => iso.slice(0, 7);

  async function openLine(id: string) {
    const dlg = $<HTMLDialogElement>('line-sheet');
    const { status, data: d } = await call(`/api/finance-admin/ledger/${id}`);
    if (status !== 200) {
      showToast(d?.error ?? 'Could not open that line.');
      return;
    }
    const detail = d as Detail;
    const { line, upi } = detail;
    const head = [
      h('h2', { text: `${line.direction === 'debit' ? 'Paid' : 'Received'} ${rupees(line.amountPaise)}`, attrs: { id: 'line-title' } }),
      h('p', { class: 'sheet-text', text: `${niceDate(line.date)} · ${line.narration}` }),
      upi?.remark || upi?.counterparty ? h('p', { class: 'hint', text: [upi.counterparty ? `Paytm says: ${upi.counterparty}` : '', upi.remark ? `remark "${upi.remark}"` : '', upi.isCircle ? 'a circle payment' : ''].filter(Boolean).join(', ') }) : null,
    ];
    const posted = detail.allocations.some((a) => a.posted);
    dlg.addEventListener('close', () => dlg.replaceChildren(), { once: true });
    if (posted || !detail.canAllocate) present(dlg, closeOnBackdrop, ...head, postedView(dlg, detail), h('div', { class: 'sheet-actions' }, button('Close', () => dlg.close())));
    else present(dlg, closeOnBackdrop, ...head, editor(dlg, detail));
  }

  // A posted line: what explains it, with review decisions for anything flagged.
  function postedView(dlg: HTMLDialogElement, d: Detail): HTMLElement {
    const lk = d.lookups;
    if (!d.allocations.length) return h('p', { class: 'note', text: 'Nothing explains this line yet.' });
    return h(
      'ul',
      { class: 'list' },
      ...d.allocations.map((a) => {
        const reasons = (a.reviewReason ?? '').split(',').filter(Boolean).map((r) => d.reasonLabels[r] ?? r);
        const actions: HTMLElement[] = [];
        if (d.canAllocate && a.reviewState !== 'ok') {
          actions.push(
            button('Mark as checked', async () => {
              const { status, data: out } = await call(`/api/finance-admin/allocations/${a.id}/review`, 'POST', { action: 'resolve' });
              if (status === 200) {
                dlg.close();
                showToast('Marked as checked.');
                void load();
              } else showToast(out?.error ?? 'Could not do that.');
            }),
          );
        } else if (d.canAllocate && a.posted) {
          actions.push(
            button('Flag for review', async () => {
              const { status, data: out } = await call(`/api/finance-admin/allocations/${a.id}/review`, 'POST', { action: 'flag' });
              if (status === 200) {
                dlg.close();
                showToast('Flagged for review.');
                void load();
              } else showToast(out?.error ?? 'Could not do that.');
            }, 'button button--outline button--small'),
          );
        }
        return h(
          'li',
          {},
          h(
            'div',
            { class: 'row alloc-row' },
            h(
              'span',
              { class: 'grow' },
              h('span', { class: 'title', text: a.reversesAllocationId ? `Refund: ${a.nature}` : a.nature }),
              h('span', { class: 'detail', text: [nameOf(lk.categories, a.categoryId), nameOf(lk.parties, a.partyId), a.householdId ? `Unit ${lk.households.find((x) => x.id === a.householdId)?.label ?? ''}` : '', a.maintenanceYear ?? '', niceMonth(a.period)].filter(Boolean).join(' · ') }),
              reasons.length ? h('span', { class: 'detail detail--warn', text: reasons.join('. ') }) : null,
            ),
            h('span', { class: 'amount', text: rupees(a.amountPaise) }),
            ...actions,
          ),
        );
      }),
    );
  }


  // Why the form is filled in the way it is, in plain words. Nothing here is posted until a person presses Post.
  function suggestionNote(d: Detail): HTMLElement | null {
    const sg = d.suggestion;
    if (!sg || !sg.reasons.length) return null;
    return h('div', { class: 'suggest-note' }, h('p', { class: 'field-label', text: `Why this suggestion (${CONFIDENCE_WORDS[sg.confidence] ?? 'a guess'})` }), h('ul', { class: 'why' }, ...sg.reasons.map((r) => h('li', { text: r }))));
  }

  // ---- the editor: rows that add up to the line
  function editor(dlg: HTMLDialogElement, d: Detail): HTMLElement {
    const lk = d.lookups;
    const line = d.line;
    type RowUi = { el: HTMLElement; household: HTMLSelectElement; year: HTMLInputElement; unitBox: HTMLElement; amount: HTMLInputElement; category: HTMLSelectElement; party: HTMLSelectElement; nature: HTMLInputElement; period: HTMLInputElement; project: HTMLSelectElement | null; reverses: HTMLSelectElement | null; reason: HTMLInputElement; ruleId: string | null; source: string };
    const rowsUi: RowUi[] = [];
    const rowsBox = h('div', { class: 'alloc-rows' });
    const remainingEl = h('p', { class: 'remaining', attrs: { 'aria-live': 'polite' } });
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const closedReason = input('closedReason', { placeholder: 'Why is a closed month being changed?' }) as HTMLInputElement;
    const closedBox = h('div', { class: 'stack-form', attrs: { hidden: '' } }, labelled('Reason for changing a closed month', closedReason));

    // Every party picker in this sheet, so a party added in one row is available in all of them.
    const partySelects: HTMLSelectElement[] = [];
    function addPartyEverywhere(p: Party) {
      lk.parties.push(p);
      for (const sel of partySelects) {
        const opt = h('option', { text: p.name, attrs: { value: p.id } });
        sel.insertBefore(opt, sel.querySelector(`option[value="${NEW_PARTY}"]`));
      }
    }
    // Add a party that is not in the register yet, right here. Bank details are added later on the Parties page and verified there.
    function openNewParty(box: HTMLElement, name: string, kind: string, onAdded: (id: string) => void) {
      const nameInput = input('newPartyName', { placeholder: 'Name as it should appear in the register' }) as HTMLInputElement;
      nameInput.value = name;
      const kindSel = h('select', { attrs: { name: 'newPartyKind' } }, ...Object.entries(PARTY_KINDS).map(([k, label]) => h('option', { text: label, attrs: { value: k } }))) as HTMLSelectElement;
      kindSel.value = kind;
      const note = h('p', { class: 'error', attrs: { hidden: '' } });
      const add = button('Add to register', async () => {
        const typed = nameInput.value.trim().replace(/\s+/g, ' ');
        const twin = lk.parties.find((x) => x.name.toLowerCase() === typed.toLowerCase());
        if (twin) {
          note.hidden = false;
          note.textContent = `${twin.name} is already in the register. Choose them from the list.`;
          return;
        }
        const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: typed, kind: kindSel.value });
        if (status !== 201) {
          note.hidden = false;
          note.textContent = out?.error ?? 'Could not add that.';
          return;
        }
        addPartyEverywhere({ id: out.party.id, name: out.party.name, kind: out.party.kind });
        box.hidden = true;
        onAdded(out.party.id);
        showToast(`${out.party.name} added to the register. Add their bank details on the Parties page.`);
      }, 'button button--primary button--small');
      box.replaceChildren(labelled('Name', nameInput), labelled('What kind of party', kindSel), note, h('div', { class: 'sheet-actions' }, add, button('Cancel', () => (box.hidden = true), 'button button--outline button--small')));
      box.hidden = false;
      nameInput.focus();
    }

    const sumPaise = () => rowsUi.reduce((n, r) => n + (parseRupees(r.amount.value) ?? 0), 0);
    function refresh() {
      const left = line.amountPaise - sumPaise();
      remainingEl.textContent = left === 0 ? 'Adds up to the line. Ready to post.' : left > 0 ? `${rupees(left)} still to allocate.` : `${rupees(-left)} more than the line.`;
      remainingEl.className = `remaining${left === 0 ? ' remaining--ok' : left < 0 ? ' remaining--over' : ''}`;
      const closedUsed = rowsUi.some((r) => lk.closedMonths.some((m) => m.slice(0, 7) === r.period.value));
      closedBox.hidden = !closedUsed;
    }

    function addRow(init: Partial<{ amountPaise: number; categoryId: string; partyId: string; nature: string; period: string; ruleId: string | null; source: string }> = {}) {
      const amount = input('amount', { inputmode: 'decimal', placeholder: '0.00', 'aria-label': 'Amount' }) as HTMLInputElement;
      amount.value = init.amountPaise ? (init.amountPaise / 100).toFixed(2) : '';
      const category = categorySelect(lk.categories, { selected: init.categoryId ?? '' });
      const party = partySelect(lk.parties, { selected: init.partyId ?? '' });
      party.append(h('option', { text: 'Add a new party…', attrs: { value: NEW_PARTY } }));
      const newBox = h('div', { class: 'stack-form new-party', attrs: { hidden: '' } });
      party.addEventListener('change', () => {
        if (party.value !== NEW_PARTY) {
          newBox.hidden = true;
          return;
        }
        party.value = '';
        openNewParty(newBox, d.suggestion?.newParty?.name ?? '', d.suggestion?.newParty?.kind ?? (line.direction === 'credit' ? 'customer' : 'vendor'), (id) => {
          party.value = id;
          refresh();
        });
      });
      partySelects.push(party);
      const nature = input('nature', { placeholder: 'What it was for, in plain words' }) as HTMLInputElement;
      nature.value = init.nature ?? '';
      const period = input('period', { type: 'month', 'aria-label': 'Month it belongs to' }) as HTMLInputElement;
      period.value = monthOf(init.period ?? line.date);
      const project = lk.projects.length ? (h('select', { attrs: { name: 'project' } }, h('option', { text: 'Not part of a project', attrs: { value: '' } }), ...lk.projects.map((p) => h('option', { text: `${p.name} (${p.financial_year})`, attrs: { value: p.id } }))) as HTMLSelectElement) : null;
      const reverses = d.reversible.length
        ? (h('select', { attrs: { name: 'reverses' } }, h('option', { text: 'This is not a refund', attrs: { value: '' } }), ...d.reversible.map((r) => h('option', { text: `${niceDate(r.date)} · ${r.nature} · ${rupees(r.remainingPaise)} left`, attrs: { value: r.id } }))) as HTMLSelectElement)
        : null;
      const reason = input('reason', { placeholder: 'Why is it being refunded?' }) as HTMLInputElement;
      const reasonBox = labelled('Reason', reason);
      reasonBox.hidden = true;
      // Maintenance is paid by anybody and allocated to a unit: the unit and the year it pays for are asked for when the category is maintenance.
      const isMaintenance = () => lk.categories.find((c) => c.id === category.value)?.type === 'member_contribution';
      const household = h('select', { attrs: { name: 'household' } }, h('option', { text: 'Choose the unit…', attrs: { value: '' } }), ...lk.households.map((x) => h('option', { text: x.label, attrs: { value: x.id } }))) as HTMLSelectElement;
      const fyOf = (iso: string) => {
        const start = Number(iso.slice(5, 7)) >= 4 ? Number(iso.slice(0, 4)) : Number(iso.slice(0, 4)) - 1;
        return `${start}-${String((start + 1) % 100).padStart(2, '0')}`;
      };
      const year = input('maintenanceYear', { placeholder: '2025-26', 'aria-label': 'Maintenance year' }) as HTMLInputElement;
      year.value = fyOf(line.date);
      const unitBox = h('div', { class: 'stack-form alloc-top' }, labelled('Unit', household), labelled('Maintenance year', year));
      unitBox.hidden = !isMaintenance();
      category.addEventListener('change', () => (unitBox.hidden = !isMaintenance()));
      const normal = h('div', { class: 'stack-form' }, labelled('Category', category), labelled('Party', party), newBox, unitBox, labelled('What it was for', nature), project ? labelled('Project', project) : null);
      const el = h('fieldset', { class: 'alloc-edit' });
      const ui: RowUi = { el, household, year, unitBox, amount, category, party, nature, period, project, reverses, reason, ruleId: init.ruleId ?? null, source: init.source ?? 'manual' };
      reverses?.addEventListener('change', () => {
        const refund = Boolean(reverses.value);
        normal.hidden = refund;
        reasonBox.hidden = !refund;
        if (refund) {
          const target = d.reversible.find((r) => r.id === reverses.value);
          if (target && !parseRupees(amount.value)) amount.value = (Math.min(target.remainingPaise, line.amountPaise) / 100).toFixed(2);
          refresh();
        }
      });
      for (const f of [amount, period]) f.addEventListener('input', refresh);
      el.append(
        ...[
        h('div', { class: 'stack-form alloc-top' }, labelled('Amount (₹)', amount), labelled('Month', period), rowsUi.length ? button('Remove', () => { rowsUi.splice(rowsUi.indexOf(ui), 1); el.remove(); refresh(); }, 'button button--outline button--small') : h('span')),
        reverses ? h('div', { class: 'stack-form' }, labelled('Refund of', reverses)) : null,
        h('div', { class: 'stack-form' }, reasonBox),
        normal,
        ].filter((n): n is HTMLElement => n !== null),
      );
      rowsUi.push(ui);
      rowsBox.append(el);
      refresh();
      return ui;
    }

    // Start from the rule's suggestion when there is one, otherwise a blank row for the whole line.
    const p = d.proposal;
    addRow({ amountPaise: line.amountPaise, categoryId: p?.categoryId ?? '', partyId: p?.partyId ?? '', nature: p?.nature ?? '', ruleId: p?.ruleId ?? null, source: p?.source === 'rule' ? 'rule' : p?.source === 'upi_remark' ? 'upi_remark' : 'manual' });
    // A name in the narration that is not in the register: open the add-party form for the first row, ready to confirm.
    if (d.suggestion?.newParty && !p?.partyId) {
      const first = rowsUi[0].party;
      first.value = NEW_PARTY;
      first.dispatchEvent(new Event('change'));
    }
    const why = d.reasons.map((r) => d.reasonLabels[r]).filter(Boolean);

    async function submit(post: boolean) {
      msg.hidden = true;
      const payload = rowsUi.map((r) => ({
        amountPaise: parseRupees(r.amount.value) ?? 0,
        period: r.period.value ? `${r.period.value}-01` : undefined,
        ...(r.reverses?.value ? { reversesAllocationId: r.reverses.value, reversalReason: r.reason.value, nature: r.nature.value } : { categoryId: r.category.value, partyId: r.party.value || null, projectId: r.project?.value || null, nature: r.nature.value, ruleId: r.ruleId, source: r.source, ...(r.unitBox.hidden ? {} : { householdId: r.household.value || null, maintenanceYear: r.year.value.trim() || null }) }),
      }));
      const { status, data: out } = await call(`/api/finance-admin/ledger/${line.id}/allocations`, 'POST', { rows: payload, post, overrideReason: closedReason.value });
      if (status === 200) {
        dlg.close();
        showToast(post ? 'Posted.' : 'Draft saved.');
        void load();
      } else {
        msg.hidden = false;
        msg.textContent = out?.error ?? 'Could not save that.';
      }
    }

    const wrap = h(
      'div',
      { class: 'editor' },
      suggestionNote(d),
      why.length ? h('p', { class: 'note', text: `${why.join('. ')}.` }) : null,
      rowsBox,
      h('div', { class: 'editor-tools' }, button('Add another row', () => { const left = line.amountPaise - sumPaise(); addRow({ amountPaise: left > 0 ? left : undefined }); })),
      remainingEl,
      closedBox,
      msg,
      h('div', { class: 'sheet-actions' }, button('Cancel', () => dlg.close()), button('Save draft', () => void submit(false)), button('Post', () => void submit(true), 'button button--primary')),
    );
    refresh();
    return wrap;
  }


  // ---- months: what is left in each, and closing one once everything in it is posted and checked
  type Month = { month: string; status: 'open' | 'closed'; unallocated: number; review: number };
  let readyMonths: string[] = [];
  async function loadMonths() {
    const { status, data: out } = await call('/api/finance-admin/periods');
    if (status !== 200) return;
    const canClose = Boolean(out.canClose);
    const months = out.months as Month[];
    readyMonths = months.filter((m) => m.status === 'open' && m.unallocated === 0 && m.review === 0).map((m) => niceMonth(m.month));
    renderProgress();
    $('months').replaceChildren(
      ...months.map((m) => {
        const ready = m.unallocated === 0 && m.review === 0;
        const detail = m.status === 'closed' ? 'Closed' : ready ? 'Everything is posted and checked.' : [m.unallocated ? `${m.unallocated} to allocate` : '', m.review ? `${m.review} to review` : ''].filter(Boolean).join(' · ');
        const close = canClose && m.status === 'open' && ready ? button('Close month', async () => {
          const res = await call(`/api/finance-admin/periods/${m.month}/close`, 'POST');
          showToast(res.status === 200 ? `${niceMonth(m.month)} closed.` : res.data?.error ?? 'Could not close it.');
          void loadMonths();
        }) : null;
        return h('li', {}, h('div', { class: 'row' }, h('span', { class: 'grow' }, h('span', { class: 'title', text: niceMonth(m.month) }), h('span', { class: 'detail', text: detail })), m.status === 'closed' ? pill('Closed', 'ok') : null, close));
      }),
    );
  }

  // The chip, the narration search and the column conditions, then the sort, over every line already here (same rules as the server's:
  // scripts/lib/finance-columns.mjs). Nothing is fetched.
  const dateLabel = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  const COLUMN_LABELS: Record<string, string> = { date: 'Date', narration: 'Narration', amount: 'Amount', category: 'Category', party: 'Party', nature: 'Wording' };
  const PARSERS: Record<string, (raw: string) => any> = { date: parseDate, narration: parseText, amount: parseAmount, category: parseText, party: parseText, nature: parseText };
  function applyView(toTop = false) {
    if (!data) return;
    const conds: Record<string, any> = {};
    filterErrors = {};
    for (const col of Object.keys(PARSERS)) {
      const parsed = PARSERS[col]((colFilters[col] ?? '').slice(0, 80));
      if (!parsed) continue;
      if (parsed.error) filterErrors[col] = parsed.error;
      else conds[col] = parsed;
    }
    const base = all.filter(
      (l) =>
        matchDate(conds.date, l.date, dateLabel(l.date)) &&
        matchText(conds.narration, l.narration) &&
        matchAmount(conds.amount, l.amountPaise) &&
        matchText(conds.category, l.effective.category) &&
        matchText(conds.party, l.effective.party) &&
        matchText(conds.nature, l.effective.nature) &&
        (!query || l.narration.toLowerCase().includes(query)),
    );
    counts = { unallocated: 0, review: 0, noparty: 0, all: base.length };
    for (const l of base) {
      if (l.state !== 'allocated') counts.unallocated++;
      if (l.review) counts.review++;
      if (l.missingParty) counts.noparty++;
    }
    const shown = base.filter((l) => (filter === 'all' ? true : filter === 'unallocated' ? l.state !== 'allocated' : filter === 'noparty' ? l.missingParty : l.review));
    const sort = sortOf();
    const compare = compareRows(sort.key, sort.dir as 'asc' | 'desc');
    const row = (l: Line) => ({ id: l.id, date: l.date, narration: l.narration, amount: l.amountPaise, category: l.effective.category, party: l.effective.party, nature: l.effective.nature, status: l.review ? 'review' : l.state });
    lines = shown.map((l) => ({ l, r: row(l) })).sort((a, b) => compare(a.r, b.r)).map((x) => x.l);
    const crumbs = Object.keys(conds).map((c) => describeCondition(COLUMN_LABELS[c], conds[c]));
    for (const box of document.querySelectorAll<HTMLInputElement>('.colfilter')) {
      const bad = Boolean(filterErrors[box.dataset.col!]);
      box.setAttribute('aria-invalid', String(bad));
      box.title = filterErrors[box.dataset.col!] ?? '';
    }
    if (toTop) scrollEl.scrollTop = 0;
    renderChips();
    renderHead();
    renderProgress(crumbs);
    setCount();
    refreshSelection();
    $('accept-all').hidden = !(data.canAllocate && filter === 'unallocated' && lines.some((l) => editable(l) && hasGhost(l)));
    $('empty').hidden = lines.length > 0;
    if (!lines.length) $('empty').textContent = crumbs.length || query ? 'Nothing matches those conditions.' : filter === 'unallocated' ? 'Everything is allocated.' : 'Nothing here right now.';
  }

  // ---- toolbar, progress and headings
  const CHIPS: [Filter, string][] = [['unallocated', 'To allocate'], ['review', 'To review'], ['noparty', 'No party'], ['all', 'All']];
  function renderChips() {
    $('chips').replaceChildren(
      ...CHIPS.map(([f, label]) => {
        const b = h('button', { attrs: { type: 'button', 'aria-pressed': String(f === filter) } }, h('span', { text: `${label} ${counts[f]}` }));
        b.addEventListener('click', () => {
          filter = f;
          applyView(true);
        });
        return b;
      }),
    );
  }
  function renderProgress(crumbs: string[] = []) {
    if (!data) return;
    const c = counts;
    const errs = Object.entries(filterErrors).map(([col, why]) => `Can't read the ${COLUMN_LABELS[col]} search: ${why}`);
    $('progress').textContent = [`Showing ${lines.length} of ${all.length}`, `${c.unallocated} left to allocate`, `${c.review} to review`, c.noparty ? `${c.noparty} posted without a party` : '', postedThisSitting ? `${postedThisSitting} posted this sitting` : '', readyMonths.length ? `${readyMonths.join(', ')} ready to close (see Months below)` : '', crumbs.length ? `Searching: ${crumbs.join(', ')}` : '', ...errs].filter(Boolean).join(' · ');
  }
  const SORTABLE = new Set(['date', 'narration', 'amount', 'category', 'party', 'nature']);
  function renderHead() {
    const head = $('ghead');
    head.replaceChildren(
      ...table.getHeaderGroups()[0].headers.map((header) => {
        const id = header.column.id;
        const sorted = header.column.getIsSorted();
        const label = String(header.column.columnDef.header ?? '');
        const cellEl = h('span', { class: `gcell gcell--${id}`, attrs: { role: 'columnheader', ...(SORTABLE.has(id) ? { 'aria-sort': sorted === 'asc' ? 'ascending' : sorted === 'desc' ? 'descending' : 'none' } : {}) } });
        if (SORTABLE.has(id)) {
          const b = h('button', { class: 'sorthead', text: `${label}${sorted === 'asc' ? ' ▲' : sorted === 'desc' ? ' ▼' : ''}`, attrs: { type: 'button' } });
          b.addEventListener('click', () => header.column.toggleSorting());
          cellEl.append(b);
        } else cellEl.textContent = label;
        return cellEl;
      }),
    );
  }
  function renderFilterRow() {
    const row = $('gfilter');
    row.replaceChildren(
      ...table.getHeaderGroups()[0].headers.map((header) => {
        const id = header.column.id;
        const cellEl = h('span', { class: `gcell gcell--${id}`, attrs: { role: 'cell' } });
        if (SORTABLE.has(id)) {
          const box = h('input', { class: 'colfilter', attrs: { 'data-col': id, type: 'search', placeholder: 'Search', 'aria-label': `Search the ${String(header.column.columnDef.header)} column`, autocomplete: 'off' } }) as HTMLInputElement;
          let timer: ReturnType<typeof setTimeout>;
          box.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => {
              colFilters[id] = box.value;
              applyView(true);
            }, 150);
          });
          cellEl.append(box);
        }
        return cellEl;
      }),
    );
  }
  renderFilterRow();
  // On a phone the headings are hidden, so sorting is a pick list; it drives the same table state as the headings.
  $<HTMLSelectElement>('sortpick').addEventListener('change', (e) => {
    const [id, dir] = (e.target as HTMLSelectElement).value.split(':');
    table.setSorting([{ id, desc: dir === 'desc' }]);
  });
  let qTimer: ReturnType<typeof setTimeout>;
  $<HTMLInputElement>('q').addEventListener('input', (e) => {
    clearTimeout(qTimer);
    qTimer = setTimeout(() => {
      query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyView(true);
    }, 150);
  });

  // ---- rows. Built once when they scroll into view; an edit changes the cells in place (fill), never the row element.
  type Refs = { check: HTMLInputElement; narr: HTMLButtonElement; details: HTMLElement; cat: HTMLSelectElement; catTick: HTMLElement; catText: HTMLElement; party: HTMLSelectElement; partyTick: HTMLElement; partyText: HTMLElement; nature: HTMLInputElement; natureTick: HTMLElement; natureText: HTMLElement; pillSlot: HTMLElement };
  const refs = new WeakMap<HTMLElement, Refs>();
  const tick = (label: string, onClick: () => void) => h('button', { class: 'tick', text: '✓', attrs: { type: 'button', 'aria-label': label, title: label }, on: { click: onClick } });
  const cell = (cls: string, label: string, ...kids: (Node | null)[]) => h('span', { class: `gcell gcell--${cls}`, attrs: { role: 'cell', 'data-label': label } }, ...kids);
  const shortDate = (iso: string) => {
    const d = new Date(`${iso.slice(0, 10)}T00:00:00`);
    const text = d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
    return d.getFullYear() === new Date().getFullYear() ? text : `${text} ${String(d.getFullYear()).slice(2)}`;
  };

  function makeRow(l: Line): HTMLElement {
    const lk = data!.lookups;
    const who = l.narration.length > 40 ? `${l.narration.slice(0, 40)}…` : l.narration;
    const check = h('input', { attrs: { type: 'checkbox', 'aria-label': `Select ${who}` } }) as HTMLInputElement;
    check.addEventListener('click', (e) => pick(l.id, (e as MouseEvent).shiftKey));
    const narr = h('button', { class: 'narr', text: l.narration, attrs: { type: 'button', title: l.narration } }) as HTMLButtonElement;
    narr.addEventListener('click', () => void openLine(l.id));
    const details = h('span', { class: 'detail' });

    const cat = categorySelect(lk.categories, { selected: '', blank: 'Choose…' }) as HTMLSelectElement;
    cat.classList.add('cellfield');
    cat.setAttribute('aria-label', `Category for ${who}`);
    cat.addEventListener('change', () => edit(l, 'categoryId', cat.value));
    const catTick = tick(`Accept the suggested category for ${who}`, () => edit(l, 'categoryId', ghostOf(l, 'categoryId')));
    const catText = h('span', { class: 'lcell-text' });

    const party = partySelect(lk.parties, { selected: '', blank: 'No one in particular' }) as HTMLSelectElement;
    party.classList.add('cellfield');
    party.setAttribute('aria-label', `Party for ${who}`);
    party.append(h('option', { text: 'Add a new party…', attrs: { value: NEW_PARTY } }));
    party.addEventListener('change', () => {
      if (party.value !== NEW_PARTY) return edit(l, 'partyId', party.value);
      party.value = draftOf(l.id).partyId;
      openAddParty(strangerOf(l), kindFor(l), (id) => afterPartyAdded(l, id));
    });
    const partyTick = tick(`Accept the suggested party for ${who}`, async () => {
      const gp = ghostOf(l, 'partyId');
      if (gp) return edit(l, 'partyId', gp);
      const stranger = strangerOf(l);
      const id = stranger ? await createParty(stranger, kindFor(l)) : null;
      if (id) afterPartyAdded(l, id);
    });
    const partyText = h('span', { class: 'lcell-text' });

    const nature = h('input', { class: 'cellfield', attrs: { type: 'text', 'aria-label': `What it was for: ${who}`, placeholder: 'What it was for', autocomplete: 'off' } }) as HTMLInputElement;
    nature.addEventListener('input', () => {
      setDraft(l.id, { nature: nature.value });
      syncRow(l);
    });
    const natureTick = tick(`Accept the suggested wording for ${who}`, () => edit(l, 'nature', ghostOf(l, 'nature')));
    const natureText = h('span', { class: 'lcell-text' });
    const pillSlot = h('span', { class: 'pillslot' });

    const rowEl = h(
      'div',
      { class: 'lrow', attrs: { role: 'row', 'data-id': l.id } },
      cell('select', '', check),
      cell('date', '', document.createTextNode(shortDate(l.date))),
      cell('narration', '', narr, details),
      cell(`amount amount--${l.direction}`, '', document.createTextNode(`${l.direction === 'debit' ? '−' : '+'}${rupees(l.amountPaise)}`)),
      cell('category', 'Category', cat, catTick, catText),
      cell('party', 'Party', party, partyTick, partyText),
      cell('nature', 'What it was for', nature, natureTick, natureText),
      cell('status', '', pillSlot),
    );
    const onKey = (e: KeyboardEvent) => {
      const index = lines.findIndex((x) => x.id === l.id);
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        acceptRow(l);
        focusRow(index + 1, 'categoryId');
      } else if (e.key === 'Enter' && e.target === nature) {
        e.preventDefault();
        focusRow(index + 1, 'nature');
      }
    };
    rowEl.addEventListener('keydown', onKey);
    refs.set(rowEl, { check, narr, details, cat, catTick, catText, party, partyTick, partyText, nature, natureTick, natureText, pillSlot });
    fill(rowEl, l);
    return rowEl;
  }

  function pillFor(l: Line): HTMLElement {
    if (l.review) return pill('To review', 'crit');
    if (l.state === 'allocated') return l.missingParty ? pill('No party', 'crit') : pill('Posted', 'ok');
    if (l.state === 'partly_allocated') return pill('Partly', 'warn');
    if (!editable(l)) return pill('To allocate');
    const d = draftOf(l.id);
    if (isReady(l)) return !d.partyId && partyNeeded(d.categoryId) ? pill('Ready, no party', 'warn') : pill('Ready', 'ok');
    if (hasGhost(l)) return pill('Suggested', 'warn');
    return pill(d.categoryId ? 'Needs wording' : 'Needs category');
  }

  // Sets every cell of a mounted row from the line and its draft, without replacing any element.
  function fill(el: HTMLElement, l: Line) {
    const r = refs.get(el)!;
    const lk = data!.lookups;
    const can = editable(l);
    const d = draftOf(l.id);
    el.classList.toggle('is-locked', !can);
    el.classList.toggle('is-selected', Boolean(tstate.rowSelection[l.id]));
    r.check.disabled = !can;
    r.check.checked = Boolean(tstate.rowSelection[l.id]);
    const upiSays = [l.counterparty, l.remark ? `“${l.remark}”` : ''].filter(Boolean).join(' · ');
    const error = rowErrors.get(l.id);
    r.details.replaceChildren(
      ...[
        error ? h('span', { class: 'detail detail--warn', text: error }) : null,
        upiSays ? h('span', { class: 'detail detail--upi', text: `Paytm: ${upiSays}`, attrs: { title: 'From the Paytm UPI report' } }) : /\bUPI\b/i.test(l.narration) ? h('span', { class: 'detail detail--dim', text: 'No Paytm record for this payment' }) : null,
        l.account ? h('span', { class: 'detail', text: l.account }) : null,
      ].filter(Boolean) as Node[],
    );
    for (const x of [r.cat, r.party, r.nature]) x.hidden = !can;
    for (const x of [r.catText, r.partyText, r.natureText]) x.hidden = can;
    if (can) {
      const gc = ghostOf(l, 'categoryId');
      r.cat.value = d.categoryId;
      r.cat.options[0].text = gc ? nameOf(lk.categories, gc) : 'Choose…';
      r.cat.classList.toggle('ghost', Boolean(gc));
      r.catTick.hidden = !gc;
      const gp = ghostOf(l, 'partyId');
      const stranger = strangerOf(l);
      r.party.value = d.partyId;
      r.party.options[0].text = gp ? nameOf(lk.parties, gp) : stranger ? `New: ${stranger}` : 'No one in particular';
      r.party.classList.toggle('ghost', Boolean(gp || stranger));
      r.partyTick.hidden = !(gp || stranger);
      const tickLabel = gp ? `Accept the suggested party for ${l.narration.slice(0, 40)}` : `Add ${stranger} to the register and use them`;
      r.partyTick.setAttribute('aria-label', tickLabel);
      r.partyTick.title = tickLabel;
      const gn = ghostOf(l, 'nature');
      if (r.nature.value !== d.nature && document.activeElement !== r.nature) r.nature.value = d.nature;
      r.nature.placeholder = gn || 'What it was for';
      r.nature.classList.toggle('ghost', Boolean(gn));
      r.natureTick.hidden = !gn;
    } else {
      for (const t of [r.catTick, r.partyTick, r.natureTick]) t.hidden = true;
      const a = l.allocation;
      const forWhom = [a?.householdLabel ? `Unit ${a.householdLabel}` : '', a?.maintenanceYear ?? ''].filter(Boolean).join(' · ');
      r.catText.replaceChildren(document.createTextNode(a ? `${nameOf(lk.categories, a.categoryId)}${a.count > 1 ? ` +${a.count - 1} more` : ''}` : ''), ...(forWhom ? [h('span', { class: 'detail detail--unit', text: forWhom })] : []));
      r.partyText.replaceChildren(a?.partyId ? document.createTextNode(nameOf(lk.parties, a.partyId)) : l.missingParty ? h('span', { class: 'noparty', text: 'No party' }) : document.createTextNode(''));
      r.natureText.textContent = a?.nature ?? '';
    }
    r.pillSlot.replaceChildren(pillFor(l));
  }
  const syncRow = (l: Line) => {
    const el = mounted.get(l.id);
    if (el) fill(el, l);
    renderBar();
  };
  function edit(l: Line, field: Field, value: string) {
    setDraft(l.id, { [field]: value } as Partial<Draft>);
    syncRow(l);
  }
  // ---- adding a party that is not in the register, from the cell or the suggestion
  const NEW_PARTY = '__new_party__';
  const PARTY_KINDS: Record<string, string> = { vendor: 'Vendor', customer: 'Customer', member: 'Member', employee: 'Employee', bank: 'Bank', government: 'Government', director: 'Director', other: 'Other' };
  const kindFor = (l: Line) => (l.direction === 'credit' ? 'customer' : 'vendor');
  async function createParty(name: string, kind: string): Promise<string | null> {
    const typed = name.trim().replace(/\s+/g, ' ');
    const twin = data!.lookups.parties.find((x) => x.name.toLowerCase() === typed.toLowerCase());
    if (twin) return twin.id;
    const { status, data: out } = await call('/api/finance-admin/parties', 'POST', { name: typed, kind });
    if (status !== 201) {
      showToast(out?.error ?? 'Could not add that party.');
      return null;
    }
    const lk = data!.lookups;
    lk.parties.push({ id: out.party.id, name: out.party.name, kind: out.party.kind });
    lk.parties.sort((a, b) => a.name.localeCompare(b.name));
    showToast(`${out.party.name} added to the register. Add their bank details on the Parties page.`);
    return out.party.id as string;
  }
  function openAddParty(name: string, kind: string, onAdded: (id: string) => void) {
    const dlg = $<HTMLDialogElement>('party-sheet');
    const nameInput = input('newPartyName', { placeholder: 'Name as it should appear in the register' }) as HTMLInputElement;
    nameInput.value = name;
    const kindSel = h('select', { attrs: { name: 'newPartyKind' } }, ...Object.entries(PARTY_KINDS).map(([k, label]) => h('option', { text: label, attrs: { value: k } }))) as HTMLSelectElement;
    kindSel.value = kind;
    const msg = h('p', { class: 'error', attrs: { hidden: '' } });
    const form = h(
      'form',
      { class: 'stack-form' },
      h('p', { class: 'hint', text: 'Bank details are added and verified later, on the Parties page.' }),
      labelled('Name', nameInput),
      labelled('What kind of party', kindSel),
      msg,
      h('div', { class: 'sheet-actions' }, button('Cancel', () => dlg.close()), h('button', { class: 'button button--primary', text: 'Add to register', attrs: { type: 'submit' } })),
    );
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (nameInput.value.trim().length < 2) {
        msg.hidden = false;
        msg.textContent = 'Enter the name.';
        return;
      }
      const id = await createParty(nameInput.value, kindSel.value);
      if (!id) return;
      dlg.close();
      onAdded(id);
    });
    dlg.addEventListener('close', () => dlg.replaceChildren(), { once: true });
    present(dlg, closeOnBackdrop, h('h2', { text: 'Add a party', attrs: { id: 'party-title' } }), form);
  }
  // The new party must be in every row's list: rows are made again (they are cheap), and the line takes the party.
  function afterPartyAdded(l: Line, id: string) {
    setDraft(l.id, { partyId: id });
    for (const el of mounted.values()) el.remove();
    mounted.clear();
    paint();
    renderBar();
  }

  function acceptRow(l: Line) {
    if (!editable(l)) return;
    const patch: Partial<Draft> = {};
    for (const f of ['categoryId', 'partyId', 'nature'] as Field[]) {
      const g = ghostOf(l, f);
      if (g) patch[f] = g;
    }
    setDraft(l.id, patch);
    syncRow(l);
  }
  function focusRow(index: number, field: Field) {
    let i = index;
    while (lines[i] && !editable(lines[i])) i++;
    if (!lines[i]) return;
    pendingFocus = { index: i, field };
    virtualizer.scrollToIndex(i, { align: 'auto' });
    paint();
  }

  function paint() {
    if (painting) return;
    painting = true;
    try {
      const rows = table.getRowModel().rows;
      spacer.style.height = `${virtualizer.getTotalSize()}px`;
      const keep = new Set<string>();
      const inOrder: HTMLElement[] = [];
      for (const item of virtualizer.getVirtualItems()) {
        const l = rows[item.index]?.original;
        if (!l) continue;
        keep.add(l.id);
        let el = mounted.get(l.id);
        if (!el) {
          el = makeRow(l);
          mounted.set(l.id, el);
          spacer.append(el);
        }
        el.dataset.index = String(item.index);
        el.setAttribute('aria-rowindex', String(item.index + 3)); // the two heading rows come first
        inOrder.push(el);
        el.style.transform = `translateY(${item.start}px)`;
        virtualizer.measureElement(el);
      }
      for (const [id, el] of mounted) {
        if (!keep.has(id)) {
          el.remove();
          mounted.delete(id);
        }
      }
      // Keep the page's order the same as the table's, so Tab and a screen reader go down the lines in order (never while focus is inside).
      if (!spacer.contains(document.activeElement) && inOrder.some((el, i) => spacer.children[i] !== el)) spacer.append(...inOrder);
      $('grid').setAttribute('aria-rowcount', String(lines.length + 2));
      if (pendingFocus) {
        const l = lines[pendingFocus.index];
        const el = l && mounted.get(l.id);
        if (el) {
          const r = refs.get(el)!;
          (pendingFocus.field === 'nature' ? r.nature : pendingFocus.field === 'partyId' ? r.party : r.cat).focus();
          pendingFocus = null;
        }
      }
    } finally {
      painting = false;
    }
    if (repaint) {
      repaint = false;
      paint();
    }
  }

  // ---- selection (shift-click for a range) and the action bar
  let lastPicked: string | null = null;
  function pick(id: string, range: boolean) {
    const pickable = lines.filter(editable);
    const on = !tstate.rowSelection[id];
    const next = { ...tstate.rowSelection };
    if (range && lastPicked) {
      const a = pickable.findIndex((x) => x.id === lastPicked);
      const b = pickable.findIndex((x) => x.id === id);
      if (a >= 0 && b >= 0) for (const x of pickable.slice(Math.min(a, b), Math.max(a, b) + 1)) next[x.id] = on;
    } else next[id] = on;
    for (const k of Object.keys(next)) if (!next[k]) delete next[k];
    lastPicked = id;
    table.setRowSelection(next);
  }
  function refreshSelection() {
    for (const [id, el] of mounted) {
      const l = lines.find((x) => x.id === id);
      if (l) fill(el, l);
    }
    renderBar();
  }

  let barFields = { categoryId: '', partyId: '', nature: '' };
  function renderBar() {
    const bar = $('actionbar');
    const sel = selectedLines();
    if (!data || !sel.length) {
      bar.hidden = true;
      bar.replaceChildren();
      return;
    }
    const ready = sel.filter(isReady).length;
    const lk = data.lookups;
    const cat = categorySelect(lk.categories, { selected: barFields.categoryId, blank: 'Category…' }) as HTMLSelectElement;
    const party = partySelect(lk.parties, { selected: barFields.partyId, blank: 'Party…' }) as HTMLSelectElement;
    const words = h('input', { attrs: { type: 'text', placeholder: 'What it was for…', 'aria-label': 'Wording for the selected lines', autocomplete: 'off', value: barFields.nature } }) as HTMLInputElement;
    cat.addEventListener('change', () => (barFields.categoryId = cat.value));
    party.addEventListener('change', () => (barFields.partyId = party.value));
    words.addEventListener('input', () => (barFields.nature = words.value));
    const post = button(`Post ${ready} ready`, () => void postReady(), 'button abar-post') as HTMLButtonElement;
    post.disabled = ready === 0;
    const why = ready === 0 ? 'Post is off until a selected line has a category and wording.' : ready < sel.length ? `${sel.length - ready} selected can't post yet: they need a category and wording.` : 'Posting asks you to confirm first.';
    bar.replaceChildren(
      h('span', { class: 'abar-count', text: `${sel.length} selected · ${ready} ready`, attrs: { 'aria-live': 'polite' } }),
      cat,
      party,
      words,
      button('Apply to selected', () => {
        for (const l of sel) setDraft(l.id, Object.fromEntries(Object.entries(barFields).filter(([, v]) => String(v).trim())) as Partial<Draft>);
        for (const l of sel) syncRow(l);
      }, 'button button--outline button--small'),
      button('Accept suggestions', () => {
        for (const l of sel) acceptRow(l);
      }, 'button button--outline button--small'),
      post,
      button('Clear', () => table.resetRowSelection(), 'button button--outline button--small'),
      h('span', { class: 'abar-why', text: why }),
    );
    bar.hidden = false;
  }
  $('accept-all').addEventListener('click', () => {
    let n = 0;
    for (const l of lines) if (editable(l) && hasGhost(l)) (acceptRow(l), n++);
    showToast(`Filled in ${n} ${n === 1 ? 'line' : 'lines'}. Nothing is posted yet.`);
  });

  // ---- posting: the second step, confirmed first
  async function postReady() {
    const ready = selectedLines().filter(isReady);
    if (!ready.length) return;
    const lk = data!.lookups;
    const total = ready.reduce((n, l) => n + l.amountPaise, 0);
    const byCat = new Map<string, number>();
    for (const l of ready) byCat.set(nameOf(lk.categories, draftOf(l.id).categoryId), (byCat.get(nameOf(lk.categories, draftOf(l.id).categoryId)) ?? 0) + 1);
    const mix = [...byCat.entries()].map(([n, c]) => `${c} × ${n}`).join(', ');
    const noParty = ready.filter((l) => !draftOf(l.id).partyId && partyNeeded(draftOf(l.id).categoryId)).length;
    const unreviewed = ready.filter((l) => l.suggestion && (l.suggestion.confidence === 'low' || l.suggestion.confidence === 'none')).length;
    const ok = await askSheet({
      title: `Post ${ready.length} ${ready.length === 1 ? 'line' : 'lines'}?`,
      text: `Together ${rupees(total)}: ${mix}.${noParty ? `\n${noParty} have no party.` : ''}${unreviewed ? `\n${unreviewed} rest on a weak suggestion.` : ''}\n\nPosted lines cannot be edited, only refunded or reversed.`,
      actions: [{ label: 'Post them', value: true, kind: 'primary' }, { label: 'Cancel', value: false }],
    });
    if (!ok) return;
    let posted = 0;
    let flagged = 0;
    const failed: { lineId: string; error: string }[] = [];
    for (let i = 0; i < ready.length; i += 10) {
      const chunk = ready.slice(i, i + 10);
      showToast(`Posting ${Math.min(i + 10, ready.length)} of ${ready.length}…`);
      const items = chunk.map((l) => ({ lineId: l.id, categoryId: draftOf(l.id).categoryId, partyId: draftOf(l.id).partyId || null, nature: draftOf(l.id).nature.trim() }));
      const { status, data: out } = await call('/api/finance-admin/ledger/post', 'POST', { items });
      if (status !== 200) {
        for (const l of chunk) failed.push({ lineId: l.id, error: out?.error ?? 'Could not post this line.' });
        continue;
      }
      posted += out.posted;
      flagged += out.flagged;
      failed.push(...(out.failed as { lineId: string; error: string }[]));
    }
    const failedIds = new Set(failed.map((f) => f.lineId));
    for (const l of ready) if (!failedIds.has(l.id)) drafts.delete(l.id);
    rowErrors.clear();
    for (const f of failed) rowErrors.set(f.lineId, f.error);
    postedThisSitting += posted;
    const summary = [`${posted} posted`, flagged ? `${flagged} sent to review` : '', failed.length ? `${failed.length} could not be posted (see the red notes on those lines)` : ''].filter(Boolean).join(', ') + '.';
    showToast(summary);
    if (failed.length || flagged) {
      const note = $('postnote');
      note.replaceChildren(h('span', { text: summary }), button('Dismiss', () => (note.hidden = true), 'button button--outline button--small'));
      note.hidden = false;
    }
    await load();
  }

  if (getToken()) void load();
  else showGate();
</script>
