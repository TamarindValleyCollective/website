---
// Finance (internal): the overview. Backed by netlify/functions/finance-admin.mts (/overview). It answers "what needs me?"
// first (payees to verify, payees to review, statement gaps, Paytm payments waiting), then where things stand, then what
// the signed-in person may do, in plain words. The pages inside Finance (Parties, Import, ...) are in the left pane.
//
// Same shell as the other internal tools: Google Sign-In gated, one sign-in per tab (scripts/lib/staff-client.mjs),
// unlinked, noindex. Everything the server returns is placed with textContent only, never as HTML.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import SignInGate from '../../../components/SignInGate.astro';
---

<StaffLayout title="Finance" description="Finance." current="finance">
  <section class="finance section wrapper">
    <h1>Finance</h1>
    <p id="intro" class="hint">Sign in to open finance.</p>

    <SignInGate forbiddenWhat="finance" />

    <div id="status" aria-live="polite" class="hint" hidden></div>

    <div id="content" hidden>
      <h2 class="list-title">Needs you</h2>
      <ul class="list" id="needs"></ul>

      <h2 class="list-title">Where things stand</h2>
      <ul class="list" id="stand"></ul>

      <details class="access" id="access">
        <summary><span id="access-title">Your access</span></summary>
        <p id="access-text" class="hint"></p>
      </details>
    </div>
  </section>
</StaffLayout>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, staffFetch } from '../../../../scripts/lib/staff-client.mjs';
  import { clearState, showFailure, showLoading } from '../../../../scripts/lib/staff-states.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const ROLE_LABELS: Record<string, string> = { admin: 'Admin', user: 'User', read_only: 'Read-only' };
  // What each capability lets a person do, in plain words (the registry's own names are for the Access screen).
  const CAPABILITY_WORDS: Record<string, string> = {
    view: 'see finance',
    import: 'import statements',
    allocate: 'categorise entries',
    request: 'raise payment requests',
    approve: 'approve payments',
    'approve-payroll': 'approve salary batches',
    'verify-payee': 'verify payees',
    'close-period': 'close months',
    configure: 'set up categories and budgets',
    export: 'export data',
  };

  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(paise / 100);
  const day = (iso: string) => new Date(`${iso.slice(0, 10)}T00:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const listWords = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`);

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    intro.hidden = false;
    intro.textContent = 'Sign in to open finance.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    clearState(statusEl);
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }

  function el(tag: string, className?: string, text?: string): HTMLElement {
    const e = document.createElement(tag);
    if (className) e.className = className;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  const chevron = () => {
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    for (const [k, v] of Object.entries({ viewBox: '0 0 24 24', width: '18', height: '18', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true', focusable: 'false', class: 'chev' })) svg.setAttribute(k, v);
    const path = document.createElementNS(ns, 'path');
    path.setAttribute('d', 'M10 7l5 5-5 5');
    svg.append(path);
    return svg;
  };

  // One line of the "Needs you" list: a number, what it counts, a sentence of why, and where to go (when there is a page for it).
  function needRow(o: { count?: number; crit?: boolean; title: string; detail: string; href?: string }): HTMLElement {
    const li = el('li');
    const row = el(o.href ? 'a' : 'div', 'row need');
    if (o.href) (row as HTMLAnchorElement).href = o.href;
    row.append(el('span', `count${o.crit ? ' count--crit' : ''}`, o.count === undefined ? '' : String(o.count)));
    const grow = el('span', 'grow');
    grow.append(el('span', 'title', o.title), el('span', 'detail', o.detail));
    row.append(grow);
    if (o.href) row.append(chevron());
    li.append(row);
    return li;
  }

  function standRow(title: string, detail: string, href?: string): HTMLElement {
    const li = el('li');
    const row = el(href ? 'a' : 'div', 'row');
    if (href) (row as HTMLAnchorElement).href = href;
    const grow = el('span', 'grow');
    grow.append(el('span', 'title', title), el('span', 'detail', detail));
    row.append(grow);
    if (href) row.append(chevron());
    li.append(row);
    return li;
  }

  function render(data: any) {
    const a = data.attention;
    const parties = '/internal/finance/parties/';
    const imports = '/internal/finance/import/';
    const needs: HTMLElement[] = [];
    if (!data.hasData) {
      needs.push(needRow({ title: 'Load your payees', detail: 'Add parties by hand, or load an existing list with the import script.', href: parties }));
      needs.push(needRow({ title: 'Import a bank statement', detail: 'The Excel download from the bank, one file per year.', href: imports }));
    } else {
      if (a.toVerify > 0) needs.push(needRow({ count: a.toVerify, title: a.toVerify === 1 ? 'payee to verify' : 'payees to verify', detail: 'Check each one against its bank details', href: `${parties}?filter=unverified` }));
      if (a.needsReview > 0) needs.push(needRow({ count: a.needsReview, crit: true, title: a.needsReview === 1 ? 'payee needs review' : 'payees need review', detail: 'Two bank accounts in use, a missing IFSC, or an account shared with another payee', href: `${parties}?filter=review` }));
      if (a.toReview > 0) needs.push(needRow({ count: a.toReview, crit: true, title: a.toReview === 1 ? 'ledger entry to review' : 'ledger entries to review', detail: 'Flagged for a second look: an unverified payee, a circle payment to the requester, or a reimbursement with no bill', href: '/internal/finance/ledger/?filter=review' }));
      if (a.toAllocate > 0) needs.push(needRow({ count: a.toAllocate, title: a.toAllocate === 1 ? 'bank line to allocate' : 'bank lines to allocate', detail: 'Say what each one was for, splitting it where it covers more than one thing', href: '/internal/finance/ledger/' }));
      if (a.statementGaps.length > 0) {
        const g = a.statementGaps[0];
        const more = a.statementGaps.length > 1 ? ` and ${a.statementGaps.length - 1} more` : '';
        needs.push(needRow({ count: a.statementGaps.length, title: a.statementGaps.length === 1 ? 'statement gap' : 'statement gaps', detail: `${g.label} has no statement from ${day(g.from)} to ${day(g.to)}${more}`, href: imports }));
      }
      if (a.paytmToCheck.count > 0) needs.push(needRow({ count: a.paytmToCheck.count, crit: true, title: a.paytmToCheck.count === 1 ? 'Paytm payment with no bank line' : 'Paytm payments with no bank line', detail: `${rupees(a.paytmToCheck.totalPaise)} in all, inside a statement we hold. Worth a look.`, href: imports }));
      if (a.paytmWaiting.count > 0) needs.push(needRow({ count: a.paytmWaiting.count, title: a.paytmWaiting.count === 1 ? 'Paytm payment waiting for a bank line' : 'Paytm payments waiting for a bank line', detail: `${rupees(a.paytmWaiting.totalPaise)} in all. They match themselves when the next statement is imported.` }));
    }
    if (!needs.length) needs.push(standRow('Nothing needs you right now', 'Payees are verified and the statements are up to date.'));
    $('needs').replaceChildren(...needs);

    $('stand').replaceChildren(
      standRow('Parties', `${plural(a.parties, 'payee or customer', 'payees and customers')}${a.merged ? `, ${plural(a.merged, 'merged duplicate')}` : ''}`, parties),
      standRow('Ledger', a.toAllocate || a.toReview ? `${plural(a.toAllocate, 'line')} to allocate, ${a.toReview} to review` : 'Every line is allocated.', '/internal/finance/ledger/'),
      standRow('Statements', a.lastImportAt ? `Last import ${day(a.lastImportAt)}.` : 'Nothing imported yet.', imports),
      standRow('Bank accounts', `${a.bankAccounts} registered`),
    );

    const words = (data.capabilities as string[]).map((c) => CAPABILITY_WORDS[c]).filter(Boolean);
    $('access-title').textContent = `Your access: ${ROLE_LABELS[data.role] ?? data.role}`;
    $('access-text').textContent = `You can ${listWords(words)}. ${data.visibility.payeeBankDetails ? 'You can see payees\' bank details in full when you verify or export them.' : 'You see only the last four digits of payees\' bank details.'}`;
  }

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    showLoading(statusEl);
    try {
      const { status, data } = await staffFetch('/api/finance-admin/overview');
      if (status !== 200) throw new Error('load failed');
      clearState(statusEl);
      intro.textContent = data.entity ?? '';
      intro.hidden = !data.entity;
      render(data);
      content.hidden = false;
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
        return;
      }
      content.hidden = true;
      intro.hidden = true;
      showFailure(statusEl, { title: "Couldn't load finance", text: "The server didn't answer. Nothing was changed. Check your connection and try again; if it keeps failing, tell a super admin.", onRetry: load });
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }

  $('use-different-account').addEventListener('click', () => {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  if (getToken()) load();
  else showGate();
</script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .finance.section.wrapper {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .finance h2 {
    margin: 0 0 6px;
    font-size: var(--text-lg);
  }

  .finance .list-title {
    margin: 26px 0 8px 14px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .finance .list-title:first-child {
    margin-top: 6px;
  }

  /* A line of "Needs you": the number it counts, then what it is. */
  .finance .need {
    gap: 14px;
  }

  .finance .count {
    min-width: 3.4rem;
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .finance .count:empty {
    min-width: 0;
  }

  .finance .count--crit {
    color: var(--tvc-error-text);
  }

  .finance .chev {
    flex: none;
    color: var(--tvc-ink-soft);
  }

  .finance .access {
    margin-top: 14px;
    padding: 12px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
  }

  .finance .access summary {
    cursor: pointer;
    font-weight: 500;
  }

  .finance .access .hint {
    margin: 8px 0 0;
  }
</style>
