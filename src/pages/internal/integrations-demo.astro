---
// Evaluation-only sample page: candidate third-party integrations that
// could enrich the public site, each rendered here with data fetched live
// (client-side, same LAT/LNG the rest of the site already uses) so
// reviewers can judge real output quality before any of this is wired into
// an actual page. Nothing here is linked from nav; noindex; not a
// production feature — if a candidate is approved, its fetch logic should
// move into the relevant page/widget and this file can be deleted.
//
// Second round, after the first six (Open-Meteo air quality, SoilGrids,
// NASA POWER, GBIF, sunrisesunset.io, Wikipedia geosearch — see git history)
// were rejected as either too trivial or not clearly dated/sourced enough to
// trust. This round picks two candidates specifically for having a real,
// checkable "as of" (a dated satellite mosaic; a named station with its own
// last-updated timestamp) rather than a modeled estimate.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LAT, LNG } from '../../utils/weather';

// Sentinel-2 cloudless (EOX IT Services, s2maps.eu) publishes a handful of
// named yearly global mosaics, not a continuous archive — 2018 and 2020 are
// the two most recent kept here since both are confirmed-published vintages;
// double check https://s2maps.eu for whatever's newest before this goes live.
const SAT_YEARS = ['2018', '2020'];
---

<BaseLayout title="Integration Ideas — Evaluation" description="Sample page evaluating candidate third-party integrations for the site, with live data for the farm's own coordinates." noindex>
  <section class="section wrapper">
    <h1>Integration ideas — live evaluation, round 2</h1>
    <p class="hint">
      Two candidates, picked this time specifically because the data carries its own real, checkable
      "as of" — a dated satellite mosaic, a named monitoring station with its own last-updated
      timestamp — rather than a modeled estimate. Same farm coordinates as before
      ({LAT.toFixed(4)}, {LNG.toFixed(4)}). This page is for evaluation only: unlinked from nav,
      <code>noindex</code>, not part of the public site.
    </p>

    <div class="grid">
      <!-- 1. Satellite vegetation history -->
      <article class="card demo-card demo-card--wide">
        <h2>Satellite vegetation history</h2>
        <p class="why">Real, dated satellite imagery of the farm's own plot across years, with the actual property boundary overlaid — TVC is already mapped on OpenStreetMap (<a href="https://www.openstreetmap.org/way/1522934798" target="_blank" rel="noopener noreferrer">way/1522934798</a>, the same boundary the Design page's map already uses) — direct visual evidence of the regenerative-farming story, not a trivia stat. Could anchor an "our land over time" section.</p>
        <div class="sat-row">
          {SAT_YEARS.map((year) => (
            <div class="sat-figure">
              <div id={`sat-map-${year}`} class="sat-map" data-year={year}></div>
              <p class="sat-caption">{year} · Sentinel-2 cloudless mosaic (10m resolution) with the OSM-mapped property boundary</p>
            </div>
          ))}
        </div>
        <p class="source">Source: <a href="https://s2maps.eu" target="_blank" rel="noopener noreferrer">EOX Sentinel-2 cloudless</a> (imagery, no key required) + <a href="https://www.openstreetmap.org/way/1522934798" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> (boundary, already in this repo as <code>TVC_BOUNDARY</code>).</p>
      </article>

      <!-- 2. Real air-quality station -->
      <article class="card demo-card">
        <h2>Nearest real air-quality station</h2>
        <p class="why">The nearest actual monitoring station rather than a modeled estimate — its distance and its own last-updated time are shown so accuracy is checkable, not assumed.</p>
        <div id="card-waqi" class="body loading">Loading nearest station from WAQI…</div>
        <p class="source">Source: <a href="https://aqicn.org/api/" target="_blank" rel="noopener noreferrer">World Air Quality Index (WAQI) API</a> — free token required (obtained, not committed to source — see below).</p>
      </article>

      <!-- 3. Instagram embed -->
      <article class="card demo-card">
        <h2>Instagram embed</h2>
        <p class="why">The community's own real, current content — no accuracy question at all since it's TVC's actual post. Shown here is one specific reel; a real integration would need Buffer/Instagram API access to pick "latest" automatically rather than a hardcoded permalink.</p>
        <div class="ig-embed">
          <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DbEArzVTK1Z/" data-instgrm-version="14"></blockquote>
        </div>
        <p class="source">Source: <a href="https://developers.facebook.com/docs/instagram-platform/oembed" target="_blank" rel="noopener noreferrer">Instagram's official embed widget</a> — no API key for a single fixed post; picking the account's latest post automatically needs the Instagram Graph API (app review) or reading it via the already-connected Buffer channel.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<script is:inline src="//www.instagram.com/embed.js"></script>

<style>
  .hint {
    color: var(--tvc-ink-soft);
    max-width: 760px;
    margin: -8px 0 32px;
  }

  .hint code {
    background: var(--tvc-cream);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .demo-card--wide {
    grid-column: 1 / -1;
  }

  .demo-card h2 {
    margin: 0 0 6px;
    font-size: 1.15rem;
  }

  .why {
    color: var(--tvc-ink-soft);
    font-size: 0.85rem;
    margin: 0 0 16px;
  }

  .body {
    min-height: 60px;
    font-size: 0.92rem;
  }

  .body.loading,
  .body.error {
    color: var(--tvc-ink-soft);
    font-style: italic;
  }

  .body.error {
    color: #b3261e;
  }

  .source {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--tvc-line);
    font-size: 0.76rem;
    color: var(--tvc-ink-soft);
  }

  .source a {
    color: var(--tvc-green-dark);
  }

  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0 0 10px;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat .value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--tvc-green-dark);
    line-height: 1.1;
  }

  .stat .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tvc-ink-soft);
  }

  .sat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 16px;
  }

  .sat-figure {
    margin: 0;
    flex: 1 1 220px;
  }

  .sat-map {
    height: 340px;
    width: 100%;
    border-radius: calc(var(--radius) - 6px);
    background: var(--tvc-green-tint);
    z-index: 0;
  }

  .sat-caption {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    margin: 6px 0 0;
    text-align: center;
  }

  .ig-embed {
    display: flex;
    justify-content: center;
    min-height: 60px;
  }

  .ig-embed :global(iframe) {
    max-width: 100% !important;
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import L from 'leaflet';
  import { LAT, LNG } from '../../utils/weather';
  import { TVC_BOUNDARY } from '../../components/biodiversity/tvc-boundary';

  // Satellite vegetation history — EOX Sentinel-2 cloudless WMS base layer
  // per year, with the farm's actual OSM-mapped boundary (same TVC_BOUNDARY
  // the Design page's map already uses) drawn on top, same style.
  for (const yearEl of document.querySelectorAll<HTMLElement>('.sat-map')) {
    const year = yearEl.dataset.year!;
    const map = L.map(yearEl, { scrollWheelZoom: false });

    L.tileLayer.wms('https://tiles.maps.eox.at/wms', {
      layers: `s2cloudless-${year}`,
      format: 'image/jpeg',
      version: '1.1.1',
      attribution: 'Sentinel-2 cloudless &copy; EOX IT Services GmbH',
    }).addTo(map);

    const boundary = L.polygon(TVC_BOUNDARY, {
      color: '#f78520',
      weight: 2,
      fill: false,
    }).addTo(map);

    map.fitBounds(boundary.getBounds().pad(0.15));
  }

  function setBody(id: string, html: string) {
    const el = document.getElementById(id)!;
    el.classList.remove('loading', 'error');
    el.innerHTML = html;
  }

  function setError(id: string, message: string) {
    const el = document.getElementById(id)!;
    el.classList.remove('loading');
    el.classList.add('error');
    el.textContent = message;
  }

  // Great-circle distance between the farm and the reporting station, so a
  // reader can judge how locally representative the reading actually is.
  function distanceKm(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // Nearest real air-quality station — WAQI
  (async () => {
    try {
      const token = import.meta.env.PUBLIC_WAQI_TOKEN;
      if (!token) throw new Error('PUBLIC_WAQI_TOKEN is not set at build time — check it\'s scoped to the Builds context on Netlify (same as PUBLIC_GOOGLE_CLIENT_ID) and that this page has been rebuilt since it was added.');
      const res = await fetch(`https://api.waqi.info/feed/geo:${LAT};${LNG}/?token=${token}`);
      if (!res.ok) throw new Error(`WAQI HTTP ${res.status}`);
      const json = await res.json();
      if (json.status !== 'ok') throw new Error(`WAQI API error: ${json.data ?? 'unknown'}`);
      const d = json.data;
      const aqi = Math.round(d.aqi);
      const band = aqi <= 50 ? 'Good' : aqi <= 100 ? 'Moderate' : aqi <= 150 ? 'Unhealthy for sensitive groups' : aqi <= 200 ? 'Unhealthy' : aqi <= 300 ? 'Very unhealthy' : 'Hazardous';
      const [stationLat, stationLng] = d.city.geo;
      const km = distanceKm(LAT, LNG, stationLat, stationLng);
      setBody('card-waqi', `
        <div class="stat-row">
          <div class="stat"><span class="value">${aqi}</span><span class="label">AQI · ${band}</span></div>
          <div class="stat"><span class="value">${km.toFixed(1)} km</span><span class="label">From the farm</span></div>
        </div>
        <p class="hint" style="margin:0 0 4px; font-size:0.82rem;"><strong>${d.city.name}</strong></p>
        <p class="hint" style="margin:0; font-size:0.78rem;">Dominant pollutant: ${d.dominentpol ?? '—'} · Station last updated ${d.time?.s ?? '—'} (${d.time?.tz ?? ''})</p>
      `);
    } catch (err) {
      console.warn('WAQI demo fetch failed', err);
      setError('card-waqi', err instanceof Error ? err.message : "Couldn't load the nearest air-quality station right now.");
    }
  })();
</script>
