import StaffLayout from '../../../layouts/StaffLayout.astro';
import RulesGrid from '../../../components/spike/RulesGrid.tsx';
---

<StaffLayout title="Spike: rules grid" description="Spike." current="finance" currentPage="finance-rules">
  <section class="section wrapper">
    <h1>Rules (React island spike)</h1>
