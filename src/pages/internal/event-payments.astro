---
// Internal admin tool: per-event registrations/cancellations/money-collected
// for events using the direct-payment flow (razorpayReferenceId — see
// RAZORPAY.md's "Event payment tracking" section), plus the ability to
// trigger an actual Razorpay refund for a booking. See
// netlify/functions/event-payments-admin.mts for the API this talks to.
// Deliberately unlinked from nav; gated by Google Sign-In plus the same
// "core team" allow-list photo-pool.astro/whatsapp.astro/
// accommodation-calendar.astro use (PHOTO_POOL_ALLOWED_EMAILS_SHEET_ID) —
// see event-payments-admin.mts's header comment for why it's reused rather
// than a new Sheet.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Only events actually wired up for direct payment have anything to show
// here — an event using the inquiry-first BookingInquiry flow has no
// event_payments rows at all. English-only (kn/ta sibling entries share the
// same razorpayReferenceId and would just duplicate the dropdown).
const paidEvents = (await getCollection('events', (e) => !e.id.startsWith('kn/') && !e.id.startsWith('ta/') && Boolean(e.data.razorpayReferenceId)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({
    referenceId: e.data.razorpayReferenceId as string,
    title: e.data.title,
    // yyyy-mm-dd only — the /refund-policy tiers key off the event's own
    // start date, and a plain date (no time-of-day) is all that's on the
    // content file anyway.
    date: e.data.date.toISOString().slice(0, 10),
    draft: e.data.draft ?? false,
  }));
---

<BaseLayout title="Event Payments" description="Internal event payment tracking and refunds." noindex>
  <section class="section wrapper">
    <h1>Event Payments</h1>
    <p class="hint">Registrations, cancellations, and money collected per event — and where to issue a refund.</p>

    <div id="gate" class="gate card">
      <p class="gate-copy">Sign in with the Google account you manage event payments with.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="error" hidden></p>
    </div>

    <div id="forbidden" class="gate card" hidden>
      <p class="gate-copy">Signed in as <strong id="forbidden-email"></strong>, but this Google account isn't authorized to view event payments.</p>
      <p class="hint" style="margin: 4px 0 12px;">Ask an admin to add it to the allow-list.</p>
      <button type="button" id="use-different-account" class="button">Use a different account</button>
    </div>

    <div id="app" hidden>
      <label class="event-picker">
        Event
        <select id="event-select">
          <option value="">Choose an event…</option>
        </select>
      </label>

      <p id="status" class="hint" hidden></p>

      <div id="results" hidden>
        <p id="test-payments-notice" class="hint test-payments-notice" hidden>
          <label>
            <input type="checkbox" id="include-test-toggle" />
            <span id="test-payments-notice-text"></span>
          </label>
        </p>
        <div class="stats">
          <div class="stat card">
            <span class="stat-label">Registrations</span>
            <span class="stat-value" id="stat-bookings"></span>
            <span class="stat-sub" id="stat-attendees"></span>
          </div>
          <div class="stat card">
            <span class="stat-label">Cancelled</span>
            <span class="stat-value" id="stat-cancelled"></span>
            <span class="stat-sub" id="stat-pending"></span>
          </div>
          <div class="stat card">
            <span class="stat-label">Gross collected</span>
            <span class="stat-value" id="stat-gross"></span>
          </div>
          <div class="stat card">
            <span class="stat-label">Net collected</span>
            <span class="stat-value" id="stat-net"></span>
            <span class="stat-sub" id="stat-refunded"></span>
            <span class="stat-sub" id="stat-fees"></span>
          </div>
        </div>

        <div id="bulk-cancel-section" class="bulk-cancel" hidden>
          <button type="button" id="bulk-cancel-open" class="button button--danger-outline button--small">Cancel event</button>
          <div id="bulk-cancel-panel" class="bulk-cancel-panel card" hidden>
            <p class="bulk-cancel-warning">⚠️ This refunds every eligible booking for this event and cannot be undone. Only use this for a full-event cancellation (e.g. weather, low turnout) — not to fix a single booking.</p>
            <p id="bulk-cancel-summary" class="bulk-cancel-summary"></p>
            <label class="bulk-cancel-field">
              Refund percentage
              <input type="number" id="bulk-cancel-percent" min="1" max="100" step="1" value="100" />
            </label>
            <label class="bulk-cancel-field">
              Reason <span class="refund-tier-hint">(kept for the audit trail)</span>
              <textarea id="bulk-cancel-reason" rows="2"></textarea>
            </label>
            <p class="error" id="bulk-cancel-error" hidden></p>
            <div id="bulk-cancel-review"></div>
            <div class="refund-actions">
              <button type="button" id="bulk-cancel-review-btn" class="button button--primary">Review</button>
              <button type="button" id="bulk-cancel-close-btn" class="button">Cancel</button>
            </div>
          </div>
        </div>

        <div class="table-scroll">
          <table class="bookings-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Amount</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="bookings-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>
<script type="application/json" id="events-data" set:html={JSON.stringify(paidEvents)} />

<style>
  .section.wrapper {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .hint {
    color: var(--tvc-ink-soft);
    margin: -8px 0 24px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .gate {
    max-width: 420px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .gate-copy {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 14px;
  }

  .error {
    color: var(--tvc-error-text);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .button {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .button--primary {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: #fff;
  }

  .button--danger {
    background: var(--tvc-error-text);
    border-color: var(--tvc-error-text);
    color: #fff;
  }

  .button--danger-outline {
    color: var(--tvc-error-text);
    border-color: var(--tvc-error-text);
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .button--small {
    padding: 5px 12px;
    font-size: 0.78rem;
  }

  /* A small, secondary trigger for a rare/destructive action shouldn't sit
     in its own full-width row — right-aligned and tightly spaced so it
     reads as "also available here", not as a second headline action next
     to the stats above it. */
  .bulk-cancel {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-bottom: 12px;
  }

  /* Same display-vs-[hidden] issue as .bulk-cancel-panel below — an explicit
     display:flex here beats the browser's default [hidden] { display: none }
     unless overridden explicitly. */
  .bulk-cancel[hidden] {
    display: none;
  }

  .bulk-cancel-panel {
    margin-top: 10px;
    padding: 16px 18px;
    max-width: 420px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
  }

  /* Explicit display:flex above beats the browser's own [hidden] { display:
     none } — author CSS always overrides the UA stylesheet regardless of
     source order or specificity — so without this the panel showed up
     immediately, `hidden` attribute or not. Higher specificity than the
     plain class rule above, so this wins whenever the attribute is present. */
  .bulk-cancel-panel[hidden] {
    display: none;
  }

  .bulk-cancel-warning {
    margin: 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f9e2df;
    color: #9c4438;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .bulk-cancel-summary {
    margin: 0;
    font-size: 0.86rem;
  }

  .bulk-cancel-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .bulk-cancel-field input,
  .bulk-cancel-field textarea {
    font: inherit;
    padding: 6px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
  }

  /* Plain (non-:global) versions of the refund form's shared bits — this
     panel lives in the static template, unlike the per-row refund form
     which is built via innerHTML inside #bookings-body and needs the
     :global() rules further down (see that block's own comment). */
  .refund-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* :global(), not plain — bulk-cancel-review's *contents* (.refund-tier-hint's
     "Refunded N of M" message, .refund-confirm, .bulk-cancel-breakdown) are
     all built via innerHTML at runtime, same as the per-row refund form
     inside #bookings-body further down. Astro's scoped CSS only tags
     elements present in this file's static template, so a plain selector
     here would silently never match — .refund-actions above stays plain
     because both its uses (Reason label, this form's own Review/Cancel
     buttons) are static; .refund-tier-hint's *static* use (the Reason
     label's hint text) is covered by the identical :global() rule too,
     since :global() still matches inside the un-scoped static markup. */
  /* Same story as .refund-tier-hint/.refund-confirm above: the confirm/
     danger/refresh buttons inside bulk-cancel-review's innerHTML need the
     :global() form of .button and its variants too — the plain rules above
     (used by this panel's *static* Review/Cancel buttons) never match them. */
  :global(#bulk-cancel-panel .button) {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
  }

  :global(#bulk-cancel-panel .button--danger) {
    background: var(--tvc-error-text);
    border-color: var(--tvc-error-text);
    color: #fff;
  }

  :global(#bulk-cancel-panel .button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(#bulk-cancel-panel .refund-tier-hint) {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    font-weight: 400;
  }

  :global(#bulk-cancel-panel .refund-confirm) {
    padding: 10px 12px;
    background: var(--tvc-orange-tint);
    border-radius: 8px;
    font-size: 0.86rem;
  }

  :global(#bulk-cancel-panel .refund-confirm p) {
    margin: 0 0 8px;
  }

  :global(#bulk-cancel-panel .bulk-cancel-breakdown) {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
    background: #fff;
  }

  :global(#bulk-cancel-panel .bulk-cancel-breakdown li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 10px;
    font-size: 0.84rem;
    border-bottom: 1px solid var(--tvc-line);
  }

  :global(#bulk-cancel-panel .bulk-cancel-breakdown li:last-child) {
    border-bottom: none;
  }

  .event-picker {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.86rem;
    font-weight: 600;
    max-width: 420px;
    margin-bottom: 20px;
  }

  .event-picker select {
    font: inherit;
    padding: 8px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
  }

  .test-payments-notice {
    margin: 0 0 16px;
  }

  .test-payments-notice label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  /* Missing :global() until now — same innerHTML-injection issue the block
     comment above #bookings-body td explains, this badge just hadn't been
     caught: astro:scoped CSS never tags dynamically-created elements, so
     this rule silently never matched and the "Test" pill rendered with only
     the base .badge shape, no orange fill. */
  :global(#bookings-body .badge--test) {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  :global(#bookings-body .badge--duplicate) {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }

  .stat {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tvc-ink-soft);
  }

  .stat-value {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .stat-sub {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .bookings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .bookings-table th {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--tvc-line);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tvc-ink-soft);
  }

  .bookings-table th:nth-child(2),
  .bookings-table th:last-child {
    text-align: right;
  }

  /* Everything below targets #bookings-body's contents, which renderBookings(),
     openBookingDetail(), and openRefundForm() build with innerHTML/createElement
     in the <script> below — Astro's scoped CSS only tags elements present in this file's
     static template, so a plain selector here would silently never match a
     row, badge, button, or refund form. :global() opts each one out of that
     scoping, and the #bookings-body id keeps the reach limited to this table
     instead of leaking onto the rest of the page. */
  :global(#bookings-body td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--tvc-line);
    vertical-align: middle;
    white-space: nowrap;
  }

  :global(#bookings-body td:nth-child(2)),
  :global(#bookings-body td:last-child) {
    text-align: right;
  }

  /* Each booking row is a click/keyboard-activated toggle for its own detail
     row (openBookingDetail() below) — the table only ever shows Name/Amount/
     Status by default, matching /refund-policy's other admin tools' pattern
     of a compact summary row that expands for detail + the actual action. */
  :global(#bookings-body .booking-row) {
    cursor: pointer;
  }

  :global(#bookings-body .booking-row:hover td),
  :global(#bookings-body .booking-row.is-open td) {
    background: var(--tvc-cream);
  }

  /* Plain-text chevron, not an icon font — matches accommodation-calendar.astro's
     .tent-summary/.tent-group-chevron convention (this page's admin-tool sibling). */
  :global(#bookings-body .row-chevron) {
    display: inline-block;
    color: var(--tvc-ink-soft);
    transition: transform 200ms ease;
  }

  :global(#bookings-body .booking-row.is-open .row-chevron) {
    transform: rotate(90deg);
  }

  :global(#bookings-body .cell-muted) {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  :global(#bookings-body .badge) {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  :global(#bookings-body .badge--paid) {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  :global(#bookings-body .badge--requested) {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  :global(#bookings-body .badge--refunded) {
    background: var(--tvc-line);
    color: var(--tvc-ink-soft);
  }

  :global(#bookings-body .badge--refund-initiated) {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  :global(#bookings-body .badge--refund-failed) {
    /* Same pale-red/dark-red pairing as global.css's .callout--red — that
       comment confirms #f9e2df needs the darker #9c4438 text, not
       --tvc-error-text/--tvc-orange-text, to actually pass WCAG AA. */
    background: #f9e2df;
    color: #9c4438;
  }

  :global(#bookings-body .button) {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
  }

  :global(#bookings-body .button--primary) {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: #fff;
  }

  :global(#bookings-body .button--danger) {
    background: var(--tvc-error-text);
    border-color: var(--tvc-error-text);
    color: #fff;
  }

  :global(#bookings-body .button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(#bookings-body .detail-row td) {
    background: var(--tvc-cream);
    text-align: left;
    white-space: normal;
    cursor: default;
    padding-top: 14px;
    padding-bottom: 16px;
  }

  :global(#bookings-body .detail-contact) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-bottom: 14px;
  }

  :global(#bookings-body .detail-field) {
    font-size: 0.86rem;
  }

  :global(#bookings-body .detail-label) {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tvc-ink-soft);
  }

  :global(#bookings-body .refund-form) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 420px;
  }

  :global(#bookings-body .refund-form label) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.84rem;
    font-weight: 600;
  }

  :global(#bookings-body .refund-form input),
  :global(#bookings-body .refund-form textarea) {
    font: inherit;
    padding: 6px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
  }

  :global(#bookings-body .refund-tier-hint) {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    font-weight: 400;
  }

  :global(#bookings-body .refund-actions) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(#bookings-body .refund-confirm) {
    padding: 10px 12px;
    background: var(--tvc-orange-tint);
    border-radius: 8px;
    font-size: 0.86rem;
  }

  :global(#bookings-body .refund-confirm p) {
    margin: 0 0 8px;
  }
</style>

<script>
  declare const google: any;

  interface EventOption {
    referenceId: string;
    title: string;
    date: string;
    draft: boolean;
  }

  interface Booking {
    id: string;
    razorpayPaymentId: string;
    payerName: string | null;
    payerEmail: string | null;
    payerContact: string | null;
    attendeeCount: number;
    amount: number;
    currency: string;
    createdAt: string;
    eventDate: string | null;
    cancellationRequestedAt: string | null;
    refundAmount: number | null;
    status: 'paid' | 'requested' | 'refund_initiated' | 'refund_failed' | 'refunded';
    isTest: boolean;
    isDuplicate: boolean;
    paymentMethod: string | null;
    feeAmount: number | null;
  }

  interface Aggregates {
    bookingCount: number;
    totalAttendees: number;
    grossCollected: number;
    totalRefunded: number;
    totalFees: number;
    netCollected: number;
    unreconciledFeeCount: number;
    cancelledCount: number;
    pendingRequestCount: number;
  }

  const STORAGE_KEY = 'tvc-event-payments-idtoken';
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const EVENTS: EventOption[] = JSON.parse(document.getElementById('events-data')!.textContent!);

  const gate = document.getElementById('gate') as HTMLElement;
  const gateError = document.getElementById('gate-error') as HTMLElement;
  const forbidden = document.getElementById('forbidden') as HTMLElement;
  const forbiddenEmail = document.getElementById('forbidden-email') as HTMLElement;
  const useDifferentAccountBtn = document.getElementById('use-different-account') as HTMLButtonElement;
  const app = document.getElementById('app') as HTMLElement;
  const eventSelect = document.getElementById('event-select') as HTMLSelectElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const results = document.getElementById('results') as HTMLElement;
  const bookingsBody = document.getElementById('bookings-body') as HTMLElement;
  const testPaymentsNotice = document.getElementById('test-payments-notice') as HTMLElement;
  const testPaymentsNoticeText = document.getElementById('test-payments-notice-text') as HTMLElement;
  const includeTestToggle = document.getElementById('include-test-toggle') as HTMLInputElement;
  const bulkCancelSection = document.getElementById('bulk-cancel-section') as HTMLElement;
  const bulkCancelOpenBtn = document.getElementById('bulk-cancel-open') as HTMLButtonElement;
  const bulkCancelPanel = document.getElementById('bulk-cancel-panel') as HTMLElement;
  const bulkCancelSummary = document.getElementById('bulk-cancel-summary') as HTMLElement;
  const bulkCancelPercent = document.getElementById('bulk-cancel-percent') as HTMLInputElement;
  const bulkCancelReason = document.getElementById('bulk-cancel-reason') as HTMLTextAreaElement;
  const bulkCancelError = document.getElementById('bulk-cancel-error') as HTMLElement;
  const bulkCancelReview = document.getElementById('bulk-cancel-review') as HTMLElement;
  const bulkCancelReviewBtn = document.getElementById('bulk-cancel-review-btn') as HTMLButtonElement;
  const bulkCancelCloseBtn = document.getElementById('bulk-cancel-close-btn') as HTMLButtonElement;

  let currentEvent: EventOption | null = null;
  let currentBookings: Booking[] = [];
  let openBookingId: string | null = null;

  function getToken(): string | null {
    return sessionStorage.getItem(STORAGE_KEY);
  }
  function clearToken() {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  function decodeTokenEmail(token: string): string {
    const payloadB64 = token.split('.')[1] ?? '';
    const base64 = payloadB64.replace(/-/g, '+').replace(/_/g, '/').padEnd(payloadB64.length + ((4 - (payloadB64.length % 4)) % 4), '=');
    try {
      return JSON.parse(atob(base64)).email ?? 'unknown';
    } catch {
      return 'unknown';
    }
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    app.hidden = true;
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden(token: string) {
    gate.hidden = true;
    app.hidden = true;
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(token);
  }

  function showApp() {
    gate.hidden = true;
    forbidden.hidden = true;
    app.hidden = false;
  }

  async function authedFetch(input: string, init: RequestInit = {}): Promise<Response> {
    const token = getToken();
    const res = await fetch(input, {
      ...init,
      headers: { ...init.headers, authorization: `Bearer ${token ?? ''}` },
    });
    if (res.status === 401) {
      clearToken();
      showGate('Your session expired — sign in again.');
      throw new Error('Unauthorized');
    }
    if (res.status === 403) {
      showForbidden(token!);
      throw new Error('Forbidden');
    }
    return res;
  }

  function populateEventSelect() {
    for (const ev of EVENTS) {
      const opt = document.createElement('option');
      opt.value = ev.referenceId;
      opt.textContent = `${ev.title} — ${ev.date}${ev.draft ? ' (draft)' : ''}`;
      eventSelect.appendChild(opt);
    }
  }

  function formatAmount(amountPaise: number, currency: string): string {
    const amount = amountPaise / 100;
    return currency === 'INR' ? `₹${amount.toLocaleString('en-IN')}` : `${amount.toLocaleString('en-IN')} ${currency}`;
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' });
  }

  // /refund-policy's day-before-event tiers (src/pages/refund-policy.astro):
  // 7+ days → 75%, 48h–7 days → 50%, <48h → 0%. Mirrored here only to
  // pre-fill a *suggested* amount — the admin can always override it, and
  // event-payments-admin.mts doesn't re-derive or enforce this tier itself.
  //
  // Both dates are inputs, not "now"/"the event's current date":
  // - referenceDateISO is when the guest actually asked to cancel
  //   (booking.cancellationRequestedAt), not whenever the admin happens to
  //   open this form — a delayed admin response must not shrink the guest's
  //   entitled tier.
  // - eventDateISO is the date the guest paid against
  //   (booking.eventDate), not the event content file's *current* date —
  //   an event rescheduled after payments came in (already happened once,
  //   Foraging Day) must not retroactively change what was already earned.
  function suggestedRefundFraction(eventDateISO: string, referenceDateISO: string): number {
    const eventDate = new Date(`${eventDateISO}T00:00:00+05:30`);
    const referenceDate = new Date(referenceDateISO);
    const hoursUntil = (eventDate.getTime() - referenceDate.getTime()) / (60 * 60 * 1000);
    if (hoursUntil >= 7 * 24) return 0.75;
    if (hoursUntil >= 48) return 0.5;
    return 0;
  }

  function tierLabel(fraction: number): string {
    if (fraction === 0.75) return '75% — 7+ days before the event';
    if (fraction === 0.5) return '50% — 48 hours to 7 days before the event';
    return '0% — less than 48 hours before the event';
  }

  function statusBadge(status: Booking['status']): string {
    if (status === 'refunded') return '<span class="badge badge--refunded">Refunded</span>';
    if (status === 'refund_failed') return '<span class="badge badge--refund-failed">Refund failed</span>';
    if (status === 'refund_initiated') return '<span class="badge badge--refund-initiated">Refund initiated</span>';
    if (status === 'requested') return '<span class="badge badge--requested">Cancellation requested</span>';
    return '<span class="badge badge--paid">Paid</span>';
  }

  function escapeHtml(s: unknown): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function closeBookingDetail() {
    if (!openBookingId) return;
    document.getElementById(`detail-row-${openBookingId}`)?.remove();
    const prevTrigger = document.getElementById(`booking-row-${openBookingId}`);
    prevTrigger?.classList.remove('is-open');
    prevTrigger?.setAttribute('aria-expanded', 'false');
    openBookingId = null;
  }

  // Shared by the initial detail-row render and by the refund form's own
  // Cancel button, so cancelling a refund attempt returns to the same
  // button/status text a fresh row-expand would have shown.
  function renderActionArea(container: HTMLElement, booking: Booking) {
    container.innerHTML = '';
    if (booking.status === 'refunded') {
      const span = document.createElement('span');
      span.className = 'cell-muted';
      span.textContent = `Refunded ${formatAmount(booking.refundAmount ?? 0, booking.currency)}`;
      container.appendChild(span);
    } else if (booking.status === 'refund_initiated') {
      // No button here — a second concurrent attempt would be rejected
      // server-side anyway (event-payments-admin.mts's in-progress check).
      // Razorpay's own refund.processed/refund.failed webhook is what
      // moves this row forward, not another click.
      const span = document.createElement('span');
      span.className = 'cell-muted';
      span.textContent = 'Awaiting Razorpay confirmation';
      container.appendChild(span);
    } else {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'button';
      btn.textContent = booking.status === 'refund_failed' ? 'Retry refund' : 'Cancel & refund';
      btn.addEventListener('click', () => openRefundForm(booking, container));
      container.appendChild(btn);
    }
  }

  function openBookingDetail(booking: Booking) {
    if (openBookingId === booking.id) {
      closeBookingDetail();
      return;
    }
    closeBookingDetail();
    openBookingId = booking.id;

    const triggerRow = document.getElementById(`booking-row-${booking.id}`)!;
    triggerRow.classList.add('is-open');
    triggerRow.setAttribute('aria-expanded', 'true');

    const tr = document.createElement('tr');
    tr.id = `detail-row-${booking.id}`;
    tr.className = 'detail-row';
    const td = document.createElement('td');
    td.colSpan = 4;
    td.innerHTML = `
      <div class="detail-contact">
        <div class="detail-field"><span class="detail-label">Email</span>${escapeHtml(booking.payerEmail ?? '—')}</div>
        <div class="detail-field"><span class="detail-label">Phone</span>${escapeHtml(booking.payerContact ?? '—')}</div>
        <div class="detail-field"><span class="detail-label">Attendees</span>${booking.attendeeCount}</div>
        <div class="detail-field"><span class="detail-label">Paid</span>${formatDate(booking.createdAt)}</div>
        <div class="detail-field"><span class="detail-label">Method</span>${escapeHtml(booking.paymentMethod ?? '—')}</div>
        <div class="detail-field"><span class="detail-label">Razorpay fee</span>${booking.feeAmount != null ? formatAmount(booking.feeAmount, booking.currency) : 'not yet reconciled'}</div>
      </div>
      <div class="detail-action" id="detail-action-${booking.id}"></div>
    `;
    tr.appendChild(td);
    triggerRow.after(tr);

    renderActionArea(td.querySelector(`#detail-action-${booking.id}`) as HTMLElement, booking);
  }

  function openRefundForm(booking: Booking, container: HTMLElement) {
    if (!currentEvent) return;

    // Fall back to the event's current content-file date for any booking
    // recorded before event_date existed (see event-payments-admin.mts).
    const eventDateISO = booking.eventDate ?? currentEvent.date;
    const referenceDateISO = booking.cancellationRequestedAt ?? new Date().toISOString();
    const fraction = suggestedRefundFraction(eventDateISO, referenceDateISO);
    const suggestedPaise = Math.round(booking.amount * fraction);
    const suggestedRupees = (suggestedPaise / 100).toFixed(2);
    const referenceDateNote = booking.cancellationRequestedAt
      ? `the cancellation request received ${formatDate(booking.cancellationRequestedAt)}`
      : `today’s date (no cancellation request on file for this booking)`;

    container.innerHTML = `
      <form class="refund-form" data-booking-id="${booking.id}">
        <label>
          Refund amount (₹)
          <input type="number" step="0.01" min="0" max="${(booking.amount / 100).toFixed(2)}" value="${suggestedRupees}" required class="refund-amount" />
          <span class="refund-tier-hint">Suggested per /refund-policy: ${tierLabel(fraction)}, based on ${referenceDateNote}. Full amount paid: ${formatAmount(booking.amount, booking.currency)}.</span>
        </label>
        <label>
          Reason <span class="refund-tier-hint">(optional, kept for the audit trail)</span>
          <textarea rows="2" class="refund-reason"></textarea>
        </label>
        <p class="error refund-error" hidden></p>
        <div id="refund-review-${booking.id}"></div>
        <div class="refund-actions">
          <button type="submit" class="button button--primary refund-review-btn">Review refund</button>
          <button type="button" class="button refund-cancel-btn">Cancel</button>
        </div>
      </form>
    `;

    const form = container.querySelector('.refund-form') as HTMLFormElement;
    const errorEl = container.querySelector('.refund-error') as HTMLElement;
    const reviewEl = container.querySelector(`#refund-review-${booking.id}`) as HTMLElement;
    const reviewBtn = container.querySelector('.refund-review-btn') as HTMLButtonElement;

    (container.querySelector('.refund-cancel-btn') as HTMLButtonElement).addEventListener('click', () => renderActionArea(container, booking));

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      errorEl.hidden = true;
      const amountInput = container.querySelector('.refund-amount') as HTMLInputElement;
      const rupees = Number(amountInput.value);
      if (!Number.isFinite(rupees) || rupees <= 0) {
        errorEl.textContent = 'Enter a valid refund amount.';
        errorEl.hidden = false;
        return;
      }
      const amountPaise = Math.round(rupees * 100);
      if (amountPaise > booking.amount) {
        errorEl.textContent = 'Refund amount cannot exceed the amount paid.';
        errorEl.hidden = false;
        return;
      }

      // Two-step: this button only ever reveals a confirm step — the actual
      // POST that moves money fires from the confirm button below, never
      // from a single click on the form itself.
      reviewEl.innerHTML = `
        <div class="refund-confirm">
          <p>Refund <strong>${formatAmount(amountPaise, booking.currency)}</strong> to <strong>${escapeHtml(booking.payerEmail ?? 'this payer')}</strong> for payment <code>${escapeHtml(booking.razorpayPaymentId)}</code>? This cannot be undone from here.</p>
          <button type="button" class="button button--danger refund-confirm-btn">Yes, refund ${formatAmount(amountPaise, booking.currency)}</button>
        </div>
      `;
      reviewBtn.hidden = true;

      reviewEl.querySelector('.refund-confirm-btn')!.addEventListener('click', async () => {
        const confirmBtn = reviewEl.querySelector('.refund-confirm-btn') as HTMLButtonElement;
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Issuing refund…';
        try {
          const res = await authedFetch('/api/event-payments-admin/refund', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              id: booking.id,
              amount: amountPaise,
              reason: (container.querySelector('.refund-reason') as HTMLTextAreaElement).value.trim() || undefined,
            }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? 'Refund failed');
          if (currentEvent) await loadBookings(currentEvent.referenceId);
        } catch (err) {
          const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
          if (!handled) {
            errorEl.textContent = err instanceof Error ? err.message : 'Refund failed';
            errorEl.hidden = false;
            reviewEl.innerHTML = '';
            reviewBtn.hidden = false;
          }
        }
      });
    });
  }

  function renderBookings(data: { bookings: Booking[]; aggregates: Aggregates; testPaymentCount: number }) {
    const { bookings, aggregates, testPaymentCount } = data;
    currentBookings = bookings;
    closeBulkCancelPanel();

    if (testPaymentCount > 0) {
      testPaymentsNotice.hidden = false;
      testPaymentsNoticeText.textContent = includeTestToggle.checked
        ? `Showing ${testPaymentCount} test payment${testPaymentCount === 1 ? '' : 's'} (Razorpay test-mode) alongside real ones.`
        : `${testPaymentCount} test payment${testPaymentCount === 1 ? '' : 's'} hidden (Razorpay test-mode — excluded from the stats below).`;
    } else {
      testPaymentsNotice.hidden = true;
    }

    document.getElementById('stat-bookings')!.textContent = String(aggregates.bookingCount);
    document.getElementById('stat-attendees')!.textContent = `${aggregates.totalAttendees} attendee${aggregates.totalAttendees === 1 ? '' : 's'}`;
    document.getElementById('stat-cancelled')!.textContent = String(aggregates.cancelledCount);
    document.getElementById('stat-pending')!.textContent = aggregates.pendingRequestCount > 0 ? `${aggregates.pendingRequestCount} pending request${aggregates.pendingRequestCount === 1 ? '' : 's'}` : '';
    const currency = bookings[0]?.currency ?? 'INR';
    document.getElementById('stat-gross')!.textContent = formatAmount(aggregates.grossCollected, currency);
    document.getElementById('stat-net')!.textContent = formatAmount(aggregates.netCollected, currency);
    document.getElementById('stat-refunded')!.textContent = aggregates.totalRefunded > 0 ? `${formatAmount(aggregates.totalRefunded, currency)} refunded` : '';
    const feesEl = document.getElementById('stat-fees')!;
    if (aggregates.totalFees > 0 || aggregates.unreconciledFeeCount > 0) {
      const feeText = aggregates.totalFees > 0 ? `${formatAmount(aggregates.totalFees, currency)} in Razorpay fees deducted` : '';
      const unreconciledText =
        aggregates.unreconciledFeeCount > 0
          ? `${feeText ? ' — ' : ''}${aggregates.unreconciledFeeCount} payment${aggregates.unreconciledFeeCount === 1 ? '' : 's'} not yet fee-reconciled (net may be slightly high)`
          : '';
      feesEl.textContent = `${feeText}${unreconciledText}`;
    } else {
      feesEl.textContent = '';
    }

    bookingsBody.innerHTML = '';
    openBookingId = null;
    for (const booking of bookings) {
      const tr = document.createElement('tr');
      tr.id = `booking-row-${booking.id}`;
      tr.className = 'booking-row';
      tr.tabIndex = 0;
      tr.setAttribute('role', 'button');
      tr.setAttribute('aria-expanded', 'false');
      tr.innerHTML = `
        <td>${escapeHtml(booking.payerName ?? '—')}</td>
        <td>${formatAmount(booking.amount, booking.currency)}</td>
        <td>${statusBadge(booking.status)}${booking.isTest ? ' <span class="badge badge--test">Test</span>' : ''}${booking.isDuplicate ? ' <span class="badge badge--duplicate" title="Another live booking from this email exists for this event">Possible duplicate</span>' : ''}</td>
        <td><span class="row-chevron">›</span></td>
      `;
      tr.addEventListener('click', () => openBookingDetail(booking));
      tr.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          openBookingDetail(booking);
        }
      });
      bookingsBody.appendChild(tr);
    }

    results.hidden = false;
  }

  async function loadBookings(referenceId: string) {
    closeBookingDetail();
    results.hidden = true;
    statusEl.hidden = false;
    statusEl.textContent = 'Loading…';
    try {
      const includeTestParam = includeTestToggle.checked ? '&includeTest=1' : '';
      const res = await authedFetch(`/api/event-payments-admin/bookings?eventReferenceId=${encodeURIComponent(referenceId)}${includeTestParam}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Failed to load');
      statusEl.hidden = true;
      renderBookings(data);
    } catch (err) {
      const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
      if (!handled) {
        statusEl.hidden = false;
        statusEl.textContent = 'Failed to load this event’s bookings — try again.';
      }
    }
  }

  // A booking is a candidate for the "cancel entire event" action under the
  // same rule handleBulkRefund applies server-side: not already refunded,
  // and not already mid-flight on a still-live refund attempt (a previously
  // *failed* one is fair game to retry).
  function eligibleForBulkRefund(bookings: Booking[]): Booking[] {
    return bookings.filter((b) => b.status === 'paid' || b.status === 'refund_failed');
  }

  function closeBulkCancelPanel() {
    bulkCancelPanel.hidden = true;
    bulkCancelError.hidden = true;
    bulkCancelReview.innerHTML = '';
    bulkCancelReviewBtn.hidden = false;
    bulkCancelPercent.value = '100';
    bulkCancelReason.value = '';
  }

  bulkCancelOpenBtn.addEventListener('click', () => {
    const eligible = eligibleForBulkRefund(currentBookings);
    const currency = currentBookings[0]?.currency ?? 'INR';
    const total = eligible.reduce((sum, b) => sum + b.amount, 0);
    bulkCancelSummary.textContent =
      eligible.length === 0
        ? 'No bookings for this event are eligible for a refund right now.'
        : `${eligible.length} booking${eligible.length === 1 ? '' : 's'} eligible, totaling ${formatAmount(total, currency)} at 100%.`;
    bulkCancelReviewBtn.disabled = eligible.length === 0;
    bulkCancelPanel.hidden = false;
  });

  bulkCancelCloseBtn.addEventListener('click', closeBulkCancelPanel);

  bulkCancelReviewBtn.addEventListener('click', () => {
    bulkCancelError.hidden = true;
    const percent = Number(bulkCancelPercent.value);
    if (!Number.isFinite(percent) || percent <= 0 || percent > 100) {
      bulkCancelError.textContent = 'Enter a refund percentage between 1 and 100.';
      bulkCancelError.hidden = false;
      return;
    }
    const eligible = eligibleForBulkRefund(currentBookings);
    const currency = currentBookings[0]?.currency ?? 'INR';
    const fraction = percent / 100;
    // The actual plan being approved: who gets how much, not just an
    // aggregate — an admin cancelling a whole event should see the per-
    // person breakdown before confirming, the same way a single-row refund
    // already shows the one payer/amount being sent.
    const breakdown = eligible.map((b) => ({ name: b.payerName ?? b.payerEmail ?? 'Unknown payer', amount: Math.round(b.amount * fraction) }));
    const total = breakdown.reduce((sum, row) => sum + row.amount, 0);

    bulkCancelReview.innerHTML = `
      <div class="refund-confirm">
        <p>Refund <strong>${eligible.length}</strong> booking${eligible.length === 1 ? '' : 's'} at <strong>${percent}%</strong> each:</p>
        <ul class="bulk-cancel-breakdown">
          ${breakdown.map((row) => `<li><span>${escapeHtml(row.name)}</span><span>${formatAmount(row.amount, currency)}</span></li>`).join('')}
        </ul>
        <p>Total <strong>${formatAmount(total, currency)}</strong>. This cannot be undone from here.</p>
        <button type="button" class="button button--danger bulk-cancel-confirm-btn">Yes, refund ${eligible.length} booking${eligible.length === 1 ? '' : 's'}</button>
      </div>
    `;
    bulkCancelReviewBtn.hidden = true;

    bulkCancelReview.querySelector('.bulk-cancel-confirm-btn')!.addEventListener('click', async () => {
      const confirmBtn = bulkCancelReview.querySelector('.bulk-cancel-confirm-btn') as HTMLButtonElement;
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Refunding…';
      try {
        if (!currentEvent) throw new Error('No event selected');
        const res = await authedFetch('/api/event-payments-admin/bulk-refund', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            eventReferenceId: currentEvent.referenceId,
            fraction,
            reason: bulkCancelReason.value.trim() || undefined,
            includeTest: includeTestToggle.checked,
          }),
        });
        const resData: { succeeded: number; attempted: number; results: Array<{ id: string; ok: boolean; error?: string }> } = await res.json();
        if (!res.ok) throw new Error((resData as unknown as { error?: string }).error ?? 'Bulk refund failed');

        const failures = resData.results.filter((r) => !r.ok);
        const summary = `Refunded ${resData.succeeded} of ${resData.attempted} eligible bookings.`;

        if (failures.length === 0) {
          // Left showing until the reload below replaces this panel's
          // contents entirely (renderBookings calls closeBulkCancelPanel).
          bulkCancelReview.innerHTML = `<p class="refund-tier-hint">${summary} Reloading…</p>`;
          if (currentEvent) await loadBookings(currentEvent.referenceId);
          return;
        }

        // Don't auto-reload here — renderBookings() would call
        // closeBulkCancelPanel() and wipe this list before the admin can
        // read *why* each one failed (e.g. Razorpay rejecting a refund for
        // insufficient account balance, hit for real 2026-09-25 — see
        // refundOneBooking()'s error message). The successful ones are
        // already refunded regardless; a manual refresh just catches the
        // table up once the admin has seen the failures.
        bulkCancelReview.innerHTML = `
          <p class="refund-tier-hint">${summary} ${failures.length} failed:</p>
          <ul class="bulk-cancel-breakdown">
            ${failures.map((f) => `<li><span>${escapeHtml(currentBookings.find((b) => b.id === f.id)?.payerName ?? f.id)}</span><span>${escapeHtml(f.error ?? 'Unknown error')}</span></li>`).join('')}
          </ul>
          <button type="button" class="button bulk-cancel-refresh-btn">Refresh table</button>
        `;
        bulkCancelReview.querySelector('.bulk-cancel-refresh-btn')!.addEventListener('click', () => {
          if (currentEvent) loadBookings(currentEvent.referenceId);
        });
      } catch (err) {
        const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
        if (!handled) {
          bulkCancelError.textContent = err instanceof Error ? err.message : 'Bulk refund failed';
          bulkCancelError.hidden = false;
          bulkCancelReview.innerHTML = '';
          bulkCancelReviewBtn.hidden = false;
        }
      }
    });
  });

  includeTestToggle.addEventListener('change', () => {
    if (currentEvent) loadBookings(currentEvent.referenceId);
  });

  // Bulk-cancelling an event that has already happened doesn't make sense —
  // hidden entirely rather than just disabled, matching "should not be
  // available" for a rare, destructive action. Available through the end of
  // the event's own day (Asia/Kolkata): a same-day weather cancellation is a
  // real use case, so this isn't gone until the day after. If a mass refund
  // is ever needed for a past event anyway, that's a job for the Razorpay
  // dashboard directly — razorpay-webhook.mts's refund.created/processed
  // handlers already sync a refund issued from there into event_payments
  // exactly like one issued from this page (see RAZORPAY.md), so nothing
  // about that fallback needs building here.
  function isEventConcluded(eventDateISO: string): boolean {
    const endOfEventDay = new Date(`${eventDateISO}T23:59:59+05:30`);
    return Date.now() > endOfEventDay.getTime();
  }

  eventSelect.addEventListener('change', () => {
    const referenceId = eventSelect.value;
    if (!referenceId) {
      results.hidden = true;
      statusEl.hidden = true;
      currentEvent = null;
      bulkCancelSection.hidden = true;
      return;
    }
    currentEvent = EVENTS.find((e) => e.referenceId === referenceId) ?? null;
    bulkCancelSection.hidden = !currentEvent || isEventConcluded(currentEvent.date);
    loadBookings(referenceId);
  });

  function handleCredentialResponse(response: { credential: string }) {
    sessionStorage.setItem(STORAGE_KEY, response.credential);
    showApp();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  useDifferentAccountBtn.addEventListener('click', () => {
    clearToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  populateEventSelect();

  if (getToken()) {
    showApp();
  } else {
    showGate();
  }
</script>
