---
// Internal reply dashboard for the WhatsApp Cloud API integration: shows
// conversations persisted by netlify/functions/whatsapp-webhook.mts and
// lets staff reply, via netlify/functions/whatsapp-admin.mts. Deliberately
// unlinked from nav; gated by Google Sign-In plus the same curator allow-list
// photo-pool.astro uses, not a shared password. See WHATSAPP.md.
import StaffLayout from '../../layouts/StaffLayout.astro';
import { WHATSAPP_QUICK_REPLIES } from '../../data/whatsapp-quick-replies';
---

<StaffLayout title="WhatsApp" description="Internal WhatsApp reply dashboard." current="whatsapp" collapseByDefault>
  <section class="section wrapper">
    <div class="page-head">
      <h1>WhatsApp</h1>
      <p class="page-head-sub">+91 80 4110 9754 · replies only send within 24h of the customer's last message</p>
    </div>

    <div id="gate" class="gate card">
      <p class="gate-copy">Sign in with the Google account you use for internal tools.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="error" hidden></p>
    </div>

    <div id="forbidden" class="gate card" hidden>
      <p class="gate-copy">Signed in as <strong id="forbidden-email"></strong>, but this Google account isn't authorized to use the WhatsApp inbox.</p>
      <p class="hint" style="margin: 4px 0 12px;">Ask an admin to add it to the staff list.</p>
      <button type="button" id="use-different-account" class="button">Use a different account</button>
    </div>

    <div id="app" class="app" hidden>
      <div class="conversations card">
        <div class="search-row">
          <input type="search" id="conversation-search" placeholder="Search name or message…" aria-label="Search conversations" />
        </div>
        <ul id="conversations-list"></ul>
        <p id="conversations-status" class="pane-status" hidden></p>
        <div id="conversations-skeleton" class="skeleton-list" aria-hidden="true">
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
        </div>
        <button type="button" id="load-more-conversations" class="button button--outline load-more-btn" hidden>Load more</button>
      </div>
      <div class="thread card">
        <p id="thread-empty" class="pane-status">Select a conversation.</p>
        <div id="thread-header" class="thread-header" hidden>
          <button type="button" id="back-to-list" class="button button--outline button--icon back-btn" aria-label="Back to conversations">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
          </button>
          <span id="thread-avatar" class="avatar avatar-lg" aria-hidden="true"></span>
          <div class="thread-header-text">
            <strong id="thread-name"></strong>
            <span id="thread-source" class="thread-source" hidden></span>
          </div>
          <div class="thread-actions">
            <button type="button" id="optout-btn" class="button button--outline">Stop WhatsApp updates</button>
            <button type="button" id="block-btn" class="button button--outline">Block</button>
          </div>
        </div>
        <div id="messages" class="messages" hidden></div>
        <div id="composer" class="composer" hidden>
          <div class="composer-signature">
            <label for="responder-name">Signing as</label>
            <input type="text" id="responder-name" placeholder="Your name" required />
          </div>
          <div class="quick-replies" role="group" aria-label="Canned replies">
            {WHATSAPP_QUICK_REPLIES.map((q) => <button type="button" class="chip tap-target quick-reply" data-text={q.text}>{q.label}</button>)}
          </div>
          <form id="reply-form" class="reply-form">
            <textarea id="reply-input" placeholder="Type a reply…" title="⌘/Ctrl + Enter to send" required></textarea>
            <button type="submit" id="reply-send" class="button">Send</button>
          </form>
          <p id="reply-status" class="reply-status" hidden></p>
        </div>
      </div>
    </div>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style>
  /* .app/.thread-header/.messages/.composer below all set `display` on a
     hidden-toggled element — a bare class selector ties `[hidden]`'s UA
     `display: none` in specificity, and author styles win ties over UA
     styles, so without this the element would render regardless of the
     `hidden` attribute (only occurs when the class rule sets `display`;
     harmless for the plain gate/forbidden panels above). */
  [hidden] {
    display: none !important;
  }

  /* This is a tool, not a landing page — the site's default 96px section
     padding is calibrated for marketing pages and just pushes the actual
     workspace down. Scoped to this page only (Astro scopes .section.wrapper
     here to this file), doesn't touch the shared class elsewhere. */
  .section.wrapper {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .page-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .page-head-sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .card {
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    /* The panes run edge to edge (header rule, message area, composer); the shared
       .card's 28px padding would float them inside the card. The gate panels set
       their own padding below. */
    padding: 0;
    overflow: hidden;
  }

  .gate {
    max-width: 400px;
    padding: 20px 24px;
  }

  .gate-copy {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 14px;
  }

  .error {
    color: var(--tvc-error-text);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .app {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    height: 75vh;
    min-height: 520px;
  }

  .conversations {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-row {
    flex: 0 0 auto;
    padding: 12px 16px;
    border-bottom: 1px solid var(--tvc-line);
  }

  .search-row input {
    width: 100%;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
    font-size: 0.9rem;
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  .conversations ul {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }

  .pane-status {
    margin: 0;
    padding: 32px 16px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  /* Loading skeleton, shown until the first conversations response lands —
     see the script's toggling of #conversations-skeleton. Content-shaped
     placeholders rather than a spinner, per this codebase's preference for
     skeleton states over mid-content spinners on task-oriented surfaces. */
  .skeleton-list {
    padding: 8px 16px;
  }

  .skeleton-row {
    height: 52px;
    border-radius: var(--radius-field);
    margin-bottom: 8px;
    background: linear-gradient(90deg, var(--tvc-line) 25%, var(--tvc-cream) 50%, var(--tvc-line) 75%);
    background-size: 200% 100%;
    animation: skeleton-pulse 1.6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .skeleton-row {
      animation: none;
      background: var(--tvc-line);
    }
  }

  @keyframes skeleton-pulse {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* These rules target elements created client-side by document.createElement
     (see the script below) rather than written in this file's template —
     Astro only stamps its scoping data-attribute onto elements present in
     the template at build time, so a bare (scoped) selector here would never
     match them. :global() opts these specific selectors out of scoping. */
  :global(.conversation-item) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    cursor: pointer;
    font: inherit;
    transition: background-color 150ms ease-out;
  }

  /* Hover and active read as genuinely different states, not the same tint
     with a coincidental overlap — active (persistent, this thread is open)
     is the more saturated green; hover (transient, just passing the mouse
     over it) is the neutral cream already used for hover elsewhere on the
     site. */
  :global(.conversation-item:hover) {
    background: var(--tvc-cream);
  }

  :global(.conversation-item.active) {
    background: var(--tvc-green-tint);
  }

  :global(.conversation-item:focus-visible) {
    outline: 2px solid var(--tvc-orange);
    outline-offset: -2px;
  }

  /* Initials-based, not a photo — Meta's Cloud API doesn't expose WhatsApp
     contact profile pictures (only name + phone come through the webhook),
     so this is the same fallback WhatsApp's own client shows for a contact
     with no photo, not a lesser stand-in for one we could have used.
     :global() here for the same reason as .bubble/.conversation-item above:
     the list and per-message avatars are document.createElement'd in the
     script, so a scoped rule would only ever match the one static instance
     (#thread-avatar in the header) and silently no-op on the rest — which
     is exactly what happened here: no background, no white text, no
     border-radius, just bare initials with none of this rule's styling. */
  :global(.avatar) {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--tvc-white);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  :global(.avatar-sm) {
    width: 36px;
    height: 36px;
    font-size: 0.76rem;
  }

  :global(.avatar-lg) {
    width: 40px;
    height: 40px;
    font-size: 0.9rem;
  }

  :global(.conversation-item .text) {
    flex: 1;
    min-width: 0;
  }

  :global(.conversation-item .name-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  :global(.conversation-item .name-group) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  :global(.conversation-item .name) {
    font-weight: 600;
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  :global(.conversation-item .meta) {
    flex: 0 0 auto;
    font-size: 0.72rem;
    color: var(--tvc-ink-soft);
  }

  :global(.conversation-item .preview) {
    display: block;
    margin-top: 2px;
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Unread is a shared, inbox-wide fact (see the migration comment on
     last_read_at) — a dot + bold text, not a per-user marker. Placed at the
     row's trailing edge, same corner WhatsApp's own client uses for its
     unread badge, rather than on the avatar (which already carries enough
     information as the contact's identity marker). */
  :global(.conversation-item .unread-dot) {
    flex: 0 0 auto;
    align-self: center;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tvc-orange-cta);
  }

  :global(.conversation-item.unread .preview) {
    color: var(--tvc-ink);
    font-weight: 500;
  }

  /* Shared .button .button--outline (see StaffLayout); only the layout is local. */
  .button.load-more-btn {
    display: flex;
    width: calc(100% - 32px);
    margin: 12px 16px;
  }

  .thread {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .thread-header {
    padding: 10px 16px;
    border-bottom: 1px solid var(--tvc-line);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .thread-header strong {
    font-size: 0.95rem;
  }

  .thread-header-text {
    flex: 1;
    min-width: 0;
  }

  .thread-source {
    display: block;
    font-size: 0.8125rem;
    color: var(--tvc-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thread-actions {
    flex: 0 0 auto;
    display: flex;
    gap: 8px;
  }

  /* Page-local modifiers on the shared staff .button, same convention as the other
     staff pages (written .button.x because the shell's `main .button` would otherwise win):
     --icon for a square icon-only control, --danger-outline for a control whose
     current state is a restriction. */
  .button.button--icon {
    width: 36px;
    padding: 0;
  }

  .button.button--danger-outline,
  .button.button--danger-outline:hover {
    background: var(--tvc-error-bg);
    border-color: var(--tvc-error-text);
    color: var(--tvc-error-text);
  }

  @media (pointer: coarse) {
    .button.button--icon {
      width: 44px;
    }
  }

  .quick-replies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 16px 0;
  }

  /* Canned replies are suggestions, not actions, so they use the site's chip
     (the same pill as the biodiversity filters, see BiodiversityExplorer.astro's
     .chip) rather than the 8px staff button. .tap-target (global) widens the hit
     area without growing the pill. */
  .chip {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: var(--tvc-white);
    color: var(--tvc-ink-soft);
    padding: 5px 14px;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out;
  }

  .chip:hover {
    background: var(--tvc-green-tint);
    border-color: var(--tvc-green);
    color: var(--tvc-green-dark);
  }

  /* Brief confirmation after a click: the chip takes the same ink fill the
     biodiversity filters use for "selected", for a third of a second, because
     the text lands in a box that can be out of view on a phone. Declared after
     :hover so it wins while the pointer is still on the chip. */
  .chip.is-flash {
    background: var(--tvc-ink);
    border-color: var(--tvc-ink);
    color: var(--tvc-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }

  /* Shown in the conversation list next to a blocked contact's name — same
     idea as the unread dot, a small persistent marker rather than repeating
     the full "Blocked" word in every row. */
  :global(.conversation-item .blocked-tag) {
    flex: 0 0 auto;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--tvc-error-text);
    background: var(--tvc-error-bg);
    border-radius: 999px;
    padding: 1px 7px;
  }

  .button.back-btn {
    display: none;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--tvc-cream);
  }

  /* One row per message: avatar + bubble, mirrored for outbound so the
     avatar always sits on the "who sent this" side — the customer's on
     inbound, whichever staff member replied on outbound (keyed by the name
     they typed into "Signing as", same avatar system as the header/list). */
  :global(.message-row) {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    max-width: 78%;
  }

  :global(.message-row.inbound) {
    align-self: flex-start;
  }

  :global(.message-row.outbound) {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  :global(.avatar-xs) {
    width: 22px;
    height: 22px;
    font-size: 0.6rem;
  }

  :global(.bubble) {
    padding: 8px 12px;
    border-radius: var(--radius);
    font-size: 0.88rem;
    line-height: 1.4;
    white-space: pre-wrap;
    word-break: break-word;
    min-width: 0;
  }

  :global(.bubble.inbound) {
    background: var(--tvc-white);
    border-bottom-left-radius: 4px;
  }

  :global(.bubble.outbound) {
    background: var(--tvc-green-tint);
    border-bottom-right-radius: 4px;
  }

  :global(.bubble.failed) {
    background: var(--tvc-error-bg);
    border: 1px solid var(--tvc-error-border);
  }

  /* Media inside a bubble. All of it is built in the script, so :global like
     the rest of the bubble. */
  :global(.msg-media) {
    margin-bottom: 6px;
  }

  :global(.msg-media img),
  :global(.msg-media video) {
    display: block;
    max-width: min(260px, 100%);
    max-height: 260px;
    border-radius: var(--radius-sm);
  }

  :global(.msg-media img) {
    cursor: zoom-in;
  }

  :global(.msg-media audio) {
    display: block;
    width: 240px;
    max-width: 100%;
  }

  :global(.msg-media .msg-media-note) {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  :global(.msg-media .msg-media-error) {
    font-size: 0.78rem;
    color: var(--tvc-error-text);
  }

  :global(.bubble .bubble-error) {
    display: block;
    margin-top: 4px;
    font-size: 0.76rem;
    color: var(--tvc-error-text);
  }

  :global(.bubble .bubble-meta) {
    display: block;
    margin-top: 4px;
    font-size: 0.7rem;
    color: var(--tvc-ink-soft);
  }

  .composer {
    border-top: 1px solid var(--tvc-line);
    background: var(--tvc-white);
  }

  .composer-signature {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px 0;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
  }

  .composer-signature input {
    flex: 0 1 200px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
    font-size: 0.9rem;
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  .reply-form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px 16px 14px;
  }

  .reply-form textarea {
    flex: 1;
    min-height: 44px;
    max-height: 120px;
    padding: 9px 12px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
    font-size: 0.9rem;
    background: var(--tvc-white);
    color: var(--tvc-ink);
    resize: vertical;
  }

  .reply-status {
    margin: 0 16px 10px;
    font-size: 0.8rem;
    color: var(--tvc-error-text);
  }

  /* Below a breakpoint, show one pane at a time (list, then thread) instead
     of squeezing a 300px sidebar next to the thread — the two-column grid
     doesn't leave enough room for either on a phone. #app.thread-open is
     toggled by the script when a conversation is selected / the back button
     is pressed; the class is harmless above the breakpoint since nothing
     outside this query reads it. */
  @media (max-width: 720px) {
    .wrapper {
      padding-left: 12px;
      padding-right: 12px;
    }

    .app {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      height: calc(100dvh - 140px); /* phone top bar (52px) + page padding and heading */
      min-height: 360px;
    }

    .thread {
      display: none;
    }

    #app.thread-open .conversations {
      display: none;
    }

    #app.thread-open .thread {
      display: flex;
    }

    .button.back-btn {
      display: inline-flex;
    }

    .thread-header {
      flex-wrap: wrap;
    }

    .thread-actions {
      flex: 1 0 100%;
    }

    .thread-actions .button {
      flex: 1;
    }

    :global(.message-row) {
      max-width: 88%;
    }
  }
</style>

<script>
  declare const google: any;

  // One Google sign-in for every internal tool in this tab: the same stored
  // sign-in as /internal, /internal/access and /internal/security (see
  // scripts/lib/staff-client.mjs), so signing in once opens them all. Each tool
  // still checks its own role on the server for every request.
  import { TOKEN_KEY as STORAGE_KEY } from '../../../scripts/lib/staff-client.mjs';
  // This inbox is signed into from one shared Google account used by several
  // staff, so the ID token's own name claim can't tell them apart — each
  // person types their own name once, remembered on that browser (localStorage,
  // not sessionStorage, so it survives across tabs/sessions on the same
  // device) rather than re-typed every reply.
  const RESPONDER_NAME_KEY = 'tvc-whatsapp-responder-name';
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const POLL_INTERVAL_MS = 15000;

  interface Conversation {
    id: string;
    // Display name (masked for read-only roles) or an opaque "Contact XXXX"
    // — the contact's phone number is never sent to the browser.
    label: string;
    lastMessageAt: string;
    unread: boolean;
    lastMessagePreview: string | null;
    lastMessageDirection: 'inbound' | 'outbound' | null;
    isBlocked: boolean;
    // On the STOP opt-out list: no WhatsApp template messages are sent to them.
    optedOut: boolean;
    // Click-to-WhatsApp attribution, when the chat began from an ad or post.
    referral: { type: string; headline: string | null; url: string | null } | null;
  }

  interface Message {
    id: string;
    direction: 'inbound' | 'outbound';
    body: string;
    status: 'received' | 'sent' | 'failed';
    errorMessage: string | null;
    createdAt: string;
    // A photo, voice note, video, document or sticker the guest sent. The file
    // itself is fetched on demand from /api/whatsapp-admin/media.
    media: { kind: 'image' | 'audio' | 'video' | 'document' | 'sticker'; mime: string; filename: string | null } | null;
  }

  const gate = document.getElementById('gate') as HTMLElement;
  const gateError = document.getElementById('gate-error') as HTMLElement;
  const forbidden = document.getElementById('forbidden') as HTMLElement;
  const forbiddenEmail = document.getElementById('forbidden-email') as HTMLElement;
  const useDifferentAccountBtn = document.getElementById('use-different-account') as HTMLButtonElement;
  const app = document.getElementById('app') as HTMLElement;
  const conversationsStatus = document.getElementById('conversations-status') as HTMLElement;
  const conversationsSkeleton = document.getElementById('conversations-skeleton') as HTMLElement;
  const conversationsList = document.getElementById('conversations-list') as HTMLElement;
  const conversationSearchInput = document.getElementById('conversation-search') as HTMLInputElement;
  const loadMoreBtn = document.getElementById('load-more-conversations') as HTMLButtonElement;
  const threadEmpty = document.getElementById('thread-empty') as HTMLElement;
  const threadHeader = document.getElementById('thread-header') as HTMLElement;
  const backToListBtn = document.getElementById('back-to-list') as HTMLButtonElement;
  const threadAvatar = document.getElementById('thread-avatar') as HTMLElement;
  const threadName = document.getElementById('thread-name') as HTMLElement;
  const threadSource = document.getElementById('thread-source') as HTMLElement;
  const blockBtn = document.getElementById('block-btn') as HTMLButtonElement;
  const optOutBtn = document.getElementById('optout-btn') as HTMLButtonElement;
  const messagesEl = document.getElementById('messages') as HTMLElement;
  const composer = document.getElementById('composer') as HTMLElement;
  const responderNameInput = document.getElementById('responder-name') as HTMLInputElement;
  const replyForm = document.getElementById('reply-form') as HTMLFormElement;
  const replyInput = document.getElementById('reply-input') as HTMLTextAreaElement;
  const replySend = document.getElementById('reply-send') as HTMLButtonElement;
  const replyStatus = document.getElementById('reply-status') as HTMLElement;

  let selectedConversationId: string | null = null;
  let selectedConversation: Conversation | null = null;
  let pollTimer: ReturnType<typeof setInterval> | null = null;
  // Re-requested with a growing limit rather than an offset — see
  // listConversations' comment in scripts/lib/supabase.mjs for why.
  let conversationsLimit = 100;
  let activeSearch = '';
  let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

  function getToken(): string | null {
    return sessionStorage.getItem(STORAGE_KEY);
  }

  function clearToken() {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  // Only decoded here for display — real verification happens server-side
  // in whatsapp-admin.mts against Google's own signing keys.
  function decodeTokenEmail(token: string): string {
    const payloadB64 = token.split('.')[1] ?? '';
    const base64 = payloadB64.replace(/-/g, '+').replace(/_/g, '/').padEnd(payloadB64.length + ((4 - (payloadB64.length % 4)) % 4), '=');
    try {
      return JSON.parse(atob(base64)).email ?? 'unknown';
    } catch {
      return 'unknown';
    }
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    app.hidden = true;
    stopPolling();
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden(token: string) {
    gate.hidden = true;
    app.hidden = true;
    stopPolling();
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(token);
  }

  async function authedFetch(input: string, init: RequestInit = {}): Promise<Response> {
    const token = getToken();
    const res = await fetch(input, {
      ...init,
      headers: { ...init.headers, authorization: `Bearer ${token ?? ''}` },
    });
    if (res.status === 401) {
      clearToken();
      showGate('Your session expired — sign in again.');
      throw new Error('Unauthorized');
    }
    if (res.status === 403) {
      showForbidden(token!);
      throw new Error('Forbidden');
    }
    return res;
  }

  // Full "8/20/2026, 8:32:38 PM" locale strings are too heavy to sit inside a
  // chat bubble or a conversation-list row — just the time for anything sent
  // today, otherwise a short date + time.
  function formatTimestamp(iso: string): string {
    const date = new Date(iso);
    const time = date.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    if (date.toDateString() === new Date().toDateString()) return time;
    return `${date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}, ${time}`;
  }

  // Outbound bodies are stored (and sent to the customer) as
  // "{text}\n\n- {name}" — see whatsapp-admin.mts's handleReply. Stripping
  // that back out here is purely cosmetic (both for the list preview and
  // the message bubble below), so the admin view can show the signature
  // separately/smaller; the actual WhatsApp message the customer received
  // is untouched.
  const SIGNATURE_PATTERN = /\n\n- (.+)$/;

  function stripSignature(body: string): { text: string; signature: string | null } {
    const match = body.match(SIGNATURE_PATTERN);
    return match ? { text: body.slice(0, match.index), signature: match[1] } : { text: body, signature: null };
  }

  // No real photo to show — Meta's Cloud API never sends one (see the CSS
  // comment on .avatar) — so this mirrors WhatsApp's own initials fallback:
  // first letter of up to the first two words, a color picked deterministically
  // from the conversation id so the same contact always gets the same color.
  // The raw --tvc-orange/--tvc-sky-blue tokens only hit 3.5-3.7:1 contrast
  // against the white initials text (fails WCAG AA's 4.5:1 for text this
  // small) — using this codebase's existing darker "-text" variants of the
  // same two colors (already defined in global.css for the same contrast
  // reason, just in a different context) instead, which clear 5.3:1+.
  const AVATAR_COLORS = [
    'var(--tvc-green)',
    'var(--tvc-orange-text)',
    'var(--tvc-earth-brown)',
    'var(--tvc-sky-blue-text)',
    'var(--tvc-green-dark)',
  ];

  function getInitials(label: string | null, fallback: string): string {
    const source = label?.trim();
    if (!source) return fallback.slice(0, 2).toUpperCase();
    const words = source.split(/\s+/).filter(Boolean);
    return words.length > 1 ? `${words[0][0]}${words[1][0]}`.toUpperCase() : source.slice(0, 2).toUpperCase();
  }

  function getAvatarColor(key: string): string {
    let hash = 0;
    for (let i = 0; i < key.length; i++) hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
    return AVATAR_COLORS[hash % AVATAR_COLORS.length];
  }

  function buildAvatarEl(initials: string, colorKey: string, size: 'xs' | 'sm' | 'lg'): HTMLElement {
    const avatar = document.createElement('span');
    avatar.className = `avatar avatar-${size}`;
    avatar.textContent = initials;
    avatar.style.background = getAvatarColor(colorKey);
    return avatar;
  }

  function buildAvatar(conv: Pick<Conversation, 'label' | 'id'>, size: 'xs' | 'sm' | 'lg'): HTMLElement {
    return buildAvatarEl(getInitials(conv.label, conv.id), conv.id, size);
  }

  function renderConversations(conversations: Conversation[]) {
    conversationsList.innerHTML = '';
    if (conversations.length === 0) {
      conversationsStatus.hidden = false;
      conversationsStatus.textContent = activeSearch ? `No matches for "${activeSearch}".` : 'No conversations yet.';
      return;
    }
    conversationsStatus.hidden = true;

    for (const conv of conversations) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'conversation-item';
      btn.dataset.conversationId = conv.id;
      if (conv.id === selectedConversationId) btn.classList.add('active');
      if (conv.unread) btn.classList.add('unread');

      const avatar = buildAvatar(conv, 'sm');

      const text = document.createElement('span');
      text.className = 'text';

      const nameRow = document.createElement('span');
      nameRow.className = 'name-row';

      // Grouped with the name (rather than appended straight to nameRow) so
      // nameRow's existing space-between still resolves against exactly two
      // items — name-group, timestamp — regardless of whether the blocked
      // tag is present.
      const nameGroup = document.createElement('span');
      nameGroup.className = 'name-group';

      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = conv.label;
      nameGroup.append(name);

      if (conv.isBlocked) {
        const blockedTag = document.createElement('span');
        blockedTag.className = 'blocked-tag';
        blockedTag.textContent = 'Blocked';
        nameGroup.append(blockedTag);
      }

      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = formatTimestamp(conv.lastMessageAt);

      nameRow.append(nameGroup, meta);

      const preview = document.createElement('span');
      preview.className = 'preview';
      if (conv.lastMessagePreview) {
        const { text: previewText } = stripSignature(conv.lastMessagePreview);
        preview.textContent = conv.lastMessageDirection === 'outbound' ? `You: ${previewText}` : previewText;
      }

      text.append(nameRow, preview);
      btn.append(avatar, text);

      if (conv.unread) {
        const dot = document.createElement('span');
        dot.className = 'unread-dot';
        btn.appendChild(dot);
      }

      btn.addEventListener('click', () => selectConversation(conv));
      li.appendChild(btn);
      conversationsList.appendChild(li);
    }
  }

  // The polling loop calls this every 15s. Rebuilding an unchanged thread would
  // reset a playing voice note and yank the scroll position, so skip it unless a
  // message was added or its status changed.
  let lastRenderKey = '';

  // Files are fetched through the admin function (it holds the WhatsApp token),
  // once each: the promise is cached by message id and the blob outlives
  // re-renders. Errors carry the server's plain-language reason (expired, too big).
  const mediaCache = new Map<string, Promise<string>>();
  function fetchMedia(messageId: string): Promise<string> {
    let p = mediaCache.get(messageId);
    if (!p) {
      p = (async () => {
        const res = await authedFetch(`/api/whatsapp-admin/media?messageId=${encodeURIComponent(messageId)}`);
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || 'Could not load this file.');
        }
        return URL.createObjectURL(await res.blob());
      })();
      mediaCache.set(messageId, p);
      p.catch(() => mediaCache.delete(messageId));
    }
    return p;
  }

  function mediaButton(label: string, onClick: () => void): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'button button--outline';
    btn.textContent = label;
    btn.addEventListener('click', onClick);
    return btn;
  }

  function mediaText(className: string, text: string): HTMLElement {
    const el = document.createElement('span');
    el.className = className;
    el.textContent = text;
    return el;
  }

  function downloadButton(m: Message): HTMLButtonElement {
    const name = m.media!.filename || 'file';
    const btn = mediaButton(`Download ${name}`, async () => {
      btn.disabled = true;
      try {
        const url = await fetchMedia(m.id);
        const a = document.createElement('a');
        a.href = url;
        a.download = name;
        a.click();
      } catch (err) {
        btn.replaceWith(mediaText('msg-media-error', (err as Error).message));
      } finally {
        btn.disabled = false;
      }
    });
    return btn;
  }

  // Photos and stickers load by themselves; audio, video and documents wait for
  // a click, so opening a busy thread doesn't download everything in it.
  function buildMediaSlot(m: Message): HTMLElement {
    const media = m.media!;
    const slot = document.createElement('div');
    slot.className = 'msg-media';

    const showError = (err: unknown) => slot.replaceChildren(mediaText('msg-media-error', err instanceof Error ? err.message : 'Could not load this file.'));

    if (media.kind === 'image' || media.kind === 'sticker') {
      slot.append(mediaText('msg-media-note', media.kind === 'sticker' ? 'Loading sticker…' : 'Loading photo…'));
      fetchMedia(m.id)
        .then((url) => {
          const img = document.createElement('img');
          img.src = url;
          img.alt = media.kind === 'sticker' ? 'Sticker from the guest' : 'Photo from the guest';
          img.addEventListener('click', () => window.open(url, '_blank', 'noopener'));
          slot.replaceChildren(img);
        })
        .catch(showError);
    } else if (media.kind === 'audio' || media.kind === 'video') {
      const label = media.kind === 'video' ? 'Load video' : 'Play voice note';
      slot.append(
        mediaButton(label, async () => {
          slot.replaceChildren(mediaText('msg-media-note', 'Loading…'));
          try {
            const url = await fetchMedia(m.id);
            const el = document.createElement(media.kind === 'video' ? 'video' : 'audio');
            // Safari can't play ogg/opus voice notes; offer the file instead of a dead player.
            if (!el.canPlayType(media.mime)) {
              slot.replaceChildren(mediaText('msg-media-note', "This browser can't play this format."), downloadButton(m));
              return;
            }
            el.controls = true;
            el.src = url;
            slot.replaceChildren(el);
          } catch (err) {
            showError(err);
          }
        }),
      );
    } else {
      slot.append(downloadButton(m));
    }
    return slot;
  }

  function renderMessages(messages: Message[]) {
    const renderKey = `${selectedConversationId}|${messages.map((m) => `${m.id}:${m.status}`).join(',')}`;
    if (renderKey === lastRenderKey) return;
    lastRenderKey = renderKey;
    messagesEl.innerHTML = '';
    for (const m of messages) {
      const { text: bodyText, signature } = m.direction === 'outbound' ? stripSignature(m.body) : { text: m.body, signature: null };

      const row = document.createElement('div');
      row.className = `message-row ${m.direction}`;

      // Inbound avatars match the customer's avatar everywhere else (list,
      // header) — keyed by their conversation id. Outbound avatars are keyed by
      // whichever staff name is in the signature, so different repliers
      // in the same thread get visibly different avatars, same as the
      // customer would see distinct people in a group chat.
      const avatar =
        m.direction === 'inbound' && selectedConversation
          ? buildAvatar(selectedConversation, 'xs')
          : signature
            ? buildAvatarEl(getInitials(signature, signature), signature, 'xs')
            : null;
      if (avatar) row.appendChild(avatar);

      const bubble = document.createElement('div');
      bubble.className = `bubble ${m.direction}`;
      if (m.status === 'failed') bubble.classList.add('failed');

      // A media message's stored text is a placeholder ("[Photo]", "[Voice note]")
      // plus any caption; the file shows above, so only the caption is text.
      let shownText = bodyText;
      if (m.media) {
        bubble.appendChild(buildMediaSlot(m));
        shownText = bodyText.replace(/^\[(Photo|Video|Voice note|Audio|Sticker|Document)\]\s*/, '');
        // A document's text is "name — caption"; the download button already shows the name.
        const name = m.media.filename;
        if (name && shownText.startsWith(name)) shownText = shownText.slice(name.length).replace(/^\s*—\s*/, '');
      }
      if (shownText) {
        const body = document.createElement('span');
        body.textContent = shownText;
        bubble.appendChild(body);
      }

      if (m.status === 'failed' && m.errorMessage) {
        const err = document.createElement('span');
        err.className = 'bubble-error';
        err.textContent = `Not delivered: ${m.errorMessage}`;
        bubble.appendChild(err);
      }

      const meta = document.createElement('span');
      meta.className = 'bubble-meta';
      meta.textContent = signature ? `${formatTimestamp(m.createdAt)} · ${signature}` : formatTimestamp(m.createdAt);
      bubble.appendChild(meta);

      row.appendChild(bubble);
      messagesEl.appendChild(row);
    }
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  // What this signed-in role may do; refreshed on every conversation poll.
  let capabilities = { reply: false, manage: false };

  async function loadConversations() {
    try {
      const params = new URLSearchParams({ limit: String(conversationsLimit) });
      if (activeSearch) params.set('search', activeSearch);
      const res = await authedFetch(`/api/whatsapp-admin/conversations?${params}`);
      conversationsSkeleton.hidden = true;
      if (!res.ok) {
        conversationsStatus.hidden = false;
        conversationsStatus.textContent = 'Failed to load conversations.';
        return;
      }
      const data = (await res.json()) as { conversations: Conversation[]; capabilities: { reply: boolean; manage: boolean } };
      capabilities = data.capabilities;
      renderConversations(data.conversations);
      // A full page back implies there may be more beyond it; a short page
      // means we've reached the end. Not exact (an exact-multiple total
      // shows one extra "Load more" click that returns nothing new), but
      // avoids a separate count query for a small internal tool. Search
      // results don't paginate at all — a query narrow enough to need
      // "load more" is a query worth narrowing instead.
      loadMoreBtn.hidden = !!activeSearch || data.conversations.length < conversationsLimit;
    } catch {
      // authedFetch already showed the gate/forbidden panel for 401/403.
      conversationsSkeleton.hidden = true;
    }
  }

  async function loadMessages() {
    if (!selectedConversationId) return;
    try {
      const res = await authedFetch(`/api/whatsapp-admin/messages?conversationId=${encodeURIComponent(selectedConversationId)}`);
      if (!res.ok) return;
      const data = (await res.json()) as { messages: Message[] };
      renderMessages(data.messages);
      markSeenIfNew(data.messages);
    } catch {
      // handled by authedFetch
    }
  }

  // Read receipts: when a staff member who can reply has the thread open and the
  // guest's latest message is one we haven't acknowledged in this browser yet,
  // tell WhatsApp it was read (blue ticks on the guest's phone). Fire-and-
  // forget — the server answers 200 even when Meta refuses (no inbound message,
  // outside the 24h window), and nothing here may ever interrupt reading.
  // Read-only roles never trigger it, though opening a thread still clears the
  // inbox's own unread dot for everyone.
  const seenInbound = new Map<string, string>();
  function markSeenIfNew(messages: Message[]) {
    if (!selectedConversationId || !capabilities.reply || document.visibilityState !== 'visible') return;
    const latestInbound = [...messages].reverse().find((m) => m.direction === 'inbound');
    if (!latestInbound || seenInbound.get(selectedConversationId) === latestInbound.id) return;
    seenInbound.set(selectedConversationId, latestInbound.id);
    authedFetch('/api/whatsapp-admin/seen', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ conversationId: selectedConversationId }),
    }).catch(() => {});
  }

  // "typing…" on the guest's phone while staff write a reply. WhatsApp shows it
  // for about 25 seconds, so re-send at most every 20 while they keep typing.
  let lastTypingSentAt = 0;
  replyInput.addEventListener('input', () => {
    if (!selectedConversationId || !capabilities.reply || !replyInput.value.trim()) return;
    if (Date.now() - lastTypingSentAt < 20000) return;
    lastTypingSentAt = Date.now();
    authedFetch('/api/whatsapp-admin/seen', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ conversationId: selectedConversationId, typing: true }),
    }).catch(() => {});
  });

  // Canned replies: drop the text into the reply box (after anything already
  // typed) for the staff member to edit and send themselves.
  composer.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.quick-reply');
    if (!chip) return;
    const text = chip.dataset.text ?? '';
    chip.classList.add('is-flash');
    setTimeout(() => chip.classList.remove('is-flash'), 350);
    replyInput.value = replyInput.value.trim() ? `${replyInput.value.trimEnd()}\n\n${text}` : text;
    replyInput.focus();
    replyInput.setSelectionRange(replyInput.value.length, replyInput.value.length);
  });

  function selectConversation(conv: Conversation) {
    selectedConversationId = conv.id;
    selectedConversation = conv;
    threadEmpty.hidden = true;
    threadHeader.hidden = false;
    messagesEl.hidden = false;
    // Read-only roles can read the thread but not reply or block; the
    // server enforces this too, this just stops the page offering it.
    composer.hidden = !capabilities.reply;
    blockBtn.hidden = !capabilities.manage;
    optOutBtn.hidden = !capabilities.manage;
    threadAvatar.textContent = getInitials(conv.label, conv.id);
    threadAvatar.style.background = getAvatarColor(conv.id);
    threadName.textContent = conv.label;
    threadSource.hidden = !conv.referral;
    threadSource.textContent = conv.referral
      ? `Came from a ${conv.referral.type === 'post' ? 'post' : 'WhatsApp ad'}${conv.referral.headline ? `: ${conv.referral.headline}` : ''}`
      : '';
    updateBlockBtn(conv.isBlocked);
    updateOptOutBtn(conv.optedOut);
    document.querySelectorAll('.conversation-item').forEach((el) => el.classList.remove('active'));
    // Optimistic — the real read-state update happens server-side as a side
    // effect of loadMessages() below (see handleMessages), which the next
    // loadConversations() poll would eventually reflect anyway, but clearing
    // it here immediately avoids a beat where a just-opened thread still
    // shows as unread.
    const listItem = conversationsList.querySelector<HTMLElement>(`[data-conversation-id="${conv.id}"]`);
    listItem?.classList.remove('unread');
    listItem?.querySelector('.unread-dot')?.remove();
    // Below the mobile breakpoint this swaps the visible pane from the
    // conversation list to the thread — see the .thread-open CSS rules.
    // No-op above the breakpoint, since nothing there reads this class.
    app.classList.add('thread-open');
    loadConversations();
    loadMessages();
  }

  function updateBlockBtn(isBlocked: boolean) {
    blockBtn.textContent = isBlocked ? 'Unblock' : 'Block';
    blockBtn.classList.toggle('button--danger-outline', isBlocked);
  }

  function updateOptOutBtn(optedOut: boolean) {
    optOutBtn.textContent = optedOut ? 'Updates stopped · Resume' : 'Stop WhatsApp updates';
    optOutBtn.classList.toggle('button--danger-outline', optedOut);
  }

  // Staff opt a number out of (or back into) the booking confirmations, reminders
  // and refund notices we send by WhatsApp — the same list a STOP reply writes
  // to. Nothing is sent to the guest. Resuming asks first: it is only right when
  // the guest themselves asked for the messages back.
  optOutBtn.addEventListener('click', async () => {
    if (!selectedConversationId || !selectedConversation) return;
    const nextOptedOut = !selectedConversation.optedOut;
    if (!nextOptedOut && !confirm(`Turn WhatsApp booking messages back on for ${selectedConversation.label}? Only do this if they asked for them.`)) return;
    if (nextOptedOut && !confirm(`Stop WhatsApp booking messages (confirmations, reminders, refund notices) to ${selectedConversation.label}? They will still get emails.`)) return;

    optOutBtn.disabled = true;
    try {
      const res = await authedFetch('/api/whatsapp-admin/opt-out', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ conversationId: selectedConversationId, optedOut: nextOptedOut }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        alert(data.error || 'Failed to update — try again.');
        return;
      }
      selectedConversation.optedOut = nextOptedOut;
      updateOptOutBtn(nextOptedOut);
      loadConversations();
    } catch {
      // handled by authedFetch
    } finally {
      optOutBtn.disabled = false;
    }
  });

  blockBtn.addEventListener('click', async () => {
    if (!selectedConversationId || !selectedConversation) return;
    const nextBlocked = !selectedConversation.isBlocked;
    // Blocking silences a real customer with no way to reach us short of a
    // new number — worth a confirm; unblocking is reversible, so it isn't.
    if (nextBlocked && !confirm(`Block ${selectedConversation.label}? They won't be able to message this number until unblocked.`)) {
      return;
    }

    blockBtn.disabled = true;
    try {
      const res = await authedFetch('/api/whatsapp-admin/block', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ conversationId: selectedConversationId, blocked: nextBlocked }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        alert(data.error || 'Failed to update block status — try again.');
        return;
      }
      selectedConversation.isBlocked = nextBlocked;
      updateBlockBtn(nextBlocked);
      loadConversations();
    } catch {
      // handled by authedFetch
    } finally {
      blockBtn.disabled = false;
    }
  });

  loadMoreBtn.addEventListener('click', () => {
    conversationsLimit += 100;
    loadConversations();
  });

  // Debounced so every keystroke doesn't round-trip — 300ms feels
  // instant to type against without firing a query per character.
  conversationSearchInput.addEventListener('input', () => {
    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
      activeSearch = conversationSearchInput.value.trim();
      conversationsLimit = 100;
      loadConversations();
    }, 300);
  });

  function pollIfVisible() {
    if (document.visibilityState !== 'visible') return;
    loadConversations();
    loadMessages();
  }

  function startPolling() {
    stopPolling();
    pollTimer = setInterval(pollIfVisible, POLL_INTERVAL_MS);
  }

  function stopPolling() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  responderNameInput.value = localStorage.getItem(RESPONDER_NAME_KEY) ?? '';
  responderNameInput.addEventListener('input', () => {
    localStorage.setItem(RESPONDER_NAME_KEY, responderNameInput.value.trim());
  });

  // Cmd/Ctrl+Enter submits — plain Enter stays a newline, since replies are
  // often more than one line and shouldn't send on every line break.
  replyInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      replyForm.requestSubmit();
    }
  });

  replyForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedConversationId) return;
    const body = replyInput.value.trim();
    const responderName = responderNameInput.value.trim();
    if (!body) return;
    if (!responderName) {
      responderNameInput.focus();
      return;
    }

    replySend.disabled = true;
    replySend.textContent = 'Sending…';
    replyStatus.hidden = true;
    try {
      const res = await authedFetch('/api/whatsapp-admin/reply', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ conversationId: selectedConversationId, body, responderName }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        replyStatus.hidden = false;
        replyStatus.textContent = data.error || 'Failed to send — try again.';
      } else {
        replyInput.value = '';
      }
      await loadMessages();
    } catch {
      // handled by authedFetch
    } finally {
      replySend.disabled = false;
      replySend.textContent = 'Send';
    }
  });

  function handleCredentialResponse(response: { credential: string }) {
    sessionStorage.setItem(STORAGE_KEY, response.credential);
    startApp();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  backToListBtn.addEventListener('click', () => {
    app.classList.remove('thread-open');
  });

  useDifferentAccountBtn.addEventListener('click', () => {
    clearToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  async function startApp() {
    gate.hidden = true;
    forbidden.hidden = true;
    app.hidden = false;
    await loadConversations();
    startPolling();
  }

  if (getToken()) {
    startApp();
  } else {
    showGate();
  }
</script>
