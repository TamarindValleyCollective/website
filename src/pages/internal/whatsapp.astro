---
// Internal reply dashboard for the WhatsApp Cloud API integration: shows
// conversations persisted by netlify/functions/whatsapp-webhook.mts and
// lets staff reply, via netlify/functions/whatsapp-admin.mts. Deliberately
// unlinked from nav; gated by Google Sign-In plus the same curator allow-list
// photo-pool.astro uses, not a shared password. See WHATSAPP.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="WhatsApp" description="Internal WhatsApp reply dashboard." noindex>
  <section class="section wrapper">
    <h1>WhatsApp</h1>
    <p class="hint">Reply to messages sent to +91 80 4110 9754. Free-form replies only work within 24 hours of the customer's last message — outside that window, WhatsApp will reject the send.</p>

    <div id="gate" class="gate card">
      <p class="gate-copy">Sign in with the Google account you use for internal tools.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="error" hidden></p>
    </div>

    <div id="forbidden" class="gate card" hidden>
      <p class="gate-copy">Signed in as <strong id="forbidden-email"></strong>, but this Google account isn't authorized to use the WhatsApp inbox.</p>
      <p class="hint" style="margin: 4px 0 12px;">Ask an admin to add it to the staff list.</p>
      <button type="button" id="use-different-account" class="button">Use a different account</button>
    </div>

    <div id="app" class="app" hidden>
      <div class="conversations card">
        <p id="conversations-status" class="hint" style="margin: 12px 16px;">Loading…</p>
        <ul id="conversations-list"></ul>
      </div>
      <div class="thread card">
        <p id="thread-empty" class="hint" style="margin: 16px;">Select a conversation.</p>
        <div id="thread-header" class="thread-header" hidden>
          <strong id="thread-name"></strong>
          <span id="thread-phone" class="hint"></span>
        </div>
        <div id="messages" class="messages" hidden></div>
        <form id="reply-form" class="reply-form" hidden>
          <textarea id="reply-input" placeholder="Type a reply…" required></textarea>
          <button type="submit" id="reply-send">Send</button>
        </form>
        <p id="reply-status" class="hint" style="margin: 4px 16px;" hidden></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style>
  /* .app/.thread-header/.messages/.reply-form below all set `display` on a
     hidden-toggled element — a bare class selector ties `[hidden]`'s UA
     `display: none` in specificity, and author styles win ties over UA
     styles, so without this the element would render regardless of the
     `hidden` attribute (only occurs when the class rule sets `display`;
     harmless for the plain gate/forbidden panels above). */
  [hidden] {
    display: none !important;
  }

  .hint {
    color: var(--tvc-ink-soft);
    margin: -8px 0 24px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .gate {
    max-width: 400px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .gate-copy {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 14px;
  }

  .error {
    color: #b3261e;
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .app {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 20px;
    height: 70vh;
    min-height: 480px;
  }

  .conversations {
    overflow-y: auto;
  }

  .conversations ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .conversation-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    cursor: pointer;
    font: inherit;
  }

  .conversation-item:hover,
  .conversation-item.active {
    background: var(--tvc-green-tint);
  }

  .conversation-item .name {
    font-weight: 600;
    font-size: 0.9rem;
    display: block;
  }

  .conversation-item .meta {
    font-size: 0.76rem;
    color: var(--tvc-ink-soft);
    display: block;
    margin-top: 2px;
  }

  .thread {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .thread-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--tvc-line);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bubble {
    max-width: 70%;
    padding: 8px 12px;
    border-radius: 12px;
    font-size: 0.88rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .bubble.inbound {
    align-self: flex-start;
    background: var(--tvc-cream);
  }

  .bubble.outbound {
    align-self: flex-end;
    background: var(--tvc-green-tint);
  }

  .bubble.failed {
    background: #fbebe9;
    border: 1px solid #e8b4af;
  }

  .bubble .bubble-error {
    display: block;
    margin-top: 4px;
    font-size: 0.76rem;
    color: #b3261e;
  }

  .bubble .bubble-time {
    display: block;
    margin-top: 4px;
    font-size: 0.7rem;
    color: var(--tvc-ink-soft);
  }

  .reply-form {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--tvc-line);
  }

  .reply-form textarea {
    flex: 1;
    min-height: 44px;
    max-height: 120px;
    padding: 8px 12px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    font-size: 0.88rem;
    resize: vertical;
  }

  .reply-form button {
    appearance: none;
    border: 1px solid var(--tvc-green);
    background: #fff;
    color: var(--tvc-green-dark);
    border-radius: 999px;
    padding: 0 20px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .reply-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>

<script>
  declare const google: any;

  const STORAGE_KEY = 'tvc-whatsapp-idtoken';
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const POLL_INTERVAL_MS = 15000;

  interface Conversation {
    id: string;
    waPhone: string;
    displayName: string | null;
    lastMessageAt: string;
  }

  interface Message {
    id: string;
    direction: 'inbound' | 'outbound';
    body: string;
    status: 'received' | 'sent' | 'failed';
    errorMessage: string | null;
    createdAt: string;
  }

  const gate = document.getElementById('gate') as HTMLElement;
  const gateError = document.getElementById('gate-error') as HTMLElement;
  const forbidden = document.getElementById('forbidden') as HTMLElement;
  const forbiddenEmail = document.getElementById('forbidden-email') as HTMLElement;
  const useDifferentAccountBtn = document.getElementById('use-different-account') as HTMLButtonElement;
  const app = document.getElementById('app') as HTMLElement;
  const conversationsStatus = document.getElementById('conversations-status') as HTMLElement;
  const conversationsList = document.getElementById('conversations-list') as HTMLElement;
  const threadEmpty = document.getElementById('thread-empty') as HTMLElement;
  const threadHeader = document.getElementById('thread-header') as HTMLElement;
  const threadName = document.getElementById('thread-name') as HTMLElement;
  const threadPhone = document.getElementById('thread-phone') as HTMLElement;
  const messagesEl = document.getElementById('messages') as HTMLElement;
  const replyForm = document.getElementById('reply-form') as HTMLFormElement;
  const replyInput = document.getElementById('reply-input') as HTMLTextAreaElement;
  const replySend = document.getElementById('reply-send') as HTMLButtonElement;
  const replyStatus = document.getElementById('reply-status') as HTMLElement;

  let selectedConversationId: string | null = null;
  let pollTimer: ReturnType<typeof setInterval> | null = null;

  function getToken(): string | null {
    return sessionStorage.getItem(STORAGE_KEY);
  }

  function clearToken() {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  // Only decoded here for display — real verification happens server-side
  // in whatsapp-admin.mts against Google's own signing keys.
  function decodeTokenEmail(token: string): string {
    const payloadB64 = token.split('.')[1] ?? '';
    const base64 = payloadB64.replace(/-/g, '+').replace(/_/g, '/').padEnd(payloadB64.length + ((4 - (payloadB64.length % 4)) % 4), '=');
    try {
      return JSON.parse(atob(base64)).email ?? 'unknown';
    } catch {
      return 'unknown';
    }
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    app.hidden = true;
    stopPolling();
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden(token: string) {
    gate.hidden = true;
    app.hidden = true;
    stopPolling();
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(token);
  }

  async function authedFetch(input: string, init: RequestInit = {}): Promise<Response> {
    const token = getToken();
    const res = await fetch(input, {
      ...init,
      headers: { ...init.headers, authorization: `Bearer ${token ?? ''}` },
    });
    if (res.status === 401) {
      clearToken();
      showGate('Your session expired — sign in again.');
      throw new Error('Unauthorized');
    }
    if (res.status === 403) {
      showForbidden(token!);
      throw new Error('Forbidden');
    }
    return res;
  }

  function formatRelativeTime(iso: string): string {
    return new Date(iso).toLocaleString();
  }

  function renderConversations(conversations: Conversation[]) {
    conversationsList.innerHTML = '';
    if (conversations.length === 0) {
      conversationsStatus.hidden = false;
      conversationsStatus.textContent = 'No conversations yet.';
      return;
    }
    conversationsStatus.hidden = true;

    for (const conv of conversations) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'conversation-item';
      if (conv.id === selectedConversationId) btn.classList.add('active');

      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = conv.displayName || `+${conv.waPhone}`;

      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = formatRelativeTime(conv.lastMessageAt);

      btn.append(name, meta);
      btn.addEventListener('click', () => selectConversation(conv));
      li.appendChild(btn);
      conversationsList.appendChild(li);
    }
  }

  function renderMessages(messages: Message[]) {
    messagesEl.innerHTML = '';
    for (const m of messages) {
      const bubble = document.createElement('div');
      bubble.className = `bubble ${m.direction}`;
      if (m.status === 'failed') bubble.classList.add('failed');

      const body = document.createElement('span');
      body.textContent = m.body;
      bubble.appendChild(body);

      if (m.status === 'failed' && m.errorMessage) {
        const err = document.createElement('span');
        err.className = 'bubble-error';
        err.textContent = `Not delivered: ${m.errorMessage}`;
        bubble.appendChild(err);
      }

      const time = document.createElement('span');
      time.className = 'bubble-time';
      time.textContent = formatRelativeTime(m.createdAt);
      bubble.appendChild(time);

      messagesEl.appendChild(bubble);
    }
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  async function loadConversations() {
    try {
      const res = await authedFetch('/api/whatsapp-admin/conversations');
      if (!res.ok) {
        conversationsStatus.hidden = false;
        conversationsStatus.textContent = 'Failed to load conversations.';
        return;
      }
      const data = (await res.json()) as { conversations: Conversation[] };
      renderConversations(data.conversations);
    } catch {
      // authedFetch already showed the gate/forbidden panel for 401/403.
    }
  }

  async function loadMessages() {
    if (!selectedConversationId) return;
    try {
      const res = await authedFetch(`/api/whatsapp-admin/messages?conversationId=${encodeURIComponent(selectedConversationId)}`);
      if (!res.ok) return;
      const data = (await res.json()) as { messages: Message[] };
      renderMessages(data.messages);
    } catch {
      // handled by authedFetch
    }
  }

  function selectConversation(conv: Conversation) {
    selectedConversationId = conv.id;
    threadEmpty.hidden = true;
    threadHeader.hidden = false;
    messagesEl.hidden = false;
    replyForm.hidden = false;
    threadName.textContent = conv.displayName || `+${conv.waPhone}`;
    threadPhone.textContent = `+${conv.waPhone}`;
    document.querySelectorAll('.conversation-item').forEach((el) => el.classList.remove('active'));
    loadConversations();
    loadMessages();
  }

  function pollIfVisible() {
    if (document.visibilityState !== 'visible') return;
    loadConversations();
    loadMessages();
  }

  function startPolling() {
    stopPolling();
    pollTimer = setInterval(pollIfVisible, POLL_INTERVAL_MS);
  }

  function stopPolling() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  replyForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedConversationId) return;
    const body = replyInput.value.trim();
    if (!body) return;

    replySend.disabled = true;
    replyStatus.hidden = true;
    try {
      const res = await authedFetch('/api/whatsapp-admin/reply', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ conversationId: selectedConversationId, body }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        replyStatus.hidden = false;
        replyStatus.textContent = data.error || 'Failed to send — try again.';
      } else {
        replyInput.value = '';
      }
      await loadMessages();
    } catch {
      // handled by authedFetch
    } finally {
      replySend.disabled = false;
    }
  });

  function handleCredentialResponse(response: { credential: string }) {
    sessionStorage.setItem(STORAGE_KEY, response.credential);
    startApp();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  useDifferentAccountBtn.addEventListener('click', () => {
    clearToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  async function startApp() {
    gate.hidden = true;
    forbidden.hidden = true;
    app.hidden = false;
    await loadConversations();
    startPolling();
  }

  if (getToken()) {
    startApp();
  } else {
    showGate();
  }
</script>
