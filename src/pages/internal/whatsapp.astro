---
// Internal reply dashboard for the WhatsApp Cloud API integration: shows
// conversations persisted by netlify/functions/whatsapp-webhook.mts and
// lets admins reply, via netlify/functions/whatsapp-admin.mts. Deliberately
// unlinked from nav; gated by Google Sign-In plus the shared admin access
// model, not a shared password. The inbox itself is the reusable
// WhatsAppInbox component. See WHATSAPP.md.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
import WhatsAppInbox from '../../components/whatsapp/WhatsAppInbox.astro';
---

<StaffLayout title="WhatsApp" description="Internal WhatsApp reply dashboard." current="whatsapp" collapseByDefault>
  <section class="section wrapper">
    <div class="page-head" data-tour="header">
      <h1>WhatsApp</h1>
      <p class="page-head-sub">+91 80 4110 9754 · replies only send within 24h of the customer's last message</p>
    </div>

    <SignInGate forbiddenWhat="WhatsApp" />

    <WhatsAppInbox scope="all" />
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style>
  /* This is a tool, not a landing page — the site's default 96px section
     padding is calibrated for marketing pages and just pushes the actual
     workspace down. Scoped to this page only (Astro scopes .section.wrapper
     here to this file), doesn't touch the shared class elsewhere. */

  .page-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .page-head-sub {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }
</style>

<script>
  declare const google: any;

  // One Google sign-in for every internal tool in this tab: the same stored
  // sign-in as /internal, /internal/access and /internal/security (see
  // scripts/lib/staff-client.mjs), so signing in once opens them all. Each tool
  // still checks its own role on the server for every request.
  import { TOKEN_KEY as STORAGE_KEY } from '../../../scripts/lib/staff-client.mjs';
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const gate = document.getElementById('gate') as HTMLElement;
  const gateError = document.getElementById('gate-error') as HTMLElement;
  const forbidden = document.getElementById('forbidden') as HTMLElement;
  const forbiddenEmail = document.getElementById('forbidden-email') as HTMLElement;
  const useDifferentAccountBtn = document.getElementById('use-different-account') as HTMLButtonElement;
  const inbox = document.querySelector('[data-wa-inbox]') as HTMLElement;
  const controls = () => (inbox as any).waInbox as { start(): Promise<void>; stop(): void };

  function getToken(): string | null {
    return sessionStorage.getItem(STORAGE_KEY);
  }

  function clearToken() {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  // Only decoded here for display — real verification happens server-side
  // in whatsapp-admin.mts against Google's own signing keys.
  function decodeTokenEmail(token: string): string {
    const payloadB64 = token.split('.')[1] ?? '';
    const base64 = payloadB64.replace(/-/g, '+').replace(/_/g, '/').padEnd(payloadB64.length + ((4 - (payloadB64.length % 4)) % 4), '=');
    try {
      return JSON.parse(atob(base64)).email ?? 'unknown';
    } catch {
      return 'unknown';
    }
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    inbox.hidden = true;
    controls().stop();
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden(token: string) {
    gate.hidden = true;
    inbox.hidden = true;
    controls().stop();
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(token);
  }

  function handleCredentialResponse(response: { credential: string }) {
    sessionStorage.setItem(STORAGE_KEY, response.credential);
    startApp();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }

  useDifferentAccountBtn.addEventListener('click', () => {
    clearToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  inbox.addEventListener('wa-inbox:unauthorized', () => {
    clearToken();
    showGate('Your session expired — sign in again.');
  });
  inbox.addEventListener('wa-inbox:forbidden', () => showForbidden(getToken() ?? ''));

  async function startApp() {
    gate.hidden = true;
    forbidden.hidden = true;
    inbox.hidden = false;
    await controls().start();
  }

  function init() {
    if (getToken()) startApp();
    else showGate();
  }
  // The inbox component sets itself up from its own script; wait for it if this one happens to run first.
  if ((inbox as any).waInbox) init();
  else inbox.addEventListener('wa-inbox:ready', init, { once: true });
</script>
