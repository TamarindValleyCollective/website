---
// Landing page for the internal tools (issue #89): sign in once with Google
// and see the tools you hold a role in, each with the role you hold there.
// Backed by netlify/functions/staff-me.mts, which answers only about the
// caller. The list is a convenience, not access control — every tool still
// checks the capability it needs on every request. Super admins also see the
// Access and Security pages.
//
// This page and /internal/access and /internal/security share one sign-in for
// the tab. The four older tools keep their own sign-in for now, so opening one
// asks you to sign in again the first time.
// Deliberately unlinked from the site nav and noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Internal tools" description="Your internal tools." noindex>
  <section class="section wrapper">
    <h1>Internal tools</h1>
    <p id="welcome" class="hint">Sign in to see the tools you can use.</p>

    <div id="gate" class="gate card">
      <p class="gate-copy">Sign in with your Google account.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="error" hidden></p>
    </div>

    <div id="forbidden" class="gate card" hidden>
      <p class="gate-copy">Signed in as <strong id="forbidden-email"></strong>, but this Google account isn't set up for the internal tools.</p>
      <p class="gate-copy">Ask a super admin to add you, then sign in again.</p>
      <button type="button" id="use-different-account" class="button button--outline">Use a different account</button>
    </div>

    <p id="status" class="hint" hidden></p>

    <div id="tools-section" hidden>
      <h2>Your tools</h2>
      <ul id="tools" class="tools"></ul>
      <p id="no-tools" class="note" hidden>You're signed in, but you don't have access to any tool yet. Ask a super admin.</p>
    </div>

    <div id="admin-section" hidden>
      <h2>Administration</h2>
      <ul id="admin-tools" class="tools"></ul>
    </div>

    <p id="signed-in" class="note" hidden>
      <button type="button" id="sign-out" class="link-button">Sign out</button>
    </p>
  </section>
</BaseLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style>
  .section.wrapper {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  [hidden] {
    display: none !important;
  }

  .hint {
    color: var(--tvc-ink-soft);
    margin: -8px 0 24px;
  }

  h2 {
    font-size: 1.1rem;
    margin: 28px 0 10px;
  }

  .card {
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .gate {
    max-width: 420px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .gate-copy {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 14px;
  }

  .note {
    font-size: 0.88rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 10px;
  }

  .error {
    color: var(--tvc-error-text);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
    max-width: 760px;
  }

  /* The cards are built by the script, so they need :global(). */
  .tools :global(a.tool) {
    display: block;
    height: 100%;
    padding: 16px 18px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    color: var(--tvc-ink);
    text-decoration: none;
  }

  .tools :global(a.tool:hover),
  .tools :global(a.tool:focus-visible) {
    border-color: var(--tvc-orange);
  }

  .tools :global(.tool-name) {
    display: block;
    font-weight: 600;
  }

  .tools :global(.tool-meta) {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
  }

  .link-button {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    color: var(--tvc-ink-soft);
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, staffFetch } from '../../../scripts/lib/staff-client.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  interface Tool {
    label: string;
    path: string;
    roleLabel?: string;
    description?: string;
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const welcome = $('welcome');
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const forbiddenEmail = $('forbidden-email');
  const statusEl = $('status');
  const toolsSection = $('tools-section');
  const toolsList = $('tools');
  const noTools = $('no-tools');
  const adminSection = $('admin-section');
  const adminList = $('admin-tools');
  const signedIn = $('signed-in');

  function card(tool: Tool, meta: string): HTMLElement {
    const link = document.createElement('a');
    link.className = 'tool';
    link.href = tool.path;
    const name = document.createElement('span');
    name.className = 'tool-name';
    name.textContent = tool.label;
    const detail = document.createElement('span');
    detail.className = 'tool-meta';
    detail.textContent = meta;
    link.append(name, detail);
    const item = document.createElement('li');
    item.append(link);
    return item;
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    toolsSection.hidden = true;
    adminSection.hidden = true;
    signedIn.hidden = true;
    statusEl.hidden = true;
    welcome.textContent = 'Sign in to see the tools you can use.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    toolsSection.hidden = true;
    adminSection.hidden = true;
    signedIn.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(getToken() ?? '');
  }

  async function load() {
    gate.hidden = true;
    statusEl.hidden = false;
    statusEl.textContent = 'Loading…';
    try {
      const { status, data } = await staffFetch('/api/staff-me');
      if (status !== 200) throw new Error('load failed');
      statusEl.hidden = true;
      welcome.textContent = data.name ? `Welcome, ${data.name}.` : 'Welcome.';
      toolsList.replaceChildren(...(data.tools as Tool[]).map((t) => card(t, `Your role: ${t.roleLabel}`)));
      const hasTools = data.tools.length > 0;
      const hasAdmin = data.adminTools.length > 0;
      toolsSection.hidden = !hasTools && hasAdmin; // a super admin with no tool roles sees just Administration
      noTools.hidden = hasTools || hasAdmin;
      adminList.replaceChildren(...(data.adminTools as Tool[]).map((t) => card(t, t.description ?? '')));
      adminSection.hidden = data.adminTools.length === 0;
      signedIn.hidden = false;
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired — sign in again.');
        else showForbidden();
      } else {
        statusEl.hidden = false;
        statusEl.textContent = 'Failed to load — try refreshing.';
      }
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);
  $('sign-out').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
