---
// Landing page for the internal tools (issue #89): sign in once with Google
// and see the tools you hold a role in, each with the role you hold there.
// Backed by netlify/functions/staff-me.mts, which answers only about the
// caller. The list is a convenience, not access control — every tool still
// checks the capability it needs on every request. Super admins also see the
// Access and Security pages.
//
// Every internal page shares one sign-in for the tab (scripts/lib/staff-client.mjs),
// including the four tools, so opening a tool from here doesn't ask again.
// Deliberately unlinked from the site nav and noindex.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
---

<StaffLayout title="Today" description="What needs you today, and your admin tools." current="home">
  <section class="section wrapper">
    <h1>Today</h1>
    <p id="welcome" class="hint">Sign in to see the tools you can use.</p>
    <div id="whats-new"></div>

    <SignInGate forbiddenWhat="the admin portal" />

    <p id="status" class="hint" hidden></p>

    <div id="attention" data-tour="attention" hidden>
      <p id="today-summary" class="summary" role="status"></p>
      <div id="today-needs" hidden>
        <h2>Needs attention</h2>
        <ul id="needs-list" class="list"></ul>
      </div>
      <div id="today-quiet" hidden>
        <h2>All clear</h2>
        <ul id="quiet-list" class="list"></ul>
      </div>
    </div>

    <div id="tools-section" data-tour="tools" hidden>
      <h2>Your tools</h2>
      <ul id="tools" class="list tools"></ul>
      <p id="no-tools" class="note" hidden>You're signed in, but you don't have access to any tool yet. Ask a super admin.</p>
    </div>

    <div id="admin-section" data-tour="admin-tools" hidden>
      <h2>Administration</h2>
      <ul id="admin-tools" class="list tools"></ul>
    </div>

  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style>



  h2 {
    margin: 26px 0 8px 14px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--tvc-ink-soft);
  }

  /* One line that says how things stand, then only what needs a person. */
  .summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 4px;
    font-weight: 500;
  }

  .summary .muted,
  .muted {
    color: var(--tvc-ink-soft);
    font-weight: 400;
  }

  .tools :global(.dot),
  .summary :global(.dot),
  #needs-list :global(.dot) {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  :global(.dot--warn) {
    background: var(--tvc-orange);
  }

  :global(.dot--crit) {
    background: var(--tvc-error-text);
  }

  #needs-list :global(.count) {
    flex: none;
    font-size: var(--text-md);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* The tools are one grouped list (shared .list and .row). The rows are built by the script, so what is
     specific to Home needs :global(): the icon badge on the left. */
  .tools :global(.tool-icon) {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .tools :global(.tool-icon--admin) {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

</style>

<script>
  import { STAFF_ICONS } from '../../lib/staff-icons';
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, staffFetch } from '../../../scripts/lib/staff-client.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  interface Tool {
    module?: string;
    label: string;
    path: string;
    roleLabel?: string;
    description?: string;
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const welcome = $('welcome');
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const forbiddenEmail = $('forbidden-email');
  const statusEl = $('status');
  const toolsSection = $('tools-section');
  const attention = $('attention');
  const toolsList = $('tools');
  const noTools = $('no-tools');
  const adminSection = $('admin-section');
  const adminList = $('admin-tools');

  // What each tool is for, shown on its tile. Admin tiles bring their own text.
  const DESCRIPTIONS: Record<string, string> = {
    'photo-pool': 'Review and describe photos sent in for the website',
    whatsapp: 'Read and reply to WhatsApp conversations',
    'event-payments': 'Bookings, totals and refunds for events',
    accommodation: 'Stay calendar, guests and bookings',
    members: 'Households, people and patta details of the member register',
    usage: 'Free-tier and credit usage, and warnings',
  };

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Icon markup comes from our own constants (src/lib/staff-icons.ts), never from the server.
  function icon(paths: string, size: number, className: string): SVGElement {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('width', String(size));
    svg.setAttribute('height', String(size));
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '1.8');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    svg.setAttribute('class', className);
    svg.innerHTML = paths;
    return svg;
  }

  function span(className: string, text?: string): HTMLSpanElement {
    const el = document.createElement('span');
    el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  }

  function card(tool: Tool, kind: 'tool' | 'admin'): HTMLElement {
    const key = tool.module ?? tool.label.toLowerCase();
    const link = document.createElement('a');
    link.className = 'row';
    link.href = tool.path;

    const badge = span(kind === 'admin' ? 'tool-icon tool-icon--admin' : 'tool-icon');
    badge.append(icon(STAFF_ICONS[key] ?? STAFF_ICONS.home, 20, 'tool-icon-svg'));

    const text = span('grow');
    text.append(span('title', tool.label), span('detail', tool.description ?? DESCRIPTIONS[key] ?? ''));

    link.append(badge, text);
    if (tool.roleLabel) link.append(span('pill pill--ok', tool.roleLabel));
    link.append(icon('<path d="m9 6 6 6-6 6"/>', 14, 'chev'));

    const item = document.createElement('li');
    item.append(link);
    return item;
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    toolsSection.hidden = true;
    attention.hidden = true;
    adminSection.hidden = true;
    statusEl.hidden = true;
    welcome.textContent = 'Sign in to see the tools you can use.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    toolsSection.hidden = true;
    attention.hidden = true;
    adminSection.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(getToken() ?? '');
  }

  // ---- Today: what is waiting on this person --------------------------------------------------------------
  interface TodayItem {
    id: string;
    tone: 'crit' | 'warn';
    title: string;
    detail: string;
    count: number;
    href: string;
  }

  function dot(tone: string): HTMLElement {
    const el = span(`dot dot--${tone}`);
    el.setAttribute('aria-hidden', 'true');
    return el;
  }

  function renderToday(data: { items: TodayItem[]; quiet: string[]; failed: string[] }) {
    const { items, quiet, failed } = data;
    const nothingChecked = items.length === 0 && quiet.length === 0 && failed.length === 0;
    attention.hidden = nothingChecked; // someone whose tools have no checks (the photo pool alone) just sees their tools
    if (nothingChecked) return;

    const summary = $('today-summary');
    if (items.length === 0 && failed.length === 0) {
      const ok = span('pill pill--ok', 'All clear');
      summary.replaceChildren(ok, span('', 'Nothing needs you right now.'));
    } else if (items.length === 0) {
      summary.replaceChildren(span('muted', `Couldn't check ${failed.join(', ')} just now. Try refreshing.`));
    } else {
      summary.replaceChildren(dot(items[0].tone), span('', items.length === 1 ? '1 thing needs you' : `${items.length} things need you`));
      if (failed.length) summary.append(span('muted', `Couldn't check ${failed.join(', ')}.`));
    }

    $('today-needs').hidden = items.length === 0;
    $('needs-list').replaceChildren(
      ...items.map((it) => {
        const link = document.createElement('a');
        link.className = 'row';
        link.href = it.href;
        const text = span('grow');
        text.append(span('title', it.title), span('detail', it.detail));
        link.append(dot(it.tone), text, span('count', String(it.count)), icon('<path d="m9 6 6 6-6 6"/>', 14, 'chev'));
        const li = document.createElement('li');
        li.append(link);
        return li;
      }),
    );

    $('today-quiet').hidden = quiet.length === 0;
    $('quiet-list').replaceChildren(
      ...quiet.map((text) => {
        const row = document.createElement('div');
        row.className = 'row';
        row.append(span('grow detail', text));
        const li = document.createElement('li');
        li.append(row);
        return li;
      }),
    );
  }

  // Runs beside the tool list and never blocks it: if the check fails the page says so rather than "all clear".
  async function loadToday() {
    try {
      const { status, data } = await staffFetch('/api/staff-today');
      if (status !== 200) throw new Error('today failed');
      renderToday(data);
      attention.hidden = attention.hidden; // renderToday decides
    } catch (err) {
      if (err instanceof StaffAuthError) return; // the tool list already handled the session
      attention.hidden = false;
      $('today-summary').replaceChildren(span('muted', "Couldn't check what needs you just now. Try refreshing."));
      $('today-needs').hidden = true;
      $('today-quiet').hidden = true;
    }
  }

  async function load() {
    gate.hidden = true;
    statusEl.hidden = false;
    statusEl.textContent = 'Loading…';
    try {
      const { status, data } = await staffFetch('/api/staff-me');
      if (status !== 200) throw new Error('load failed');
      statusEl.hidden = true;
      welcome.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' });
      toolsList.replaceChildren(...(data.tools as Tool[]).map((t) => card(t, 'tool')));
      const hasTools = data.tools.length > 0;
      const hasAdmin = data.adminTools.length > 0;
      toolsSection.hidden = !hasTools && hasAdmin; // a super admin with no tool roles sees just Administration
      noTools.hidden = hasTools || hasAdmin;
      adminList.replaceChildren(...(data.adminTools as Tool[]).map((t) => card(t, 'admin')));
      adminSection.hidden = data.adminTools.length === 0;
      void loadToday();
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired — sign in again.');
        else showForbidden();
      } else {
        statusEl.hidden = false;
        statusEl.textContent = 'Failed to load — try refreshing.';
      }
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
