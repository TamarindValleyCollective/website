---
// Member register (internal): step 1 of the member portal. A read-only review
// of the households, people and patta details imported from the workbook, with
// the data gaps an admin should fix before members are invited. Backed by
// netlify/functions/members-admin.mts; see docs/plans/member-portal.md.
//
// Same shell as the other internal tools: Google Sign-In gated, one sign-in per
// tab (scripts/lib/staff-client.mjs), unlinked, noindex. Everything the server
// returns is placed with textContent only, never as HTML. The server never
// sends an email or phone number, only whether one is on file; names are masked
// there for the read-only role.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
---

<StaffLayout title="Member register" description="Units, people and patta details." current="members">
  <section class="members section wrapper">
    <h1>Member register</h1>
    <p id="intro" class="hint">Sign in to review the member register.</p>

    <SignInGate forbiddenWhat="the Member register" />

    <p id="status" class="hint" hidden></p>

    <div id="content" hidden>
     <div id="overview">
      <section id="publish" class="publish card" aria-label="Publish to the website" hidden></section>
      <section id="autopublish" class="publish card" aria-label="Automatic publishing" hidden></section>
      <section id="unit-stories" class="stories" aria-label="Unit stories waiting for review" hidden></section>
      <section id="notices" class="stories" aria-label="Notices" hidden></section>
      <section id="family-requests" class="stories" aria-label="Family member requests waiting for a decision" hidden></section>
      <dl id="totals" class="totals" data-tour="totals"></dl>

      <div class="toolbar" data-tour="toolbar">
        <label>Search <input type="search" id="search" placeholder="Unit, house or name" autocomplete="off" /></label>
        <label>Show
          <select id="show">
            <option value="all">All units</option>
            <option value="validate">Needs validation</option>
            <option value="attention">Needs attention</option>
          </select>
        </label>
      </div>

      <p id="masked-note" class="note" hidden>Names are masked for the read-only role.</p>
      <p id="count" class="note" role="status"></p>
      <div id="list" data-tour="list"></div>

     </div>

      <div id="detail" class="detail-view" hidden>
        <div class="detail-head">
          <button type="button" id="detail-close" class="link-button">&larr; All units</button>
          <h2 id="detail-title"></h2>
        </div>
        <div id="detail-body" class="body"></div>
      </div>

      <p id="signed-in" class="note"><button type="button" id="sign-out" class="link-button">Sign out</button></p>
    </div>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .members [hidden] {
    display: none !important;
  }

  .members.section.wrapper {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .members .hint,
  .members .muted {
    color: var(--tvc-ink-soft);
  }

  .members .hint {
    margin: -8px 0 24px;
  }

  .members .card {
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .members .error {
    color: var(--tvc-error-text);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .members .note {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .members .link-button {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    color: var(--tvc-ink-soft);
    text-decoration: underline;
    cursor: pointer;
  }

  .members .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin: 0 0 24px;
  }

  .members .totals > div {
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
  }

  .members .totals dt {
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .members .totals dd {
    margin: 2px 0 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .members .totals dd.sub {
    margin-top: 4px;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  /* Collapsible land total: the summary line is the total, the table is the detail. */
  .members details.pivot > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .members details.pivot > summary::-webkit-details-marker {
    display: none;
  }

  .members details.pivot > summary::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--tvc-ink-soft);
    border-bottom: 2px solid var(--tvc-ink-soft);
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }

  .members details.pivot[open] > summary::before {
    transform: rotate(45deg);
  }

  .members .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: end;
    margin-bottom: 12px;
  }

  .members .toolbar label {
    display: grid;
    gap: 4px;
    font-size: 0.85rem;
  }

  .members .toolbar label.check {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .members .toolbar select {
    min-height: 40px;
    padding: 8px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    font: inherit;
  }

  .members .toolbar input[type='search'] {
    min-width: 240px;
    padding: 8px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-field);
    font: inherit;
  }

  .members .group {
    margin-bottom: 32px;
  }

  .members .group h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--tvc-line);
    font-size: 1.2rem;
  }

  .members .group h2 small {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  .members .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
  }

  /* One household: farm plot, house, and who lives there. A button, so the whole card is the target. */
  .members .hcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    min-height: 150px;
    padding: 16px 18px;
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: border-color 0.15s, transform 0.15s;
  }

  .members .hcard:hover {
    border-color: var(--tvc-orange);
    transform: translateY(-1px);
  }

  .members .hcard:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .members .hcard-ids {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .members .unit-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    white-space: nowrap;
  }

  .members .unit-pill--none {
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font-weight: 600;
  }

  .members .hcard-area {
    margin: -6px 0 0;
  }

  /* Visually hidden, still read by screen readers. */
  .members .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .members .hcard-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .members .faces {
    display: flex;
    flex: none;
  }

  .members .faces > * + * {
    margin-left: -12px;
  }

  .members .face {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--tvc-white);
    border-radius: 50%;
    box-sizing: border-box;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 700;
    object-fit: cover;
  }

  .members .hcard-people {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--tvc-green-dark);
    overflow: hidden;
  }

  .members .hcard-foot {
    display: grid;
    justify-items: start;
    gap: 6px;
    margin-top: auto;
    min-height: 1.4em;
  }

  .members .meta {
    color: var(--tvc-ink-soft);
    font-size: 0.85rem;
  }

  /* Household detail: a page of cards, one per topic, instead of a pop-up. */
  .members .detail-view {
    max-width: 960px;
  }

  .members .detail-head {
    margin-bottom: 14px;
  }

  .members .detail-head h2 {
    margin: 6px 0 0;
    font-size: 1.5rem;
  }

  .members .body {
    display: grid;
    gap: 14px;
  }

  .members .dcard {
    padding: 16px 20px 18px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
  }

  .members .dcard > h3 {
    margin: 0 0 10px;
  }

  .members .dcard .flags {
    margin-top: 10px;
  }

  .members .factsrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .members .factsrow p {
    margin: 0;
  }

  /* Small text-style buttons for the actions on a row. */
  .members .rowbtns {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .members .rowbtn {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 4px 0;
    color: var(--tvc-green-dark);
    text-decoration: none;
    cursor: pointer;
  }

  .members .rowbtn:hover,
  .members .rowbtn:focus-visible {
    text-decoration: underline;
  }

  /* The decision buttons on a land document record: real buttons, not text links. */
  .members .rowbtn--act {
    padding: 3px 12px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    text-decoration: none;
  }

  .members .rowbtn--act:hover {
    background: var(--tvc-stone);
    text-decoration: none;
  }

  .members .rowbtn--yes {
    border-color: var(--tvc-green-dark);
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .members .rowbtn--yes:hover {
    background: var(--tvc-green);
  }

  /* Land documents: the records waiting for a decision as rows grouped by how careful to be; a row
     opens into a card with what differs and buttons that name what they do. The uploaded files
     are listed small underneath. Built for a phone first: one column, 44px targets. */
  .members .landq-group {
    margin: 14px 2px 6px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .members .landq-row {
    margin-bottom: 8px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    overflow: hidden;
  }

  .members .landq-head {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 56px;
    padding: 10px 14px;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .members .landq-head:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: -2px;
  }

  .members .landq-sentence {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .members .landq-chev {
    color: var(--tvc-ink-soft);
  }

  .members .landq-tag {
    flex: none;
    padding: 2px 9px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .members .landq-tag--house {
    background: var(--tvc-stone);
    color: var(--tvc-earth-brown);
  }

  .members .landq-body {
    padding: 0 14px 14px;
    border-top: 1px solid var(--tvc-line);
  }

  .members .landq-diff {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 8px 0;
  }

  .members .landq-diff > div {
    padding: 6px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .members .landq-diff small {
    display: block;
    font-size: 0.72rem;
    color: var(--tvc-ink-soft);
  }

  .members .landq-new {
    border-color: var(--tvc-green);
    background: var(--tvc-green-tint);
  }

  .members .landq-note {
    margin: 6px 0;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .members .landq-link {
    min-height: 44px;
  }

  .members .landq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .members .landq-btn {
    flex: 1 1 12rem;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .members .landq-btn--main {
    border-color: var(--tvc-green-dark);
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .members .landq-btn--danger {
    border-color: var(--tvc-error-border);
    color: var(--tvc-error-text);
  }

  .members .landq-auto {
    margin: 10px 2px;
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
  }

  .members .landq-auto::before {
    content: '✓ ';
    color: var(--tvc-green-vivid);
    font-weight: 700;
  }

  .members .landq-files {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--tvc-line);
  }

  .members .landq-file {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    padding: 6px 0;
    font-size: 0.85rem;
  }

  .members .landq-file .landq-note {
    flex-basis: 100%;
    margin: 0;
  }

  .members .landq-filemeta {
    margin-right: auto;
    color: var(--tvc-ink-soft);
  }

  /* Verified / awaiting / not verified as an icon; the words stay for screen readers and on hover. */
  .members .vmark {
    display: inline-flex;
    vertical-align: middle;
  }

  .members .vmark svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .members .vmark--verified {
    color: var(--tvc-green);
  }

  .members .vmark--pending_review {
    color: var(--tvc-orange-text);
  }

  .members .vmark--unverified {
    color: var(--tvc-ink-soft);
  }

  .members .survey-cell {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .members .parcel-shape {
    display: block;
    width: auto;
    height: 28px;
    flex: none;
  }

  .members .merged-cell {
    vertical-align: top;
  }

  .members .doc-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .members .rowbtn--danger {
    color: var(--tvc-error-text);
  }

  .members .editform {
    margin: 10px 0 4px;
    padding: 14px 16px;
    background: var(--tvc-cream);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .members .editform h4 {
    margin: 0 0 10px;
    font-size: 0.95rem;
  }

  .members .editfields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px 14px;
  }

  .members .editfields label {
    display: grid;
    gap: 4px;
    font-size: 0.85rem;
  }

  .members .editfields label.check {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .members .editfields input:not([type='checkbox']),
  .members .editfields select {
    padding: 8px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    font: inherit;
  }

  .members .editfields small {
    color: var(--tvc-ink-soft);
  }

  .members .editactions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 12px;
  }

  .members .form-msg {
    min-height: 1.2em;
    margin: 8px 0 0;
    color: var(--tvc-error-text);
    font-size: 0.85rem;
  }

  .members .form-ok {
    margin: 0;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .members .body h3 {
    font-size: 0.85rem;
    margin: 0 0 6px;
    color: var(--tvc-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .members .table-wrap {
    overflow-x: auto;
  }

  .members table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .members th,
  .members td {
    text-align: left;
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--tvc-line);
    vertical-align: top;
  }

  .members th {
    font-weight: 600;
    color: var(--tvc-ink-soft);
    font-size: 0.78rem;
  }

  .members .flags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .members .flag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .members .flag--error {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .members .flag--warn {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .members .flag--info {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }
  .members .assess {
    margin: 0 0 10px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }

  .members .assess ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  .members .assess--low {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .members .assess--high {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .members .auto-list {
    margin: 0 0 8px;
    padding-left: 18px;
  }

  .members .auto-list li {
    margin: 4px 0;
  }

  .members .publish {
    margin: 0 0 18px;
    padding: 14px 16px;
  }

  .members .publish p {
    margin: 4px 0 8px;
  }

  .members .stories {
    margin: 0 0 22px;
  }

  .members .notice-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .members .notice-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }

  .members .story-queue > summary {
    cursor: pointer;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .members .story-list {
    display: grid;
    gap: 14px;
  }

  .members .story-card {
    padding: 14px 16px;
  }

  /* A unit story: what changed as chips, the unchanged parts folded away, buttons a thumb can hit. */
  .members .story-changes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }

  .members .story-photos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .members .story-unchanged {
    margin: 4px 0 12px;
  }

  .members .story-actions .rowbtns {
    gap: 8px;
  }

  .members .story-actions .rowbtn--act {
    min-height: 44px;
    padding: 0 16px;
  }

  .members .story-actions textarea {
    width: 100%;
    margin: 8px 0;
  }

  .members .story-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-bottom: 10px;
  }

  .members .story-fields {
    margin: 10px 0 12px;
  }

  .members .story-row {
    margin: 0 0 10px;
  }

  .members .story-row dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .members .story-row dd {
    margin: 2px 0 0;
  }

  .members .story-text {
    white-space: pre-wrap;
  }

  .members .story-links {
    margin: 0;
    padding-left: 18px;
    overflow-wrap: anywhere;
  }

  .members .story-photo {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--tvc-stone);
  }

  .members .story-was {
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
  }

  .members .story-reject {
    margin-top: 8px;
  }

  .members .story-reject[hidden] {
    display: none;
  }

  .members .story-reject textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 8px;
    padding: 8px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
  }
</style>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, staffFetch, staffPhotoSrc } from '../../../scripts/lib/staff-client.mjs';
  import { sizedPicture } from '../../../scripts/lib/member-google-picture.mjs';
  import { linksIn } from '../../../scripts/lib/member-markdown.mjs';
  import { shapeForRecord } from '../../../scripts/lib/member-land-docs.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  type Kid = Node | string | null | undefined | false;
  function h(tag: string, props: { class?: string; text?: string; attrs?: Record<string, string> } = {}, ...kids: Kid[]): HTMLElement {
    const el = document.createElement(tag);
    if (props.class) el.className = props.class;
    if (props.text !== undefined) el.textContent = props.text;
    for (const [k, v] of Object.entries(props.attrs ?? {})) el.setAttribute(k, v);
    for (const kid of kids) if (kid) el.append(kid);
    return el;
  }

  type Flag = { kind: string; severity: 'error' | 'warn' | 'info'; text: string };
  type Person = { id: string; name: string; role: string; canLogin: boolean; hasEmail: boolean; hasPhone: boolean; picture: string | null };
  type Plot = { id: string; pattaNo: string | null; referenceNo: string | null; surveyNo: string | null; areaHectares: number | null; areaAcres: number | null; settlement: string | null; verification: string; sourceDocumentId: string | null };
  type HousePatta = { id: string; pattaNo: string | null; referenceNo: string | null; surveyNo: string | null; areaSqFt: number | null; settlement: string | null; verification: string; sourceDocumentId: string | null };
  type Household = { id: string; farmUnit: string; houseNo: string | null; cluster: string | null; unitType: string | null; people: Person[]; plots: Plot[]; housePattas: HousePatta[]; flags: Flag[]; farmAcres: number; farmHectares: number; houseSqFt: number; plotsMissingArea: number; housePattasMissingArea: number };
  type Totals = { households: number; people: number; peopleWithEmail: number; farmPlots: number; householdsNeedingAttention: number; farmAcres: number; farmHectares: number; houseSqFt: number };

  const SEVERITY_WORD = { error: 'Fix', warn: 'Check', info: 'Note' } as const;
  const dash = (v: string | number | null) => (v == null || v === '' ? 'Not available yet' : String(v));
  // Land is shown as an Excel-style pivot: a total when collapsed, the rows when expanded.
  const acresFmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  // Hectares are always shown to four decimal places (0.1619, 0.0040).
  const haFmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
  const ha = (v: number | null) => (v == null ? null : haFmt.format(v));
  const sqftFmt = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 });
  const acres = (n: number) => `${acresFmt.format(n)} acres`;
  const sqft = (n: number) => `${sqftFmt.format(n)} sq ft`;
  const SQFT_PER_ACRE = 43560;
  const sqftAsAcres = (n: number) => n / SQFT_PER_ACRE;
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
  const sumOf = (list: Household[], pick: (hh: Household) => number) => list.reduce((n, hh) => n + pick(hh), 0);

  // Two different jobs: a land document is waiting for the core team to decide (validation), or the
  // register itself has a problem to fix (attention: a missing patta, a mismatched number, ...).
  const needsValidation = (hh: Household) => hh.flags.some((f) => f.kind === 'land_review');
  const needsAttention = (hh: Household) => hh.flags.some((f) => f.kind !== 'land_review' && f.severity !== 'info');

  const CLUSTERS: (string | null)[] = ['H1-A', 'H1-B', 'H2', null];

  let households: Household[] = [];

  function flagChip(f: Flag): HTMLElement {
    return h('span', { class: `flag flag--${f.severity}`, text: `${f.kind === 'land_review' ? 'Validate' : SEVERITY_WORD[f.severity]}: ${f.text}` });
  }

  function table(headers: string[], rows: (string | number | null | HTMLElement)[][]): HTMLElement {
    return h(
      'table',
      {},
      h('thead', {}, h('tr', {}, ...headers.map((t) => h('th', { text: t })))),
      h('tbody', {}, ...rows.map((r) => h('tr', {}, ...r.map((c) => (c instanceof HTMLElement ? h('td', {}, c) : h('td', { text: dash(c) })))))),
    );
  }

  // A plot number with its size pill underneath. The position says which plot it
  // is (farm plot on the left, house on the right), so there is no visible label;
  // screen readers still get one.
  // The first name for a tile: the first word that isn't just an initial, so
  // "A B Kumar" shows as "Kumar". (Masked names for the read-only role arrive
  // already masked, like "A•••• M••••", and are shortened the same way.)
  const firstName = (full: string): string => {
    const words = full.trim().split(/\s+/);
    return words.find((w) => [...w.replace(/[.\u2022]/g, '')].length > 1) ?? words[0] ?? '';
  };

  // A farm plot or house number as a pill. The label is read by screen readers only: the F-/H-
  // prefix already says which is which.
  const unitPill = (label: string, value: string | null, none: string): HTMLElement =>
    h('span', { class: `unit-pill${value ? '' : ' unit-pill--none'}` }, h('span', { class: 'sr', text: `${label}: ` }), value ?? none);

  // The card shows only what you scan for: farm plot, house, and who is on it.
  // A native <details>: the summary line is the total, the table is the detail.
  function pivot(summary: string, content: HTMLElement): HTMLElement {
    return h('details', { class: 'pivot' }, h('summary', { text: summary }), h('div', { class: 'table-wrap' }, content));
  }

  function renderHousehold(hh: Household): HTMLElement {
    const attention = hh.flags.filter((f) => f.severity !== 'info').length;
    // The owners (the primary members), "+ 1" if there are more than two. A card with two or more people names them
    // by first name ("Asha & Ravi"); a card with one person has room for the whole name ("Asha Rao"). The full names are
    // in the tooltip and the detail page. A household with no owner on record falls back to everyone in it.
    const owners = hh.people.filter((p) => p.role === 'owner');
    const named = owners.length ? owners : hh.people;
    const shown = named.slice(0, 2);
    const extra = named.length - shown.length;
    const firstOf = (name: string) => name.trim().split(/\s+/)[0] ?? name;
    const nameOf = (p: Person) => (named.length >= 2 ? firstOf(p.name) : p.name);
    const peopleLine = shown.length ? shown.map(nameOf).join(' & ') + (extra > 0 ? ` + ${extra}` : '') : 'No people yet';
    // The Google picture of each person shown, or their initial: small and overlapping, to the left of the names.
    const face = (p: Person) => {
      const initial = h('span', { class: 'face', text: firstOf(p.name).slice(0, 1).toUpperCase(), attrs: { 'aria-hidden': 'true' } });
      const src = sizedPicture(p.picture, 96);
      if (!src) return initial;
      const img = document.createElement('img');
      img.className = 'face';
      img.alt = '';
      img.loading = 'lazy';
      img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => img.replaceWith(initial));
      img.src = src;
      return img;
    };
    // "0.40 ac farm · 3,100 sq ft house": what the land pills used to carry, now a quiet line.
    const areaLine = [
      hh.plots.length ? (hh.farmAcres > 0 ? `${acres(hh.farmAcres).replace(' acres', ' ac')} farm` : 'farm: no area yet') : null,
      hh.housePattas.length ? (hh.houseSqFt > 0 ? `${sqft(hh.houseSqFt)} house` : 'house: no area yet') : null,
    ].filter(Boolean).join(' · ');
    const card = h(
      'button',
      { class: 'hcard', attrs: { type: 'button', 'aria-haspopup': 'dialog', 'aria-label': `Farm plot ${hh.farmUnit}, ${hh.houseNo ?? 'no house'}. Open details.` } },
      h('span', { class: 'hcard-top' },
        shown.length ? h('span', { class: 'faces' }, ...shown.map(face)) : null,
        h('span', { class: `hcard-people${shown.length ? '' : ' meta'}`, attrs: { title: named.map((p) => p.name).join(', ') }, text: peopleLine })),
      h(
        'span',
        { class: 'hcard-ids' },
        unitPill('Farm plot', hh.farmUnit, 'No farm plot'),
        unitPill('House', hh.houseNo, 'No house'),
      ),
      areaLine ? h('span', { class: 'hcard-area meta', text: areaLine }) : null,
      h('span', { class: 'hcard-foot' }, attention ? h('span', { class: 'flag flag--warn', text: `${attention} to check` }) : null),
    );
    card.addEventListener('click', () => openDetail(hh));
    return card;
  }

  const detail = $('detail');
  const overview = $('overview');
  let can = { edit: false, manage: false };
  let openId: string | null = null;

  // ---- editing -------------------------------------------------------------------
  // What the server enforces is in netlify/functions/members-admin.mts; the page
  // only offers what the signed-in role can do. Emails and phones are write-only:
  // a field can replace or clear one, but the current value is never shown.
  type Field = {
    name: string;
    label: string;
    type?: 'text' | 'number' | 'email' | 'tel' | 'select' | 'checkbox';
    value?: string;
    options?: { value: string; label: string }[];
    placeholder?: string;
    hint?: string;
  };

  const VERIFY: Record<string, string> = { verified: 'Verified', pending_review: 'Awaiting review', unverified: 'Not verified' };

  async function send(body: Record<string, unknown>): Promise<void> {
    try {
      const { status, data } = await staffFetch('/api/members-admin/edit', { method: 'POST', body });
      if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
    } catch (err) {
      if (err instanceof StaffAuthError) throw new Error(err.kind === 'unauthorized' ? 'Your session expired. Sign in again.' : "You don't have permission to do that.");
      throw err;
    }
  }

  // Reload the register after a change and show the same household again.
  async function refreshAfterEdit(message: string) {
    await loadData();
    const hh = households.find((x) => x.id === openId);
    if (hh) openDetail(hh, message);
    else closeDetail();
  }

  function formEl(title: string, fields: Field[], submitLabel: string, onSubmit: (values: Record<string, string>) => Promise<void>, onCancel: () => void, extra?: HTMLElement | null): HTMLFormElement {
    const msg = h('p', { class: 'form-msg', attrs: { role: 'alert' } });
    const inputs = new Map<string, HTMLInputElement | HTMLSelectElement>();
    const labels = fields.map((f) => {
      let control: HTMLInputElement | HTMLSelectElement;
      if (f.type === 'select') {
        const sel = document.createElement('select');
        for (const o of f.options ?? []) {
          const opt = document.createElement('option');
          opt.value = o.value;
          opt.textContent = o.label;
          sel.append(opt);
        }
        sel.value = f.value ?? '';
        control = sel;
      } else {
        const inp = document.createElement('input');
        inp.type = f.type ?? 'text';
        if (f.type === 'number') {
          inp.step = 'any';
          inp.min = '0';
          inp.inputMode = 'decimal';
        }
        if (f.type === 'checkbox') inp.checked = f.value === 'on';
        else inp.value = f.value ?? '';
        if (f.placeholder) inp.placeholder = f.placeholder;
        inp.autocomplete = 'off';
        control = inp;
      }
      control.name = f.name;
      inputs.set(f.name, control);
      const isCheck = f.type === 'checkbox';
      return h('label', { class: isCheck ? 'check' : '' }, isCheck ? control : null, h('span', { text: f.label }), isCheck ? null : control, f.hint ? h('small', { text: f.hint }) : null);
    });
    const save = h('button', { class: 'button', text: submitLabel, attrs: { type: 'submit' } }) as HTMLButtonElement;
    const cancel = h('button', { class: 'button button--outline', text: 'Cancel', attrs: { type: 'button' } });
    cancel.addEventListener('click', onCancel);
    const form = h('form', { class: 'editform', attrs: { novalidate: '' } }, h('h4', { text: title }), h('div', { class: 'editfields' }, ...labels), msg, h('div', { class: 'editactions' }, save, cancel, extra)) as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const values: Record<string, string> = {};
      for (const [name, control] of inputs) values[name] = control instanceof HTMLInputElement && control.type === 'checkbox' ? (control.checked ? 'on' : '') : control.value;
      msg.textContent = '';
      save.disabled = true;
      try {
        await onSubmit(values);
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        save.disabled = false;
      }
    });
    return form;
  }

  // A button that needs a second click, for removing things.
  function confirmButton(label: string, confirmLabel: string, action: () => Promise<void>, report: (m: string) => void): HTMLElement {
    const b = h('button', { class: 'rowbtn rowbtn--danger', text: label, attrs: { type: 'button' } });
    let armed = false;
    b.addEventListener('click', async () => {
      if (!armed) {
        armed = true;
        b.textContent = confirmLabel;
        setTimeout(() => {
          armed = false;
          b.textContent = label;
        }, 5000);
        return;
      }
      try {
        await action();
      } catch (err) {
        armed = false;
        b.textContent = label;
        report(err instanceof Error ? err.message : 'Something went wrong.');
      }
    });
    return b;
  }

  const VMARK: Record<string, string> = {
    verified: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/>',
    pending_review: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
    unverified: '<circle cx="12" cy="12" r="9" stroke-dasharray="3 3"/>',
  };
  function verifiedMark(v: string): HTMLElement {
    const key = VERIFY[v] ? v : 'unverified';
    const el = h('span', { class: `vmark vmark--${key}`, attrs: { title: VERIFY[key] } }, h('span', { class: 'sr', text: VERIFY[key] }));
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('aria-hidden', 'true');
    svg.innerHTML = VMARK[key]; // fixed constants only
    el.prepend(svg);
    return el;
  }
  // Opens an uploaded land document (a one-minute signed link, logged). The tab is opened in
  // the click so the browser doesn't block it as a pop-up. Needs the manage capability.
  async function openLandFile(documentId: string, onError: (m: string) => void) {
    const tab = window.open('', '_blank');
    try {
      const res = await staffFetch('/api/members-admin/land-document-link', { method: 'POST', body: { documentId } });
      if (res.status !== 200) throw new Error(res.data.error || 'Could not open the file.');
      if (tab) {
        tab.opener = null;
        tab.location.href = res.data.url;
      } else window.location.href = res.data.url;
    } catch (err) {
      tab?.close();
      onError(err instanceof Error ? err.message : 'Something went wrong.');
    }
  }
  // Rows are sorted by patta number, so records sharing a patta sit together: show the patta
  // number once, spanning its survey numbers, instead of repeating it on every row.
  function mergePattaRuns(root: HTMLElement): HTMLElement {
    const rows = [...root.querySelectorAll('tbody tr')];
    const key = (tr: Element) => {
      const t = tr.firstElementChild?.textContent?.trim() ?? '';
      return t === '—' || t === 'Not available yet' ? '' : t;
    };
    for (let i = 0; i < rows.length; ) {
      let j = i + 1;
      while (key(rows[i]) && j < rows.length && key(rows[j]) === key(rows[i])) j++;
      if (j - i > 1) {
        const first = rows[i].firstElementChild as HTMLTableCellElement;
        first.rowSpan = j - i;
        first.classList.add('merged-cell');
        for (let k = i + 1; k < j; k++) rows[k].firstElementChild?.remove();
      }
      i = j;
    }
    return root;
  }
  const byPatta = <T extends { pattaNo: string | null; surveyNo: string | null }>(a: T, b: T) =>
    (a.pattaNo == null ? 1 : 0) - (b.pattaNo == null ? 1 : 0) || String(a.pattaNo).localeCompare(String(b.pattaNo), undefined, { numeric: true }) || String(a.surveyNo).localeCompare(String(b.surveyNo), undefined, { numeric: true });

  // The parcel outlines of the open household's documents, one request per household opened.
  const shapesByHousehold = new Map<string, Promise<Record<string, string>>>();
  const loadShapes = (householdId: string) => {
    let p = shapesByHousehold.get(householdId);
    if (!p) {
      p = staffFetch(`/api/members-admin/land-shapes?householdId=${encodeURIComponent(householdId)}`).then(({ status, data }) => (status === 200 ? (data.shapes as Record<string, string>) : {})).catch((): Record<string, string> => ({}));
      shapesByHousehold.set(householdId, p);
    }
    return p;
  };
  // The survey number, linked to the document it was read from when there is one, with the parcel's
  // outline beside it: from that document, or from an FMB sketch uploaded for the survey number.
  function surveyLink(hh: Household, surveyNo: string | null, documentId: string | null): string | null | HTMLElement {
    if (!surveyNo) return surveyNo;
    const cell = h('div', { class: 'survey-cell' });
    if (documentId && can.manage) {
      const b = h('button', { class: 'doc-link', text: surveyNo, attrs: { type: 'button', title: 'Open the uploaded document' } });
      b.addEventListener('click', () =>
        void openLandFile(documentId, (m) => {
          cell.querySelector('.form-msg')?.remove();
          cell.append(h('p', { class: 'form-msg', text: m, attrs: { role: 'alert' } }));
        }),
      );
      cell.append(b);
    } else cell.append(document.createTextNode(surveyNo));
    void loadShapes(hh.id).then((shapes) => {
      const src = shapeForRecord(shapes, surveyNo, documentId);
      if (!src) return;
      const img = document.createElement('img');
      img.className = 'parcel-shape';
      img.src = src;
      img.alt = `Outline of survey number ${surveyNo}`;
      cell.append(img);
    });
    return cell;
  }

  const rowButton = (text: string, onClick: () => void): HTMLElement => {
    const b = h('button', { class: 'rowbtn', text, attrs: { type: 'button' } });
    b.addEventListener('click', onClick);
    return b;
  };

  const householdOptions = (exceptId?: string) =>
    households
      .filter((x) => x.id !== exceptId)
      .sort((a, b) => a.farmUnit.localeCompare(b.farmUnit))
      .map((x) => ({ value: x.id, label: `${x.farmUnit}${x.houseNo ? ` · ${x.houseNo}` : ''} — ${x.people.map((p) => firstName(p.name)).join(' & ') || 'no people yet'}` }));

  const ROLE_OPTIONS = [
    { value: 'owner', label: 'Owner' },
    { value: 'family', label: 'Family' },
    { value: 'non_owner', label: 'Not an owner' },
  ];

  function personForm(hh: Household, p: Person, slot: HTMLElement): HTMLFormElement {
    const fields: Field[] = [
      { name: 'fullName', label: 'Name', value: p.name },
      { name: 'email', label: 'Email', type: 'email', placeholder: p.hasEmail ? 'On file. Type a new address to replace it' : 'Not on file. Type an address to add one', hint: 'Emails are never shown, only replaced.' },
      ...(p.hasEmail ? [{ name: 'clearEmail', label: 'Remove the email on file', type: 'checkbox' } as Field] : []),
      { name: 'phone', label: 'Mobile number', type: 'tel', placeholder: p.hasPhone ? 'On file. Type a new number to replace it' : 'Not on file. Type a number to add one' },
      ...(p.hasPhone ? [{ name: 'clearPhone', label: 'Remove the number on file', type: 'checkbox' } as Field] : []),
      ...(can.manage ? [{ name: 'role', label: 'Role in this unit', type: 'select', options: ROLE_OPTIONS, value: p.role } as Field] : []),
    ];
    return formEl(
      `Edit ${firstName(p.name)}`,
      fields,
      'Save',
      async (v) => {
        const body: Record<string, unknown> = { action: 'person.update', personId: p.id };
        if (v.fullName.trim() && v.fullName.trim() !== p.name) body.fullName = v.fullName;
        if (v.email.trim()) body.email = v.email;
        else if (v.clearEmail) body.email = null;
        if (v.phone.trim()) body.phone = v.phone;
        else if (v.clearPhone) body.phone = null;
        const personChanged = Object.keys(body).length > 2;
        const roleChanged = can.manage && v.role !== p.role;
        if (!personChanged && !roleChanged) throw new Error('Nothing to change.');
        if (personChanged) await send(body);
        if (roleChanged) await send({ action: 'membership.update', householdId: hh.id, personId: p.id, role: v.role });
        await refreshAfterEdit('Saved.');
      },
      () => slot.replaceChildren(),
    );
  }

  function addPersonForm(hh: Household, slot: HTMLElement): HTMLFormElement {
    return formEl(
      'Add a person to this unit',
      [
        { name: 'fullName', label: 'Name' },
        { name: 'role', label: 'Role in this unit', type: 'select', options: ROLE_OPTIONS, value: 'owner' },
        { name: 'email', label: 'Email (optional)', type: 'email' },
        { name: 'phone', label: 'Mobile number (optional)', type: 'tel' },
      ],
      'Add person',
      async (v) => {
        const body: Record<string, unknown> = { action: 'person.add', householdId: hh.id, fullName: v.fullName, role: v.role };
        if (v.email.trim()) body.email = v.email;
        if (v.phone.trim()) body.phone = v.phone;
        await send(body);
        await refreshAfterEdit('Person added.');
      },
      () => slot.replaceChildren(),
    );
  }

  function moveForm(hh: Household, p: Person, slot: HTMLElement): HTMLFormElement {
    return formEl(
      `Move ${firstName(p.name)} to another unit`,
      [{ name: 'to', label: 'Move to', type: 'select', options: householdOptions(hh.id) }],
      'Move',
      async (v) => {
        await send({ action: 'membership.move', fromHouseholdId: hh.id, toHouseholdId: v.to, personId: p.id });
        await refreshAfterEdit('Moved.');
      },
      () => slot.replaceChildren(),
    );
  }

  function householdForm(hh: Household, slot: HTMLElement): HTMLFormElement {
    return formEl(
      'Edit house, cluster and unit type',
      [
        { name: 'houseNo', label: 'House number', value: hh.houseNo ?? '', placeholder: 'H-07', hint: 'Leave empty if no house has been allocated yet.' },
        { name: 'cluster', label: 'Cluster', type: 'select', value: hh.cluster ?? '', options: [{ value: '', label: 'No cluster yet' }, ...['H1-A', 'H1-B', 'H2'].map((c) => ({ value: c, label: c }))] },
        { name: 'unitType', label: 'Unit type', value: hh.unitType ?? '', placeholder: 'e.g. DF1-V2' },
      ],
      'Save',
      async (v) => {
        const body: Record<string, unknown> = { action: 'household.update', householdId: hh.id };
        if (v.houseNo.trim().toUpperCase() !== (hh.houseNo ?? '')) body.houseNo = v.houseNo.trim() === '' ? null : v.houseNo;
        if (v.cluster !== (hh.cluster ?? '')) body.cluster = v.cluster === '' ? null : v.cluster;
        if (v.unitType.trim() !== (hh.unitType ?? '')) body.unitType = v.unitType.trim() === '' ? null : v.unitType;
        if (Object.keys(body).length === 2) throw new Error('Nothing to change.');
        await send(body);
        await refreshAfterEdit('Saved.');
      },
      () => slot.replaceChildren(),
    );
  }

  // Farm patta and house patta records share one form; the fields differ.
  const LAND = {
    plot: {
      noun: 'farm patta record',
      create: 'plot.create',
      update: 'plot.update',
      remove: 'plot.delete',
      idKey: 'plotId',
      fields: [
        { name: 'pattaNo', label: 'Patta number' },
        { name: 'referenceNo', label: 'Reference number' },
        { name: 'surveyNo', label: 'Survey number' },
        { name: 'areaHectares', label: 'Hectares', type: 'number' },
        { name: 'areaAcres', label: 'Acres', type: 'number' },
        { name: 'settlement', label: 'Settlement' },
      ] as Field[],
    },
    housepatta: {
      noun: 'house patta record',
      create: 'housepatta.create',
      update: 'housepatta.update',
      remove: 'housepatta.delete',
      idKey: 'housePattaId',
      fields: [
        { name: 'pattaNo', label: 'Patta number' },
        { name: 'referenceNo', label: 'Reference number' },
        { name: 'surveyNo', label: 'Survey number' },
        { name: 'areaSqFt', label: 'Square feet', type: 'number' },
        { name: 'settlement', label: 'Settlement' },
      ] as Field[],
    },
  } as const;

  function landForm(kind: 'plot' | 'housepatta', hh: Household, rec: (Plot | HousePatta) | null, slot: HTMLElement): HTMLFormElement {
    const cfg = LAND[kind];
    const current = (rec ?? {}) as Record<string, string | number | null>;
    const fields: Field[] = cfg.fields.map((f) => ({ ...f, value: current[f.name] == null ? '' : String(current[f.name]) }));
    if (rec) fields.push({ name: 'householdId', label: 'Belongs to unit', type: 'select', value: hh.id, options: householdOptions(), hint: 'Change this to move the record to another unit.' });
    const report = (m: string) => {
      const note = slot.querySelector('.form-msg');
      if (note) note.textContent = m;
    };
    const del = rec ? confirmButton('Delete this record', 'Click again to delete', async () => {
      await send({ action: cfg.remove, [cfg.idKey]: (rec as { id: string }).id });
      await refreshAfterEdit('Record deleted.');
    }, report) : null;
    return formEl(
      rec ? `Edit ${cfg.noun}` : `Add a ${cfg.noun}`,
      fields,
      rec ? 'Save' : 'Add record',
      async (v) => {
        const body: Record<string, unknown> = { action: rec ? cfg.update : cfg.create };
        if (rec) body[cfg.idKey] = (rec as { id: string }).id;
        else body.householdId = hh.id;
        for (const f of cfg.fields) {
          const now = (v[f.name] ?? '').trim();
          const was = current[f.name] == null ? '' : String(current[f.name]);
          if (rec ? now !== was : now !== '') body[f.name] = now === '' ? null : now;
        }
        if (rec && v.householdId !== hh.id) body.householdId = v.householdId;
        if (Object.keys(body).length <= 2) throw new Error(rec ? 'Nothing to change.' : 'Enter at least one detail.');
        await send(body);
        await refreshAfterEdit(rec ? 'Saved.' : 'Record added.');
      },
      () => slot.replaceChildren(),
      del,
    );
  }

  // Everything we hold about one household, as a page of cards.
  function openDetail(hh: Household, message?: string) {
    openId = hh.id;
    $('detail-title').textContent = [`Farm plot ${hh.farmUnit}`, hh.houseNo ?? 'No house'].join(' · ');
    const body = $('detail-body');
    const facts = [hh.cluster ? `Cluster ${hh.cluster}` : null, hh.unitType ? `Unit type ${hh.unitType}` : null].filter(Boolean).join(' · ');
    body.replaceChildren();
    if (message) body.append(h('p', { class: 'form-ok', text: message, attrs: { role: 'status' } }));

    // The unit card: its facts, the edit link, and anything that needs attention.
    const hhSlot = h('div');
    body.append(
      h(
        'section',
        { class: 'dcard' },
        h('div', { class: 'factsrow' }, h('p', { class: 'meta', text: facts || 'No cluster or unit type yet' }), can.manage ? rowButton('Edit house, cluster and unit type', () => hhSlot.replaceChildren(householdForm(hh, hhSlot))) : null),
        hhSlot,
        hh.flags.length ? h('ul', { class: 'flags' }, ...hh.flags.map((f) => h('li', {}, flagChip(f)))) : null,
      ),
    );
    const section = (title: string, ...nodes: Kid[]) => body.append(h('section', { class: 'dcard' }, h('h3', { text: title }), ...nodes));
    const editable = can.edit || can.manage;

    // People
    const peopleSlot = h('div');
    const reportPeople = (m: string) => {
      const note = peopleSlot.querySelector('.form-msg') ?? body.querySelector('.form-ok');
      if (note) note.textContent = m;
      else peopleSlot.append(h('p', { class: 'form-msg', text: m, attrs: { role: 'alert' } }));
    };
    const personActions = (p: Person): HTMLElement =>
      h(
        'span',
        { class: 'rowbtns' },
        can.edit ? rowButton('Edit', () => peopleSlot.replaceChildren(personForm(hh, p, peopleSlot))) : null,
        can.manage ? rowButton('Move', () => peopleSlot.replaceChildren(moveForm(hh, p, peopleSlot))) : null,
        // Lets this person sign in to the member portal (needs an email on file; at most two per household).
        can.manage
          ? rowButton(p.canLogin ? 'Remove sign-in' : 'Allow sign-in', async () => {
              try {
                await send({ action: 'membership.invite', householdId: hh.id, personId: p.id, canLogin: !p.canLogin });
                await refreshAfterEdit(p.canLogin ? 'Sign-in removed.' : 'They can now sign in to the member portal.');
              } catch (err) {
                reportPeople(err instanceof Error ? err.message : 'Something went wrong.');
              }
            })
          : null,
        can.manage
          ? confirmButton('Remove', 'Click again to remove', async () => {
              await send({ action: 'membership.remove', householdId: hh.id, personId: p.id });
              await refreshAfterEdit('Removed from this unit.');
            }, reportPeople)
          : null,
      );
    section(
      'People',
      h(
        'div',
        { class: 'table-wrap' },
        table(
          ['Name', 'Role', 'Email on file', 'Phone on file', 'Can sign in', ...(editable ? [''] : [])],
          hh.people.map((p) => [p.name, p.role, p.hasEmail ? 'Yes' : 'No', p.hasPhone ? 'Yes' : 'No', p.canLogin ? 'Yes' : 'Not invited', ...(editable ? [personActions(p)] : [])]),
        ),
      ),
      peopleSlot,
      can.manage ? rowButton('Add a person', () => peopleSlot.replaceChildren(addPersonForm(hh, peopleSlot))) : null,
    );

    // Farm patta
    const plotSlot = h('div');
    section(
      'Farm patta',
      hh.plots.length
        ? pivot(
            `${plural(hh.plots.length, 'plot')} · ${acres(hh.farmAcres)} (${haFmt.format(hh.farmHectares)} ha)${hh.plotsMissingArea ? ` · ${plural(hh.plotsMissingArea, 'plot')} without an area yet` : ''}`,
            mergePattaRuns(table(
              ['Patta no.', 'Survey no.', 'Hectares', 'Acres', 'Settlement', 'Status', ...(can.manage ? [''] : [])],
              [...hh.plots].sort(byPatta).map((p) => [p.pattaNo, surveyLink(hh, p.surveyNo, p.sourceDocumentId), ha(p.areaHectares), p.areaAcres, p.settlement, verifiedMark(p.verification), ...(can.manage ? [rowButton('Edit', () => plotSlot.replaceChildren(landForm('plot', hh, p, plotSlot)))] : [])]),
            )),
          )
        : h('p', { class: 'muted', text: 'Not available yet' }),
      plotSlot,
      can.manage ? rowButton('Add a farm patta record', () => plotSlot.replaceChildren(landForm('plot', hh, null, plotSlot))) : null,
    );

    // House patta
    const houseSlot = h('div');
    section(
      'House patta',
      hh.housePattas.length
        ? pivot(
            `${plural(hh.housePattas.length, 'record')} · ${sqft(hh.houseSqFt)} (${acres(sqftAsAcres(hh.houseSqFt))})${hh.housePattasMissingArea ? ` · ${plural(hh.housePattasMissingArea, 'record')} without an area yet` : ''}`,
            mergePattaRuns(table(
              ['Patta no.', 'Reference', 'Survey no.', 'Sq ft', 'Settlement', 'Status', ...(can.manage ? [''] : [])],
              [...hh.housePattas].sort(byPatta).map((p) => [p.pattaNo, p.referenceNo, surveyLink(hh, p.surveyNo, p.sourceDocumentId), p.areaSqFt, p.settlement, verifiedMark(p.verification), ...(can.manage ? [rowButton('Edit', () => houseSlot.replaceChildren(landForm('housepatta', hh, p, houseSlot)))] : [])]),
            )),
          )
        : h('p', { class: 'muted', text: hh.houseNo ? 'Not available yet' : 'No house' }),
      houseSlot,
      can.manage ? rowButton('Add a house patta record', () => houseSlot.replaceChildren(landForm('housepatta', hh, null, houseSlot))) : null,
    );
    // Land documents uploaded by the household's members (read in the background; see
    // members-land-extract-background.mts). New records and disagreements wait here.
    const docsSlot = h('div', {}, h('p', { class: 'muted', text: 'Loading…' }));
    section('Land documents', docsSlot);
    void loadLandDocuments(hh, docsSlot);
    overview.hidden = true;
    detail.hidden = false;
    if (location.hash !== `#${hh.farmUnit}`) history.pushState(null, '', `#${hh.farmUnit}`);
    window.scrollTo(0, 0);
  }

  function closeDetail() {
    openId = null;
    detail.hidden = true;
    overview.hidden = false;
    if (location.hash) history.pushState(null, '', location.pathname + location.search);
  }

  type LandDiff = { field: string; recorded: string; document: string };
  type LandItem = { surveyNo: string; pattaNo: string | null; areaHectares?: number | null; areaSqFt?: number | null; outcome: string; differences: LandDiff[]; ownerMatch: boolean | null; decision?: string };
  type LandDocument = { id: string; landType: string; fileName: string | null; mimeType: string; status: string; error: string | null; uploadedAt: string; sketchFor: string | null; items: LandItem[] };
  const chip = (severity: 'info' | 'warn' | 'error', text: string) => h('span', { class: `flag flag--${severity}`, text });

  // A record read from a document that still waits for the core team, with where it came from.
  type OpenRecord = { doc: LandDocument; item: LandItem; index: number };
  const WAITING = ['pending', 'mismatch', 'check', 'conflict'];
  const DIFF_LABEL: Record<string, string> = { patta_no: 'Patta', area: 'Area', area_sq_ft: 'Area', owners: 'Owners' };
  const landTag = (landType: string) => h('span', { class: `landq-tag${landType === 'house' ? ' landq-tag--house' : ''}`, text: landType === 'house' ? 'House plot' : 'Farm land' });

  // The decision in one sentence, for the row and for the top of the opened card.
  function landHeadline(i: LandItem): string {
    if (i.outcome === 'conflict') return 'Another unit already holds this survey number';
    if (i.outcome === 'pending') return i.ownerMatch === false ? 'New record; the owner names on the document don’t match anyone here (often just a different spelling)' : 'New record, not in the register yet';
    if (i.outcome === 'check') return 'Can’t be verified from this file alone';
    const fields = i.differences.filter((d) => d.field !== 'owners');
    if (fields.length === 0) return 'Owner names don’t match the unit';
    const first = fields[0];
    return `${DIFF_LABEL[first.field] ?? first.field} differs: register ${first.recorded}, document ${first.document}${fields.length > 1 ? ` (+${fields.length - 1} more)` : ''}`;
  }

  // Needs a careful look / differences to confirm / quick yes.
  const landGroup = (i: LandItem): 'stop' | 'check' | 'quick' =>
    i.outcome === 'conflict' ? 'stop' : i.outcome === 'pending' && i.ownerMatch !== false ? 'quick' : 'check';

  function landFacts(i: LandItem, landType: string): HTMLElement[] {
    const cells = (label: string, recorded: string, document: string) =>
      h('div', { class: 'landq-diff' }, h('div', {}, h('small', { text: `${label} · register` }), h('strong', { text: recorded })), h('div', { class: 'landq-new' }, h('small', { text: `${label} · document` }), h('strong', { text: document })));
    if (i.differences.length) return i.differences.map((d) => cells(DIFF_LABEL[d.field] ?? d.field, d.recorded, d.document));
    if (i.outcome !== 'pending') return [];
    // A new record: no register value to compare, so show what the document says.
    const area = landType === 'house' ? (i.areaSqFt != null ? sqft(i.areaSqFt) : null) : i.areaHectares != null ? `${ha(i.areaHectares)} ha` : null;
    return area ? [cells('Area', 'none', area)] : [];
  }

  async function loadLandDocuments(hh: Household, slot: HTMLElement) {
    try {
      const { status, data } = await staffFetch(`/api/members-admin/land-documents?householdId=${encodeURIComponent(hh.id)}`);
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      const docs: LandDocument[] = data.documents;
      if (docs.length === 0) return slot.replaceChildren(h('p', { class: 'muted', text: 'Nothing uploaded.' }));
      const report = (m: string) => {
        slot.querySelector('.form-msg')?.remove();
        slot.prepend(h('p', { class: 'form-msg', text: m, attrs: { role: 'alert' } }));
      };
      const decide = (action: 'landdoc.approve' | 'landdoc.reject', r: OpenRecord) => async () => {
        try {
          await send({ action, documentId: r.doc.id, itemIndex: r.index });
          await refreshAfterEdit(action === 'landdoc.approve' ? 'Approved and verified.' : 'Rejected.');
        } catch (err) {
          report(err instanceof Error ? err.message : 'Something went wrong.');
        }
      };
      const act = (label: string, run: () => void, kind: 'main' | 'danger' | '' = '') => {
        const b = h('button', { class: `landq-btn${kind ? ` landq-btn--${kind}` : ''}`, text: label, attrs: { type: 'button' } });
        b.addEventListener('click', run);
        return b;
      };
      // Buttons say what will happen to the register. Reject on a record the member added removes it.
      const buttons = (r: OpenRecord): HTMLElement | null => {
        if (!can.manage) return null;
        const approve = decide('landdoc.approve', r);
        const reject = decide('landdoc.reject', r);
        const i = r.item;
        if (i.outcome === 'conflict') return h('div', { class: 'landq-actions' }, act('Dismiss', reject, 'main'));
        const onlyOwners = i.outcome === 'mismatch' && i.differences.every((d) => d.field === 'owners');
        const yes = i.outcome === 'pending' ? 'Add to register' : i.outcome === 'mismatch' && !onlyOwners ? 'Use the document’s values and verify' : 'Verify';
        return h('div', { class: 'landq-actions' }, act(yes, approve, 'main'), act(i.outcome === 'pending' ? 'Reject and remove' : 'Reject', reject, 'danger'));
      };

      const open: OpenRecord[] = docs.flatMap((doc) => doc.items.map((item, index) => ({ doc, item, index })).filter((r) => WAITING.includes(r.item.outcome) && !r.item.decision));
      const autoVerified = docs.flatMap((d) => d.items).filter((i) => i.outcome === 'verified' && !i.decision);
      const verified = autoVerified.length;
      // Owner names are a transliteration from Tamil and often differ from the register, so they do not stop a record the register
      // already holds from being verified (by its survey number, patta and area); the admin is told how many it happened to.
      const namesUnmatched = autoVerified.filter((i) => i.ownerMatch === false).length;
      let openKey = '';

      const rowOf = (r: OpenRecord, redraw: () => void): HTMLElement => {
        const key = `${r.doc.id}:${r.index}`;
        const isOpen = openKey === key;
        const head = h('button', { class: 'landq-head', attrs: { type: 'button', 'aria-expanded': String(isOpen) } }, landTag(r.doc.landType), h('span', { class: 'landq-sentence', text: `${r.item.surveyNo}: ${landHeadline(r.item)}` }), h('span', { class: 'landq-chev', text: isOpen ? '▴' : '▾', attrs: { 'aria-hidden': 'true' } }));
        head.addEventListener('click', () => {
          openKey = isOpen ? '' : key;
          redraw();
        });
        const notes = [
          r.item.outcome === 'conflict' ? 'Nothing was added. Sort it out in the register first, then dismiss this.' : null,
          r.item.outcome === 'check' ? 'A photo or scan, or a record the member added that is still waiting, can’t be verified by a document alone.' : null,
          r.item.ownerMatch === null && r.item.outcome === 'pending' ? 'Owner names couldn’t be read; check them in the file.' : null,
        ].filter((n): n is string => Boolean(n));
        const view = can.manage ? rowButton('View the PDF', () => void openLandFile(r.doc.id, report)) : null;
        view?.classList.add('landq-link');
        const body = h('div', { class: 'landq-body' }, ...landFacts(r.item, r.doc.landType), ...notes.map((n) => h('p', { class: 'landq-note', text: n })), view, buttons(r));
        return h('section', { class: 'landq-row' }, head, isOpen ? body : null);
      };

      const GROUPS: { g: 'stop' | 'check' | 'quick'; title: string }[] = [
        { g: 'stop', title: 'Needs a careful look' },
        { g: 'check', title: 'Differences to confirm' },
        { g: 'quick', title: 'Quick yes' },
      ];

      // Uploaded files, kept small: who/when/what, whether it was read, and a way to open it.
      const files = h('div', { class: 'landq-files' }, ...docs.map((d) => {
        const waiting = d.items.some((i) => WAITING.includes(i.outcome) && !i.decision);
        const state = d.status === 'processing' ? chip('info', 'Reading…') : d.status === 'failed' ? chip('error', 'Not used') : waiting || (d.status === 'needs_review' && d.items.length === 0) ? chip('warn', 'Needs review') : chip('info', 'Done');
        const view = can.manage ? rowButton('View file', () => void openLandFile(d.id, report)) : null;
        const note = d.status === 'failed' ? (d.error ?? 'Could not be used.') : d.status === 'needs_review' && d.items.length === 0 ? 'Could not be read automatically. Open the file and add the record above by hand.' : null;
        return h('div', { class: 'landq-file' }, landTag(d.landType), h('span', { class: 'landq-filemeta', text: `${new Date(d.uploadedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })} · ${d.sketchFor ? `FMB sketch, survey no. ${d.sketchFor}` : d.mimeType === 'application/pdf' ? 'PDF' : 'Photo'}` }), state, view, note ? h('p', { class: 'landq-note', text: note }) : null);
      }));

      const draw = () => {
        const nodes: Node[] = [];
        for (const { g, title } of GROUPS) {
          const list = open.filter((r) => landGroup(r.item) === g);
          if (!list.length) continue;
          nodes.push(h('p', { class: 'landq-group', text: title }), ...list.map((r) => rowOf(r, draw)));
        }
        if (open.length === 0) nodes.push(h('p', { class: 'muted', text: 'Nothing waiting for a decision.' }));
        if (verified) nodes.push(h('p', { class: 'landq-auto', text: `${plural(verified, 'record')} verified automatically${namesUnmatched ? `; for ${namesUnmatched === verified ? 'all of them' : namesUnmatched}, the owner names on the document did not match anyone here (names are often spelled differently when translated from Tamil)` : ''}` }));
        nodes.push(files);
        slot.replaceChildren(...nodes);
      };
      draw();
    } catch (err) {
      slot.replaceChildren(h('p', { class: 'form-msg', text: err instanceof Error ? err.message : 'Could not load documents.' }));
    }
  }
  $('detail-close').addEventListener('click', closeDetail);
  // The browser's Back button returns to the list, and a link to #F-27 opens that household.
  window.addEventListener('popstate', () => {
    const unit = location.hash.slice(1);
    const hh = unit ? households.find((x) => x.farmUnit === unit) : null;
    if (hh) openDetail(hh);
    else if (!detail.hidden) {
      detail.hidden = true;
      overview.hidden = false;
      openId = null;
    }
  });

  function renderList() {
    const q = ($<HTMLInputElement>('search').value || '').trim().toLowerCase();
    const show = $<HTMLSelectElement>('show').value;
    const shown = households.filter((hh) => {
      if (show === 'validate' && !needsValidation(hh)) return false;
      if (show === 'attention' && !needsAttention(hh)) return false;
      if (!q) return true;
      const hay = [hh.farmUnit, hh.houseNo ?? '', hh.cluster ?? '', ...hh.people.map((p) => p.name)].join(' ').toLowerCase();
      return hay.includes(q);
    });
    $('count').textContent = `${shown.length} of ${households.length} units`;
    // Grouped by housing cluster, in a fixed order; households with no cluster
    // (no house built yet) come last.
    // Within a cluster, cards run in house-number order (H-01, H-02, ...); a
    // household with no house yet sorts last, by farm plot.
    const houseNumber = (hh: Household) => (hh.houseNo ? parseInt(hh.houseNo.slice(2), 10) : Infinity);
    const byHouse = (a: Household, b: Household) => houseNumber(a) - houseNumber(b) || a.farmUnit.localeCompare(b.farmUnit);
    const groups = CLUSTERS.map((c) => ({
      title: c ? `Cluster ${c}` : 'No cluster yet',
      items: shown.filter((hh) => (hh.cluster ?? null) === c).sort(byHouse),
    })).filter((g) => g.items.length);
    $('list').replaceChildren(
      ...groups.map((g) =>
        h(
          'section',
          { class: 'group' },
          h('h2', {}, g.title, h('small', { text: `${plural(g.items.length, 'unit')} · ${acres(sumOf(g.items, (x) => x.farmAcres))} farm · ${acres(sqftAsAcres(sumOf(g.items, (x) => x.houseSqFt)))} house` })),
          h('div', { class: 'grid' }, ...g.items.map(renderHousehold)),
        ),
      ),
    );
  }

  function renderTotals(t: Totals) {
    const stat = (label: string, value: string, sub?: string) => h('div', {}, h('dt', { text: label }), h('dd', { text: value }), sub ? h('dd', { class: 'sub', text: sub }) : null);
    const withFarm = households.filter((hh) => hh.plots.length).length;
    const withHouse = households.filter((hh) => hh.housePattas.length).length;
    $('totals').replaceChildren(
      stat('Units', String(t.households)),
      stat('People', String(t.people)),
      stat('With an email on file', `${t.peopleWithEmail} of ${t.people}`),
      stat('Farm land', acres(t.farmAcres), `${haFmt.format(t.farmHectares)} ha · ${plural(t.farmPlots, 'plot')} · ${withFarm} of ${t.households} units have data`),
      stat('House land', acres(sqftAsAcres(t.houseSqFt)), `${sqft(t.houseSqFt)} · ${withHouse} of ${t.households} units have data`),
      stat('Need validation', String(households.filter(needsValidation).length), 'land documents waiting for a decision'),
      stat('Need attention', String(households.filter(needsAttention).length), 'problems in the register'),
    );
  }

  // ---- publish to the website ----------------------------------------------------
  // Approved stories with "Show on tvc.farm" on reach the public Members page at the next site build. A build
  // takes about half an hour and costs Netlify credits, so approvals are batched: this button starts one.
  type PublishStatus = { configured: boolean; canPublish: boolean; lastPublishedAt: string | null; publicStories: number; waiting: number };

  async function loadPublish() {
    const box = $('publish');
    if (!can.edit) {
      box.hidden = true;
      return;
    }
    try {
      const { status, data } = await staffFetch('/api/members-admin/publish');
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      renderPublish(data as PublishStatus);
    } catch {
      box.hidden = true; // the register works without it
    }
  }

  function renderPublish(st: PublishStatus) {
    const box = $('publish');
    box.hidden = false;
    const when = (iso: string) => new Date(iso).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
    const msg = h('p', { class: 'form-msg', attrs: { role: 'alert' } });
    const line = st.waiting > 0
      ? `${st.waiting} approved public ${st.waiting === 1 ? 'story' : 'stories'} waiting to go on tvc.farm`
      : 'Nothing waiting to go on tvc.farm';
    const kids: Kid[] = [
      h('strong', { text: 'Website' }),
      h('p', { class: 'muted', text: `${line}. ${st.publicStories} ${st.publicStories === 1 ? 'story is' : 'stories are'} public in all. ${st.lastPublishedAt ? `Last publish started ${when(st.lastPublishedAt)}.` : 'Nothing has been published yet.'} A story switched off, or a photo removed, comes off the site at the next publish too.` }),
    ];
    if (!st.configured) kids.push(h('p', { class: 'muted', text: 'Publishing is not set up yet: a Netlify build hook has to be added (see docs/plans/member-portal.md, "Public export").' }));
    else if (!st.canPublish) kids.push(h('p', { class: 'muted', text: 'An admin starts the publish.' }));
    else {
      const btn = h('button', { class: 'rowbtn rowbtn--act rowbtn--yes', text: 'Publish to the website', attrs: { type: 'button' } });
      let armed = false;
      btn.addEventListener('click', async () => {
        if (!armed) {
          armed = true;
          btn.textContent = 'Start the build? It takes about 30 minutes. Click again to confirm';
          setTimeout(() => { armed = false; btn.textContent = 'Publish to the website'; }, 6000);
          return;
        }
        btn.setAttribute('disabled', '');
        try {
          await send({ action: 'site.publish' });
          msg.textContent = 'The build has started. The public Members page updates in about 30 minutes.';
          await loadPublish();
        } catch (err) {
          btn.removeAttribute('disabled');
          armed = false;
          btn.textContent = 'Publish to the website';
          msg.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        }
      });
      kids.push(h('div', { class: 'rowbtns' }, btn));
    }
    kids.push(msg);
    box.replaceChildren(...(kids.filter(Boolean) as Node[]));
  }

  // ---- automatic publishing ------------------------------------------------------
  // Every submitted public story is assessed for risk. In SHADOW mode (the default) that is shown on the queue and nothing
  // is done by itself, so the assessment can be compared with the team's own decisions. In LIVE mode a low-risk story is
  // published without a person, a high-risk one is held and the team emailed, and a daily job starts the build.
  type Autopublish = { mode: 'shadow' | 'live'; paused: boolean; canChange: boolean; stats: { assessed: number; low: number; high: number; decided: number; missed: number; overHeld: number }; published: { householdId: string; name: string; at: string; stillPublic: boolean }[] };

  async function loadAutopublish() {
    const box = $('autopublish');
    if (!can.edit) {
      box.hidden = true;
      return;
    }
    try {
      const { status, data } = await staffFetch('/api/members-admin/autopublish');
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      renderAutopublish(data as Autopublish);
    } catch {
      box.hidden = true; // the register works without it
    }
  }

  function renderAutopublish(st: Autopublish) {
    const box = $('autopublish');
    box.hidden = false;
    const when = (iso: string) => new Date(iso).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
    const msg = h('p', { class: 'form-msg', attrs: { role: 'alert' } });
    const s = st.stats;
    const mode = st.mode === 'live'
      ? (st.paused ? 'Live, but paused: nothing is approved or published automatically until it is resumed.' : 'Live: a low-risk story is published without a person, a high-risk one is held and emailed to the core team, and approved stories go on the website every morning at 7.')
      : 'Shadow mode: every public story is assessed and the result is shown in the review queue, but a person approves everything and nothing is published or emailed by itself.';
    const kids: Kid[] = [
      h('strong', { text: 'Automatic publishing' }),
      h('p', { class: 'muted', text: mode }),
      h('p', { class: 'muted', text: s.assessed === 0
        ? 'No public stories have been assessed in the last 30 days.'
        : `Last 30 days: ${s.assessed} public ${s.assessed === 1 ? 'story' : 'stories'} assessed, ${s.low} low risk and ${s.high} high. ${s.decided} decided by a person so far: ${s.missed === 0 ? 'none that it called low was rejected' : `${s.missed} that it called low ${s.missed === 1 ? 'was' : 'were'} rejected by a person, so the rules need tightening before it goes live`}${s.overHeld ? `; ${s.overHeld} that it would have held ${s.overHeld === 1 ? 'was' : 'were'} approved as they were` : ''}.` }),
    ];
    const armedButton = (label: string, confirm: string, run: () => Promise<void>, cls = 'rowbtn rowbtn--act') => {
      const btn = h('button', { class: cls, text: label, attrs: { type: 'button' } });
      let armed = false;
      btn.addEventListener('click', async () => {
        if (!armed) {
          armed = true;
          btn.textContent = confirm;
          setTimeout(() => { armed = false; btn.textContent = label; }, 7000);
          return;
        }
        btn.setAttribute('disabled', '');
        try {
          await run();
        } catch (err) {
          btn.removeAttribute('disabled');
          armed = false;
          btn.textContent = label;
          msg.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        }
      });
      return btn;
    };
    if (st.canChange) {
      const row = h('div', { class: 'rowbtns' });
      if (st.mode === 'shadow') {
        row.append(armedButton('Switch to live', 'Switch to live? Low-risk stories will then publish without anyone reading them. Click again to confirm', async () => { await send({ action: 'site.autopublish', mode: 'live' }); await loadAutopublish(); void loadUnitStories(); }, 'rowbtn rowbtn--act rowbtn--yes'));
      } else {
        row.append(armedButton('Back to shadow mode', 'Go back to shadow mode? A person will approve everything again. Click again to confirm', async () => { await send({ action: 'site.autopublish', mode: 'shadow' }); await loadAutopublish(); void loadUnitStories(); }));
        row.append(armedButton(st.paused ? 'Resume' : 'Pause', st.paused ? 'Resume automatic publishing? Click again to confirm' : 'Pause? Everything waits for a person until resumed. Click again to confirm', async () => { await send({ action: 'site.autopublish', paused: !st.paused }); await loadAutopublish(); }));
      }
      kids.push(row);
    } else kids.push(h('p', { class: 'muted', text: 'An admin changes this setting.' }));
    if (st.published.length) {
      kids.push(h('p', { class: 'muted', text: 'Published automatically in the last 7 days. Hide takes a story off the public site and starts a build:' }));
      kids.push(h('ul', { class: 'auto-list' }, ...st.published.map((p) => {
        const li = h('li', {}, h('span', { text: `${p.name} · ${when(p.at)} ` }));
        if (!p.stillPublic) li.append(h('span', { class: 'muted', text: '(no longer public)' }));
        else if (st.canChange) li.append(armedButton('Hide', 'Hide from the public site? Click again to confirm', async () => { await send({ action: 'unitstory.unpublish', householdId: p.householdId }); msg.textContent = `${p.name} is off the public site once the build finishes.`; await loadAutopublish(); await loadPublish(); }));
        return li;
      })));
    }
    kids.push(msg);
    box.replaceChildren(...(kids.filter(Boolean) as Node[]));
  }

  // The fields the writing check and the risk rules can flag.
  type StoryText = { bio: string; family: string; why: string; social: string; photo: string };
  const STORY_LABEL: Record<keyof StoryText, string> = { bio: 'What they do today', family: 'Family', why: 'Why TVC', social: 'Profile link', photo: 'Photo' };

  // ---- unit stories waiting for review -----------------------------------------
  // A story that belongs to a whole unit (member_unit_stories): bio, family and photos are the unit's, each
  // person's quote and profile link are their own. The queue shows what changed first and folds the rest away.
  // Hidden while nothing is waiting.
  type UnitStoryItem = {
    householdId: string; farmUnit: string; submittedAt: string; submittedBy: string | null; submittedPublic: boolean; approvedPublic: boolean | null;
    submitted: UnitCopy; approved: UnitCopy | null; changes: { kind: string; name?: string }[];
    flags: { field: string; kind: string; note: string }[];
    assessment: { level: 'low' | 'high'; outcome: 'publish' | 'hold'; mode: 'shadow' | 'live'; reasons: { code: string; text: string; source: string }[] } | null;
  };
  type UnitCopy = { bio: string; family: string; photos: { ref: string; personId: string }[]; quotes: { name: string; text: string }[]; links: { name: string; url: string }[] };

  async function loadUnitStories() {
    const box = $('unit-stories');
    if (!can.edit) {
      box.hidden = true;
      return;
    }
    try {
      const { status, data } = await staffFetch('/api/members-admin/unit-stories');
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      renderUnitStories(data.stories as UnitStoryItem[]);
    } catch {
      box.hidden = false;
      box.replaceChildren(h('p', { class: 'muted', text: 'Could not load the unit stories waiting for review.' }));
    }
  }

  async function decideUnitStory(st: UnitStoryItem, action: 'unitstory.approve' | 'unitstory.reject', note?: string) {
    await send({ action, householdId: st.householdId, submittedAt: st.submittedAt, ...(note ? { note } : {}) });
    await loadUnitStories();
  }

  // One line per change, in words: "What they do today", "Asha's quote"...
  const changeWords = (c: { kind: string; name?: string }) =>
    c.kind === 'new' ? 'New story' : c.kind === 'bio' ? 'What they do today' : c.kind === 'family' ? 'Family' : c.kind === 'photos' ? 'Photos' : c.kind === 'public' ? 'Public switch' : c.kind === 'quote' ? `${c.name}’s “Why TVC”` : `${c.name}’s profile link`;

  function renderUnitStories(stories: UnitStoryItem[]) {
    const box = $('unit-stories');
    if (stories.length === 0) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    const when = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const pic = (ref: string) => {
      const img = document.createElement('img');
      img.className = 'story-photo';
      img.alt = '';
      staffPhotoSrc(ref).then((src) => { img.src = src; }).catch(() => img.replaceWith(h('span', { class: 'muted', text: '(photo unavailable)' })));
      return img;
    };
    const cards = stories.map((st) => {
      const msg = h('p', { class: 'form-msg', attrs: { role: 'alert' } });
      const isNew = !st.approved;
      const changed = (kind: string, name?: string) => isNew || st.changes.some((c) => c.kind === kind && (name === undefined || c.name === name));
      const changedRows: HTMLElement[] = [];
      const unchanged: { label: string; node: HTMLElement }[] = [];
      // Each part is a row; the changed ones are shown, the unchanged ones fold into one line.
      const part = (label: string, kind: string, name: string | undefined, now: Node | null, was: Node | null) => {
        if (!now && !was) return;
        if (!changed(kind, name)) {
          if (now) unchanged.push({ label, node: h('div', { class: 'story-row' }, h('dt', { text: label }), h('dd', {}, now)) });
          return;
        }
        changedRows.push(h('div', { class: 'story-row' },
          h('dt', { text: label }, isNew ? null : h('span', { class: 'flag flag--warn', text: now ? 'Changed' : 'Removed' })),
          h('dd', { class: now ? 'story-text' : 'muted' }, now ?? '(removed)'),
          !isNew && was ? h('details', { class: 'story-was' }, h('summary', { text: 'Currently approved' }), was) : null));
      };
      const text = (t: string) => (t ? h('span', { text: t }) : null);
      part('What they do today', 'bio', undefined, text(st.submitted.bio), text(st.approved?.bio ?? ''));
      part('Family', 'family', undefined, text(st.submitted.family), text(st.approved?.family ?? ''));
      const photos = (c: UnitCopy | null) => (c?.photos.length ? h('div', { class: 'story-photos' }, ...c.photos.map((p) => pic(p.ref))) : null);
      part('Photos', 'photos', undefined, photos(st.submitted), photos(st.approved));
      const names = [...new Set([...st.submitted.quotes.map((q) => q.name), ...(st.approved?.quotes ?? []).map((q) => q.name)])];
      for (const n of names) part(`${n}’s “Why TVC”`, 'quote', n, text(st.submitted.quotes.find((q) => q.name === n)?.text ?? ''), text(st.approved?.quotes.find((q) => q.name === n)?.text ?? ''));
      const linkNames = [...new Set([...st.submitted.links.map((l) => l.name), ...(st.approved?.links ?? []).map((l) => l.name)])];
      for (const n of linkNames) part(`${n}’s profile link`, 'link', n, text(st.submitted.links.find((l) => l.name === n)?.url ?? ''), text(st.approved?.links.find((l) => l.name === n)?.url ?? ''));
      // Where the links in the text go, so a reviewer sees the addresses and not only the words.
      const linkList = (c: UnitCopy | null) => [...linksIn(c?.bio ?? ''), ...linksIn(c?.family ?? '')];
      const linksNow = linkList(st.submitted);
      const linksWas = linkList(st.approved);
      const linkKey = (ls: { label: string; href: string }[]) => ls.map((l) => `${l.label}\u0000${l.href}`).join('\n');
      if (linksNow.length || linksWas.length) {
        const lines = (ls: { label: string; href: string }[]) => h('ul', { class: 'story-links' }, ...ls.map((l) => h('li', {}, h('strong', { text: l.label }), ` → ${l.href}`)));
        const linkChanged = !isNew && linkKey(linksNow) !== linkKey(linksWas);
        changedRows.push(h('div', { class: 'story-row' },
          h('dt', { text: 'Links in the text' }, linkChanged ? h('span', { class: 'flag flag--warn', text: 'Changed' }) : null),
          linksNow.length ? h('dd', { class: 'story-text' }, lines(linksNow)) : h('dd', { class: 'muted', text: '(none)' }),
          linkChanged && linksWas.length ? h('details', { class: 'story-was' }, h('summary', { text: 'Currently approved links' }), lines(linksWas)) : null));
      }

      const head = h('div', { class: 'story-head' },
        h('span', { class: 'unit-pill', text: st.farmUnit }),
        h('strong', { text: st.submittedBy ? `Submitted by ${st.submittedBy}` : 'Submitted' }),
        h('span', { class: 'meta', text: when(st.submittedAt) }),
        h('span', { class: `flag flag--${st.submittedPublic ? 'warn' : 'info'}`, text: st.submittedPublic ? 'Wants to be on tvc.farm' : 'Members only' }),
        !isNew ? h('span', { class: 'flag flag--info', text: 'Edit to an approved story' }) : null);
      const summary = h('ul', { class: 'story-changes', attrs: { 'aria-label': 'What changed' } }, ...(isNew ? [h('li', {}, h('span', { class: 'flag flag--info', text: 'New story' }))] : st.changes.map((c) => h('li', {}, h('span', { class: 'flag flag--warn', text: changeWords(c) })))));
      const flags = st.flags.length ? h('ul', { class: 'flags' }, ...st.flags.map((f) => h('li', {}, h('span', { class: 'flag flag--warn', text: `${STORY_LABEL[f.field as keyof StoryText]}: ${f.note}` })))) : null;
      // What the risk assessment made of this submission; in shadow mode a person still decides everything and this shows what it would have done.
      const a = st.assessment;
      const assessEl = !a ? null : h('div', { class: `assess assess--${a.level}` },
        h('strong', { text: a.level === 'low' ? (a.mode === 'shadow' ? 'Assessment: low risk, would have been published automatically' : 'Assessment: low risk') : (a.mode === 'shadow' ? 'Assessment: high risk, would have been held for you' : 'Assessment: high risk, held for you') }),
        a.reasons.length ? h('ul', {}, ...a.reasons.map((r) => h('li', { text: r.text }))) : null);
      const rest = unchanged.length ? h('details', { class: 'story-unchanged' }, h('summary', { text: `Unchanged: ${unchanged.map((u) => u.label).join(', ')}` }), h('dl', { class: 'story-fields' }, ...unchanged.map((u) => u.node))) : null;

      let actions: HTMLElement;
      if (!can.manage) {
        actions = h('p', { class: 'muted', text: 'An admin approves or sends back stories.' });
      } else {
        const noteBox = h('textarea', { attrs: { rows: '3', maxlength: '500', placeholder: 'What should they change? They will see this note.' } }) as HTMLTextAreaElement;
        const form = h('div', { class: 'story-reject', attrs: { hidden: '' } }, noteBox);
        const sendBack = h('button', { class: 'rowbtn rowbtn--act', text: 'Send back with this note', attrs: { type: 'button' } });
        sendBack.addEventListener('click', async () => {
          if (!noteBox.value.trim()) { msg.textContent = 'Write a note so the members know what to change.'; return; }
          try { await decideUnitStory(st, 'unitstory.reject', noteBox.value); } catch (err) { msg.textContent = err instanceof Error ? err.message : 'Something went wrong.'; }
        });
        form.append(sendBack);
        const approve = h('button', { class: 'rowbtn rowbtn--act rowbtn--yes', text: 'Approve', attrs: { type: 'button' } });
        approve.addEventListener('click', async () => {
          approve.setAttribute('disabled', '');
          try { await decideUnitStory(st, 'unitstory.approve'); } catch (err) { approve.removeAttribute('disabled'); msg.textContent = err instanceof Error ? err.message : 'Something went wrong.'; }
        });
        const reject = h('button', { class: 'rowbtn rowbtn--act', text: 'Send back…', attrs: { type: 'button' } });
        reject.addEventListener('click', () => { form.hidden = !form.hidden; if (!form.hidden) noteBox.focus(); });
        actions = h('div', { class: 'story-actions' }, h('div', { class: 'rowbtns' }, approve, reject), form);
      }
      return h('article', { class: 'card story-card' }, head, assessEl, summary, flags, h('dl', { class: 'story-fields' }, ...changedRows), rest, msg, actions);
    });
    box.replaceChildren(h('details', { class: 'story-queue', attrs: { open: '' } }, h('summary', { text: `Unit stories waiting for review (${stories.length})` }), h('div', { class: 'story-list' }, ...cards)));
  }

  // ---- notices ---------------------------------------------------------------------
  // Things to know that need no action (an owner added a family member). Each stays until someone dismisses it.
  type Notice = { id: string; kind: string; text: string; createdAt: string };

  async function loadNotices() {
    const box = $('notices');
    if (!can.edit) {
      box.hidden = true;
      return;
    }
    try {
      const { status, data } = await staffFetch('/api/members-admin/notices');
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      renderNotices(data.notices as Notice[]);
    } catch {
      box.hidden = true; // a quiet extra: if it cannot load, the register is still usable
    }
  }

  function renderNotices(notices: Notice[]) {
    const box = $('notices');
    if (notices.length === 0) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    const when = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const rows = notices.map((n) => {
      const dismiss = h('button', { class: 'rowbtn rowbtn--act', text: 'Dismiss', attrs: { type: 'button' } });
      dismiss.addEventListener('click', async () => {
        dismiss.setAttribute('disabled', '');
        try {
          await send({ action: 'notice.dismiss', noticeId: n.id });
          await loadNotices();
        } catch {
          dismiss.removeAttribute('disabled');
        }
      });
      return h('li', { class: 'notice-row' }, h('span', { text: n.text }), h('span', { class: 'muted', text: ` ${when(n.createdAt)}` }), ' ', dismiss);
    });
    box.replaceChildren(h('details', { class: 'story-queue', attrs: { open: '' } }, h('summary', { text: `Notices (${notices.length})` }), h('ul', { class: 'notice-list' }, ...rows)));
  }

  // ---- family member requests ---------------------------------------------------
  // An owner may add two family members who can sign in on their own; a further one waits here. Approving adds
  // them to the unit as family with sign-in; declining just closes the request.
  type FamilyRequest = { id: string; farmUnit: string; requestedBy: string; fullName: string; email: string; phone: string | null; createdAt: string };

  async function loadFamilyRequests() {
    const box = $('family-requests');
    if (!can.edit) {
      box.hidden = true;
      return;
    }
    try {
      const { status, data } = await staffFetch('/api/members-admin/family-requests');
      if (status !== 200) throw new Error(data.error || 'Could not load.');
      renderFamilyRequests(data.requests as FamilyRequest[]);
    } catch {
      box.hidden = false;
      box.replaceChildren(h('p', { class: 'muted', text: 'Could not load the family member requests.' }));
    }
  }

  function renderFamilyRequests(requests: FamilyRequest[]) {
    const box = $('family-requests');
    if (requests.length === 0) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    const when = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const cards = requests.map((r) => {
      const msg = h('p', { class: 'form-msg', attrs: { role: 'alert' } });
      const decide = (action: 'familyrequest.approve' | 'familyrequest.reject', buttons: HTMLElement[]) => async () => {
        buttons.forEach((b) => b.setAttribute('disabled', ''));
        try {
          await send({ action, requestId: r.id });
          await loadFamilyRequests();
          await loadData(); // an approval adds a person to the register
        } catch (err) {
          buttons.forEach((b) => b.removeAttribute('disabled'));
          msg.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        }
      };
      const approve = h('button', { class: 'rowbtn rowbtn--act rowbtn--yes', text: 'Approve', attrs: { type: 'button' } });
      const decline = h('button', { class: 'rowbtn rowbtn--act', text: 'Decline', attrs: { type: 'button' } });
      approve.addEventListener('click', decide('familyrequest.approve', [approve, decline]));
      decline.addEventListener('click', decide('familyrequest.reject', [approve, decline]));
      const actions = can.manage ? h('div', { class: 'rowbtns' }, approve, decline) : h('p', { class: 'muted', text: 'An admin decides on these requests.' });
      return h('article', { class: 'card story-card' },
        h('p', {}, h('strong', { text: `${r.farmUnit}: ${r.fullName}` }), ` (${r.email}${r.phone ? `, ${r.phone}` : ''})`),
        h('p', { class: 'muted', text: `Asked for by ${r.requestedBy} on ${when(r.createdAt)}. The unit already has two family members who can sign in.` }),
        msg, actions);
    });
    box.replaceChildren(h('details', { class: 'story-queue', attrs: { open: '' } }, h('summary', { text: `Family member requests (${requests.length})` }), h('div', { class: 'story-list' }, ...cards)));
  }

  // ---- load & sign-in ----------------------------------------------------------
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to review the member register.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }

  // Fetches the register and redraws the page; callers handle errors.
  async function loadData() {
    const { status, data } = await staffFetch('/api/members-admin/overview');
    if (status !== 200) throw new Error('load failed');
    households = data.households;
    can = data.can ?? { edit: false, manage: false };
    $('masked-note').hidden = !data.namesMasked;
    renderTotals(data.totals);
    renderList();
    void loadUnitStories();
    void loadNotices();
    void loadFamilyRequests();
    void loadPublish();
    void loadAutopublish();
  }

  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    statusEl.hidden = false;
    statusEl.textContent = 'Loading…';
    try {
      await loadData();
      statusEl.hidden = true;
      intro.textContent = can.edit
        ? 'The register of units, people and patta details. Emails and phone numbers are never shown here, only whether one is on file; you can replace or remove them.'
        : 'The register of units, people and patta details. Emails and phone numbers are never shown here, only whether one is on file.';
      content.hidden = false;
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      } else {
        statusEl.hidden = false;
        statusEl.textContent = 'Failed to load. Try refreshing.';
      }
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);
  $('sign-out').addEventListener('click', signOut);
  $('search').addEventListener('input', renderList);
  $('show').addEventListener('change', renderList);

  if (getToken()) load();
  else showGate();
</script>
