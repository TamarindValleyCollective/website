  }

  // ---- saving ----
  const errToast = (err: unknown) => {
    if (err instanceof StaffAuthError) { if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.'); else showForbidden(); } else showToast('Could not save. Try again.');
  };
  async function saveAlignment() {
    const f = liveFit();
    if (!f) return;
    const done = busyForPress('Saving…');
    try {
      // Moving the whole page moves its placed groups with it, so they are saved too (the groups first: the server checks a group
      // against where its page is saved, and the page has not moved yet).
      const post = async (body: Record<string, unknown>) => staffFetch('/api/site-map-admin/alignment', { method: 'POST', body });
      if (!groupKey && !linesMode && isTuned(tune)) {
        // (and the page's groups of lines that have a placement of their own)
        for (const k of lineKeys(clusterId)) {
          const lr = lineRowFor(clusterId, k);
          if (!lr) continue;
          const lf = withTune(asBase(lr, lineUnits(clusterId, k)));
          const r = await post({ cluster: clusterId, lines: true, ...(k === 'other' ? {} : { group: { houses: lineGroupOf(k)!.houses } }), direct: { a: lf.a, b: lf.b, tx: lf.tx, ty: lf.ty }, origin: lf.frame });
          if (r.status !== 200) { showToast(r.data?.error ?? 'Could not save the lines. Nothing else was saved.'); return; }
        }
        for (const g of groups.filter((x) => x.cluster === clusterId)) {
          const row = savedFit(g);
          if (!row) continue;
          const gf = withTune(asBase(row, unitsOf(g)));
          const r = await post({ cluster: clusterId, group: { houses: g.houses }, direct: { a: gf.a, b: gf.b, tx: gf.tx, ty: gf.ty }, origin: gf.frame });
          if (r.status !== 200) { showToast(r.data?.error ?? `Could not save homes ${rangeLabel(g.houses)}. Nothing else was saved.`); return; }
        }
      }
      const { status, data: out } = await post({ cluster: clusterId, ...(linesMode ? { lines: true, ...(lineKey === 'other' ? {} : { group: { houses: lineGroupOf(lineKey)?.houses ?? [] } }) } : groupKey ? { group: { houses: targetGroup()?.houses ?? [] } } : {}), direct: { a: f.a, b: f.b, tx: f.tx, ty: f.ty }, origin: f.frame });
      if (status !== 200) { showToast(out?.error ?? 'Could not save. Try again.'); return; }
