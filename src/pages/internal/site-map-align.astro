    else if (!live) hint = 'No placement yet. Find the farm on the map, place the plan here, then drag it into position.';
    else if (linesMode) hint = `The ${lineLabel(lineKey)} (white boundaries) move on their own, like a group of homes. Drag them onto the real boundaries (Shift turns), then save.`;
    else if (!aligned && groupKey) hint = `Homes ${rangeLabel(g!.houses)} share walls, so they move together. Drag them onto their buildings (Shift turns), then save.`;
