---
// Align to satellite (internal): lay each plan page of the Map over a satellite image by pairing points. An admin taps a home
// (or any spot) on the plan page, then the same spot on the image, three or more times; the page fits the scale, rotation and
// shift from the pairs, shows how far each pair is from the fit, and draws the plan over the image to check. Saving stores the
// pairs and the fit for that page (netlify/functions/site-map-admin.mts); the member map joins H1-A and H1-B from them
// (scripts/lib/site-map-align.mjs). The image is imagery from a map provider: it is kept in a private store and only admins
// are given it. Same shell and sign-in as the Map page. Everything the server returns is placed with textContent only.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
import '../../styles/site-map.css';
---

<StaffLayout title="Align map" description="Lay the plan over the satellite image." current="site-map">
  <section class="align section wrapper">
    <h1>Align to satellite</h1>
    <p id="intro" class="hint">Sign in to lay the plan over the satellite image.</p>

    <SignInGate forbiddenWhat="the Map tool" />

    <p id="status" class="hint" hidden></p>

    <div id="content" hidden>
      <p class="hint"><a href="/internal/site-map/">&larr; Back to the Map</a></p>
      <ol class="steps">
        <li id="step-image">Upload a satellite image (a screenshot of the farm from above, north up). <span id="image-note"></span></li>
        <li>Pick a plan page. Tap a home on the plan (or any spot, such as a plot corner), then tap the <em>same</em> spot on the image. Zoom in for a precise tap.</li>
        <li>Three or more pairs, spread apart, fit the page. The list shows how far each pair is from the fit; remove or redo the ones that are off, then Save.</li>
      </ol>

      <div class="bar">
        <div class="segmented" id="clusters" role="group" aria-label="Plan page"></div>
        <div class="editbar" id="imagebar" hidden>
          <input type="file" id="file" accept="image/png,image/jpeg" hidden />
          <button type="button" class="button button--outline" id="upload">Upload image</button>
        </div>
      </div>

      <p id="hint" class="hint" role="status"></p>

      <div class="al-grid">
        <div class="al-pane">
          <h2>Plan page <span id="plan-name"></span></h2>
          <div class="sm-stage">
            <svg id="plan" class="sm-map" role="group" aria-label="Plan page: tap a home or a spot"></svg>
            <div class="sm-zoom">
              <button type="button" class="button button--outline" data-z="plan" data-d="in" aria-label="Zoom in the plan">+</button>
              <button type="button" class="button button--outline" data-z="plan" data-d="out" aria-label="Zoom out the plan">&minus;</button>
              <button type="button" class="button button--outline" data-z="plan" data-d="fit" aria-label="Show the whole plan page">Fit</button>
            </div>
          </div>
        </div>
        <div class="al-pane">
          <h2>Satellite image</h2>
          <div class="sm-stage">
            <svg id="sat" class="sm-map" role="group" aria-label="Satellite image: tap the same spot"></svg>
            <div class="sm-zoom">
              <button type="button" class="button button--outline" data-z="sat" data-d="in" aria-label="Zoom in the image">+</button>
              <button type="button" class="button button--outline" data-z="sat" data-d="out" aria-label="Zoom out the image">&minus;</button>
              <button type="button" class="button button--outline" data-z="sat" data-d="fit" aria-label="Show the whole image">Fit</button>
            </div>
          </div>
          <div class="line" id="overlaybar" hidden>
            <button type="button" class="button button--outline" id="overlay" aria-pressed="false">Show the plan on the image</button>
            <label class="line">Plan strength <input type="range" id="strength" min="0" max="100" value="80" /></label>
          </div>
        </div>
      </div>

      <section class="card" id="fit-card" aria-live="polite"></section>
    </div>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .align .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 12px 0;
  }

  .align .steps { margin: 0 0 8px; padding-left: 20px; font-size: var(--text-sm); color: var(--tvc-ink-soft); }
  .align .steps li { margin: 2px 0; }
  .align .editbar { display: flex; flex-wrap: wrap; gap: 8px; }
  .align .al-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: start; }
  .align .al-pane h2 { margin: 0 0 6px; font-size: var(--text-md); }
  .align .al-pane h2 span { color: var(--tvc-ink-soft); font-weight: 400; }
  .align .sm-map { height: min(56vh, 560px); }
  .align .sm-zoom .button { width: 36px; padding: 0; background: var(--tvc-white); }
  .align .line { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-top: 8px; font-size: var(--text-sm); }
  .align .hint--wait { color: var(--tvc-orange-text); }

  @media (min-width: 901px) {
    .align .al-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Marks on the two pictures. A pair is the same number on both; the pending point has a ring until its partner is tapped. */
  .align .al-home { fill: var(--tvc-white); stroke: var(--tvc-green-dark); stroke-width: 1.5; vector-effect: non-scaling-stroke; cursor: pointer; }
  .align .al-home-label { fill: var(--tvc-ink-soft); text-anchor: middle; pointer-events: none; }
  .align .al-pin { fill: var(--tvc-green-dark); stroke: var(--tvc-white); stroke-width: 1.5; vector-effect: non-scaling-stroke; pointer-events: none; }
  .align .al-pin.is-off { fill: var(--tvc-error-text); }
  .align .al-pin-label { fill: var(--tvc-white); font-weight: 700; text-anchor: middle; dominant-baseline: central; pointer-events: none; }
  .align .al-pending { fill: none; stroke: var(--tvc-orange); stroke-width: 3; vector-effect: non-scaling-stroke; pointer-events: none; }
  .align .al-overlay-line { fill: none; stroke: var(--tvc-orange-light); stroke-width: 1.4; vector-effect: non-scaling-stroke; pointer-events: none; }
  .align .al-overlay-home { fill: var(--tvc-orange-light); stroke: var(--tvc-green-dark); stroke-width: 1; vector-effect: non-scaling-stroke; pointer-events: none; }

  .align .fit-grid { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 10px 0 0; font-size: var(--text-sm); }
  .align .fit-grid dt { color: var(--tvc-ink-soft); }
  .align .fit-grid dd { margin: 0; }
  .align .pairs { display: grid; gap: 4px; margin: 10px 0 0; padding: 0; list-style: none; font-size: var(--text-sm); }
  .align .pairs li { display: flex; align-items: center; gap: 10px; }
  .align .pairs .n { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--tvc-green-dark); color: var(--tvc-white); font-weight: 700; font-size: var(--text-xs); }
  .align .pairs .is-off .n { background: var(--tvc-error-text); }
  .align .pairs .what { flex: 1; min-width: 0; }
  .align .pairs .off { color: var(--tvc-ink-soft); }
  .align .pairs .is-off .off { color: var(--tvc-error-text); font-weight: 600; }
  .align .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .align .dirty { color: var(--tvc-orange-text); font-size: var(--text-sm); margin: 8px 0 0; }
</style>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../scripts/lib/staff-client.mjs';
  import { busyForPress } from '../../../scripts/lib/busy.mjs';
  import { MAX_PAIRS, MIN_PAIRS, fitSimilarity, planToImageMatrix } from '../../../scripts/lib/site-map-align.mjs';
  import { SVG_NS } from '../../../scripts/lib/site-map-draw.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // text only, never HTML
  type Kid = Node | string | null | undefined | false;
  function h(tag: string, cls = '', text?: string, ...kids: Kid[]): HTMLElement {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text !== undefined) el.textContent = text;
    for (const k of kids) if (k) el.append(k);
    return el;
  }
  const svgEl = (tag: string, attrs: Record<string, string | number> = {}, cls = '') => {
    const e = document.createElementNS(SVG_NS, tag);
    if (cls) e.setAttribute('class', cls);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  };

  type Unit = { houseNo: string; cluster: string; x: number; y: number };
  type Cluster = { id: string; viewBox: number[]; plot: string };
  type Pair = { house: string | null; plan: number[]; image: number[] };
  type Saved = { cluster: string; a: number; b: number; tx: number; ty: number; scale: number; rotation: number; rms: number | null; pairs: Pair[]; updatedAt: string | null };

  const gate = $('gate');
  const forbidden = $('forbidden');
  const content = $('content');
  const statusEl = $('status');
  const intro = $('intro');
  const gateError = $('gate-error');
  const planSvg = $('plan') as unknown as SVGSVGElement;
  const satSvg = $('sat') as unknown as SVGSVGElement;
  const nf = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 1 });

  let clusters: Cluster[] = [];
  let units: Unit[] = [];
  let saved: Saved[] = [];
  let canEdit = false;
  let hasImage = false;
  let imageUrl = '';
  let imgW = 0;
  let imgH = 0;
  let clusterId = '';
  // What is on screen for the page being aligned: not saved until Save.
  let pairs: Pair[] = [];
  let pending: { house: string | null; plan: number[] } | null = null;
  let dirty = false;
  let showOverlay = false;
  const clusterOf = (id: string) => clusters.find((c) => c.id === id) ?? clusters[0];

  // ---- the two pictures: pan by dragging, zoom with the wheel or the buttons; a touch that does not move is a tap ----
  type View = { svg: SVGSVGElement; vb: number[]; full: () => number[]; onTap: (ux: number, uy: number, target: Element) => void };
  const views: Record<string, View> = {
    plan: { svg: planSvg, vb: [0, 0, 1, 1], full: () => [...clusterOf(clusterId).viewBox], onTap: (x, y, t) => tapPlan(x, y, t) },
    sat: { svg: satSvg, vb: [0, 0, 1, 1], full: () => [0, 0, imgW || 1, imgH || 1], onTap: (x, y) => tapImage(x, y) },
  };
  const unitsPerPx = (v: View) => { const r = v.svg.getBoundingClientRect(); return Math.max(v.vb[2] / (r.width || 1), v.vb[3] / (r.height || 1)); };
  const toUser = (v: View, e: { clientX: number; clientY: number }) => {
    const r = v.svg.getBoundingClientRect();
    const k = Math.max(v.vb[2] / r.width, v.vb[3] / r.height);
    return [v.vb[0] + (e.clientX - r.left - (r.width - v.vb[2] / k) / 2) * k, v.vb[1] + (e.clientY - r.top - (r.height - v.vb[3] / k) / 2) * k];
  };
  function zoomBy(name: string, f: number, cx?: number, cy?: number) {
    const v = views[name];
    const [x, y, w, ht] = v.vb;
    const nw = w / f;
    if (nw < 30 || nw > v.full()[2] * 1.6) return;
    const px = cx ?? x + w / 2, py = cy ?? y + ht / 2;
    v.vb = [px - (px - x) / f, py - (py - y) / f, nw, ht / f];
    paint();
  }
  for (const [name, v] of Object.entries(views)) {
    const ptrs = new Map<number, { x: number; y: number }>();
    let moved = false;
    let pinch = 0;
    // With the pointer captured, pointerup is addressed to the svg itself, so what was tapped is read when it went down.
    let down: Element | null = null;
    v.svg.addEventListener('wheel', (e) => { e.preventDefault(); const [ux, uy] = toUser(v, e); zoomBy(name, e.deltaY < 0 ? 1.15 : 1 / 1.15, ux, uy); }, { passive: false });
    v.svg.addEventListener('pointerdown', (e) => {
      v.svg.setPointerCapture(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 1) { moved = false; down = e.target as Element; } else pinch = 0;
    });
    v.svg.addEventListener('pointermove', (e) => {
      const p = ptrs.get(e.pointerId);
      if (!p) return;
      if (ptrs.size === 2) {
        ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const [a, b] = [...ptrs.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) { const [ux, uy] = toUser(v, { clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }); zoomBy(name, d / pinch, ux, uy); }
        pinch = d;
        moved = true;
        return;
      }
      const dx = e.clientX - p.x, dy = e.clientY - p.y;
      if (!moved && Math.hypot(dx, dy) < 4) return;
      moved = true;
      const k = unitsPerPx(v);
      v.vb = [v.vb[0] - dx * k, v.vb[1] - dy * k, v.vb[2], v.vb[3]];
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      v.svg.setAttribute('viewBox', v.vb.join(' '));
    });
    const end = (e: PointerEvent) => {
      const had = ptrs.has(e.pointerId);
      ptrs.delete(e.pointerId);
      if (had && !moved && ptrs.size === 0 && e.type === 'pointerup') { const [ux, uy] = toUser(v, e); v.onTap(ux, uy, down ?? (e.target as Element)); }
      if (moved && ptrs.size === 0) paint();
    };
    v.svg.addEventListener('pointerup', end);
    v.svg.addEventListener('pointercancel', end);
  }
  document.querySelectorAll<HTMLElement>('[data-z]').forEach((b) => b.addEventListener('click', () => {
    const name = b.getAttribute('data-z')!;
    const d = b.getAttribute('data-d');
    if (d === 'fit') { views[name].vb = views[name].full(); paint(); } else zoomBy(name, d === 'in' ? 1.4 : 1 / 1.4);
  }));
  window.addEventListener('resize', paint);

  // ---- tapping ----
  function tapPlan(ux: number, uy: number, target: Element) {
    const near = (target.closest('.al-home') as SVGElement | null)?.getAttribute('data-house') ?? null;
    const home = near ? units.find((x) => x.houseNo === near) : null;
    pending = home ? { house: home.houseNo, plan: [home.x, home.y] } : { house: null, plan: [Math.round(ux * 100) / 100, Math.round(uy * 100) / 100] };
    paint();
  }
  function tapImage(ux: number, uy: number) {
    if (!pending) { setHint('Tap a spot on the plan first, then the same spot here.', true); return; }
    if (pairs.length >= MAX_PAIRS) { setHint(`That is ${MAX_PAIRS} pairs, the most one page takes. Remove one first.`, true); return; }
    pairs = [...pairs, { house: pending.house, plan: pending.plan, image: [Math.round(ux * 10) / 10, Math.round(uy * 10) / 10] }];
    pending = null;
    dirty = true;
    paint();
  }
  function setHint(text: string, wait = false) {
    const el = $('hint');
    el.textContent = text;
    el.classList.toggle('hint--wait', wait);
  }

  // ---- drawing ----
  const fit = () => (pairs.length >= 2 ? fitSimilarity(pairs) : null);
  function pin(x: number, y: number, n: number, r: number, off: boolean) {
    const g = svgEl('g');
    g.append(svgEl('circle', { cx: x, cy: y, r }, `al-pin${off ? ' is-off' : ''}`));
    const t = svgEl('text', { x, y, 'font-size': r * 1.25 }, 'al-pin-label');
    t.textContent = String(n);
    g.append(t);
    return g;
  }
  function paintPlan(off: boolean[]) {
    const v = views.plan;
    v.svg.setAttribute('viewBox', v.vb.join(' '));
    const k = unitsPerPx(v);
    const c = clusterOf(clusterId);
    v.svg.replaceChildren();
    v.svg.append(svgEl('path', { d: c.plot }, 'sm-plot'));
    const paired = new Set(pairs.map((p) => p.house).filter(Boolean));
    for (const u of units.filter((x) => x.cluster === clusterId)) {
      const g = svgEl('g');
      g.append(svgEl('circle', { cx: u.x, cy: u.y, r: 7 * k, 'data-house': u.houseNo }, 'al-home'));
      if (!paired.has(u.houseNo)) { const t = svgEl('text', { x: u.x, y: u.y + 16 * k, 'font-size': 10 * k }, 'al-home-label'); t.textContent = u.houseNo.slice(2); g.append(t); }
      v.svg.append(g);
    }
    pairs.forEach((p, i) => v.svg.append(pin(p.plan[0], p.plan[1], i + 1, 9 * k, off[i])));
    if (pending) v.svg.append(svgEl('circle', { cx: pending.plan[0], cy: pending.plan[1], r: 13 * k }, 'al-pending'));
  }
  function paintSat(f: ReturnType<typeof fit>, off: boolean[]) {
    const v = views.sat;
    v.svg.setAttribute('viewBox', v.vb.join(' '));
    v.svg.replaceChildren();
    if (!imageUrl) return;
    const k = unitsPerPx(v);
    v.svg.append(svgEl('image', { href: imageUrl, x: 0, y: 0, width: imgW, height: imgH }));
    if (showOverlay && f && pairs.length >= MIN_PAIRS) {
      const m = planToImageMatrix(f);
      const g = svgEl('g', { transform: `matrix(${m.a} ${m.b} ${m.c} ${m.d} ${m.e} ${m.f})`, opacity: Number((document.getElementById('strength') as HTMLInputElement).value) / 100 });
      g.append(svgEl('path', { d: clusterOf(clusterId).plot }, 'al-overlay-line'));
      // The homes are drawn at a fixed size on screen: the plan's scale on the image would make them tiny or huge.
      const s = Math.hypot(m.a, m.b);
      for (const u of units.filter((x) => x.cluster === clusterId)) g.append(svgEl('circle', { cx: u.x, cy: u.y, r: (4 * k) / s }, 'al-overlay-home'));
      v.svg.append(g);
    }
    pairs.forEach((p, i) => v.svg.append(pin(p.image[0], p.image[1], i + 1, 9 * k, off[i])));
  }
  function paintCard(f: ReturnType<typeof fit>, off: boolean[]) {
    const card = $('fit-card');
    const old = saved.find((s) => s.cluster === clusterId);
    const fitOk = !!f && pairs.length >= MIN_PAIRS;
    const rows = pairs.map((p, i) => {
      const li = h('li', off[i] ? 'is-off' : '', undefined, h('span', 'n', String(i + 1)), h('span', 'what', p.house ? `Home ${p.house}` : `Plan spot ${nf.format(p.plan[0])}, ${nf.format(p.plan[1])}`));
      if (fitOk) li.append(h('span', 'off', `off by ${nf.format(f!.residuals[i])} units${off[i] ? ' (check this one)' : ''}`));
      if (canEdit) { const b = h('button', 'button button--outline button--small', 'Remove'); b.setAttribute('type', 'button'); b.addEventListener('click', () => { pairs = pairs.filter((_, j) => j !== i); dirty = true; paint(); }); li.append(b); }
      return li;
    });
    const fitLines = fitOk
      ? h('dl', 'fit-grid', undefined,
        h('dt', '', 'Scale'), h('dd', '', `${nf.format(f!.scale)} plan units per image pixel`),
        h('dt', '', 'Rotation'), h('dd', '', `${nf.format(f!.rotation)}° (the plan page against the image, clockwise)`),
        h('dt', '', 'Typical error'), h('dd', '', `${nf.format(f!.rms)} plan units`))
      : h('p', 'hint', pairs.length ? `Add ${Math.max(0, MIN_PAIRS - pairs.length)} more pair${MIN_PAIRS - pairs.length === 1 ? '' : 's'} to fit this page.` : 'No pairs yet for this page.');
    const kids: Kid[] = [h('h2', '', `Page ${clusterId}`), old && !dirty ? h('p', 'hint', `Saved: ${old.pairs.length} pairs, typical error ${old.rms == null ? '–' : nf.format(old.rms)} plan units.`) : null, fitLines, rows.length ? h('ul', 'pairs', undefined, ...rows) : null];
    if (dirty) kids.push(h('p', 'dirty', 'Not saved yet.'));
    if (canEdit) {
      const save = h('button', 'button button--primary', 'Save this page') as HTMLButtonElement;
      save.setAttribute('type', 'button');
      save.disabled = !fitOk || !dirty;
      save.addEventListener('click', () => void saveAlignment());
      const undo = h('button', 'button button--outline', 'Discard changes') as HTMLButtonElement;
      undo.setAttribute('type', 'button');
      undo.disabled = !dirty;
      undo.addEventListener('click', () => { pairs = (saved.find((s) => s.cluster === clusterId)?.pairs ?? []).map((p) => ({ ...p })); pending = null; dirty = false; paint(); });
      const clear = h('button', 'button button--danger-outline', 'Remove this alignment');
      clear.setAttribute('type', 'button');
      clear.hidden = !old;
      clear.addEventListener('click', () => void clearAlignment());
      kids.push(h('div', 'actions', undefined, save, undo, clear));
    }
    card.replaceChildren(...(kids.filter(Boolean) as Node[]));
  }
  function paint() {
    const f = fit();
    // A pair is "off" when it is well beyond the typical error of the others (and at least a little off in absolute terms).
    const off = pairs.map((_, i) => !!f && pairs.length > MIN_PAIRS && f.residuals[i] > Math.max(2 * f.rms, 6));
    $('clusters').querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-c') === clusterId)));
    $('plan-name').textContent = clusterId;
    paintPlan(off);
    paintSat(f, off);
    paintCard(f, off);
    ($('overlay') as HTMLButtonElement).setAttribute('aria-pressed', String(showOverlay));
    $('overlaybar').hidden = !(hasImage && f && pairs.length >= MIN_PAIRS);
    if (!hasImage) setHint(canEdit ? 'Upload a satellite image to start.' : 'No satellite image has been uploaded yet.');
    else if (pending) setHint('Now tap the same spot on the satellite image.', true);
    else setHint(pairs.length ? 'Tap another home or spot on the plan to add a pair.' : 'Tap a home on the plan to start.');
  }

  // ---- saving ----
  const errToast = (err: unknown) => {
    if (err instanceof StaffAuthError) { if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.'); else showForbidden(); } else showToast('Could not save. Try again.');
  };
  async function saveAlignment() {
    const done = busyForPress('Saving…');
    try {
      const { status, data: out } = await staffFetch('/api/site-map-admin/alignment', { method: 'POST', body: { cluster: clusterId, pairs } });
      if (status !== 200) { showToast(out?.error ?? 'Could not save. Try again.'); return; }
      showToast(`Saved the alignment of ${clusterId}.`);
      await loadAlignments();
      dirty = false;
      paint();
    } catch (err) { errToast(err); } finally { done(); }
  }
  async function clearAlignment() {
    if (!window.confirm(`Remove the satellite alignment of ${clusterId}? The member map goes back to its default placement if a page of its sheet has none.`)) return;
    const done = busyForPress('Removing…');
    try {
      const { status, data: out } = await staffFetch('/api/site-map-admin/alignment', { method: 'POST', body: { cluster: clusterId, clear: true } });
      if (status !== 200) { showToast(out?.error ?? 'Could not remove it. Try again.'); return; }
      showToast(`Removed the alignment of ${clusterId}.`);
      await loadAlignments();
      selectCluster(clusterId);
    } catch (err) { errToast(err); } finally { done(); }
  }

  // The image is shrunk and sent as a JPEG: a screenshot is far larger than the alignment needs, and the request is limited.
  async function shrink(file: File): Promise<string> {
    const url = URL.createObjectURL(file);
    try {
      const img = await new Promise<HTMLImageElement>((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('not an image')); i.src = url; });
      const k = Math.min(1, 2400 / img.naturalWidth);
      const c = document.createElement('canvas');
      c.width = Math.round(img.naturalWidth * k);
      c.height = Math.round(img.naturalHeight * k);
      c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
      return c.toDataURL('image/jpeg', 0.88);
    } finally { URL.revokeObjectURL(url); }
  }
  $('upload').addEventListener('click', () => $('file').click());
  $('file').addEventListener('change', async () => {
    const input = $('file') as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    if (hasImage && !window.confirm('Replacing the image means every saved alignment no longer matches it, and the pairs must be tapped again. Continue?')) return;
    const done = busyForPress('Uploading…');
    try {
      const dataUrl = await shrink(file);
      const { status, data: out } = await staffFetch('/api/site-map-admin/satellite', { method: 'POST', body: { image: dataUrl } });
      if (status !== 200) { showToast(out?.error ?? 'Could not upload that image.'); return; }
      showToast('Image uploaded.');
      await loadImage();
      views.sat.vb = views.sat.full();
      paint();
    } catch (err) { if (err instanceof StaffAuthError) errToast(err); else showToast('Could not read that image.'); } finally { done(); }
  });
  $('overlay').addEventListener('click', () => { showOverlay = !showOverlay; paint(); });
  $('strength').addEventListener('input', paint);

  // ---- loading ----
  function selectCluster(id: string) {
    clusterId = id;
    pairs = (saved.find((s) => s.cluster === id)?.pairs ?? []).map((p) => ({ ...p }));
    pending = null;
    dirty = false;
    views.plan.vb = views.plan.full();
    views.sat.vb = views.sat.full();
    paint();
  }
  async function loadAlignments() {
    const { status, data: body } = await staffFetch('/api/site-map-admin/alignment');
    if (status !== 200) throw new Error(`the server answered ${status}`);
    saved = body.alignments as Saved[];
    hasImage = !!body.hasImage;
    canEdit = !!body.canEdit;
    $('imagebar').hidden = !canEdit;
    $('image-note').textContent = hasImage ? 'One is uploaded; uploading another replaces it.' : 'None uploaded yet.';
  }
  async function loadImage() {
    const { status, data: body } = await staffFetch('/api/site-map-admin/satellite');
    if (status === 404) { hasImage = false; imageUrl = ''; return; }
    if (status !== 200) throw new Error(`the server answered ${status}`);
    imageUrl = body.image as string;
    await new Promise<void>((res) => { const i = new Image(); i.onload = () => { imgW = i.naturalWidth; imgH = i.naturalHeight; res(); }; i.onerror = () => res(); i.src = imageUrl; });
    hasImage = true;
    $('image-note').textContent = 'One is uploaded; uploading another replaces it.';
  }
  let firstLoad = true;
  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (firstLoad) { statusEl.hidden = false; statusEl.textContent = 'Loading…'; }
    try {
      const { status, data: map } = await staffFetch('/api/site-map-admin/overview');
      if (status === 403) { showForbidden(); return; }
      if (status !== 200) throw new Error(`the server answered ${status}`);
      clusters = map.clusters as Cluster[];
      units = (map.units as Unit[]).map((u) => ({ houseNo: u.houseNo, cluster: u.cluster, x: u.x, y: u.y }));
      await loadAlignments();
      if (hasImage) await loadImage();
      statusEl.hidden = true;
      intro.textContent = 'Lay each plan page over the satellite image by pairing points. The member map uses this to place the pages against each other.';
      content.hidden = false;
      $('clusters').replaceChildren(...clusters.map((c) => { const b = h('button', '', c.id); b.setAttribute('type', 'button'); b.setAttribute('data-c', c.id); b.addEventListener('click', () => { if (dirty && !window.confirm('This page has changes that are not saved. Leave them?')) return; selectCluster(c.id); }); return b; }));
      selectCluster(clusterId && clusters.some((c) => c.id === clusterId) ? clusterId : clusters[0].id);
      firstLoad = false;
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      } else {
        console.error('[site-map-align] load failed', err);
        statusEl.hidden = false;
        statusEl.textContent = `Failed to load (${err instanceof Error ? err.message : 'unknown error'}). Try refreshing.`;
      }
    }
  }
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    firstLoad = true;
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
