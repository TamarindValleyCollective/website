      if (!l.target && !showOthers) continue;
      const base = clusterOf(l.cluster).baseSize;
      const [x, y] = planOfGeo(l.moves ? withTune(l.fit) : l.fit, lat, lng);
      const unit = l.units.find((u) => inside(footprintPoints(u, base), x, y) || (plotShapeOf(u) ? inside(plotShapeOf(u)!, x, y) : false));
