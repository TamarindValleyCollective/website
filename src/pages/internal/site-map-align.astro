  // ---- loading ----
  // The fine-tune a saved page carries: how its stored fit differs from the fit its own pairs give.
  function tuneOf(s: Saved | undefined): Tune {
    if (!s) return { ...NO_TUNE };
    if (s.pairs.length < 2) { const pb = s.houses ? pageBase() : null; return pb ? { ...tuneBetween(pb, s, pb.pivot) } : { ...NO_TUNE }; }
    const f0 = { lat: s.originLat, lng: s.originLng };
    const base = fitSimilarity(s.pairs.map((p) => ({ plan: p.plan, image: geoToLocal(f0, p.geo as [number, number]) })), s.lockedScale ?? undefined);
    return base ? { ...tuneBetween(base, s, pivotOf(s.pairs, f0)) } : { ...NO_TUNE };
  }
  // The part of the plan page the target covers: the whole page, or the group's homes with a margin.
  function viewFor(): number[] {
    const g = targetGroup();
    if (!g) return [...clusterOf(clusterId).viewBox];
    const mine = targetUnits();
    if (!mine.length) return [...clusterOf(clusterId).viewBox];
    const xs = mine.map((u) => u.x), ys = mine.map((u) => u.y);
    const pad = 90;
    const w = Math.max(...xs) - Math.min(...xs) + 2 * pad, h2 = Math.max(...ys) - Math.min(...ys) + 2 * pad;
    return [Math.min(...xs) - pad, Math.min(...ys) - pad, Math.max(w, 200), Math.max(h2, 200)];
  }
  function selectTarget(id: string, gkey: string | null) {
    clusterId = id;
    groupKey = gkey && groups.some((g) => g.key === gkey) ? gkey : null;
    const row = savedTarget();
    pairs = (row?.pairs ?? []).map((p) => ({ ...p }));
    savedTune = tuneOf(row);
    tune = { ...savedTune };
    // A group saved with its size free stays free.
    keepSize = !(row && groupKey && row.lockedScale == null);
    pending = null;
    dirty = false;
    vb = viewFor();
    paint();
  }
  // The group chips of the page on show, with a tick on the ones that have an alignment.
  function paintGroups() {
    const here = groups.filter((g) => g.cluster === clusterId);
    const box = $('groups');
    const chips: HTMLElement[] = [];
    const whole = h('button', '', 'Whole page');
    whole.setAttribute('type', 'button');
    whole.setAttribute('aria-pressed', String(!groupKey));
    whole.addEventListener('click', () => switchTarget(clusterId, null));
    chips.push(whole);
    for (const g of here) {
      const b = h('button', '', `${rangeLabel(g.houses)}${savedFit(g) ? ' ✓' : ''}`);
      b.setAttribute('type', 'button');
      b.setAttribute('aria-pressed', String(groupKey === g.key));
      b.title = `Homes ${g.houses.map((x) => x.slice(2)).join(', ')}`;
      b.addEventListener('click', () => switchTarget(clusterId, g.key));
      chips.push(b);
    }
    box.replaceChildren(...chips);
    const note = $('group-note');
    note.replaceChildren();
    if (groupKey) {
      const lock = referenceScale();
      note.append(`Aligning homes ${rangeLabel(targetGroup()?.houses ?? [])} on their own: they share walls, so they move together. `);
      if (lock) {
        const label = h('label', 'line');
        const box2 = document.createElement('input');
        box2.type = 'checkbox';
        box2.checked = keepSize;
        box2.addEventListener('change', () => { keepSize = box2.checked; dirty = true; paint(); });
        label.append(box2, ' Keep every home the same size (then two pairs are enough)');
        note.append(label);
      } else note.append('No other alignment is accurate enough yet to set the size from, so this one fits its own size (three pairs).');
    } else note.textContent = 'Aligning the whole plan page: its lines (roads, boundaries) and the homes not aligned as a group follow this.';
  }
  function switchTarget(id: string, gkey: string | null) {
    if (dirty && !window.confirm('This has changes that are not saved. Leave them?')) return;
    selectTarget(id, gkey);
  }
  async function loadAlignments() {
    const { status, data: body } = await staffFetch('/api/site-map-admin/alignment');
    if (status !== 200) throw new Error(`the server answered ${status}`);
    saved = [...(body.alignments as Saved[]), ...((body.groups ?? []) as Saved[])];
    canEdit = !!body.canEdit;
  }
  let firstLoad = true;
  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (firstLoad) { statusEl.hidden = false; statusEl.textContent = 'Loading…'; }
    try {
      const { status, data: plan } = await staffFetch('/api/site-map-admin/overview');
      if (status === 403) { showForbidden(); return; }
      if (status !== 200) throw new Error(`the server answered ${status}`);
      clusters = plan.clusters as Cluster[];
      units = (plan.units as Unit[]).map((u) => ({ houseNo: u.houseNo, cluster: u.cluster, shape: u.shape, x: u.x, y: u.y, rotation: u.rotation, mirrorX: u.mirrorX, mirrorY: u.mirrorY }));
      groups = detectGroups(units, Object.fromEntries(clusters.map((c) => [c.id, c.baseSize])));
      await loadAlignments();
      statusEl.hidden = true;
      intro.textContent = 'Lay each plan page over the satellite map by pairing points. The member map uses this to place the pages against each other.';
      content.hidden = false;
      $('clusters').replaceChildren(...clusters.map((c) => { const b = h('button', '', c.id); b.setAttribute('type', 'button'); b.setAttribute('data-c', c.id); b.addEventListener('click', () => switchTarget(c.id, null)); return b; }));
      selectTarget(clusterId && clusters.some((c) => c.id === clusterId) ? clusterId : clusters[0].id, groupKey);
      firstLoad = false;
      void startMap().then(() => paint());
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      } else {
        console.error('[site-map-align] load failed', err);
        statusEl.hidden = false;
        statusEl.textContent = `Failed to load (${err instanceof Error ? err.message : 'unknown error'}). Try refreshing.`;
      }
    }
  }
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined' || !google.accounts) return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined' && google.accounts) google.accounts.id.disableAutoSelect();
    firstLoad = true;
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
