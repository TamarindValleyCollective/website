  }
  async function clearAlignment() {
    if (!window.confirm(linesMode ? `Remove the placement of ${targetName()}? They go back to following their homes (or their page).` : groupKey ? `Remove the placement of ${targetName()}? Those homes go back to their page's placement on the member map.` : `Remove the placement of ${targetName()}? The member map goes back to its default placement for it.`)) return;
    const done = busyForPress('Removing…');
    try {
      const g = targetGroup();
      const key = g ? savedFit(g)?.key : undefined;
      const { status, data: out } = await staffFetch('/api/site-map-admin/alignment', { method: 'POST', body: linesMode ? { lineGroupKey: lineRowFor(clusterId, lineKey)?.key ?? lineKey, clear: true } : g ? { groupKey: key ?? groupKey, clear: true } : { cluster: clusterId, clear: true } });
      if (status !== 200) { showToast(out?.error ?? 'Could not remove it. Try again.'); return; }
      showToast(`Removed the placement of ${targetName()}.`);
      await loadAlignments();
      tune = { ...NO_TUNE };
      render();
      paintPanel();
    } catch (err) { errToast(err); } finally { done(); }
  }

  // ---- the map ----
  const CENTER_KEY = 'tvc-site-map-align-view';
  function loadGoogleMaps(): Promise<void> {
    if ((window as any).google?.maps?.Map) return Promise.resolve();
    return new Promise((res, rej) => {
      (window as any).__tvcMapsReady = () => res();
      (window as any).gm_authFailure = () => { $('nokey').hidden = false; $('nokey').textContent = 'Google refused the map key. Check that the key allows the Maps JavaScript API and this site, then reload.'; };
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(MAPS_KEY)}&v=weekly&callback=__tvcMapsReady`;
      s.async = true;
      s.onerror = () => rej(new Error('The Google map could not be loaded.'));
      document.head.append(s);
    });
  }
  async function startMap() {
    if (map) return;
    if (!MAPS_KEY) { $('nokey').hidden = false; $('gmap').hidden = true; return; }
    try { await loadGoogleMaps(); } catch (err) { $('nokey').hidden = false; $('nokey').textContent = err instanceof Error ? err.message : 'The Google map could not be loaded.'; return; }
    let start = { lat: 20.5937, lng: 78.9629, zoom: 5 }; // India, until the farm has been found
    try { const kept = JSON.parse(localStorage.getItem(CENTER_KEY) ?? 'null'); if (kept && Number.isFinite(kept.lat) && Number.isFinite(kept.lng)) start = kept; } catch { /* nothing kept */ }
    if (saved[0] && start.zoom < 10) start = { lat: saved[0].originLat, lng: saved[0].originLng, zoom: 18 };
    map = new google.maps.Map($('gmap'), { center: { lat: start.lat, lng: start.lng }, zoom: start.zoom, mapTypeId: 'satellite', tilt: 0, rotateControl: false, streetViewControl: false, mapTypeControl: false, gestureHandling: 'greedy', clickableIcons: false, maxZoom: 21 });
    map.addListener('bounds_changed', () => applyMatrices());
    map.addListener('idle', () => { const c = map.getCenter(); try { localStorage.setItem(CENTER_KEY, JSON.stringify({ lat: c.lat(), lng: c.lng(), zoom: map.getZoom() })); } catch { /* not remembered */ } render(); });
    wireMap();
    fadeSatellite();
    new ResizeObserver(() => schedule(true)).observe($('gmap'));
  }
  // Show what is picked: the map goes to its homes (zoomed to them if they are far off screen).
  function focusTarget(force = true) {
    const f = liveFit();
    if (!map || !f) return;
    const pts = (linesMode ? lineUnits(clusterId, lineKey) : targetUnits()).map((u) => geoOfPlan(f, u.x, u.y));
    if (!pts.length) return;
    const north = Math.max(...pts.map((q) => q[0])), south = Math.min(...pts.map((q) => q[0])), east = Math.max(...pts.map((q) => q[1])), west = Math.min(...pts.map((q) => q[1]));
    const r = $('gmap').getBoundingClientRect();
    const [ex, ey] = pixelOf((north + south) / 2, (east + west) / 2);
    const onScreen = ex > 40 && ex < r.width - 40 && ey > 40 && ey < r.height - 40 && map.getZoom() >= 17;
    if (force || !onScreen) {
      map.fitBounds({ north, south, east, west }, { top: 80, right: 80, bottom: 80, left: 80 });
      // a single home would zoom in past usefulness
      google.maps.event.addListenerOnce(map, 'idle', () => { if (map.getZoom() > 20) map.setZoom(20); });
    }
  }
  $('goto-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const m = ($('goto') as HTMLInputElement).value.match(/(-?\d+(?:\.\d+)?)\s*[,\s]\s*(-?\d+(?:\.\d+)?)/);
    if (!m || !map) { showToast('Type or paste a latitude and longitude, like 29.12345, 79.12345.'); return; }
    map.setCenter({ lat: Number(m[1]), lng: Number(m[2]) });
    map.setZoom(18);
  });
  $('others').addEventListener('change', () => { showOthers = ($('others') as HTMLInputElement).checked; render(); });
  $('adjust').addEventListener('change', () => { adjustOn = ($('adjust') as HTMLInputElement).checked; });
  // The slider fades the satellite image itself (the plan stays at full strength over a plain white ground), so the plan can be
  // seen on its own, or the buildings underneath.
  const fadeSatellite = () => { $('gmap').style.opacity = String(Number(($('strength') as HTMLInputElement).value) / 100); };
  $('strength').addEventListener('input', fadeSatellite);
  window.addEventListener('resize', () => schedule(true));

  // ---- loading ----
  function switchTarget(id: string, gkey: string | null, focus = true, lines: string | null = null) {
    if (isDirty() && !window.confirm('This has changes that are not saved. Leave them?')) return;
    clusterId = id;
    groupKey = gkey && groups.some((g) => g.key === gkey) ? gkey : null;
    linesMode = lines !== null && !groupKey;
    if (lines !== null) lineKey = lines;
    tune = { ...NO_TUNE };
    if (draft && (draft.cluster !== id || groupKey)) draft = null;
    render();
    paintPanel();
    if (focus) focusTarget();
  }
  async function loadAlignments() {
    const { status, data: body } = await staffFetch('/api/site-map-admin/alignment');
    if (status !== 200) throw new Error(`the server answered ${status}`);
    saved = [...(body.alignments as Saved[]), ...((body.groups ?? []) as Saved[])];
    lineRows = ((body.lines ?? []) as Saved[]).map((r) => ({ ...r, lines: true }));
    canEdit = !!body.canEdit;
  }
  let firstLoad = true;
  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (firstLoad) { statusEl.hidden = false; statusEl.textContent = 'Loading…'; }
    try {
      const { status, data: plan } = await staffFetch('/api/site-map-admin/overview');
      if (status === 403) { showForbidden(); return; }
      if (status !== 200) throw new Error(`the server answered ${status}`);
      clusters = plan.clusters as Cluster[];
      units = (plan.units as Unit[]).map((u) => ({ houseNo: u.houseNo, cluster: u.cluster, shape: u.shape, x: u.x, y: u.y, rotation: u.rotation, mirrorX: u.mirrorX, mirrorY: u.mirrorY }));
      lineSetCache.clear();
      groups = detectGroups(units, Object.fromEntries(clusters.map((c) => [c.id, c.baseSize])));
      await loadAlignments();
      statusEl.hidden = true;
      intro.textContent = 'Put the plan where it is on the satellite map.';
      content.hidden = false;
      $('clusters').replaceChildren(...clusters.map((c) => { const b = h('button', '', c.id); b.setAttribute('type', 'button'); b.setAttribute('data-c', c.id); b.addEventListener('click', () => switchTarget(c.id, null)); return b; }));
      if (!clusterId || !clusters.some((c) => c.id === clusterId)) clusterId = clusters[0].id;
      firstLoad = false;
      paintPanel();
      await startMap();
      render();
      paintPanel();
      focusTarget();
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      } else {
        console.error('[site-map-align] load failed', err);
        statusEl.hidden = false;
        statusEl.textContent = `Failed to load (${err instanceof Error ? err.message : 'unknown error'}). Try refreshing.`;
      }
    }
  }
  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }
  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }
  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }
  function renderSignInButton() {
    if (typeof google === 'undefined' || !google.accounts) return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: (window as any).tvcGsiTheme?.() ?? 'outline', size: 'large' });
  }
  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined' && google.accounts) google.accounts.id.disableAutoSelect();
    firstLoad = true;
    showGate();
  }
  $('use-different-account').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
