---
// Align to satellite (internal): put each plan page, and each group of homes that share walls, where it really is on Google's live
// satellite map. One view: the satellite map with the homes drawn on it as their real shapes (with numbers), the way members see
// them. Click a home to pick its group; drag the group onto its foundations (Shift and drag turns it); the buttons nudge it a step at
// a time, and a group can be snapped to a neighbouring group. A page that has no placement yet is dropped on the map's middle to be
// dragged into place; a group starts where its page puts it. What is saved is the placement itself (scale, turn and position,
// netlify/functions/site-map-admin.mts); the member map joins the pages and places the groups from it (scripts/lib/site-map-align.mjs).
// No imagery is stored: the map is Google's, drawn live with the browser key PUBLIC_GOOGLE_MAPS_API_KEY (restricted to our sites).
// Same shell and sign-in as the Map page. Everything the server returns is placed with textContent only.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
import '../../styles/site-map.css';
---

<StaffLayout title="Align map" description="Put the plan where it is on the satellite map." current="site-map">
  <section class="align section wrapper">
    <div class="al-title">
      <h1>Align to satellite</h1>
      <a href="/internal/site-map/">&larr; Back to the Map</a>
    </div>
    <p id="intro" class="hint">Sign in to put the plan where it is on the satellite map.</p>

    <SignInGate forbiddenWhat="the Map tool" />

    <p id="status" class="hint" hidden></p>

    <div id="content" hidden>
      <div class="al-grid">
        <aside class="al-panel" aria-label="Controls">
          <div class="al-block">
            <div class="segmented" id="clusters" role="group" aria-label="Plan page"></div>
            <div class="segmented al-groups" id="groups" role="group" aria-label="Group of homes"></div>
            <div class="segmented al-groups" id="line-groups" role="group" aria-label="Group of lines"></div>
          </div>

          <p id="hint" class="hint al-note" role="status"></p>
          <p id="nokey" class="hint hint--wait" hidden>The Google Maps key is not set. Put it in <code>PUBLIC_GOOGLE_MAPS_API_KEY</code> (a browser key limited to this site) and reload.</p>

          <div class="al-block" id="place" hidden>
            <button type="button" class="button button--primary" id="place-btn">Place the plan here</button>
          </div>

          <section class="tune" id="tune" hidden aria-label="Move and turn the plan on the map">
            <div class="tune-row">
              <span class="k">Move</span>
              <div class="dpad" id="tune-move" role="group" aria-label="Move"></div>
              <div class="tune-col">
                <span class="k">Turn</span>
                <div class="pair" id="tune-turn" role="group" aria-label="Turn"></div>
                <span class="k">Size</span>
                <div class="pair" id="tune-size" role="group" aria-label="Resize"></div>
              </div>
            </div>
            <div class="tune-row">
              <span class="k">Step</span>
              <div class="segmented" id="tune-step" role="group" aria-label="Size of each nudge"></div>
              <button type="button" class="button button--outline" id="tune-reset">Reset</button>
            </div>
            <div class="tune-row" id="tune-snap" hidden>
              <span class="k">Snap to</span>
              <div class="pair" id="tune-snap-buttons" role="group" aria-label="Snap to a neighbouring group"></div>
            </div>
            <p class="hint" id="tune-readout" role="status"></p>
          </section>

          <section class="al-block al-state" id="fit-card" aria-live="polite"></section>
          <div class="al-actions" id="actions"></div>

          <div class="al-block al-views">
            <label class="line"><input type="checkbox" id="others" checked /> Show the other layouts (white)</label>
            <label class="line"><input type="checkbox" id="adjust" checked /> Drag the plan to adjust (Shift turns)</label>
            <label class="line" title="Fade the satellite image (to white) to see the plan on its own, or bring it back to see the buildings">Satellite image <input type="range" id="strength" min="0" max="100" value="100" aria-label="Satellite image visibility" /></label>
          </div>

          <form class="al-goto" id="goto-form">
            <label class="line">Go to <input type="text" id="goto" placeholder="29.12345, 79.12345" autocomplete="off" aria-label="Latitude and longitude" /></label>
            <button type="submit" class="button button--outline">Go</button>
          </form>
        </aside>

        <div class="al-mapwrap sm-stage">
          <div id="gmap" class="al-gmap" aria-label="Satellite map"></div>
          <svg id="ov" class="al-ov" aria-hidden="true"></svg>
        </div>
      </div>
    </div>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  /* One screen: the satellite map is the work surface and takes the room; the controls are a slim column beside it. */
  #staff-main .align.section { padding-top: 6px; padding-bottom: 12px; }
  .align:has(#content:not([hidden])) #intro { display: none; }
  .align .al-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; }
  .align h1 { font-size: var(--text-2xl); margin: 0 0 4px; }
  .align .al-title a { font-size: var(--text-sm); }
  .align .hint--wait { color: var(--tvc-orange-text); }
  .align .al-note { margin: 4px 0; }

  .align .al-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .align .al-mapwrap { position: relative; min-height: 420px; height: 60dvh; border-radius: var(--radius); }
  .align .al-gmap { position: absolute; inset: 0; z-index: 0; }
  .align .al-ov { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; pointer-events: none; }
  .align .al-ov * { pointer-events: none; }
  .align .al-panel { display: flex; flex-direction: column; gap: 8px; min-width: 0; }

  @media (min-width: 1100px) {
    /* --al-top is set by the page from where the grid really starts, so the grid fills the window and nothing is below the fold. */
    .align .al-grid { grid-template-columns: minmax(300px, 340px) minmax(0, 1fr); align-items: stretch; height: calc(100dvh - var(--al-top, 130px)); min-height: 520px; }
    .align .al-panel { overflow-y: auto; min-height: 0; padding-right: 4px; }
    .align .al-mapwrap { height: auto; min-height: 0; }
  }

  .align .segmented { flex-wrap: wrap; }
  .align .segmented button { min-height: 28px; padding: 0 9px; font-size: var(--text-sm); }
  .align .al-groups { margin-top: 6px; }
  .align .line { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: var(--text-sm); }
  .align .al-views { display: grid; gap: 6px; }
  .align .al-goto { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .align .al-goto input[type='text'] { width: 170px; }

  /* The plan as it is drawn on the map: the picked group strong, everything else white and fainter. */
  .align .al-layer:not(.is-target) { opacity: 0.6; }
  .align .al-layer .sm-plot { stroke: var(--tvc-white); stroke-width: 1.2; }
  .align .al-layer .sm-plot { vector-effect: non-scaling-stroke; }
  .align .al-layer.is-target .sm-plot { stroke: var(--tvc-orange-light); stroke-width: 4px; }
  /* a dark outline under the picked lines, so they stand out on any satellite picture */
  .align .al-halo { fill: none; stroke: var(--tvc-green-dark); stroke-width: 8px; stroke-linecap: round; stroke-linejoin: round; opacity: 0.85; vector-effect: non-scaling-stroke; }
  .align .al-ov .sm-plotfill { opacity: 0.35; }

  .align .tune { display: grid; gap: 8px; padding: 10px; border: 1px solid var(--tvc-line); border-radius: var(--radius); background: var(--tvc-white); }
  .align .tune-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .align .tune-col { display: grid; grid-template-columns: auto auto; gap: 6px 8px; align-items: center; }
  .align .tune .k { color: var(--tvc-ink-soft); font-size: var(--text-sm); }
  .align .tune .hint { margin: 0; }
  .align .tune .button { min-width: 34px; padding: 0 10px; }
  .align .tune .dpad { display: grid; grid-template-columns: repeat(3, 32px); grid-auto-rows: 32px; gap: 3px; }
  .align .tune .dpad .button { width: 32px; min-width: 0; height: 32px; min-height: 0; padding: 0; }
  .align .tune .pair { display: flex; gap: 4px; }

  .align .al-state { font-size: var(--text-sm); color: var(--tvc-ink-soft); }
  .align .al-state strong { color: var(--tvc-ink); }
  .align .al-state .dirty { color: var(--tvc-orange-text); margin: 4px 0 0; }
  .align .al-actions { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, showToast, staffFetch } from '../../../scripts/lib/staff-client.mjs';
  import { busyForPress } from '../../../scripts/lib/busy.mjs';
  import { NO_TUNE, applyTune, geoToLocal, imageToPlan, isTuned, localToGeo, planToLocal, sharedWalls, snapShift, snapToLines } from '../../../scripts/lib/site-map-align.mjs';
  import { SVG_NS, badgeEl, outlineEl, plotFillEl, shapeDefs, unitGroup } from '../../../scripts/lib/site-map-draw.mjs';
  import { assignLines, pathOfLines, plotOutline } from '../../../scripts/lib/site-map.mjs';
  import { footprintPoints } from '../../../scripts/lib/site-map-snap.mjs';
  import { detectGroups, savedFor } from '../../../scripts/lib/site-map-groups.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
  const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // text only, never HTML
  type Kid = Node | string | null | undefined | false;
  function h(tag: string, cls = '', text?: string, ...kids: Kid[]): HTMLElement {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text !== undefined) el.textContent = text;
    for (const k of kids) if (k) el.append(k);
    return el;
  }
  const svgEl = (tag: string, attrs: Record<string, string | number> = {}, cls = '') => {
    const e = document.createElementNS(SVG_NS, tag);
    if (cls) e.setAttribute('class', cls);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  };

  type Unit = { houseNo: string; cluster: string; shape: string; x: number; y: number; rotation: number; mirrorX: boolean; mirrorY: boolean };
  type Cluster = { id: string; baseSize: number; viewBox: number[]; plot: string };
  type Group = { key: string; cluster: string; houses: string[] };
  type Saved = { key: string; houses: string[] | null; cluster: string; a: number; b: number; tx: number; ty: number; scale: number; rotation: number; originLat: number; originLng: number; rms: number | null; updatedAt: string | null; lines?: boolean };
  // A placement of a plan page's coordinates on the ground: plan = c * local + d (see site-map-align.mjs), around a reference point.
  type Base = { a: number; b: number; tx: number; ty: number; frame: { lat: number; lng: number }; pivot: [number, number] };
  type Tune = { east: number; north: number; rotate: number; scale: number };
  // `target` is drawn strong; `moves` follows the hand adjustment (the picked group; or, for the whole page, the page and every group on it).
  type Layer = { key: string; fit: Base; cluster: string; units: Unit[]; lines: string | null; polys?: [number, number][][]; lineKey?: string; target: boolean; moves: boolean };

  const gate = $('gate');
  const forbidden = $('forbidden');
  const content = $('content');
  const statusEl = $('status');
  const intro = $('intro');
  const gateError = $('gate-error');
  const nf = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 1 });

  let clusters: Cluster[] = [];
  let units: Unit[] = [];
  let groups: Group[] = [];
  let saved: Saved[] = [];
  let lineRows: Saved[] = []; // saved placements of groups of lines (`houses` is null for a page's other lines)
  let canEdit = false;
  let clusterId = '';
  let groupKey: string | null = null; // null = the whole plan page
  // A group of the page's lines (the white boundaries) on its own, placed and adjusted like a group of homes: the lines along one group's
  // plots, or the page's other lines ('other').
  let linesMode = false;
  let lineKey = 'other';
  // What is being moved is the saved placement (or the page's, for a group not placed yet) plus this hand adjustment, not saved until Save.
  let tune: Tune = { ...NO_TUNE };
  // A page with no placement yet, dropped on the map's middle to be dragged into place (not saved until Save).
  let draft: { cluster: string; row: Saved } | null = null;
  let showOthers = true;
  let adjustOn = true;
  let step = 'medium';
  const plotShapes = new Map<string, [number, number][] | null>(); // each home's plot outline (plan coordinates), for hit testing
  const clusterOf = (id: string) => clusters.find((c) => c.id === id) ?? clusters[0];
  const targetGroup = () => (groupKey ? groups.find((g) => g.key === groupKey) ?? null : null);
  const unitsOf = (g: Group) => units.filter((u) => u.cluster === g.cluster && g.houses.includes(u.houseNo));
  const targetUnits = () => { if (linesMode) return []; const g = targetGroup(); return g ? unitsOf(g) : units.filter((u) => u.cluster === clusterId); };
  const pageUnits = (id: string) => units.filter((u) => u.cluster === id);
  const groupOfHome = () => Object.fromEntries(groups.flatMap((g) => g.houses.map((x) => [x, g.key])));
  const lineSetCache = new Map<string, Map<string, [number, number][][]>>();
  // The page's open lines (the white boundaries), split into the stretches along each group's plots and the rest, in plan coordinates.
  const lineSets = (id: string) => { let m = lineSetCache.get(id); if (!m) { m = assignLines(clusterOf(id).plot, pageUnits(id), groupOfHome()) as Map<string, [number, number][][]>; lineSetCache.set(id, m); } return m; };
  const lineKeys = (id: string) => [...lineSets(id).keys()].filter((k) => k === 'other' || groups.some((g) => g.key === k)).sort((a, b) => (a === 'other' ? 1 : b === 'other' ? -1 : a.localeCompare(b)));
  const lineGroupOf = (key: string) => (key === 'other' ? null : groups.find((g) => g.key === key) ?? null);
  const lineUnits = (id: string, key: string) => { const g = lineGroupOf(key); return g ? unitsOf(g) : pageUnits(id); };
  const lineRowFor = (id: string, key: string): Saved | undefined => { const g = lineGroupOf(key); return g ? (savedFor(g, lineRows.filter((r) => r.houses && r.cluster === id) as (Saved & { houses: string[] })[]) as Saved | null) ?? undefined : lineRows.find((r) => !r.houses && r.cluster === id); };
  // Where a group of lines is drawn: its own placement, else its homes' (they follow them), else the page's.
  const lineFitRow = (id: string, key: string): Saved | undefined => { const g = lineGroupOf(key); return lineRowFor(id, key) ?? (g ? savedFit(g) : undefined) ?? pageRow(id); };
  const pageRow = (id: string) => saved.find((s) => s.key === id && !s.houses);
  const savedFit = (g: Group): Saved | undefined => (savedFor(g, saved.filter((s) => s.houses && s.cluster === g.cluster) as (Saved & { houses: string[] })[]) as Saved | null) ?? undefined;
  const rangeLabel = (houses: string[]) => {
    const n = houses.map((x) => Number(x.slice(2))).sort((a, b) => a - b);
    return n.length > 1 && n[n.length - 1] - n[0] === n.length - 1 ? `${n[0]}–${n[n.length - 1]}` : n.join(', ');
  };
  const lineLabel = (key: string) => (key === 'other' ? 'other lines' : `lines along homes ${rangeLabel(lineGroupOf(key)?.houses ?? [])}`);
  const targetName = () => (linesMode ? `the ${lineLabel(lineKey)} of page ${clusterId}` : groupKey ? `homes ${rangeLabel(targetGroup()?.houses ?? [])}` : `page ${clusterId}`);

  // ---- the placement being moved ----
  const meanLocal = (f: { a: number; b: number; tx: number; ty: number }, us: Unit[]): [number, number] => {
    const pts = us.map((u) => planToLocal(f, [u.x, u.y]));
    return [pts.reduce((s, q) => s + q[0], 0) / (pts.length || 1), pts.reduce((s, q) => s + q[1], 0) / (pts.length || 1)];
  };
  const asBase = (r: Saved, us: Unit[]): Base => ({ a: r.a, b: r.b, tx: r.tx, ty: r.ty, frame: { lat: r.originLat, lng: r.originLng }, pivot: meanLocal(r, us) });
  // The target's placement before the hand adjustment: its own saved one; a group's page's when it has none; a page's draft.
  function baseNow(): Base | null {
    // A group of lines: its own saved placement, or (until it has one) where it is drawn now.
    if (linesMode) { const lr = lineFitRow(clusterId, lineKey); return lr ? asBase(lr, lineUnits(clusterId, lineKey)) : null; }
    const g = targetGroup();
    const row = g ? savedFit(g) ?? pageRow(clusterId) : pageRow(clusterId) ?? (draft?.cluster === clusterId ? draft.row : undefined);
    return row ? asBase(row, targetUnits()) : null;
  }
  // The hand adjustment is an operation on the ground about the picked thing's middle, so it can be applied to any placement: the
  // picked group's, or (for the whole page) the page's and each placed group's, which then all move together.
  function withTune(b: Base): Base {
    const pivot = baseNow()?.pivot;
    return isTuned(tune) && pivot ? { ...b, ...applyTune(b, tune, pivot) } : b;
  }
  function liveFit(): Base | null {
    const b = baseNow();
    return b ? withTune(b) : null;
  }
  const isDirty = () => isTuned(tune) || (!groupKey && draft?.cluster === clusterId);

  // ---- the live map, and where the plan's pixels are on it ----
  let map: any = null;
  let viewRect: DOMRect | null = null;
  const mercator = (lat: number, lng: number, zoom: number): [number, number] => {
    const size = 256 * 2 ** zoom;
    const sin = Math.min(Math.max(Math.sin((lat * Math.PI) / 180), -0.9999), 0.9999);
    return [(lng / 360 + 0.5) * size, (0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI)) * size];
  };
  const unMercator = (px: number, py: number, zoom: number): [number, number] => {
    const size = 256 * 2 ** zoom;
    const n = Math.PI - (2 * Math.PI * py) / size;
    return [(180 / Math.PI) * Math.atan(0.5 * (Math.exp(n) - Math.exp(-n))), (px / size - 0.5) * 360];
  };
  const rect = () => viewRect ?? $('gmap').getBoundingClientRect();
  // Pixel positions are inside the map box (0,0 at its top left), which is also the overlay's coordinate system.
  const pixelOf = (lat: number, lng: number): [number, number] => {
    const r = rect(), c = map.getCenter(), z = map.getZoom();
    const [cx, cy] = mercator(c.lat(), c.lng(), z), [px, py] = mercator(lat, lng, z);
    return [px - cx + r.width / 2, py - cy + r.height / 2];
  };
  const latLngAt = (clientX: number, clientY: number): [number, number] => {
    const r = $('gmap').getBoundingClientRect(), c = map.getCenter(), z = map.getZoom();
    const [cx, cy] = mercator(c.lat(), c.lng(), z);
    return unMercator(cx + clientX - r.left - r.width / 2, cy + clientY - r.top - r.height / 2, z);
  };
  const clientOf = (lat: number, lng: number): [number, number] => {
    const r = $('gmap').getBoundingClientRect(), [px, py] = pixelOf(lat, lng);
    return [px + r.left, py + r.top];
  };
  const metresPerPixel = () => (156543.03392 * Math.cos((map.getCenter().lat() * Math.PI) / 180)) / 2 ** map.getZoom();
  const geoOfPlan = (f: Base, x: number, y: number): [number, number] => localToGeo(f.frame, planToLocal(f, [x, y]) as [number, number]) as [number, number];
  const planOfGeo = (f: Base, lat: number, lng: number): [number, number] => imageToPlan(f, geoToLocal(f.frame, [lat, lng]) as [number, number]) as [number, number];

  // The affine transform that takes a layer's plan coordinates to pixels on the map: three of its points, through the placement and
  // the map's own projection. (The map is north-up with no tilt, so a plan page is a turn, a scale and a shift of it.)
  function matrixOf(f: Base, ref: [number, number]): number[] {
    const at = (x: number, y: number) => pixelOf(...geoOfPlan(f, x, y));
    const [x0, y0] = ref;
    const p0 = at(x0, y0), p1 = at(x0 + 100, y0), p2 = at(x0, y0 + 100);
    const a = (p1[0] - p0[0]) / 100, b = (p1[1] - p0[1]) / 100, c = (p2[0] - p0[0]) / 100, d = (p2[1] - p0[1]) / 100;
    return [a, b, c, d, p0[0] - a * x0 - c * y0, p0[1] - b * x0 - d * y0];
  }

  // ---- what is drawn: one layer per placement ----
  // Each saved group, the picked target (with the hand adjustment), and each aligned page's own lines with the homes that follow the
  // page. Homes are drawn exactly as members see them: their real shapes, with plots and numbers.
  function layers(): Layer[] {
    const out: Layer[] = [];
    const tg = targetGroup();
    const wholePage = !tg && !linesMode; // the whole page: everything on the page is picked and moves together
    const covered = new Set<string>();
    for (const g of groups) {
      if (tg && g.key === tg.key) { g.houses.forEach((x) => covered.add(x)); continue; }
      const row = savedFit(g);
      if (!row) continue;
      g.houses.forEach((x) => covered.add(x));
      const picked = wholePage && g.cluster === clusterId;
      out.push({ key: `g:${g.key}`, fit: asBase(row, unitsOf(g)), cluster: g.cluster, units: unitsOf(g), lines: null, target: picked, moves: picked });
    }
    if (tg) {
      const b = baseNow();
      if (b) out.push({ key: 'target', fit: b, cluster: clusterId, units: targetUnits(), lines: null, target: true, moves: true });
    }
    for (const c of clusters) {
      const pagePicked = wholePage && c.id === clusterId;
      const prow = pageRow(c.id);
      const pageFit = pagePicked ? baseNow() : prow ? asBase(prow, pageUnits(c.id)) : null;
      // the homes that follow the page (not in a saved group) ...
      if (pageFit) out.push({ key: `p:${c.id}`, fit: pageFit, cluster: c.id, units: units.filter((u) => u.cluster === c.id && !covered.has(u.houseNo)), lines: null, target: pagePicked, moves: pagePicked });
      // ... and each group of the page's lines, which has a placement of its own once placed (until then it follows its homes, or the page)
      for (const k of lineSets(c.id).keys()) {
        const g = lineGroupOf(k);
        if (k !== 'other' && !g) continue;
        const own = lineRowFor(c.id, k);
        const picked = c.id === clusterId && linesMode && k === lineKey;
        const followsTarget = !!tg && !own && !!g && g.key === tg.key;
        const lf = picked || followsTarget ? baseNow() : (() => { const r = lineFitRow(c.id, k); return r ? asBase(r, lineUnits(c.id, k)) : null; })();
        if (!lf) continue;
        const polys = lineSets(c.id).get(k)!;
        out.push({ key: `l:${c.id}:${k}`, fit: lf, cluster: c.id, units: [], lines: pathOfLines(polys), polys, lineKey: k, target: pagePicked || picked || followsTarget, moves: pagePicked || picked || followsTarget });
      }
    }
    return out;
  }
  const ov = $('ov') as unknown as SVGSVGElement;
  let drawn: { layer: Layer; g: SVGGElement; ref: [number, number] }[] = [];
  // The target's own placement is read fresh while dragging; everything else is as it was drawn.
  const fitOfDrawn = (e: { layer: Layer }) => (e.layer.moves ? withTune(e.layer.fit) : e.layer.fit);
  function applyMatrices() {
    if (!map || !map.getCenter()) return;
    viewRect = $('gmap').getBoundingClientRect();
    ov.setAttribute('viewBox', `0 0 ${viewRect.width} ${viewRect.height}`);
    for (const e of drawn) e.g.setAttribute('transform', `matrix(${matrixOf(fitOfDrawn(e), e.ref).join(' ')})`);
    viewRect = null;
  }
  function render() {
