  function tuneButton(label: string, text: string, onClick: () => void): HTMLElement {
    const b = h('button', 'button button--outline', text);
    b.setAttribute('type', 'button');
    b.setAttribute('aria-label', label);
    b.addEventListener('click', onClick);
    return b;
  }
  {
    const s = () => STEPS[step];
    const blank = () => h('span');
    $('tune-move').replaceChildren(blank(), tuneButton('Move north', '↑', () => nudge({ north: s().m })), blank(),
      tuneButton('Move west', '←', () => nudge({ east: -s().m })), blank(), tuneButton('Move east', '→', () => nudge({ east: s().m })),
      blank(), tuneButton('Move south', '↓', () => nudge({ north: -s().m })), blank());
    $('tune-turn').replaceChildren(tuneButton('Turn anticlockwise', '↺', () => nudge({ rotate: -s().deg })), tuneButton('Turn clockwise', '↻', () => nudge({ rotate: s().deg })));
    $('tune-size').replaceChildren(tuneButton('Make smaller', '−', () => nudge({ scale: 1 - s().pct / 100 })), tuneButton('Make larger', '+', () => nudge({ scale: 1 + s().pct / 100 })));
    $('tune-step').replaceChildren(...Object.entries(STEPS).map(([id, v]) => { const b = h('button', '', v.label); b.setAttribute('type', 'button'); b.setAttribute('data-step', id); b.addEventListener('click', () => { step = id; paintPanel(); }); return b; }));
    $('tune-reset').addEventListener('click', () => { tune = { ...NO_TUNE }; schedule(true); });
  }

  // Snap: for each neighbouring group (on this page, already placed, whose plots touch this group's on the plan), a button that moves
  // this group so its walls meet that group's walls on the ground.
  const polyOf = (d: string): [number, number][] => { const n = (d.match(/-?\d+(?:\.\d+)?/g) ?? []).map(Number); const q: [number, number][] = []; for (let i = 0; i + 1 < n.length; i += 2) q.push([n[i], n[i + 1]]); return q; };
  const outlinesOf = (us: Unit[]) => us.map((u) => plotOutline(clusterOf(u.cluster).plot, u.x, u.y)).filter((d): d is string => !!d).map(polyOf);
  function paintSnap() {
    const box = $('tune-snap');
    const g = targetGroup();
    const live = liveFit();
    if (!g || !live || !canEdit) { box.hidden = true; return; }
    const mine = outlinesOf(targetUnits());
    const buttons: HTMLElement[] = [];
    // The page's lines (the white boundaries): lay the group's plot walls on the nearby lines that bound them. The group's own lines that
    // still follow it are left out (they move with it).
    const sets = lineKeys(clusterId).filter((k) => !(k === g.key && !lineRowFor(clusterId, k))).flatMap((k) => { const r = lineFitRow(clusterId, k); return r ? [{ polys: lineSets(clusterId).get(k)!, fit: r }] : []; });
