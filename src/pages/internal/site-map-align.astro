  // ---- picking and dragging on the map ----
  const inside = (pts: [number, number][], x: number, y: number) => { let hit = false; for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) { const [xi, yi] = pts[i], [xj, yj] = pts[j]; if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit; } return hit; };
  // A home is pressed by its shape or by its plot (a T-shaped house has a notch in its bounding box that is not the house; the plot around it
