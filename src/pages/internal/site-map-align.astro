  const clampTune = (t: Tune): Tune => ({ east: Math.max(-300, Math.min(300, t.east)), north: Math.max(-300, Math.min(300, t.north)), rotate: Math.max(-30, Math.min(30, t.rotate)), scale: Math.max(0.8, Math.min(1.25, t.scale)) });
  const r3 = (n: number) => Math.round(n * 1000) / 1000;
  function nudge(change: Partial<Tune>) {
    tune = clampTune({ east: r3(tune.east + (change.east ?? 0)), north: r3(tune.north + (change.north ?? 0)), rotate: r3(tune.rotate + (change.rotate ?? 0)), scale: Math.round(tune.scale * (change.scale ?? 1) * 1e5) / 1e5 });
