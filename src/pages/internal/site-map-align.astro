  }

  // ---- hand adjustment: the buttons ----
  const STEPS: Record<string, { label: string; m: number; deg: number; pct: number }> = {
    fine: { label: 'Fine', m: 0.25, deg: 0.1, pct: 0.25 },
    medium: { label: 'Medium', m: 1, deg: 0.5, pct: 1 },
    coarse: { label: 'Coarse', m: 4, deg: 2, pct: 4 },
