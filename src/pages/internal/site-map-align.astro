  };
  // A press on the picked group of lines, to move it.
  const lineHit = (clientX: number, clientY: number) => { const l = layers().find((x) => x.moves && x.lineKey === lineKey && x.cluster === clusterId); return !!l && nearLine(l, clientX, clientY, 12); };
  // A tap on any of this page's lines picks that group of lines.
