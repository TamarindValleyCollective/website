---
// Internal admin tool for the accommodation-calendar prototype: lets the
// farm manager, Madhavan, record bookings against the fixed tent inventory
// (scripts/lib/accommodation.mjs) - who's in which tent, for how long, and
// why. See netlify/functions/accommodation-admin.mts for the API this talks
// to, and src/components/views/AvailabilityView.astro for the public,
// aggregate-only counterpart. Deliberately unlinked from nav; gated by
// Google Sign-In plus a live allow-list, same shell pattern as
// photo-pool.astro/whatsapp.astro (own Sheet/env var - see
// accommodation-admin.mts's header comment for why it isn't shared).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ACCOMMODATION_UNITS } from '../../../scripts/lib/accommodation.mjs';
import { durationDays } from '../../utils/events';
import { members } from '../../data/members';

// Member names only, for the "member stay" label picker - `name` is already
// the canonical display label used everywhere else members show up (see
// MembersView.astro), so no separate slug/id is needed here.
const memberNames = members.map((m) => m.name);

// English-only, upcoming-only, *overnight* public events, for the "link to
// a public event" picker - a day event has no accommodation to book
// against (its own date/duration is fixed by the event, not chosen here),
// so it's excluded rather than left for someone to pick and then have to
// notice doesn't apply. durationDays() (src/utils/events.ts) is the same
// day-vs-overnight test EventsIndexView.astro/EventDetailView.astro already
// use, so this can't drift from what the public site itself calls
// "overnight". A past event has no future nights left to book against, and
// this is an internal tool (not a localized visitor-facing page), so the
// kn/ta sibling entries (see EventsIndexView.astro's bareSlug convention)
// aren't relevant here either. A multi-day event counts as upcoming until
// its last day (endDate), not just its start.
const today = new Date();
const allEvents = (await getCollection('events', (e) => !e.data.draft && !e.id.startsWith('kn/') && !e.id.startsWith('ta/')))
  .filter((e) => (e.data.endDate ?? e.data.date) >= today && durationDays(e.data.date, e.data.endDate) > 1)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .map((e) => ({
    slug: e.id,
    title: e.data.title,
    date: e.data.date.toISOString().slice(0, 10),
    // nights, not days: a 2-day event (date + 1 endDate) is a 1-night stay.
    nights: durationDays(e.data.date, e.data.endDate) - 1,
  }));
---

<BaseLayout title="Accommodation Calendar" description="Internal accommodation booking tool." noindex>
  <section class="section wrapper">
    <h1>Accommodation Calendar</h1>
    <p class="hint">Record who's in which tent, for how long. The public site only ever shows aggregate availability derived from this.</p>

    <div id="gate" class="gate card">
      <p class="gate-copy">Sign in with the Google account you manage bookings with.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="error" hidden></p>
    </div>

    <div id="forbidden" class="gate card" hidden>
      <p class="gate-copy">Signed in as <strong id="forbidden-email"></strong>, but this Google account isn't authorized to manage the accommodation calendar.</p>
      <p class="hint" style="margin: 4px 0 12px;">Ask an admin to add it to the allow-list.</p>
      <button type="button" id="use-different-account" class="button">Use a different account</button>
    </div>

    <div id="app" hidden>
      <div class="month-nav">
        <button type="button" id="prev-month" class="button">← Prev</button>
        <h2 id="month-label"></h2>
        <button type="button" id="next-month" class="button">Next →</button>
        <div class="view-toggle" role="group" aria-label="Calendar view">
          <button type="button" class="button view-toggle-btn" data-view="day">Day</button>
          <button type="button" class="button view-toggle-btn view-toggle-btn--active" data-view="week">Week</button>
          <button type="button" class="button view-toggle-btn" data-view="month">Month</button>
        </div>
      </div>

      <p id="status" class="hint" hidden></p>

      <div class="grid-scroll">
        <table id="grid" class="grid-table"></table>
      </div>

      <div id="day-view" class="day-view" hidden></div>

      <div class="booking-list-header">
        <h2 id="booking-list-heading">Bookings this month</h2>
        <button type="button" id="new-booking-btn" class="button button--primary">+ New booking</button>
      </div>
      <div id="booking-list" class="booking-list"></div>

      <div id="booking-modal" class="booking-modal" hidden>
        <div id="booking-modal-backdrop" class="booking-modal-backdrop"></div>
        <div id="booking-modal-panel" class="card booking-modal-panel" role="dialog" aria-modal="true" aria-labelledby="form-heading">
          <div class="booking-modal-panel-head">
            <h2 id="form-heading" tabindex="-1">New booking</h2>
            <button type="button" id="booking-modal-close" class="button" aria-label="Close">✕</button>
          </div>
          <form id="booking-form" class="form">
            <fieldset class="form-group">
              <legend>What</legend>
              <label>
                Type
                <select id="f-type" required>
                  <option value="casual-stay">Linger booking</option>
                  <option value="public-event" id="f-type-public-event">Public event (linked)</option>
                  <option value="private-event">Private event (retreat)</option>
                  <option value="member-stay">Member stay (booked direct)</option>
                  <option value="unit-closure">Tent closure (repair, etc.)</option>
                </select>
              </label>

              <label id="f-event-wrap">
                Linked public event
                <select id="f-event"></select>
              </label>

              <label id="f-label-wrap">
                Label <span id="f-label-hint" class="hint-inline">(shown to you only, e.g. who's coming)</span>
                <input type="text" id="f-label" />
              </label>

              <label id="f-member-wrap" hidden>
                Member
                <select id="f-member"></select>
              </label>

              <label id="f-exclusive-wrap" class="checkbox-label">
                <input type="checkbox" id="f-exclusive" />
                Exclusive use — blocks the whole farm publicly, even if not every tent is assigned
              </label>

              <label id="f-farm-closure-wrap" class="checkbox-label" hidden>
                <input type="checkbox" id="f-farm-closure" />
                Farm on Vacation — closes the whole farm, not just one tent (no tent selection needed)
              </label>
            </fieldset>

            <fieldset class="form-group">
              <legend>When</legend>
              <div class="dates-row">
                <label>
                  Start date
                  <input type="date" id="f-start" required />
                </label>
                <label>
                  Nights
                  <input type="number" id="f-nights" min="1" value="1" required />
                </label>
              </div>
            </fieldset>

            <fieldset id="f-tents-wrap" class="form-group">
              <legend>Tents</legend>
              <div id="f-tents"></div>
            </fieldset>

            <fieldset class="form-group">
              <legend>Internal notes</legend>
              <label>
                Note <span class="hint-inline">(staff-only, never shown publicly)</span>
                <textarea id="f-note" rows="2"></textarea>
              </label>

              <label id="f-reason-wrap" hidden>
                Reason for this change <span class="hint-inline">(required — this stay has already happened)</span>
                <textarea id="f-reason" rows="2"></textarea>
              </label>
            </fieldset>

            <p id="form-error" class="error" hidden></p>

            <div class="form-actions">
              <button type="submit" id="f-submit" class="button button--primary">Save booking</button>
              <button type="button" id="f-cancel-edit" class="button" hidden>Cancel edit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<script type="application/json" id="events-data" set:html={JSON.stringify(allEvents)} />
<script type="application/json" id="units-data" set:html={JSON.stringify(ACCOMMODATION_UNITS)} />
<script type="application/json" id="members-data" set:html={JSON.stringify(memberNames)} />

<style>
  .hint {
    color: var(--tvc-ink-soft);
    margin: -8px 0 24px;
  }

  .hint-inline {
    font-weight: 400;
    color: var(--tvc-ink-soft);
    font-size: 0.82rem;
  }

  .card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .gate {
    max-width: 420px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .gate-copy {
    font-size: 0.9rem;
    color: var(--tvc-ink-soft);
    margin: 0 0 14px;
  }

  .error {
    color: #b3261e;
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .button {
    appearance: none;
    border: 1px solid var(--tvc-line);
    background: #fff;
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .button--primary {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: #fff;
  }

  .month-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    /* Without this, the toggle group (pushed right by margin-left:auto)
       simply ran off the edge of a phone-width viewport instead of
       dropping to its own line - confirmed via a real 390px-wide check
       during this page's design critique (2026-08): the row's own content
       (588px) exceeded the viewport (485px) and the Day/Week/Month buttons
       were hidden off-screen with no way to reach them. */
    flex-wrap: wrap;
  }

  .month-nav h2 {
    margin: 0;
    min-width: 180px;
    text-align: center;
  }

  .view-toggle {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .view-toggle-btn {
    padding: 6px 14px;
    font-size: 0.8rem;
  }

  .view-toggle-btn--active {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
    color: #fff;
  }

  /* Below this width, Prev/label/Next alone are already tight - let the
     label shrink instead of holding a fixed 180px, and force the view
     toggle onto its own centered row rather than letting the wrap point
     land wherever it happens to (which read as broken, not tidy). */
  @media (max-width: 480px) {
    .month-nav h2 {
      min-width: 0;
      flex: 1 1 auto;
    }

    .view-toggle {
      flex-basis: 100%;
      justify-content: center;
      margin-left: 0;
    }
  }

  .grid-scroll {
    overflow-x: auto;
    margin-bottom: 32px;
  }

  .booking-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .booking-list-header h2 {
    margin: 0;
  }

  /* A dialog the grid opens directly, instead of a form living in its own
     scrolled-past section below the booking list - closes the "grid and
     form are disconnected" gap found in this page's design critique
     (2026-08). Bottom-sheet on narrow screens (align-items: flex-end) since
     that's the native mobile pattern for "an action anchored to what you
     just tapped"; a centered dialog once there's room for one (see the
     min-width media query below). */
  .booking-modal {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .booking-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .booking-modal-panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 92vh;
    overflow-y: auto;
    padding: 20px 24px;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .booking-modal-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .booking-modal-panel-head h2 {
    margin: 0;
  }

  @media (min-width: 640px) {
    .booking-modal {
      align-items: center;
    }

    .booking-modal-panel {
      border-radius: var(--radius);
    }
  }

  /* Below the same 640px threshold the modal itself treats as "mobile"
     (see the min-width query above) - Start date/Nights sat side by side
     and didn't fit (design critique, 2026-09-10): the row overflowed the
     panel by 18px, scrollable via a scrollbar touch browsers hide by
     default, so Nights was reachable but easy to miss and leave at its
     default. The matching touch-target fix for the Tents picker's controls
     lives in the second, is:global stylesheet below (see that block's own
     comment) - those are elements the client script builds at runtime, so
     a rule here (Astro's scoped-style attribute never lands on them) would
     silently do nothing. */
  @media (max-width: 639px) {
    .dates-row {
      flex-direction: column;
      gap: 10px;
    }

    #booking-modal-close {
      min-width: 44px;
      min-height: 44px;
    }
  }

  /* The site-wide chat bubble (ChatWidget.astro, rendered by BaseLayout on
     every page including this internal one) sits at z-index 100, above the
     booking modal's own z-index 90 - on mobile it physically overlapped the
     second tent row's "+ Guest" button by ~15px (design critique,
     2026-09-10), so a tap aimed at +Guest could silently open marketing
     chat instead. :global() since #cw-root belongs to a different
     component's template, outside this page's own scoped-style subtree. */
  :global(body:has(#booking-modal:not([hidden])) #cw-root) {
    display: none;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .form input,
  .form select,
  .form textarea {
    font: inherit;
    padding: 6px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
  }

  /* Applied by setFormEditable() when a role can view but not write a
     booking (viewer, or restricted looking at a type outside its
     allowedTypes) - the browser's own default :disabled look is too subtle
     on this page's custom-bordered inputs/checkboxes to read as "locked"
     rather than just "a form that happens to ignore clicks" (Sharath's
     testing feedback, 2026-09-10). `disabled` is still the real mechanism
     (this is presentation only); button:disabled is excluded since
     #f-cancel-edit is the one button a read-only form keeps active. */
  .form--readonly input:disabled,
  .form--readonly select:disabled,
  .form--readonly textarea:disabled {
    background: var(--tvc-line);
    color: var(--tvc-ink-soft);
    cursor: not-allowed;
    opacity: 0.75;
  }

  .form--readonly button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .form--readonly .tent-option {
    cursor: not-allowed;
  }

  .checkbox-label {
    flex-direction: row !important;
    align-items: center;
    gap: 8px !important;
  }

  .dates-row {
    display: flex;
    gap: 14px;
  }

  .dates-row label {
    flex: 1;
  }

  /* An empty date input renders its dd/mm/yyyy pattern in full black by
     default, reading as if it were already a real value rather than a
     format hint. :placeholder-shown doesn't actually match a date input in
     Chrome (confirmed live - it never matches here despite matching a text
     input's real placeholder), so this is driven by a plain JS-toggled
     class (see syncStartDateEmptyState) instead of relying on that
     pseudo-class. */
  #f-start.is-empty {
    color: var(--tvc-ink-soft);
  }

  fieldset {
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
    padding: 10px 14px;
  }

  /* Groups the form into what/when/tents/internal-notes clusters instead of
     one flat 10+ field scroll with no landmarks - on a phone this used to
     be a long undifferentiated thumb-scroll (see this page's design
     critique, 2026-08). Reuses the plain fieldset look already established
     by the Tents box rather than inventing a second visual language. */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group legend {
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tvc-ink-soft);
    padding: 0 4px;
  }

  .form-actions {
    display: flex;
    gap: 10px;
  }
</style>

<!--
  Everything below styles content the client script builds at runtime
  (renderGrid/renderBookingList/buildTentsFieldset use innerHTML/
  createElement, not this component's own template) - Astro's scoped-style
  attribute selector only lands on elements Astro itself renders, so a
  normal scoped <style> block silently fails to match any of it (see
  AvailabilityView.astro's identical note). [hidden] is included here too,
  not just in the scoped block above, since guestsEl/addGuestBtn (dynamic)
  rely on it being suppressed the same way #gate/#app (static) do. None of
  these class names collide with anything in global.css (checked before
  adding this).
-->
<style is:global>
  .grid-table {
    /* Table width is otherwise intrinsic to its content - month view's ~30
       date columns naturally exceed the container (hence .grid-scroll's
       horizontal scroll), but week view's 7 columns fall well short of it,
       leaving the table looking stranded in the left part of the page
       instead of using the same width day/month do. width: 100% stretches
       it to fill the container whenever content is narrower; it has no
       effect once content (month view) already exceeds that width. */
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .grid-table th,
  .grid-table td {
    border: 1px solid var(--tvc-line);
    padding: 4px 6px;
    text-align: center;
  }

  .grid-table th.col--weekend {
    background: var(--tvc-line);
  }

  /* Body cells get the weekend cue too (Sharath: it shouldn't be
     header-only), but as a translucent overlay rather than a flat
     background - a flat color would replace, not sit alongside, the
     free/occupied/closed status color that same cell already carries,
     muddying the one thing that background is actually for. Layering a
     dark wash on top (background-image, painted over background-color)
     darkens whichever status color is underneath by the same amount
     instead of replacing it. */
  .grid-table td.col--weekend {
    background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.08));
  }

  /* A past date's header gets a visibly darker/greyer tint than a weekend
     one (this rule follows col--weekend in source, so a date that's both
     wins this treatment) - a quick "this column is history" cue across the
     whole calendar, not just on the free cells below (see .cell--free's own
     past-dimming, which only covers the one status that otherwise looked
     identical whether it was bookable or not). */
  .grid-table th.col--past {
    background: #d8d8d8;
  }

  .day-letter {
    font-weight: 700;
  }

  .day-date {
    font-weight: 400;
    color: var(--tvc-ink-soft);
    font-size: 0.72rem;
  }

  .grid-table th.unit-col,
  .grid-table td.unit-col {
    text-align: left;
    position: sticky;
    left: 0;
    background: #fff;
    font-weight: 600;
  }

  /* Same grouping the booking form's Tents picker uses, extended to the
     week/month grid (Sharath's feedback, 2026-09-10) - a solid-green band
     reads clearly against every row state's own background (free/occupied/
     closed all use tints, not solid color, of their own - see .day-row's
     own comment on that same clash). */
  .group-row td.group-row-label {
    background: var(--tvc-green);
    color: #fff;
    font-weight: 700;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .group-row td.group-row-fill {
    background: var(--tvc-green);
    border-color: var(--tvc-green);
  }

  .cell--free {
    background: var(--tvc-green-tint);
  }

  /* Past free cells (no data-tent-id - see renderGrid) can't be booked, so
     the green "bookable" tint above would be actively misleading here -
     matches the header's own col--past shading rather than inventing a
     second grey. */
  .cell--free:not([data-tent-id]) {
    background: #d8d8d8;
  }

  .cell--occupied {
    background: var(--tvc-orange-tint);
  }

  .cell--closed {
    background: #e6e6e6;
  }

  .cell--occupied,
  .cell--closed,
  .cell--free[data-tent-id] {
    cursor: pointer;
  }

  /* A free cell for today or later opens a pre-filled new-booking dialog
     (see startNewBookingAt) - this outline is the only hint that tapping it
     does something, so it needs to read as clickable the same way the
     occupied/closed cells already do via their tint. A free cell in the
     past has no data-tent-id (renderGrid) and gets neither the pointer
     cursor above nor this hover outline, since a new booking can never
     start in the past - it must read as inert, not clickable. */
  .cell--free[data-tent-id]:hover {
    outline: 2px solid var(--tvc-green);
    outline-offset: -2px;
  }

  /* Day view: one wide row per tent instead of the table's one-column
     squeeze (see renderDayView). Same status colors as the grid cells
     (free/occupied/closed/past) for a consistent vocabulary, but with room
     to actually show the booking's title and guest names instead of a
     glyph behind a hover-only tooltip. */
  .day-view {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }

  /* Same grouping the booking form's Tents picker uses, extended to day
     view (Sharath's feedback, 2026-09-10). A solid pill, not a tint, since
     every .day-row state (free/occupied/closed/past) already claims a tint
     of its own for status - a tinted heading would read as just another row
     state instead of a heading sitting above them. */
  .day-group-heading {
    align-self: flex-start;
    margin-top: 12px;
    padding: 3px 10px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--tvc-green);
    border-radius: 999px;
  }

  .day-group-heading:first-child {
    margin-top: 0;
  }

  .day-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 12px 16px;
    border-radius: var(--radius);
    background: var(--tvc-green-tint);
  }

  .day-row-tent {
    flex: 0 0 140px;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .day-row-main {
    flex: 1 1 220px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .day-row-title {
    font-weight: 600;
  }

  .day-row-guests {
    color: var(--tvc-ink-soft);
    font-size: 0.88rem;
  }

  .day-row--occupied {
    background: var(--tvc-orange-tint);
  }

  .day-row--closed {
    background: #e6e6e6;
  }

  .day-row--free-past {
    background: #d8d8d8;
    color: var(--tvc-ink-soft);
  }

  .day-row--occupied,
  .day-row--closed,
  .day-row--free {
    cursor: pointer;
  }

  .day-row--occupied:hover,
  .day-row--closed:hover,
  .day-row--free:hover {
    outline: 2px solid var(--tvc-green);
    outline-offset: -2px;
  }

  .booking-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .booking-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
  }

  .booking-card .meta {
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
  }

  .booking-card .actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  /* A plain uppercase heading sitting flush with its own units read as the
     same visual level as them, not a parent (Sharath's feedback,
     2026-09-10: "Fixed (S) is part of Malabar Hut, but they look like the
     same level"). A real bordered <fieldset>/<legend> per group - the exact
     pattern this form's own top-level sections (What/When/Tents/Internal
     notes) already use one level up - makes the containment unambiguous
     without inventing a new visual language. Bare `fieldset` below already
     supplies the border/radius/padding every fieldset on this page gets;
     this only adds the legend treatment and tightens spacing for a smaller,
     denser nested group. */
  .tent-group-fieldset {
    padding: 6px 12px 2px;
    margin-bottom: 10px;
  }

  .tent-group-fieldset:last-child {
    margin-bottom: 0;
  }

  /* A muted-grey uppercase legend on a white fieldset read as barely there
     ("Malabar Hut itself is lost in the text," Sharath's feedback,
     2026-09-10) - a solid brand-green pill with white text gives it real
     contrast and weight instead. It doubles as the collapse/expand toggle
     (same date, once 5 groups made the list long) - a plain <legend> isn't
     natively interactive, so this gets its own hover/focus treatment rather
     than relying on a browser default a legend doesn't have. */
  .tent-group-legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--tvc-green);
    padding: 3px 10px;
    border-radius: 999px;
    cursor: pointer;
    user-select: none;
  }

  .tent-group-legend:hover,
  .tent-group-legend:focus-visible {
    background: var(--tvc-green-dark);
    outline: 2px solid var(--tvc-green);
    outline-offset: 2px;
  }

  /* Rotates to point down once expanded - plain text, not an icon font, to
     match this page's existing no-icon-library convention (see .tent-summary's
     own chevron, the first place this page did the same thing). */
  .tent-group-chevron {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .tent-group-fieldset--expanded .tent-group-chevron {
    transform: rotate(90deg);
  }

  /* The CSS-grid 0fr/1fr trick: a track that animates between "collapsed to
     nothing" and "exactly its content's natural height" without either
     JS-measured heights or an overestimated max-height guess (which would
     leave a lingering gap once actually collapsed, or clip real content
     once a guest card pushes the group taller than a fixed guess). Needs
     exactly one child (.tent-group-body) to measure against; that child's
     own overflow:hidden is what actually clips it mid-transition, since the
     grid track alone can report a fractional height partway through. */
  .tent-group-body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms ease;
  }

  .tent-group-fieldset--expanded .tent-group-body-wrap {
    grid-template-rows: 1fr;
  }

  .tent-group-body {
    overflow: hidden;
    min-height: 0;
  }

  .tent-option {
    padding: 10px 0;
    border-bottom: 1px dashed var(--tvc-line);
  }

  .tent-option:last-child {
    border-bottom: none;
  }

  /* Checkbox+name and the +Guest button share one row - +Guest used to sit
     on its own line below the (hidden-until-checked) guest rows, reading as
     detached from the tent it belonged to once more than one tent was
     checked (Sharath's feedback, 2026-09-10). */
  /* Grid, not flex+space-between, so the occupancy count genuinely centers
     between the name and +Guest regardless of how wide either is (Sharath's
     feedback, 2026-09-10) - flex+space-between only pushes the two end
     items apart, it can't center a third item independent of their widths. */
  .tent-check-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
  }

  .tent-check-row .tent-check {
    justify-self: start;
  }

  .tent-check-row .add-guest {
    justify-self: end;
  }

  .tent-occupancy {
    justify-self: center;
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--tvc-ink-soft);
  }

  /* Guest mode's dot meter only - closure mode's plain "(3)" capacity
     figure keeps the base muted/tight styling above. */
  .tent-occupancy--dots {
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: var(--tvc-green);
  }

  .tent-solo-check {
    margin-top: 6px;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  .tent-solo-check:has(.tent-solo-checkbox:disabled) {
    opacity: 0.6;
  }

  .tent-option .tent-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.86rem;
  }

  /* Collapsed state for a guest-mode tent that has guests but isn't the
     active one (see activeTentId/renderTentState) - a full-width row rather
     than a small link, since it's replacing the entire guest-card block and
     should read as "there's real content folded up here," not a stray
     button. The chevron is plain text, not an icon font, to match this
     page's existing no-icon-library convention. */
  .tent-summary {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 8px 10px;
    border: 1px dashed var(--tvc-line);
    border-radius: 8px;
    background: none;
    font: inherit;
    font-size: 0.82rem;
    color: var(--tvc-ink-soft);
    text-align: left;
    cursor: pointer;
  }

  .tent-summary::after {
    content: ' ›';
  }

  .tent-summary:hover,
  .tent-summary:focus-visible {
    border-color: var(--tvc-green);
    color: var(--tvc-ink);
  }

  .guests {
    margin: 10px 0 2px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* Numbers each .guest-row below via .guest-row::before - browser-native,
       stays correct as rows are added/removed with no JS bookkeeping. */
    counter-reset: guest;
  }

  /* Each guest used to be a bare, unbordered stack of label rows with only a
     6px gap from the next guest's identical-looking stack - within one tent,
     "guest 1 ends" and "guest 2 begins" had no visual signal at all (Sharath's
     feedback, 2026-09-10: "two user details... too close... without any
     visual separation"). A bordered, tinted card per guest plus a numbered
     label makes each one read as one self-contained unit - the deliberate
     contrast this needs is tight spacing *within* a guest's own fields
     (unchanged below) against generous spacing *between* guests (the .guests
     gap above), not one uniform value for both relationships. */
  .guest-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* Extra right padding reserves the top-right corner for .remove-guest
       (below) so no field ever renders underneath it. */
    padding: 10px 40px 10px 12px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
    background: var(--tvc-cream);
  }

  .guest-row::before {
    counter-increment: guest;
    content: 'Guest ' counter(guest);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--tvc-ink-soft);
  }

  .guest-row-main {
    display: flex;
    position: relative; /* anchors .guest-typeahead's dropdown below */
  }

  .guest-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Top-right corner of the guest card, matching the common "dismiss this
     card" convention - used to sit inline next to Mobile, but now that each
     guest is its own bordered card (see .guest-row above), the corner reads
     as more intuitive (Sharath's feedback, 2026-09-10). .guest-row's extra
     right padding reserves this space so it never overlaps a field. */
  .remove-guest {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
  }

  /* Each guest field is a label wrapping its input/select, with a small
     persistent caption above it - a plain placeholder used to be the only
     hint at what a field was, which disappears the moment it's filled in
     (see this page's design critique, 2026-08: a farm manager filling
     these in has no way to re-confirm which column is which once there's
     real data in them). */
  .guest-field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .guest-field-label {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--tvc-ink-soft);
  }

  .guest-field input,
  .guest-field select {
    width: 100%;
    padding: 4px 8px;
    font-size: 0.82rem;
    font-family: inherit;
    /* Flex items default to min-width:auto, which floors their shrink at
       their content/intrinsic width - with 5 fields now on this row (name,
       age, gender, mobile number, remove), that floor added up to wider than
       the .form card itself, pushing the row out past the card's border
       instead of wrapping or shrinking. min-width:0 lets them actually
       shrink; flex-wrap on the row (above) is the fallback once they've
       shrunk as far as still-usable and there's still no room. */
    min-width: 0;
  }

  .guest-field--name {
    flex: 2 1 110px;
  }

  .guest-field--mobile {
    flex: 1 1 90px;
  }

  .guest-field--email {
    flex: 2 1 140px;
  }

  .mobile-number-warning,
  .email-warning {
    margin: 0;
    font-size: 0.76rem;
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  .mobile-number-conflict {
    padding: 8px 10px;
    background: var(--tvc-orange-tint);
    border-radius: 6px;
    font-size: 0.8rem;
  }

  .mobile-number-conflict p {
    margin: 0 0 6px;
  }

  .mobile-number-conflict-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .mobile-number-conflict-actions .button {
    font-size: 0.76rem;
    padding: 4px 10px;
  }

  .guest-field--age {
    flex: 1 1 80px;
  }

  /* Wider than age - "Unspecified" (the readable label for the stored
     value "NA", see GENDER_DISPLAY_LABELS) doesn't fit the narrower basis
     without clipping, which is exactly the truncated-text bug the
     min-width:0 shrink rule above already risks for a long enough label. */
  .guest-field--gender {
    flex: 2 1 130px;
  }

  .guest-typeahead {
    position: absolute;
    /* A few px of gap (instead of sitting flush at 100%) plus an opaque
       background is what stops this from reading as merged into the
       Preferences field directly beneath it, which sits at that same
       vertical position in normal flow. */
    top: calc(100% + 4px);
    left: 0;
    z-index: 5;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: 6px;
    box-shadow: var(--shadow-soft);
    min-width: 220px;
    max-height: 180px;
    overflow-y: auto;
  }

  .guest-typeahead button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 6px 10px;
    font-size: 0.8rem;
    border: none;
    background: none;
    cursor: pointer;
  }

  .guest-typeahead button:hover {
    background: var(--tvc-green-tint);
  }

  .guest-history-toggle {
    align-self: flex-start;
    font-size: 0.76rem;
    padding: 2px 8px;
    background: none;
    border: none;
    text-decoration: underline;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  /* Preferences/allergies is empty for most guests - an always-visible
     input for it read as clutter (Sharath's feedback, 2026-09-10). Idle
     state is a plain link-like button; a filled-in value becomes read-only
     text with a small Edit affordance instead of a permanently open input. */
  .preferences-add-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.78rem;
    text-decoration: underline;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .preferences-display {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 0.82rem;
  }

  .preferences-display .preferences-text {
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
  }

  .preferences-edit-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.76rem;
    text-decoration: underline;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .preferences-input {
    width: 100%;
  }

  .guest-history-panel {
    margin: 2px 0 4px;
    padding: 6px 10px;
    background: var(--tvc-green-tint);
    border-radius: 6px;
    font-size: 0.78rem;
  }

  .guest-history-panel ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  .reason-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .reason-overlay-card {
    background: #fff;
    border-radius: var(--radius);
    padding: 20px 24px;
    max-width: 420px;
    width: 90%;
  }

  .reason-overlay-card p {
    margin: 0 0 10px;
    font-size: 0.88rem;
  }

  .reason-overlay-card textarea {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    padding: 6px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 8px;
  }

  .reason-overlay-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 12px;
  }

  .add-guest {
    align-self: center;
    flex-shrink: 0;
    font-size: 0.78rem;
    padding: 3px 10px;
  }

  .add-guest:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .tent-option--occupied {
    opacity: 0.55;
  }

  .tent-option--occupied .tent-checkbox {
    cursor: not-allowed;
  }

  /* A tent that's checked but has become conflicting since (dates changed
     underneath it) - distinct from --occupied (unchecked + taken), since
     this one stays enabled so the admin can uncheck it themselves. */
  .tent-option--conflict {
    background: var(--tvc-orange-tint);
    border-radius: 6px;
    padding: 4px 6px;
    margin: 0 -6px;
  }

  .tent-conflict-warning {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  /* Buttons this page builds at runtime (guest-row remove/add, booking-card
     edit/cancel, reason-overlay actions, mobile-conflict actions) never get
     Astro's scoped-style attribute, so without an is:global override they
     fell through to global.css's site-wide `.button` at every state - a
     solid orange marketing-CTA background, meant for the site's hero CTA,
     not a small admin-tool action pill. Confirmed live during this page's
     design critique (2026-08): Edit/Cancel computed to
     `background: rgb(247, 133, 32)` with no astro-cid attribute, versus the
     one statically-rendered button (Prev), which correctly got this page's
     own white background. `.button.button` (repeating the class) bumps
     specificity past global.css's plain `.button`/`.button:hover`
     regardless of stylesheet load order, giving every non-primary,
     non-danger button here this page's own neutral pill look end to end -
     base, hover, and focus, not just the text color. :not(.button--primary)
     excludes the one button that's meant to look like the site's green CTA;
     :not(.button--danger) excludes destructive actions below, which get
     their own look so a destructive action never renders identically to a
     safe one (Edit vs Cancel were indistinguishable before this). */
  .button.button:not(.button--primary):not(.button--danger) {
    background: #fff;
    color: var(--tvc-ink);
  }

  .button.button:not(.button--primary):not(.button--danger):hover,
  .button.button:not(.button--primary):not(.button--danger):focus-visible {
    background: var(--tvc-line);
    color: var(--tvc-ink);
  }

  /* Destructive actions (cancelling a booking, removing a guest row) get a
     visibly different treatment from neutral ones (Edit, +Guest) so the two
     are never one indistinguishable pill color. */
  .button.button--danger {
    background: #fff;
    border-color: #b3261e;
    color: #b3261e;
  }

  .button.button--danger:hover,
  .button.button--danger:focus-visible {
    background: #b3261e;
    border-color: #b3261e;
    color: #fff;
  }

  [hidden] {
    display: none !important;
  }

  /* Touch targets for the Tents picker's runtime-built controls (design
     critique, 2026-09-10, measured live at 390px): group-legend pills
     (~24px tall), +Guest (67x21px), remove-guest (33x27px), the tent and
     Family Booking checkboxes' label rows (as little as 116x16px) all
     measured well under the ~44x44px minimum. Widens the actual hit area
     via padding/min-height only below the same 640px threshold the modal
     itself already treats as "mobile" - the deliberately compact desktop
     sizing these were tuned to (see this file's earlier design-critique
     fixes) is untouched above that width. Placed last in this stylesheet,
     and matches the base rules' own specificity exactly (single class
     selectors) - equal-specificity CSS resolves by source order, so this
     has to come after every rule it's meant to override, not just be
     wrapped in the right media query. */
  @media (max-width: 639px) {
    .tent-group-legend {
      padding: 10px 14px;
      min-height: 44px;
    }

    .add-guest {
      padding: 10px 14px;
      min-height: 44px;
    }

    .remove-guest {
      min-width: 44px;
      min-height: 44px;
    }

    .tent-check {
      min-height: 44px;
    }

    /* Unlike .tent-check (already display:flex from its own base rule),
       .tent-solo-check has no explicit display - a runtime-built <label>
       defaults to inline, which min-height has no effect on at all (it
       just happened to look fine side-by-side because inline boxes flow
       horizontally too, hiding that the property was silently a no-op). */
    .tent-solo-check {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

<script>
  import { normalizeMobileNumber, isValidEmail } from '../../../scripts/lib/accommodation.mjs';

  declare const google: any;

  const STORAGE_KEY = 'tvc-accommodation-idtoken';
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  interface EventOption {
    slug: string;
    title: string;
    date: string;
    nights: number;
  }

  interface Unit {
    id: string;
    label: string;
    shortLabel: string;
    capacity: number;
    kind: 'fixed' | 'removable' | 'byot';
    group: string;
  }

  interface Guest {
    personId?: string;
    name?: string;
    mobileNumber?: string;
    email?: string;
    ageGroup?: 'Adult' | 'Child';
    gender?: string;
    preferences?: string;
  }

  interface GuestMatch {
    id: string;
    name: string;
    mobileNumber?: string;
    email?: string;
    gender?: string;
    preferences?: string;
  }

  interface PastStay {
    bookingId: string;
    startDate: string;
    nights: number;
    tentId: string;
    type: string;
    label?: string;
    eventTitle?: string;
    ageGroupAtStay: string;
  }

  interface TentAssignment {
    tentId: string;
    guests: Guest[];
  }

  type BookingType = 'public-event' | 'private-event' | 'casual-stay' | 'member-stay' | 'unit-closure' | 'farm-closure';

  // A booking with no Label/eventTitle used to fall back to its raw type
  // slug ("casual-stay") as its human-facing title, everywhere that title
  // shows up (booking card, grid tooltip, a guest's past-stays list) - a
  // real bug found in this page's design critique (2026-08): the slug is
  // internal shorthand, never meant to be read by anyone.
  const TYPE_DISPLAY_LABELS: Record<BookingType, string> = {
    'public-event': 'Public event',
    'private-event': 'Private event / retreat',
    'casual-stay': 'Linger booking',
    'member-stay': 'Member stay',
    'unit-closure': 'Tent closure',
    'farm-closure': 'Farm on Vacation',
  };

  function typeDisplayLabel(type: string): string {
    return TYPE_DISPLAY_LABELS[type as BookingType] ?? type;
  }

  interface Booking {
    id: string;
    type: BookingType;
    eventSlug?: string;
    eventTitle?: string;
    label?: string;
    exclusive?: boolean;
    startDate: string;
    nights: number;
    tents: TentAssignment[];
    note?: string;
    isPast: boolean;
    createdBy: string;
    createdAt: string;
    updatedBy?: string;
    updatedAt: string;
  }

  const EVENTS: EventOption[] = JSON.parse(document.getElementById('events-data')!.textContent!);
  const UNITS: Unit[] = JSON.parse(document.getElementById('units-data')!.textContent!);
  const MEMBERS: string[] = JSON.parse(document.getElementById('members-data')!.textContent!);

  const gate = document.getElementById('gate') as HTMLElement;
  const gateError = document.getElementById('gate-error') as HTMLElement;
  const forbidden = document.getElementById('forbidden') as HTMLElement;
  const forbiddenEmail = document.getElementById('forbidden-email') as HTMLElement;
  const useDifferentAccountBtn = document.getElementById('use-different-account') as HTMLButtonElement;
  const app = document.getElementById('app') as HTMLElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const monthLabel = document.getElementById('month-label') as HTMLElement;
  const viewToggleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-toggle-btn'));
  const gridTable = document.getElementById('grid') as HTMLTableElement;
  const gridScroll = document.querySelector('.grid-scroll') as HTMLElement;
  const dayView = document.getElementById('day-view') as HTMLElement;
  const bookingListHeading = document.getElementById('booking-list-heading') as HTMLElement;
  const bookingList = document.getElementById('booking-list') as HTMLElement;
  const newBookingBtn = document.getElementById('new-booking-btn') as HTMLButtonElement;
  const bookingModal = document.getElementById('booking-modal') as HTMLElement;
  const bookingModalPanel = document.getElementById('booking-modal-panel') as HTMLElement;
  const bookingModalBackdrop = document.getElementById('booking-modal-backdrop') as HTMLElement;
  const bookingModalClose = document.getElementById('booking-modal-close') as HTMLButtonElement;
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const formHeading = document.getElementById('form-heading') as HTMLElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const typeSelect = document.getElementById('f-type') as HTMLSelectElement;
  const publicEventTypeOption = document.getElementById('f-type-public-event') as HTMLOptionElement;
  const eventWrap = document.getElementById('f-event-wrap') as HTMLElement;
  const eventSelect = document.getElementById('f-event') as HTMLSelectElement;
  const labelWrap = document.getElementById('f-label-wrap') as HTMLElement;
  const labelHint = document.getElementById('f-label-hint') as HTMLElement;
  const labelInput = document.getElementById('f-label') as HTMLInputElement;
  const memberWrap = document.getElementById('f-member-wrap') as HTMLElement;
  const memberSelect = document.getElementById('f-member') as HTMLSelectElement;
  const exclusiveWrap = document.getElementById('f-exclusive-wrap') as HTMLElement;
  const exclusiveInput = document.getElementById('f-exclusive') as HTMLInputElement;
  const farmClosureWrap = document.getElementById('f-farm-closure-wrap') as HTMLElement;
  const farmClosureInput = document.getElementById('f-farm-closure') as HTMLInputElement;
  const startInput = document.getElementById('f-start') as HTMLInputElement;
  const nightsInput = document.getElementById('f-nights') as HTMLInputElement;
  const tentsWrap = document.getElementById('f-tents-wrap') as HTMLElement;
  const tentsContainer = document.getElementById('f-tents') as HTMLElement;
  const noteInput = document.getElementById('f-note') as HTMLTextAreaElement;
  const reasonWrap = document.getElementById('f-reason-wrap') as HTMLElement;
  const reasonInput = document.getElementById('f-reason') as HTMLTextAreaElement;
  const cancelEditBtn = document.getElementById('f-cancel-edit') as HTMLButtonElement;
  const submitBtn = document.getElementById('f-submit') as HTMLButtonElement;

  type ViewMode = 'day' | 'week' | 'month';
  let viewMode: ViewMode = 'week';
  let anchorDate = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD, local
  let currentBookings: Booking[] = [];
  let editingId: string | null = null;

  // Role/allowedTypes come back on every /bookings response (see
  // accommodation-admin.mts's handleList) rather than a separate "whoami"
  // call - defaults to unrestricted until the first successful load, same
  // as the brief pre-load flicker every other role-gated control already has.
  type Role = 'admin' | 'restricted' | 'viewer';
  let myRole: Role = 'admin';
  let myAllowedTypes: string[] | null = null;

  // Server-side canWriteType (accommodation-admin.mts) is the real gate -
  // this mirrors it only to grey out/hide controls the request would be
  // rejected for anyway, never as the actual authorization boundary.
  function canWriteType(type: string): boolean {
    if (myRole === 'admin') return true;
    if (myRole === 'restricted') return myAllowedTypes?.includes(type) ?? false;
    return false; // viewer
  }

  function getToken(): string | null {
    return sessionStorage.getItem(STORAGE_KEY);
  }

  function clearToken() {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  function decodeTokenEmail(token: string): string {
    const payloadB64 = token.split('.')[1] ?? '';
    const base64 = payloadB64.replace(/-/g, '+').replace(/_/g, '/').padEnd(payloadB64.length + ((4 - (payloadB64.length % 4)) % 4), '=');
    try {
      return JSON.parse(atob(base64)).email ?? 'unknown';
    } catch {
      return 'unknown';
    }
  }

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    app.hidden = true;
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden(token: string) {
    gate.hidden = true;
    app.hidden = true;
    forbidden.hidden = false;
    forbiddenEmail.textContent = decodeTokenEmail(token);
  }

  function showStatus(message: string) {
    statusEl.hidden = false;
    statusEl.textContent = message;
  }

  function hideStatus() {
    statusEl.hidden = true;
  }

  // The dialog asserted role="dialog" aria-modal="true" but didn't back
  // that up with real focus handling (Sharath's feedback, 2026-09-10, filed
  // as issue #154): focus stayed on <body> after opening, and Tab could
  // still reach the page header's nav behind a modal claiming to be, well,
  // modal. modalTriggerEl remembers whatever had focus before the modal
  // opened (the grid cell, "+ New booking", etc.) so it can be restored on
  // close - the standard "return focus to where you were" dialog contract.
  let modalTriggerEl: HTMLElement | null = null;

  // Elements a real user could tab to - deliberately narrow (no [tabindex]
  // catch-all) since every focusable control in this form is one of these
  // native element types; broadening it would risk snagging something like
  // a decorative element that happens to carry a stray tabindex.
  function getFocusableElements(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled])'),
    ).filter((el) => el.getClientRects().length > 0); // excludes anything hidden/display:none
  }

  // Keeps Tab/Shift+Tab cycling within the panel instead of escaping to
  // background page content - wrap-around only at the two ends, everything
  // in between is untouched native tab order.
  function trapModalFocus(ev: KeyboardEvent) {
    if (ev.key !== 'Tab' || bookingModal.hidden) return;
    const focusable = getFocusableElements(bookingModalPanel);
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (ev.shiftKey && document.activeElement === first) {
      ev.preventDefault();
      last.focus();
    } else if (!ev.shiftKey && document.activeElement === last) {
      ev.preventDefault();
      first.focus();
    }
  }

  // The booking form lives in a dialog the grid opens directly (tap a free
  // cell to book, tap an occupied one to edit) instead of a separate
  // section scrolled past below the list - see this page's design critique
  // (2026-08) for why. Locking body scroll matters most on a phone, where
  // the sheet covers most of the viewport and a background scroll under it
  // reads as broken.
  function openBookingModal() {
    modalTriggerEl = document.activeElement as HTMLElement | null;
    bookingModal.hidden = false;
    document.body.style.overflow = 'hidden';
    // The heading, not the first field - works identically whether the
    // form is editable or a fully-disabled view-only booking (see
    // setFormEditable), and announces "New/Edit/View booking" before a
    // screen-reader user lands on any field.
    formHeading.focus();
  }

  function closeBookingModal() {
    bookingModal.hidden = true;
    document.body.style.overflow = '';
    modalTriggerEl?.focus();
    modalTriggerEl = null;
  }

  // Layers role-based type restrictions on top of whatever
  // updatePublicEventOptionVisibility()/loadIntoForm already decided about
  // f-type's options - only ever adds a disabled/hidden state, never removes
  // one, so call order relative to those doesn't matter. Hidden, not just
  // disabled, for a restricted role: a partner like Linger shouldn't see
  // that internal categories (member-stay, private-event, tent closure)
  // exist at all in the picker, not just be blocked from picking them
  // (Sharath's feedback, 2026-09-10). A hidden option that's already the
  // *current* selection (editing an existing out-of-scope booking) still
  // shows as the select's closed-state text - restricted/viewer roles see
  // full booking details regardless of type, per the read-access design
  // decision; this only hides options from the open picker list.
  function refreshTypeOptions() {
    for (const opt of Array.from(typeSelect.options)) {
      if (myRole === 'restricted' && !canWriteType(opt.value)) {
        opt.disabled = true;
        opt.hidden = true;
      }
    }
  }

  // Disables every field/button in the booking form except the dismiss
  // control (#f-cancel-edit), and applies .form--readonly so the disabled
  // state actually reads as locked rather than just an inert copy of the
  // normal form (see that class's own CSS comment) - used when the
  // signed-in role can view a booking (every role can) but not write to it:
  // a viewer, or a restricted role looking at a booking outside its
  // allowedTypes. The server-side canWriteType check in
  // accommodation-admin.mts is the actual boundary; this only keeps the UI
  // from offering a save/delete that would 403.
  function setFormEditable(editable: boolean) {
    form.classList.toggle('form--readonly', !editable);
    for (const el of Array.from(form.querySelectorAll('input, select, textarea, button:not(#f-cancel-edit)'))) {
      (el as HTMLInputElement | HTMLButtonElement).disabled = !editable;
    }
    submitBtn.hidden = !editable;
  }

  async function authedFetch(input: string, init: RequestInit = {}): Promise<Response> {
    const token = getToken();
    const res = await fetch(input, {
      ...init,
      headers: { ...init.headers, authorization: `Bearer ${token ?? ''}` },
    });
    if (res.status === 401) {
      clearToken();
      showGate('Your session expired — sign in again.');
      throw new Error('Unauthorized');
    }
    if (res.status === 403) {
      showForbidden(token!);
      throw new Error('Forbidden');
    }
    return res;
  }

  // ---- Tent-assignment fieldset (checkbox per unit, expandable guest rows) ----

  const GENDER_OPTIONS = ['Male', 'Female', 'NA'];
  // Display text only - the stored/validated value stays the literal 'NA'
  // the server's VALID_GENDERS checks against (accommodation-admin.mts);
  // "NA" read as developer shorthand in a guest register, not a real choice
  // a guest would recognize themselves in.
  const GENDER_DISPLAY_LABELS: Record<string, string> = { Male: 'Male', Female: 'Female', NA: 'Unspecified' };
  const AGE_GROUP_OPTIONS = ['Adult', 'Child'];

  // Debounced so the typeahead doesn't fire a request on every keystroke -
  // 250ms is short enough to feel live, long enough to skip the request
  // entirely for someone typing at a normal pace.
  function debounce<T extends (...args: never[]) => void>(fn: T, ms: number): T {
    let timer: ReturnType<typeof setTimeout>;
    return ((...args: never[]) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), ms);
    }) as T;
  }

  async function searchGuestsByName(query: string): Promise<GuestMatch[]> {
    if (query.trim().length < 2) return [];
    try {
      const res = await authedFetch(`/api/accommodation-admin/guests/search?q=${encodeURIComponent(query.trim())}`);
      if (!res.ok) return [];
      return ((await res.json()) as { matches: GuestMatch[] }).matches;
    } catch {
      return [];
    }
  }

  // Exact match, so this can return more than one row now that mobile
  // number alone isn't unique (see 0011's migration comment) - two
  // different people sharing a number is exactly the case this powers the
  // "same person, fix the spelling? or a different guest?" prompt for.
  async function searchGuestsByMobile(mobileNumber: string): Promise<GuestMatch[]> {
    try {
      const res = await authedFetch(`/api/accommodation-admin/guests/search?mobile=${encodeURIComponent(mobileNumber)}`);
      if (!res.ok) return [];
      return ((await res.json()) as { matches: GuestMatch[] }).matches;
    } catch {
      return [];
    }
  }

  async function fetchGuestStays(personId: string): Promise<{ person: GuestMatch; stays: PastStay[] } | null> {
    try {
      const res = await authedFetch(`/api/accommodation-admin/guests/${personId}/stays`);
      if (!res.ok) return null;
      return await res.json();
    } catch {
      return null;
    }
  }

  // "Guest 1"/"Guest 2" is otherwise CSS counter-content only (.guest-row
  // ::before), invisible to a screen reader, and every "Remove guest"
  // button was identically labeled regardless of which guest it belonged
  // to (Sharath's feedback, 2026-09-10, filed as issue #156) - a screen
  // reader user tabbing through 2-3 identical announcements had no way to
  // tell which guest they were about to delete. Recomputed from current DOM
  // order (not stored once at creation) so removing a guest correctly
  // renumbers everyone after it, the same way the CSS counter already does
  // visually - called after every add and every remove.
  function renumberGuestAriaLabels(container: HTMLElement) {
    Array.from(container.querySelectorAll<HTMLElement>('.guest-row')).forEach((row, i) => {
      const n = i + 1;
      row.setAttribute('aria-label', `Guest ${n}`);
      row.querySelector('.remove-guest')?.setAttribute('aria-label', `Remove Guest ${n}`);
    });
  }

  function addGuestRow(container: HTMLElement, guest: Guest = {}, onRemove?: () => void) {
    const row = document.createElement('div');
    row.className = 'guest-row';
    // No blank/placeholder option in either select, on purpose - "Adult/Child"
    // and "Gender" as literal choices confused testing (see Sharath's
    // feedback), and a real, always-present default (Adult / NA) is exactly
    // what "these are mandatory to fill" means in practice: there's no empty
    // state to accidentally submit, only a default a guest doesn't have to
    // touch if it doesn't apply.
    const ageGroup = guest.ageGroup ?? 'Adult';
    const gender = guest.gender ?? 'NA';
    row.dataset.personId = guest.personId ?? '';
    row.innerHTML = `
      <div class="guest-row-main">
        <div class="guest-fields">
          <label class="guest-field guest-field--name">
            <span class="guest-field-label">Name</span>
            <input type="text" data-field="name" placeholder="Name" required autocomplete="off" value="${guest.name ?? ''}" />
          </label>
          <label class="guest-field guest-field--age">
            <span class="guest-field-label">Age</span>
            <select data-field="ageGroup">
              ${AGE_GROUP_OPTIONS.map((a) => `<option value="${a}" ${ageGroup === a ? 'selected' : ''}>${a}</option>`).join('')}
            </select>
          </label>
          <label class="guest-field guest-field--gender">
            <span class="guest-field-label">Gender</span>
            <select data-field="gender">
              ${GENDER_OPTIONS.map((g) => `<option value="${g}" ${gender === g ? 'selected' : ''}>${GENDER_DISPLAY_LABELS[g]}</option>`).join('')}
            </select>
          </label>
          <label class="guest-field guest-field--mobile">
            <span class="guest-field-label">Mobile</span>
            <input type="tel" data-field="mobileNumber" placeholder="Optional" value="${guest.mobileNumber ?? ''}" />
          </label>
          <label class="guest-field guest-field--email">
            <span class="guest-field-label">Email</span>
            <input type="email" data-field="email" placeholder="Optional" value="${guest.email ?? ''}" />
          </label>
        </div>
      </div>
      <p class="mobile-number-warning" hidden></p>
      <div class="mobile-number-conflict" hidden></div>
      <p class="email-warning" hidden></p>
      <div class="preferences-field">
        <input type="text" data-field="preferences" class="preferences-input" placeholder="Preferences / allergies" value="${guest.preferences ?? ''}" hidden />
        <button type="button" class="preferences-add-btn" hidden>+ Preferences / allergies</button>
        <div class="preferences-display" hidden>
          <span class="guest-field-label">Preferences / allergies</span>
          <span class="preferences-text"></span>
          <button type="button" class="preferences-edit-btn">Edit</button>
        </div>
      </div>
      <button type="button" class="guest-history-toggle" ${guest.personId ? '' : 'hidden'}>Past stays</button>
      <button type="button" class="button button--danger remove-guest" aria-label="Remove guest">✕</button>
    `;
    row.querySelector('.remove-guest')!.addEventListener('click', () => {
      row.remove();
      renumberGuestAriaLabels(container);
      onRemove?.();
    });

    // ---- Preferences/allergies: hidden entirely when empty (idle "+ Add"
    // link) instead of an always-visible input, and a plain-text + Edit
    // affordance once a value exists, instead of a permanently-open input -
    // both read as clutter for a field that's empty for most guests
    // (Sharath's feedback, 2026-09-10). The underlying <input> stays in the
    // DOM at all times either way, so collectTents()'s existing
    // `[data-field="preferences"]` read is completely unaffected by which
    // of the three states is currently showing.
    const preferencesInput = row.querySelector('.preferences-input') as HTMLInputElement;
    const preferencesAddBtn = row.querySelector('.preferences-add-btn') as HTMLButtonElement;
    const preferencesDisplay = row.querySelector('.preferences-display') as HTMLElement;
    const preferencesText = row.querySelector('.preferences-text') as HTMLElement;
    const preferencesEditBtn = row.querySelector('.preferences-edit-btn') as HTMLButtonElement;

    function renderPreferencesState() {
      const value = preferencesInput.value.trim();
      preferencesInput.hidden = true;
      preferencesAddBtn.hidden = Boolean(value);
      preferencesDisplay.hidden = !value;
      if (value) preferencesText.textContent = value;
    }

    preferencesAddBtn.addEventListener('click', () => {
      preferencesAddBtn.hidden = true;
      preferencesInput.hidden = false;
      preferencesInput.focus();
    });
    preferencesEditBtn.addEventListener('click', () => {
      preferencesDisplay.hidden = true;
      preferencesInput.hidden = false;
      preferencesInput.focus();
    });
    preferencesInput.addEventListener('blur', renderPreferencesState);
    preferencesInput.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        ev.preventDefault();
        preferencesInput.blur();
      }
    });
    renderPreferencesState();

    // ---- Typeahead: search by name, pick a match to reuse that guest's
    // record (fills mobile number/gender/preferences, links personId)
    // instead of creating a fresh one. Typing without picking a suggestion
    // just means "new person" - still resolved server-side by mobile
    // number + name together if a number's entered (see 0011's migration
    // comment on why mobile number alone isn't a safe auto-match key).
    const nameInput = row.querySelector('[data-field="name"]') as HTMLInputElement;
    const mobileInput = row.querySelector('[data-field="mobileNumber"]') as HTMLInputElement;
    const emailInput = row.querySelector('[data-field="email"]') as HTMLInputElement;
    const mobileWarning = row.querySelector('.mobile-number-warning') as HTMLElement;
    const mobileConflict = row.querySelector('.mobile-number-conflict') as HTMLElement;
    const emailWarning = row.querySelector('.email-warning') as HTMLElement;
    const genderSelect = row.querySelector('[data-field="gender"]') as HTMLSelectElement;
    const historyToggle = row.querySelector('.guest-history-toggle') as HTMLButtonElement;
    const guestMain = row.querySelector('.guest-row-main') as HTMLElement;
    let dropdown: HTMLElement | null = null;

    function closeDropdown() {
      dropdown?.remove();
      dropdown = null;
    }

    function selectMatch(match: GuestMatch) {
      row.dataset.personId = match.id;
      nameInput.value = match.name;
      mobileInput.value = match.mobileNumber ?? '';
      emailInput.value = match.email ?? '';
      genderSelect.value = match.gender ?? 'NA';
      preferencesInput.value = match.preferences ?? '';
      renderPreferencesState();
      historyToggle.hidden = false;
      closeDropdown();
    }

    // If this number already belongs to a different-named person, ask
    // rather than silently either merging or duplicating: "same person,
    // fix the spelling?" links this row to that existing record (so saving
    // corrects its name); "different guest" leaves this as a new,
    // independent person who happens to share the number - Sharath's
    // explicit call, since auto-picking either behavior silently is wrong
    // often enough to need a human in the loop (see 0011's migration
    // comment for the "two people, one shared phone" bug this replaces).
    async function checkMobileConflict() {
      mobileConflict.hidden = true;
      mobileConflict.innerHTML = '';
      const normalized = normalizeMobileNumber(mobileInput.value);
      const typedName = nameInput.value.trim();
      if (!normalized || !typedName) return;

      const matches = await searchGuestsByMobile(normalized);
      const different = matches.find((m) => m.id !== row.dataset.personId && m.name.trim().toLowerCase() !== typedName.toLowerCase());
      if (!different) return;

      mobileConflict.hidden = false;
      mobileConflict.innerHTML = `
        <p>This number is already saved for <strong>${different.name}</strong>.</p>
        <div class="mobile-number-conflict-actions">
          <button type="button" class="button" data-action="same">Same person — fix name to "${typedName}"</button>
          <button type="button" class="button" data-action="different">Different guest, same number</button>
        </div>
      `;
      mobileConflict.querySelector('[data-action="same"]')!.addEventListener('click', () => {
        row.dataset.personId = different.id;
        genderSelect.value = different.gender ?? genderSelect.value;
        if (!emailInput.value.trim()) emailInput.value = different.email ?? '';
        if (!preferencesInput.value.trim()) preferencesInput.value = different.preferences ?? '';
        renderPreferencesState();
        historyToggle.hidden = false;
        mobileConflict.hidden = true;
      });
      mobileConflict.querySelector('[data-action="different"]')!.addEventListener('click', () => {
        if (row.dataset.personId === different.id) row.dataset.personId = '';
        mobileConflict.hidden = true;
      });
    }

    // Same validation the server enforces (normalizeMobileNumber, imported
    // from the one shared implementation) - this is UX-only, an instant
    // heads-up before the round-trip to the server that will reject it for
    // real regardless.
    mobileInput.addEventListener('blur', () => {
      const raw = mobileInput.value.trim();
      const invalid = raw !== '' && !normalizeMobileNumber(raw);
      mobileWarning.hidden = !invalid;
      mobileWarning.textContent = invalid ? '⚠ Doesn’t look like a valid mobile number (10 digits for India, or include a country code).' : '';
      if (!invalid) checkMobileConflict();
    });

    // Same shape check the server enforces (isValidEmail, the one shared
    // implementation) - instant feedback only, the server/DB CHECK
    // constraint (migration 0015) is the actual gate.
    emailInput.addEventListener('blur', () => {
      const raw = emailInput.value.trim();
      const invalid = raw !== '' && !isValidEmail(raw);
      emailWarning.hidden = !invalid;
      emailWarning.textContent = invalid ? '⚠ Doesn’t look like a valid email address.' : '';
    });

    nameInput.addEventListener('input', () => {
      row.dataset.personId = ''; // typing again after a pick means "not necessarily that person anymore"
      historyToggle.hidden = true;
      closeDropdown();
      debouncedSearch(nameInput.value);
    });

    const debouncedSearch = debounce(async (query: string) => {
      const matches = await searchGuestsByName(query);
      closeDropdown();
      if (matches.length === 0) return;
      dropdown = document.createElement('div');
      dropdown.className = 'guest-typeahead';
      for (const m of matches) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = m.mobileNumber ? `${m.name} — ${m.mobileNumber}` : m.name;
        btn.addEventListener('click', () => selectMatch(m));
        dropdown.appendChild(btn);
      }
      guestMain.appendChild(dropdown);
    }, 250);

    nameInput.addEventListener('blur', () => {
      // Let a click on a dropdown button register before it disappears.
      setTimeout(closeDropdown, 150);
    });

    historyToggle.addEventListener('click', async () => {
      const existingPanel = row.querySelector('.guest-history-panel');
      if (existingPanel) {
        existingPanel.remove();
        return;
      }
      const personId = row.dataset.personId;
      if (!personId) return;
      const result = await fetchGuestStays(personId);
      const panel = document.createElement('div');
      panel.className = 'guest-history-panel';
      if (!result || result.stays.length === 0) {
        panel.textContent = 'No past stays on record.';
      } else {
        const items = result.stays
          .map((s) => {
            const tentLabel = UNITS.find((u) => u.id === s.tentId)?.label ?? s.tentId;
            const what = s.eventTitle ?? s.label ?? typeDisplayLabel(s.type);
            return `<li>${s.startDate} · ${tentLabel} · ${what}</li>`;
          })
          .join('');
        panel.innerHTML = `Past stays:<ul>${items}</ul>`;
      }
      row.appendChild(panel);
    });

    container.appendChild(row);
    renumberGuestAriaLabels(container);
  }

  // Which tent (if any) currently shows its full guest cards - every other
  // guest-mode tent that has guests collapses to a one-line summary instead
  // (Sharath's feedback, 2026-09-10: filling one tent while several others
  // sit fully expanded was the core of "too cluttered"). Closure-mode tents
  // (wantsGuestFields() false) ignore this entirely - they're a plain
  // checkbox list, nothing to expand.
  let activeTentId: string | null = null;

  // Explicit user toggles of a group's collapse state, keyed by group name -
  // absent means "use the default" (see isGroupExpanded). Cleared per fresh
  // form session (resetForm/loadIntoForm), not persisted beyond that.
  const groupOverride = new Map<string, boolean>();

  function countGuests(option: HTMLElement): number {
    return option.querySelectorAll('.guest-row').length;
  }

  // "Amit, Guest 2" - falls back to "Guest N" for a still-blank name so the
  // collapsed summary is never just an empty string.
  function guestSummaryText(option: HTMLElement): string {
    return Array.from(option.querySelectorAll<HTMLElement>('.guest-row'))
      .map((row, i) => (row.querySelector('[data-field="name"]') as HTMLInputElement).value.trim() || `Guest ${i + 1}`)
      .join(', ');
  }

  // Renders one tent-option's presentation for the current type + guest
  // count + activeTentId. The checkbox itself stays the one source of truth
  // collectTents()/markOccupiedTents() read (unchanged) - this only decides
  // what's visible: the real checkbox in closure mode, or a hidden checkbox
  // driven by "+Guest"/guest-count in guest mode (see activateGuestTent/
  // onGuestRemoved below, the only two places that ever check/uncheck it in
  // guest mode).
  // The "Family Booking" checkbox (Sharath, 2026-09-10) caps a
  // tent at 1 guest instead of its real physical capacity - purely a form
  // convenience for the common solo-occupancy case, nothing persisted (a
  // booking that ends up with exactly 1 guest already fully captures the
  // outcome on its own). Only selectable while the tent has 0 or 1 guests
  // already (see renderTentState's soloCheckbox.disabled) - a 2nd guest
  // already means "not one person," so the box can't be turned on to
  // contradict data that's already there.
  function effectiveCapacity(option: HTMLElement, unit: Unit): number {
    const solo = option.querySelector('.tent-solo-checkbox') as HTMLInputElement | null;
    return solo?.checked ? 1 : unit.capacity;
  }

  // "●●○" reads as a filled-vs-empty meter at a glance without an icon
  // library (Sharath's feedback, 2026-09-10: "can capacity be a visual
  // indicator," then "remove the numbers next to it" once dots alone were
  // shown) - every unit here tops out at 3, well within the ~4 items a
  // glance can subitize without counting, so the dots alone stay exactly as
  // precise as the digits they replaced, not a fuzzy approximation of them.
  // aria-label on the element using this (see renderTentState) carries the
  // literal count for anyone not reading the glyphs visually.
  function capacityDots(count: number, cap: number): string {
    return '●'.repeat(Math.min(count, cap)) + '○'.repeat(Math.max(cap - count, 0));
  }

  function renderTentState(option: HTMLElement, unit: Unit) {
    const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
    const nameText = option.querySelector('.tent-name-text') as HTMLElement;
    const occupancyText = option.querySelector('.tent-occupancy') as HTMLElement;
    const addGuestBtn = option.querySelector('.add-guest') as HTMLButtonElement;
    const soloWrap = option.querySelector('.tent-solo-check') as HTMLElement;
    const soloCheckbox = option.querySelector('.tent-solo-checkbox') as HTMLInputElement;
    const summaryBtn = option.querySelector('.tent-summary') as HTMLButtonElement;
    const guestsEl = option.querySelector('.guests') as HTMLElement;

    nameText.textContent = unit.shortLabel;

    if (!wantsGuestFields()) {
      checkbox.hidden = false;
      occupancyText.textContent = `(${unit.capacity})`;
      occupancyText.classList.remove('tent-occupancy--dots');
      occupancyText.removeAttribute('aria-label');
      addGuestBtn.hidden = true;
      soloWrap.hidden = true;
      summaryBtn.hidden = true;
      guestsEl.hidden = true;
      return;
    }

    const guestCount = countGuests(option);
    const cap = effectiveCapacity(option, unit);
    checkbox.hidden = true;
    occupancyText.textContent = capacityDots(guestCount, cap);
    occupancyText.classList.add('tent-occupancy--dots');
    occupancyText.setAttribute('aria-label', `${guestCount} of ${cap} occupied`);
    addGuestBtn.hidden = false;
    const atCapacity = guestCount >= cap;
    addGuestBtn.disabled = checkbox.disabled || atCapacity;
    addGuestBtn.textContent = atCapacity ? `Full (${cap})` : '+ Guest';

    // Doesn't apply to a BYOT slot (Sharath, 2026-09-10) - "whole tent for
    // one person/family" is a distinction about one of the farm's own
    // rooms; a guest's own tent has no such ambiguity to resolve.
    soloWrap.hidden = unit.kind === 'byot';
    soloCheckbox.disabled = guestCount >= 2;

    if (guestCount === 0) {
      summaryBtn.hidden = true;
      guestsEl.hidden = true;
    } else if (activeTentId === unit.id) {
      summaryBtn.hidden = true;
      guestsEl.hidden = false;
    } else {
      summaryBtn.hidden = false;
      summaryBtn.textContent = `${guestSummaryText(option)} — tap to edit`;
      guestsEl.hidden = true;
    }
  }

  function renderAllTentStates() {
    for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
      const unit = UNITS.find((u) => u.id === option.dataset.tentId)!;
      renderTentState(option, unit);
    }
    renderGroupStates();
  }

  // True the moment any unit in this group is part of the booking -
  // checkbox.checked is the one flag that already means that uniformly in
  // both guest mode (set via activateGuestTent) and closure mode (the real,
  // user-clicked checkbox), so no mode-specific branching is needed here.
  function groupHasSelection(groupName: string): boolean {
    return Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option')).some((option) => {
      const unit = UNITS.find((u) => u.id === option.dataset.tentId)!;
      if (unit.group !== groupName) return false;
      return (option.querySelector('.tent-checkbox') as HTMLInputElement).checked;
    });
  }

  // A manual toggle wins; absent one, a group defaults open only while it
  // actually has something in it - collapsing every empty group is the
  // point (Sharath's feedback, 2026-09-10: 5 groups' worth of tent rows
  // made the list long), while a group mid-booking never silently hides
  // what's already been entered into it.
  function isGroupExpanded(groupName: string): boolean {
    return groupOverride.has(groupName) ? groupOverride.get(groupName)! : groupHasSelection(groupName);
  }

  function toggleGroup(groupName: string) {
    groupOverride.set(groupName, !isGroupExpanded(groupName));
    renderGroupStates();
  }

  function renderGroupStates() {
    for (const fieldset of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-group-fieldset'))) {
      const groupName = fieldset.dataset.group!;
      const expanded = isGroupExpanded(groupName);
      fieldset.classList.toggle('tent-group-fieldset--expanded', expanded);
      fieldset.querySelector('.tent-group-legend')!.setAttribute('aria-expanded', String(expanded));
    }
  }

  function setActiveTent(tentId: string | null) {
    activeTentId = tentId;
    renderAllTentStates();
  }

  // The sole "+Guest" entry point for a guest-mode tent (button click or a
  // free-cell grid tap via startNewBookingAt) - checks the underlying
  // checkbox, seeds the first guest row if needed, and makes this the one
  // expanded tent.
  function activateGuestTent(option: HTMLElement, unit: Unit) {
    const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
    const guestsEl = option.querySelector('.guests') as HTMLElement;
    if (countGuests(option) >= effectiveCapacity(option, unit)) {
      setActiveTent(unit.id);
      return;
    }
    checkbox.checked = true;
    addGuestRow(guestsEl, {}, () => onGuestRemoved(option, unit));
    setActiveTent(unit.id);
  }

  // A tent with zero guests left isn't part of the booking anymore - uncheck
  // it (collectTents() excludes it) and fall back out of "active" so it
  // reads as idle again instead of an expanded-but-empty card.
  function onGuestRemoved(option: HTMLElement, unit: Unit) {
    const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
    if (countGuests(option) === 0) {
      checkbox.checked = false;
      if (activeTentId === unit.id) activeTentId = null;
    }
    renderAllTentStates();
  }

  function buildTentsFieldset() {
    tentsContainer.innerHTML = '';
    let lastGroup: string | null = null;
    let currentGroupBody: HTMLElement | null = null;
    for (const unit of UNITS) {
      // Each group is its own real <fieldset>/<legend> - UNITS is already
      // in a fixed, group-contiguous order (see accommodation.mjs), so a
      // new fieldset only needs starting when the group actually changes,
      // not a full group-by pass. The legend doubles as a collapse/expand
      // toggle (Sharath's feedback, 2026-09-10: the list got long once
      // there were 5 groups) - a plain <legend> isn't natively interactive,
      // so it gets the same tabindex/role="button"/keydown pattern the
      // grid's own non-button cells already use elsewhere on this page.
      if (unit.group !== lastGroup) {
        const fieldset = document.createElement('fieldset');
        fieldset.className = 'tent-group-fieldset';
        fieldset.dataset.group = unit.group;
        const legend = document.createElement('legend');
        legend.className = 'tent-group-legend';
        legend.tabIndex = 0;
        legend.setAttribute('role', 'button');
        const name = document.createElement('span');
        name.className = 'tent-group-name';
        name.textContent = unit.group;
        const chevron = document.createElement('span');
        chevron.className = 'tent-group-chevron';
        chevron.setAttribute('aria-hidden', 'true');
        chevron.textContent = '›';
        legend.append(name, chevron);
        legend.addEventListener('click', () => toggleGroup(unit.group));
        legend.addEventListener('keydown', (ev) => {
          if (ev.key !== 'Enter' && ev.key !== ' ') return;
          ev.preventDefault();
          toggleGroup(unit.group);
        });
        fieldset.appendChild(legend);
        // The animated element: CSS grid-template-rows 0fr<->1fr (see this
        // class's own CSS comment) needs exactly one child to measure
        // against, so the actual tent-options live one level deeper still
        // (.tent-group-body, with overflow:hidden to clip mid-transition).
        const bodyWrap = document.createElement('div');
        bodyWrap.className = 'tent-group-body-wrap';
        const body = document.createElement('div');
        body.className = 'tent-group-body';
        bodyWrap.appendChild(body);
        fieldset.appendChild(bodyWrap);
        tentsContainer.appendChild(fieldset);
        currentGroupBody = body;
        lastGroup = unit.group;
      }
      const option = document.createElement('div');
      option.className = 'tent-option';
      option.dataset.tentId = unit.id;
      option.innerHTML = `
        <div class="tent-check-row">
          <label class="tent-check">
            <input type="checkbox" class="tent-checkbox" />
            <span class="tent-name-text"></span>
          </label>
          <span class="tent-occupancy"></span>
          <button type="button" class="button add-guest" hidden>+ Guest</button>
        </div>
        <label class="tent-solo-check checkbox-label" hidden>
          <input type="checkbox" class="tent-solo-checkbox" />
          Family Booking — treats this tent as one booking, not per-person
        </label>
        <button type="button" class="tent-summary" hidden></button>
        <p class="tent-conflict-warning" hidden></p>
        <div class="guests" hidden></div>
      `;
      const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
      const checkLabel = option.querySelector('.tent-check') as HTMLLabelElement;
      const addGuestBtn = option.querySelector('.add-guest') as HTMLButtonElement;
      const soloWrap = option.querySelector('.tent-solo-check') as HTMLElement;
      const soloCheckbox = option.querySelector('.tent-solo-checkbox') as HTMLInputElement;
      const summaryBtn = option.querySelector('.tent-summary') as HTMLButtonElement;
      const guestsEl = option.querySelector('.guests') as HTMLElement;

      // The checkbox is only visually hidden in guest mode, not removed -
      // a <label> still forwards a click anywhere on its text to the
      // control it wraps by default, which would silently flip the hidden
      // checkbox to checked with zero guests attached (a phantom "included"
      // tent collectTents() would submit) without ever going through
      // activateGuestTent. Block only that default in guest mode; closure
      // mode leaves it alone since toggling the checkbox by clicking its
      // label text is exactly the real, visible control there.
      checkLabel.addEventListener('click', (ev) => {
        if (wantsGuestFields()) ev.preventDefault();
      });

      // Only ever fires for closure mode (real, user-clicked checkbox) or a
      // programmatic uncheck in guest mode (farmClosureInput's "clear every
      // checked tent" cleanup below) - guest mode's own check-on path goes
      // through activateGuestTent, never through this listener.
      checkbox.addEventListener('change', () => {
        if (!checkbox.checked) {
          guestsEl.innerHTML = '';
          if (activeTentId === unit.id) activeTentId = null;
        }
        renderTentState(option, unit);
      });
      addGuestBtn.addEventListener('click', () => activateGuestTent(option, unit));
      soloCheckbox.addEventListener('change', () => renderTentState(option, unit));
      summaryBtn.addEventListener('click', () => setActiveTent(unit.id));

      currentGroupBody!.appendChild(option);
      renderTentState(option, unit);
    }
    renderGroupStates();
  }

  function wantsGuestFields(): boolean {
    return typeSelect.value !== 'unit-closure';
  }

  // "Farm on Vacation" isn't its own dropdown entry - it's a checkbox that
  // only appears once "Tent closure" is picked, refining a closure from
  // "this one tent" to "the whole farm" (see f-farm-closure-wrap). The
  // underlying data model is unchanged: this still submits as booking type
  // 'farm-closure' (see the submit handler and loadIntoForm below), zero
  // tents assigned, same as before the UI moved it off the dropdown.
  function isFarmClosure(): boolean {
    return typeSelect.value === 'unit-closure' && farmClosureInput.checked;
  }

  function collectTents(): TentAssignment[] {
    const out: TentAssignment[] = [];
    for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
      const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
      if (!checkbox.checked) continue;
      const guests: Guest[] = [];
      for (const row of Array.from(option.querySelectorAll<HTMLElement>('.guest-row'))) {
        const name = (row.querySelector('[data-field="name"]') as HTMLInputElement).value.trim();
        const ageGroup = (row.querySelector('[data-field="ageGroup"]') as HTMLSelectElement).value.trim() as Guest['ageGroup'] | '';
        const gender = (row.querySelector('[data-field="gender"]') as HTMLSelectElement).value.trim();
        const mobileNumber = (row.querySelector('[data-field="mobileNumber"]') as HTMLInputElement).value.trim();
        const preferences = (row.querySelector('[data-field="preferences"]') as HTMLInputElement).value.trim();
        const email = (row.querySelector('[data-field="email"]') as HTMLInputElement).value.trim();
        if (!name && !ageGroup && !gender) continue;
        guests.push({
          personId: row.dataset.personId || undefined,
          name: name || undefined,
          ageGroup: ageGroup || undefined,
          gender: gender || undefined,
          mobileNumber: mobileNumber || undefined,
          preferences: preferences || undefined,
          email: email || undefined,
        });
      }
      out.push({ tentId: option.dataset.tentId!, guests });
    }
    return out;
  }

  function setTents(tents: TentAssignment[]) {
    for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
      const tentId = option.dataset.tentId!;
      const unit = UNITS.find((u) => u.id === tentId)!;
      const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
      const guestsEl = option.querySelector('.guests') as HTMLElement;
      const soloCheckbox = option.querySelector('.tent-solo-checkbox') as HTMLInputElement;
      const assignment = tents.find((t) => t.tentId === tentId);
      checkbox.checked = Boolean(assignment);
      guestsEl.innerHTML = '';
      // Never persisted (see effectiveCapacity's own comment) - always
      // starts unchecked, whether this is a fresh reset or loading an
      // existing booking, rather than guessing intent from guest count.
      soloCheckbox.checked = false;
      if (assignment && wantsGuestFields()) {
        const onRemove = () => onGuestRemoved(option, unit);
        if (assignment.guests.length === 0) addGuestRow(guestsEl, {}, onRemove);
        else for (const g of assignment.guests) addGuestRow(guestsEl, g, onRemove);
      }
    }
    // Expand the first assigned tent, collapse the rest - editing a
    // multi-tent booking used to dump every tent's full guest cards open at
    // once; this is the same "one tent open at a time" default a fresh
    // booking gets via activateGuestTent.
    activeTentId = tents[0]?.tentId ?? null;
    renderAllTentStates();
  }

  // Reflects what's already booked for the form's currently-selected dates
  // directly on the tent checkboxes - disables (and dims) any tent that's
  // taken on any of the selected nights by a *different* booking, so
  // Madhavan sees a conflict before submitting rather than only after the
  // server rejects it (see accommodation-admin.mts's findConflict). Doesn't
  // disable a tent this same booking (editingId) already occupies.
  function markOccupiedTents() {
    const start = startInput.value;
    const nights = Number(nightsInput.value) || 1;
    if (!start) return;
    const selectedNights = new Set(nightsForBooking({ startDate: start, nights } as Booking));
    for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
      const tentId = option.dataset.tentId!;
      const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
      const warning = option.querySelector('.tent-conflict-warning') as HTMLElement;
      const conflict = currentBookings.find(
        (b) => b.id !== editingId && b.type !== 'farm-closure' && b.tents.some((t) => t.tentId === tentId) && nightsForBooking(b).some((n) => selectedNights.has(n)),
      );
      const conflictName = conflict ? (conflict.label ?? conflict.eventTitle ?? conflict.type) : '';
      const blocked = Boolean(conflict) && !checkbox.checked;
      option.classList.toggle('tent-option--occupied', blocked);
      checkbox.disabled = blocked;
      checkbox.title = conflict ? `Already booked: ${conflictName}` : '';
      // A tent already checked before the dates changed underneath it isn't
      // auto-unchecked (that could feel like the form silently discarding a
      // choice) or disabled (blocking a checked box would trap the admin
      // into being unable to uncheck it) - but leaving it checked with only
      // an invisible title attribute as the sole warning meant the tent
      // list looked exactly the same before and after the dates changed,
      // which read as "the view isn't refreshing" even though it was.
      const conflictWhileChecked = Boolean(conflict) && checkbox.checked;
      option.classList.toggle('tent-option--conflict', conflictWhileChecked);
      warning.hidden = !conflictWhileChecked;
      if (conflictWhileChecked) warning.textContent = `⚠ Already booked by ${conflictName} on these dates - uncheck or pick different dates.`;
    }
    // Picks up checkbox.disabled just set above into addGuestBtn.disabled
    // (guest mode's own visible control) - closure mode's real checkbox
    // already reflects it directly, this only matters for guest mode.
    renderAllTentStates();
  }

  // Jumps the calendar view to match the form's selected start date (at
  // whatever granularity - day/week/month - is currently active) so the
  // grid/booking-list/occupied-tent markers reflect that date, instead of
  // silently staying on whatever range was last navigated to (see point 4
  // from Sharath's testing feedback).
  async function handleDateOrNightsChange() {
    if (!startInput.value) return;
    // Not signed in yet - happens when the initial resetForm() call (before
    // the gate/sign-in check at the bottom of this script) syncs the
    // default event's dates. Nothing to refresh against the server yet, and
    // calling loadView() this early would misfire as "session expired".
    if (!getToken()) return;
    const { start, end } = visibleRange();
    if (startInput.value < start || startInput.value > end) {
      anchorDate = startInput.value;
      await loadView();
    } else {
      markOccupiedTents();
    }
  }

  startInput.addEventListener('change', handleDateOrNightsChange);
  nightsInput.addEventListener('change', handleDateOrNightsChange);

  // Drives #f-start.is-empty (see that rule's own comment for why this
  // isn't CSS-only) - 'input' fires on every keystroke/picker interaction,
  // covering manual entry; call sites that set .value programmatically
  // (resetForm, loadIntoForm, startNewBookingAt, syncDatesFromEvent) call
  // this directly too, since a script-assigned value doesn't fire 'input'.
  function syncStartDateEmptyState() {
    startInput.classList.toggle('is-empty', !startInput.value);
  }

  startInput.addEventListener('input', syncStartDateEmptyState);

  // ---- Type-conditional field visibility ----

  function populateEventSelect() {
    eventSelect.innerHTML = EVENTS.map((e) => `<option value="${e.slug}">${e.date} — ${e.title}</option>`).join('');
  }

  function populateMemberSelect() {
    memberSelect.innerHTML = MEMBERS.map((name) => `<option value="${name}">${name}</option>`).join('');
  }

  // A linked public event already has its own dates and duration - EVENTS
  // (built server-side from the events content collection, see this page's
  // frontmatter) is filtered to overnight events only, so every option here
  // has a real nights count to hand over. Called whenever the picked event
  // changes, and once when switching a *new* booking's type to public-event
  // (see typeSelect's listener below) - never during loadIntoForm, which
  // sets startInput/nightsInput from the booking's own saved values instead
  // and doesn't dispatch 'change', so an existing booking's dates are never
  // silently overwritten by whatever the dropdown happens to show.
  function syncDatesFromEvent() {
    const opt = EVENTS.find((e) => e.slug === eventSelect.value);
    if (!opt) return;
    startInput.value = opt.date;
    syncStartDateEmptyState();
    nightsInput.value = String(opt.nights);
    handleDateOrNightsChange();
  }

  eventSelect.addEventListener('change', syncDatesFromEvent);

  function updateFieldVisibility() {
    const type = typeSelect.value as BookingType;
    eventWrap.hidden = type !== 'public-event';
    // member-stay picks from the member directory instead of free text -
    // labelWrap and memberWrap are mutually exclusive, never both shown.
    labelWrap.hidden = type === 'public-event' || type === 'member-stay';
    // "who's coming" reads as a non-sequitur on a closure, which has no
    // guests - a closure's label is a reason, not a guest list.
    labelHint.textContent = type === 'unit-closure' ? '(shown to you only, e.g. the reason)' : "(shown to you only, e.g. who's coming)";
    memberWrap.hidden = type !== 'member-stay';
    exclusiveWrap.hidden = type !== 'private-event';
    farmClosureWrap.hidden = type !== 'unit-closure';
    // Leaving the checkbox checked after switching away from "Tent closure"
    // would silently resurrect it (still checked, just hidden) if the admin
    // switches back to unit-closure later without noticing - uncheck it the
    // moment it's no longer reachable.
    if (type !== 'unit-closure') farmClosureInput.checked = false;
    tentsWrap.hidden = isFarmClosure();
    // Fixed by the linked event, not chosen here - see syncDatesFromEvent.
    startInput.disabled = type === 'public-event';
    nightsInput.disabled = type === 'public-event';
    // A tent's checked state can carry real meaning across a type switch
    // (e.g. "close this tent" stays checked if you switch to a guest type,
    // or vice versa), but leftover *content* from the other mode doesn't:
    // guest rows attached to a tent now being closed would otherwise
    // silently ride along into a closure booking with no guest concept at
    // all, and a checked-but-empty tent coming out of closure mode isn't
    // meaningfully "included" in a guest booking (collectTents() reads
    // checkbox.checked regardless of visibility, so either case would
    // otherwise submit a phantom tent assignment).
    for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
      const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
      const guestsEl = option.querySelector('.guests') as HTMLElement;
      const soloCheckbox = option.querySelector('.tent-solo-checkbox') as HTMLInputElement;
      if (!wantsGuestFields()) {
        guestsEl.innerHTML = '';
        soloCheckbox.checked = false;
      } else if (checkbox.checked && countGuests(option) === 0) {
        checkbox.checked = false;
      }
    }
    // Re-render every tent option for the new type - switches each between
    // closure mode (real checkbox) and guest mode (+Guest/occupancy/
    // accordion), see renderTentState.
    renderAllTentStates();
  }

  typeSelect.addEventListener('change', () => {
    updateFieldVisibility();
    // Only for a fresh pick on a *new* booking - loadIntoForm sets
    // typeSelect.value programmatically (no 'change' event), so an edit in
    // progress never hits this branch.
    if (typeSelect.value === 'public-event' && editingId === null) syncDatesFromEvent();
  });

  farmClosureInput.addEventListener('change', () => {
    // A farm-wide closure has no specific tents - clear any already-checked
    // ones so they don't ride along in the submitted payload despite the
    // now-hidden fieldset (collectTents() reads .checked regardless of
    // visibility, so a stale check here would silently attach a tent to a
    // booking that's supposed to have none).
    if (farmClosureInput.checked) {
      for (const option of Array.from(tentsContainer.querySelectorAll<HTMLElement>('.tent-option'))) {
        const checkbox = option.querySelector('.tent-checkbox') as HTMLInputElement;
        if (checkbox.checked) {
          checkbox.checked = false;
          checkbox.dispatchEvent(new Event('change'));
        }
      }
    }
    updateFieldVisibility();
  });

  // ---- Calendar grid (day/week/month) ----

  function datesInMonth(monthStr: string): string[] {
    const [y, m] = monthStr.split('-').map(Number);
    const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
    return Array.from({ length: daysInMonth }, (_, i) => `${monthStr}-${String(i + 1).padStart(2, '0')}`);
  }

  function addDaysToDateStr(dateStr: string, days: number): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
  }

  function addMonthsToDateStr(dateStr: string, months: number): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const target = new Date(Date.UTC(y, m - 1 + months, 1));
    const daysInTargetMonth = new Date(Date.UTC(target.getUTCFullYear(), target.getUTCMonth() + 1, 0)).getUTCDate();
    target.setUTCDate(Math.min(d, daysInTargetMonth));
    return target.toISOString().slice(0, 10);
  }

  // Monday-start week, so "this week" always reads as a normal work-week
  // block rather than splitting a weekend across two rows.
  function startOfWeek(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay(); // 0=Sun..6=Sat
    return addDaysToDateStr(dateStr, -((dow + 6) % 7));
  }

  function monthKey(dateStr: string): string {
    return dateStr.slice(0, 7);
  }

  // The [start, end] (inclusive) date range the current viewMode+anchorDate
  // covers - the single source of truth every render/fetch/nav function
  // below derives from, so day/week/month can't drift from each other.
  function visibleRange(): { start: string; end: string } {
    if (viewMode === 'day') return { start: anchorDate, end: anchorDate };
    if (viewMode === 'week') {
      const start = startOfWeek(anchorDate);
      return { start, end: addDaysToDateStr(start, 6) };
    }
    const dates = datesInMonth(monthKey(anchorDate));
    return { start: dates[0], end: dates[dates.length - 1] };
  }

  function visibleDates(): string[] {
    const { start, end } = visibleRange();
    const out: string[] = [];
    for (let cur = start; cur <= end; cur = addDaysToDateStr(cur, 1)) out.push(cur);
    return out;
  }

  // A week can straddle two calendar months (e.g. 28 Aug - 3 Sep); day/month
  // views never touch more than one. The admin API only serves "give me
  // this month's bookings", so this is however many separate calls a given
  // view needs to cover its own date range.
  function monthsTouchingRange(start: string, end: string): string[] {
    return [...new Set([monthKey(start), monthKey(end)])];
  }

  function formatDateLabel(dateStr: string, opts: Intl.DateTimeFormatOptions): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-IN', { ...opts, timeZone: 'UTC' });
  }

  function viewRangeLabel(start: string, end: string): string {
    if (viewMode === 'month') return monthDisplayLabel(monthKey(start));
    if (viewMode === 'day') return formatDateLabel(start, { day: 'numeric', month: 'long', year: 'numeric' });
    if (monthKey(start) === monthKey(end)) {
      const monthName = formatDateLabel(start, { month: 'long' });
      return `${Number(start.slice(-2))}–${Number(end.slice(-2))} ${monthName} ${start.slice(0, 4)}`;
    }
    return `${formatDateLabel(start, { day: 'numeric', month: 'short' })} – ${formatDateLabel(end, { day: 'numeric', month: 'short', year: 'numeric' })}`;
  }

  function bookingListHeadingLabel(): string {
    if (viewMode === 'day') return 'Bookings today';
    if (viewMode === 'week') return 'Bookings this week';
    return 'Bookings this month';
  }

  function nightsForBooking(b: Booking): string[] {
    const [y, m, d] = b.startDate.split('-').map(Number);
    const start = Date.UTC(y, m - 1, d);
    return Array.from({ length: b.nights }, (_, i) => new Date(start + i * 86_400_000).toISOString().slice(0, 10));
  }

  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }

  function cellTooltip(b: Booking, tentId: string): string {
    const title = b.type === 'farm-closure' ? typeDisplayLabel(b.type) : (b.label ?? b.eventTitle ?? typeDisplayLabel(b.type));
    const dates = `${b.startDate} · ${b.nights} night${b.nights > 1 ? 's' : ''}`;
    if (b.type === 'farm-closure') return [title, dates, b.note].filter(Boolean).join('\n');
    const guestNames = b.tents
      .find((t) => t.tentId === tentId)
      ?.guests.map((g) => g.name)
      .filter(Boolean)
      .join(', ');
    return [title, dates, guestNames || 'No guests listed'].join('\n');
  }

  // Mon-first single-letter row (M T W T F S S) - the standard compact
  // calendar-header convention; Tue/Thu and Sat/Sun sharing a letter is
  // expected in this style, since column position (not the letter alone)
  // disambiguates.
  const WEEKDAY_LETTERS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];

  function isWeekend(dateStr: string): boolean {
    const [y, m, d] = dateStr.split('-').map(Number);
    const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay(); // 0=Sun..6=Sat
    return dow === 0 || dow === 6;
  }

  function weekdayLetter(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
    return WEEKDAY_LETTERS[(dow + 6) % 7]; // re-index so Monday is 0
  }

  // Day view gets its own wide, full-name-visible list instead of the
  // table: with only one date column, the table's narrow, nowrap cells
  // (built for 7-31 columns at once) had room for nothing but a single
  // status glyph behind a hover-only tooltip - useless on a phone, where
  // hover doesn't even exist. One flex row per tent, each free to wrap
  // text and use the full page width, works the same way on a phone as on
  // a desktop (see Sharath's own ask: "wide... keep mobile in mind").
  function renderDayView() {
    const [date] = visibleDates();
    const today = new Date().toLocaleDateString('en-CA');
    const nightsByBookingId = new Map(currentBookings.map((b) => [b.id, new Set(nightsForBooking(b))]));
    const farmClosure = currentBookings.find((b) => b.type === 'farm-closure' && nightsByBookingId.get(b.id)!.has(date));

    if (farmClosure) {
      // Blocks the whole farm - one row, not one per tent (unlike the
      // table, which is stuck repeating it down every row since that's
      // just how a table works).
      const ariaLabel = cellTooltip(farmClosure, '').replace(/\n/g, ' — ');
      dayView.innerHTML = `
        <div class="day-row day-row--closed" data-booking-id="${farmClosure.id}" tabindex="0" role="button" aria-label="${escapeAttr(ariaLabel)}">
          <div class="day-row-title">${escapeAttr(typeDisplayLabel(farmClosure.type))}</div>
          ${farmClosure.note ? `<div class="day-row-guests">${escapeAttr(farmClosure.note)}</div>` : ''}
        </div>`;
      return;
    }

    let html = '';
    let lastGroup: string | null = null;
    for (const unit of UNITS) {
      // Same grouping as the booking form's Tents picker (Malabar Hut/Banyan
      // Hut/Bamboo Huts/Portable Tents), extended to the calendar's own
      // views (Sharath's feedback, 2026-09-10) - UNITS is already in a
      // fixed, group-contiguous order (see accommodation.mjs), so a heading
      // only needs inserting when the group actually changes. The per-row
      // name switches to shortLabel for the same reason the picker's did:
      // the heading directly above already says "Malabar Hut," repeating it
      // on every row underneath it would just reproduce the redundancy that
      // change fixed there. aria-label keeps the full standalone `label`
      // (below) since a screen reader announcing one row in isolation has
      // no visual heading to inherit context from.
      if (unit.group !== lastGroup) {
        html += `<div class="day-group-heading">${escapeAttr(unit.group)}</div>`;
        lastGroup = unit.group;
      }
      const occupying = currentBookings.find((b) => b.type !== 'farm-closure' && b.tents.some((t) => t.tentId === unit.id) && nightsByBookingId.get(b.id)!.has(date));
      if (occupying) {
        const title = occupying.label ?? occupying.eventTitle ?? typeDisplayLabel(occupying.type);
        const guestNames =
          occupying.tents
            .find((t) => t.tentId === unit.id)
            ?.guests.map((g) => g.name)
            .filter(Boolean)
            .join(', ') || 'No guests listed';
        const ariaLabel = cellTooltip(occupying, unit.id).replace(/\n/g, ' — ');
        html += `
          <div class="day-row day-row--occupied" data-booking-id="${occupying.id}" tabindex="0" role="button" aria-label="${escapeAttr(ariaLabel)}">
            <div class="day-row-tent">${unit.shortLabel}</div>
            <div class="day-row-main">
              <span class="day-row-title">${escapeAttr(title)}</span>
              <span class="day-row-guests">${escapeAttr(guestNames)}</span>
            </div>
          </div>`;
      } else if (date < today) {
        html += `
          <div class="day-row day-row--free-past">
            <div class="day-row-tent">${unit.shortLabel}</div>
            <div class="day-row-main"><span class="day-row-title">—</span></div>
          </div>`;
      } else {
        const ariaLabel = `${unit.label}, ${formatDateLabel(date, { day: 'numeric', month: 'long' })} — free, tap to book`;
        html += `
          <div class="day-row day-row--free" data-tent-id="${unit.id}" data-date="${date}" tabindex="0" role="button" aria-label="${escapeAttr(ariaLabel)}">
            <div class="day-row-tent">${unit.shortLabel}</div>
            <div class="day-row-main"><span class="day-row-title">Free — tap to book</span></div>
          </div>`;
      }
    }
    dayView.innerHTML = html;
  }

  function renderGrid() {
    gridScroll.hidden = viewMode === 'day';
    dayView.hidden = viewMode !== 'day';
    if (viewMode === 'day') {
      renderDayView();
      return;
    }
    const dates = visibleDates();
    // A new booking can never start in the past (see resetForm) - a free
    // cell for a bygone date must not look or act clickable, or tapping it
    // would silently contradict that rule via startNewBookingAt instead of
    // being visibly inert.
    const today = new Date().toLocaleDateString('en-CA');
    const nightsByBookingId = new Map(currentBookings.map((b) => [b.id, new Set(nightsForBooking(b))]));
    // Month's 31 narrow columns only have room for the day-of-month number;
    // day/week have space to also spell out which weekday each column is.
    const headerLabel = (d: string) =>
      viewMode === 'month' ? d.slice(-2) : `<div class="day-letter">${weekdayLetter(d)}</div><div class="day-date">${formatDateLabel(d, { day: 'numeric', month: 'short' })}</div>`;

    const headerColClass = (d: string) => [d < today ? 'col--past' : '', isWeekend(d) ? 'col--weekend' : ''].filter(Boolean).join(' ');
    let headHtml =
      '<tr><th class="unit-col">Tent</th>' + dates.map((d) => `<th class="${headerColClass(d)}">${headerLabel(d)}</th>`).join('') + '</tr>';
    let bodyHtml = '';
    let lastGroup: string | null = null;
    for (const unit of UNITS) {
      // Same grouping/shortLabel reasoning as renderDayView() above - a
      // full-width row (the table equivalent of a heading, since a table
      // row can't sit "above" a set of other rows any other way) spanning
      // every date column. The label cell reuses .unit-col so it stays
      // pinned (position: sticky) during month view's horizontal scroll,
      // same as the real unit-name column below it - a single colspan cell
      // would scroll the label itself out of view along with the dates.
      if (unit.group !== lastGroup) {
        bodyHtml += `<tr class="group-row"><td class="unit-col group-row-label">${escapeAttr(unit.group)}</td>${'<td class="group-row-fill"></td>'.repeat(dates.length)}</tr>`;
        lastGroup = unit.group;
      }
      bodyHtml += `<tr><td class="unit-col">${unit.shortLabel}</td>`;
      for (const date of dates) {
        const weekendClass = isWeekend(date) ? ' col--weekend' : '';
        const farmClosure = currentBookings.find((b) => b.type === 'farm-closure' && nightsByBookingId.get(b.id)!.has(date));
        const occupying = currentBookings.find((b) => b.type !== 'farm-closure' && b.tents.some((t) => t.tentId === unit.id) && nightsByBookingId.get(b.id)!.has(date));
        if (farmClosure) {
          const label = cellTooltip(farmClosure, unit.id).replace(/\n/g, ' — ');
          bodyHtml += `<td class="cell--closed${weekendClass}" data-booking-id="${farmClosure.id}" title="${escapeAttr(cellTooltip(farmClosure, unit.id))}" tabindex="0" role="button" aria-label="${escapeAttr(label)}">✕</td>`;
        } else if (occupying) {
          const label = cellTooltip(occupying, unit.id).replace(/\n/g, ' — ');
          bodyHtml += `<td class="cell--occupied${weekendClass}" data-booking-id="${occupying.id}" title="${escapeAttr(cellTooltip(occupying, unit.id))}" tabindex="0" role="button" aria-label="${escapeAttr(label)}">●</td>`;
        } else if (date < today) {
          bodyHtml += `<td class="cell--free${weekendClass}">·</td>`;
        } else {
          const label = `${unit.label}, ${formatDateLabel(date, { day: 'numeric', month: 'long' })} — free, tap to book`;
          bodyHtml += `<td class="cell--free${weekendClass}" data-tent-id="${unit.id}" data-date="${date}" tabindex="0" role="button" aria-label="${escapeAttr(label)}">·</td>`;
        }
      }
      bodyHtml += '</tr>';
    }
    gridTable.innerHTML = headHtml + bodyHtml;
  }

  let viewOnlyHintTimer: ReturnType<typeof setTimeout> | undefined;

  function activateCell(cell: HTMLElement) {
    if (cell.dataset.bookingId) {
      const booking = currentBookings.find((b) => b.id === cell.dataset.bookingId);
      if (booking) loadIntoForm(booking);
      return;
    }
    if (myRole === 'viewer') {
      // A free cell for a viewer has nothing to open (no booking to view, no
      // permission to create one) - silently doing nothing here reads as a
      // dead/broken click rather than "correctly no permission" (Sharath's
      // testing feedback, 2026-09-10: "nothing pops up"), so say so instead.
      showStatus('View-only access — you can’t create new bookings.');
      clearTimeout(viewOnlyHintTimer);
      viewOnlyHintTimer = setTimeout(hideStatus, 3000);
      return;
    }
    startNewBookingAt(cell.dataset.tentId!, cell.dataset.date!);
  }

  // Delegated once on the table itself (which persists across renderGrid's
  // innerHTML replacements) rather than per-cell, since cells are rebuilt
  // from scratch on every render. Cells are plain <td>s (not real buttons),
  // so click alone left keyboard/screen-reader users with no way to act on
  // one despite the tabindex/role="button"/aria-label added in renderGrid -
  // the keydown listener below is what actually makes that markup mean
  // something rather than just describing intent.
  gridTable.addEventListener('click', (ev) => {
    const cell = (ev.target as HTMLElement).closest('td[data-booking-id], td.cell--free[data-tent-id]') as HTMLElement | null;
    if (cell) activateCell(cell);
  });

  gridTable.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    const cell = (ev.target as HTMLElement).closest('td[data-booking-id], td.cell--free[data-tent-id]') as HTMLElement | null;
    if (!cell) return;
    ev.preventDefault(); // stop Space from scrolling the page
    activateCell(cell);
  });

  // Same activateCell, same delegation reasoning, just against day view's
  // own row markup (a div, not a td) instead of the table's cells.
  dayView.addEventListener('click', (ev) => {
    const row = (ev.target as HTMLElement).closest('.day-row[data-booking-id], .day-row--free[data-tent-id]') as HTMLElement | null;
    if (row) activateCell(row);
  });

  dayView.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    const row = (ev.target as HTMLElement).closest('.day-row[data-booking-id], .day-row--free[data-tent-id]') as HTMLElement | null;
    if (!row) return;
    ev.preventDefault();
    activateCell(row);
  });

  // Tapping a free grid cell starts a new booking pre-filled with that tent
  // and date, instead of requiring a scroll to a separate form section and
  // re-entering both from memory - the "grid and form are disconnected"
  // fix from this page's design critique (2026-08). Only free cells for
  // today or later ever reach here (see renderGrid) - a new booking must
  // never start in the past (the same rule resetForm's own `min` already
  // enforces for manual date entry); backfilling a historical booking is
  // only ever done by editing an existing one, never by creating a new one.
  function startNewBookingAt(tentId: string, date: string) {
    resetForm();
    startInput.value = date;
    syncStartDateEmptyState();
    handleDateOrNightsChange();
    const option = tentsContainer.querySelector<HTMLElement>(`.tent-option[data-tent-id="${tentId}"]`);
    const unit = UNITS.find((u) => u.id === tentId);
    const checkbox = option?.querySelector<HTMLInputElement>('.tent-checkbox');
    if (option && unit && checkbox && !checkbox.disabled) {
      if (wantsGuestFields()) activateGuestTent(option, unit);
      else {
        checkbox.checked = true;
        checkbox.dispatchEvent(new Event('change'));
      }
    }
    openBookingModal();
  }

  function renderBookingList() {
    bookingListHeading.textContent = bookingListHeadingLabel();
    const dates = new Set(visibleDates());
    const relevant = currentBookings.filter((b) => nightsForBooking(b).some((n) => dates.has(n)));

    bookingList.innerHTML = '';
    if (relevant.length === 0) {
      bookingList.innerHTML = '<p class="hint">No bookings in this view.</p>';
      return;
    }
    for (const b of [...relevant].sort((a, c) => a.startDate.localeCompare(c.startDate))) {
      const card = document.createElement('div');
      card.className = 'booking-card';
      const title = b.eventTitle ?? b.label ?? typeDisplayLabel(b.type);
      const tentNames = b.tents.map((t) => UNITS.find((u) => u.id === t.tentId)?.label ?? t.tentId).join(', ') || '(whole farm)';
      const canWrite = canWriteType(b.type);
      card.innerHTML = `
        <div>
          <strong>${title}</strong>
          <div class="meta">${b.startDate} · ${b.nights} night${b.nights > 1 ? 's' : ''} · ${tentNames}${b.exclusive ? ' · exclusive' : ''}</div>
        </div>
        <div class="actions">
          <button type="button" class="button edit-booking">${canWrite ? 'Edit' : 'View'}</button>
          ${canWrite ? '<button type="button" class="button button--danger cancel-booking">Cancel</button>' : ''}
        </div>
      `;
      card.querySelector('.edit-booking')!.addEventListener('click', () => loadIntoForm(b));
      card.querySelector('.cancel-booking')?.addEventListener('click', () => cancelBooking(b));
      bookingList.appendChild(card);
    }
  }

  // Custom overlay instead of a native prompt() - a past booking's cancel
  // reason needs a real multi-line field, which prompt() can't give, and a
  // native dialog blocks all further page script until dismissed.
  function showReasonPrompt(message: string): Promise<string | null> {
    return new Promise((resolve) => {
      const overlay = document.createElement('div');
      overlay.className = 'reason-overlay';
      overlay.innerHTML = `
        <div class="reason-overlay-card">
          <p>${message}</p>
          <textarea rows="3" autofocus></textarea>
          <div class="reason-overlay-actions">
            <button type="button" class="button" data-action="cancel">Never mind</button>
            <button type="button" class="button button--primary" data-action="confirm">Confirm</button>
          </div>
        </div>
      `;
      const textarea = overlay.querySelector('textarea') as HTMLTextAreaElement;
      const close = (value: string | null) => {
        overlay.remove();
        resolve(value);
      };
      overlay.querySelector('[data-action="cancel"]')!.addEventListener('click', () => close(null));
      overlay.querySelector('[data-action="confirm"]')!.addEventListener('click', () => close(textarea.value.trim() || null));
      document.body.appendChild(overlay);
      textarea.focus();
    });
  }

  async function cancelBooking(b: Booking) {
    let reason: string | undefined;
    if (b.isPast) {
      const entered = await showReasonPrompt('This stay has already happened. Why is it being cancelled?');
      if (!entered) return; // either "Never mind" or an empty reason - both abort
      reason = entered;
    } else if (!confirm('Cancel this booking?')) {
      return;
    }
    try {
      const res = await authedFetch('/api/accommodation-admin/bookings/delete', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: b.id, reason }),
      });
      if (!res.ok) throw new Error('Request failed');
      await loadView();
    } catch (err) {
      const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
      if (!handled) alert('Failed to cancel booking — try again.');
    }
  }

  // Hides "Public event" from the Type dropdown entirely when there's
  // nothing upcoming to link it to, rather than leaving a picker that opens
  // onto an empty select - the option itself has no value once EVENTS is
  // empty. Editing an *existing* public-event booking still needs the
  // option available regardless (see loadIntoForm), so this only ever runs
  // for the new-booking state (resetForm) and once at load.
  function updatePublicEventOptionVisibility() {
    const hasUpcomingEvents = EVENTS.length > 0;
    publicEventTypeOption.hidden = !hasUpcomingEvents;
    publicEventTypeOption.disabled = !hasUpcomingEvents;
  }

  // A cheap dirty-check for the discard-confirmation guard below: every
  // field that matters, serialized to one string, compared against a
  // baseline snapshot taken right after the form was last put into a known
  // state (end of resetForm for a new booking, end of loadIntoForm for an
  // edit - see both). Reuses collectTents() rather than re-deriving guest
  // data separately, so this can never disagree with what Save would
  // actually submit.
  let formBaseline = '';

  function formSnapshot(): string {
    return JSON.stringify({
      type: typeSelect.value,
      label: labelInput.value,
      member: memberSelect.value,
      exclusive: exclusiveInput.checked,
      farmClosure: farmClosureInput.checked,
      eventSlug: eventSelect.value,
      start: startInput.value,
      nights: nightsInput.value,
      note: noteInput.value,
      reason: reasonInput.value,
      tents: collectTents(),
    });
  }

  function isFormDirty(): boolean {
    return formSnapshot() !== formBaseline;
  }

  // Backdrop click, the X button, and Escape all used to discard a
  // partially-filled booking with zero warning (Sharath's feedback,
  // 2026-09-10, filed as issue #152) - a native confirm() matches this
  // page's own existing precedent for a plain yes/no gate (see
  // cancelBooking's non-past-booking path), rather than introducing a new
  // custom-overlay component for a case that doesn't need a text input the
  // way the reason-for-a-past-edit prompt does. Only asks when there's
  // actually something to lose - an untouched or already-viewed-unchanged
  // form closes immediately, same as before this fix.
  function attemptCloseModal() {
    if (isFormDirty() && !confirm('Discard changes to this booking?')) return;
    resetForm();
    closeBookingModal();
  }

  function loadIntoForm(b: Booking) {
    editingId = b.id;
    groupOverride.clear(); // fresh session - groups default open/closed by selection, not a stale manual toggle
    const canEdit = canWriteType(b.type);
    formHeading.textContent = canEdit ? 'Edit booking' : 'View booking';
    cancelEditBtn.hidden = false;
    cancelEditBtn.textContent = canEdit ? 'Cancel edit' : 'Close';
    reasonWrap.hidden = !b.isPast;
    reasonInput.value = '';
    // An existing public-event booking must stay viewable/editable even if
    // its event no longer has any upcoming overnight dates to offer a *new*
    // booking (see updatePublicEventOptionVisibility) - re-enabling here is
    // scoped to this one edit; resetForm re-applies the hide-if-empty rule
    // the moment this edit ends.
    if (b.type === 'public-event') {
      publicEventTypeOption.hidden = false;
      publicEventTypeOption.disabled = false;
    }
    // "Farm on Vacation" has no dropdown entry of its own (see
    // isFarmClosure) - a saved farm-closure booking loads back as
    // "Tent closure" with the checkbox ticked, since that's the only UI
    // path that produces it.
    typeSelect.value = b.type === 'farm-closure' ? 'unit-closure' : b.type;
    farmClosureInput.checked = b.type === 'farm-closure';
    updateFieldVisibility();
    // #f-event only lists upcoming events (see the EVENTS prop's own
    // comment) - editing a booking whose linked event has since happened
    // (e.g. correcting a booking after the fact) would otherwise set
    // eventSelect.value to a slug with no matching <option>, which a native
    // <select> silently ignores rather than erroring. The select would then
    // just keep showing whatever option it already had selected, and saving
    // would silently reassign the booking to that wrong event. Rebuild from
    // the upcoming-only list first (clears any previously-injected option
    // from an earlier edit), then inject this booking's own event if it
    // isn't already there, so eventSelect.value always lands on the right
    // one.
    populateEventSelect();
    if (b.eventSlug) {
      if (!Array.from(eventSelect.options).some((o) => o.value === b.eventSlug)) {
        const opt = document.createElement('option');
        opt.value = b.eventSlug;
        opt.textContent = b.eventTitle ?? b.eventSlug;
        eventSelect.insertBefore(opt, eventSelect.firstChild);
      }
      eventSelect.value = b.eventSlug;
    }
    labelInput.value = b.label ?? '';
    if (b.type === 'member-stay' && b.label) memberSelect.value = b.label;
    exclusiveInput.checked = Boolean(b.exclusive);
    // No lower bound while editing - a booking that already starts in the
    // past (e.g. correcting a historical entry) must stay editable without
    // the browser's date-picker fighting the "no past dates" rule that only
    // makes sense for *new* bookings (see resetForm below).
    startInput.removeAttribute('min');
    startInput.value = b.startDate;
    syncStartDateEmptyState();
    nightsInput.value = String(b.nights);
    noteInput.value = b.note ?? '';
    setTents(b.tents);
    markOccupiedTents();
    refreshTypeOptions();
    setFormEditable(canEdit); // must run last - overrides markOccupiedTents' own enable/disable calls
    formBaseline = formSnapshot(); // after every field above is populated - "dirty" means changed since this load, not "non-empty"
    openBookingModal();
  }

  function resetForm() {
    editingId = null;
    groupOverride.clear(); // fresh session - see loadIntoForm's same reset
    formHeading.textContent = 'New booking';
    cancelEditBtn.hidden = true;
    cancelEditBtn.textContent = 'Cancel edit';
    reasonWrap.hidden = true;
    reasonInput.value = '';
    form.reset();
    setFormEditable(true); // form.reset() clears values, not a prior view-only edit's disabled state
    populateEventSelect(); // drops any event injected by loadIntoForm for a past-event edit
    syncStartDateEmptyState();
    typeSelect.value = 'casual-stay';
    updatePublicEventOptionVisibility();
    refreshTypeOptions();
    // Linger booking (casual-stay) is the default type, but a restricted
    // role without casual-stay in its allowedTypes can't land there - fall
    // through to the first type it's actually allowed to create instead of
    // opening a new-booking form defaulted to a type its first save would
    // 403 on.
    if (typeSelect.selectedOptions[0]?.disabled) {
      const firstAllowed = Array.from(typeSelect.options).find((o) => !o.disabled);
      if (firstAllowed) typeSelect.value = firstAllowed.value;
    }
    updateFieldVisibility();
    // A new booking can't start in the past - today, in the visitor's own
    // local timezone, computed fresh on every reset rather than baked in at
    // build time (this page is statically prerendered).
    startInput.min = new Date().toLocaleDateString('en-CA'); // en-CA formats as YYYY-MM-DD
    // Only public-event's dates come from the linked event - casual-stay
    // (the default type) leaves Start date/Nights blank for the admin to
    // fill in themselves, same as every other non-public-event type.
    setTents([]);
    markOccupiedTents();
    formError.hidden = true;
    formBaseline = formSnapshot(); // after every field above is reset - see loadIntoForm's matching line
  }

  cancelEditBtn.addEventListener('click', () => {
    resetForm();
    closeBookingModal();
  });

  newBookingBtn.addEventListener('click', () => {
    resetForm();
    openBookingModal();
  });

  bookingModalBackdrop.addEventListener('click', attemptCloseModal);

  bookingModalClose.addEventListener('click', attemptCloseModal);

  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && !bookingModal.hidden) {
      attemptCloseModal();
      return;
    }
    trapModalFocus(ev);
  });

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    formError.hidden = true;

    if (!reasonWrap.hidden && !reasonInput.value.trim()) {
      formError.hidden = false;
      formError.textContent = 'A reason is required to edit a past booking.';
      return;
    }

    const type = (isFarmClosure() ? 'farm-closure' : typeSelect.value) as BookingType;
    const payload: Partial<Booking> & { id?: string; reason?: string } = {
      id: editingId ?? undefined,
      type,
      startDate: startInput.value,
      nights: Number(nightsInput.value),
      tents: collectTents(),
      note: noteInput.value.trim() || undefined,
      reason: reasonWrap.hidden ? undefined : reasonInput.value.trim(),
    };
    if (type === 'public-event') {
      // Read the slug straight from the select rather than only trusting a
      // lookup in the upcoming-only EVENTS list - loadIntoForm injects a
      // synthetic option (with its own label) for a booking whose linked
      // event has since happened, and that option's slug has no entry in
      // EVENTS. Falling back to the selected option's own text keeps
      // eventTitle correct for that case too, instead of silently dropping
      // both fields.
      const slug = eventSelect.value || undefined;
      const opt = EVENTS.find((e) => e.slug === slug);
      payload.eventSlug = slug;
      payload.eventTitle = opt?.title ?? eventSelect.options[eventSelect.selectedIndex]?.textContent ?? undefined;
    } else if (type === 'member-stay') {
      payload.label = memberSelect.value || undefined;
    } else {
      payload.label = labelInput.value.trim() || undefined;
    }
    if (type === 'private-event') payload.exclusive = exclusiveInput.checked;

    const url = editingId ? '/api/accommodation-admin/bookings/update' : '/api/accommodation-admin/bookings';
    try {
      const res = await authedFetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        formError.hidden = false;
        formError.textContent = data.error ?? 'Failed to save — try again.';
        return;
      }
      resetForm();
      closeBookingModal();
      await loadView();
    } catch (err) {
      const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
      if (!handled) {
        formError.hidden = false;
        formError.textContent = 'Failed to save — try again.';
      }
    }
  });

  // ---- View loading/navigation ----

  function monthDisplayLabel(monthStr: string): string {
    const [y, m] = monthStr.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  }

  function shiftView(direction: 1 | -1) {
    if (viewMode === 'day') anchorDate = addDaysToDateStr(anchorDate, direction);
    else if (viewMode === 'week') anchorDate = addDaysToDateStr(anchorDate, direction * 7);
    else anchorDate = addMonthsToDateStr(anchorDate, direction);
    loadView();
  }

  async function loadView() {
    gate.hidden = true;
    forbidden.hidden = true;
    app.hidden = false;
    const { start, end } = visibleRange();
    monthLabel.textContent = viewRangeLabel(start, end);
    showStatus('Loading…');

    try {
      const months = monthsTouchingRange(start, end);
      const responses = await Promise.all(months.map((m) => authedFetch(`/api/accommodation-admin/bookings?month=${m}`)));
      if (responses.some((res) => !res.ok)) {
        showStatus('Failed to load bookings — try refreshing.');
        return;
      }
      const bodies = (await Promise.all(responses.map((res) => res.json()))) as {
        units: Unit[];
        bookings: Booking[];
        access: { role: Role; allowedTypes: string[] | null };
      }[];
      // Dedupe by id - a week straddling two months fetches both, and a
      // booking touching both (e.g. a stay spanning the boundary) would
      // otherwise appear in each month's response.
      const byId = new Map(bodies.flatMap((body) => body.bookings).map((b) => [b.id, b]));
      currentBookings = [...byId.values()];
      // Every month's response carries the same access record for this
      // signed-in caller - any one of them is fine to read it from.
      if (bodies[0]?.access) {
        myRole = bodies[0].access.role;
        myAllowedTypes = bodies[0].access.allowedTypes;
      }
      newBookingBtn.hidden = myRole === 'viewer';
      hideStatus();
      renderGrid();
      renderBookingList();
      markOccupiedTents();
    } catch (err) {
      const handled = err instanceof Error && (err.message === 'Unauthorized' || err.message === 'Forbidden');
      if (!handled) showStatus('Failed to load bookings — try refreshing.');
    }
  }

  document.getElementById('prev-month')!.addEventListener('click', () => shiftView(-1));
  document.getElementById('next-month')!.addEventListener('click', () => shiftView(1));

  for (const btn of viewToggleButtons) {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.view as ViewMode;
      if (mode === viewMode) return;
      viewMode = mode;
      for (const b of viewToggleButtons) b.classList.toggle('view-toggle-btn--active', b === btn);
      loadView();
    });
  }

  function handleCredentialResponse(response: { credential: string }) {
    sessionStorage.setItem(STORAGE_KEY, response.credential);
    loadView();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  useDifferentAccountBtn.addEventListener('click', () => {
    clearToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    showGate();
  });

  populateEventSelect();
  populateMemberSelect();
  buildTentsFieldset();
  resetForm();

  if (getToken()) {
    loadView();
  } else {
    showGate();
  }
</script>
