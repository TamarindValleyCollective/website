---
// Usage & limits (internal): how much of each free tier and credit balance the
// website is using, which warnings are active, and when each domain expires.
// Backed by netlify/functions/usage-admin.mts; the hourly alert emails come from
// usage-alerts.mts and use the same rules (scripts/lib/usage-rules.mjs).
//
// Same shell as the other internal tools: Google Sign-In gated, one sign-in per
// tab (scripts/lib/staff-client.mjs), unlinked, noindex. Everything the server
// returns is placed with textContent only, never as HTML.
//
// Two kinds of figures, labelled as such on the page: MEASURED (our own call
// counts and the Supabase size) and TYPED IN (read off a provider's own
// dashboard by an admin, because we deliberately hold no credentials for those
// services). Status is always a word plus an icon, never colour alone.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
---

<StaffLayout title="Usage & limits" description="Free-tier and credit usage." current="usage">
  <section class="usage section wrapper">
    <h1>Usage &amp; limits</h1>
    <p id="intro" class="hint">Sign in to see how much of our free tiers and credits we are using.</p>

    <SignInGate forbiddenWhat="Usage & limits" />

    <p id="status" class="hint" hidden></p>

    <div id="content" hidden>
      <section aria-labelledby="alerts-title" class="block" data-tour="alerts">
        <h2 id="alerts-title">Needs attention</h2>
        <div id="alerts" role="status"></div>
      </section>

      <details class="glossary">
        <summary>What these words mean</summary>
        <dl>
          <div><dt>Credit</dt><dd>A prepaid balance a service draws down as the website uses it.</dd></div>
          <div><dt>Egress</dt><dd>Data a service sends out. Supabase allows 5 GB a month on the free plan.</dd></div>
          <div><dt>Deploy</dt><dd>Publishing a new version of the website. Every merge to the main branch is one, and costs Netlify 15 credits.</dd></div>
          <div><dt>Estimated</dt><dd>Worked out from the last figure someone typed in, minus what the website has measurably used since.</dd></div>
          <div><dt>Warning and critical</dt><dd>Warning is about 70% used (or 30% left). Critical is about 90% used (or 10% left).</dd></div>
        </dl>
      </details>
      <section aria-labelledby="services-title" class="block" data-tour="services">
        <h2 id="services-title">Services</h2>
        <div id="cards" class="cards"></div>
      </section>

      <section aria-labelledby="domains-title" class="block" data-tour="domains">
        <h2 id="domains-title">Domain renewals</h2>
        <div id="domains" class="card pad"><p class="muted">Checking the registries…</p></div>
      </section>

      <section aria-labelledby="wa-health-title" class="block">
        <h2 id="wa-health-title">WhatsApp account health</h2>
        <div id="wa-health" class="card pad"><p class="muted">Loading…</p></div>
      </section>

      <section id="admin" aria-labelledby="admin-title" class="block" hidden>
        <h2 id="admin-title">Update readings</h2>
        <p class="muted lead">Some services have no safe way for us to read their usage automatically, so an admin types the figure in from the provider's own dashboard. Warnings use the latest entry, so keep them fresh.</p>
        <div id="readings" class="forms"></div>
        <h2 class="sub">Prices &amp; limits</h2>
        <form id="settings-form" class="card pad form" novalidate>
          <p class="muted">Turns Anthropic token counts into an estimated spend, and sets a daily request limit for Gemini. Both are optional; warnings that depend on a missing one stay quiet.</p>
          <div class="fields">
            <label>Anthropic input price <span class="muted">(USD per million tokens)</span><input type="number" step="any" min="0" inputmode="decimal" id="price-input" /></label>
            <label>Anthropic output price <span class="muted">(USD per million tokens)</span><input type="number" step="any" min="0" inputmode="decimal" id="price-output" /></label>
            <label>Gemini daily request limit <span class="muted">(from your Google AI Studio project)</span><input type="number" step="1" min="1" inputmode="numeric" id="gemini-limit" /></label>
          </div>
          <div class="actions"><button type="submit" class="button">Save</button><span id="settings-msg" class="msg" role="status"></span></div>
        </form>
      </section>

      <p class="muted foot" id="foot"></p>
      <p id="signed-in" class="note"><button type="button" id="sign-out" class="link-button">Sign out</button></p>
    </div>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .usage.section.wrapper {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .usage .muted {
    color: var(--tvc-ink-soft);
  }

  .usage .lead {
    margin: 0 0 16px;
    max-width: 62ch;
  }

  .usage h2 {
    font-size: var(--text-lg);
    margin: 0 0 12px;
  }

  .usage h2.sub {
    margin-top: 28px;
  }

  .usage .block {
    margin-bottom: 32px;
  }


  .usage .card.pad {
    padding: 16px 18px;
  }


  .usage .note,
  .usage .foot {
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  /* On top of the shared .link-button (StaffLayout): this one sits flush with its text. */
  #staff-main .usage .link-button {
    padding: 12px 0;
  }

  /* ---- status pill: a word and an icon, colour is only reinforcement ---- */
  .usage .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .usage .status-pill svg {
    flex: none;
  }

  .usage .status-pill--ok {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .usage .status-pill--warn {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .usage .status-pill--critical {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .usage .status-pill--none {
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
  }

  /* ---- alerts ---- */
  .usage .alert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .usage .alert {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    padding: 14px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
  }

  /* severity is the tint and the pill's word, not a coloured stripe */
  .usage .alert--warn {
    border-color: var(--tvc-orange);
    background: var(--tvc-orange-tint);
  }

  .usage .alert--critical {
    border-color: var(--tvc-error-border);
    background: var(--tvc-error-bg);
  }

  .usage .alert-summary {
    margin: 0 0 10px;
    font-weight: 600;
  }

  .usage .alert-action {
    margin: 8px 0 0;
    font-size: var(--text-sm);
  }

  .usage .alert-why > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .usage .alert-why > summary::after {
    content: '+';
    margin-left: 8px;
    font-size: var(--text-lg);
    line-height: 1;
  }

  .usage .alert-why[open] > summary::after {
    content: '\2212';
  }

  .usage .alert-why .alert-detail {
    margin: 0;
  }

  .usage .alert-more {
    margin: 6px 0 0;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .usage .alert .link-button {
    margin-top: 4px;
    font-size: var(--text-sm);
  }

  /* a short plain-words list for readers who do not live in these dashboards */
  .usage .glossary {
    margin: 0 0 20px;
    font-size: var(--text-sm);
  }

  .usage .glossary > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .usage .glossary dl {
    margin: 0 0 4px;
    display: grid;
    gap: 8px;
    max-width: 62ch;
  }

  .usage .glossary dt {
    font-weight: 600;
  }

  .usage .glossary dd {
    margin: 0;
    color: var(--tvc-ink-soft);
  }

  .usage .alert-title {
    font-weight: 600;
    margin: 0;
  }

  .usage .alert-detail {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .usage .all-clear {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    margin: 0;
  }

  /* ---- service cards ---- */
  /* a grid, so cards line up in rows; each card keeps its own height, so opening one doesn't stretch its neighbours */
  .usage .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    align-items: start;
  }

  /* the part of a card that is always on show has one height for every service (title, badge, figure,
     bar and one line of context), so a row of collapsed cards is level whatever each one measures */
  .usage .svc-top {
    min-height: 11.9rem;
    margin-bottom: 12px;
  }

  .usage .svc {
    display: flex;
    flex-direction: column;
  }

  .usage .svc {
    padding: 18px 20px;
  }

  .usage .svc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .usage .svc-title {
    margin: 0;
    font-size: var(--text-md);
  }

  .usage .svc-kind {
    margin: 2px 0 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  /* how a card's figures get updated: Automatic / Live (no hands) vs Manual (a person types them in) */
  .usage .mode {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px 2px 7px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .usage .mode svg {
    width: 13px;
    height: 13px;
    flex: none;
  }

  .usage .mode--auto,
  .usage .mode--live {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .usage .mode--manual,
  .usage .mode--mixed {
    background: var(--tvc-stone);
    color: var(--tvc-ink);
  }

  .usage .svc-fresh {
    margin: 0 0 12px;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--tvc-ink-soft);
  }

  .usage .svc-fresh--late {
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  /* A card is a summary. Click anywhere on it to open its details (one at a time). The motion is the
     iOS ease: fast out of the gate, a long soft landing, no overshoot, and the same path back. */
  .usage .svc {
    position: relative;
    cursor: pointer;
    transition: transform 140ms ease-out;
  }

  .usage .svc[data-pressed] {
    transform: scale(0.985);
  }

  .usage .svc:has(.svc-toggle:focus-visible) {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .usage .svc-foot {
    margin-top: auto;
    border-top: 1px solid var(--tvc-line);
  }

  .usage .svc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: left;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .usage .svc:hover .svc-toggle {
    color: var(--tvc-ink);
  }

  .usage .svc-toggle:focus-visible {
    outline: none; /* the whole card shows the focus ring */
  }

  .usage .svc-toggle::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-right: 3px;
    border-right: 1.75px solid currentColor;
    border-bottom: 1.75px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .usage .svc[data-open='true'] .svc-toggle::after {
    transform: translateY(2px) rotate(225deg);
  }

  /* 0fr to 1fr animates the height to the content's real size, and a click mid-flight turns around from where it is */
  .usage .svc-more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms cubic-bezier(0.32, 0.72, 0, 1);
    cursor: auto;
  }

  .usage .svc[data-open='true'] .svc-more {
    grid-template-rows: 1fr;
  }

  .usage .svc-more-clip {
    min-height: 0;
    overflow: hidden;
  }

  .usage .svc-more-body {
    padding-top: 10px;
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  .usage .svc[data-open='true'] .svc-more-body {
    opacity: 1;
    transition: opacity 300ms ease-out 120ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .usage .svc,
    .usage .svc-more,
    .usage .svc-toggle::after {
      transition-duration: 1ms;
    }

    .usage .svc-more-body,
    .usage .svc[data-open='true'] .svc-more-body {
      transition-duration: 1ms;
      transition-delay: 0s;
    }
  }

  .usage .hero {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.15;
    color: var(--tvc-ink);
  }

  .usage .hero-sub {
    margin: 2px 0 10px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  /* meter: a thin track with a fill; the numbers beside it carry the value */
  .usage .meter {
    height: 8px;
    border-radius: 4px;
    background: var(--tvc-stone);
    overflow: hidden;
    margin: 6px 0 4px;
  }

  .usage .meter-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--tvc-green);
  }

  .usage .meter-fill--warn {
    background: var(--tvc-orange);
  }

  .usage .meter-fill--critical {
    background: var(--tvc-error-text);
  }

  .usage .meter-row-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .meter-row .meter {
    margin-top: 4px;
  }

  .usage .meter-caption {
    margin: 0 0 12px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 12px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--tvc-line);
  }

  .usage .stat dt {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .stat dd {
    margin: 2px 0 0;
    font-weight: 600;
    font-size: var(--text-base);
  }

  .usage .stat dd small {
    display: block;
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .spark {
    margin: 12px 0 0;
  }

  .usage .spark svg {
    display: block;
    width: 100%;
    height: 44px;
  }

  .usage .spark-line {
    fill: none;
    stroke: var(--tvc-green);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .usage .spark-base {
    stroke: var(--tvc-line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .usage .spark figcaption {
    margin-top: 4px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .svc-note {
    margin: 12px 0 0;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  /* ---- domains table ---- */
  .usage #domains,
  .usage #wa-health {
    overflow-x: auto;
  }

  .usage td small {
    display: block;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .usage th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--tvc-ink-soft);
    padding: 0 12px 8px 0;
  }

  .usage td {
    padding: 8px 12px 8px 0;
    border-top: 1px solid var(--tvc-line);
    vertical-align: middle;
  }

  /* ---- forms ---- */
  .usage .forms {
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  .usage details.card > summary {
    padding: 14px 18px;
    cursor: pointer;
    font-weight: 600;
  }

  .usage details.card[open] > summary {
    border-bottom: 1px solid var(--tvc-line);
  }

  .usage .form {
    max-width: 720px;
  }

  .usage details .form {
    padding: 16px 18px;
  }

  .usage .fields {
    display: grid;
    gap: 14px;
    margin: 12px 0;
  }

  .usage label {
    display: grid;
    gap: 4px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .usage label .muted {
    font-weight: 400;
  }

  .usage input {
    font: inherit;
    min-height: 44px;
    padding: 8px 10px;
    max-width: 280px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  .usage input:focus-visible,
  .usage summary:focus-visible,
  .usage .link-button:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .usage .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .usage .msg {
    font-size: var(--text-sm);
    color: var(--tvc-green-dark);
  }

  .usage .msg--error {
    color: var(--tvc-error-text);
  }

  @media (max-width: 520px) {
    .usage .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import { StaffAuthError, clearStepUp, clearToken, decodeTokenEmail, getToken, setToken, staffFetch } from '../../../scripts/lib/staff-client.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const SVG = 'http://www.w3.org/2000/svg';

  // ---- tiny DOM helper: text only, never HTML -----------------------------
  type Kid = Node | string | null | undefined | false;
  function h(tag: string, props: { class?: string; text?: string; attrs?: Record<string, string> } = {}, ...kids: Kid[]): HTMLElement {
    const el = document.createElement(tag);
    if (props.class) el.className = props.class;
    if (props.text !== undefined) el.textContent = props.text;
    for (const [k, v] of Object.entries(props.attrs ?? {})) el.setAttribute(k, v);
    for (const kid of kids) if (kid) el.append(kid);
    return el;
  }

  // ---- formatting ----------------------------------------------------------
  const nf = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 });
  // Typed-in readings can be small and fractional (1.2 GB of egress, $4.98 of credit): whole numbers would misreport them.
  const nfSmall = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 2 });
  const amount = (n: number) => (n >= 100 ? nf : nfSmall).format(n);
  // "640 of 1,000"; but when top-ups or carried-over credits put the balance above the plan's included credits,
  // "1,394 (1,000 included + extra)" rather than the nonsense of "1,394 of 1,000".
  const leftOf = (value: number, limit: number) => (value > limit ? `${amount(value)} (${amount(limit)} included + extra)` : `${amount(value)} of ${amount(limit)}`);
  const compact = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)}B` : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e4 ? `${(n / 1e3).toFixed(0)}k` : nf.format(n));
  const usd = (n: number) => `$${n.toFixed(2)}`;
  const mb = (bytes: number) => `${nf.format(bytes / 1024 / 1024)} MB`;
  const dateText = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const daysAgo = (iso: string) => Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000));
  const ago = (iso: string) => (daysAgo(iso) === 0 ? 'today' : daysAgo(iso) === 1 ? 'yesterday' : `${daysAgo(iso)} days ago`);

  type Level = 'warn' | 'critical' | null;
  const LABEL = { ok: 'OK', warn: 'Warning', critical: 'Critical', none: 'Not set up' } as const;

  // Icons give status a second signal besides colour.
  const ICON: Record<string, string> = {
    ok: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/>',
    warn: '<path d="M12 4l9 16H3z"/><path d="M12 10v4M12 17.2v.1"/>',
    critical: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16v.1"/>',
    none: '<circle cx="12" cy="12" r="9"/><path d="M8 12h8"/>',
    auto: '<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v5h-5"/>',
    live: '<circle cx="12" cy="12" r="2.5"/><path d="M6.3 6.3a8 8 0 0 0 0 11.4M17.7 6.3a8 8 0 0 1 0 11.4"/>',
    manual: '<path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 7l3 3"/>',
    mixed: '<path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 7l3 3"/>',
  };
  function icon(kind: string): SVGElement {
    const svg = document.createElementNS(SVG, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('width', '16');
    svg.setAttribute('height', '16');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    svg.innerHTML = ICON[kind]; // fixed constants above, no server data
    return svg;
  }
  function pill(level: Level | 'none', okText?: string): HTMLElement {
    const kind = level ?? 'ok';
    return h('span', { class: `status-pill status-pill--${kind}` }, icon(kind), okText && kind === 'ok' ? okText : LABEL[kind]);
  }

  // A meter shows `fraction` (0..1) of a track. The words beside it carry the numbers.
  function meter(fraction: number, level: Level, label: string, valueText: string): HTMLElement {
    const pctNow = Math.max(0, Math.min(100, Math.round(fraction * 100)));
    const track = h('div', { class: 'meter', attrs: { role: 'meter', 'aria-valuemin': '0', 'aria-valuemax': '100', 'aria-valuenow': String(pctNow), 'aria-valuetext': valueText, 'aria-label': label } });
    const fill = h('div', { class: `meter-fill${level ? ` meter-fill--${level}` : ''}` });
    fill.style.width = `${pctNow}%`;
    track.append(fill);
    return track;
  }

  // A plain trend line: one series, no axes, last point marked, with a text equivalent.
  function sparkline(points: { label: string; value: number }[], what: string, unit: (n: number) => string): HTMLElement {
    const W = 300;
    const H = 44;
    const pad = 5;
    const max = Math.max(1, ...points.map((p) => p.value));
    const x = (i: number) => pad + (i * (W - 2 * pad)) / Math.max(1, points.length - 1);
    const y = (v: number) => H - pad - (v / max) * (H - 2 * pad);
    const svg = document.createElementNS(SVG, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('preserveAspectRatio', 'none');
    const peak = points.reduce((a, b) => (b.value > a.value ? b : a), points[0]);
    const total = points.reduce((s, p) => s + p.value, 0);
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', `${what}, last ${points.length} days: ${unit(total)} in total, busiest ${peak.label} with ${unit(peak.value)}.`);
    const base = document.createElementNS(SVG, 'line');
    base.setAttribute('class', 'spark-base');
    base.setAttribute('x1', String(pad));
    base.setAttribute('x2', String(W - pad));
    base.setAttribute('y1', String(H - pad));
    base.setAttribute('y2', String(H - pad));
    const line = document.createElementNS(SVG, 'polyline');
    line.setAttribute('class', 'spark-line');
    line.setAttribute('points', points.map((p, i) => `${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' '));
    svg.append(base, line);
    const lastP = points[points.length - 1];
    return h('figure', { class: 'spark', attrs: { style: 'margin-left:0;margin-right:0' } }, svg, h('figcaption', { text: `${what}, last ${points.length} days · busiest: ${peak.label} (${unit(peak.value)}) · latest: ${unit(lastP.value)}` }));
  }

  const dayLabel = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });

  function stat(label: string, value: string, sub?: string): HTMLElement {
    return h('div', { class: 'stat' }, h('dt', { text: label }), h('dd', { text: value }, sub ? h('small', { text: sub }) : null));
  }

  // How a card's figures are kept up to date, shown as a badge plus when the next update is due.
  type Mode = 'auto' | 'live' | 'manual' | 'mixed';
  type Kind = string | { mode: Mode; text: string; fresh?: { text: string; late?: boolean }[] };
  const MODE_LABEL: Record<Mode, string> = { auto: 'Automatic', live: 'Live', manual: 'Manual', mixed: 'Part manual' };
  let nextRunAt: string | null = null; // from the server: when usage-collect next runs
  let runEveryHours = 6;

  function inDuration(ms: number): string {
    const mins = Math.max(1, Math.round(ms / 60_000));
    return mins < 60 ? `${mins}m` : `${Math.floor(mins / 60)}h ${mins % 60}m`;
  }
  const clock = (iso: string) => new Date(iso).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });

  // "Next update about 11:30 pm (in 3h 12m)"; flagged late when the last automatic reading is more than two cycles old.
  function nextAutoUpdate(lastAt?: string): { text: string; late?: boolean } {
    const late = lastAt ? Date.now() - new Date(lastAt).getTime() > 2 * runEveryHours * 3_600_000 + 3_600_000 : false;
    if (!nextRunAt) return { text: `Updates automatically every ${runEveryHours} hours` };
    const eta = `Next update about ${clock(nextRunAt)} (in ${inDuration(new Date(nextRunAt).getTime() - Date.now())})`;
    return late ? { text: `${eta}. Last update was ${ago(lastAt as string)}, so a run was missed.`, late: true } : { text: eta };
  }

  // "Update due Fri 17 Oct" for a typed-in reading, counted from when it was entered.
  function nextManualUpdate(capturedAt: string | undefined, everyDays: number | null | undefined): { text: string; late?: boolean } {
    if (!capturedAt || !everyDays) return { text: 'Updated by hand when the figure changes' };
    const due = new Date(new Date(capturedAt).getTime() + everyDays * 86_400_000);
    const dueText = due.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
    return Date.now() > due.getTime() ? { text: `Update overdue (was due ${dueText}) · an admin types it in below`, late: true } : { text: `Update due ${dueText} · an admin types it in below` };
  }

  // A card is a summary (title, status, one headline figure, one bar) and, behind a "Details" toggle,
  // everything else: how it updates, charts, breakdowns, caveats. `body` is the summary parts, then MORE,
  // then the detail parts. Anything overdue is lifted back into the summary so it is never hidden.
  const MORE = Symbol('more');
  type Part = Kid | typeof MORE;
  function card(title: string, kind: Kind, level: Level | 'none', ...body: Part[]): HTMLElement {
    const k = typeof kind === 'string' ? { mode: null, text: kind, fresh: undefined } : kind;
    const badge = k.mode ? h('span', { class: `mode mode--${k.mode}` }, icon(k.mode), MODE_LABEL[k.mode]) : null;
    const at = body.indexOf(MORE);
    const summary = (at === -1 ? body : body.slice(0, at)) as Kid[];
    const more = (at === -1 ? [] : body.slice(at + 1)) as Kid[];
    const fresh = k.fresh ?? [];
    const freshLine = (f: { text: string; late?: boolean }) => h('p', { class: `svc-fresh${f.late ? ' svc-fresh--late' : ''}`, text: f.text });
    const open = title === openCardTitle; // a re-render (after a saved reading) keeps the open card open, with no animation
    const bodyId = `svc-more-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
    const toggle = h('button', { class: 'svc-toggle', attrs: { type: 'button', 'aria-expanded': String(open), 'aria-controls': bodyId, 'aria-label': `${title}: details` } }, h('span', { text: 'Details' }));
    const bodyEl = h('div', { class: 'svc-more', attrs: { id: bodyId } }, h('div', { class: 'svc-more-clip' }, h('div', { class: 'svc-more-body' }, h('p', { class: 'svc-fresh', text: k.text }), ...fresh.filter((f) => !f.late).map(freshLine), ...more)));
    if (!open) bodyEl.setAttribute('inert', ''); // closed content is out of the tab order and invisible to screen readers
    return h(
      'article',
      { class: 'card svc', attrs: { 'data-open': String(open), 'data-level': String(level ?? 'ok') } },
      h('div', { class: 'svc-top' },
        h('div', { class: 'svc-head' }, h('h3', { class: 'svc-title', text: title }), pill(level)),
        h('p', { class: 'svc-kind' }, badge),
        ...summary,
        ...fresh.filter((f) => f.late).map(freshLine),
      ),
      h('div', { class: 'svc-foot' }, toggle, bodyEl),
    );
  }

  // One card open at a time. The whole card is the target (the button inside is for keyboards and screen
  // readers); the open details are not, so they can be read and selected without folding shut.
  let openCardTitle: string | null = null;
  function setCardOpen(card: HTMLElement, open: boolean) {
    card.dataset.open = String(open);
    card.querySelector('.svc-toggle')?.setAttribute('aria-expanded', String(open));
    card.querySelector('.svc-more')?.toggleAttribute('inert', !open);
  }
  function onCardsClick(e: MouseEvent) {
    const target = e.target as Element;
    const card = target.closest<HTMLElement>('.svc');
    if (!card || target.closest('.svc-more')) return;
    if (window.getSelection()?.toString()) return; // the end of a text selection is not a click
    const opening = card.dataset.open !== 'true';
    document.querySelectorAll<HTMLElement>('#cards .svc[data-open="true"]').forEach((c) => setCardOpen(c, false));
    if (opening) setCardOpen(card, true);
    openCardTitle = opening ? (card.querySelector('.svc-title')?.textContent ?? null) : null;
  }
  // Open a card from outside it (an alert's "See the card" link): fold the others, open this one, bring it into view.
  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  function openCardByTitle(title: string) {
    const card = [...document.querySelectorAll<HTMLElement>('#cards .svc')].find((c) => c.querySelector('.svc-title')?.textContent === title);
    if (!card) return;
    document.querySelectorAll<HTMLElement>('#cards .svc[data-open="true"]').forEach((c) => c !== card && setCardOpen(c, false));
    setCardOpen(card, true);
    openCardTitle = title;
    card.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'start' });
    card.querySelector<HTMLElement>('.svc-toggle')?.focus({ preventScroll: true });
  }

  // The figures a person types in live in forms far down the page; this takes them there, open and ready to type.
  let canConfigure = false; // only admins have the forms
  function enterReadingButton(meterId: string): HTMLElement | null {
    if (!canConfigure) return null;
    return linkButton('Enter a new reading', () => {
      const form = document.getElementById(`reading-${meterId}`) as HTMLDetailsElement | null;
      if (!form) return;
      form.open = true;
      form.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'center' });
      form.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });
  }
  const shortDay = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });

  // Press feedback on pointer-down (before release), like a tap on a physical button.
  function onCardsPress(e: PointerEvent) {
    const card = (e.target as Element).closest<HTMLElement>('.svc');
    if (card && !(e.target as Element).closest('.svc-more')) card.dataset.pressed = 'true';
  }
  function onCardsRelease() {
    document.querySelectorAll<HTMLElement>('#cards .svc[data-pressed]').forEach((c) => delete c.dataset.pressed);
  }


  // ---- the cards -------------------------------------------------------------
  type Overview = any;

  function anthropicCard(o: Overview): HTMLElement {
    const a = o.anthropic;
    const est = a.credit.estimate;
    const reading = a.credit.reading;
    const parts: Kid[] = [];
    const more: Kid[] = [];
    let level: Level | 'none' = est?.level ?? null;
    if (a.billingErrorsRecent > 0) level = 'critical';
    if (!reading && !a.billingErrorsRecent) level = 'none';

    if (a.billingErrorsRecent > 0) {
      parts.push(h('p', { class: 'hero-sub', text: `Credits look exhausted: ${a.billingErrorsRecent} request${a.billingErrorsRecent === 1 ? ' was' : 's were'} refused for billing reasons since yesterday.` }));
    }
    if (est) {
      parts.push(h('p', { class: 'hero', text: `about ${usd(est.remaining)}` }), h('p', { class: 'hero-sub', text: `credit left, estimated, of ${usd(est.total ?? est.remaining)}` }));
      if (est.total) parts.push(meter(est.remaining / est.total, est.level, 'Anthropic credit left', `${Math.round((est.remaining / est.total) * 100)}% left`));
      more.push(h('p', { class: 'meter-caption', text: `${Math.round((est.remaining / est.total) * 100)}% left · based on the ${usd(reading.value)} entered ${ago(reading.capturedAt)}, minus ${usd(est.spent)} of metered usage since` }));
    } else if (reading) {
      parts.push(h('p', { class: 'hero', text: usd(reading.value) }), h('p', { class: 'hero-sub', text: `entered ${ago(reading.capturedAt)}. Add the token prices below to turn usage into a live estimate.` }));
    } else {
      parts.push(h('p', { class: 'hero-sub', text: 'No credit balance entered yet. An admin can add it below so we can warn before it runs out.' }));
    }
    if (a.credit.expiresInDays !== null) {
      (a.credit.expiresInDays <= 30 ? parts : more).push(h('p', { class: 'hero-sub', text: a.credit.expiresInDays < 0 ? `Credit expired on ${dateText(reading.expiresOn)}.` : `Credit expires on ${dateText(reading.expiresOn)} (${a.credit.expiresInDays} day${a.credit.expiresInDays === 1 ? '' : 's'}).` }));
    }
    if (est && reading) parts.push(h('p', { class: 'hero-sub', text: `Balance entered ${ago(reading.capturedAt)}` }));
    more.push(
      h('dl', { class: 'stats' },
        stat('Today', nf.format(a.today.requests), `${compact(a.today.input_tokens + a.today.output_tokens)} tokens${a.today.costUsd !== null ? ` · ${usd(a.today.costUsd)}` : ''}`),
        stat('Last 7 days', nf.format(a.last7.requests), `${compact(a.last7.input_tokens + a.last7.output_tokens)} tokens${a.last7.costUsd !== null ? ` · ${usd(a.last7.costUsd)}` : ''}`),
        stat('This month', nf.format(a.month.requests), `${compact(a.month.input_tokens + a.month.output_tokens)} tokens${a.month.costUsd !== null ? ` · ${usd(a.month.costUsd)}` : ''}`),
      ),
      sparkline(a.requestsSeries.map((p: any) => ({ label: dayLabel(p.day), value: p.value })), 'Requests per day', (n) => `${nf.format(n)} request${n === 1 ? '' : 's'}`),
    );
    if (a.chatCapHitsToday || a.searchFallbackCapHitsToday) {
      parts.push(h('p', { class: 'svc-note', text: `Today the site turned away ${a.chatCapHitsToday} chat message(s) and ${a.searchFallbackCapHitsToday} paid search fallback(s) because a daily cap was reached.` }));
    }
    more.push(h('p', { class: 'svc-note', text: 'Counts only what the website itself sends (chat and the search fallback), not other uses of the same key. Dollar figures are estimates from the prices below.' }));
    more.push(enterReadingButton('anthropic.credit_remaining_usd'));
    return card('Anthropic (Claude)', { mode: 'mixed', text: 'Usage measured live · credit balance typed in', fresh: [{ text: 'Usage: updates on every request the site makes.' }, nextManualUpdate(reading?.capturedAt, a.credit.meter.refreshEveryDays)] }, level, ...parts, MORE, ...more);
  }

  function geminiCard(o: Overview): HTMLElement {
    const g = o.gemini;
    const limit: number | null = g.dailyLimit;
    const frac = limit ? g.today.requests / limit : 0;
    const level: Level = g.today.quotaExhausted > 0 ? 'warn' : limit && frac >= 0.9 ? 'critical' : limit && frac >= 0.7 ? 'warn' : null;
    const more: Kid[] = [];
    const parts: Kid[] = [h('p', { class: 'hero', text: nf.format(g.today.requests) }), h('p', { class: 'hero-sub', text: limit ? `requests today of ${nf.format(limit)} allowed` : 'requests today (no daily limit entered)' })];
    if (limit) parts.push(meter(frac, level, 'Gemini requests used today', `${Math.round(frac * 100)}% of today's limit`), h('p', { class: 'meter-caption', text: `${Math.round(frac * 100)}% of today's limit` }));
    if (g.today.quotaExhausted > 0) parts.push(h('p', { class: 'hero-sub', text: `Google refused ${g.today.quotaExhausted} request(s) today: the free quota ran out.` }));
    more.push(
      h('dl', { class: 'stats' },
        stat('Last 7 days', nf.format(g.last7.requests), 'requests'),
        stat('Refused (7 days)', nf.format(g.last7.quotaExhausted), 'free quota hit'),
        stat('Fell back to paid', nf.format(g.last7.fallbacksToAnthropic), 'searches, 7 days'),
      ),
      sparkline(g.requestsSeries.map((p: any) => ({ label: dayLabel(p.day), value: p.value })), 'Requests per day', (n) => `${nf.format(n)} request${n === 1 ? '' : 's'}`),
      h('p', { class: 'svc-note', text: 'Powers the "Ask AI" search answer. Days here are UTC; Google resets its own daily quota at a different hour.' }),
    );
    return card('Google Gemini', { mode: 'live', text: 'Measured by the website', fresh: [{ text: 'Updates on every search the site makes.' }] }, level, ...parts, MORE, ...more);
  }

  // Typed-in meters that appear inside their service's card (or as the Netlify card) instead of on their own.
  const FOLDED_INTO_SERVICE_CARD = new Set(['typesafe.credit_remaining_usd', 'supabase.egress_gb', 'netlify.credits_remaining']);

  // Cards go critical, then warning, then the rest, so the one that needs a look is never behind calm ones.
  const urgencyRank = (el: HTMLElement) => ({ critical: 2, warn: 1 } as Record<string, number>)[el.dataset.level ?? ''] ?? 0;

  // The more serious of several levels (a card shows the worst of what it measures).
  const worst = (...levels: (Level | 'none')[]): Level => (levels.includes('critical') ? 'critical' : levels.includes('warn') ? 'warn' : null);

  function typesafeCard(o: Overview): HTMLElement {
    const t = o.typesafe;
    const m = o.manual.find((x: any) => x.id === 'typesafe.credit_remaining_usd');
    const est = t.creditEstimate;
    // Jev calls cost a few thousandths of a cent each, so whole cents would always read $0.00.
    const spend = (n: number) => (n < 0.01 ? `$${n.toFixed(4)}` : usd(n));
    const failing = t.today.errors >= 5 && t.today.errors / Math.max(t.today.requests, 1) >= 0.2;
    const level: Level = worst(failing ? 'warn' : null, est?.level ?? null);
    const calls = `${nf.format(t.today.requests)} call${t.today.requests === 1 ? '' : 's'} today${t.today.errors ? `, ${nf.format(t.today.errors)} failed` : ''}`;
    const parts: Kid[] = [];
    if (est) {
      parts.push(h('p', { class: 'hero', text: `about ${spend(est.remaining)}` }), h('p', { class: 'hero-sub', text: `credit left, estimated, of ${usd(est.total ?? est.remaining)}` }));
      if (est.total) parts.push(meter(est.remaining / est.total, est.level, 'TypeSafe credit left', `${Math.round((est.remaining / est.total) * 100)}% left`));
      parts.push(h('p', { class: 'hero-sub', text: `${m?.reading ? `entered ${ago(m.reading.capturedAt)} · ` : ''}${calls}` }));
    } else {
      parts.push(h('p', { class: 'hero', text: nf.format(t.today.requests) }), h('p', { class: 'hero-sub', text: calls.replace(/^\d[\d,]* /, '') }), h('p', { class: 'hero-sub', text: 'No credit entered yet. Enter the amount you loaded once, and the page subtracts what the site spends.' }));
    }
    const more: Kid[] = [];
    if (est) more.push(h('p', { class: 'meter-caption', text: `${Math.round((est.remaining / (est.total || est.remaining || 1)) * 100)}% left · based on the ${usd(est.readingValue)} entered ${ago(est.readingAt)}, minus ${spend(est.spent)} of metered usage since` }));
    more.push(
      h('dl', { class: 'stats' },
        stat('Last 7 days', nf.format(t.last7.requests), `${spend(t.last7.costUsd)} · ${nf.format(t.last7.errors)} failed`),
        stat('This month', nf.format(t.month.requests), `${compact(t.month.inputTokens)} tokens · ${spend(t.month.costUsd)}`),
      ),
      sparkline(t.requestsSeries.map((p: any) => ({ label: dayLabel(p.day), value: p.value })), 'Calls per day', (n) => `${nf.format(n)} call${n === 1 ? '' : 's'}`),
      h('p', { class: 'svc-note', text: 'Reads each inbound WhatsApp message in shadow mode (nothing acts on them yet). Billed per input token only. TypeSafe has no balance API, so the credit left is what you entered at the last top-up minus what this site has spent since (its own metered calls at the published price). Enter a new balance after each top-up; it needs no other upkeep. Anything TypeSafe is used for outside the website is not counted.' }),
    );
    more.push(enterReadingButton('typesafe.credit_remaining_usd'));
    return card('TypeSafe (Jev)', { mode: 'mixed', text: 'Usage measured live · credit entered at each top-up', fresh: [{ text: 'Usage: updates on every WhatsApp message read.' }, { text: m?.reading ? `Credit: ${usd(m.reading.value)} entered ${ago(m.reading.capturedAt)}.` : 'Credit: not entered yet.' }] }, level, ...parts, MORE, ...more);
  }

  function supabaseCard(o: Overview): HTMLElement {
    const s = o.supabase;
    if (!s.reading) return card('Supabase database', { mode: 'auto', text: 'Measured every 6 hours', fresh: [nextAutoUpdate()] }, 'none', h('p', { class: 'hero-sub', text: 'No measurement recorded yet.' }));
    const frac = s.reading.limitBytes ? s.reading.bytes / s.reading.limitBytes : 0;
    // Size and growth can each be the reason to look; the card shows the worse of the two.
    const days: number | null = s.growth?.daysToFull ?? null;
    const growthLevel: Level = days !== null && days <= 21 ? 'critical' : days !== null && days <= 60 ? 'warn' : null;
    const sizeLevel: Level = frac >= 0.9 ? 'critical' : frac >= 0.7 ? 'warn' : null;
    const egress = o.manual.find((x: any) => x.id === 'supabase.egress_gb'); // billed egress: no API, so it is typed in
    const level: Level = worst(sizeLevel, growthLevel, egress?.level ?? null);
    const size = (bytes: number) => (bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : mb(bytes));
    const lasts = (d: number) => {
      const n = Math.max(1, Math.round(d));
      return d < 90 ? `${n} day${n === 1 ? '' : 's'}` : d < 730 ? `${Math.round(d / 30)} months` : 'over 2 years';
    };
    // Summary: size, its bar and one line on how fast it is growing. The rest is behind Details.
    const parts: Kid[] = [h('p', { class: 'hero', text: mb(s.reading.bytes) }), h('p', { class: 'hero-sub', text: s.reading.limitBytes ? `of ${mb(s.reading.limitBytes)} on the free plan` : 'database size' })];
    const more: Kid[] = [];
    if (s.reading.limitBytes) parts.push(meter(frac, level, 'Supabase database size', `${Math.round(frac * 100)}% of the free size`));
    if (!s.growth) {
      parts.push(h('p', { class: 'hero-sub', text: 'Growth shows after about a week.' }));
    } else if (days === null) {
      parts.push(h('p', { class: 'hero-sub', text: `Not growing over the last ${Math.round(s.growth.spanDays)} days.` }));
    } else {
      const perWeek = s.growth.bytesPerDay * 7;
      parts.push(h('p', { class: 'hero-sub', text: `+${perWeek < 100 * 1024 ? '<0.1' : nf.format(perWeek / 1024 / 1024)} MB a week · full in ${lasts(days)}` }));
    }
    if (egress?.level && egress.reading?.limit) {
      parts.push(h('p', { class: 'svc-fresh svc-fresh--late', text: `Egress is at ${Math.round((egress.reading.value / egress.reading.limit) * 100)}% of its monthly limit.` }));
    }
    more.push(h('p', { class: 'meter-caption', text: `${frac < 0.01 ? 'under 1' : Math.round(frac * 100)}% used · measured ${ago(s.reading.capturedAt)}` }));
    // One reading every 6 hours, but the chart (and its caption) counts days: keep each day's last reading.
    const perDay = new Map<string, any>();
    for (const p of s.history) perDay.set(String(p.at).slice(0, 10), p);
    if (perDay.size > 1) {
      more.push(sparkline([...perDay.values()].map((p: any) => ({ label: dateText(p.at), value: p.bytes / 1024 / 1024 })), 'Database size in MB', (n) => `${nf.format(n)} MB`));
    }
    const tables: { name: string; bytes: number; rows: number }[] = s.tables?.list ?? [];
    if (tables.length) {
      // One row per table: names are long, so they get the full card width rather than a narrow stat column.
      // Grouped in one block so the two-column layout of an open card never splits the list.
      more.push(h('div', {}, h('p', { class: 'hero-sub', text: 'Biggest tables' }), ...tables.slice(0, 5).map((t) => h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: t.name }), h('span', { text: `${size(t.bytes)} · ~${nf.format(t.rows)} rows` }))))));
    }
    if (s.connections?.max) {
      const cf = s.connections.inUse / s.connections.max;
      more.push(h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: 'Database connections open' }), h('span', { text: `${s.connections.inUse} of ${s.connections.max}` })), meter(cf, s.connections.level, 'Supabase database connections', `${Math.round(cf * 100)}% of the connection limit`)));
    }
    if (egress?.reading?.limit) {
      const ef = egress.reading.value / egress.reading.limit;
      more.push(h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: 'Egress this month (typed in)' }), h('span', { text: `${amount(egress.reading.value)} of ${amount(egress.reading.limit)} GB` })), meter(ef, egress.level, 'Supabase egress used', `${Math.round(ef * 100)}% of the monthly egress`)), h('p', { class: 'meter-caption', text: `Typed in ${ago(egress.reading.capturedAt)} from ${egress.where}.${daysAgo(egress.reading.capturedAt) > 35 ? ' That is over a month old: update it.' : ''}` }));
    } else {
      more.push(h('p', { class: 'hero-sub', text: `Egress (data sent out, free plan: 5 GB a month) can't be measured automatically. Read it at ${egress?.where ?? 'the Supabase dashboard'} and enter it below.` }));
    }
    more.push(enterReadingButton('supabase.egress_gb'));
    more.push(h('p', { class: 'svc-note', text: 'The free plan stops accepting new data at the limit. Growth is a straight-line estimate from the last two weeks of readings, so a bulk import skews it. Table sizes include indexes. Egress cannot be measured automatically, so it is typed in. The Supabase dashboard is the authority.' }));
    return card('Supabase database', { mode: 'auto', text: 'Measured every 6 hours', fresh: [nextAutoUpdate(s.reading.capturedAt)] }, level, ...parts, MORE, ...more);
  }

  // Netlify's cycle dates come as Pacific-time ISO strings; read the calendar date straight from the
  // string (not the browser's timezone) so it matches Netlify's page. The API gives the NEXT period's
  // start, so the cycle's last day is `offset` = -1 from it.
  function cycleDay(iso: string, offset = 0): string {
    const d = new Date(`${iso.slice(0, 10)}T00:00:00Z`);
    d.setUTCDate(d.getUTCDate() + offset);
    return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  }

  // Netlify, read automatically: production deploys (a flat 15 credits each), build minutes, the last
  // deploy. The credit balance itself has no API (and bandwidth, functions and requests cost credits too),
  // so the typed-in balance stays in the details, next to how much of it the deploys explain.
  function netlifyCard(o: Overview, typed: any | null): HTMLElement {
    const d = o.netlify.deploys;
    const a = o.netlify.activity;
    const r = typed?.reading ?? null;
    const level: Level = worst(d.level, d.onPaceToExceed ? 'warn' : null, typed?.level ?? null);
    const parts: Kid[] = [
      h('p', { class: 'hero', text: `${nf.format(d.credits)} credits` }),
      h('p', { class: 'hero-sub', text: d.basis === 'balance' ? `used on deploys, of ${nf.format(Math.round(d.pool))} available` : `used on deploys, of ${nf.format(d.allowance)} included` }),
      meter(d.fraction, d.level, 'Netlify credits used on deploys', `${Math.round(d.fraction * 100)}% of the allowance`),
      d.onPaceToExceed
        ? h('p', { class: 'hero-sub svc-fresh--late', text: `${nf.format(d.deploys)} deploys · runs out ~${shortDay(d.exhaustsAt)}` })
        : h('p', { class: 'hero-sub', text: `${nf.format(d.deploys)} deploy${d.deploys === 1 ? '' : 's'} · resets ${cycleDay(d.cycleEnd)}` }),
    ];
    if (r?.staleForCycle) parts.push(h('p', { class: 'svc-fresh svc-fresh--late', text: 'The typed-in balance is from a previous billing cycle: update it.' }));

    const more: Kid[] = [
      h('dl', { class: 'stats' },
        stat('Production deploys', nf.format(d.deploys), `${nf.format(d.credits)} credits`),
        stat('Failed (free)', nf.format(a.production_failed ?? 0), 'production deploys'),
        stat('Previews (free)', nf.format(a.previews ?? 0), 'deploy previews'),
      ),
    ];
    const bm = a.build_minutes;
    if (bm) {
      more.push(h('dl', { class: 'stats' }, stat('Build minutes', nf.format(bm.current), `this cycle · last cycle ${nf.format(bm.previous)}`), stat('Deploy time', a.avg_deploy_seconds ? `${a.avg_deploy_seconds}s` : 'n/a', 'average, production')));
    }
    if (a.last_deploy) {
      more.push(h('p', { class: 'hero-sub', text: `Last deploy: ${a.last_deploy.context === 'production' ? 'production' : 'preview'}, ${a.last_deploy.state}, ${ago(a.last_deploy.at)}.` }));
    }
    more.push(h('p', { class: 'hero-sub', text: d.exhaustsAt ? `At this pace the ${nf.format(Math.round(d.remaining))} credits left run out around ${shortDay(d.exhaustsAt)}, before the cycle ends on ${cycleDay(d.cycleEnd)} (${nf.format(d.deploys)} deploys in ${Math.floor(d.elapsedDays)} days).` : d.projected !== null ? `Pace: ${nf.format(d.deploys)} deploys in ${Math.floor(d.elapsedDays)} days is about ${nf.format(Math.round(d.projected))} credits by the end of the cycle (${cycleDay(d.cycleEnd)}).` : `A pace estimate appears three days into each cycle. It resets ${cycleDay(d.cycleEnd)}.` }));
    if (r?.limit && !r.staleForCycle) {
      const used = 1 - r.value / r.limit;
      more.push(
        h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: "Netlify's own balance (typed in)" }), h('span', { text: `${leftOf(r.value, r.limit)} left` })), meter(used, typed.level, 'Netlify credits used', `${Math.round(used * 100)}% used`)),
        h('p', { class: 'meter-caption', text: `Typed in ${ago(r.capturedAt)} from ${typed.where}. ${r.value > r.limit ? "It is above the plan's included credits, so the extra is from top-ups or carried-over credits, and the run-out date uses it. " : ''}Whatever it shows beyond deploys is bandwidth, functions and requests: they cost credits but Netlify's API reports none of them.` }),
      );
    } else if (!r) {
      more.push(h('p', { class: 'hero-sub', text: `Bandwidth, functions and requests also cost credits, and Netlify's API reports none of them. Type in the balance from ${typed?.where ?? 'Netlify → Team → Billing and usage'} to see the full picture here.` }));
    }
    more.push(enterReadingButton('netlify.credits_remaining'));
    more.push(h('p', { class: 'svc-note', text: "A successful production deploy costs 15 credits; failed deploys, rollbacks and deploy previews cost nothing (Netlify's docs, \"How credits work\"). Counted from the site's deploy list every 6 hours. Each merge to main is one production deploy, so batching changes into fewer merges is the main way to save credits." }));

    const fresh = [nextAutoUpdate(a.capturedAt)];
    if (r) fresh.push(nextManualUpdate(r.capturedAt, typed.refreshEveryDays));
    return card('Netlify', { mode: 'mixed', text: 'Deploys and build minutes read from Netlify · balance typed in', fresh }, level, ...parts, MORE, ...more);
  }

  function r2Card(o: Overview): HTMLElement {
    const r = o.r2.reading;
    const gb = (b: number) => `${(b / 1e9).toFixed(2)} GB`;
    const frac = r.limitBytes ? r.bytes / r.limitBytes : 0;
    const parts: Kid[] = [h('p', { class: 'hero', text: gb(r.bytes) }), h('p', { class: 'hero-sub', text: r.limitBytes ? `of ${gb(r.limitBytes)} free` : 'stored' })];
    const more: Kid[] = [];
    if (r.limitBytes) parts.push(meter(frac, r.level, 'Cloudflare R2 storage used', `${Math.round(frac * 100)}% of the free allowance`));
    if (r.limitBytes) more.push(h('p', { class: 'meter-caption', text: `${frac < 0.01 ? 'under 1' : Math.round(frac * 100)}% used · ${nf.format(r.objects)} object${r.objects === 1 ? '' : 's'} in ${r.buckets} bucket${r.buckets === 1 ? '' : 's'}` }));
    parts.push(h('p', { class: 'hero-sub', text: `${nf.format(r.objects)} file${r.objects === 1 ? '' : 's'} in ${r.buckets} bucket${r.buckets === 1 ? '' : 's'}` }));
    more.push(h('p', { class: 'svc-note', text: `Read from Cloudflare's analytics ${ago(r.capturedAt)}, refreshed every 6 hours. Past the free allowance R2 storage is billed per GB-month; the Cloudflare dashboard is the authority.` }));
    return card('Cloudflare R2 storage', { mode: 'auto', text: 'Read from Cloudflare', fresh: [nextAutoUpdate(r.capturedAt)] }, r.level, ...parts, MORE, ...more);
  }

  function resendCard(o: Overview): HTMLElement {
    const r = o.resend;
    const rows: [string, any][] = [['This month', r.monthly], ['Today', r.daily]];
    const level: Level = r.monthly?.level === 'critical' || r.daily?.level === 'critical' ? 'critical' : r.monthly?.level === 'warn' || r.daily?.level === 'warn' ? 'warn' : null;
    const parts: Kid[] = [];
    const more: Kid[] = [];
    // Summary: the quota that is closest to its limit (the monthly and daily ones can differ a lot).
    const tightest = rows.filter(([, x]) => x && x.limit).sort((a, b) => b[1].used / b[1].limit - a[1].used / a[1].limit)[0];
    if (tightest) {
      const [label, x] = tightest;
      parts.push(h('p', { class: 'hero', text: nf.format(x.used) }), h('p', { class: 'hero-sub', text: `emails sent ${label.toLowerCase()}, of ${nf.format(x.limit)} allowed` }), meter(x.used / x.limit, x.level, `Resend emails ${label.toLowerCase()}`, `${Math.round((x.used / x.limit) * 100)}% used`));
    }
    const other = tightest ? rows.find(([l, x]) => l !== tightest[0] && x && x.limit) : undefined;
    if (other) parts.push(h('p', { class: 'hero-sub', text: `${nf.format(other[1].used)} of ${nf.format(other[1].limit)} ${other[0].toLowerCase()}` }));
    for (const [label, x] of rows) {
      if (!x || !x.limit) continue;
      const frac = x.used / x.limit;
      more.push(
        h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: `Emails sent ${label.toLowerCase()}` }), h('span', { text: `${nf.format(x.used)} of ${nf.format(x.limit)}${x.resetsAt ? ` · resets ${dateText(x.resetsAt)}` : ''}` })), meter(frac, x.level, `Resend emails ${label.toLowerCase()}`, `${Math.round(frac * 100)}% used`)),
      );
    }
    more.push(h('p', { class: 'svc-note', text: `Read from Resend's own usage API ${ago((r.monthly ?? r.daily).capturedAt)}, refreshed every 6 hours. Resend stops sending (and the site's emails fail) at the limit.` }));
    return card('Resend emails', { mode: 'auto', text: 'Read from Resend', fresh: [nextAutoUpdate((r.monthly ?? r.daily).capturedAt)] }, level, ...parts, MORE, ...more);
  }

  function manualCard(m: any): HTMLElement {
    const r = m.reading;
    if (!r) return card(m.label, { mode: 'manual', text: 'Typed in from the provider' }, 'none', h('p', { class: 'hero-sub', text: `No reading yet. Find it at ${m.where}, then an admin can enter it below.` }));
    const remaining = m.kind === 'remaining';
    const frac = r.limit ? (remaining ? 1 - r.value / r.limit : r.value / r.limit) : 0; // always the fraction USED, for the bar
    const staleForCycle = r.staleForCycle === true;
    const stale = !staleForCycle && daysAgo(r.capturedAt) > 35;
    const more: Kid[] = [];
    const parts: Kid[] = [h('p', { class: 'hero', text: `${amount(r.value)} ${m.unit}` }), h('p', { class: 'hero-sub', text: remaining ? (r.limit ? (r.value > r.limit ? `left (${amount(r.limit)} included + extra)` : `left of ${amount(r.limit)} included`) : 'left (limit not entered)') : r.limit ? `of ${amount(r.limit)} included` : 'limit not entered' })];
    const cycleMs = r.cycleStart && r.cycleEnd ? new Date(r.cycleEnd).getTime() - new Date(r.cycleStart).getTime() : 0;
    if (remaining && r.limit && cycleMs > 0 && !staleForCycle) {
      // Two bars that both drain left to right: credits left against days left in the billing cycle.
      // Credits draining faster than days means spending is ahead of pace.
      const msLeft = Math.max(0, new Date(r.cycleEnd).getTime() - Date.now());
      const daysLeft = Math.ceil(msLeft / 86_400_000);
      const daysTotal = Math.round(cycleMs / 86_400_000);
      const creditsFrac = Math.max(0, r.value / r.limit);
      const daysFrac = Math.min(1, msLeft / cycleMs);
      const row = (label: string, text: string, fraction: number, level: Level, what: string) =>
        h('div', { class: 'meter-row' }, h('div', { class: 'meter-row-head' }, h('span', { text: label }), h('span', { text })), meter(fraction, level, what, text));
      parts.push(meter(creditsFrac, m.level, `${m.label} left`, leftOf(r.value, r.limit)));
      more.push(
        row('Credits left', leftOf(r.value, r.limit), creditsFrac, m.level, `${m.label} left`),
        row('Days left', `${daysLeft} of ${daysTotal} · resets ${cycleDay(r.cycleEnd)}`, daysFrac, null, 'Days left in the billing cycle'),
        h('p', { class: 'meter-caption', text: daysLeft > 0 ? `About ${nf.format(Math.floor(r.value / daysLeft))} credits a day to last until the reset${creditsFrac < daysFrac ? ' · using credits faster than the cycle is passing' : ''}` : 'Resets today' }),
      );
    } else {
      if (r.limit) parts.push(meter(frac, m.level, `${m.label} used`, `${Math.round(frac * 100)}% used`));
      if (r.limit) more.push(h('p', { class: 'meter-caption', text: `${Math.round(frac * 100)}% used${remaining ? ` · ${amount(r.value)} left` : ''}` }));
      if (r.cycleEnd) {
        const daysLeft = Math.max(0, Math.ceil((new Date(r.cycleEnd).getTime() - Date.now()) / 86_400_000));
        more.push(h('p', { class: 'meter-caption', text: `Resets in ${daysLeft} day${daysLeft === 1 ? '' : 's'} (${cycleDay(r.cycleEnd)})` }));
      }
    }
    // A stale or out-of-date reading must not hide behind the toggle.
    if (staleForCycle || stale || r.planStale) {
      parts.push(h('p', { class: 'svc-fresh svc-fresh--late', text: staleForCycle ? 'This reading is from a previous billing cycle: update it.' : stale ? 'This reading is over a month old: update it.' : 'Netlify plan data looks out of date: check the token.' }));
    }
    more.push(h('p', { class: 'svc-note', text: `Typed in on ${dateText(r.capturedAt)} (${ago(r.capturedAt)}) from ${m.where}.${r.cycleStart ? ` Billing cycle ${cycleDay(r.cycleStart)} to ${cycleDay(r.cycleEnd, -1)}; the allowance is read from Netlify automatically.` : ''}${r.planStale ? ` Warning: Netlify plan data was last refreshed ${ago(r.planCapturedAt)}, so the limit and cycle dates may be out of date. Check the Netlify token.` : ''}${staleForCycle ? ' This reading is from a previous billing cycle, so the balance has reset since. Update it.' : ''}${stale ? ' This reading is more than a month old, so treat it with caution and update it.' : ''}` }));
    return card(m.label, r.cycleStart ? { mode: 'mixed', text: 'Balance typed in · allowance read from Netlify', fresh: [nextManualUpdate(r.capturedAt, m.refreshEveryDays), { text: 'Allowance and billing cycle: ' + nextAutoUpdate(r.planCapturedAt).text.replace('Next update', 'next update') }] } : { mode: 'manual', text: 'Typed in from the provider', fresh: [nextManualUpdate(r.capturedAt, m.refreshEveryDays)] }, m.level, ...parts, MORE, ...more);
  }

  // ---- alerts ----------------------------------------------------------------
  // The card each service's alerts belong to, so an alert can take you to the figures behind it.
  const SERVICE_CARD: Record<string, string> = { anthropic: 'Anthropic (Claude)', gemini: 'Google Gemini', typesafe: 'TypeSafe (Jev)', supabase: 'Supabase database', resend: 'Resend emails', cloudflare: 'Cloudflare R2 storage', netlify: 'Netlify' };

  function linkButton(text: string, onClick: () => void): HTMLElement {
    const b = h('button', { class: 'link-button', text, attrs: { type: 'button' } });
    b.addEventListener('click', onClick);
    return b;
  }

  // One entry per service, led by its most serious alert (the others sit under it), each saying what to do,
  // under a one-line count, so the top of the page answers "is anything wrong, and what do I do?".
  function renderAlerts(alerts: any[], cardCount: number) {
    const box = $('alerts');
    if (alerts.length === 0) {
      box.replaceChildren(h('p', { class: 'card all-clear' }, pill(null, 'All clear'), h('span', { text: `All ${cardCount} services are within their limits, as far as we can measure.` })));
      return;
    }
    const rank = (a: any) => (a.level === 'critical' ? 0 : 1);
    const byService = new Map<string, any[]>();
    for (const a of [...alerts].sort((x, y) => rank(x) - rank(y))) {
      if (!byService.has(a.service)) byService.set(a.service, []);
      byService.get(a.service)!.push(a);
    }
    const groups = [...byService.entries()].sort((x, y) => rank(x[1][0]) - rank(y[1][0]));
    const critical = groups.filter(([, g]) => g[0].level === 'critical').length;
    const warning = groups.length - critical;
    const fine = Math.max(0, cardCount - groups.length);
    const summary = [critical ? `${critical} critical` : null, warning ? `${warning} warning${warning === 1 ? '' : 's'}` : null, `${fine} fine`].filter(Boolean).join(' · ');
    box.replaceChildren(
      h('p', { class: 'alert-summary', text: summary }),
      h('ul', { class: 'alert-list' }, ...groups.map(([service, group]) => {
        const [lead, ...rest] = group;
        const cardTitle = SERVICE_CARD[service];
        return h('li', { class: `alert alert--${lead.level}` },
          pill(lead.level),
          h('div', {},
            h('p', { class: 'alert-title', text: lead.title }),
            lead.action ? h('p', { class: 'alert-action' }, h('strong', { text: 'What to do: ' }), lead.action) : null,
            // the numbers behind it, one tap away, so the headline and the action stay short
            h('details', { class: 'alert-why' },
              h('summary', { text: 'Why this is flagged' }),
              h('p', { class: 'alert-detail', text: lead.detail + (lead.emailedAt ? ` Emailed to the core team ${ago(lead.emailedAt)}.` : '') }),
              ...rest.map((r) => h('p', { class: 'alert-more', text: `Also: ${r.title}.${r.action && r.action !== lead.action ? ` ${r.action}` : ''}` })),
            ),
            cardTitle ? linkButton(`See the ${cardTitle} card`, () => openCardByTitle(cardTitle)) : null,
          ),
        );
      })),
    );
  }

  // ---- admin forms -----------------------------------------------------------
  function readingForm(meterInfo: any, last: { value?: number; limit?: number | null; expiresOn?: string | null } | null, withExpiry: boolean): HTMLElement {
    const id = meterInfo.id as string;
    const field = (name: string, label: string, value?: number | string | null, type = 'number') => {
      const input = h('input', { attrs: { name, type, ...(type === 'number' ? { step: 'any', min: '0', inputmode: 'decimal' } : {}), ...(value !== undefined && value !== null ? { value: String(value) } : {}), 'data-field': name } });
      return h('label', {}, label, input);
    };
    const msg = h('span', { class: 'msg', attrs: { role: 'status' } });
    const form = h('form', { class: 'form', attrs: { novalidate: '' } },
      h('p', { class: 'muted', text: `Find this at ${meterInfo.where}.` }),
      h('div', { class: 'fields' }, field('value', meterInfo.valueLabel, last?.value), field('limit', meterInfo.limitLabel, last?.limit), withExpiry ? field('expiresOn', 'Credit expires on (optional)', last?.expiresOn ?? '', 'date') : null),
      h('div', { class: 'actions' }, h('button', { class: 'button', text: 'Save reading', attrs: { type: 'submit' } }), msg),
    );
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const get = (n: string) => (form.querySelector(`[data-field="${n}"]`) as HTMLInputElement | null)?.value.trim() ?? '';
      const value = get('value') === '' ? NaN : Number(get('value'));
      const limit = get('limit') === '' ? NaN : Number(get('limit'));
      msg.className = 'msg msg--error';
      if (!Number.isFinite(value) || !Number.isFinite(limit)) {
        msg.textContent = 'Enter both numbers.';
        return;
      }
      msg.className = 'msg';
      msg.textContent = 'Saving…';
      try {
        const { status, data } = await staffFetch('/api/usage-admin/reading', { method: 'POST', body: { meter: id, value, limit, ...(withExpiry && get('expiresOn') ? { expiresOn: get('expiresOn') } : {}) } });
        if (status !== 200) throw new Error(data.error ?? 'Could not save');
        await load();
        $('readings').querySelectorAll('details').forEach((d) => ((d as HTMLDetailsElement).open = false));
      } catch (err) {
        msg.className = 'msg msg--error';
        msg.textContent = err instanceof StaffAuthError ? 'Your session ended or this account cannot change readings.' : (err as Error).message;
      }
    });
    return h('details', { class: 'card', attrs: { id: `reading-${id}` } }, h('summary', { text: `${meterInfo.label}${last?.value !== undefined ? ` · last entered ${last.value}` : ''}` }), form);
  }

  function renderAdmin(o: Overview) {
    $('admin').hidden = !o.canConfigure;
    if (!o.canConfigure) return;
    const a = o.anthropic.credit;
    const forms: HTMLElement[] = [readingForm(a.meter, a.reading ? { value: a.reading.value, limit: a.reading.total, expiresOn: a.reading.expiresOn } : null, true)];
    for (const m of o.manual) forms.push(readingForm(m, m.reading ? { value: m.reading.value, limit: m.reading.limit } : null, false));
    $('readings').replaceChildren(...forms);
    ($('price-input') as HTMLInputElement).value = o.settings.anthropicPrices?.input ?? '';
    ($('price-output') as HTMLInputElement).value = o.settings.anthropicPrices?.output ?? '';
    ($('gemini-limit') as HTMLInputElement).value = o.settings.geminiDailyRequests ?? '';
  }

  $('settings-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const msg = $('settings-msg');
    const pIn = ($('price-input') as HTMLInputElement).value.trim();
    const pOut = ($('price-output') as HTMLInputElement).value.trim();
    const gem = ($('gemini-limit') as HTMLInputElement).value.trim();
    const body: Record<string, unknown> = {};
    msg.className = 'msg msg--error';
    if (pIn || pOut) {
      if (!pIn || !pOut) {
        msg.textContent = 'Enter both Anthropic prices, or leave both empty.';
        return;
      }
      body.anthropicPrices = { input: Number(pIn), output: Number(pOut) };
    }
    if (gem) body.geminiDailyRequests = Number(gem);
    if (Object.keys(body).length === 0) {
      msg.textContent = 'Nothing to save.';
      return;
    }
    msg.className = 'msg';
    msg.textContent = 'Saving…';
    try {
      const { status, data } = await staffFetch('/api/usage-admin/settings', { method: 'POST', body });
      if (status !== 200) throw new Error(data.error ?? 'Could not save');
      await load();
      msg.textContent = 'Saved.';
    } catch (err) {
      msg.className = 'msg msg--error';
      msg.textContent = err instanceof StaffAuthError ? 'Your session ended or this account cannot change settings.' : (err as Error).message;
    }
  });

  // ---- domains ---------------------------------------------------------------
  async function loadDomains() {
    const box = $('domains');
    try {
      const { status, data } = await staffFetch('/api/usage-admin/domains');
      if (status !== 200) throw new Error('failed');
      const rows = (data.domains as any[]).map((d) => {
        if (d.error) return h('tr', {}, h('td', { text: d.domain }), h('td', { attrs: { colspan: '3' }, class: 'muted', text: d.error }));
        const lvl: Level = d.daysLeft <= 14 ? 'critical' : d.daysLeft <= 60 ? 'warn' : null;
        return h('tr', {}, h('td', {}, d.domain, h('small', { text: d.registrar ?? 'registrar unknown' })), h('td', { text: dateText(`${d.expiresOn}T00:00:00Z`) }), h('td', { text: d.daysLeft < 0 ? 'expired' : `${nf.format(d.daysLeft)} days` }), h('td', {}, pill(lvl, 'OK')));
      });
      box.replaceChildren(
        h('table', {}, h('thead', {}, h('tr', {}, h('th', { text: 'Domain' }), h('th', { text: 'Expires' }), h('th', { text: 'Time left' }), h('th', { text: 'Status' }))), h('tbody', {}, ...rows)),
        h('p', { class: 'svc-note', text: 'Read live from the registries. The core team is also emailed at 60 and 30 days before expiry, then daily from 14 days.' }),
      );
    } catch {
      box.replaceChildren(h('p', { class: 'muted', text: 'Could not check the registries right now. The daily email check is unaffected.' }));
    }
  }

  // ---- WhatsApp account health ---------------------------------------------------
  async function loadWhatsAppHealth() {
    const box = $('wa-health');
    try {
      const { status, data } = await staffFetch('/api/usage-admin/whatsapp-health');
      if (status !== 200) throw new Error('failed');
      const events = data.events as Array<{ severity: string; title: string; detail: string | null; at: string }>;
      if (events.length === 0) {
        box.replaceChildren(
          h('p', { class: 'muted', text: 'No events yet. Meta reports template approvals, quality drops and restrictions here as they happen.' }),
          h('p', { class: 'svc-note', text: 'The core team is emailed about each one.' }),
        );
        return;
      }
      const rows = events.map((e) => {
        const lvl: Level = e.severity === 'critical' ? 'critical' : e.severity === 'warning' ? 'warn' : null;
        return h('tr', {}, h('td', {}, e.title, e.detail ? h('small', { text: e.detail }) : null), h('td', { text: `${dateText(e.at)}, ${new Date(e.at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}` }), h('td', {}, pill(lvl, 'Info')));
      });
      box.replaceChildren(
        h('table', {}, h('thead', {}, h('tr', {}, h('th', { text: 'Event' }), h('th', { text: 'When' }), h('th', { text: 'Level' }))), h('tbody', {}, ...rows)),
        h('p', { class: 'svc-note', text: 'Reported by Meta (template approved, rejected or paused; quality drops; restrictions). The core team is emailed about each one.' }),
      );
    } catch {
      box.replaceChildren(h('p', { class: 'muted', text: 'Could not load WhatsApp events right now.' }));
    }
  }

  // ---- load & sign-in ----------------------------------------------------------
  const gate = $('gate');
  const gateError = $('gate-error');
  const forbidden = $('forbidden');
  const statusEl = $('status');
  const content = $('content');
  const intro = $('intro');

  function showGate(message?: string) {
    gate.hidden = false;
    forbidden.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    intro.textContent = 'Sign in to see how much of our free tiers and credits we are using.';
    gateError.hidden = !message;
    if (message) gateError.textContent = message;
    renderSignInButton();
  }

  function showForbidden() {
    gate.hidden = true;
    content.hidden = true;
    statusEl.hidden = true;
    forbidden.hidden = false;
    $('forbidden-email').textContent = decodeTokenEmail(getToken() ?? '');
  }

  let firstLoad = true;
  async function load() {
    gate.hidden = true;
    forbidden.hidden = true;
    if (firstLoad) {
      statusEl.hidden = false;
      statusEl.textContent = 'Loading…';
    }
    try {
      const { status, data } = await staffFetch('/api/usage-admin/overview');
      if (status !== 200) throw new Error('load failed');
      statusEl.hidden = true;
      intro.textContent = 'Free tiers and credits the website relies on. "Measured" figures come from our own systems; "typed in" ones come from a provider\'s dashboard and are only as fresh as the last entry.';
      nextRunAt = data.schedule?.nextCollectorRunAt ?? null;
      runEveryHours = data.schedule?.collectorEveryHours ?? 6;
      // Re-rendered after every saved reading; the open card (openCardTitle) is rebuilt open.
      const netlifyTyped = data.manual.find((m: any) => m.id === 'netlify.credits_remaining') ?? null;
      canConfigure = Boolean(data.canConfigure);
      const nodes = [anthropicCard(data), geminiCard(data), typesafeCard(data), supabaseCard(data), ...(data.resend.fresh ? [resendCard(data)] : []), ...(data.r2.fresh ? [r2Card(data)] : []), ...(data.netlify.deploys ? [netlifyCard(data, netlifyTyped)] : netlifyTyped ? [manualCard(netlifyTyped)] : []), ...data.manual.filter((m: any) => !FOLDED_INTO_SERVICE_CARD.has(m.id)).map(manualCard)].sort((a, b) => urgencyRank(b) - urgencyRank(a)); // most urgent first; the sort is stable, so ties keep their order
      $('cards').replaceChildren(...nodes);
      renderAlerts(data.alerts, nodes.length);
      renderAdmin(data);
      $('foot').textContent = `Updated ${new Date(data.generatedAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}. Counts use UTC days. Warnings are emailed to the core team once, and again only if they get worse.`;
      content.hidden = false;
      if (firstLoad) {
        firstLoad = false;
        loadDomains();
        loadWhatsAppHealth();
      }
    } catch (err) {
      if (err instanceof StaffAuthError) {
        if (err.kind === 'unauthorized') showGate('Your session expired. Sign in again.');
        else showForbidden();
      } else {
        statusEl.hidden = false;
        statusEl.textContent = 'Failed to load. Try refreshing.';
      }
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton(document.getElementById('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  function signOut() {
    clearToken();
    clearStepUp();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    firstLoad = true;
    showGate();
  }
  $('cards').addEventListener('click', onCardsClick);
  $('cards').addEventListener('pointerdown', onCardsPress);
  for (const type of ['pointerup', 'pointercancel']) document.addEventListener(type, onCardsRelease); // wherever the pointer is let go
  $('use-different-account').addEventListener('click', signOut);
  $('sign-out').addEventListener('click', signOut);

  if (getToken()) load();
  else showGate();
</script>
