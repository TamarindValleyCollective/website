    position: absolute;
    inset: 0 0 auto 14px;
    height: 1px;
    background: var(--tvc-line);
  }

  .usage .stat dt {
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .usage .stat dd {
