    }
  }

  .usage .bar {
    flex: none;
    width: 84px;
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--tvc-ink) 12%, var(--tvc-white));
    overflow: hidden;
  }

  .usage .bar > i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--tvc-green);
  }

  .usage .bar--warn > i {
    background: var(--tvc-orange);
  }

  .usage .bar--crit > i {
    background: var(--tvc-error-text);
  }

  #staff-main .usage .sheet--service {
    width: min(480px, calc(100vw - 24px));
    max-height: calc(100vh - 40px);
    padding: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--tvc-stone);
  }

  #staff-main .usage .sheet--service[open] {
    display: flex;
    flex-direction: column;
  }

  .usage .sheet-label {
    margin: 18px 0 6px 14px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .usage .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 16px 6px;
  }

  .usage .sheet-head h3 {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .usage .sheet-head-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .usage .sheet-body {
    display: grid;
    grid-auto-rows: max-content;
    gap: 14px;
    padding: 4px 16px 18px;
    overflow-y: auto;
  }

  .usage .sheet-body > * {
    min-width: 0;
  }

  .usage .sheet-hero > :first-child {
    margin-top: 0;
  }

  .usage .sheet-foot {
    margin: 0;
  }

  .usage .sheet-foot .svc-fresh {
    margin: 0 0 4px;
  }

  .usage .svc-fresh {
    margin: 0 0 12px;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--tvc-ink-soft);
  }

  .usage .svc-fresh--late {
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  /* What an alert says about a service sits at the top of that service's sheet. */
  .usage .alert-callout {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tvc-orange-tint);
  }

  .usage .alert-callout--critical {
    background: var(--tvc-error-bg);
  }

  .usage .alert-callout > :first-child {
    margin-top: 0;
  }

  .usage .glossary {
    margin-top: 22px;
  }

  .usage dialog h2 {
    margin: 0 0 6px;
    color: var(--tvc-ink);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .usage .hero {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--tvc-ink);
  }

  .usage .hero-sub {
    margin: 2px 0 10px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  /* meter: a thin track with a fill; the numbers beside it carry the value */
  .usage .meter {
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--tvc-ink) 12%, var(--tvc-white));
    overflow: hidden;
    margin: 8px 0 4px;
  }

  .usage .meter-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--tvc-green);
  }

  .usage .meter-fill--warn {
    background: var(--tvc-orange);
  }

  .usage .meter-fill--critical {
    background: var(--tvc-error-text);
  }

  .usage .meter-row-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .usage .meter-row .meter {
    margin-top: 4px;
  }

  .usage .meter-caption {
    margin: 0 0 12px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  /* The facts about a service are a grouped list: the label on the left, the figure on the right. */
  .usage .stats {
    margin: 0;
    padding: 0;
    background: var(--tvc-white);
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--tvc-line) inset;
    overflow: hidden;
  }

  .usage .stat {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
  }

