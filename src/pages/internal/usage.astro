---
// Usage & limits (internal): how much of each free tier and credit balance the
// website is using, which warnings are active, and when each domain expires.
// Backed by netlify/functions/usage-admin.mts; the hourly alert emails come from
// usage-alerts.mts and use the same rules (scripts/lib/usage-rules.mjs).
//
// Same shell as the other internal tools: Google Sign-In gated, one sign-in per
// tab (scripts/lib/staff-client.mjs), unlinked, noindex. Everything the server
// returns is placed with textContent only, never as HTML.
//
// Two kinds of figures, labelled as such on the page: MEASURED (our own call
// counts and the Supabase size) and TYPED IN (read off a provider's own
// dashboard by an admin, because we deliberately hold no credentials for those
// services). Status is always a word plus an icon, never colour alone.
import StaffLayout from '../../layouts/StaffLayout.astro';
import SignInGate from '../../components/SignInGate.astro';
---

<StaffLayout title="Usage" description="Free-tier and credit usage." current="usage">
  <section class="usage section wrapper">
    <h1>Usage &amp; limits</h1>
    <p id="intro" class="hint">Sign in to see how much of our free tiers and credits we are using.</p>

    <SignInGate forbiddenWhat="usage & limits" />

    <p id="status" class="hint" hidden></p>

    <div id="content" hidden>
      <div data-tour="alerts">
        <p id="summary" class="summary" role="status"></p>
        <div id="needs" hidden>
          <h2>Needs attention</h2>
          <ul id="needs-list" class="list"></ul>
        </div>
      </div>

      <h2 id="services-title">Services</h2>
      <ul id="cards" class="list" data-tour="services" aria-labelledby="services-title"></ul>
      <p class="foot">Every bar shows how much is <b>used</b>, so a fuller bar is closer to the limit; what is left is in the words beside it. A figure typed in from a provider's dashboard is only as fresh as the last entry; each service says how old it is. Warnings are emailed to the core team once, and again only if they get worse.</p>

      <h2>Domain renewals</h2>
      <ul id="domains" class="list" data-tour="domains"><li><div class="row"><span class="grow muted">Checking the registries…</span></div></li></ul>

      <h2>WhatsApp account health</h2>
      <ul id="wa-health" class="list"><li><div class="row"><span class="grow muted">Loading…</span></div></li></ul>

      <div id="admin" hidden>
        <h2>Settings</h2>
        <ul class="list"><li><button type="button" id="prices-open" class="row"><span class="grow"><span class="title">Prices and limits</span><span class="detail">Token prices for the spend estimate, and the Gemini daily limit</span></span><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li></ul>
      </div>

      <details class="glossary">
        <summary>What these words mean</summary>
        <dl>
          <div><dt>Credit</dt><dd>A prepaid balance a service draws down as the website uses it.</dd></div>
          <div><dt>Egress</dt><dd>Data a service sends out. Supabase allows 5 GB a month on the free plan.</dd></div>
          <div><dt>Deploy</dt><dd>Publishing a new version of the website. Every merge to the main branch is one, and costs Netlify 15 credits.</dd></div>
          <div><dt>Estimated</dt><dd>Worked out from the last figure someone typed in, minus what the website has measurably used since.</dd></div>
          <div><dt>Warning and critical</dt><dd>Warning is about 70% used (or 30% left). Critical is about 90% used (or 10% left).</dd></div>
        </dl>
      </details>

      <p class="muted foot" id="foot"></p>
    </div>

    <dialog id="service-sheet" class="sheet sheet--service" aria-labelledby="service-title"></dialog>
    <dialog id="wa-sheet" class="sheet sheet--service" aria-labelledby="wa-title"></dialog>

    <dialog id="prices-sheet" class="sheet" aria-labelledby="prices-title">
      <h2 id="prices-title">Prices and limits</h2>
      <form id="settings-form" class="form stack-form" novalidate>
        <p class="sheet-text">Turns Anthropic token counts into an estimated spend, and sets a daily request limit for Gemini. Both are optional; warnings that depend on a missing one stay quiet.</p>
        <div class="fields">
          <label>Anthropic input price <span class="muted">(USD per million tokens)</span><input type="number" step="any" min="0" inputmode="decimal" id="price-input" /></label>
          <label>Anthropic output price <span class="muted">(USD per million tokens)</span><input type="number" step="any" min="0" inputmode="decimal" id="price-output" /></label>
          <label>Gemini daily request limit <span class="muted">(from your Google AI Studio project)</span><input type="number" step="1" min="1" inputmode="numeric" id="gemini-limit" /></label>
        </div>
        <div class="actions"><button type="button" id="prices-cancel" class="button button--outline">Cancel</button><button type="submit" class="button">Save</button><span id="settings-msg" class="msg" role="status"></span></div>
      </form>
    </dialog>
  </section>
</StaffLayout>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  .usage.section.wrapper {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .usage .muted {
    color: var(--tvc-ink-soft);
  }


  .usage h2 {
    margin: 26px 0 8px 14px;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--tvc-ink-soft);
  }






  .usage .note,
  .usage .foot {
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  .usage .foot {
    max-width: 64ch;
    margin: 8px 14px 0;
  }

  /* On top of the shared .link-button (StaffLayout): this one sits flush with its text. */
  #staff-main .usage .link-button {
    padding: 12px 0;
  }

  /* The reading form lives inside its card: a quiet panel under the "Enter a new reading" link. */
  .usage .reading-inline {
    grid-column: 1 / -1;
  }

  .usage .reading-inline .form {
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--tvc-cream);
  }







  /* ---- alerts ---- */


  /* severity is the tint and the pill's word, not a coloured stripe */



  .usage .alert-action {
    margin: 8px 0 0;
    font-size: var(--text-sm);
  }

  .usage .alert-why > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
    cursor: pointer;
  }

  .usage .alert-why > summary::after {
    content: '+';
    margin-left: 8px;
    font-size: var(--text-lg);
    line-height: 1;
  }

  .usage .alert-why[open] > summary::after {
    content: '\2212';
  }

  .usage .alert-why .alert-detail {
    margin: 0;
  }

  .usage .alert-more {
    margin: 6px 0 0;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }


  /* a short plain-words list for readers who do not live in these dashboards */
  .usage .glossary {
    margin: 0 0 20px;
    font-size: var(--text-sm);
  }

  .usage .glossary > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--tvc-ink-soft);
    cursor: pointer;
    margin-left: 14px;
  }

  .usage .glossary dl {
    margin: 0 0 4px;
    display: grid;
    gap: 8px;
    max-width: 62ch;
  }

  .usage .glossary dt {
    font-weight: 600;
  }

  .usage .glossary dd {
    margin: 0;
    color: var(--tvc-ink-soft);
  }

  .usage .alert-title {
    font-weight: 600;
    margin: 0;
  }

  .usage .alert-detail {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }









  /* how a card's figures get updated: Automatic / Live (no hands) vs Manual (a person types them in) */




  .usage .svc-fresh {
    margin: 0 0 12px;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--tvc-ink-soft);
  }

  .usage .svc-fresh--late {
    color: var(--tvc-orange-text);
    font-weight: 600;
  }










  /* 0fr to 1fr animates the height to the content's real size, and a click mid-flight turns around from where it is */






  /* ---- the page: a status line, then grouped lists; a service opens in a sheet ---- */
  .usage .summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 4px;
    font-weight: 500;
  }

  .usage .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .usage .dot--warn {
    background: var(--tvc-orange);
  }

  .usage .dot--crit {
    background: var(--tvc-error-text);
  }

  .usage .row .value {
    flex: none;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .usage .row .detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .usage .row-meter {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
  }

  /* On a phone the percentage sits above a shorter bar, so the service name and its line of detail keep their room. */
  @media (max-width: 520px) {
    .usage .row-meter {
      flex-direction: column;
      align-items: flex-end;
      gap: 5px;
    }

    .usage .row-meter .bar {
