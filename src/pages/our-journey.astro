---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { FARM_AREA_ACRES } from '../data/site-facts';
---

<BaseLayout title="Our Journey" description={`From a degraded ${FARM_AREA_ACRES}-acre farm to a regenerating ecosystem, year by year.`} image="/images/pages/journey/hero.jpg" imageWidth={1280} imageHeight={960}>
  <PageHero
    eyebrow="Our Journey"
    title="From degraded farmland to a regenerating ecosystem"
    image="/images/pages/journey/hero.jpg"
    imageAlt="Early view of the farm during its restoration"
  />

  <section class="section wrapper">
    <h2>Early days</h2>
    <p>TVC is a {FARM_AREA_ACRES}-acre farm collectively owned by 53 families. Due to exploitative farming practices, the farmland was degraded when the collective bought it. Since 2017, the community has been using permaculture principles to regenerate the farm's fertility naturally.</p>

    <blockquote>
      <p>Nature does not hurry, yet everything is accomplished.</p>
      <cite>— Lao Tzu</cite>
    </blockquote>
  </section>

  <section class="section wrapper">
    <h2>Timeline</h2>
    <p>Nine years, year by year — tap through the story from a barren plot in 2017 to our first completed home, with photos for every month.</p>
    <a class="button button--outline" href="/our-journey/timeline">Explore the timeline →</a>
  </section>
</BaseLayout>

<style>
  blockquote {
    border-left: 4px solid var(--tvc-orange);
    padding: 4px 24px;
    font-style: italic;
    margin: 24px 0;
  }

  blockquote cite {
    display: block;
    margin-top: 6px;
    font-style: normal;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }
</style>
