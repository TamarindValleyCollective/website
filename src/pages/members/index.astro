      // The tour points at whichever of the two is on screen.
      if (!onPhone) a.setAttribute('data-tour', `nav-${item.id}`);
      nav.append(a);
    }
    for (const item of overflow.length ? shown.slice(0, MAX_TABS - 1) : shown) {
      const t = mk(item, '', '');
      if (onPhone) t.setAttribute('data-tour', `nav-${item.id}`);
