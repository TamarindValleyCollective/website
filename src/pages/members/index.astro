  };

  type NavItem = { id: string; label: string; icon: string; soon?: boolean; hidden?: boolean; preview?: boolean };
  // Marks a feature that is not on for everyone yet; the server says so (`preview`) and the mark goes when the flag is turned on.
  const previewPill = () => {
    const p = h('span', 'beta-pill', 'Preview');
    p.setAttribute('title', 'You are among the first to try this. Tell the core team what works and what does not.');
    return p;
  };
  const NAV: NavItem[] = [
    { id: 'dashboard', label: 'Home', icon: IC.dash },
    { id: 'unit', label: 'My unit', icon: IC.unit },
    // Owners only: a family member's story route lands on the Directory.
    { id: 'story', label: 'Our story', icon: IC.pen },
    // Owners only, and only once the feature is switched on (MEMBER_RENTAL_ENABLED): probeRental() shows it.
    { id: 'rental', label: 'Rent out', icon: IC.stay, hidden: true },
    { id: 'directory', label: 'Directory', icon: IC.book },
    // Early access (MEMBER_SITE_MAP_ENABLED, or a household on Preview): probeSiteMap() shows it.
    { id: 'sitemap', label: 'Map', icon: IC.map, hidden: true },
    // Not built yet: kept out of the menu (they would only lead to a "coming soon" page) and listed
    // once, quietly, at the foot of the Home page. The routes stay so an old bookmark still lands somewhere.
    { id: 'stays', label: 'Stays', icon: IC.stay, soon: true },
    { id: 'dues', label: 'My dues', icon: IC.rupee, soon: true },
    { id: 'receipts', label: 'Receipts', icon: IC.receipt, soon: true },
    { id: 'statements', label: 'Statements', icon: IC.statement, soon: true },
    { id: 'notices', label: 'Notices', icon: IC.bell, soon: true },
    { id: 'documents', label: 'Documents', icon: IC.book, soon: true },
    { id: 'meetings', label: 'Meetings & polls', icon: IC.cal, soon: true },
    { id: 'help', label: 'Ask the core team', icon: IC.help, soon: true },
  ];
  const PLANNED: Record<string, string[]> = {
    stays: ['Book overnight stays for yourself and your family (free)', 'Add guests at a discounted rate and pay by UPI', 'See, change and cancel your bookings; event dates take priority'],
    dues: ['Your annual maintenance for each financial year, what is paid and what is due, and a UPI QR to pay', 'Pay by UPI QR, and tell us when you have paid'],
    receipts: ['Download a receipt for every payment you have made'],
    statements: ['Your account statement for each financial year'],
    notices: ['Announcements from the core team: meetings, maintenance reminders, farm and event updates'],
    documents: ['Meeting minutes, farm rules, forms and other member documents'],
