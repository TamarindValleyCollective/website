  }

  // ---- building blocks ----
  const widget = (title: string, opts: { wide?: boolean; more?: [string, string]; icon?: string } = {}, ...kids: Kid[]) => {
    const head = h('h2', '', undefined, opts.icon ? h('span', 'glyph', undefined, icon(opts.icon)) : null, title);
    if (opts.more) {
      const m = h('button', 'more', opts.more[0]);
      m.addEventListener('click', () => (location.hash = `#/${opts.more![1]}`));
      head.append(m);
    }
    return h('section', `widget${opts.wide ? ' widget--wide' : ''}`, undefined, head, ...kids);
  };
  const kpi = (k: string, v: string) => h('div', 'kpi', undefined, h('div', 'k', k), h('div', 'v', v));
  const tableOf = (headers: string[], rows: (string | number | null | HTMLElement)[][], rightFrom = -1): HTMLElement =>
    h('div', 'table-wrap', undefined, h('table', '', undefined,
      h('thead', '', undefined, h('tr', '', undefined, ...headers.map((t, i) => h('th', rightFrom >= 0 && i >= rightFrom ? 'r' : '', t)))),
      h('tbody', '', undefined, ...rows.map((r) => h('tr', '', undefined, ...r.map((c, i) => (c instanceof HTMLElement ? h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', undefined, c) : h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', c == null || c === '' ? '—' : String(c))))))),
    ));
  // The household split by role, owners first, so owners and family are not mixed in one list.
  const ROLE_GROUPS: [string, string][] = [['owner', 'Owners'], ['family', 'Family'], ['non_owner', 'Not owners']];
  // The codes that name a card, as pills in its heading: the farm unit on Farm, the house number on House; the unit type sits at the foot of the House card.
  // No "Cluster"/"Type" words (the codes say it); the name is in the tooltip and the accessible name.
  // The code that names the card (farm unit, house number) is the solid pill; the descriptors are tinted.
  const pillsOf = (items: [string, string | null | undefined, boolean?][]): HTMLElement | null => {
    const shown = items.filter((i): i is [string, string, boolean?] => !!i[1]);
    return shown.length ? h('span', 'pills', undefined, ...shown.map(([label, value, key]) => {
      const pill = h('span', key ? 'pill pill--key' : 'pill', value);
      pill.title = label;
      pill.setAttribute('aria-label', `${label} ${value}`);
      return pill;
    })) : null;
  };
  const farmPills = (hh: Hh) => pillsOf([['Farm unit', hh.farmUnit, true]]);
  // TO1-V2 is just a variant of TO1, so only the family is shown ("TO1").
  const unitTypeFamily = (t: string | null) => (t ? t.replace(/-V\d+$/i, '') : null);
  const housePills = (hh: Hh) => pillsOf([['House number', hh.houseNo, true]]);
  const typePill = (hh: Hh) => pillsOf([['Unit type', unitTypeFamily(hh.unitType)]]);
  // On My unit the unit type sits beside the house number in the heading (on Home it is at the foot of the tile).
  const houseHeadPills = (hh: Hh) => pillsOf([['Unit type', unitTypeFamily(hh.unitType)], ['House number', hh.houseNo, true]]);
  const peopleByRole = (people: Person[]) => ROLE_GROUPS.map(([role, label]) => ({ label, people: people.filter((p) => p.role === role) })).filter((g) => g.people.length);
  const peopleList = (hh: Hh, you: Person) =>
    h('div', '', undefined, ...peopleByRole(hh.people).flatMap((g) => [
      h('h3', 'role-head', g.label),
      h('ul', 'people', undefined, ...g.people.map((p) =>
        h('li', '', undefined, h('span', 'avatar', first(p.name).slice(0, 1).toUpperCase()),
          h('div', 'who2', undefined, h('strong', '', `${p.name}${p.id === you.id ? ' (you)' : ''}`), h('span', '', `${p.hasEmail ? 'Email on file' : 'No email'} · ${p.hasPhone ? 'Mobile on file' : 'No mobile'}`))))),
    ]));

  // ---- editing my own details ----
  function detailsDialog() {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const phone = document.createElement('input');
    phone.type = 'tel';
    phone.autocomplete = 'off';
    phone.value = me!.phone ?? '';
    phone.placeholder = 'e.g. 98450 12345';
    const dir = document.createElement('input');
    dir.type = 'checkbox';
    dir.checked = me!.directoryVisible;
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const save = h('button', 'btn btn--solid', 'Save') as HTMLButtonElement;
    save.addEventListener('click', async () => {
      const body: Record<string, unknown> = {};
      if (phone.value.trim() !== (me!.phone ?? '')) body.phone = phone.value.trim() === '' ? null : phone.value;
      if (dir.checked !== me!.directoryVisible) body.directoryVisible = dir.checked;
      if (Object.keys(body).length === 0) {
        msg.textContent = 'Nothing to change.';
        return;
      }
      save.disabled = true;
      msg.textContent = '';
      try {
        const { status, data } = await memberFetch('/api/members-me/profile', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        await load(true);
        toast('Your details are saved');
      } catch (err) {
        save.disabled = false;
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', 'Your details'),
      h('p', '', `Signed in as ${me!.email ?? 'your Google account'}. To change your name, email or unit, ask the core team.`),
      h('label', '', 'Mobile number', phone),
      h('label', 'check', undefined, dir, h('span', '', 'List me in the member directory')),
      msg,
      h('div', 'modal-actions', undefined, cancel, save),
    );
    dlg.addEventListener('close', () => dlg.remove());
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- land documents ----
  // Members upload the patta / survey extract they downloaded from eservices.tn.gov.in. The
  // server reads it in the background (members-land-extract-background.mts): a record the
  // register already holds is marked verified, a new one is added for the core team to confirm.
  const DOC_STATUS: Record<string, string> = { processing: 'Reading…', applied: 'Done', needs_review: 'With the core team', failed: 'Not used' };
  const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const LAND_LABEL: Record<string, string> = { farm: 'Farm land', house: 'House plot' };

  // The household's uploaded documents, shared by the Farm and House cards and the popup that
  // lists them. Re-read every few seconds while one is still being read.
  let docsState: { householdId: string; docs: LandDoc[]; loaded: boolean } = { householdId: '', docs: [], loaded: false };
  const docsListeners = new Set<() => void>();
  let pollTimer: number | undefined;
  async function refreshDocs(hh: Hh) {
    window.clearTimeout(pollTimer);
    try {
      const { status, data } = await memberFetch('/api/members-me/land-documents');
      if (status !== 200) throw new Error();
      docsState = { householdId: hh.id, docs: (data.documents as LandDoc[]).filter((d) => d.householdId === hh.id), loaded: true };
    } catch {
      docsState = { householdId: hh.id, docs: [], loaded: false };
    }
    for (const fn of [...docsListeners]) fn();
    const processing = docsState.docs.some((d) => d.status === 'processing');
    if (processing && docsListeners.size > 0) pollTimer = window.setTimeout(() => void refreshDocs(hh), 4000);
    else if (docsState.docs.length && !processing) loadQuietly();
  }
  const docsOfType = (landType: string) => docsState.docs.filter((d) => d.landType === landType);

  function docRow(d: LandDoc): HTMLElement {
    return h('p', 'doc-row', undefined,
      h('strong', '', undefined, docLink(dateFmt.format(new Date(d.uploadedAt)) + (d.fileName ? ` · ${d.fileName}` : ''), d.status === 'failed' ? null : d.id)),
      h('span', 'pill', DOC_STATUS[d.status] ?? d.status),
      h('span', 'doc-sum', d.summary));
  }

  // Under a Farm or House card's table: upload for that kind of land (no choice to make), and a
  // link to what has been uploaded for it. The list itself is in a popup, not on the page.
  function landCardFooter(hh: Hh, landType: 'farm' | 'house'): HTMLElement {
    const upload = h('button', 'btn btn--solid', 'Upload a document');
    upload.setAttribute('type', 'button');
    upload.addEventListener('click', () => uploadDialog(hh, landType, () => { shapesLoad = null; void refreshDocs(hh); }));
    const history = h('button', 'link-btn', 'Uploaded documents');
    history.setAttribute('type', 'button');
    history.addEventListener('click', () => docsDialog(hh, landType));
    const sketch = h('button', 'btn', 'Add an FMB sketch');
    sketch.setAttribute('type', 'button');
    sketch.addEventListener('click', () => sketchDialog(hh, landType, () => { shapesLoad = null; void refreshDocs(hh); }));
    const footer = h('div', 'card-docs', undefined, upload, sketch, history);
    const update = () => {
      if (!footer.isConnected) {
        docsListeners.delete(update);
        return;
      }
      const n = docsOfType(landType).length;
      history.textContent = n ? `Uploaded documents (${n})` : 'Uploaded documents';
    };
    docsListeners.add(update);
    if (docsState.householdId === hh.id && docsState.loaded) update();
    else void refreshDocs(hh);
    return footer;
  }

  function docsDialog(hh: Hh, landType: 'farm' | 'house') {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal docs-modal';
    const list = h('div', 'docs-list');
    const render = () => {
      const docs = docsOfType(landType);
      list.replaceChildren(...(docs.length ? docs.slice(0, 20).map(docRow) : [h('p', 'lede', docsState.loaded ? 'Nothing uploaded yet.' : 'Loading…')]));
    };
    docsListeners.add(render);
    const close = h('button', 'btn', 'Close');
    close.addEventListener('click', () => dlg.close());
    dlg.append(
      h('h3', '', `${LAND_LABEL[landType]} documents`),
      h('p', '', 'Click a date to open the file you uploaded.'),
      list,
      h('div', 'modal-actions', undefined, close),
    );
    dlg.addEventListener('close', () => {
      docsListeners.delete(render);
      dlg.remove();
    });
    render();
    document.body.append(dlg);
    dlg.showModal();
    void refreshDocs(hh);
  }

  // Re-reads the household once documents finish, so verified badges appear without a reload.
  let lastRefreshKey = '';
  function loadQuietly() {
    const key = String(Date.now() / 60000 | 0);
    if (key === lastRefreshKey) return;
    lastRefreshKey = key;
    window.setTimeout(async () => {
      try {
        const { status, data } = await memberFetch('/api/members-me/home');
        if (status === 200 && data.households) {
          const before = JSON.stringify(all);
          all = data.households;
          if (JSON.stringify(all) !== before) onRoute();
        }
      } catch {
        // the next navigation reloads anyway
      }
    }, 0);
  }

  // What to download and where from, for a member who has never used the e-Services site.
  function uploadHelp(): HTMLElement {
    const link = h('a', '', 'eservices.tn.gov.in');
    link.setAttribute('href', 'https://eservices.tn.gov.in/eservicesnew/index.html');
    link.setAttribute('target', '_blank');
    link.setAttribute('rel', 'noopener noreferrer');
    return h('div', 'upload-help', undefined,
      h('p', '', 'There are two kinds of document you can upload. Both come from the Tamil Nadu e-Services website, and you can upload both:'),
      h('ul', '', undefined,
        h('li', '', undefined, h('strong', '', 'Patta / chitta'), ' (choose "Patta Number"). It covers your patta number and lists every survey number under it.'),
        h('li', '', undefined, h('strong', '', 'Survey number document'), ' (choose "Survey Number"). It is for one survey number and comes with its FMB sketch. If your document has the sketch, the shape of the land appears next to that survey number on your card.')),
      h('p', '', undefined, 'To get them, open ', link, ' and go to ', h('strong', '', 'View Patta / Chitta'), '. Then choose:'),
      h('ul', '', undefined,
        h('li', '', undefined, 'District: ', h('strong', '', 'Krishnagiri')),
        h('li', '', undefined, 'Taluk: ', h('strong', '', 'Anchetty')),
        h('li', '', undefined, 'Village: ', h('strong', '', 'Taggati'))),
      h('p', '', 'Pick Patta Number or Survey Number, enter your mobile number, and use the OTP you receive to download the PDF. Upload that PDF here. A photo or scan is checked by the core team instead. Limits: PDF 1 MB, photo 3 MB.'),
    );
  }

  function uploadDialog(hh: Hh, landType: 'farm' | 'house', done: () => void) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal upload-modal';
    const file = document.createElement('input');
    file.type = 'file';
    file.accept = 'application/pdf,image/jpeg,image/png';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const send = h('button', 'btn btn--solid', 'Upload') as HTMLButtonElement;
    send.addEventListener('click', async () => {
      const chosen = file.files?.[0];
      if (!chosen) {
        msg.textContent = 'Choose a file first.';
        return;
      }
      if (chosen.size > (chosen.type === 'application/pdf' ? 1_000_000 : 3_000_000)) {
        msg.textContent = chosen.type === 'application/pdf' ? 'A patta PDF is under 1 MB; that file is too large to be one.' : 'That photo is larger than 3 MB.';
        return;
      }
      send.disabled = true;
      msg.textContent = '';
      try {
        const body = new FormData();
        body.append('file', chosen);
        body.append('landType', landType);
        body.append('householdId', hh.id);
        const { status, data } = await memberFetch('/api/members-me/land-documents', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        done();
        toast(data.replaced ? 'Uploaded. It replaces your earlier upload, and we are reading it now' : 'Uploaded. We are reading it now');
      } catch (err) {
        send.disabled = false;
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', `Upload a ${landType === 'house' ? 'house plot' : 'farm land'} document`),
      uploadHelp(),
      h('label', '', 'File', file),
      msg,
      h('div', 'modal-actions', undefined, cancel, send),
    );
    dlg.addEventListener('close', () => dlg.remove());
    document.body.append(dlg);
    dlg.showModal();
  }

  // The FMB sketch on its own, for one survey number: the shape of the land then appears beside that
  // survey number on the card. The file can't say which survey number it is (its labels are drawn,
  // not text), so the member picks it. It is not a patta and changes no record.
  function sketchDialog(hh: Hh, landType: 'farm' | 'house', done: () => void) {
    const choices = surveyChoices((landType === 'house' ? hh.housePattas : hh.plots).map((r) => ({ survey_no: r.surveyNo })));
    const dlg = document.createElement('dialog');
    dlg.className = 'modal upload-modal';
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => dlg.remove());
    if (!choices.length) {
      dlg.append(
        h('h3', '', 'Add an FMB sketch'),
        h('p', '', `There is no survey number on your ${landType === 'house' ? 'House plot' : 'Farm land'} card yet. Upload your patta first with "Upload a document", then come back to add the sketch.`),
        h('div', 'modal-actions', undefined, cancel),
      );
      document.body.append(dlg);
      dlg.showModal();
      return;
    }
    const survey = document.createElement('select');
    for (const s of choices) survey.append(new Option(s, s));
    const file = document.createElement('input');
    file.type = 'file';
    file.accept = 'application/pdf';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const send = h('button', 'btn btn--solid', 'Upload') as HTMLButtonElement;
    send.addEventListener('click', async () => {
      const chosen = file.files?.[0];
      if (!chosen) {
        msg.textContent = 'Choose a file first.';
        return;
      }
      if (chosen.size > 1_000_000) {
        msg.textContent = 'That file is too large to be an FMB sketch (under 1 MB).';
        return;
      }
      send.disabled = true;
      msg.textContent = '';
      try {
        const body = new FormData();
        body.append('file', chosen);
        body.append('landType', landType);
        body.append('householdId', hh.id);
        body.append('sketchFor', survey.value);
        const { status, data } = await memberFetch('/api/members-me/land-documents', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        done();
        toast(data.replaced ? `Sketch added for survey no. ${survey.value}. It replaces your earlier one` : `Sketch added for survey no. ${survey.value}`);
      } catch (err) {
        send.disabled = false;
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', 'Add an FMB sketch'),
      h('div', 'upload-help', undefined,
        h('p', '', 'The FMB sketch is the drawing of your land. On the e-Services site, choose "Survey Number" in View Patta / Chitta and download the sketch. Upload that PDF here and the shape of the land appears beside the survey number on your card.'),
        h('p', '', 'It does not change any record. To have a patta checked against your register, use "Upload a document" instead.')),
      h('label', '', 'This sketch is for survey no.', survey),
      h('label', '', 'File', file),
      msg,
      h('div', 'modal-actions', undefined, cancel, send),
    );
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- the privacy notice ----
  // Shown before anything else on a member's first sign-in (and again if the notice
  // changes): the server releases no household data until it is acknowledged.
  // `required` = that blocking first-time case; otherwise it is a plain read-only view.
  function noticeDialog(required: boolean) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal notice';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const actions = h('div', 'modal-actions');
    if (required) {
      dlg.addEventListener('cancel', (e) => e.preventDefault()); // Esc must not skip it
      const out = h('button', 'btn', 'Sign out');
      out.addEventListener('click', () => {
        dlg.remove();
        signOut();
      });
      const ok = h('button', 'btn btn--solid', 'I have read this') as HTMLButtonElement;
      ok.addEventListener('click', async () => {
        ok.disabled = true;
        msg.textContent = '';
        try {
          const { status, data } = await memberFetch('/api/members-me/privacy', { method: 'POST', body: { version: PRIVACY_NOTICE_VERSION } });
          if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
          dlg.remove();
          await load();
        } catch (err) {
          ok.disabled = false;
          msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
        }
      });
      actions.append(out, ok);
      queueMicrotask(() => ok.focus()); // not "Sign out", which showModal() would focus first
    } else {
      const close = h('button', 'btn btn--solid', 'Close');
      close.addEventListener('click', () => dlg.close());
      actions.append(close);
      dlg.addEventListener('close', () => dlg.remove());
    }
    dlg.append(
      h('h3', '', NOTICE_TITLE),
      h('p', '', NOTICE_INTRO),
      ...SECTIONS.flatMap((s: { heading: string; body: string }) => [h('h4', '', s.heading), h('p', '', s.body)]),
      msg,
      actions,
    );
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- views ----
  function viewDashboard(): HTMLElement {
    const hh = hhNow();
    const person = meIn(hh);
    const root = h('div');
    root.append(h('h1', 'page-title', `Hello, ${first(me!.name)}`), h('p', 'lede', 'Your unit, your story and your neighbours in the valley.'));

    // One thing to do next. Until a mobile number is on file that is the thing; after that, the story.
    const go = (label: string, to: string, solid = false) => {
      const b = h('button', solid ? 'btn btn--solid' : 'btn', label);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => (location.hash = `#/${to}`));
      return b;
    };
    const next = !me!.phone
      ? { title: 'Add your mobile number', text: 'So the core team can reach you about stays and farm updates.', actions: [(() => { const b = h('button', 'btn btn--solid', 'Add my number'); b.setAttribute('type', 'button'); b.addEventListener('click', detailsDialog); return b; })()] }
      : { title: 'Your story', text: 'Add to it or change it whenever you like, and read what your neighbours have shared.', actions: [go('Open your story', 'story', true), go('See our members', 'directory')] };
    root.append(h('section', 'next', undefined, h('div', 'next-text', undefined, h('h2', '', next.title), h('p', '', next.text)), h('div', 'next-actions', undefined, ...next.actions)));

    const grid = h('div', 'widgets');
    const prompts = h('div');
    const checks = hh.flags.filter((f) => f.severity !== 'info').length;
    if (checks) prompts.append(h('p', 'prompt', `${checks} detail${checks === 1 ? '' : 's'} in your unit's records look incomplete. The core team is working through them.`));

    grid.append(
      widget('My unit', { more: ['View unit', 'unit'], icon: IC.unit },
        h('div', 'tiles', undefined,
          h('div', 'tile', undefined, h('div', 'k', undefined, glyph(IC.farm, 'Farm land'), farmPills(hh)), h('div', 'v', hh.plots.length ? `${acresFmt.format(hh.farmAcres)} ac` : '—'), h('div', 's', hh.plots.length ? `${hh.plots.length} plot${hh.plots.length === 1 ? '' : 's'}` : 'Not available yet')),
          h('div', 'tile', undefined, h('div', 'k', undefined, glyph(IC.house, 'House'), housePills(hh)), h('div', 'v', hh.houseSqFt > 0 ? `${sqftFmt.format(hh.houseSqFt)} sq ft` : '—'), h('div', 's', undefined, h('span', '', !hh.houseNo ? 'No house allocated yet' : hh.housePattas.length ? `${hh.housePattas.length} plot${hh.housePattas.length === 1 ? '' : 's'}` : 'Area not on record'), typePill(hh))),
        ),
        prompts,
      ),
      widget('People', { icon: IC.people }, peopleList(hh, person)),
