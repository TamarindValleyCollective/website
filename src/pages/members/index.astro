          renderView();
        });
        menu.append(b);
      });
    }
    const details = h('button', '', 'Your details');
    details.addEventListener('click', () => {
      menu.hidden = true;
      $('who').setAttribute('aria-expanded', 'false');
      detailsDialog();
    });
    const notice = h('button', '', 'Privacy notice');
    notice.addEventListener('click', () => {
      menu.hidden = true;
      $('who').setAttribute('aria-expanded', 'false');
      noticeDialog(false);
    });
    const tour = h('button', '', 'Take the tour again');
    tour.addEventListener('click', () => {
      menu.hidden = true;
      $('who').setAttribute('aria-expanded', 'false');
      startTour(fullTourFor(me!.role), false);
    });
    const contact = h('a', '', 'Contact the core team');
    contact.setAttribute('href', 'mailto:core-team@tvc.farm');
    const out = h('button', '', 'Sign out');
    out.addEventListener('click', signOut);
    menu.append(details, tour, notice, contact, appearanceControl(), out);
  }

  // Appearance: follow the device (Auto), or pin Light or Dark. Remembered in this browser; the <head> script applies it early.
  const THEME_KEY = 'tvc-member-theme';
  const currentTheme = (): '' | 'light' | 'dark' => {
    const t = document.documentElement.getAttribute('data-theme');
    return t === 'light' || t === 'dark' ? t : '';
  };
  function setTheme(value: '' | 'light' | 'dark') {
    if (value) document.documentElement.setAttribute('data-theme', value);
    else document.documentElement.removeAttribute('data-theme');
    try {
      if (value) localStorage.setItem(THEME_KEY, value);
      else localStorage.removeItem(THEME_KEY);
    } catch { /* not remembered */ }
  }
  function appearanceControl(): HTMLElement {
    const group = h('div', 'appearance');
    group.setAttribute('role', 'group');
    group.setAttribute('aria-label', 'Appearance');
    const options: ['' | 'light' | 'dark', string][] = [['', 'Auto'], ['light', 'Light'], ['dark', 'Dark']];
    const paint = () => group.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-pressed', String(options[i][0] === currentTheme())));
    for (const [value, label] of options) {
      const b = h('button', '', label);
      b.setAttribute('type', 'button');
      b.addEventListener('click', (ev) => {
        ev.stopPropagation(); // the menu stays open so the change can be seen
        setTheme(value);
        paint();
      });
      group.append(b);
    }
    paint();
    return group;
  }

  // ---- building blocks ----
  const widget = (title: string, opts: { wide?: boolean; more?: [string, string]; icon?: string; tour?: string } = {}, ...kids: Kid[]) => {
    const head = h('h2', '', undefined, opts.icon ? h('span', 'glyph', undefined, icon(opts.icon)) : null, title);
    if (opts.more) {
      const m = h('button', 'more', opts.more[0]);
      m.addEventListener('click', () => (location.hash = `#/${opts.more![1]}`));
      head.append(m);
    }
    const section = h('section', `widget${opts.wide ? ' widget--wide' : ''}`, undefined, head, ...kids);
    if (opts.tour) section.setAttribute('data-tour', opts.tour);
    return section;
  };
  const tableOf = (headers: string[], rows: (string | number | null | HTMLElement)[][], rightFrom = -1): HTMLElement =>
    h('div', 'table-wrap', undefined, h('table', '', undefined,
      h('thead', '', undefined, h('tr', '', undefined, ...headers.map((t, i) => h('th', rightFrom >= 0 && i >= rightFrom ? 'r' : '', t)))),
      h('tbody', '', undefined, ...rows.map((r) => h('tr', '', undefined, ...r.map((c, i) => (c instanceof HTMLElement ? h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', undefined, c) : h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', c == null || c === '' ? '—' : String(c))))))),
    ));
  // The household split by role, owners first, so owners and family are not mixed in one list.
  const ROLE_GROUPS: [string, string][] = [['owner', 'Owners'], ['family', 'Family'], ['non_owner', 'Not owners']];
  // The codes that name a card, as pills in its heading: the farm unit on Farm, the house number on House; the unit type sits at the foot of the House card.
  // No "Cluster"/"Type" words (the codes say it); the name is in the tooltip and the accessible name.
  // The code that names the card (farm unit, house number) is the solid pill; the descriptors are tinted.
  const pillsOf = (items: [string, string | null | undefined, boolean?][]): HTMLElement | null => {
    const shown = items.filter((i): i is [string, string, boolean?] => !!i[1]);
    return shown.length ? h('span', 'pills', undefined, ...shown.map(([label, value, key]) => {
      const pill = h('span', key ? 'pill pill--key' : 'pill', value);
      pill.title = label;
      pill.setAttribute('aria-label', `${label} ${value}`);
      return pill;
    })) : null;
  };
  const farmPills = (hh: Hh) => pillsOf([['Farm unit', hh.farmUnit, true]]);
  const housePills = (hh: Hh) => pillsOf([['House number', hh.houseNo, true]]);
  const peopleByRole = (people: Person[]) => ROLE_GROUPS.map(([role, label]) => ({ label, people: people.filter((p) => p.role === role) })).filter((g) => g.people.length);
  // Google's picture for the person, or their initial when they have none (or it will not load). Someone who has
  // signed in has a picture on file, so this also shows who has used the portal.
  const personFace = (p: { name: string; picture: string | null }, small = false) => {
    const initial = h('span', `avatar${small ? ' avatar--sm' : ''}`, first(p.name).slice(0, 1).toUpperCase());
    const src = sizedPicture(p.picture, 96);
    if (!src) return initial;
    const img = document.createElement('img');
    img.className = `avatar${small ? ' avatar--sm' : ''}`;
    img.alt = '';
    img.loading = 'lazy';
    img.referrerPolicy = 'no-referrer';
    img.addEventListener('error', () => img.replaceWith(initial));
    img.src = src;
    return img;
  };
  // Your own email and mobile in full, everyone else's masked.
  const contact = (p: Person, you: Person) => (p.id === you.id ? { email: me!.email, phone: me!.phone } : { email: p.emailMasked, phone: p.phoneMasked });
  const peopleList = (hh: Hh, you: Person) =>
    h('div', '', undefined, ...peopleByRole(hh.people).flatMap((g) => [
      h('h3', 'role-head', g.label),
      h('ul', 'people', undefined, ...g.people.map((p) =>
        h('li', '', undefined, personFace(p),
          h('div', 'who2', undefined, h('strong', '', `${p.name}${p.id === you.id ? ' (you)' : ''}`), h('span', '', `${contact(p, you).email ?? 'No email'} · ${contact(p, you).phone ?? 'No mobile'}`))))),
    ]));

  // ---- dialogs ----
  // Every dialog goes through here, so they all behave alike. On a wide screen a dialog is a card that grows out of the
  // control that opened it; on a phone it is a bottom sheet with a grab bar you can pull down. Leaving plays the entrance
  // backwards, however it is closed (Cancel, Esc, a click outside, a swipe): `close` is wrapped, so the dialogs keep
  // calling dlg.close() as before. `locked` is for the privacy notice a new member must read first: no Esc, no click
  // outside, no grab bar.
  const phoneSheet = window.matchMedia('(max-width: 560px)');
  function presentSheet(dlg: HTMLDialogElement, opts: { from?: Element | null; locked?: boolean } = {}) {
    dlg.classList.add('sheet');
    const nativeClose = dlg.close.bind(dlg);
    let leaving = false;
    dlg.close = (returnValue?: string) => {
      if (leaving || !dlg.open) {
        nativeClose(returnValue);
        return;
      }
      leaving = true;
      dlg.classList.add('sheet--out');
      const done = () => { if (dlg.open) nativeClose(returnValue); };
      dlg.addEventListener('animationend', (e) => { if (e.target === dlg) done(); });
      window.setTimeout(done, 400); // in case no animation runs
    };
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault();
      if (!opts.locked) dlg.close();
    });
    if (!opts.locked) {
      // Only the backdrop closes it: the press and the release both outside the sheet's box. A click on the sheet's own
      // padding or the gaps between fields also has the dialog as its target, and so does a text selection dragged out.
      const outside = (e: MouseEvent) => {
        const box = dlg.getBoundingClientRect();
        return e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
      };
      let pressedOutside = false;
      dlg.addEventListener('pointerdown', (e) => { pressedOutside = e.target === dlg && outside(e); });
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg && pressedOutside && outside(e)) dlg.close();
        pressedOutside = false;
      });
      // On a phone the grab area at the top moves the sheet with the finger, and a flick carries it (the release
      // velocity is projected the way scrolling is, and past halfway it goes). Elsewhere it is not shown.
      const grab = h('div', 'sheet-grab');
      grab.setAttribute('aria-hidden', 'true');
      let drag: { id: number; y: number; t: number; dy: number; v: number } | null = null;
      grab.addEventListener('pointerdown', (e) => {
        drag = { id: e.pointerId, y: e.clientY, t: e.timeStamp, dy: 0, v: 0 };
        grab.setPointerCapture(e.pointerId);
        dlg.style.transition = 'none';
      });
      grab.addEventListener('pointermove', (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dy = e.clientY - drag.y;
        drag.v = (dy - drag.dy) / Math.max(1, e.timeStamp - drag.t); // px per ms, from the last movement
        drag.dy = dy;
        drag.t = e.timeStamp;
        dlg.style.transform = `translateY(${Math.max(0, dy)}px)`;
      });
      const endDrag = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const { dy, v } = drag;
        drag = null;
        const projected = dy + v * (0.998 / (1 - 0.998));
        if (dy > 0 && projected > dlg.offsetHeight / 2) {
          dlg.style.transition = '';
          dlg.close(); // carries on from where the finger left it
        } else {
          dlg.style.transition = 'transform 280ms cubic-bezier(0.32, 0.72, 0, 1)';
          dlg.style.transform = '';
        }
      };
      grab.addEventListener('pointerup', endDrag);
      grab.addEventListener('pointercancel', endDrag);
      dlg.prepend(grab);
      // A close button in the corner, so a sheet never depends on finding Cancel or knowing to swipe. (The profile
      // sheet brings its own.)
      if (!dlg.querySelector('.dir-close')) {
        const x = h('button', 'dir-close', undefined, icon('<path d="M6 6l12 12M18 6L6 18"/>'));
        x.setAttribute('type', 'button');
        x.setAttribute('aria-label', 'Close');
        x.addEventListener('click', () => dlg.close());
        dlg.append(x);
      }
    }
    // On iOS the keyboard shrinks only the visual viewport, so a sheet docked to the layout viewport (and sized in dvh)
    // ends up under the keyboard with its title and buttons out of reach. On a phone, follow the visual viewport.
    const vv = window.visualViewport;
    if (vv) {
      const fit = () => {
        if (!phoneSheet.matches) {
          dlg.style.removeProperty('bottom');
          dlg.style.removeProperty('max-height');
          return;
        }
        dlg.style.bottom = `${Math.max(0, window.innerHeight - vv.offsetTop - vv.height)}px`;
        dlg.style.maxHeight = `${Math.round(vv.height * 0.88)}px`;
        const field = dlg.querySelector(':focus');
        if (field instanceof HTMLElement && field.matches('input, textarea, select')) field.scrollIntoView({ block: 'nearest' });
      };
      vv.addEventListener('resize', fit);
      vv.addEventListener('scroll', fit);
      dlg.addEventListener('close', () => {
        vv.removeEventListener('resize', fit);
        vv.removeEventListener('scroll', fit);
      }, { once: true });
    }
    document.body.append(dlg);
    dlg.showModal();
    // On a wide screen the card grows out of whatever opened it (the control that has focus, unless told otherwise).
    const from = opts.from ?? document.activeElement;
    if (from instanceof HTMLElement && !phoneSheet.matches) {
      const at = from.getBoundingClientRect();
      if (at.width > 0) {
        const box = dlg.getBoundingClientRect();
        dlg.style.transformOrigin = `${at.left + at.width / 2 - box.left}px ${at.top + at.height / 2 - box.top}px`;
      }
    }
  }

  // ---- editing my own details ----
  function detailsDialog() {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const phone = document.createElement('input');
    phone.type = 'tel';
    phone.autocomplete = 'off';
    phone.value = me!.phone ?? '';
    phone.placeholder = 'e.g. 98450 12345';
    const dir = document.createElement('input');
    dir.type = 'checkbox';
    dir.checked = me!.directoryVisible;
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const save = h('button', 'btn btn--solid', 'Save') as HTMLButtonElement;
    save.addEventListener('click', async () => {
      const body: Record<string, unknown> = {};
      if (phone.value.trim() !== (me!.phone ?? '')) body.phone = phone.value.trim() === '' ? null : phone.value;
      if (dir.checked !== me!.directoryVisible) body.directoryVisible = dir.checked;
      if (Object.keys(body).length === 0) {
        msg.textContent = 'Nothing to change.';
        return;
      }
      const done = setBusy(save, 'Saving…');
      msg.textContent = '';
      try {
        const { status, data } = await memberFetch('/api/members-me/profile', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        await load(true);
        toast('Your details are saved');
      } catch (err) {
        done();
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', 'Your details'),
      h('p', '', `Signed in as ${me!.email ?? 'your Google account'}. To change your name, email or unit, ask the core team.`),
      hinted('WhatsApp number', phone, 'We use this number to message you on WhatsApp about stays and farm updates.', 'a number with WhatsApp. Outside India, start with + and the country code'),
      h('label', 'check', undefined, dir, h('span', '', 'List me in the member directory')),
      msg,
      h('div', 'modal-actions', undefined, cancel, save),
    );
    dlg.addEventListener('close', () => dlg.remove());
    presentSheet(dlg);
  }

  // ---- family members ----
  // A field with a hint that appears only while the cursor is in it (the hint stays attached for screen readers).
  let hintSeq = 0;
  const hinted = (label: string, input: HTMLInputElement, hint: string, cue = '') => {
    const note = h('small', 'field-hint', hint);
    note.id = `hint-${++hintSeq}`;
    input.setAttribute('aria-describedby', note.id);
    // The cue is one quiet line under the field, always visible; the hint is the fuller explanation, shown as a callout while typing.
    const optional = label.endsWith(' (optional)');
    const text = optional ? label.slice(0, -' (optional)'.length) : label;
    return h('label', '', undefined, h('span', 'field-label', text, optional ? h('span', 'field-opt', ' (optional)') : null), input, cue ? h('small', 'field-help', cue.charAt(0).toUpperCase() + cue.slice(1)) : null, note);
  };
  const GOOGLE_HINT = 'They sign in with Google, so this must be an address that has a Google account: Gmail, or a work or school address on Google. There is no password to remember.';
  const WHATSAPP_HINT = 'We use this number to message them on WhatsApp about stays and farm updates.';
  // Mirrors FAMILY_LOGIN_LIMIT in scripts/lib/member-family.mjs (the server enforces it).
  const FAMILY_LOGINS = 2;

  function addFamilyDialog(asRequest: boolean) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const field = (type: string, placeholder = '') => {
      const i = document.createElement('input');
      i.type = type;
      i.autocomplete = 'off';
      i.placeholder = placeholder;
      return i;
    };
    const name = field('text');
    const email = field('email', 'name@gmail.com');
    const phone = field('tel', '98450 12345');
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const save = h('button', 'btn btn--solid', asRequest ? 'Send request' : 'Add') as HTMLButtonElement;
    save.addEventListener('click', async () => {
      const done = setBusy(save, asRequest ? 'Sending…' : 'Adding…');
      msg.textContent = '';
      try {
        const { status, data } = await memberFetch('/api/members-me/family-add', { method: 'POST', body: { fullName: name.value, email: email.value, phone: phone.value } });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        await load(true);
        toast(data.requested ? 'Sent to the core team. They will let you know.' : 'Added. They can sign in now.');
      } catch (err) {
        done();
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', asRequest ? 'Request another family member' : 'Add a family member'),
      h('p', '', asRequest
        ? `Your unit already has ${FAMILY_LOGINS} family members who can sign in, so the core team decides on more.`
        : 'They can see your unit and the member directory and, soon, book stays. They cannot edit your story, land documents or who is in your unit.'),
      h('label', '', undefined, h('span', 'field-label', 'Name'), name),
      hinted('Google email', email, GOOGLE_HINT, 'Gmail or any Google account'),
      hinted('WhatsApp number (optional)', phone, WHATSAPP_HINT, 'a number with WhatsApp. Outside India, start with + and the country code'),
      msg,
      h('div', 'modal-actions', undefined, cancel, save),
    );
    dlg.addEventListener('close', () => dlg.remove());
    presentSheet(dlg);
  }

  // Edit a family member's details, or remove them. The email and mobile on file are never sent to an owner, so those
  // fields start empty and a blank one keeps what is there.
  function editFamilyDialog(p: { id: string; name: string }) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const input = (type: string, value: string, placeholder: string) => {
      const i = document.createElement('input');
      i.type = type;
      i.autocomplete = 'off';
      i.value = value;
      i.placeholder = placeholder;
      return i;
    };
    const name = input('text', p.name, '');
    const email = input('email', '', 'Unchanged');
    const phone = input('tel', '', 'Unchanged');
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const fail = (err: unknown) => {
      msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
    };
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const save = h('button', 'btn btn--solid', 'Save') as HTMLButtonElement;
    const remove = h('button', 'link-btn link-btn--danger', 'Remove from my unit') as HTMLButtonElement;
    const run = async (btn: HTMLButtonElement, path: string, body: Record<string, unknown>, done: string, doing: string) => {
      const finish = setBusy(btn, doing);
      msg.textContent = '';
      try {
        const { status, data } = await memberFetch(path, { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        await load(true);
        toast(done);
      } catch (err) {
        finish();
        fail(err);
      }
    };
    save.addEventListener('click', () => {
      const changes: Record<string, string> = {};
      if (name.value.trim() !== p.name) changes.fullName = name.value;
      if (email.value.trim()) changes.email = email.value;
      if (phone.value.trim()) changes.phone = phone.value;
      if (Object.keys(changes).length === 0) { msg.textContent = 'Nothing to change.'; return; }
      void run(save, '/api/members-me/family-update', { personId: p.id, ...changes }, 'Saved', 'Saving…');
    });
    // Asks again before removing, in the dialog itself.
    let sure = false;
    remove.addEventListener('click', () => {
      if (!sure) {
        sure = true;
        remove.textContent = `Yes, remove ${first(p.name)}`;
        // The same spot now removes, so a second tap meant for the first must not land: pause it, and put focus on Cancel.
        remove.disabled = true;
        window.setTimeout(() => { remove.disabled = false; }, 900);
        cancel.focus();
        msg.textContent = 'They will no longer be able to sign in. You can add them again later.';
        return;
      }
      void run(remove, '/api/members-me/family-remove', { personId: p.id }, `${first(p.name)} can no longer sign in`, 'Removing…');
    });
    dlg.append(
      h('h3', '', `Edit ${p.name}`),
      h('p', '', 'Leave a field blank to keep what is on file.'),
      h('label', '', undefined, h('span', 'field-label', 'Name'), name),
      hinted('Google email', email, GOOGLE_HINT, 'Gmail or any Google account'),
      hinted('WhatsApp number', phone, WHATSAPP_HINT, 'a number with WhatsApp. Outside India, start with + and the country code'),
      msg,
      h('div', 'modal-actions', undefined, remove, cancel, save),
    );
    dlg.addEventListener('close', () => dlg.remove());
    presentSheet(dlg);
  }

  // ---- land documents ----
  // Members upload the patta / survey extract they downloaded from eservices.tn.gov.in. The
  // server reads it in the background (members-land-extract-background.mts): a record the
  // register already holds is marked verified, a new one is added for the core team to confirm.
  const DOC_STATUS: Record<string, string> = { processing: 'Reading…', applied: 'Done', needs_review: 'With the core team', failed: 'Not used' };
  const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const LAND_LABEL: Record<string, string> = { farm: 'Farm land', house: 'House plot' };

  // The household's uploaded documents, shared by the Farm and House cards and the popup that
  // lists them. Re-read every few seconds while one is still being read.
  let docsState: { householdId: string; docs: LandDoc[]; loaded: boolean } = { householdId: '', docs: [], loaded: false };
  const docsListeners = new Set<() => void>();
  let pollTimer: number | undefined;
  async function refreshDocs(hh: Hh) {
    window.clearTimeout(pollTimer);
    try {
      const { status, data } = await memberFetch('/api/members-me/land-documents');
      if (status !== 200) throw new Error();
      docsState = { householdId: hh.id, docs: (data.documents as LandDoc[]).filter((d) => d.householdId === hh.id), loaded: true };
    } catch {
      docsState = { householdId: hh.id, docs: [], loaded: false };
    }
    for (const fn of [...docsListeners]) fn();
    const processing = docsState.docs.some((d) => d.status === 'processing');
    if (processing && docsListeners.size > 0) pollTimer = window.setTimeout(() => void refreshDocs(hh), 4000);
    else if (docsState.docs.length && !processing) loadQuietly();
  }
  const docsOfType = (landType: string) => docsState.docs.filter((d) => d.landType === landType);

  function docRow(d: LandDoc): HTMLElement {
    return h('p', 'doc-row', undefined,
      h('strong', '', undefined, docLink(dateFmt.format(new Date(d.uploadedAt)) + (d.fileName ? ` · ${d.fileName}` : ''), d.status === 'failed' ? null : d.id)),
      h('span', `st-pill${d.status === 'applied' ? ' st-pill--ok' : d.status === 'needs_review' ? ' st-pill--warn' : ''}`, DOC_STATUS[d.status] ?? d.status),
      h('span', 'doc-sum', d.summary));
  }

  // Under a Farm or House card's table: one small edit button that opens a short menu of what can be done with
  // the documents for that kind of land (upload one, add an FMB sketch, see what has been uploaded). The list
  // itself is in its own popup, not on the page.
  function landCardFooter(hh: Hh, landType: 'farm' | 'house'): HTMLElement {
    const chev = icon('<path d="M9 6l6 6-6 6"/>');
    chev.setAttribute('class', 'chev');
    const meta = h('span', 'meta');
    const row = h('button', 'row card-row', undefined, icon('<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 13h5M10 17h5"/>'), h('span', 'grow', 'Documents'), meta, chev);
    row.setAttribute('type', 'button');
    row.setAttribute('data-tour', 'land-docs');
    row.addEventListener('click', () => docsMenuDialog(hh, landType));
    // How many are uploaded, once they have been read; blank until then rather than a wrong "None yet".
    const paint = () => {
      const n = docsOfType(landType).length;
      meta.textContent = docsState.householdId === hh.id && docsState.loaded ? (n ? `${n} uploaded` : 'None yet') : '';
    };
    // While this row is on the page it keeps the re-reading going after an upload (refreshDocs only polls while
    // something is listening), so verified badges appear without a reload; it stops listening once the row is gone.
    const alive = () => {
      if (!row.isConnected) docsListeners.delete(alive);
      else paint();
    };
    docsListeners.add(alive);
    paint();
    // The documents are read once so the count can show.
    if (!(docsState.householdId === hh.id && docsState.loaded)) void refreshDocs(hh);
    return row;
  }

