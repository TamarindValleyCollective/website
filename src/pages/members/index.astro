---
// The member portal (members.tvc.farm, served at /members/): where a signed-in member sees
// their own unit and everything about their membership. Shaped like a society-management web
// portal: a left menu, the member's unit always in the top bar, and a Home page that leads with one
// next step. Sign-in is Google; only members who have been invited get in
// (netlify/functions/lib/member-access.ts), and the data comes from /api/members-me/*, which
// only ever returns the member's own household. Modules that are not built yet are not in the menu;
// Home lists them once under "On the way". Nothing here shows made-up figures.
// This page deliberately has its own minimal shell: no public header, footer, cookie banner,
// chat widget or analytics, none of which belong on a page of personal data.
import '../../styles/global.css';
import SignInGate from '../../components/SignInGate.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Member portal · Tamarind Valley Collective</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SignInGate
      level="h1"
      startHidden
      title="Member portal"
      copy="Sign in with the Google account whose email you gave the core team. If you have not been invited yet, write to core-team@tvc.farm."
    />

    <div class="boot" id="boot" role="status" hidden>
      <p id="boot-msg">Opening the member portal…</p>
      <button type="button" class="btn btn--solid" id="boot-retry" hidden>Try again</button>
    </div>

    <div class="shell" id="shell" hidden>
      <aside class="side" id="side" aria-label="Member portal menu">
        <div class="side-head">
          <img class="mark" src="/images/brand/tvc-logo-mark.svg" width="38" height="38" alt="Tamarind Valley Collective" />
          <button type="button" class="collapse" id="collapse" aria-label="Collapse the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        </div>
        <nav id="nav" aria-label="Member portal"></nav>
        <div class="side-foot">
          <a class="nav-item" href="mailto:core-team@tvc.farm"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span class="nav-label">Contact the core team</span></a>
          <button type="button" class="nav-item" id="signout-side"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M15 8l4 4-4 4M19 12H9"/></svg><span class="nav-label">Sign out</span></button>
        </div>
      </aside>
      <div class="scrim" id="scrim"></div>

      <div class="col">
        <header class="topbar">
          <button type="button" class="menu-btn" id="menu" aria-label="Open the menu" aria-controls="side" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <div class="who-wrap">
            <button type="button" class="who" id="who" aria-haspopup="true" aria-expanded="false" aria-controls="who-menu">
              <span class="avatar" id="avatar" aria-hidden="true"></span>
              <span class="who-text"><strong id="who-name"></strong><small id="who-role"></small></span>
              <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5"/></svg>
            </button>
            <div class="who-menu" id="who-menu" hidden></div>
          </div>
        </header>
        <main id="view" tabindex="-1"></main>
      </div>
    </div>
    <p class="toast" id="toast" role="status" hidden></p>
  </body>
</html>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  body {
    margin: 0;
    background: var(--tvc-stone);
    color: var(--tvc-ink);
    accent-color: var(--tvc-green-dark); /* checkboxes and the like, instead of the browser's blue */
    caret-color: var(--tvc-green-dark);
  }

  body ::selection {
    background: var(--tvc-green-tint);
    color: var(--tvc-ink);
  }

  .shell[hidden],
  .shell [hidden],
  .toast[hidden] {
    display: none !important;
  }

  .shell {
    transition: grid-template-columns 200ms cubic-bezier(0.23, 1, 0.32, 1);
    display: grid;
    grid-template-columns: 15rem 1fr;
    min-height: 100vh;
  }

  .shell.collapsed {
    grid-template-columns: 4.25rem 1fr;
  }

  /* ---- left menu ---- */
  .side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-x: hidden; /* the collapse button hangs half off the edge; without this the menu grows a sideways scrollbar */
    overflow-y: auto;
    padding: 14px 10px;
    background: var(--tvc-white);
    border-right: 1px solid var(--tvc-line);
  }

  .side-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 14px;
  }

  .mark {
    display: block;
    flex: none;
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .collapse {
    position: absolute;
    right: -22px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--tvc-line);
    border-radius: 50%;
    background: var(--tvc-white);
    cursor: pointer;
  }

  .shell.collapsed .collapse svg {
    transform: rotate(180deg);
  }

  .collapse svg,
  .menu-btn svg,
  .caret {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Hidden to the eye but still the link's name: display:none would leave the collapsed menu as unlabelled icons for a screen reader. */
  .shell.collapsed .nav-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .side {
    display: flex;
    flex-direction: column;
  }

  .side-foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--tvc-line);
  }

  .scrim {
    display: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 9px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-base);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item:hover {
      background: var(--tvc-cream);
    }
  }

  .nav-item svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item[aria-current='page'] {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  .nav-item[aria-current='page'] svg {
    stroke: var(--tvc-green-dark);
  }

  .nav-label {
    flex: 1;
  }

  /* One keyboard focus ring for everything in the portal, in the same orange the story and directory controls already use. */
  .shell :is(a, button, input, select, textarea, summary):focus-visible,
  .signin :is(a, button):focus-visible,
  .boot button:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  #view h1:focus,
  #view:focus {
    outline: none;
  }

  /* ---- top bar ---- */
  .col {
    min-width: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 24px;
    background: color-mix(in srgb, var(--tvc-white) 82%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease-out;
  }

  /* The hairline appears only once content is passing under the bar. */
  .topbar.scrolled {
    border-bottom-color: var(--tvc-line);
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .topbar {
      background: var(--tvc-white);
      backdrop-filter: none;
      border-bottom-color: var(--tvc-line);
    }
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -8px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
  }

  .boot {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 96px 24px;
    text-align: center;
    color: var(--tvc-ink-soft);
  }

  .boot[hidden] {
    display: none;
  }

  .boot p {
    margin: 0;
  }

  .who-wrap {
    position: relative;
    flex: none;
    margin-left: auto;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 4px 12px 4px 8px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    font: inherit;
    cursor: pointer;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .who-text {
    display: grid;
    text-align: left;
    line-height: 1.15;
  }

  .who-text strong {
    font-size: var(--text-sm);
  }

  .who-text small {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .who-menu {
    transform-origin: top right;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 240px;
    padding: 8px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .who-menu p {
    margin: 4px 8px 6px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
    overflow-wrap: anywhere; /* a long email must not stretch the menu */
  }

  .who-menu button,
  .who-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-base);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .who-menu button[aria-pressed='true'] {
    background: var(--tvc-green-tint);
  }

  @media (hover: hover) and (pointer: fine) {
    .who-menu a:hover,
    .who-menu button:hover {
      background: var(--tvc-green-tint);
    }
  }

  /* ---- views ---- */
  #view {
    padding: 22px 24px 48px;
    outline: none;
  }

  .page-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin: 0 0 4px;
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .page-title small {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  .lede {
    margin: 0 0 18px;
    color: var(--tvc-ink-soft);
    font-size: var(--text-base);
  }

  .widgets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .widget,
  .panel {
    padding: 18px 20px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .widget--wide {
    grid-column: 1 / -1;
  }

  /* Lets a widget's contents respond to the widget's own width, not the screen's. */
  .widget {
    container-type: inline-size;
  }

  .widget h2,
  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }

  .widget h2 .more {
    margin-left: auto;
    min-height: 44px;
    margin-block: -14px;
    padding: 0 4px;
    border: none;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    cursor: pointer;
  }

  /* The one thing to do next: the dashboard's first card, and the only one that asks for something. */
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin: 0 0 16px;
    padding: 18px 20px;
    background: var(--tvc-green-tint);
    border-radius: var(--radius);
  }

  .next--swap {
    animation: next-swap 220ms ease-out;
  }

  @keyframes next-swap {
    from { opacity: 0; filter: blur(2px); }
  }

  .next-text {
    flex: 1 1 280px;
  }

  .next h2 {
    margin: 0 0 4px;
    font-size: var(--text-lg);
  }

  .next p {
    margin: 0;
    font-size: var(--text-base);
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ahead {
    margin-top: 16px;
  }

  .ahead h2 {
    margin-bottom: 8px;
  }

  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 14px;
  }

  .box {
    padding: 6px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 12px 0;
    border: none;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    font: inherit;
    font-size: var(--text-base);
    text-align: left;
    color: var(--tvc-ink);
    cursor: pointer;
  }

  .line:last-child {
    border-bottom: none;
  }

  .line b {
    font-size: var(--text-lg);
  }

  .line .go {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: var(--text-sm);
    flex: none;
  }

  .num--due {
    color: var(--tvc-orange-text);
  }

  .num--over {
    color: var(--tvc-error-text);
  }

  .num--ok {
    color: var(--tvc-green-vivid);
  }

  .empty {
    margin: 18px 0 8px;
    color: var(--tvc-ink-soft);
    text-align: center;
    font-size: var(--text-base);
  }

  .btn {
    min-height: 44px;
    padding: 9px 18px;
    border: 1px solid var(--tvc-green-dark);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
  }

  .btn--solid {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  /* Stays */
  .stay-when {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }

  .stay-when label {
    display: grid;
    gap: 4px;
    font-size: var(--text-sm);
  }

  .stay-when input,
  .stay-person input:not([type='checkbox']),
  .stay-person select {
    min-height: 44px;
    padding: 8px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    font: inherit;
  }

  .stay-summary {
    margin: 0 0 4px;
    font-weight: 600;
  }

  .stay-tents {
    margin: 0 0 8px;
    padding-left: 20px;
  }

  .stay-hint {
    margin: 8px 0 0;
    color: var(--tvc-ink-soft);
    font-size: var(--text-sm);
  }

  .stay-guest-tag {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .stay-note {
    display: grid;
    gap: 4px;
    margin: 14px 0 12px;
    font-size: var(--text-sm);
  }

  .stay-note textarea {
    padding: 8px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
    resize: vertical;
  }

  .stay-tent {
    margin: 16px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .stay-tent legend {
    padding: 0 6px;
    font-weight: 600;
  }

  .stay-person {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .stay-person input:not([type='checkbox']) {
    flex: 1 1 160px;
    min-width: 0;
  }

  .stay-card {
    padding: 12px 0;
    border-top: 1px solid var(--tvc-line);
  }

  .stay-card:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .stay-card--past {
    color: var(--tvc-ink-soft);
  }

  .stay-line {
    margin: 0 0 4px;
    font-size: var(--text-sm);
  }

  .btn--cta {
    border-color: var(--tvc-orange-cta);
    background: var(--tvc-orange-cta);
    color: var(--tvc-ink);
  }

  /* Feedback on the press itself, not on release. */
  :is(.btn, .nav-item, .who, .menu-btn, .more, .dir-chip, .who-menu button, .who-menu a) {
    transition: transform 120ms ease-out, background-color 120ms ease-out;
  }

  :is(.btn, .nav-item, .who, .menu-btn, .more, .dir-chip, .who-menu button, .who-menu a):active:not(:disabled) {
    transform: scale(0.97);
  }

  .dir-card {
    transition: transform 120ms ease-out, border-color 120ms ease-out;
  }

  .dir-card:active {
    transform: scale(0.985);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 16px 0 22px;
  }

  .kpi {
    padding: 14px 16px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .kpi .k {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  /* Land areas in a table: Inter's own equal-width digits, right-aligned, so the decimal points line up down the column. */
  .num {
    font-variant-numeric: tabular-nums;
  }

  /* Equal-width digits for the tables (Inter has them; the Fraunces figures are never stacked in a column). */
  .table-wrap table {
    font-variant-numeric: tabular-nums;
  }

  .kpi .v {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .unit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
    align-items: start;
  }

  /* The code pills of a card, together at the right of its heading. */
  .pills {
    display: flex;
    gap: 6px;
    margin: -4px 0 -4px auto; /* don't make the row taller than its heading */
  }

  .tile .pills {
    flex-wrap: wrap;
    margin: 0;
  }

  /* Tinted with a dark outline (so they read on both the white card and the tinted Home tile); the key code is solid. */
  .pills .pill {
    margin: 0;
    padding: 3px 12px;
    border-color: var(--tvc-green-dark);
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    /* Set outright: the pills sit inside a Fraunces h2 on My unit and an uppercase Inter row on Home, and must look the same in both:
       the display face they had under the headings. */
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
  }

  .pills .pill--key {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .pill {
    margin: -4px 0 -4px auto; /* don't make the row taller than its heading */
    padding: 2px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
  }

  .docs-list {
    margin: 0 0 12px;
  }

  .doc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 8px;
    font-size: var(--text-base);
  }

  .doc-row .pill {
    margin: 0;
  }

  .doc-sum {
    flex-basis: 100%;
    color: var(--tvc-ink-soft);
  }

  /* Under a Farm / House card: the two uploads as buttons (the main one filled), and a link to what has been uploaded (shown in a popup). */
  .card-docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 14px;
  }

  .link-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  dialog.modal.upload-modal {
    width: min(560px, calc(100vw - 32px));
  }

  .upload-help {
    margin: 0 0 12px;
    padding: 12px 14px;
    background: var(--tvc-green-tint);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .upload-help p,
  .upload-help ul {
    margin: 0 0 8px;
  }

  .upload-help ul {
    padding-left: 20px;
  }

  .upload-help li {
    margin-bottom: 4px;
  }

  .upload-help > :last-child {
    margin-bottom: 0;
  }

  .upload-help a {
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  dialog.modal.docs-modal {
    width: min(560px, calc(100vw - 32px));
  }

  .docs-list {
    max-height: 50vh;
    overflow-y: auto;
  }

  .survey-cell {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .parcel-shape {
    display: block;
    width: auto;
    height: 28px;
    flex: none;
  }

  .merged-cell {
    vertical-align: top;
  }

  .doc-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  /* Verified / awaiting / not verified: an icon, with the words for screen readers and on hover. */
  .vmark {
    display: inline-flex;
    vertical-align: middle;
  }

  .vmark svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vmark--verified {
    color: var(--tvc-green);
  }

  .vmark--pending_review {
    color: var(--tvc-orange-text);
  }

  .vmark--unverified {
    color: var(--tvc-ink-soft);
  }

  .vmark .vtext {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .unit-cols .kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 12px 0 16px;
  }

  .shell table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .shell th,
  .shell td {
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--tvc-line);
    text-align: left;
    vertical-align: top;
  }

  .shell th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .shell td.r,
  .shell th.r {
    text-align: right;
  }

  .shell tfoot td {
    font-weight: 700;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .role-head {
    margin: 14px 0 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
  }

  .role-head:first-child {
    margin-top: 0;
  }

  .shell tr.group-row th {
    padding-top: 14px;
    border-bottom: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--tvc-ink-soft);
    text-align: left;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .people li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .people .who2 {
    flex: 1;
    min-width: 0;
  }

  .people .who2 strong {
    display: block;
    font-size: var(--text-base);
  }

  .people .who2 span {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  /* The tiles share three rows (code pills, figure, caption), so the figures sit on one line even when one tile's pills wrap to two. */
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 12px;
  }

  /* In a narrow widget (a phone, or a half-width card) the two tiles stack, so the pills and figures keep one line each. */
  @container (max-width: 440px) {
    .tiles {
      grid-template-columns: 1fr;
      row-gap: 12px;
    }
  }

  .tile {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
  }

  .tile .k {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-start; /* the row is as tall as the other tile's, but its icon and pills stay at the top */
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .glyph {
    display: inline-flex;
  }

  .glyph svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--tvc-green-dark);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tile .v {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .tile .s {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .prompt {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: var(--text-sm);
  }

  .soon-list {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--tvc-ink-soft);
    font-size: var(--text-base);
  }

  dialog.modal label.check {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-msg {
    min-height: 1.2em;
    margin: 0 0 4px;
    color: var(--tvc-error-text);
    font-size: var(--text-sm);
  }

  dialog.modal {
    width: min(420px, calc(100vw - 24px));
    padding: 20px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  dialog.modal.notice {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
  }

  dialog.modal.notice h4 {
    margin: 14px 0 2px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
  }

  dialog.modal.notice h4 + p {
    margin-bottom: 0;
  }

  dialog.modal::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  dialog.modal h3 {
    margin: 0 0 6px;
    font-size: var(--text-xl);
  }

  dialog.modal p {
    margin: 0 0 12px;
    font-size: var(--text-sm);
    color: var(--tvc-ink-soft);
  }

  dialog.modal label {
    display: grid;
    gap: 4px;
    margin-bottom: 10px;
    font-size: var(--text-sm);
  }

  dialog.modal input,
  dialog.modal select {
    padding: 8px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
  }

  .who-menu:not([hidden], .out) {
    animation: pop-in 140ms ease-out;
  }

  .who-menu.out {
    animation: pop-out 100ms ease-out forwards;
  }

  .toast:not([hidden], .out) {
    animation: toast-in 200ms ease-out;
  }

  .toast.out {
    animation: toast-out 120ms ease-out forwards;
  }

  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.97); }
  }

  @keyframes pop-out {
    to { opacity: 0; transform: scale(0.97); }
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translate(-50%, 8px); }
  }

  @keyframes toast-out {
    to { opacity: 0; transform: translate(-50%, 4px); }
  }

  @keyframes fade-in {
    from { opacity: 0; }
  }

  @keyframes fade-out {
    to { opacity: 0; }
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 20;
    transform: translateX(-50%);
    margin: 0;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--tvc-ink);
    color: var(--tvc-white);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .shell,
    .shell.collapsed {
      grid-template-columns: 1fr;
    }

    .side {
      position: fixed;
      z-index: 10;
      left: 0;
      top: 0;
      width: 17.5rem;
      max-width: 86vw;
      transform: translateX(-105%);
      visibility: hidden;
      transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s 280ms;
    }

    .shell.open .side {
      transform: none;
      visibility: visible;
      transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
      box-shadow: var(--shadow-soft);
    }

    .scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 9;
      background: color-mix(in srgb, var(--tvc-ink) 40%, transparent);
      opacity: 0;
      visibility: hidden;
      transition: opacity 200ms ease-out, visibility 0s 200ms;
    }

    .shell.open .scrim {
      opacity: 1;
      visibility: visible;
      transition: opacity 200ms ease-out;
    }

    .collapse {
      display: none;
    }

    .menu-btn {
      display: grid;
    }

    .topbar {
      padding: 10px 14px;
      gap: 10px;
    }

    #view {
      padding: 16px 14px 40px;
    }

    .widgets,
    .split,
    .unit-cols {
      grid-template-columns: 1fr;
    }

    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .who-text {
      display: none;
    }
  }

  /* Reduced motion keeps the feedback and drops the movement: fades instead of slides, no press scale. */
  @media (prefers-reduced-motion: reduce) {
    .side,
    .shell,
    .scrim {
      transition: none !important;
    }

    :is(.btn, .nav-item, .who, .menu-btn, .more, .dir-chip, .who-menu button, .who-menu a, .dir-card):active {
      transform: none !important;
    }

    .who-menu:not([hidden], .out),
    .toast:not([hidden], .out),
    .next--swap {
      animation-name: fade-in;
    }

    .who-menu.out,
    .toast.out {
      animation-name: fade-out;
    }
  }
  /* ---- your story ---- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .story-side {
    position: sticky;
    top: 74px;
  }

  .story-prev-label {
    margin: 0 0 8px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .story-status {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0 0 18px;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-stone);
    font-size: var(--text-sm);
  }

  .story-status--review {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .story-status--live {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .story-field {
    display: block;
    margin: 0 0 18px;
  }

  .story-label {
    display: block;
    margin-bottom: 3px;
    font-weight: 700;
    font-size: var(--text-base);
  }

  .story-hint {
    display: block;
    margin: 0 0 6px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .story-hint--warn {
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  .story-field textarea,
  .story-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 11px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    resize: vertical;
  }

  .story-field textarea:focus-visible,
  .story-field input:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .md-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 6px;
  }

  .md-btn {
    padding: 5px 11px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    color: var(--tvc-ink);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .md-btn:hover {
    border-color: var(--tvc-green-dark);
    color: var(--tvc-green-dark);
  }

  .md-btn:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 2px;
  }

  .md-note:empty {
    display: none;
  }

  .md-panel {
    margin: 0 0 8px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
  }

  .md-panel-title {
    margin: 0 0 6px;
    font-size: var(--text-sm);
  }

  .md-panel-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .md-panel-row input {
    flex: 1 1 14rem;
    width: auto;
    padding: 7px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
  }

  .md-panel .story-hint {
    margin: 6px 0 0;
  }

  .md-panel .story-hint:empty {
    display: none;
  }

  a.md-link {
    color: var(--tvc-green-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .story-save {
    min-height: 1.2em;
    margin: -6px 0 14px;
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .story-photo {
    object-fit: cover;
  }

  .story-photo-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .story-thumb {
    flex: none;
  }

  /* The crop dialog: the picture inside a circle, the shape it takes on the card. */
  dialog.crop-modal {
    width: min(360px, calc(100vw - 24px));
    text-align: center;
  }

  .crop-stage {
    display: grid;
    place-items: center;
    margin: 12px 0;
  }

  .crop-view {
    width: 280px;
    height: 280px;
    max-width: 100%;
    border-radius: 50%;
    border: 2px solid var(--tvc-line-strong);
    background: var(--tvc-stone);
    cursor: grab;
    touch-action: none; /* a drag moves the picture, it does not scroll the page */
  }

  .crop-view:active {
    cursor: grabbing;
  }

  .crop-view:focus-visible {
    outline: 2px solid var(--tvc-orange);
    outline-offset: 3px;
  }

  .crop-zoom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 8px 8px;
    font-size: var(--text-sm);
  }

  .crop-zoom input {
    flex: 1;
    min-height: 44px;
  }

  .story-photo-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 6px;
  }

  /* A unit's photos (at most two): each with its own Remove, then one Add button and the note. */
  .story-photos {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 10px;
  }

  .story-photo-item {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .story-others {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
    background: var(--tvc-stone);
  }

  .story-others p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .photo-missing {
    visibility: hidden;
  }

  .story-box {
    margin: 0 0 16px;
    padding: 14px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-cream);
  }

  .story-box-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .story-box h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }

  .story-ok {
    margin: 10px 0 0;
    font-weight: 600;
    color: var(--tvc-green-dark);
  }

  .story-sug {
    margin-top: 10px;
    padding: 10px 12px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
  }

  .story-sug--done {
    opacity: 0.55;
  }

  .story-sug-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .story-sug-field {
    font-size: var(--text-xs);
    color: var(--tvc-ink-soft);
  }

  .story-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--tvc-stone);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .story-tag--framing {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  .story-tag--privacy {
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .story-tag--tone,
  .story-tag--note {
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
  }

  .story-diff {
    margin: 8px 0 4px;
  }

  .story-diff del {
    padding: 0 3px;
    border-radius: 3px;
    background: var(--tvc-error-bg);
    color: var(--tvc-error-text);
  }

  .story-diff ins {
    padding: 0 3px;
    border-radius: 3px;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .story-sug-note {
    margin: 8px 0;
    font-size: var(--text-base);
  }

  .story-sug-act {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .story-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
    align-items: flex-start;
    cursor: pointer;
  }

  .story-toggle small {
    display: block;
    color: var(--tvc-ink-soft);
  }

  .story-card {
    padding: 18px 20px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    box-shadow: var(--shadow-soft);
  }

  .avatar--lg {
    flex: none;
    width: 56px;
    height: 56px;
    font-size: var(--text-xl);
  }

  .story-card-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  /* Two photos of a unit overlap, like the Directory card. */
  .story-card-faces {
    display: flex;
  }

  .story-card-faces .avatar + .avatar {
    margin-left: -14px;
  }

  .story-card-faces .avatar {
    box-shadow: 0 0 0 2px var(--tvc-white);
  }

  .story-card h3 {
    margin: 0 0 4px;
    font-size: var(--text-lg);
  }

  .story-card-bio,
  .story-card-fam {
    margin: 0 0 10px;
  }

  .story-card-fam {
    font-size: var(--text-base);
    color: var(--tvc-ink-soft);
  }

  .story-card-why {
    margin: 12px 0;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
    font-style: italic;
  }

  .story-empty {
    color: var(--tvc-ink-soft);
  }

  .story-vis {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .story-vis--public {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
  }

  @media (max-width: 900px) {
    .story {
      grid-template-columns: 1fr;
    }

    .story-side {
      position: static;
      order: -1;
    }
  }
  .lede--warn {
    color: var(--tvc-orange-text);
    font-weight: 600;
  }

  /* ---- directory ---- */
  .dir-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin: 0 0 8px;
  }

  .dir-bar input[type='search'] {
    flex: 1 1 260px;
    min-width: 0;
    max-width: 420px;
    padding: 8px 11px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    background: var(--tvc-white);
    font: inherit;
  }

