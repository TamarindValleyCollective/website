---
// The member portal (members.tvc.farm, served at /members/): where a signed-in member sees
// their own unit and everything about their membership. Shaped like a society-management web
// portal: a left menu of modules, a module search, the member's unit always in the top bar, and a
// dashboard of widgets. Sign-in is Google; only members who have been invited get in
// (netlify/functions/lib/member-access.ts), and the data comes from /api/members-me/*, which
// only ever returns the member's own household. Modules that are not built yet say so ("Soon");
// nothing here shows made-up figures.
// This page deliberately has its own minimal shell: no public header, footer, cookie banner,
// chat widget or analytics, none of which belong on a page of personal data.
import '../../styles/global.css';
import SignInGate from '../../components/SignInGate.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Member portal · Tamarind Valley Collective</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SignInGate
      level="h1"
      startHidden
      title="Member portal"
      copy="Sign in with the Google account you gave the core team. If you have not been invited yet, please contact the core team."
    />

    <div class="shell" id="shell" hidden>
      <aside class="side" id="side" aria-label="Modules">
        <div class="side-head">
          <img class="mark" src="/images/brand/tvc-logo-mark.svg" width="38" height="38" alt="Tamarind Valley Collective" />
          <button type="button" class="collapse" id="collapse" aria-label="Collapse the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        </div>
        <nav id="nav"></nav>
      </aside>

      <div class="col">
        <header class="topbar">
          <button type="button" class="menu-btn" id="menu" aria-label="Open the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <label class="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4-4"/></svg>
            <input id="search" type="search" placeholder="Search modules" autocomplete="off" />
            <kbd>⌘K</kbd>
          </label>
          <div class="who-wrap">
            <button type="button" class="who" id="who" aria-haspopup="true" aria-expanded="false">
              <span class="unit-chip" id="unit-chip"></span>
              <span class="avatar" id="avatar" aria-hidden="true"></span>
              <span class="who-text"><strong id="who-name"></strong><small id="who-role"></small></span>
              <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5"/></svg>
            </button>
            <div class="who-menu" id="who-menu" hidden></div>
          </div>
        </header>
        <main id="view" tabindex="-1"></main>
      </div>
    </div>
    <p class="toast" id="toast" role="status" hidden></p>
  </body>
</html>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  body {
    margin: 0;
    background: var(--tvc-stone);
    color: var(--tvc-ink);
  }

  .shell[hidden],
  .shell [hidden],
  .toast[hidden] {
    display: none !important;
  }

  .shell {
    display: grid;
    grid-template-columns: 232px 1fr;
    min-height: 100vh;
  }

  .shell.collapsed {
    grid-template-columns: 68px 1fr;
  }

  /* ---- left menu ---- */
  .side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    padding: 14px 10px;
    background: var(--tvc-white);
    border-right: 1px solid var(--tvc-line);
  }

  .side-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 14px;
  }

  .mark {
    display: block;
    flex: none;
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .collapse {
    position: absolute;
    right: -22px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--tvc-line);
    border-radius: 50%;
    background: var(--tvc-white);
    cursor: pointer;
  }

  .shell.collapsed .collapse svg {
    transform: rotate(180deg);
  }

  .collapse svg,
  .menu-btn svg,
  .search svg,
  .caret {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .shell.collapsed .nav-label,
  .shell.collapsed .nav-group,
  .shell.collapsed .nav-soon {
    display: none;
  }

  .nav-group {
    margin: 14px 8px 4px;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 9px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--tvc-ink);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-item:hover {
    background: var(--tvc-cream);
  }

  .nav-item svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item[aria-current='page'] {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  .nav-item[aria-current='page'] svg {
    stroke: var(--tvc-green-dark);
  }

  .nav-label {
    flex: 1;
  }

  .nav-soon {
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font-size: 0.65rem;
    font-weight: 600;
  }

  /* ---- top bar ---- */
  .col {
    min-width: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 24px;
    background: var(--tvc-white);
    border-bottom: 1px solid var(--tvc-line);
  }

  .menu-btn {
    display: none;
    padding: 6px;
    border: none;
    background: none;
    cursor: pointer;
  }

  .search {
    display: flex;
    flex: 1;
    min-width: 0; /* an input can't shrink below its default width unless its wrapper may, which pushed the bar past a phone's width */
    align-items: center;
    gap: 10px;
    max-width: 520px;
    padding: 8px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-cream);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    outline: none;
  }

  .search kbd {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font: inherit;
    font-size: 0.75rem;
  }

  .who-wrap {
    position: relative;
    flex: none;
    margin-left: auto;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    font: inherit;
    cursor: pointer;
  }

  .unit-chip {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .who-text {
    display: grid;
    text-align: left;
    line-height: 1.15;
  }

  .who-text strong {
    font-size: 0.85rem;
  }

  .who-text small {
    font-size: 0.72rem;
    color: var(--tvc-ink-soft);
  }

  .who-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 240px;
    padding: 8px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .who-menu p {
    margin: 4px 8px 6px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .who-menu button {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    font-size: 0.88rem;
    text-align: left;
    cursor: pointer;
  }

  .who-menu button:hover,
  .who-menu button[aria-pressed='true'] {
    background: var(--tvc-green-tint);
  }

  .ribbon {
    margin: 0;
    padding: 5px 24px;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.75rem;
  }

  /* ---- views ---- */
  #view {
    padding: 22px 24px 48px;
    outline: none;
  }

  .crumbs {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .page-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin: 0 0 4px;
    font-size: 1.5rem;
  }

  .page-title small {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  .lede {
    margin: 0 0 18px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .widgets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .widget,
  .panel {
    padding: 18px 20px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .widget--wide {
    grid-column: 1 / -1;
  }

  .widget h2,
  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .widget h2 .more {
    margin-left: auto;
    padding: 0;
    border: none;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    cursor: pointer;
  }

  .sample {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 14px;
  }

  .box {
    padding: 6px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 12px 0;
    border: none;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    color: var(--tvc-ink);
    cursor: pointer;
  }

  .line:last-child {
    border-bottom: none;
  }

  .line b {
    font-size: 1.05rem;
  }

  .line .go {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.85rem;
    flex: none;
  }

  .num--due {
    color: var(--tvc-orange-text);
  }

  .num--over {
    color: var(--tvc-error-text);
  }

  .num--ok {
    color: var(--tvc-green-vivid);
  }

  .empty {
    margin: 18px 0 8px;
    color: var(--tvc-ink-soft);
    text-align: center;
    font-size: 0.9rem;
  }

  .btn {
    padding: 9px 16px;
    border: 1px solid var(--tvc-green-dark);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn--solid {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .btn--cta {
    border-color: var(--tvc-orange-cta);
    background: var(--tvc-orange-cta);
    color: var(--tvc-ink);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 16px 0 22px;
  }

  .kpi {
    padding: 14px 16px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .kpi .k {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .kpi .v {
    margin-top: 6px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .unit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
    align-items: start;
  }

  .pill {
    margin: -4px 0 -4px auto; /* don't make the row taller than its heading */
    padding: 2px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
  }

  .docs-list {
    margin: 0 0 12px;
  }

  .doc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 8px;
    font-size: 0.9rem;
  }

  .doc-row .pill {
    margin: 0;
  }

  .doc-sum {
    flex-basis: 100%;
    color: var(--tvc-ink-soft);
  }

  /* Under a Farm / House card: upload, and a link to what has been uploaded (shown in a popup). */
  .card-docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 14px;
  }

  .link-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  dialog.modal.upload-modal {
    width: min(560px, calc(100vw - 32px));
  }

  .upload-help {
    margin: 0 0 12px;
    padding: 12px 14px;
    background: var(--tvc-green-tint);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }

  .upload-help p,
  .upload-help ul {
    margin: 0 0 8px;
  }

  .upload-help ul {
    padding-left: 20px;
  }

  .upload-help li {
    margin-bottom: 4px;
  }

  .upload-help > :last-child {
    margin-bottom: 0;
  }

  .upload-help a {
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  dialog.modal.docs-modal {
    width: min(560px, calc(100vw - 32px));
  }

  .docs-list {
    max-height: 50vh;
    overflow-y: auto;
  }

  .survey-cell {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .parcel-shape {
    display: block;
    width: auto;
    height: 28px;
    flex: none;
  }

  .merged-cell {
    vertical-align: top;
  }

  .doc-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  /* Verified / awaiting / not verified: an icon, with the words for screen readers and on hover. */
  .vmark {
    display: inline-flex;
    vertical-align: middle;
  }

  .vmark svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vmark--verified {
    color: var(--tvc-green);
  }

  .vmark--pending_review {
    color: var(--tvc-orange-text);
  }

  .vmark--unverified {
    color: var(--tvc-ink-soft);
  }

  .vmark .vtext {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .unit-cols .kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 12px 0 16px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 8px 0 14px;
  }

  .toolbar h3 {
    margin: 0 auto 0 0;
    font-size: 1.1rem;
  }

  .invoice {
    margin-bottom: 14px;
    padding: 16px 20px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
  }

  .invoice h4 {
    margin: 0 0 2px;
    font-size: 1.05rem;
    color: var(--tvc-green-dark);
  }

  .invoice .meta {
    margin: 0 0 12px;
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .shell table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .shell th,
  .shell td {
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--tvc-line);
    text-align: left;
    vertical-align: top;
  }

  .shell th {
    font-size: 0.74rem;
    color: var(--tvc-ink-soft);
  }

  .shell td.r,
  .shell th.r {
    text-align: right;
  }

  .shell tfoot td {
    font-weight: 700;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .people li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .people .who2 {
    flex: 1;
    min-width: 0;
  }

  .people .who2 strong {
    display: block;
    font-size: 0.92rem;
  }

  .people .who2 span {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tile {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
  }

  .tile .k {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .glyph {
    display: inline-flex;
  }

  .glyph svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--tvc-green-dark);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tile .v {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--tvc-green-dark);
  }

  .tile .s {
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .prompt {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.82rem;
  }

  .soon-list {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  dialog.modal label.check {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-msg {
    min-height: 1.2em;
    margin: 0 0 4px;
    color: var(--tvc-error-text);
    font-size: 0.85rem;
  }

  dialog.modal {
    width: min(420px, calc(100vw - 24px));
    padding: 20px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  dialog.modal.notice {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
  }

  dialog.modal.notice h4 {
    margin: 14px 0 2px;
    font-size: 0.9rem;
  }

  dialog.modal.notice h4 + p {
    margin-bottom: 0;
