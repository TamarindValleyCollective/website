    help: ['Raise a request and follow its status'],
  };

  let me: Me | null = null;
  // Family members sign in with fewer rights: they see the unit and the directory, but do not edit the story, land documents or who is in the unit.
  const isFamily = () => me?.role === 'family';
  const isOwner = () => me?.role === 'owner';
  let all: Hh[] = [];
  let current = 0;
  let route = 'dashboard';
  // The part of the hash after "?" (#/directory?unit=F-12), so one page can open something on arrival.
  let routeQuery = new URLSearchParams();
  let toastTimer: number | undefined;

  // Long enough to read a whole sentence once, not a flash.
  function toast(msg: string) {
    const t = $('toast');
    t.textContent = msg;
    t.classList.remove('out');
    t.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      t.classList.add('out'); // leaves faster than it arrived
      toastTimer = window.setTimeout(() => {
        t.hidden = true;
        t.classList.remove('out');
      }, 120);
    }, Math.max(4000, msg.length * 70));
  }

  const hhNow = (): Hh => all[Math.min(current, all.length - 1)];
  const meIn = (hh: Hh): Person => hh.people.find((p) => p.id === me?.personId) ?? hh.people[0];

  // ---- shell ----
  const MAX_TABS = 5;
  function renderNav() {
    const nav = $('nav');
    const bar = $('tabbar');
    nav.replaceChildren();
    bar.replaceChildren();
    const onPhone = window.matchMedia('(max-width: 560px)').matches;
    const shown = NAV.filter((item) => !(item.soon || item.hidden || (item.id === 'story' && me && isFamily())));
    // The phone's bar holds five places at most: past that the last ones go under "More", so adding a page never squeezes the rest.
    const overflow = shown.length > MAX_TABS ? shown.slice(MAX_TABS - 1) : [];
    const mk = (item: NavItem, cls: string, label: string) => {
      const a = h('a', cls, undefined, icon(item.icon), h('span', label, item.label, ...(item.preview && cls ? [previewPill()] : [])));
      a.setAttribute('href', `#/${item.id}`);
      if (item.id === route) a.setAttribute('aria-current', 'page');
