---
// The member portal (members.tvc.farm, served at /members/): where a signed-in member sees
// their own unit and everything about their membership. Shaped like a society-management web
// portal: a left menu of modules, a module search, the member's unit always in the top bar, and a
// dashboard of widgets. Sign-in is Google; only members who have been invited get in
// (netlify/functions/lib/member-access.ts), and the data comes from /api/members-me/*, which
// only ever returns the member's own household. Modules that are not built yet say so ("Soon");
// nothing here shows made-up figures.
// This page deliberately has its own minimal shell: no public header, footer, cookie banner,
// chat widget or analytics, none of which belong on a page of personal data.
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Member portal · Tamarind Valley Collective</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div id="gate" class="gate" hidden>
      <img class="mark" src="/images/brand/tvc-logo-mark.svg" width="56" height="56" alt="Tamarind Valley Collective" />
      <h1>Member portal</h1>
      <p>Sign in with the Google account you gave the core team. If you have not been invited yet, please contact the core team.</p>
      <div id="g_id_signin"></div>
      <p id="gate-error" class="gate-error" role="alert" hidden></p>
    </div>

    <div class="shell" id="shell" hidden>
      <aside class="side" id="side" aria-label="Modules">
        <div class="side-head">
          <img class="mark" src="/images/brand/tvc-logo-mark.svg" width="38" height="38" alt="Tamarind Valley Collective" />
          <button type="button" class="collapse" id="collapse" aria-label="Collapse the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        </div>
        <nav id="nav"></nav>
      </aside>

      <div class="col">
        <header class="topbar">
          <button type="button" class="menu-btn" id="menu" aria-label="Open the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <label class="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4-4"/></svg>
            <input id="search" type="search" placeholder="Search modules" autocomplete="off" />
            <kbd>⌘K</kbd>
          </label>
          <div class="who-wrap">
            <button type="button" class="who" id="who" aria-haspopup="true" aria-expanded="false">
              <span class="unit-chip" id="unit-chip"></span>
              <span class="avatar" id="avatar" aria-hidden="true"></span>
              <span class="who-text"><strong id="who-name"></strong><small id="who-role"></small></span>
              <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5"/></svg>
            </button>
            <div class="who-menu" id="who-menu" hidden></div>
          </div>
        </header>
        <main id="view" tabindex="-1"></main>
      </div>
    </div>
    <p class="toast" id="toast" role="status" hidden></p>
  </body>
</html>

<script is:inline src="https://accounts.google.com/gsi/client"></script>

<style is:global>
  body {
    margin: 0;
    background: var(--tvc-stone);
    color: var(--tvc-ink);
  }

  .shell[hidden],
  .shell [hidden],
  .gate[hidden],
  .toast[hidden] {
    display: none !important;
  }

  .shell {
    display: grid;
    grid-template-columns: 232px 1fr;
    min-height: 100vh;
  }

  .shell.collapsed {
    grid-template-columns: 68px 1fr;
  }

  /* ---- left menu ---- */
  .side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    padding: 14px 10px;
    background: var(--tvc-white);
    border-right: 1px solid var(--tvc-line);
  }

  .side-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 14px;
  }

  .mark {
    display: block;
    flex: none;
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .collapse {
    position: absolute;
    right: -22px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--tvc-line);
    border-radius: 50%;
    background: var(--tvc-white);
    cursor: pointer;
  }

  .shell.collapsed .collapse svg {
    transform: rotate(180deg);
  }

  .collapse svg,
  .menu-btn svg,
  .search svg,
  .caret {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .shell.collapsed .nav-label,
  .shell.collapsed .nav-group,
  .shell.collapsed .nav-soon {
    display: none;
  }

  .nav-group {
    margin: 14px 8px 4px;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 9px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--tvc-ink);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-item:hover {
    background: var(--tvc-cream);
  }

  .nav-item svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--tvc-ink-soft);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item[aria-current='page'] {
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 600;
  }

  .nav-item[aria-current='page'] svg {
    stroke: var(--tvc-green-dark);
  }

  .nav-label {
    flex: 1;
  }

  .nav-soon {
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font-size: 0.65rem;
    font-weight: 600;
  }

  /* ---- top bar ---- */
  .col {
    min-width: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 24px;
    background: var(--tvc-white);
    border-bottom: 1px solid var(--tvc-line);
  }

  .menu-btn {
    display: none;
    padding: 6px;
    border: none;
    background: none;
    cursor: pointer;
  }

  .search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    max-width: 520px;
    padding: 8px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-cream);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    outline: none;
  }

  .search kbd {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--tvc-stone);
    color: var(--tvc-ink-soft);
    font: inherit;
    font-size: 0.75rem;
  }

  .who-wrap {
    position: relative;
    margin-left: auto;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    font: inherit;
    cursor: pointer;
  }

  .unit-chip {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .who-text {
    display: grid;
    text-align: left;
    line-height: 1.15;
  }

  .who-text strong {
    font-size: 0.85rem;
  }

  .who-text small {
    font-size: 0.72rem;
    color: var(--tvc-ink-soft);
  }

  .who-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 240px;
    padding: 8px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .who-menu p {
    margin: 4px 8px 6px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .who-menu button {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    font-size: 0.88rem;
    text-align: left;
    cursor: pointer;
  }

  .who-menu button:hover,
  .who-menu button[aria-pressed='true'] {
    background: var(--tvc-green-tint);
  }

  .ribbon {
    margin: 0;
    padding: 5px 24px;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.75rem;
  }

  /* ---- views ---- */
  #view {
    padding: 22px 24px 48px;
    outline: none;
  }

  .crumbs {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .page-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin: 0 0 4px;
    font-size: 1.5rem;
  }

  .page-title small {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--tvc-ink-soft);
  }

  .lede {
    margin: 0 0 18px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .widgets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .widget,
  .panel {
    padding: 18px 20px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .widget--wide {
    grid-column: 1 / -1;
  }

  .widget h2,
  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .widget h2 .more {
    margin-left: auto;
    padding: 0;
    border: none;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    cursor: pointer;
  }

  .sample {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 14px;
  }

  .box {
    padding: 6px 16px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius-sm);
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 12px 0;
    border: none;
    border-bottom: 1px solid var(--tvc-line);
    background: none;
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    color: var(--tvc-ink);
    cursor: pointer;
  }

  .line:last-child {
    border-bottom: none;
  }

  .line b {
    font-size: 1.05rem;
  }

  .line .go {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.85rem;
    flex: none;
  }

  .num--due {
    color: var(--tvc-orange-text);
  }

  .num--over {
    color: var(--tvc-error-text);
  }

  .num--ok {
    color: var(--tvc-green-vivid);
  }

  .empty {
    margin: 18px 0 8px;
    color: var(--tvc-ink-soft);
    text-align: center;
    font-size: 0.9rem;
  }

  .btn {
    padding: 9px 16px;
    border: 1px solid var(--tvc-green-dark);
    border-radius: var(--radius-sm);
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn--solid {
    background: var(--tvc-green-dark);
    color: var(--tvc-white);
  }

  .btn--cta {
    border-color: var(--tvc-orange-cta);
    background: var(--tvc-orange-cta);
    color: var(--tvc-ink);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 16px 0 22px;
  }

  .kpi {
    padding: 14px 16px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .kpi .k {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .kpi .v {
    margin-top: 6px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .unit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
    align-items: start;
  }

  .pill {
    margin: -4px 0 -4px auto; /* don't make the row taller than its heading */
    padding: 2px 10px;
    border: 1px solid var(--tvc-line);
    border-radius: 999px;
    background: var(--tvc-white);
    color: var(--tvc-green-dark);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
  }

  .docs-list {
    margin: 0 0 12px;
  }

  .doc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 8px;
    font-size: 0.9rem;
  }

  .doc-row .pill {
    margin: 0;
  }

  .doc-sum {
    flex-basis: 100%;
    color: var(--tvc-ink-soft);
  }

  /* Under a Farm / House card: upload, and a link to what has been uploaded (shown in a popup). */
  .card-docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 14px;
  }

  .link-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  dialog.docs-modal {
    width: min(560px, calc(100vw - 32px));
  }

  .docs-list {
    max-height: 50vh;
    overflow-y: auto;
  }

  .survey-cell {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .parcel-shape {
    display: block;
    width: auto;
    height: 28px;
    flex: none;
  }

  .merged-cell {
    vertical-align: top;
  }

  .doc-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tvc-green-dark);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  /* Verified / awaiting / not verified: an icon, with the words for screen readers and on hover. */
  .vmark {
    display: inline-flex;
    vertical-align: middle;
  }

  .vmark svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vmark--verified {
    color: var(--tvc-green);
  }

  .vmark--pending_review {
    color: var(--tvc-orange-text);
  }

  .vmark--unverified {
    color: var(--tvc-ink-soft);
  }

  .vmark .vtext {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .unit-cols .kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 12px 0 16px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 8px 0 14px;
  }

  .toolbar h3 {
    margin: 0 auto 0 0;
    font-size: 1.1rem;
  }

  .invoice {
    margin-bottom: 14px;
    padding: 16px 20px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
  }

  .invoice h4 {
    margin: 0 0 2px;
    font-size: 1.05rem;
    color: var(--tvc-green-dark);
  }

  .invoice .meta {
    margin: 0 0 12px;
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .shell table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .shell th,
  .shell td {
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--tvc-line);
    text-align: left;
    vertical-align: top;
  }

  .shell th {
    font-size: 0.74rem;
    color: var(--tvc-ink-soft);
  }

  .shell td.r,
  .shell th.r {
    text-align: right;
  }

  .shell tfoot td {
    font-weight: 700;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .people li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .people .who2 {
    flex: 1;
    min-width: 0;
  }

  .people .who2 strong {
    display: block;
    font-size: 0.92rem;
  }

  .people .who2 span {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
  }

  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tile {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tvc-green-tint);
  }

  .tile .k {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tvc-ink-soft);
  }

  .glyph {
    display: inline-flex;
  }

  .glyph svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--tvc-green-dark);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tile .v {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--tvc-green-dark);
  }

  .tile .s {
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
  }

  .prompt {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--tvc-orange-tint);
    color: var(--tvc-orange-text);
    font-size: 0.82rem;
  }

  .soon-list {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .gate {
    max-width: 420px;
    margin: 12vh auto 0;
    padding: 28px;
    background: var(--tvc-white);
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    text-align: center;
  }

  .gate .mark {
    width: 56px;
    height: 56px;
    margin: 0 auto 12px;
  }

  .gate h1 {
    margin: 0 0 8px;
    font-size: 1.5rem;
  }

  .gate p {
    margin: 0 0 18px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .gate #g_id_signin {
    display: flex;
    justify-content: center;
  }

  .gate .gate-error {
    margin: 16px 0 0;
    color: var(--tvc-error-text);
  }

  dialog.modal label.check {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-msg {
    min-height: 1.2em;
    margin: 0 0 4px;
    color: var(--tvc-error-text);
    font-size: 0.85rem;
  }

  dialog.modal {
    width: min(420px, calc(100vw - 24px));
    padding: 20px;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    background: var(--tvc-white);
    color: var(--tvc-ink);
  }

  dialog.modal.notice {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
  }

  dialog.modal.notice h4 {
    margin: 14px 0 2px;
    font-size: 0.9rem;
  }

  dialog.modal.notice h4 + p {
    margin-bottom: 0;
  }

  dialog.modal::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  dialog.modal h3 {
    margin: 0 0 6px;
  }

  dialog.modal p {
    margin: 0 0 12px;
    font-size: 0.88rem;
    color: var(--tvc-ink-soft);
  }

  dialog.modal label {
    display: grid;
    gap: 4px;
    margin-bottom: 10px;
    font-size: 0.85rem;
  }

  dialog.modal input,
  dialog.modal select {
    padding: 8px 10px;
    border: 1px solid var(--tvc-line-strong);
    border-radius: var(--radius-field);
    font: inherit;
  }

  .qr {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin: 6px 0 12px;
  }

  .qr code {
    font-size: 0.78rem;
    word-break: break-all;
    color: var(--tvc-ink);
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 20;
    transform: translateX(-50%);
    margin: 0;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--tvc-ink);
    color: var(--tvc-white);
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .shell,
    .shell.collapsed {
      grid-template-columns: 1fr;
    }

    .side {
      position: fixed;
      z-index: 10;
      left: 0;
      top: 0;
      width: 260px;
      transform: translateX(-105%);
      transition: transform 0.2s;
    }

    .shell.open .side {
      transform: none;
      box-shadow: var(--shadow-soft);
    }

    .collapse {
      display: none;
    }

    .menu-btn {
      display: block;
    }

    .search kbd,
    .who-text {
      display: none;
    }

    .topbar {
      padding: 10px 14px;
      gap: 10px;
    }

    #view {
      padding: 16px 14px 40px;
    }

    .widgets,
    .split,
    .unit-cols {
      grid-template-columns: 1fr;
    }

    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { clearMemberToken, getMemberToken, memberFetch, MemberAuthError, setMemberToken } from '../../../scripts/lib/member-client.mjs';
  import { NOTICE_INTRO, NOTICE_TITLE, PRIVACY_NOTICE_VERSION, SECTIONS } from '../../../scripts/lib/member-privacy.mjs';

  declare const google: any;
  const CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  type Person = { id: string; name: string; role: string; canLogin: boolean; hasEmail: boolean; hasPhone: boolean };
  type Plot = { pattaNo: string | null; surveyNo: string | null; areaAcres: number | null; areaHectares: number | null; referenceNo: string | null; verification: string; sourceDocumentId: string | null };
  type House = { pattaNo: string | null; surveyNo: string | null; areaSqFt: number | null; verification: string; sourceDocumentId: string | null };
  type LandDoc = { id: string; householdId: string; landType: string; fileName: string | null; uploadedAt: string; status: string; summary: string };
  type Hh = { id: string; farmUnit: string; houseNo: string | null; cluster: string | null; unitType: string | null; people: Person[]; plots: Plot[]; housePattas: House[]; farmAcres: number; farmHectares: number; houseSqFt: number; flags: { severity: string; text: string }[] };
  type Me = { personId: string; name: string; email: string | null; phone: string | null; directoryVisible: boolean };

  type Kid = Node | string | null | undefined | false;
  function h(tag: string, cls = '', text?: string, ...kids: Kid[]): HTMLElement {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text !== undefined) el.textContent = text;
    for (const k of kids) if (k) el.append(k);
    return el;
  }
  const SVG_NS = 'http://www.w3.org/2000/svg';
  function icon(paths: string): SVGElement {
    const s = document.createElementNS(SVG_NS, 'svg');
    s.setAttribute('viewBox', '0 0 24 24');
    s.setAttribute('aria-hidden', 'true');
    s.innerHTML = paths; // fixed constants only, never server data
    return s;
  }
  const first = (full: string) => full.trim().split(/\s+/).find((w) => w.length > 1) ?? full;
  const acresFmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  // Hectares are always shown to four decimal places (0.1619, 0.0040).
  const haFmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
  const ha = (v: number | null) => (v == null ? null : haFmt.format(v));
  const sqftFmt = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 });
  const VERIFICATION: Record<string, string> = { verified: 'Verified', pending_review: 'Awaiting core team', unverified: 'Not yet verified' };
  // Tick in a circle / clock / empty circle; the words stay for screen readers and the hover title.
  const VMARK: Record<string, string> = {
    verified: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/>',
    pending_review: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
    unverified: '<circle cx="12" cy="12" r="9" stroke-dasharray="3 3"/>',
  };
  function verifiedMark(v: string): HTMLElement {
    const key = VERIFICATION[v] ? v : 'unverified';
    const el = h('span', `vmark vmark--${key}`, undefined, icon(VMARK[key]), h('span', 'vtext', VERIFICATION[key]));
    el.title = VERIFICATION[key];
    return el;
  }
  // Opens a file this household uploaded: a signed link that lasts a minute. The tab is opened
  // first, in the click, so the browser doesn't treat it as a pop-up.
  async function openLandDoc(documentId: string) {
    const tab = window.open('', '_blank');
    try {
      const { status, data } = await memberFetch('/api/members-me/land-document-link', { method: 'POST', body: { documentId } });
      if (status !== 200 || !data.url) throw new Error(data.error || 'Could not open the file.');
      if (tab) {
        tab.opener = null;
        tab.location.href = data.url;
      } else window.location.href = data.url;
    } catch (err) {
      tab?.close();
      toast(err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Could not open the file.');
    }
  }
  // Rows are sorted by patta number, so records sharing a patta sit together: show the patta
  // number once, spanning its survey numbers, instead of repeating it on every row.
  function mergePattaRuns(root: HTMLElement): HTMLElement {
    const rows = [...root.querySelectorAll('tbody tr')];
    const key = (tr: Element) => {
      const t = tr.firstElementChild?.textContent?.trim() ?? '';
      return t === '—' || t === 'Not available yet' ? '' : t;
    };
    for (let i = 0; i < rows.length; ) {
      let j = i + 1;
      while (key(rows[i]) && j < rows.length && key(rows[j]) === key(rows[i])) j++;
      if (j - i > 1) {
        const first = rows[i].firstElementChild as HTMLTableCellElement;
        first.rowSpan = j - i;
        first.classList.add('merged-cell');
        for (let k = i + 1; k < j; k++) rows[k].firstElementChild?.remove();
      }
      i = j;
    }
    return root;
  }
  const byPatta = <T extends { pattaNo: string | null; surveyNo: string | null }>(a: T, b: T) =>
    (a.pattaNo == null ? 1 : 0) - (b.pattaNo == null ? 1 : 0) || String(a.pattaNo).localeCompare(String(b.pattaNo), undefined, { numeric: true }) || String(a.surveyNo).localeCompare(String(b.surveyNo), undefined, { numeric: true });

  // The outline of a parcel, from the field sketch of a single-survey document. All of the
  // household's outlines come in one request, once per page load (and again after an upload).
  let shapesLoad: Promise<Record<string, string>> | null = null;
  const loadShapes = () =>
    (shapesLoad ??= memberFetch('/api/members-me/land-shapes').then(({ status, data }) => (status === 200 ? (data.shapes as Record<string, string>) : {})).catch((): Record<string, string> => ({})));
  // The survey number as a link to its document, with the parcel's outline under it when there is one.
  function surveyCell(surveyNo: string | null, documentId: string | null): HTMLElement | string | null {
    const link = docLink(surveyNo ?? '', documentId);
    if (!documentId || !surveyNo) return link || null;
    const cell = h('div', 'survey-cell', undefined, link);
    void loadShapes().then((shapes) => {
      const src = shapes[documentId];
      if (!src) return;
      const img = document.createElement('img');
      img.className = 'parcel-shape';
      img.src = src;
      img.alt = `Outline of survey number ${surveyNo}`;
      cell.append(img);
    });
    return cell;
  }
  function docLink(text: string, documentId: string | null): HTMLElement | string {
    if (!documentId) return text;
    const b = h('button', 'doc-link', text);
    b.setAttribute('type', 'button');
    b.setAttribute('title', 'Open the uploaded document');
    b.addEventListener('click', () => void openLandDoc(documentId));
    return b;
  }
  const ROLE: Record<string, string> = { owner: 'Owner', family: 'Family', non_owner: 'Not an owner' };

  const IC = {
    dash: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
    unit: '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
    stay: '<path d="M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 18h18M7 9V6h10v3"/>',
    rupee: '<circle cx="12" cy="12" r="9"/><path d="M9 8h6M9 11h6M9 8c4 0 4 5 0 5l4 4"/>',
    receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/>',
    statement: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/>',
    bell: '<path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4z"/><path d="M10 21h4"/>',
    book: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/>',
    cal: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    help: '<path d="M4 5h16v11H9l-5 4z"/>',
    farm: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l8-8"/>',
    house: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-6h4v6"/>',
  };
  // A small picture standing in for a label; the name stays available to screen readers and on hover.
  const glyph = (paths: string, name: string) => {
    const g = h('span', 'glyph', undefined, icon(paths));
    g.setAttribute('role', 'img');
    g.setAttribute('aria-label', name);
    g.title = name;
    return g;
  };

  type NavItem = { id: string; label: string; icon: string; soon?: boolean };
  const NAV: (NavItem | { group: string })[] = [
    { id: 'dashboard', label: 'Dashboard', icon: IC.dash },
    { id: 'unit', label: 'My unit', icon: IC.unit },
    { id: 'stays', label: 'Stays', icon: IC.stay, soon: true },
    { group: 'Accounts' },
    { id: 'dues', label: 'My dues', icon: IC.rupee, soon: true },
    { id: 'receipts', label: 'Receipts', icon: IC.receipt, soon: true },
    { id: 'statements', label: 'Statements', icon: IC.statement, soon: true },
    { group: 'Community' },
    { id: 'notices', label: 'Notices', icon: IC.bell, soon: true },
    { id: 'documents', label: 'Documents', icon: IC.statement, soon: true },
    { id: 'meetings', label: 'Meetings & polls', icon: IC.cal, soon: true },
    { id: 'directory', label: 'Directory', icon: IC.book, soon: true },
    { group: 'Support' },
    { id: 'help', label: 'Help desk', icon: IC.help, soon: true },
  ];
  const PLANNED: Record<string, string[]> = {
    stays: ['Book overnight stays for yourself and your family (free)', 'Add guests at a discounted rate and pay by UPI', 'See, change and cancel your bookings; event dates take priority'],
    dues: ['Your annual maintenance for each financial year, what is paid and what is due', 'Pay by UPI QR, and tell us when you have paid'],
    receipts: ['Download a receipt for every payment you have made'],
    statements: ['Your account statement for each financial year'],
    notices: ['Announcements from the core team: meetings, maintenance reminders, farm and event updates'],
    documents: ['Meeting minutes, farm rules, forms and other member documents'],
    meetings: ['Upcoming meetings and agendas', 'Opinion polls on collective decisions'],
    directory: ['Find other members and their units. You can opt out of being listed.'],
    help: ['Raise a request with the core team and follow its status'],
  };

  let me: Me | null = null;
  let all: Hh[] = [];
  let current = 0;
  let route = 'dashboard';
  let toastTimer: number | undefined;

  function toast(msg: string) {
    const t = $('toast');
    t.textContent = msg;
    t.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.hidden = true), 2600);
  }

  const hhNow = (): Hh => all[Math.min(current, all.length - 1)];
  const meIn = (hh: Hh): Person => hh.people.find((p) => p.id === me?.personId) ?? hh.people[0];

  // ---- shell ----
  function renderNav(filter = '') {
    const q = filter.trim().toLowerCase();
    const nav = $('nav');
    nav.replaceChildren();
    let pendingGroup: HTMLElement | null = null;
    for (const item of NAV) {
      if ('group' in item) {
        pendingGroup = h('div', 'nav-group', item.group);
        continue;
      }
      if (q && !item.label.toLowerCase().includes(q)) continue;
      if (pendingGroup) {
        nav.append(pendingGroup);
        pendingGroup = null;
      }
      const a = h('a', 'nav-item', undefined, icon(item.icon), h('span', 'nav-label', item.label), item.soon ? h('span', 'nav-soon', 'Soon') : null);
      a.setAttribute('href', `#/${item.id}`);
      if (item.id === route) a.setAttribute('aria-current', 'page');
      a.title = item.label;
      nav.append(a);
    }
  }

  function renderWho() {
    const hh = hhNow();
    const person = meIn(hh);
    $('unit-chip').textContent = `${hh.farmUnit}${hh.houseNo ? ` · ${hh.houseNo}` : ''}`;
    $('avatar').textContent = first(me!.name).slice(0, 1).toUpperCase();
    $('who-name').textContent = me!.name;
    $('who-role').textContent = ROLE[person.role] ?? person.role;
    const menu = $('who-menu');
    menu.replaceChildren();
    if (all.length > 1) {
      menu.append(h('p', '', 'Switch unit'));
      all.forEach((o, i) => {
        const b = h('button', '', o.farmUnit, h('span', '', o.houseNo ?? 'No house'));
        b.setAttribute('aria-pressed', String(i === current));
        b.addEventListener('click', () => {
          current = i;
          menu.hidden = true;
          $('who').setAttribute('aria-expanded', 'false');
          renderWho();
          renderView();
        });
        menu.append(b);
      });
    }
    const notice = h('button', '', 'Privacy notice');
    notice.addEventListener('click', () => {
      menu.hidden = true;
      $('who').setAttribute('aria-expanded', 'false');
      noticeDialog(false);
    });
    const out = h('button', '', 'Sign out');
    out.addEventListener('click', signOut);
    menu.append(notice, out);
  }

  // ---- building blocks ----
  const widget = (title: string, opts: { soon?: boolean; wide?: boolean; more?: [string, string] } = {}, ...kids: Kid[]) => {
    const head = h('h2', '', title, opts.soon ? h('span', 'sample', 'Coming soon') : null);
    if (opts.more) {
      const m = h('button', 'more', opts.more[0]);
      m.addEventListener('click', () => (location.hash = `#/${opts.more![1]}`));
      head.append(m);
    }
    return h('section', `widget${opts.wide ? ' widget--wide' : ''}`, undefined, head, ...kids);
  };
  const kpi = (k: string, v: string) => h('div', 'kpi', undefined, h('div', 'k', k), h('div', 'v', v));
  const crumbs = (...parts: string[]) => h('p', 'crumbs', parts.join(' >> '));
  const tableOf = (headers: string[], rows: (string | number | null | HTMLElement)[][], rightFrom = -1): HTMLElement =>
    h('div', 'table-wrap', undefined, h('table', '', undefined,
      h('thead', '', undefined, h('tr', '', undefined, ...headers.map((t, i) => h('th', rightFrom >= 0 && i >= rightFrom ? 'r' : '', t)))),
      h('tbody', '', undefined, ...rows.map((r) => h('tr', '', undefined, ...r.map((c, i) => (c instanceof HTMLElement ? h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', undefined, c) : h('td', rightFrom >= 0 && i >= rightFrom ? 'r' : '', c == null || c === '' ? '—' : String(c))))))),
    ));
  const peopleList = (hh: Hh, you: Person) =>
    h('ul', 'people', undefined, ...hh.people.map((p) =>
      h('li', '', undefined, h('span', 'avatar', first(p.name).slice(0, 1).toUpperCase()),
        h('div', 'who2', undefined, h('strong', '', `${p.name}${p.id === you.id ? ' (you)' : ''}`), h('span', '', `${ROLE[p.role] ?? p.role} · ${p.hasEmail ? 'Email on file' : 'No email'} · ${p.hasPhone ? 'Mobile on file' : 'No mobile'}`)))));

  // ---- editing my own details ----
  function detailsDialog() {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const phone = document.createElement('input');
    phone.type = 'tel';
    phone.autocomplete = 'off';
    phone.value = me!.phone ?? '';
    phone.placeholder = 'e.g. 98450 12345';
    const dir = document.createElement('input');
    dir.type = 'checkbox';
    dir.checked = me!.directoryVisible;
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const save = h('button', 'btn btn--solid', 'Save') as HTMLButtonElement;
    save.addEventListener('click', async () => {
      const body: Record<string, unknown> = {};
      if (phone.value.trim() !== (me!.phone ?? '')) body.phone = phone.value.trim() === '' ? null : phone.value;
      if (dir.checked !== me!.directoryVisible) body.directoryVisible = dir.checked;
      if (Object.keys(body).length === 0) {
        msg.textContent = 'Nothing to change.';
        return;
      }
      save.disabled = true;
      msg.textContent = '';
      try {
        const { status, data } = await memberFetch('/api/members-me/profile', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        await load(true);
        toast('Your details are saved');
      } catch (err) {
        save.disabled = false;
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', 'Your details'),
      h('p', '', `Signed in as ${me!.email ?? 'your Google account'}. To change your name, email or household, ask the core team.`),
      h('label', '', 'Mobile number', phone),
      h('label', 'check', undefined, dir, h('span', '', 'List me in the member directory')),
      msg,
      h('div', 'modal-actions', undefined, cancel, save),
    );
    dlg.addEventListener('close', () => dlg.remove());
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- land documents ----
  // Members upload the patta / survey extract they downloaded from eservices.tn.gov.in. The
  // server reads it in the background (members-land-extract-background.mts): a record the
  // register already holds is marked verified, a new one is added for the core team to confirm.
  const DOC_STATUS: Record<string, string> = { processing: 'Reading…', applied: 'Done', needs_review: 'With the core team', failed: 'Not used' };
  const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  const LAND_LABEL: Record<string, string> = { farm: 'Farm land', house: 'House plot' };

  // The household's uploaded documents, shared by the Farm and House cards and the popup that
  // lists them. Re-read every few seconds while one is still being read.
  let docsState: { householdId: string; docs: LandDoc[]; loaded: boolean } = { householdId: '', docs: [], loaded: false };
  const docsListeners = new Set<() => void>();
  let pollTimer: number | undefined;
  async function refreshDocs(hh: Hh) {
    window.clearTimeout(pollTimer);
    try {
      const { status, data } = await memberFetch('/api/members-me/land-documents');
      if (status !== 200) throw new Error();
      docsState = { householdId: hh.id, docs: (data.documents as LandDoc[]).filter((d) => d.householdId === hh.id), loaded: true };
    } catch {
      docsState = { householdId: hh.id, docs: [], loaded: false };
    }
    for (const fn of [...docsListeners]) fn();
    const processing = docsState.docs.some((d) => d.status === 'processing');
    if (processing && docsListeners.size > 0) pollTimer = window.setTimeout(() => void refreshDocs(hh), 4000);
    else if (docsState.docs.length && !processing) loadQuietly();
  }
  const docsOfType = (landType: string) => docsState.docs.filter((d) => d.landType === landType);

  function docRow(d: LandDoc): HTMLElement {
    return h('p', 'doc-row', undefined,
      h('strong', '', undefined, docLink(dateFmt.format(new Date(d.uploadedAt)) + (d.fileName ? ` · ${d.fileName}` : ''), d.status === 'failed' ? null : d.id)),
      h('span', 'pill', DOC_STATUS[d.status] ?? d.status),
      h('span', 'doc-sum', d.summary));
  }

  // Under a Farm or House card's table: upload for that kind of land (no choice to make), and a
  // link to what has been uploaded for it. The list itself is in a popup, not on the page.
  function landCardFooter(hh: Hh, landType: 'farm' | 'house'): HTMLElement {
    const upload = h('button', 'btn btn--solid', 'Upload a document');
    upload.setAttribute('type', 'button');
    upload.addEventListener('click', () => uploadDialog(hh, landType, () => { shapesLoad = null; void refreshDocs(hh); }));
    const history = h('button', 'link-btn', 'Uploaded documents');
    history.setAttribute('type', 'button');
    history.addEventListener('click', () => docsDialog(hh, landType));
    const footer = h('div', 'card-docs', undefined, upload, history);
    const update = () => {
      if (!footer.isConnected) {
        docsListeners.delete(update);
        return;
      }
      const n = docsOfType(landType).length;
      history.textContent = n ? `Uploaded documents (${n})` : 'Uploaded documents';
    };
    docsListeners.add(update);
    if (docsState.householdId === hh.id && docsState.loaded) update();
    else void refreshDocs(hh);
    return footer;
  }

  function docsDialog(hh: Hh, landType: 'farm' | 'house') {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal docs-modal';
    const list = h('div', 'docs-list');
    const render = () => {
      const docs = docsOfType(landType);
      list.replaceChildren(...(docs.length ? docs.slice(0, 20).map(docRow) : [h('p', 'lede', docsState.loaded ? 'Nothing uploaded yet.' : 'Loading…')]));
    };
    docsListeners.add(render);
    const close = h('button', 'btn', 'Close');
    close.addEventListener('click', () => dlg.close());
    dlg.append(
      h('h3', '', `${LAND_LABEL[landType]} documents`),
      h('p', '', 'Click a date to open the file you uploaded.'),
      list,
      h('div', 'modal-actions', undefined, close),
    );
    dlg.addEventListener('close', () => {
      docsListeners.delete(render);
      dlg.remove();
    });
    render();
    document.body.append(dlg);
    dlg.showModal();
    void refreshDocs(hh);
  }

  // Re-reads the household once documents finish, so verified badges appear without a reload.
  let lastRefreshKey = '';
  function loadQuietly() {
    const key = String(Date.now() / 60000 | 0);
    if (key === lastRefreshKey) return;
    lastRefreshKey = key;
    window.setTimeout(async () => {
      try {
        const { status, data } = await memberFetch('/api/members-me/home');
        if (status === 200 && data.households) {
          const before = JSON.stringify(all);
          all = data.households;
          if (JSON.stringify(all) !== before) onRoute();
        }
      } catch {
        // the next navigation reloads anyway
      }
    }, 0);
  }

  function uploadDialog(hh: Hh, landType: 'farm' | 'house', done: () => void) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal';
    const file = document.createElement('input');
    file.type = 'file';
    file.accept = 'application/pdf,image/jpeg,image/png';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const cancel = h('button', 'btn', 'Cancel');
    cancel.addEventListener('click', () => dlg.close());
    const send = h('button', 'btn btn--solid', 'Upload') as HTMLButtonElement;
    send.addEventListener('click', async () => {
      const chosen = file.files?.[0];
      if (!chosen) {
        msg.textContent = 'Choose a file first.';
        return;
      }
      if (chosen.size > (chosen.type === 'application/pdf' ? 1_000_000 : 3_000_000)) {
        msg.textContent = chosen.type === 'application/pdf' ? 'A patta PDF is under 1 MB; that file is too large to be one.' : 'That photo is larger than 3 MB.';
        return;
      }
      send.disabled = true;
      msg.textContent = '';
      try {
        const body = new FormData();
        body.append('file', chosen);
        body.append('landType', landType);
        body.append('householdId', hh.id);
        const { status, data } = await memberFetch('/api/members-me/land-documents', { method: 'POST', body });
        if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
        dlg.close();
        done();
        toast(data.replaced ? 'Uploaded. It replaces your earlier upload, and we are reading it now' : 'Uploaded. We are reading it now');
      } catch (err) {
        send.disabled = false;
        msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
      }
    });
    dlg.append(
      h('h3', '', `Upload a ${landType === 'house' ? 'house plot' : 'farm land'} document`),
      h('p', '', 'Use the PDF downloaded from eservices.tn.gov.in; it can be read automatically. A photo or scan is checked by the core team instead. Limits: PDF 1 MB, photo 3 MB.'),
      h('label', '', 'File', file),
      msg,
      h('div', 'modal-actions', undefined, cancel, send),
    );
    dlg.addEventListener('close', () => dlg.remove());
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- the privacy notice ----
  // Shown before anything else on a member's first sign-in (and again if the notice
  // changes): the server releases no household data until it is acknowledged.
  // `required` = that blocking first-time case; otherwise it is a plain read-only view.
  function noticeDialog(required: boolean) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal notice';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const actions = h('div', 'modal-actions');
    if (required) {
      dlg.addEventListener('cancel', (e) => e.preventDefault()); // Esc must not skip it
      const out = h('button', 'btn', 'Sign out');
      out.addEventListener('click', () => {
        dlg.remove();
        signOut();
      });
      const ok = h('button', 'btn btn--solid', 'I have read this') as HTMLButtonElement;
      ok.addEventListener('click', async () => {
        ok.disabled = true;
        msg.textContent = '';
        try {
          const { status, data } = await memberFetch('/api/members-me/privacy', { method: 'POST', body: { version: PRIVACY_NOTICE_VERSION } });
          if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
          dlg.remove();
          await load();
        } catch (err) {
          ok.disabled = false;
          msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
        }
      });
      actions.append(out, ok);
      queueMicrotask(() => ok.focus()); // not "Sign out", which showModal() would focus first
    } else {
      const close = h('button', 'btn btn--solid', 'Close');
      close.addEventListener('click', () => dlg.close());
      actions.append(close);
      dlg.addEventListener('close', () => dlg.remove());
    }
    dlg.append(
      h('h3', '', NOTICE_TITLE),
      h('p', '', NOTICE_INTRO),
      ...SECTIONS.flatMap((s: { heading: string; body: string }) => [h('h4', '', s.heading), h('p', '', s.body)]),
      msg,
      actions,
    );
    document.body.append(dlg);
    dlg.showModal();
  }

  // ---- views ----
  function viewDashboard(): HTMLElement {
    const hh = hhNow();
    const person = meIn(hh);
    const root = h('div');
    root.append(h('h1', 'page-title', `Hello, ${first(me!.name)}`), h('p', 'lede', 'Everything about your membership in one place.'));
    const grid = h('div', 'widgets');

    const prompts = h('div');
    if (!me!.phone) prompts.append(h('p', 'prompt', 'Add your mobile number so we can reach you about stays and farm updates.'));
    const checks = hh.flags.filter((f) => f.severity !== 'info').length;
    if (checks) prompts.append(h('p', 'prompt', `${checks} detail${checks === 1 ? '' : 's'} in your unit's records look incomplete. The core team is working through them.`));

    grid.append(
      widget('My unit', { more: ['View unit', 'unit'] },
        h('div', 'tiles', undefined,
          h('div', 'tile', undefined, h('div', 'k', undefined, glyph(IC.farm, 'Farm land')), h('div', 'v', hh.plots.length ? `${acresFmt.format(hh.farmAcres)} ac` : '—'), h('div', 's', hh.plots.length ? `${hh.plots.length} plot${hh.plots.length === 1 ? '' : 's'}` : 'Not available yet')),
          h('div', 'tile', undefined, h('div', 'k', undefined, glyph(IC.house, 'House'), hh.houseNo && hh.cluster ? h('span', 'pill', `Cluster ${hh.cluster}`) : null), h('div', 'v', hh.houseSqFt > 0 ? `${sqftFmt.format(hh.houseSqFt)} sq ft` : '—'), h('div', 's', !hh.houseNo ? 'No house allocated yet' : hh.housePattas.length ? `${hh.housePattas.length} plot${hh.housePattas.length === 1 ? '' : 's'}` : 'Area not on record')),
        ),
        prompts,
      ),
      widget('My household', { more: ['Details', 'unit'] }, peopleList(hh, person)),
      widget('Stays', { soon: true }, h('p', 'lede', 'Book overnight stays for you and your family. Free for family; guests at a discounted rate.')),
      widget('Maintenance', { soon: true }, h('p', 'lede', 'Your annual maintenance, what is paid and what is due, with a UPI QR to pay.')),
      widget('Notices', { soon: true }, h('p', 'lede', 'Announcements from the core team.')),
      widget('Help desk', { soon: true }, h('p', 'lede', 'Raise a request with the core team and follow its status.')),
    );
    root.append(grid);
    return root;
  }

  function viewUnit(): HTMLElement {
    const hh = hhNow();
    const person = meIn(hh);
    const root = h('div');
    root.append(crumbs('Home', 'My unit'), h('h1', 'page-title', 'My unit'));
    root.append(h('p', 'lede', [hh.unitType ? `Unit type ${hh.unitType}` : null, `You are listed as ${ROLE[person.role] ?? person.role}`].filter(Boolean).join(' · ')));
    const panel = (title: string, ...kids: Kid[]) => {
      const p = h('section', 'panel', undefined, h('h2', '', title), ...kids);
      p.style.marginTop = '16px';
      return p;
    };
    const cols = h('div', 'unit-cols');
    cols.append(
      h('section', 'panel', undefined, h('h2', '', undefined, h('span', 'glyph', undefined, icon(IC.farm)), 'Farm'),
        h('div', 'kpis', undefined, kpi('Farm land', hh.plots.length ? `${acresFmt.format(hh.farmAcres)} ac` : '—'), kpi('Farm plots', String(hh.plots.length))),
        hh.plots.length ? mergePattaRuns(tableOf(['Patta no.', 'Survey no.', 'Hectares', 'Acres', 'Status'], [...hh.plots].sort(byPatta).map((p) => [p.pattaNo, surveyCell(p.surveyNo, p.sourceDocumentId), ha(p.areaHectares), p.areaAcres, verifiedMark(p.verification)]), 2)) : h('p', 'lede', 'Patta details not available yet'),
        landCardFooter(hh, 'farm')),
      h('section', 'panel', undefined, h('h2', '', undefined, h('span', 'glyph', undefined, icon(IC.house)), 'House', hh.houseNo && hh.cluster ? h('span', 'pill', `Cluster ${hh.cluster}`) : null),
        h('div', 'kpis', undefined, kpi('House area', hh.houseSqFt > 0 ? `${sqftFmt.format(hh.houseSqFt)} sq ft` : '—'), kpi('House plots', String(hh.housePattas.length))),
        hh.housePattas.length ? mergePattaRuns(tableOf(['Patta no.', 'Survey no.', 'Sq ft', 'Status'], [...hh.housePattas].sort(byPatta).map((p) => [p.pattaNo, surveyCell(p.surveyNo, p.sourceDocumentId), p.areaSqFt, verifiedMark(p.verification)]), 2)) : h('p', 'lede', hh.houseNo ? 'Patta details not available yet' : 'No house allocated yet'),
        hh.houseNo ? landCardFooter(hh, 'house') : null),
    );
    root.append(cols);
    root.append(panel('People in this unit', tableOf(['Name', 'Role', 'Email', 'Mobile'], hh.people.map((p) => [`${p.name}${p.id === person.id ? ' (you)' : ''}`, ROLE[p.role] ?? p.role, p.hasEmail ? 'On file' : 'Missing', p.hasPhone ? 'On file' : 'Missing']))));

    const edit = h('button', 'btn btn--solid', 'Update my details');
    edit.addEventListener('click', detailsDialog);
    root.append(panel('My details',
      h('p', 'lede', `Email: ${me!.email ?? 'not on file'}`),
      h('p', 'lede', `Mobile: ${me!.phone ?? 'not on file'}`),
      h('p', 'lede', `Member directory: ${me!.directoryVisible ? 'you are listed' : 'you are not listed'}`),
      edit,
    ));
    return root;
  }

  function viewSoon(id: string): HTMLElement {
    const item = NAV.find((n): n is NavItem => 'id' in n && n.id === id)!;
    return h('div', '', undefined,
      crumbs('Home', item.label),
      h('h1', 'page-title', item.label, h('small', '', 'Coming soon')),
      h('section', 'panel', undefined, h('h2', '', 'Planned'), h('ul', 'soon-list', undefined, ...(PLANNED[id] ?? []).map((t) => h('li', '', t)))),
    );
  }

  function renderView() {
    const fn = route === 'dashboard' ? viewDashboard : route === 'unit' ? viewUnit : () => viewSoon(route);
    $('view').replaceChildren(fn());
    renderNav($<HTMLInputElement>('search').value);
    const label = (NAV.find((n) => 'id' in n && n.id === route) as NavItem | undefined)?.label ?? 'Dashboard';
    document.title = `${label} · Member portal · Tamarind Valley Collective`;
    $('shell').classList.remove('open');
  }

  function onRoute() {
    const id = location.hash.replace(/^#\//, '') || 'dashboard';
    route = NAV.some((n) => 'id' in n && n.id === id) ? id : 'dashboard';
    if (me) renderView();
  }

  // ---- sign-in and loading ----
  function showGate(message?: string) {
    me = null;
    $('shell').hidden = true;
    $('gate').hidden = false;
    const err = $('gate-error');
    err.hidden = !message;
    if (message) err.textContent = message;
    renderSignInButton();
  }

  async function load(quiet = false) {
    try {
      const { status, data } = await memberFetch('/api/members-me/home');
      if (status === 403) return showGate(data.error || 'This account has not been invited to the member portal yet.');
      if (status !== 200) return showGate('Something went wrong. Please try again in a moment.');
      if (data.privacyNoticeRequired) {
        // First sign-in (or a changed notice): read it before anything else is shown.
        me = null;
        $('gate').hidden = true;
        $('shell').hidden = true;
        noticeDialog(true);
        return;
      }
      me = data.me;
      all = data.households;
      current = Math.min(current, all.length - 1);
      $('gate').hidden = true;
      $('shell').hidden = false;
      renderWho();
      onRoute();
    } catch (err) {
      if (err instanceof MemberAuthError) return showGate(quiet ? 'Your session ended. Sign in again.' : undefined);
      showGate('Something went wrong. Please try again in a moment.');
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setMemberToken(response.credential);
    load();
  }

  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    google.accounts.id.renderButton($('g_id_signin'), { theme: 'outline', size: 'large' });
  }

  function signOut() {
    clearMemberToken();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    $('who-menu').hidden = true;
    showGate();
  }

  // ---- wiring ----
  $('collapse').addEventListener('click', () => $('shell').classList.toggle('collapsed'));
  $('menu').addEventListener('click', () => $('shell').classList.toggle('open'));
  $('search').addEventListener('input', () => renderNav($<HTMLInputElement>('search').value));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      $('search').focus();
    }
  });
  $('who').addEventListener('click', () => {
    const m = $('who-menu');
    m.hidden = !m.hidden;
    $('who').setAttribute('aria-expanded', String(!m.hidden));
  });
  window.addEventListener('hashchange', onRoute);

  renderNav();
  if (getMemberToken()) load();
  else showGate();
</script>
