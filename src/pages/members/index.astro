  // ---- the privacy notice ----
  // Shown before anything else on a member's first sign-in (and again if the notice
  // changes): the server releases no household data until it is acknowledged.
  // `required` = that blocking first-time case; otherwise it is a plain read-only view.
  function noticeDialog(required: boolean) {
    const dlg = document.createElement('dialog');
    dlg.className = 'modal notice';
    const msg = h('p', 'form-msg');
    msg.setAttribute('role', 'alert');
    const actions = h('div', 'modal-actions');
    if (required) {
      dlg.addEventListener('cancel', (e) => e.preventDefault()); // Esc must not skip it
      const out = h('button', 'btn', 'Sign out');
      out.addEventListener('click', () => {
        dlg.remove();
        signOut();
      });
      const ok = h('button', 'btn btn--solid', 'I have read this') as HTMLButtonElement;
      ok.addEventListener('click', async () => {
        const done = setBusy(ok, 'Saving…');
        msg.textContent = '';
        try {
          const { status, data } = await memberFetch('/api/members-me/privacy', { method: 'POST', body: { version: PRIVACY_NOTICE_VERSION } });
          if (status !== 200) throw new Error(data.error || 'Something went wrong. Try again.');
          dlg.remove();
          await load();
        } catch (err) {
          done();
          msg.textContent = err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : err instanceof Error ? err.message : 'Something went wrong.';
        }
      });
      actions.append(out, ok);
      queueMicrotask(() => ok.focus()); // not "Sign out", which showModal() would focus first
    } else {
      const close = h('button', 'btn btn--solid', 'Close');
      close.addEventListener('click', () => dlg.close());
      actions.append(close);
      dlg.addEventListener('close', () => dlg.remove());
    }
    dlg.append(
      h('h3', '', NOTICE_TITLE),
      h('p', '', NOTICE_INTRO),
      ...SECTIONS.flatMap((s: { heading: string; body: string }) => [h('h4', '', s.heading), h('p', '', s.body)]),
      msg,
      actions,
    );
    presentSheet(dlg, { locked: required });
  }

  // ---- the feature tour ----
  // The steps live in scripts/lib/member-tour.mjs. A brand new member gets all of them on first sign-in; one who
  // has been here before gets only the steps added since, as a "What's new" card on Home. Closing or skipping it
  // counts as seen (it can be replayed from the account menu, which records nothing).
  type TourStep = { id: string; route: string; target: string; tag: string; title: string; text: string };
  let tourAutoStarted = false;
  let whatsNewDismissed = false;
  const tourPending = (): TourStep[] => (me ? tourStepsFor({ role: me.role, seenThrough: me.tourSeenThrough }) : []);

  async function markTourSeen() {
    if (!me) return;
    me.tourSeenThrough = TOUR_LATEST; // the card goes at once; if the save fails it simply comes back next visit
    try {
      await memberFetch('/api/members-me/tour-seen', { method: 'POST', body: { through: TOUR_LATEST } });
    } catch {
      /* not worth interrupting anyone for */
    }
  }

  function whatsNewCard(steps: TourStep[]): HTMLElement {
    const dismiss = () => {
      whatsNewDismissed = true;
      markTourSeen();
      renderView();
    };
    const close = h('button', 'whatsnew-close', '×');
    close.setAttribute('type', 'button');
    close.setAttribute('aria-label', 'Dismiss what\'s new');
    close.addEventListener('click', dismiss);
    const show = h('button', 'btn btn--solid', `Show me${steps.length > 1 ? ` (${steps.length} steps)` : ''}`);
    show.setAttribute('type', 'button');
    show.addEventListener('click', () => startTour(steps, true));
    const got = h('button', 'btn', 'Got it');
    got.setAttribute('type', 'button');
    got.addEventListener('click', dismiss);
    const card = h('section', 'whatsnew', undefined,
      h('div', 'whatsnew-head', undefined,
        h('div', '', undefined, h('p', 'whatsnew-eyebrow', steps.length > 1 ? `What's new · ${steps.length} things` : 'What\'s new'), h('h2', '', 'Since you last visited')),
        close),
      h('ul', 'whatsnew-list', undefined, ...steps.map((s) => h('li', '', undefined, h('span', 'whatsnew-tag', s.tag), h('span', '', undefined, h('strong', '', s.title), ' ', s.text)))),
      h('div', 'whatsnew-actions', undefined, show, got));
    card.setAttribute('aria-label', 'What\'s new in the member portal');
    return card;
  }

  // Dims the page, rings the element a step is about and puts a card beside it. A step whose element isn't on the page
  // (a closed menu on a phone, a card that isn't there) is a plain centred card instead.
  function startTour(steps: TourStep[], record: boolean) {
    if (!steps.length) return;
    document.querySelector('.tour')?.remove();
    const returnTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const layer = h('div', 'tour');
    const spot = h('div', 'tour-spot');
    spot.hidden = true;
    const card = h('div', 'tour-card');
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-modal', 'true');
    card.setAttribute('aria-labelledby', 'tour-title');
    layer.append(h('div', 'tour-block'), spot, card);
    document.body.append(layer);

    const phone = window.matchMedia('(max-width: 560px)');
    const onScreen = (el: Element) => {
      const r = el.getBoundingClientRect();
      return r.width > 0 && r.height > 0 && r.right > 0 && r.left < window.innerWidth;
    };
    let target: HTMLElement | null = null;
    let run = 0;

    function place() {
      layer.classList.toggle('tour--spot', !!target);
      spot.hidden = !target;
      card.classList.toggle('tour-card--centre', !target);
      card.style.cssText = '';
      delete card.dataset.side;
      if (!target) return;
      const r = target.getBoundingClientRect();
      const pad = 6;
      spot.style.cssText = `top:${r.top - pad}px;left:${r.left - pad}px;width:${r.width + pad * 2}px;height:${r.height + pad * 2}px`;
      if (phone.matches) return; // a sheet along the bottom, set in CSS
      const w = card.offsetWidth;
      const ht = card.offsetHeight;
      const room = 28; // the spotlight ring plus air, and the pointer sits in it
      const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
      let side = 'right';
      let left = r.right + room;
      let top = clamp(r.top, 12, window.innerHeight - ht - 12);
      if (left + w > window.innerWidth - 12) { left = r.left - room - w; side = 'left'; } // no room to the right: to the left
      if (left < 12) {
        left = clamp(r.left, 12, window.innerWidth - w - 12); // neither: below, else above
        const below = r.bottom + room + ht < window.innerHeight;
        top = below ? r.bottom + room : Math.max(12, r.top - room - ht);
        side = below ? 'below' : 'above';
      }
      card.style.left = `${left}px`;
      card.style.top = `${top}px`;
      // A pointer on the edge facing the target, aimed at the middle of it (kept off the card's rounded corners).
      card.dataset.side = side;
      const along = side === 'left' || side === 'right' ? r.top + r.height / 2 - top : r.left + Math.min(r.width / 2, 120) - left;
      card.style.setProperty('--pointer', `${clamp(along, 28, (side === 'left' || side === 'right' ? ht : w) - 28)}px`);
    }

    // A scroll fires many times a frame; place() reads layout, so do it once per frame.
    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; place(); });
    };

    function finish() {
      run++;
      layer.remove();
      document.removeEventListener('keydown', onKey, true);
      window.removeEventListener('resize', place);
      window.removeEventListener('scroll', onScroll, true);
      if (record) {
        markTourSeen();
        renderView();
      }
      if (returnTo?.isConnected) returnTo.focus();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        finish();
      } else if (e.key === 'Tab') {
        const stops = [...card.querySelectorAll<HTMLElement>('button')].filter((b) => !b.hidden);
        if (!stops.length) return;
        const i = stops.indexOf(document.activeElement as HTMLElement);
        const next = e.shiftKey ? (i <= 0 ? stops.length - 1 : i - 1) : i === stops.length - 1 ? 0 : i + 1;
        e.preventDefault();
        stops[next].focus();
      }
    }

    async function show(n: number) {
      const mine = ++run;
      const step = steps[n];
      const moved = !!step.route && route !== step.route;
      if (moved) location.hash = `#/${step.route}`;
      // The page draws a moment after the route changes (the directory fetches first); wait for the element, then give up.
      target = null;
      for (let tries = 0; tries < (moved ? 40 : 4); tries++) {
        await new Promise((r) => setTimeout(r, tries ? 50 : 30));
        if (mine !== run) return;
        const el = document.querySelector<HTMLElement>(`[data-tour="${step.target}"]`);
        if (el && onScreen(el)) {
          target = el;
          break;
        }
      }

      const last = n === steps.length - 1;
      const back = h('button', 'btn', 'Back');
      back.setAttribute('type', 'button');
      back.hidden = n === 0;
      back.addEventListener('click', () => show(n - 1));
      const skip = h('button', 'tour-skip', 'Skip tour');
      skip.setAttribute('type', 'button');
      skip.hidden = last;
      skip.addEventListener('click', finish);
      const next = h('button', 'btn btn--solid', last ? 'Done' : 'Next');
      next.setAttribute('type', 'button');
      next.addEventListener('click', () => (last ? finish() : show(n + 1)));
      const title = h('h2', '', step.title);
      title.id = 'tour-title';
      card.replaceChildren(
        h('p', 'tour-count', `Step ${n + 1} of ${steps.length}`),
        title,
        h('p', 'tour-text', step.text),
        h('div', 'tour-foot', undefined,
          h('div', 'tour-dots', undefined, ...steps.map((_, i) => h('span', i === n ? 'on' : ''))),
          h('div', 'tour-buttons', undefined, skip, back, next)));
      // Bring the target into the part of the screen the sticky top bar and (on a phone) the bottom card leave free.
      if (target) {
        const r = target.getBoundingClientRect();
        const top = (document.querySelector('.topbar')?.getBoundingClientRect().bottom ?? 0) + 16;
        const bottom = window.innerHeight - (phone.matches ? card.offsetHeight + 28 : 16);
        const fits = r.height <= bottom - top;
        const shift = fits ? (r.top < top ? r.top - top : r.bottom > bottom ? r.bottom - bottom : 0) : r.top - top;
        if (shift) window.scrollBy({ top: shift, behavior: 'instant' });
      }
      place();
      next.focus({ preventScroll: true });
    }

    document.addEventListener('keydown', onKey, true);
    window.addEventListener('resize', place);
    window.addEventListener('scroll', onScroll, true);
    show(0);
  }

  // ---- Rent out ----
  // Offer your unit to guests who book through Linger, then manage it. The menu item stays hidden until the server says
  // the feature is on and this person is an owner (probeRental). Plan: docs/plans/accommodation-member-units.md.
  type RentalData = {
    enabled: boolean;
    preview?: boolean;
    eligible: boolean;
    farmUnit?: string;
    houseNo?: string | null;
    state?: 'none' | 'interested' | 'rentable' | 'paused';
    types?: { id: string; label: string }[];
    offer?: { shape: string; typeId: string; delegateToTvc: boolean; createdAt: string } | null;
    unit?: { shape: string; typeId: string; manager: 'tvc' | 'member'; status: string; requestMode: string; ignoresFarmClosure: boolean } | null;
    stays?: { id: string; startDate: string; nights: number; label: string | null; guests: { name: string; ageGroup: string; gender?: string; preferences: string }[] }[];
    blocks?: { id: string; startDate: string; nights: number; mine: boolean; farm: boolean }[];
    payout?: { needed: boolean; maintenance: boolean; account: { payeeName: string; method: 'bank' | 'upi'; shown: string; panShown: string; status: 'submitted' | 'verified' } | null };
    contract?: { stage: 'sign' | 'review'; termsVersion: string; sharedAt: string; canUpload: boolean; hasSigned: boolean } | null;
  };

  // The contract copies are read by the server for the member and handed over as data; the member never gets a storage link.
  async function openContractCopy(which: 'contract' | 'signed', btn: HTMLButtonElement) {
    const finish = setBusy(btn, 'Opening…');
    try {
      const { status, data } = await memberFetch(`/api/members-me/rental/contract?which=${which}`);
      if (status !== 200) return toast(data.error || 'Could not open that.');
      const bytes = Uint8Array.from(atob(data.base64), (c) => c.charCodeAt(0));
      const url = URL.createObjectURL(new Blob([bytes], { type: data.mime }));
      window.open(url, '_blank', 'noopener');
      setTimeout(() => URL.revokeObjectURL(url), 60_000);
    } catch (err) {
      toast(err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : 'Could not reach the server.');
    } finally {
      finish();
    }
  }
  const fileAsBase64 = (file: File) =>
    new Promise<string>((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(String(r.result).split(',')[1] ?? '');
      r.onerror = () => reject(r.error);
      r.readAsDataURL(file);
    });
  let rental: RentalData | null = null;

  function setRentalVisible(on: boolean) {
    const item = NAV.find((n) => n.id === 'rental');
    if (!item || item.hidden === !on) return;
    item.hidden = !on;
    renderNav();
    if (on && location.hash === '#/rental') onRoute();
  }

  async function probeRental() {
    try {
      const { status, data } = await memberFetch('/api/members-me/rental');
      if (status === 200 && data.enabled && data.eligible) {
        rental = data;
        const item = NAV.find((n) => n.id === 'rental');
        if (item) item.preview = !!data.preview;
        setRentalVisible(true);
      } else setRentalVisible(false);
    } catch {
      // The page works without it.
    }
  }

  const RENTAL_MODES: [string, string, string][] = [
    ['reject', 'Auto-reject', 'Your unit is not offered to guests.'],
    ['ask', 'Ask me each time', 'You accept or decline. No answer in 24 hours counts as declined.'],
    ['auto', 'Auto-accept', 'Guests are accepted when the dates are free.'],
  ];
  const dateLabel = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const endLabel = (d: string, nights: number) => dateLabel(new Date(Date.parse(`${d}T00:00:00Z`) + nights * 86_400_000).toISOString().slice(0, 10));

  function viewRental(): HTMLElement {
    const root = h('div');
    root.append(h('h1', 'page-title', 'Rent out', ...(rental?.preview ? [previewPill()] : [])), h('p', 'lede', 'Let guests book your unit through Linger.'));
    const homeLine = h('p', 'rent-note');
    homeLine.hidden = true;
    const body = h('div', 'rent');
    root.append(homeLine, body);
    let editingSettings = false; // the Requests card shows its setting until Change is pressed

    const paint = () => {
      const d = rental;
      homeLine.hidden = !d?.houseNo;
      if (d?.houseNo) homeLine.textContent = `Home ${d.houseNo}`;
      if (!d?.eligible) return body.replaceChildren(h('p', 'lede', 'This page is for the owners of a unit.'));
      const sections: HTMLElement[] = [];
      const card = (title: string, ...kids: (HTMLElement | null)[]) => h('section', 'unit-card', undefined, h('div', 'unit-card-head', undefined, h('h2', '', title)), h('div', 'unit-card-body', undefined, ...kids));
      const say = (text: string) => h('p', 'rent-note', text);
      const act = async (path: string, payload: unknown, done: string, btn?: HTMLButtonElement, doing?: string): Promise<boolean> => {
        const finish = btn ? setBusy(btn, doing) : () => {};
        try {
          const { status, data } = await memberFetch(path, { method: 'POST', body: payload });
          if (status !== 200) {
            toast(data.error || 'Something went wrong. Try again.');
            return false;
          }
          toast(done);
          await refresh();
          return true;
        } catch (err) {
          toast(err instanceof MemberAuthError ? 'Your session ended. Sign in again.' : 'Could not reach the server.');
          return false;
        } finally {
          finish();
        }
      };

      // Where TVC pays the member. Entered once, encrypted on the server, and only ever shown back as "ending 4821".
      const payoutCard = (): HTMLElement | null => {
        const pay = d.payout;
        if (!pay) return null;
        if (pay.maintenance) return null; // nothing to enter: it is one line in Your rental instead of a card
        if (!pay.needed) return null;
        const a = pay.account;
        let editing = !a;
        const box = h('div');
        const paint2 = () => {
          if (!editing && a) {
            const change = h('button', 'btn', 'Change details') as HTMLButtonElement;
            change.type = 'button';
            change.addEventListener('click', () => {
              editing = true;
              paint2();
            });
            return box.replaceChildren(
              say(`${a.payeeName} · ${a.method === 'bank' ? 'bank account' : 'UPI'} ${a.shown} · PAN ${a.panShown}`),
              say(a.status === 'verified' ? 'Verified.' : 'Saved. TVC will make a small test transfer first.'),
              change,
            );
          }
          const inp = (label: string, type = 'text', ph = '') => {
            const i = h('input') as HTMLInputElement;
            i.type = type;
            i.placeholder = ph;
            i.autocomplete = 'off';
            i.setAttribute('aria-label', label);
            return i;
          };
          const name = inp('Name on the account');
          const method = h('select') as HTMLSelectElement;
          for (const [v, l] of [['bank', 'Bank account'], ['upi', 'UPI']]) method.append(Object.assign(document.createElement('option'), { value: v, textContent: l }));
          const account = inp('Account number', 'text', '');
          account.inputMode = 'numeric';
          const ifsc = inp('IFSC code', 'text', 'HDFC0001234');
          const upi = inp('UPI id', 'text', 'name@bank');
          const pan = inp('PAN', 'text', 'ABCDE1234F');
          pan.maxLength = 10;
          const bankRows = h('div', 'rent-more', undefined, h('label', 'rent-field', undefined, h('span', 'field-label', 'Account number'), account), h('label', 'rent-field', undefined, h('span', 'field-label', 'IFSC code'), ifsc));
          const upiRows = h('div', 'rent-more', undefined, h('label', 'rent-field', undefined, h('span', 'field-label', 'UPI id'), upi));
          upiRows.hidden = true;
          method.addEventListener('change', () => {
            bankRows.hidden = method.value !== 'bank';
            upiRows.hidden = method.value !== 'upi';
          });
          const save = h('button', 'btn btn--solid', 'Save payout details') as HTMLButtonElement;
          save.type = 'button';
          save.addEventListener('click', async () => {
            await act('/api/members-me/rental/payout', { payeeName: name.value, method: method.value, account: account.value, ifsc: ifsc.value, upi: upi.value, pan: pan.value }, 'Saved. TVC will check it before paying you.', save, 'Saving…');
          });
          box.replaceChildren(
            say('Encrypted. We show only the last four characters.'),
            h('label', 'rent-field', undefined, h('span', 'field-label', 'Name on the account'), name),
            h('label', 'rent-field', undefined, h('span', 'field-label', 'Pay me by'), method),
            bankRows,
            upiRows,
            h('label', 'rent-field', undefined, h('span', 'field-label', 'PAN'), pan),
            save,
          );
        };
        paint2();
        return card('How you are paid', box);
      };

      if (d.state === 'none') {
        let shape: 'whole' | 'room' = 'whole';
        const size = h('select') as HTMLSelectElement;
        size.id = 'rent-size';
        for (const [v, l] of [['1bhk', '1 BHK'], ['2bhk', '2 BHK'], ['3bhk', '3 BHK']]) size.append(Object.assign(document.createElement('option'), { value: v, textContent: l }));
        size.value = '2bhk';
        const delegate = h('input') as HTMLInputElement;
        delegate.type = 'checkbox';
        delegate.id = 'rent-delegate';
        const wholeOnly = h('div', 'rent-more', undefined,
          h('label', 'rent-field', undefined, h('span', 'field-label', 'Size'), size),
          h('label', 'rent-check', undefined, delegate, h('span', '', 'TVC manages it for me')));
        const roomOnly = h('p', 'rent-note', 'You answer requests for a room yourself.');
        roomOnly.hidden = true;
        const seg = h('div', 'segmented rent-pick');
        seg.setAttribute('role', 'radiogroup');
        seg.setAttribute('aria-label', 'What you are offering');
        const picks = ([['whole', 'Whole unit'], ['room', 'One room']] as ['whole' | 'room', string][]).map(([v, l]) => {
          const b = h('button', '', l) as HTMLButtonElement;
          b.type = 'button';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', String(v === shape));
          b.addEventListener('click', () => {
            shape = v;
            for (const o of picks) o.setAttribute('aria-checked', String(o === b));
            wholeOnly.hidden = shape === 'room';
            roomOnly.hidden = shape === 'whole';
          });
          return b;
        });
        seg.append(...picks);
        const send = h('button', 'btn btn--solid', 'I’m interested') as HTMLButtonElement;
        send.type = 'button';
        send.addEventListener('click', async () => {
          await act('/api/members-me/rental/offer', { shape, size: size.value, delegateToTvc: shape === 'whole' && delegate.checked }, 'Linger has been told. They will be in touch.', send, 'Sending…');
        });
        sections.push(card('Rent out your unit',
          seg,
          wholeOnly, roomOnly,
          say('Linger receives your name and email to get in touch.'),
          send));
      } else if (d.state === 'interested') {
        const label = d.types?.find((t) => t.id === d.offer?.typeId)?.label ?? '';
        const withdraw = h('button', 'btn', 'Withdraw') as HTMLButtonElement;
        withdraw.type = 'button';
        withdraw.addEventListener('click', () => void act('/api/members-me/rental/withdraw', {}, 'Withdrawn.', withdraw, 'Withdrawing…'));
        const k = d.contract;
        let contractCard: HTMLElement | null = null;
        if (k) {
          const pick = h('input') as HTMLInputElement;
          pick.type = 'file';
          pick.accept = 'application/pdf,image/jpeg,image/png';
          pick.setAttribute('aria-label', 'Your signed copy');
          const read = h('button', 'btn', 'Read the contract') as HTMLButtonElement;
          read.type = 'button';
          read.addEventListener('click', () => void openContractCopy('contract', read));
          const mine = h('button', 'btn', 'See my signed copy') as HTMLButtonElement;
          mine.type = 'button';
          mine.addEventListener('click', () => void openContractCopy('signed', mine));
          const up = h('button', 'btn btn--solid', k.hasSigned ? 'Replace my signed copy' : 'Upload my signed copy') as HTMLButtonElement;
          up.type = 'button';
          up.addEventListener('click', async () => {
            const f = pick.files?.[0];
            if (!f) return toast('Choose your signed copy first.');
            await act('/api/members-me/rental/contract/signed', { file: { mime: f.type, base64: await fileAsBase64(f) } }, 'Thank you. The core team will enable your unit.', up, 'Uploading…');
          });
          contractCard = card('Your contract',
            say(k.hasSigned ? 'Signed copy received. The core team will enable your unit.' : 'Read it, sign it, then upload the signed copy (PDF or photo, up to 4 MB).'),
            h('div', 'rent-dates', undefined, read, k.hasSigned ? mine : null),
            k.canUpload ? h('div', 'rent-dates', undefined, pick, up) : null);
        }
        sections.push(card('Your offer',
          rentalStepper(stageIndex({ offerStatus: 'interested', contractStatus: k ? (k.stage === 'review' ? 'signed' : 'shared') : undefined })),
          say(`Offered as ${d.offer?.shape === 'room' ? 'one room' : `${label}, whole unit${d.offer?.delegateToTvc ? ', managed by TVC' : ''}`}. Linger will be in touch.`),
          withdraw));
        if (contractCard) sections.unshift(contractCard);
        const pc = payoutCard();
        if (pc) sections.push(pc);
      } else if (d.unit) {
        const u = d.unit;
        const label = d.types?.find((t) => t.id === u.typeId)?.label ?? '';
        sections.push(card('Your rental',
          rentalStepper(stageIndex({ unitStatus: u.status })),
          say(`${label} · ${u.shape === 'room' ? 'one room' : 'whole unit'} · ${u.manager === 'tvc' ? 'TVC manages it' : 'you manage it'}${d.state === 'paused' ? ' · paused by the core team' : ''}`),
          d.payout?.maintenance ? say('Your share is set against your maintenance.') : null));

        // Set once and left alone: the card says what is set, and the choices open only after Change.
        const mode = RENTAL_MODES.find(([v]) => v === u.requestMode);
        const closureText = u.ignoresFarmClosure ? 'Open when the farm is closed' : 'Closes with the farm';
        const settingsBtn = (label: string, on: boolean) => {
          const b = h('button', 'btn', label) as HTMLButtonElement;
          b.type = 'button';
          b.addEventListener('click', () => {
            editingSettings = on;
            paint();
          });
          return b;
        };
        if (!editingSettings) {
          sections.push(card('Requests',
            u.manager === 'member' && mode ? h('p', 'rent-set', undefined, h('b', '', mode[1]), h('span', '', mode[2])) : say('TVC answers requests for your unit.'),
            say(closureText),
            settingsBtn('Change', true)));
        } else {
          const open = h('input') as HTMLInputElement;
          open.type = 'checkbox';
          open.checked = u.ignoresFarmClosure;
          open.addEventListener('change', () => void act('/api/members-me/rental/settings', { ignoresFarmClosure: open.checked }, open.checked ? 'Your unit stays open when the farm is closed.' : 'Your unit closes with the farm.'));
          const keepOpen = h('label', 'rent-check', undefined, open, h('span', '', 'Keep my unit open when the farm is closed'));
          const opts = u.manager === 'member'
            ? RENTAL_MODES.map(([v, t, text]) => {
                const r = h('input') as HTMLInputElement;
                r.type = 'radio';
                r.name = 'rent-mode';
                r.value = v;
                r.checked = u.requestMode === v;
                r.addEventListener('change', () => void act('/api/members-me/rental/settings', { requestMode: v }, `Requests: ${t}.`));
                return h('label', 'rent-opt', undefined, r, h('span', '', undefined, h('b', '', t), h('span', '', text)));
              })
            : [];
          sections.push(card('Requests', ...opts, keepOpen, settingsBtn('Done', false)));
        }

        const from = h('input') as HTMLInputElement;
        const to = h('input') as HTMLInputElement;
        for (const [i, id, l] of [[from, 'rent-from', 'First night'], [to, 'rent-to', 'Last night']] as [HTMLInputElement, string, string][]) {
          i.type = 'date';
          i.id = id;
          i.setAttribute('aria-label', l);
        }
        const add = h('button', 'btn', 'Block these nights') as HTMLButtonElement;
        add.type = 'button';
        add.addEventListener('click', async () => {
          if (!from.value || !to.value) return toast('Choose the first and the last night.');
          await act('/api/members-me/rental/blocks', { from: from.value, to: to.value }, 'Nights blocked.', add, 'Blocking…');
        });
        const blocks = d.blocks ?? [];
        sections.push(card('Blocked dates',
          blocks.length
            ? h('ul', 'rent-list', undefined, ...blocks.map((b) => {
                const li = h('li', '', undefined, h('span', '', b.farm ? `${dateLabel(b.startDate)} to ${endLabel(b.startDate, b.nights)}: the farm is closed` : `${dateLabel(b.startDate)} to ${endLabel(b.startDate, b.nights)}${b.mine ? '' : ': unavailable (TVC)'}`));
                if (b.mine) {
                  const rm = h('button', 'link-btn', 'Remove') as HTMLButtonElement;
                  rm.type = 'button';
                  rm.addEventListener('click', () => void act('/api/members-me/rental/blocks/remove', { id: b.id }, 'Block removed.', rm, 'Removing…'));
                  li.append(rm);
                }
                return li;
              }))
            : null,
          h('div', 'rent-dates', undefined, from, to, add)));

        const stays = d.stays ?? [];
        sections.push(card('Stays',
          stays.length
            ? h('ul', 'rent-list rent-stays', undefined, ...stays.map((st) => h('li', '', undefined,
                h('b', '', `${dateLabel(st.startDate)} to ${endLabel(st.startDate, st.nights)} · ${st.guests.length} guest${st.guests.length === 1 ? '' : 's'}`),
                h('ul', 'rent-guests', undefined, ...st.guests.map((g) => h('li', '', `${g.name} · ${g.ageGroup}${g.gender ? `, ${g.gender.toLowerCase()}` : ''}${g.preferences ? ` · ${g.preferences}` : ''}`))))))
            : say('No stays yet.')));
        const pc2 = payoutCard();
        if (pc2) sections.push(pc2);
      }
      body.replaceChildren(...sections);
    };

    const refresh = async () => {
      try {
        const { status, data } = await memberFetch('/api/members-me/rental');
        if (status === 200) rental = data;
      } catch {
        // keep what is shown
      }
      paint();
    };
    if (rental) paint();
    else body.append(h('span', 'skel skel--card'));
    void refresh();
    return root;
  }

  // ---- views ----
  function viewDashboard(): HTMLElement {
    const hh = hhNow();
    const person = meIn(hh);
    const root = h('div');
    root.append(h('h1', 'page-title', `Hello, ${first(me!.name)}`), h('p', 'lede', 'Your unit, your story and your neighbours in the valley.'));

    // One thing to do next. Until a mobile number is on file that is the thing; after that, the story.
    const go = (label: string, to: string, solid = false) => {
      const b = h('button', solid ? 'btn btn--solid' : 'btn', label);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => (location.hash = `#/${to}`));
      return b;
    };
    const next = !me!.phone
      ? { title: 'Add your WhatsApp number', text: 'So the core team can message you about stays and farm updates.', actions: [(() => { const b = h('button', 'btn btn--solid', 'Add my number'); b.setAttribute('type', 'button'); b.addEventListener('click', detailsDialog); return b; })()] }
      : isFamily()
      ? { title: 'Directory', text: 'Meet your neighbours in the valley.', actions: [go('Open the directory', 'directory', true)] }
      : { title: 'Our story', text: 'Add to it or change it whenever you like, and read what your neighbours have shared.', actions: [go('Edit your story', 'story', true), go('Open the directory', 'directory')] };
    // Steps added since this member last saw the tour: one dismissible card above the next step (nothing for a brand new
    // member, who is walked through the whole tour instead).
    const fresh = typeof me!.tourSeenThrough === 'number' && !whatsNewDismissed ? tourPending() : [];
    if (fresh.length) root.append(whatsNewCard(fresh));
    const nextCard = h('section', 'next', undefined, h('div', 'next-text', undefined, h('h2', '', next.title), h('p', '', next.text)), h('div', 'next-actions', undefined, ...next.actions));
    nextCard.setAttribute('data-tour', 'next');
    root.append(nextCard);

    const grid = h('div', 'widgets');
    const prompts = h('div');
    const checks = hh.flags.filter((f) => f.severity !== 'info').length;
    if (checks) prompts.append(h('p', 'prompt', `${checks} detail${checks === 1 ? '' : 's'} in your unit's records look incomplete. The core team is working through them.`));

    grid.append(
      widget('My unit', { more: ['View unit', 'unit'], icon: IC.unit, tour: 'unit-widget' },
        h('div', 'tiles', undefined,
          h('div', 'tile', undefined, h('div', 'k', undefined, scene('farm', 'Farm land'), farmPills(hh)), h('div', 'v', hh.plots.length ? `${acresFmt.format(hh.farmAcres)} ac` : '—'), h('div', 's', hh.plots.length ? `${hh.plots.length} survey${hh.plots.length === 1 ? '' : 's'}` : 'Not available yet')),
          h('div', 'tile', undefined, h('div', 'k', undefined, scene('house', 'House'), housePills(hh)), h('div', 'v', hh.houseSqFt > 0 ? `${sqftFmt.format(hh.houseSqFt)} sq ft` : '—'), h('div', 's', undefined, h('span', '', !hh.houseNo ? 'No house allocated yet' : hh.housePattas.length ? `${hh.housePattas.length} survey${hh.housePattas.length === 1 ? '' : 's'}` : 'Area not on record'))),
        ),
        prompts,
      ),
      widget('People', { icon: IC.people }, peopleList(hh, person)),
    );
    root.append(grid);

    const ahead = NAV.filter((n) => n.soon && n.id !== 'receipts' && n.id !== 'statements' && n.id !== 'documents' && n.id !== 'meetings');
    root.append(h('section', 'panel ahead', undefined,
      h('h2', '', 'On the way'),
      h('ul', 'soon-list', undefined, ...ahead.map((n) => h('li', '', `${n.label}: ${PLANNED[n.id][0]}`)))));
    return root;
  }

  function viewUnit(): HTMLElement {
    const hh = hhNow();
    const person = meIn(hh);
    const root = h('div');
    root.append(
      h('h1', 'page-title', 'My unit'),
      h('p', 'lede', 'Your farm land and house plot, and the people who share them.'),
      h('h2', 'group-head', 'Land'));

    // One card per kind of land: what it is (with its code), one figure, the survey table, and a Documents row.
    const landCard = (o: { title: string; codes: HTMLElement[]; figure: string; other?: string; table: HTMLElement | null; empty: string; footer: HTMLElement | null }) =>
      h('section', 'unit-card', undefined,
        h('div', 'unit-card-head', undefined, h('h2', '', o.title), ...o.codes),
        h('div', 'land-figure', undefined, h('b', '', o.figure), o.other ? h('span', '', o.other) : null),
        o.table ?? h('p', 'unit-card-empty', o.empty),
        o.footer);
    const codePill = (text: string, title: string, end = false) => {
      const el = h('span', `code-pill${end ? ' code-pill--end' : ''}`, text);
      el.title = title;
      return el;
    };
    const kind = baseUnitType(hh.unitType);
    const beds = bedroomsOf(hh.unitType);
    const housingBits = [hh.cluster ? `Cluster ${hh.cluster}` : null, beds, kind].filter(Boolean).join(' · ');
    const land = h('div', 'land');
    land.append(
      landCard({
        title: 'Farm land',
        codes: [codePill(hh.farmUnit, 'Farm unit')],
        figure: hh.plots.length ? `${acresFmt.format(hh.farmAcres)} acres` : '—',
        other: hh.plots.length ? `${acresFmt.format(hh.farmHectares)} hectares` : undefined,
        table: hh.plots.length ? mergePattaRuns(tableOf(['Patta no.', 'Survey no.', 'Acres', 'Status'], [...hh.plots].sort(byPatta).map((p) => [docLink(p.pattaNo ?? '', p.pattaDocumentId) || null, surveyCell(p.surveyNo, p.surveyDocumentId, p.sourceDocumentId), area(p.areaAcres, acresFmt), verifiedMark(p.verification)]), 2)) : null,
        empty: 'Patta details not available yet',
        footer: isFamily() ? null : landCardFooter(hh, 'farm'),
      }),
      landCard({
        title: 'House plot',
        codes: [...(hh.houseNo ? [codePill(hh.houseNo, 'House number')] : []), ...(housingBits ? [codePill(housingBits, 'Cluster and unit type', true)] : [])],
        figure: hh.houseSqFt > 0 ? `${sqftFmt.format(hh.houseSqFt)} sq ft` : '—',
        table: hh.housePattas.length ? mergePattaRuns(tableOf(['Patta no.', 'Survey no.', 'Sq ft', 'Status'], [...hh.housePattas].sort(byPatta).map((p) => [docLink(p.pattaNo ?? '', p.pattaDocumentId) || null, surveyCell(p.surveyNo, p.surveyDocumentId, p.sourceDocumentId), area(p.areaSqFt, sqftFmt), verifiedMark(p.verification)]), 2)) : null,
        empty: hh.houseNo ? 'Patta details not available yet' : 'No house allocated yet',
        footer: hh.houseNo && !isFamily() ? landCardFooter(hh, 'house') : null,
      }),
    );
    root.append(land, h('h2', 'group-head', 'People'));

    // People: one grouped list. Each person is a row: their picture or initial, name, contact (masked for
    // everyone but you), and where they stand with signing in, in words. Owners can open a family member to edit them.
    const owner = isOwner();
    // A picture on file means they have signed in. No picture could be either "not yet" or a Google account without one,
    // so the label for a person who can sign in is "Invited", not a claim that they never have.
    const signIn = (p: Person): [string, string, string] =>
      p.picture || p.id === person.id ? ['Signed in', ' st-pill--ok', 'Has signed in to the portal'] : p.canLogin ? ['Invited', '', 'Can sign in with Google; no sign-in seen yet'] : ['No sign-in', '', 'Cannot sign in to the portal'];
    const personRow = (p: Person): HTMLElement => {
      const c = contact(p, person);
      const [word, tone, why] = signIn(p);
      const state = h('span', `st-pill${tone}`, word);
      state.title = why;
      const body = [
        personFace(p),
        h('span', 'grow', undefined, h('span', 'title', `${p.name}${p.id === person.id ? ' (you)' : ''}`),
          h('span', 'detail', undefined, c.email ?? 'No email', h('span', 'sep', ' · '), h('span', 'tel', c.phone ?? 'No mobile'))),
        state,
      ];
      if (owner && p.role === 'family') {
        const chev = icon('<path d="M9 6l6 6-6 6"/>');
        chev.setAttribute('class', 'chev');
        const b = h('button', 'row person-row', undefined, ...body, chev);
        b.setAttribute('type', 'button');
        b.setAttribute('aria-label', `Edit ${p.name}`);
        b.addEventListener('click', () => editFamilyDialog(p));
        return h('li', '', undefined, b);
      }
      return h('li', '', undefined, h('div', 'row person-row', undefined, ...body));
    };
    const owners = hh.people.filter((p) => p.role === 'owner');
    const others = hh.people.filter((p) => p.role === 'non_owner');
    const family = hh.people.filter((p) => p.role === 'family');
    const familyLogins = family.filter((p) => p.canLogin).length;
    const requestMore = familyLogins >= FAMILY_LOGINS;
    const add = h('button', 'row card-row action-row', undefined, icon('<path d="M12 5v14M5 12h14"/>'), h('span', 'grow', requestMore ? 'Request another family member' : 'Add a family member'));
    add.setAttribute('type', 'button');
    add.setAttribute('data-tour', 'add-family');
    add.addEventListener('click', () => addFamilyDialog(requestMore));
    const label = (text: string) => h('li', 'sub-label', text);
    const items: HTMLElement[] = [label('Owners'), ...(owners.length ? owners.map(personRow) : [h('li', 'sub-label', 'No owners on record yet')])];
    if (others.length) items.push(label('Not owners'), ...others.map(personRow));
    if (owner || family.length) {
      items.push(label('Family'), ...(family.length ? family.map(personRow) : [h('li', 'unit-card-empty', 'No family members added yet.')]));
      if (owner) items.push(h('li', '', undefined, add));
    }
    root.append(h('ul', 'list', undefined, ...items));
    const notes: HTMLElement[] = [];
    if (owner && me!.familyRequestsPending > 0) notes.push(h('p', 'story-hint', `${me!.familyRequestsPending === 1 ? '1 request is' : `${me!.familyRequestsPending} requests are`} waiting for the core team.`));
    if (owner) notes.push(h('p', 'story-hint', `Family members sign in with Google to see your unit and, soon, book stays. They cannot edit your story, land documents or who is in your unit. ${FAMILY_LOGINS} are included; more need core team approval.`));
    root.append(...notes);
    return root;
  }

  // ---- your story ----
  // Split editor: the form on the left (draft autosaved), the card as it will look on the
  // right. "Check & submit" runs the writing check first; the member accepts or dismisses
  // each suggestion, and only then is the story handed to the core team. Nothing the check
  // suggests is ever applied without the member pressing Accept.
  // The unit's one shared story, with each person's own quote (and, until it is folded into the text, link).
  type StoryDraft = { bio: string; family: string; why: string; social: string; photo: string };
  type StoryView = { draft: StoryDraft; showOnPublicSite: boolean; status: string; hasUnsubmittedChanges: boolean; reviewerNote: string | null; hasApproved: boolean };
  type Suggestion = { field: 'bio' | 'family' | 'why'; kind: string; before?: string; after?: string; why?: string; note?: string; done?: boolean };
  const STORY_FIELD: Record<string, string> = { bio: 'What you do today', family: 'Family', why: 'Why TVC' };
  const KIND_LABEL: Record<string, string> = { spelling: 'Spelling', grammar: 'Grammar', framing: 'House style', tone: 'Tone', privacy: 'Privacy', note: 'Note' };

  // Before a photo is uploaded the member chooses what the circle shows: drag to centre it, zoom with the slider, the mouse
  // wheel or a pinch. What is drawn here is cut from exactly the same rectangle (photo-crop.mjs), so the card matches the dialog.
  // Resolves with the two JPEGs, or null if they cancel. Errors (a photo too small...) are thrown before the dialog opens.
  async function cropPhoto(file: File): Promise<{ square: Blob; full: Blob } | null> {
    const bitmap = await openPhoto(file);
    const { width, height } = bitmap;
    const VIEW = 280;
    let state = initialCrop(width, height);
    const canvas = document.createElement('canvas');
    const px = Math.round(VIEW * Math.min(window.devicePixelRatio || 1, 2));
    canvas.width = canvas.height = px;
    canvas.className = 'crop-view';
    canvas.tabIndex = 0;
    canvas.setAttribute('role', 'img');
    canvas.setAttribute('aria-label', 'Your photo. Drag to move it, or use the arrow keys; zoom with the slider or the plus and minus keys.');
    const ctx = canvas.getContext('2d')!;
    const slider = document.createElement('input');
    slider.type = 'range';
    slider.min = '1';
    slider.max = String(MAX_ZOOM);
    slider.step = '0.01';
    slider.value = '1';
    slider.setAttribute('aria-label', 'Zoom');
    const draw = () => {
      const r = cropRect(state, width, height);
      ctx.clearRect(0, 0, px, px);
      ctx.drawImage(bitmap, r.sx, r.sy, r.side, r.side, 0, 0, px, px);
      slider.value = String(state.zoom);
    };
    const zoom = (z: number) => { state = zoomTo(state, z, width, height); draw(); };
    const pan = (dx: number, dy: number) => { state = panBy(state, dx, dy, VIEW, width, height); draw(); };

    // Dragging with one finger or the mouse moves the picture; two fingers pinch to zoom.
    const pointers = new Map<number, { x: number; y: number }>();
    let pinchStart: { distance: number; zoom: number } | null = null;
    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStart = { distance: Math.hypot(a.x - b.x, a.y - b.y) || 1, zoom: state.zoom };
      }
    });
    canvas.addEventListener('pointermove', (e) => {
      const last = pointers.get(e.pointerId);
      if (!last) return;
      const now = { x: e.clientX, y: e.clientY };
      pointers.set(e.pointerId, now);
      if (pointers.size === 1) pan(now.x - last.x, now.y - last.y);
      else if (pointers.size === 2 && pinchStart) {
        const [a, b] = [...pointers.values()];
        zoom(pinchStart.zoom * ((Math.hypot(a.x - b.x, a.y - b.y) || 1) / pinchStart.distance));
      }
    });
    const release = (e: PointerEvent) => { pointers.delete(e.pointerId); pinchStart = null; };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('wheel', (e) => { e.preventDefault(); zoom(state.zoom * (e.deltaY < 0 ? 1.1 : 1 / 1.1)); }, { passive: false });
    canvas.addEventListener('keydown', (e) => {
      const step = 12;
      const moves: Record<string, [number, number]> = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
      if (moves[e.key]) { e.preventDefault(); pan(...moves[e.key]); }
      else if (e.key === '+' || e.key === '=') { e.preventDefault(); zoom(state.zoom * 1.1); }
      else if (e.key === '-') { e.preventDefault(); zoom(state.zoom / 1.1); }
    });
    slider.addEventListener('input', () => zoom(Number(slider.value)));

    return new Promise((resolve) => {
      let result: { square: Blob; full: Blob } | null = null;
      const dlg = document.createElement('dialog');
      dlg.className = 'modal crop-modal';
      const use = h('button', 'btn btn--solid', 'Use this photo') as HTMLButtonElement;
      use.type = 'button';
      const cancel = h('button', 'btn', 'Cancel') as HTMLButtonElement;
      cancel.type = 'button';
      const note = h('p', 'story-hint', 'The circle is how your photo will look on your card. Drag to move it, zoom to fit.');
      use.addEventListener('click', async () => {
        use.disabled = cancel.disabled = true;
        note.textContent = 'Preparing your photo…';
        try {
          result = await preparePhotoFrom(bitmap, cropRect(state, width, height));
          dlg.close();
        } catch (e) {
          note.textContent = msgOf(e);
          note.className = 'story-hint story-hint--warn';
          use.disabled = cancel.disabled = false;
        }
      });
      cancel.addEventListener('click', () => dlg.close());
      dlg.addEventListener('close', () => { if (!result) bitmap.close?.(); dlg.remove(); resolve(result); });
      dlg.append(
        h('h3', '', 'Position your photo'),
        h('div', 'crop-stage', undefined, canvas),
        h('label', 'crop-zoom', undefined, h('span', '', 'Zoom'), slider),
        note,
        h('div', 'modal-actions', undefined, cancel, use),
      );
      draw();
      presentSheet(dlg);
      canvas.focus();
    });
  }
  const msgOf = (e: unknown) => (e instanceof Error ? e.message : 'Something went wrong. Try again.');

  function viewStory(): HTMLElement {
    const root = h('div');
    const back = h('a', 'back-link', undefined, icon('<path d="M15 6l-6 6 6 6"/>'), 'Directory');
    back.setAttribute('href', '#/directory');
    root.append(
      back,
      h('h1', 'page-title', 'Our story', h('small', '', 'Your card for the collective')),
      h('p', 'lede', 'Your unit has one story, shared by everyone in it. The core team reads it before it appears anywhere.'),
      h('details', 'story-how', undefined, h('summary', '', 'How it works'), h('ul', '', undefined,
        h('li', '', 'Either of you can edit what you do, your family and the photos. Your "why TVC" line is your own.'),
        h('li', '', 'The story needs at least one "why TVC" line from your unit before it can be submitted.'),
        h('li', '', 'To link your name to a page of yours, select it in the text and press Link.'),
        h('li', '', 'Once approved, other members can read it in the Directory. It goes on tvc.farm only if you switch on "Show on tvc.farm".'))),
      // (not `cond ? null : el`: append(null) writes the text "null")
      ...(me!.directoryVisible ? [] : [h('p', 'lede lede--warn', 'You are not listed in the member directory, so other members cannot see your story and it will not go on tvc.farm either. You can change that in your account menu, under Your details.')]),
    );
    const loading = h('div', 'story-skel', undefined,
      h('span', 'sr-only', 'Loading your story…'),
      h('span', 'skel skel--line'), h('span', 'skel skel--card'), h('span', 'skel skel--card'));
    loading.setAttribute('role', 'status');
    root.append(loading);

    const draft: StoryDraft = { bio: '', family: '', why: '', social: '', photo: '' };
    // Saves and checks carry the text only: the photo is changed by its own endpoints.
    const textOf = (d: StoryDraft) => ({ bio: d.bio, family: d.family, why: d.why, social: d.social });
    let story: StoryView | null = null;
    // The unit's shared draft has a version, so two owners saving at once only collide on the same field.
    // `savedFields` is what the server last accepted, so a save can send only what changed since.
    let version = 0;
    type EditKey = 'bio' | 'family' | 'why' | 'social';
    const EDIT_KEYS: EditKey[] = ['bio', 'family', 'why', 'social'];
    const savedFields = { bio: '', family: '', why: '', social: '', isPublic: false };
    let photos: { ref: string; personId: string }[] = [];
    let others: { firstName: string; quote: string; link: string }[] = [];
    let housemates: string[] = [];
    const unitText = () => ({ bio: draft.bio, family: draft.family, why: draft.why, social: draft.social, isPublic });
    // The server's view of the unit's story.
    function applyUnitView(v: any) {
      story = { draft: { bio: v.draft.bio, family: v.draft.family, why: v.draft.quote, social: v.draft.link, photo: '' }, showOnPublicSite: v.showOnPublicSite, status: v.status, hasUnsubmittedChanges: v.hasUnsubmittedChanges, reviewerNote: v.reviewerNote, hasApproved: v.hasApproved };
      version = v.version;
      photos = v.draft.photos;
      others = v.others;
      housemates = v.housemates ?? [];
    }
    let firstName = first(me!.name);
    let isPublic = false;
    let suggestions: Suggestion[] = [];
    let reviewed = false;
    let checking = false;
    let submitting = false;
    let notice: string | null = null;
    let message = '';
    let saveState: 'idle' | 'saving' | 'saved' | 'error' = 'idle';
    let timer: number | undefined;
    let chain: Promise<void> = Promise.resolve();
    const fields: Record<string, HTMLTextAreaElement | HTMLInputElement> = {};
    const statusEl = h('div', 'story-status');
    const saveEl = h('p', 'story-save');
    const previewEl = h('article', 'story-card');
    const reviewEl = h('section', 'story-box');
    const publishEl = h('section', 'story-box');
    // The submit bar stays at the foot of the screen while the form scrolls, so the next step is always in reach.
    const submitEl = h('div', 'story-bar');
    const pending = () => suggestions.filter((s) => !s.done);

    const msg = (e: unknown) => (e instanceof MemberAuthError ? 'Your session ended. Sign in again.' : e instanceof Error ? e.message : 'Something went wrong. Try again.');

    function renderStatus() {
      let cls = 'draft', title = 'Draft', text = 'Saved, but not submitted. Only the people in your unit and the core team can see it.';
      if (story?.status === 'in_review') {
        cls = 'review'; title = 'In review';
        text = story.hasUnsubmittedChanges ? 'With the core team. You have newer changes that are not submitted yet.' : 'With the core team. It will show here once it is approved.';
      } else if (story?.status === 'approved') {
        cls = 'live'; title = 'Approved';
        text = story.hasUnsubmittedChanges ? 'Your approved story stays as it is until you submit these changes.' : 'Approved. Other members can read it in the Directory.';
      } else if (story?.status === 'rejected') {
        cls = 'review'; title = 'Changes needed';
        text = story.reviewerNote || 'The core team asked for changes. Edit and submit again.';
      }
      statusEl.className = 'story-status';
      statusEl.replaceChildren(h('span', `st-pill${cls === 'review' ? ' st-pill--warn' : cls === 'live' ? ' st-pill--ok' : ''}`, title), h('span', '', text));
      saveEl.textContent = saveState === 'saving' ? 'Saving…' : saveState === 'saved' ? 'Draft saved' : saveState === 'error' ? 'Could not save your draft. Check your connection.' : '';
    }

    function renderPreview() {
      const name = me!.name;
      const nodes: Kid[] = [];
      const bio = draft.bio.trim();
      const para = h('p', 'story-card-bio');
      if (bio) {
        const boldFirst = (t: string) => t.split(new RegExp(`(\\b${firstName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b)`)).map((part) => (part === firstName ? h('strong', '', part) : document.createTextNode(part)));
        para.append(...mdNodes(bio, (t, inLink) => (inLink ? [document.createTextNode(t)] : boldFirst(t))));
      } else para.append(h('em', 'story-empty', 'Nothing here yet'));
      // The Directory shows up to two photos of a unit as overlapping faces, so the preview does too (one photo is one face).
      const shownPhotos = photos.slice(0, MAX_PHOTOS).map((p) => p.ref);
      const title = housemates.length ? `${first(name)} & ${housemates.join(' & ')}` : name;
      const faces = shownPhotos.length
        ? h('span', 'story-card-faces', undefined, ...shownPhotos.map((ref) => photoImg(ref, 'avatar avatar--lg story-photo', 'square')))
        : h('span', 'avatar avatar--lg', first(name).slice(0, 1).toUpperCase());
      nodes.push(h('div', 'story-card-top', undefined, faces, h('div', '', undefined, h('h3', '', title), h('span', `story-vis ${isPublic ? 'story-vis--public' : ''}`, isPublic ? 'Members and tvc.farm' : 'Members only'))));
      nodes.push(para);
      if (draft.family.trim()) nodes.push(h('p', 'story-card-fam', undefined, ...mdNodes(draft.family.trim())));
      if (draft.why.trim()) nodes.push(h('blockquote', 'story-card-why', draft.why.trim()));
      for (const o of others) if (o.quote) nodes.push(h('blockquote', 'story-card-why', o.quote, h('cite', '', ` — ${o.firstName}`)));
      previewEl.replaceChildren(...(nodes.filter(Boolean) as Node[]));
    }

    function renderReview() {
      const head = h('div', 'story-box-head', undefined, h('h2', '', 'Review my story'));
      const run = h('button', 'btn', checking ? 'Checking…' : reviewed ? 'Check again' : 'Check spelling, grammar & style') as HTMLButtonElement;
      run.type = 'button';
      run.disabled = checking;
      run.addEventListener('click', () => void runCheck());
      head.append(run);
      const kids: Kid[] = [head, h('p', 'story-hint', 'Suggestions come from an AI writing check. Nothing changes unless you press Accept; your words stay yours.')];
      if (notice) kids.push(h('p', 'story-hint story-hint--warn', notice));
      if (reviewed && suggestions.length === 0) kids.push(h('p', 'story-ok', 'No suggestions. Your story reads well.'));
      for (const s of suggestions) {
        const row = h('div', `story-sug${s.done ? ' story-sug--done' : ''}`);
        row.append(h('div', 'story-sug-meta', undefined, h('span', `story-tag story-tag--${s.kind}`, KIND_LABEL[s.kind] ?? s.kind), h('span', 'story-sug-field', STORY_FIELD[s.field])));
        if (s.before !== undefined && s.after !== undefined) {
          const diff = h('p', 'story-diff', undefined, h('del', '', s.before), ' → ', h('ins', '', s.after));
          row.append(diff);
          if (s.why) row.append(h('p', 'story-hint', s.why));
        } else row.append(h('p', 'story-sug-note', s.note ?? ''));
        if (s.done) row.append(h('span', 'story-hint', 'Done'));
        else {
          const act = h('div', 'story-sug-act');
          if (s.before !== undefined) {
            const ok = h('button', 'btn btn--solid', 'Accept') as HTMLButtonElement;
            ok.type = 'button';
            ok.addEventListener('click', () => accept(s));
            act.append(ok);
          }
          const keep = h('button', 'btn', s.before !== undefined ? 'Keep mine' : 'Got it') as HTMLButtonElement;
          keep.type = 'button';
          keep.addEventListener('click', () => { s.done = true; renderReview(); renderSubmit(); });
          act.append(keep);
          row.append(act);
        }
        kids.push(row);
      }
      if (reviewed && suggestions.length > 0 && pending().length === 0) kids.push(h('p', 'story-ok', 'All handled. You can submit.'));
      reviewEl.replaceChildren(...(kids.filter(Boolean) as Node[]));
    }

    function renderSubmit() {
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = isPublic;
      cb.addEventListener('change', () => { isPublic = cb.checked; edited(); renderSubmit(); });
      const inReview = story?.status === 'in_review' && !story.hasUnsubmittedChanges;
      const waiting = checking || submitting;
      const go = h('button', 'btn btn--cta', checking ? 'Checking your writing…' : submitting ? 'Submitting…' : inReview ? 'Submitted' : reviewed ? 'Submit to the core team' : 'Check & submit') as HTMLButtonElement;
      go.type = 'button';
      go.disabled = inReview || waiting;
      if (waiting) go.setAttribute('aria-busy', 'true');
      go.addEventListener('click', () => void submitClick());
      publishEl.replaceChildren(
        h('label', 'check story-toggle', undefined, cb, h('span', '', undefined, h('strong', '', 'Show on tvc.farm'), h('small', '', isPublic ? 'On: once approved, your card will also appear on the public Members page, visible to anyone.' : 'Off: once approved, only logged-in members will see your card.'))));
      const hint = h('p', `story-bar-hint${message ? ' story-bar-hint--note' : ''}`, message || (inReview ? 'The core team reads every submission. You can keep editing; your changes are only handed in when you submit again.' : 'Submitting runs the writing check first, so you see any suggestions before the core team does.'));
      submitEl.replaceChildren(h('div', 'story-bar-text', undefined, hint, saveEl), go);
    }

    const renderAll = () => { renderStatus(); renderPreview(); renderReview(); renderSubmit(); };

    // Any edit makes an earlier check out of date, and the draft is saved shortly after typing stops.
    function edited() {
      reviewed = false;
      suggestions = [];
      notice = null;
      message = '';
      clearTimeout(timer);
      timer = window.setTimeout(() => void persist(), 1200);
      renderStatus(); renderPreview(); renderReview();
    }

    function persist(): Promise<void> {
      clearTimeout(timer);
      chain = chain.then(async () => {
        saveState = 'saving';
        renderStatus();
        try {
          await persistUnit();
          saveState = 'saved';
        } catch (e) {
          saveState = 'error';
          message = msg(e);
        }
        renderStatus(); renderSubmit();
      });
      return chain;
    }

    // Saves only what changed since the last save. If the other owner changed one of those fields meanwhile, the save
    // is refused: their version of just that field is shown, your other changes are kept and saved, and you are told.
    async function persistUnit(): Promise<void> {
      const sent = unitText();
      const changes = saveChanges(savedFields, sent);
      if (Object.keys(changes).length === 0) return;
      const { status, data } = await memberFetch('/api/members-me/unit-story', { method: 'POST', body: { baseVersion: version, ...changes } });
      if (status === 200) {
        applyUnitView(data.story);
        Object.assign(savedFields, sent);
        return;
      }
      if (status !== 409) throw new Error(data.error || 'Could not save your draft.');
      // Someone else in the unit got there first: take their version of the clashing fields only.
      const latest = await memberFetch('/api/members-me/unit-story');
      if (latest.status !== 200) throw new Error(data.error || 'Could not save your draft.');
      const v = latest.data.story;
      const theirs: Record<EditKey, string> = { bio: v.draft.bio, family: v.draft.family, why: v.draft.quote, social: v.draft.link };
      const clashed: string[] = conflictedDraftKeys(data.fields);
      for (const k of EDIT_KEYS) {
        // A field I did not touch simply follows them; one that clashed takes their version; one I changed that did not clash is mine, and is sent again below.
        if (clashed.includes(k) || draft[k] === savedFields[k]) {
          draft[k] = theirs[k];
          if (fields[k]) fields[k].value = theirs[k]; // the profile link has no box of its own: it lives in the text
          savedFields[k] = theirs[k];
        }
      }
      if (clashed.includes('isPublic') || isPublic === savedFields.isPublic) {
        isPublic = v.showOnPublicSite;
        savedFields.isPublic = v.showOnPublicSite;
      }
      applyUnitView(v);
      const who = others[0]?.firstName ?? 'Someone in your unit';
      message = `${who} changed ${clashed.length ? 'the same part' : 'this'} while you were editing, so their version is shown${clashed.length ? ' for that part' : ''}. Your other changes are kept.`;
      renderPreview();
      await persistUnit(); // my other changes, on top of theirs
    }

    async function runCheck() {
      if (!draft.bio.trim() && !draft.family.trim() && !draft.why.trim()) { message = 'Write something first, then check it.'; renderSubmit(); return; }
      checking = true; message = ''; notice = null;
      renderReview(); renderSubmit();
      try {
        const { status, data } = await memberFetch('/api/members-me/story-review', { method: 'POST', body: { ...textOf(draft), showOnPublicSite: isPublic } });
        if (status !== 200) throw new Error(data.error || 'The check did not work. Try again.');
        suggestions = (data.suggestions as Suggestion[]).map((s) => ({ ...s, done: false }));
        notice = data.notice ?? null;
        reviewed = true;
      } catch (e) {
        message = msg(e);
      }
      checking = false;
      renderReview(); renderSubmit();
    }

    function accept(s: Suggestion) {
      if (s.before === undefined || s.after === undefined || !draft[s.field].includes(s.before)) { s.done = true; renderReview(); return; }
      draft[s.field] = draft[s.field].replace(s.before, () => s.after!);
      fields[s.field].value = draft[s.field];
      s.done = true;
      // Other suggestions that quoted text that no longer exists have nothing left to do.
      for (const o of suggestions) if (!o.done && o.before !== undefined && !draft[o.field].includes(o.before)) o.done = true;
      renderPreview(); renderReview(); renderSubmit();
      void persist();
    }

    async function submitClick() {
      if (!reviewed) { await runCheck(); return; }
      if (pending().length) { message = 'Accept or keep mine for each suggestion first.'; renderSubmit(); return; }
      // A unit's story needs one "why TVC" line from anyone in it (a joint quote written by one of you is enough).
      if (!draft.why.trim() && !others.some((o) => o.quote)) { message = 'Your unit\'s story needs at least one "why TVC" line before it can be submitted. Write yours, or ask the other person in your unit to.'; renderSubmit(); return; }
      submitting = true;
      renderSubmit();
      await persist();
      if (saveState === 'error') { submitting = false; renderSubmit(); return; }
      try {
        const { status, data } = await memberFetch('/api/members-me/unit-story-submit', { method: 'POST', body: {} });
        if (status !== 200) throw new Error(data.error || 'Could not submit. Try again.');
        applyUnitView(data.story);
        suggestions = []; reviewed = false; message = '';
        toast('Submitted to the core team');
      } catch (e) {
        message = msg(e);
      }
      submitting = false;
      renderAll();
    }

    function field(name: keyof StoryDraft, label: string, hint: string | null, rows: number): HTMLElement {
      const input = rows === 1 ? document.createElement('input') : document.createElement('textarea');
      if (input instanceof HTMLTextAreaElement) input.rows = rows;
      else input.type = 'url';
      input.addEventListener('input', () => { draft[name] = input.value; edited(); });
      fields[name] = input;
      return h('label', 'story-field', undefined, h('span', 'story-label', label), hint ? h('span', 'story-hint', hint) : null, input);
    }

    // "What you do today" and "Family" take a little Markdown (bold, italic, links). The buttons write it, so
    // nobody has to know the syntax: select words, press a button. With the cursor inside a link, Link changes
    // or removes it. Edits go through the browser's own text insertion so Undo keeps working.
    function putValue(ta: HTMLTextAreaElement, next: { value: string; from: number; to: number }) {
      const old = ta.value;
      let a = 0;
      while (a < old.length && a < next.value.length && old[a] === next.value[a]) a++;
      let b = 0;
      while (b < old.length - a && b < next.value.length - a && old[old.length - 1 - b] === next.value[next.value.length - 1 - b]) b++;
      ta.focus();
      ta.setSelectionRange(a, old.length - b);
      const piece = next.value.slice(a, next.value.length - b);
      if (!document.execCommand('insertText', false, piece)) {
        ta.setRangeText(piece, a, old.length - b, 'end');
        ta.dispatchEvent(new Event('input', { bubbles: true }));
      }
      ta.setSelectionRange(next.from, next.to);
    }

    function mdField(name: 'bio' | 'family', label: string, hint: string, rows: number): HTMLElement {
      const ta = document.createElement('textarea');
      ta.rows = rows;
      ta.id = `story-${name}`;
      ta.addEventListener('input', () => { draft[name] = ta.value; edited(); });
      fields[name] = ta;
      const lab = h('label', 'story-label', label);
      lab.setAttribute('for', ta.id);

      const note = h('p', 'story-hint md-note');
      note.setAttribute('role', 'status');
      const say = (m: string, warn = false) => { note.textContent = m; note.className = `story-hint md-note${warn ? ' story-hint--warn' : ''}`; };
      const btn = (html: string, title: string, onClick: () => void) => {
        const b = h('button', 'md-btn') as HTMLButtonElement;
        b.type = 'button';
        b.innerHTML = html; // fixed constants only
        b.title = title;
        b.addEventListener('mousedown', (e) => e.preventDefault()); // keep the selection in the box
        b.addEventListener('click', onClick);
        return b;
      };

      const mark = (m: string) => {
        const from = ta.selectionStart, to = ta.selectionEnd;
        if (from === to) { say('Select the words first, then press the button.', true); return; }
        say('');
        putValue(ta, toggleMark(ta.value, from, to, m));
      };

      // the link panel
      const panel = h('div', 'md-panel');
      panel.hidden = true;
      const openLink = () => {
        const from = ta.selectionStart, to = ta.selectionEnd;
        const existing = linkAt(ta.value, from, to);
        const selected = ta.value.slice(from, to);
        if (!existing) {
          if (from === to) { say('Select the words you want to turn into a link (your first name, for example), then press Link.', true); return; }
          if (linkAt(ta.value, from, from) || linkAt(ta.value, to, to)) { say('That selection overlaps another link. Select other words, or put the cursor inside the link to change it.', true); return; }
          if (/\n/.test(selected)) { say('Select words on one line, for example just a name.', true); return; }
          if (selected.trim().length > 80) { say('Select fewer words: a name or a short phrase.', true); return; }
        }
        say('');
        const words = existing ? existing.label : selected.trim();
        const input = document.createElement('input');
        input.type = 'text';
        input.inputMode = 'url';
        input.autocomplete = 'off';
        input.placeholder = 'Paste the address, e.g. linkedin.com/in/your-name';
        input.value = existing ? existing.url : '';
        input.setAttribute('aria-label', 'Web address');
        const err = h('p', 'story-hint story-hint--warn');
        err.setAttribute('role', 'alert');
        const close = () => { panel.hidden = true; panel.replaceChildren(); ta.focus(); ta.setSelectionRange(from, to); };
        const save = () => {
          const u = normalizeUrl(input.value);
          if (!u.ok) { err.textContent = u.error; input.focus(); return; }
          panel.hidden = true; panel.replaceChildren();
          putValue(ta, setLink(ta.value, from, to, u.url));
        };
        const act = (text: string, cls: string, fn: () => void) => { const b = h('button', cls, text) as HTMLButtonElement; b.type = 'button'; b.addEventListener('click', fn); return b; };
        input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); save(); } else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); } });
        const row = h('div', 'md-panel-row', undefined, input, act(existing ? 'Save' : 'Add link', 'btn btn--solid', save));
        if (existing) row.append(act('Remove link', 'btn', () => { panel.hidden = true; panel.replaceChildren(); putValue(ta, removeLink(ta.value, from, to)); }));
        row.append(act('Cancel', 'btn', close));
        panel.replaceChildren(h('p', 'md-panel-title', undefined, existing ? 'Change the link on ' : 'Link ', h('strong', '', `“${words.length > 40 ? `${words.slice(0, 37)}…` : words}”`), existing ? '' : ' to:'), row, err);
        panel.hidden = false;
        input.focus();
        input.select();
      };

      ta.addEventListener('keydown', (e) => {
        if (!(e.metaKey || e.ctrlKey) || e.altKey || e.shiftKey) return;
        const k = e.key.toLowerCase();
        if (k === 'b' || k === 'i' || k === 'k') { e.preventDefault(); if (k === 'k') openLink(); else mark(k === 'b' ? '**' : '*'); }
      });
      // The Link button says what it will do at the cursor.
      const linkBtn = btn('Link', 'Link the selected words to a web address (Ctrl/Cmd+K)', openLink);
      const syncLink = () => { linkBtn.textContent = linkAt(ta.value, ta.selectionStart, ta.selectionEnd) ? 'Edit link' : 'Link'; };
      for (const ev of ['select', 'keyup', 'mouseup', 'input', 'focus'] as const) ta.addEventListener(ev, syncLink);

      const bar = h('div', 'md-bar segmented', undefined, btn('<strong>B</strong> Bold', 'Bold (Ctrl/Cmd+B)', () => mark('**')), btn('<em>I</em> Italic', 'Italic (Ctrl/Cmd+I)', () => mark('*')), linkBtn);
      return h('div', 'story-field', undefined, lab, h('span', 'story-hint', hint), bar, note, panel, ta);
    }

    // Before the editor had links in the text, a story had one "profile link" that linked the person's first
    // name. Opening such a story, that link is written into the text where the name first appears, so it
    // can be seen, changed or removed like any other. (It is saved with the next change.) If the name is not in
    // the text, or the address is not usable, the old link stays and is shown with a Remove button.
    function foldProfileLink() {
      Object.assign(draft, foldProfileIntoText(draft, firstName));
    }
    function legacyProfile(): HTMLElement | null {
      if (!draft.social) return null;
      const row = h('div', 'story-field story-legacy', undefined, h('p', 'story-hint', `You also have a profile link (${draft.social.replace(/^https?:\/\/(www\.)?/, '')}) that is not attached to any words in your story. To use it, select a name above and press Link.`));
      const rm = h('button', 'btn', 'Remove this link') as HTMLButtonElement;
      rm.type = 'button';
      rm.addEventListener('click', () => { draft.social = ''; row.remove(); edited(); });
      row.append(rm);
      return row;
    }

    let paintPhoto = () => {};

    // What the others in the unit have written for themselves, to read beside the shared story (only they edit it).
    function unitOthers(): HTMLElement {
      const withLines = others.filter((o) => o.quote || o.link);
      if (!withLines.length) return h('span');
      return h('div', 'story-field', undefined, h('span', 'story-label', 'What others in your unit have written'),
        h('div', 'story-others', undefined, ...withLines.map((o) => h('p', '', undefined, h('strong', '', `${o.firstName}: `), o.quote ? `“${o.quote}”` : '', o.link ? ` ${o.link.replace(/^https?:\/\/(www\.)?/, '')}` : ''))));
    }

    // A unit has up to MAX_PHOTOS photos, shared by everyone in it. Each is prepared in the browser as two JPEGs (preparePhoto),
    // uploaded, and then belongs to the shared draft; they are submitted and reviewed with the text.
    function unitPhotosField(): HTMLElement {
      const list = h('div', 'story-photos');
      const note = h('p', 'story-hint', `Your unit can have up to ${MAX_PHOTOS} photos, shown on your card. Photos of children become public if you turn on "Show on tvc.farm". They are kept privately and checked with your story.`);
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/jpeg,image/png,image/webp';
      input.hidden = true;
      const choose = h('button', 'btn', 'Add a photo') as HTMLButtonElement;
      choose.type = 'button';
      choose.addEventListener('click', () => input.click());
      let busy = false;
      const say = (m: string, warn = false) => { note.textContent = m; note.className = `story-hint${warn ? ' story-hint--warn' : ''}`; };
      async function send(work: () => Promise<{ status: number; data: any }>, doing: string) {
        busy = true; say(doing); paintPhoto();
        try {
          const { status, data } = await work();
          if (status !== 200) throw new Error(data.error || 'Could not save the photo. Try again.');
          applyUnitView(data.story);
          say('Saved. It goes to the core team with your story when you submit.');
          renderStatus(); renderPreview(); renderSubmit();
        } catch (e) {
          say(msg(e), true);
        } finally {
          busy = false; paintPhoto();
        }
      }
      paintPhoto = () => {
        list.replaceChildren(...photos.map((p) => {
          const rm = h('button', 'btn', 'Remove') as HTMLButtonElement;
          rm.type = 'button';
          rm.disabled = busy;
          rm.addEventListener('click', () => void send(() => memberFetch('/api/members-me/unit-story-photo-remove', { method: 'POST', body: { ref: p.ref } }), 'Removing…'));
          return h('div', 'story-photo-item', undefined, photoImg(p.ref, 'avatar avatar--lg story-photo', 'square'), rm);
        }));
        choose.disabled = busy || photos.length >= MAX_PHOTOS;
        choose.textContent = photos.length >= MAX_PHOTOS ? `${MAX_PHOTOS} photos added` : photos.length ? 'Add another photo' : 'Add a photo';
      };
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        input.value = '';
        if (!file) return;
        busy = true; say('Preparing your photo…'); paintPhoto();
        let prepared: { square: Blob; full: Blob };
        try {
          const cropped = await cropPhoto(file);
          if (!cropped) { busy = false; say('Cancelled. Nothing was uploaded.'); paintPhoto(); return; }
          prepared = cropped;
        } catch (e) {
          busy = false; say(msg(e), true); paintPhoto();
          return;
        }
        const body = new FormData();
        body.set('square', prepared.square, 'square.jpg');
        body.set('full', prepared.full, 'full.jpg');
        await send(() => memberFetch('/api/members-me/unit-story-photo', { method: 'POST', body }), 'Uploading…');
      });
      paintPhoto();
      return h('div', 'story-field', undefined, h('span', 'story-label', 'Photos (optional)'), list, choose, note, input);
    }

    void (async () => {
      try {
        const { status, data } = await memberFetch('/api/members-me/unit-story');
        if (status !== 200) throw new Error(data.error || 'Could not load your story.');
        applyUnitView(data.story);
        firstName = data.firstName || firstName;
        Object.assign(draft, story!.draft);
        isPublic = story!.showOnPublicSite;
        Object.assign(savedFields, unitText()); // what the server holds, so the first save sends only what is changed
        // A profile link of your own is written into the shared text on your first name (and cleared) rather than kept in a separate
        // field: it is then saved with your next change, like any other edit, and the core team reads it with the story.
        foldProfileLink();
      } catch (e) {
        loading.className = 'lede';
        loading.textContent = msg(e);
        return;
      }
      loading.remove();
      const form = h('div', 'story-form', undefined,
        statusEl,
        mdField('bio', 'What do you do today?', 'In your own words, in the third person, e.g. "Asha works as…". Select words and press Link to link them to a web page; the preview shows how it will look.', 5),
        mdField('family', 'Family (optional)', 'First names are enough. Children\'s names and ages become public if you turn on "Show on tvc.farm".', 3),
        field('why', 'In one sentence, why are you part of TVC?', 'Shown as a quote on your unit\'s card, in your own voice. Your unit needs at least one: yours, or one the other person has written.', 2),
        unitOthers(),
        legacyProfile(),
        unitPhotosField(),
        reviewEl, publishEl);
      const side = h('aside', 'story-side', undefined, h('p', 'story-prev-label', 'How others will see your card'), previewEl);
      // On a phone the form and the card do not fit side by side: a switch shows one at a time.
      const storyEl = h('div', 'story');
      storyEl.dataset.pane = 'edit';
      const paneSeg = h('div', 'segmented story-panes');
      paneSeg.setAttribute('role', 'group');
      paneSeg.setAttribute('aria-label', 'Show');
      const paneButtons = [['edit', 'Edit'], ['preview', 'Preview']].map(([v, text]) => {
        const b = h('button', '', text);
        b.setAttribute('type', 'button');
        b.addEventListener('click', () => {
          storyEl.dataset.pane = v;
          paneButtons.forEach((x, i) => x.setAttribute('aria-pressed', String((i === 1) === (v === 'preview'))));
        });
        return b;
      });
      paneButtons.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
      paneSeg.append(...paneButtons);
      storyEl.append(form, side);
      root.append(paneSeg, storyEl, submitEl);
      for (const k of ['bio', 'family', 'why'] as const) fields[k].value = draft[k];
      renderAll();
    })();
    return root;
  }

  // ---- directory ----
  // The other members, as households (like the public Members page): names, farm plot and
  // cluster, and each person's approved story. Never contact details; the server sends none
  // (members-me.mts handleDirectory). A member who turned their listing off is not in this list.
  type DirStory = { bio: string; family: string; why: string; social: string; onPublicSite: boolean };
  type DirPerson = { name: string; isYou: boolean; primary?: boolean; photo?: string | null; story: DirStory | null };
  type DirGroup = { people: { name: string; isYou: boolean }[]; bio: string; family: string; quotes: { name: string | null; why: string }[]; links: { name: string; url: string }[]; onPublicSite: boolean };
  type DirHousehold = { farmUnit: string; houseNo: string | null; cluster: string | null; unitType: string | null; people: DirPerson[]; groups: DirGroup[]; withoutStory: { name: string; isYou: boolean }[]; familyMembers: { name: string; isYou: boolean }[]; hasStory: boolean };

  // ---- Site map (early access) ----
  // Every home on the site plan: who it belongs to and what type it is. Read-only; the layout is changed by admins.
  // What each home shows follows the directory (netlify/functions/members-sitemap.mts, scripts/lib/site-map.mjs).
  type MapUnit = {
    houseNo: string; cluster: string; shape: string; x: number; y: number; rotation: number; mirrorX: boolean; mirrorY: boolean;
    status: 'named' | 'private' | 'vacant'; names: string[]; unitType: string | null; bhk: string; detail: string; farmUnit: string | null; isYours: boolean;
  };
  type MapCluster = { id: string; baseSize: number; viewBox: number[]; plot: string };
  let siteMap: { preview?: boolean; clusters: MapCluster[]; units: MapUnit[] } | null = null;

  function setSiteMapVisible(on: boolean) {
    const item = NAV.find((n) => n.id === 'sitemap');
    if (!item || item.hidden === !on) return;
    item.hidden = !on;
    renderNav();
    if (on && location.hash.startsWith('#/sitemap')) onRoute();
  }

  async function probeSiteMap() {
    try {
      const { status, data } = await memberFetch('/api/members-me/site-map');
      if (status === 200 && data.enabled) {
        siteMap = data;
        const item = NAV.find((n) => n.id === 'sitemap');
        if (item) item.preview = !!data.preview;
        setSiteMapVisible(true);
      } else setSiteMapVisible(false);
    } catch {
      // The page works without it.
    }
  }

  // The directory, keyed by farm unit, for the faces in the hover popup (the photo each member chose to share there).
  // Loaded once and kept; if it cannot be loaded the popup shows initials instead.
  let mapDirectory: Map<string, DirHousehold> | null = null;
  let mapDirectoryLoad: Promise<void> | null = null;
  function loadMapDirectory(): Promise<void> {
    mapDirectoryLoad ??= memberFetch('/api/members-me/directory').then(({ status, data }) => {
      if (status === 200) mapDirectory = new Map((data.households as DirHousehold[]).map((x) => [x.farmUnit, x]));
    }).catch(() => { mapDirectoryLoad = null; });
    return mapDirectoryLoad;
  }

  function viewSiteMap(): HTMLElement {
    const root = h('div');
    root.append(h('h1', 'page-title', 'Map', h('small', '', 'Every home'), ...(siteMap?.preview ? [previewPill()] : [])), h('p', 'lede', 'Tap a home to see who it belongs to and what type it is.'));
    const data = siteMap;
    if (!data || !data.units.length) {
      root.append(h('p', 'lede', 'The site map is not available right now.'));
      return root;
    }
    const mine = data.units.find((u) => u.isYours) ?? null;
    let clusterId = mine?.cluster ?? data.clusters[0].id;
    let selected: MapUnit | null = mine;
    let vb: number[] = [];
    const clusterOf = (id: string) => data.clusters.find((c) => c.id === id) ?? data.clusters[0];
    const fit = () => { vb = [...clusterOf(clusterId).viewBox]; };
    fit();

    const seg = h('div', 'segmented');
    seg.setAttribute('role', 'group');
    seg.setAttribute('aria-label', 'Cluster');
    const segButtons = data.clusters.map((c) => {
      const b = h('button', '', c.id);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => { clusterId = c.id; fit(); paint(); });
      return b;
    });
    seg.append(...segButtons);

    const search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Find a home or member';
    search.autocomplete = 'off';
    search.setAttribute('aria-label', 'Find a home or member');
    const field = h('label', 'field', undefined, icon('<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>'), search);
    const bar = h('div', 'sm-bar', undefined, seg, field);
    if (mine) {
      const b = h('button', 'btn', 'Find my home');
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => focusOn(mine));
      bar.append(b);
    }
    const msg = h('p', 'sm-note');
    msg.setAttribute('aria-live', 'polite');

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('class', 'sm-map');
    svg.setAttribute('role', 'group');
    svg.setAttribute('aria-label', 'Site plan, one button per home');
    svg.innerHTML = `<defs>${shapeDefs()}</defs>`;
    const plotPath = document.createElementNS(SVG_NS, 'path');
    plotPath.setAttribute('class', 'sm-plot');
    const fillLayer = document.createElementNS(SVG_NS, 'g');
    const unitLayer = document.createElementNS(SVG_NS, 'g');
    // The outlines of all the homes, above every fill (the picked one last, so it is not covered).
    const outlineLayer = document.createElementNS(SVG_NS, 'g');
    // The house numbers sit above the homes, inside each home's plot, and never take a tap or a hover.
    const badgeLayer = document.createElementNS(SVG_NS, 'g');
    svg.append(fillLayer, plotPath, unitLayer, outlineLayer, badgeLayer);
    // What members already share with each other (the directory) gives the faces for the hover popup. It is fetched once,
    // in the background: the popup works without it (initials), and the map never waits for it.
    void loadMapDirectory();
    const pop = h('div', 'sm-pop');
    pop.id = 'sm-pop';
    pop.setAttribute('role', 'tooltip');
    pop.hidden = true;
    const zoomBtn = (label: string, text: string, fn: () => void) => {
      const b = h('button', 'btn', text);
      b.setAttribute('type', 'button');
      b.setAttribute('aria-label', label);
      b.addEventListener('click', fn);
      return b;
    };
    const stage = h('div', 'sm-stage', undefined, svg, pop, h('div', 'sm-zoom', undefined, zoomBtn('Zoom in', '+', () => zoomBy(1.4)), zoomBtn('Zoom out', '−', () => zoomBy(1 / 1.4)), zoomBtn('Show the whole cluster', 'Fit', () => { fit(); paint(); })));
    const card = h('section', 'sm-card');
    card.setAttribute('aria-live', 'polite');
    const keyItem = (cls: string, text: string) => h('li', '', undefined, h('span', `sm-sw ${cls}`), text);
    const key = h('ul', 'sm-key', undefined, ...(mine ? [keyItem('is-yours', 'Your home')] : []), keyItem('sm-named', 'A member'), keyItem('sm-private', 'A member who keeps their details private'), keyItem('sm-vacant', 'No member yet'));
    key.setAttribute('aria-label', 'Colours');
    root.append(bar, h('div', 'sm-grid', undefined, stage, h('div', 'sm-aside', undefined, card, key)), msg);

    const unitsPerPx = () => { const r = svg.getBoundingClientRect(); return Math.max(vb[2] / (r.width || 1), vb[3] / (r.height || 1)); };
    const toUser = (e: { clientX: number; clientY: number }) => {
      const r = svg.getBoundingClientRect();
      const k = Math.max(vb[2] / r.width, vb[3] / r.height);
      return [vb[0] + (e.clientX - r.left - (r.width - vb[2] / k) / 2) * k, vb[1] + (e.clientY - r.top - (r.height - vb[3] / k) / 2) * k];
    };

    const classesOf = (x: MapUnit) => `sm-${x.status}${x.isYours ? ' is-yours' : ''}${selected?.houseNo === x.houseNo ? ' is-sel' : ''}`;
    function unitEl(x: MapUnit, k: number): SVGElement {
      const who = x.status === 'named' ? x.names.join(' and ') : x.status === 'private' ? 'a private member' : 'no member yet';
      const g = unitGroup(x, k, classesOf(x), `Home ${x.houseNo}, ${who}, ${x.bhk}`);
      g.addEventListener('keydown', (e: Event) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); pick(x); }
      });
      return g;
    }

    function drawCard() {
      card.replaceChildren();
      const s = selected;
      if (!s) { card.append(h('p', 'sm-note', 'Tap a home on the map.')); return; }
      const owner = s.status === 'named' ? s.names.join(' & ') : s.status === 'private' ? 'Private member' : 'No member yet';
      card.append(h('h2', '', `Home ${s.houseNo}${s.isYours ? ' (yours)' : ''}`));
      const dl = h('dl', 'sm-kv');
      const row = (k: string, v: string) => dl.append(h('dt', '', k), h('dd', '', v));
      row(s.names.length > 1 ? 'Owners' : 'Owner', owner);
      row('Unit type', s.unitType ? `${s.bhk} · ${s.unitType}` : s.bhk);
      row('Cluster', s.cluster);
      card.append(dl);
      if (s.farmUnit) {
        const unit = s.farmUnit;
        const b = h('button', 'btn btn--solid', 'View profile');
        b.setAttribute('type', 'button');
        b.addEventListener('click', () => { location.hash = `#/directory?unit=${encodeURIComponent(unit)}`; });
        card.append(h('div', 'sm-actions', undefined, b));
      }
    }

    function paint() {
      segButtons.forEach((b, i) => b.setAttribute('aria-pressed', String(data!.clusters[i].id === clusterId)));
      const c = clusterOf(clusterId);
      svg.setAttribute('viewBox', vb.join(' '));
      plotPath.setAttribute('d', c.plot);
      const u = unitsPerPx();
      hidePop();
      const here = data!.units.filter((x) => x.cluster === clusterId);
      fillLayer.replaceChildren(...here.map((x) => plotFillEl(c.plot, x, classesOf(x))).filter((e): e is SVGPathElement => !!e));
      unitLayer.replaceChildren(...here.map((x) => unitEl(x, c.baseSize)));
      outlineLayer.replaceChildren(...[...here].sort((a, b) => Number(selected?.houseNo === a.houseNo) - Number(selected?.houseNo === b.houseNo)).map((x) => outlineEl(x, c.baseSize, classesOf(x))));
      badgeLayer.replaceChildren(...here.map((x) => badgeEl(c.plot, x, u, classesOf(x))).filter((e): e is SVGElement => !!e));
      drawCard();
    }
    function pick(x: MapUnit) {
      selected = x;
      if (x.cluster !== clusterId) { clusterId = x.cluster; fit(); }
      msg.textContent = '';
      paint();
    }
    function focusOn(x: MapUnit) {
      selected = x;
      clusterId = x.cluster;
      vb = [x.x - 110, x.y - 85, 220, 170];
      msg.textContent = '';
      paint();
    }
    function zoomBy(f: number, cx?: number, cy?: number) {
      const [x, y, w, ht] = vb;
      const nw = w / f;
      if (nw < 40 || nw > clusterOf(clusterId).viewBox[2] * 1.6) return;
      const qx = cx ?? x + w / 2;
      const qy = cy ?? y + ht / 2;
      vb = [qx - (qx - x) / f, qy - (qy - y) / f, nw, ht / f];
      paint();
    }

    search.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const q = search.value.trim().toLowerCase();
      if (!q) return;
      const num = q.replace(/^h-?/, '');
      const hit = data.units.find((u) => /^\d+$/.test(num) && Number(u.houseNo.slice(2)) === Number(num)) ?? data.units.find((u) => u.names.some((n) => n.toLowerCase().includes(q)));
      if (hit) focusOn(hit);
      else msg.textContent = `No home or member matches "${search.value.trim()}".`;
    });

    // Pan by dragging, zoom with the wheel or two fingers; a touch that does not move is a tap on a home.
    const ptrs = new Map<number, { x: number; y: number }>();
    let dragged = false;
    let tap: string | null = null;
    let pinch = 0;
    svg.addEventListener('wheel', (e) => { e.preventDefault(); const [ux, uy] = toUser(e); zoomBy(e.deltaY < 0 ? 1.15 : 1 / 1.15, ux, uy); }, { passive: false });
    svg.addEventListener('pointerdown', (e) => {
      svg.setPointerCapture(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 1) { dragged = false; tap = (e.target as Element).closest('.sm-unit')?.getAttribute('data-house') ?? null; } else { tap = null; pinch = 0; }
    });
    svg.addEventListener('pointermove', (e) => {
      const p = ptrs.get(e.pointerId);
      if (!p) return;
      if (ptrs.size === 2) {
        ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const [a, b] = [...ptrs.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) { const [ux, uy] = toUser({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }); zoomBy(d / pinch, ux, uy); }
        pinch = d;
        dragged = true;
        return;
      }
      const dx = e.clientX - p.x;
      const dy = e.clientY - p.y;
      if (!dragged && Math.hypot(dx, dy) < 4) return;
      dragged = true;
      const u = unitsPerPx();
      vb = [vb[0] - dx * u, vb[1] - dy * u, vb[2], vb[3]];
      p.x = e.clientX;
      p.y = e.clientY;
      svg.setAttribute('viewBox', vb.join(' '));
    });
    const release = (e: PointerEvent) => {
      ptrs.delete(e.pointerId);
      if (ptrs.size) return;
      if (!dragged && tap) { const x = data.units.find((u) => u.houseNo === tap); if (x) pick(x); }
      tap = null;
      pinch = 0;
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    // ---- Hover popup: who lives in a home, its number and its type, without opening anything ----
    // For a mouse or trackpad (a phone has no hover: a tap opens the card below the map, as before). It shows the first
    // names, the house number as a pill, the unit type, and a face for each member: the photo they chose to share in
    // the directory, or their initial. Nothing here is more than the card already shows (the same privacy rule), and
    // a Google profile picture is deliberately never used: those are only ever sent to the core team.
    const canHover = window.matchMedia('(hover: hover)');
    let popTimer: number | undefined;
    let popFor: string | null = null;
    const initialOf = (name: string) => first(name).slice(0, 1).toUpperCase();
    const joinFirst = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names[names.length - 1]}` : names[0] ?? '');

    function popFill(x: MapUnit) {
      const dir = x.farmUnit ? mapDirectory?.get(x.farmUnit) : undefined;
      // Faces: the directory's primary members (with their shared photo) when it has loaded, otherwise the names we have.
      const people: { name: string; photo?: string | null }[] = dir ? dir.people.filter((p) => p.primary !== false) : x.names.map((name) => ({ name }));
      const withPhoto = people.filter((p) => p.photo);
      const faces: { name: string; photo?: string | null }[] = [];
      for (const p of withPhoto.length ? withPhoto : people) if (!faces.some((f) => (p.photo ? f.photo === p.photo : f.name === p.name))) faces.push(p);
      const shownFaces = faces.slice(0, 3).map((p) => (p.photo ? photoImg(p.photo, 'sm-pop-face', 'square') : h('span', 'sm-pop-face sm-pop-initial', initialOf(p.name))));
      const title = x.status === 'named' ? joinFirst(x.names.map(first)) : x.status === 'private' ? 'Private member' : 'No member yet';
      pop.replaceChildren(
        ...(x.status === 'named' ? [h('span', 'sm-pop-faces', undefined, ...shownFaces)] : []),
        h('span', 'sm-pop-text', undefined,
          h('span', 'sm-pop-name', title),
          h('span', 'sm-pop-meta', undefined, h('span', 'sm-pop-code', x.houseNo), h('span', '', `${x.unitType ?? x.shape} · ${x.bhk}`))),
      );
    }
    function popPlace(clientX: number, clientY: number) {
      const r = stage.getBoundingClientRect();
      const w = pop.offsetWidth;
      const ht = pop.offsetHeight;
      let left = clientX - r.left + 16;
      let top = clientY - r.top + 16;
      if (left + w > r.width - 8) left = Math.max(8, clientX - r.left - w - 16);
      if (top + ht > r.height - 8) top = Math.max(8, clientY - r.top - ht - 16);
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
    }
    function hidePop() {
      window.clearTimeout(popTimer);
      popFor = null;
      pop.hidden = true;
      svg.querySelectorAll('[aria-describedby]').forEach((n) => n.removeAttribute('aria-describedby'));
    }
    function showPop(houseNo: string, clientX: number, clientY: number) {
      const x = data!.units.find((u) => u.houseNo === houseNo);
      if (!x) return;
      popFor = houseNo;
      popFill(x);
      pop.hidden = false;
      popPlace(clientX, clientY);
      svg.querySelector(`[data-house="${houseNo}"]`)?.setAttribute('aria-describedby', 'sm-pop');
    }
    const unitOf = (t: EventTarget | null) => (t as Element | null)?.closest?.('.sm-unit') ?? null;
    svg.addEventListener('pointerover', (e) => {
      if (!canHover.matches || ptrs.size || (e as PointerEvent).pointerType === 'touch') return;
      const g = unitOf(e.target);
      const house = g?.getAttribute('data-house');
      if (!house || house === popFor) return;
      window.clearTimeout(popTimer);
      const { clientX, clientY } = e as PointerEvent;
      popTimer = window.setTimeout(() => showPop(house, clientX, clientY), popFor ? 0 : 140);
    });
    svg.addEventListener('pointermove', (e) => { if (popFor && !pop.hidden) popPlace((e as PointerEvent).clientX, (e as PointerEvent).clientY); });
    svg.addEventListener('pointerout', (e) => {
      const to = unitOf((e as PointerEvent).relatedTarget);
      if (to && to.getAttribute('data-house') === popFor) return;
      window.clearTimeout(popTimer);
      if (!to) hidePop();
    });
    svg.addEventListener('pointerleave', hidePop);
    svg.addEventListener('pointerdown', hidePop);
    svg.addEventListener('wheel', hidePop, { passive: true });
    // Keyboard: focusing a home shows the same popup beside it.
    svg.addEventListener('focusin', (e) => {
      const g = unitOf(e.target);
      if (!g || !(e.target as Element).matches(':focus-visible')) return;
      const r = g.getBoundingClientRect();
      showPop(g.getAttribute('data-house')!, r.left + r.width / 2, r.top + r.height / 2);
    });
    svg.addEventListener('focusout', hidePop);

    // The plan is measured once it is on the page, so the house numbers are sized for the real width.
    requestAnimationFrame(paint);
    paint();
    return root;
  }

  function viewDirectory(): HTMLElement {
    const root = h('div');
    const body = h('div');
    root.append(
      h('h1', 'page-title', 'Directory', h('small', '', 'The collective')),
      h('p', 'lede', 'Names, farm plots and the story each member chose to share. Contact details are never shown.'),
      body,
    );
    // Cards the size of the real ones, so the page does not jump when the list arrives.
    body.append(h('p', 'sr-only', 'Loading the directory…'), h('div', 'dir-skel', undefined, h('span'), h('span'), h('span')));

    let list: DirHousehold[] = [];
    let query = '';
    let onlyStories = false;
    let cluster: string | null = null;
    let unitType: string | null = null;

    const search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Search by name, farm plot or house';
    search.autocomplete = 'off';
    search.setAttribute('aria-label', 'Search the directory');
    search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); draw(); });
    // A search field in the admin portal's style: magnifier, then the input, on a quiet fill.
    const searchField = h('label', 'field', undefined, icon('<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>'), search);
    // One choice of two, always visible, instead of a checkbox.
    const onlySeg = h('div', 'segmented');
    onlySeg.setAttribute('role', 'group');
    onlySeg.setAttribute('aria-label', 'Show');
    const onlyButtons = [[false, 'All'], [true, 'With a story']].map(([v, text]) => {
      const b = h('button', '', text as string);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => { onlyStories = v as boolean; paintOnly(); draw(); });
      return b;
    });
    onlySeg.append(...onlyButtons);
    function paintOnly() {
      onlyButtons.forEach((b, i) => b.setAttribute('aria-pressed', String((i === 1) === onlyStories)));
    }
    paintOnly();

    // List (one line per unit, to scan and find) or Cards (big faces and a few lines of each story, to browse).
    // The choice is remembered on this device; storage can be blocked, so it is only a convenience.
    const VIEW_KEY = 'tvc-member-directory-view';
    let mode: 'list' | 'cards' = 'list';
    try {
      if (localStorage.getItem(VIEW_KEY) === 'cards') mode = 'cards';
    } catch { /* blocked: the list */ }
    const viewSeg = h('div', 'segmented dir-view');
    viewSeg.setAttribute('role', 'group');
    viewSeg.setAttribute('aria-label', 'Layout');
    const viewButtons = [['list', 'List'], ['cards', 'Cards']].map(([v, text]) => {
      const b = h('button', '', text);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => {
        mode = v as 'list' | 'cards';
        try { localStorage.setItem(VIEW_KEY, mode); } catch { /* not remembered */ }
        paintView();
        draw();
      });
      return b;
    });
    viewSeg.append(...viewButtons);
    function paintView() {
      viewButtons.forEach((b, i) => b.setAttribute('aria-pressed', String((i === 1) === (mode === 'cards'))));
    }
    paintView();

    const snippet = (t: string) => { const p = toPlain(t); return p.length > 120 ? `${p.slice(0, 117).trimEnd()}…` : p; };

    // A round photo when the person has one, otherwise their initial. Photos are 400x400 squares.
    // size: '' (card), 'lg' or 'xl' (the popup's header).
    function face(p: { name: string; photo?: string | null }, size = ''): HTMLElement {
      const sz = size ? ` dir-photo--${size}` : '';
      if (p.photo) return photoImg(p.photo, `dir-photo${sz}`, 'square');
      return h('span', `avatar dir-initial${size ? ` dir-initial--${size}` : ''}`, first(p.name).slice(0, 1).toUpperCase());
    }

    // People who share one photo (a couple's joint picture) are shown once.
    const distinctFaces = (people: { name: string; photo?: string | null }[]) => {
      const seen = new Set<string>();
      return people.filter((p) => {
        const key = p.photo || `name:${p.name}`;
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    };

    // One face for a single member, two overlapping for a couple, and "+N" beyond that.
    function faces(people: { name: string; photo?: string | null }[], size = '', limit = 2): HTMLElement {
      // In a unit the photos belong to the unit: one photo for two owners shows one picture, not a picture and a stray initial.
      const all = distinctFaces(facesToShow(people));
      const shown = all.slice(0, limit).map((p) => face(p, size));
      const extra = all.length - shown.length;
      return h('span', `dir-faces dir-faces--${Math.min(shown.length, 2)}`, undefined, ...shown, extra > 0 ? h('span', 'dir-more', `+${extra}`) : null);
    }

    // "Bo", "Bo & Cy", "Ishan, Kavya & Leela"
    const joinNames = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names[names.length - 1]}` : names[0] ?? '');

    // Farm plot in green; house and cluster in blue, because they belong to the housing, not the farm.
    // The card shows farm and house only, as a footer (the cluster and unit type are filters above, and are in the popup).
    function pills(hh: DirHousehold, withCluster = true): HTMLElement {
      const code = baseUnitType(hh.unitType);
      const beds = bedroomsOf(hh.unitType);
      const pill = (cls: string, text: string, title: string) => {
        const el = h('span', `dir-pill dir-pill--${cls}`, text);
        el.title = title;
        return el;
      };
      // On a card, one quiet pill ("F-12 · H-12"); the popup lists plot, house, cluster and type separately.
      if (!withCluster) return h('span', 'dir-pills', undefined, pill('farm', hh.houseNo ? `${hh.farmUnit} · ${hh.houseNo}` : hh.farmUnit, hh.houseNo ? 'Farm plot and house' : 'Farm plot'));
      return h('span', 'dir-pills', undefined,
        pill('farm', hh.farmUnit, 'Farm plot'),
        hh.houseNo ? pill('house', hh.houseNo, 'House') : null,
        withCluster && hh.cluster ? pill('house', `Cluster ${hh.cluster}`, 'Housing cluster') : null,
        withCluster && code ? pill('house', beds ? `${beds} · ${code}` : code, 'Unit type') : null);
    }

    // Your own unit's story state, read once so the card can show where it stands (the directory itself only
    // lists approved stories). null until it loads, or if it cannot be read: the card then just says "Edit story".
    let mine: { written: boolean; text: string; label: string; tone: 'draft' | 'review' | 'changes' | 'live' } | null = null;
    function describeMine(st: { status: string | null; hasUnsubmittedChanges: boolean; draft: { bio: string; family: string; quote: string } }) {
      const written = !!(st.draft.bio.trim() || st.draft.family.trim() || st.draft.quote.trim());
      const text = st.draft.bio.trim() || (st.draft.quote.trim() ? `“${st.draft.quote.trim()}”` : '');
      if (st.status === 'in_review') return { written, text, label: st.hasUnsubmittedChanges ? 'In review (newer changes not submitted)' : 'In review with the core team', tone: 'review' as const };
      if (st.status === 'rejected') return { written, text, label: 'Changes needed', tone: 'changes' as const };
      if (st.status === 'approved') return { written, text, label: st.hasUnsubmittedChanges ? 'Approved (newer changes not submitted)' : 'Approved', tone: 'live' as const };
      return { written, text, label: 'Draft, not submitted yet', tone: 'draft' as const };
    }

    // What both views show for a unit: the owners' first names, the story's first line, and whether the unit is yours.
    // (The popup has everyone, and search still matches full names.) No story means no line at all, so a unit
    // without one is quiet rather than repeating "no story yet".
    function unitInfo(hh: DirHousehold) {
      const primary = hh.people.filter((p) => p.primary !== false);
      const withStory = primary.find((p) => p.story?.bio) ?? primary.find((p) => p.story) ?? hh.people.find((p) => p.story?.bio) ?? hh.people.find((p) => p.story);
      const isYours = hh.people.some((p) => p.isYou);
      const names = joinNames(primary.map((p) => (p.isYou ? `${first(p.name)} (you)` : first(p.name))));
      const storyLine = withStory?.story?.bio ? snippet(withStory.story.bio) : withStory?.story?.why ? `“${snippet(withStory.story.why)}”` : isYours && mine?.text ? snippet(mine.text) : isYours ? 'You have not shared a story yet' : '';
      return { primary, isYours, own: isYours && !isFamily(), names, storyLine };
    }

    // Your own unit carries where its story stands, in words, and the way into the editor. The story is the
    // unit's, so anyone in the unit sees it on the unit's row or card.
    const STATE_WORD = { draft: 'Draft', review: 'In review', changes: 'Changes needed', live: 'Approved' };
    function storyState(): HTMLElement | null {
      if (!mine || !mine.written) return null;
      const state = h('span', `dir-state dir-state--${mine.tone}`, STATE_WORD[mine.tone]);
      state.title = mine.label;
      return state;
    }
    function ownTools(primaryCount: number, cls: string, withState = true): HTMLElement {
      const label = mine && !mine.written ? 'Write your story' : primaryCount > 1 ? 'Edit your unit\'s story (shared)' : 'Edit your story';
      const edit = h('button', 'dir-edit', undefined, icon(IC.pen));
      edit.setAttribute('type', 'button');
      edit.setAttribute('aria-label', label);
      edit.title = label;
      edit.setAttribute('data-tour', 'edit-story');
      edit.addEventListener('click', () => (location.hash = '#/story'));
      return h('span', cls, undefined, withState ? storyState() : null, edit);
    }

    // List view: one unit as a row in the grouped list (the admin portal's .list and .row): faces, the owners'
    // first names with the story's first line under them, the farm and house code, and a chevron.
    function unitRow(hh: DirHousehold): HTMLElement {
      const { primary, own, names, storyLine } = unitInfo(hh);
      const chev = icon('<path d="M9 6l6 6-6 6"/>');
      chev.setAttribute('class', 'chev');
      const b = h('button', 'row dir-row', undefined,
        faces(primary),
        h('span', 'grow', undefined, h('span', 'title', names), storyLine ? h('span', 'detail', storyLine) : null),
        pills(hh, false),
        own ? null : chev);
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => openProfile(hh, b));
      if (!own) return h('li', '', undefined, b);
      return h('li', 'dir-own', undefined, b, ownTools(primary.length, 'dir-own-tools'));
    }

    // Cards view: the picture on the left, vertically centred against the text; the names, the story's first
    // lines and the farm and house code are in a column beside it.
    function unitCard(hh: DirHousehold): HTMLElement {
      const { primary, isYours, own, names, storyLine } = unitInfo(hh);
      const b = h('button', `dir-card${isYours ? ' dir-card--you' : ''}`, undefined,
        h('span', 'dir-card-photo', undefined, faces(primary, 'card')),
        h('span', 'dir-card-body', undefined,
          h('span', 'dir-card-names', names),
          storyLine ? h('span', 'dir-card-text', storyLine) : null,
          h('span', 'dir-card-foot', undefined, own ? storyState() : null, pills(hh, false))));
      b.setAttribute('type', 'button');
      b.addEventListener('click', () => openProfile(hh, b));
      if (!own) return b;
      return h('div', 'dir-cell', undefined, b, ownTools(primary.length, 'dir-card-tools', false));
    }

    // The household's profile in a native dialog, laid out like the card on the public Members page: the
    // photo, the primary members' names, their story (first names in bold), the family in its own section
    // with an icon, and the quote. The list underneath keeps its scroll position and search; Esc and a
    // click outside close it, and focus returns to the card that opened it.
    const FAMILY_ICON = '<circle cx="9" cy="8" r="3"/><path d="M3.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5"/><circle cx="17" cy="9" r="2.3"/><path d="M16.2 14.4c2.8.2 4.8 2 4.8 5.1"/>';
    function openProfile(hh: DirHousehold, from?: HTMLElement) {
      const dlg = document.createElement('dialog');
      dlg.className = 'modal dir-modal';
      dlg.setAttribute('aria-label', joinNames(hh.people.filter((p) => p.primary !== false).map((p) => p.name)));
      const close = h('button', 'dir-close', undefined, icon('<path d="M6 6l12 12M18 6L6 18"/>'));
      close.setAttribute('type', 'button');
      close.setAttribute('aria-label', 'Close');
      close.addEventListener('click', () => dlg.close());
      const label = (p: { name: string; isYou: boolean }) => (p.isYou ? `${p.name} (you)` : p.name);

      // The first names of everyone in the household are set in bold wherever the text mentions them.
      const firsts = [...new Set(hh.people.map((p) => first(p.name)))].sort((a, b) => b.length - a.length);
      const bold = new RegExp(`\\b(${firsts.map((n) => n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})\\b`);
      // A first name that has a profile link becomes that link (green and clickable, as on the public card);
      // a name without one is just bold. There is no separate row of links.
      const urlByFirst = new Map<string, string>();
      for (const g of hh.groups) for (const l of g.links) if (/^https?:\/\//i.test(l.url) && !urlByFirst.has(first(l.name))) urlByFirst.set(first(l.name), l.url);
      const nameNode = (part: string): Node => {
        const url = urlByFirst.get(part);
        if (!url) return h('strong', 'dir-name', part);
        const a = h('a', 'dir-name dir-name--link', part);
        a.setAttribute('href', url);
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer nofollow');
        a.title = 'Open their profile';
        return a;
      };
      // The text may carry the member's own bold, italic and links; names are set in bold inside the plain pieces
      // (a name inside a written link stays plain, so links never nest).
      const withNames = (t: string, inLink: boolean): Node[] => (firsts.length && !inLink ? t.split(bold).map((part, i) => (i % 2 ? nameNode(part) : document.createTextNode(part))) : [document.createTextNode(t)]);
      const emphasise = (text: string): Node[] => mdNodes(text, withNames);

      const familyRow = (...kids: Kid[]) => h('div', 'dir-famrow', undefined, icon(FAMILY_ICON), h('div', '', undefined, ...kids));

      // One section per shared story (identical bio and family are shown once), with each person's own
      // quote and link under it. Quotes are captioned by first name only when they differ.
      const sections = hh.groups.map((g) => {
        const stack = h('div', 'dir-hero', undefined, faces(g.people.map((gp) => hh.people.find((x) => x.name === gp.name) ?? { name: gp.name, photo: null }), 'xl', 3));
        const bio = g.bio ? h('p', 'dir-bio', undefined, ...emphasise(g.bio)) : null;
        return h('section', 'dir-person', undefined,
          stack,
          h('h3', '', joinNames(g.people.map(label))),
          bio,
          g.family ? familyRow(h('p', 'dir-family', undefined, ...emphasise(g.family))) : null,
          ...g.quotes.map((q) => h('blockquote', 'dir-why', q.why, q.name ? h('cite', 'dir-cite', ` — ${first(q.name)}`) : null)),
          h('p', 'dir-vis', g.onPublicSite ? 'Also on the public Members page' : 'Visible to members only'));
      });
      if (hh.withoutStory.length) {
        const who = hh.withoutStory.map(label);
        sections.push(h('section', 'dir-person', undefined, h('p', 'lede', `${joinNames(who)} ${who.length > 1 ? 'have' : 'has'} not shared a story yet.`)));
      }
      // The rest of the household (children, other family) in a section of their own, not a block each.
      if (hh.familyMembers.length) sections.push(h('section', 'dir-person dir-household', undefined, familyRow(h('p', 'dir-family', `Also in this unit: ${joinNames(hh.familyMembers.map(label))}`))));
      dlg.append(close, pills(hh), ...sections);
      dlg.addEventListener('close', () => dlg.remove());
      presentSheet(dlg, { from });
    }

    // Filters: housing cluster (fixed order) and bedrooms (1, 2 and 3 BHK), one of each at a time, with no counts on
    // the chips. All the variants of a unit type are one bedroom count (DG1 and DF1-V2 are both 2 BHK). A household
    // with no house yet has no cluster, and one with no unit type yet is under no bedroom chip. A code that isn't
    // S, D or T has no bedroom count, so it keeps a chip of its own (its code) rather than vanishing from the filter.
    const kindOf = (t: string | null) => bedroomsOf(t) ?? baseUnitType(t);
    function filterChips(): HTMLElement {
      const row = (label: string, selected: string | null, set: (v: string | null) => void, values: string[]) => {
        const group = h('div', 'segmented');
        group.setAttribute('role', 'group');
        group.setAttribute('aria-label', label);
        for (const [value, text] of [[null, 'All'], ...values.map((v) => [v, v])] as [string | null, string][]) {
          const b = h('button', '', text);
          b.setAttribute('type', 'button');
          b.setAttribute('aria-pressed', String(selected === value));
          b.addEventListener('click', () => { set(value); draw(); });
          group.append(b);
        }
        return h('div', 'dir-filter', undefined, h('span', 'dir-filter-label', label), group);
      };
      const kinds = [...new Set(list.map((x) => kindOf(x.unitType)).filter((t): t is string => !!t))].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
      return h('div', 'dir-filters', undefined,
        row('Cluster', cluster, (v) => { cluster = v; }, ['H1-A', 'H1-B', 'H2']),
        kinds.length ? row('Bedrooms', unitType, (v) => { unitType = v; }, kinds) : null);
    }

    const chipsHost = h('div');
    // On a phone Cluster and Bedrooms sit behind one Filters button (with how many are on); wide screens show them.
    const moreSummary = h('summary', '', 'Filters');
    const more = h('details', 'dir-filters-toggle', undefined, moreSummary, chipsHost) as HTMLDetailsElement;
    more.open = !window.matchMedia('(max-width: 560px)').matches;
    const bar = h('div', 'dir-toolbar', undefined, searchField, onlySeg, viewSeg);
    const count = h('p', 'dir-count');
    const foot = h('p', 'dir-foot', 'Prefer not to be listed? Turn it off under Your details in the account menu.');
    const results = h('div');
    let built = false;

    function draw() {
      const shown = list.filter((hh) => (!onlyStories || hh.hasStory) && (!cluster || hh.cluster === cluster) && (!unitType || kindOf(hh.unitType) === unitType) && (!query || [hh.farmUnit, hh.houseNo ?? '', hh.cluster ?? '', ...hh.people.map((p) => p.name)].join(' ').toLowerCase().includes(query)));
      // The member's own household first (the sort is stable, so everyone else stays in house-number order).
      shown.sort((a, b) => Number(b.people.some((p) => p.isYou)) - Number(a.people.some((p) => p.isYou)));
      // The search box and the checkbox are built once and never re-created: replacing them on every keystroke
      // would take the cursor out of the box after each character. Only the chips, the count and the results are redrawn.
      if (!built) {
        body.replaceChildren(bar, more, count, results, foot);
        built = true;
      }
      chipsHost.replaceChildren(filterChips());
      const active = (cluster ? 1 : 0) + (unitType ? 1 : 0);
      moreSummary.textContent = active ? `Filters · ${active} on` : 'Filters';
      count.textContent = `${shown.length} of ${list.length} households`;
      const clear = h('button', 'btn', 'Clear search and filters');
      clear.setAttribute('type', 'button');
      clear.addEventListener('click', () => {
        query = '';
        search.value = '';
        onlyStories = false;
        cluster = null;
        unitType = null;
        paintOnly();
        draw();
      });
      const isMine = (x: DirHousehold) => x.people.some((p) => p.isYou);
      const mineHh = shown.filter(isMine);
      const rest = shown.filter((x) => !isMine(x));
      const listOf = (hs: DirHousehold[]) => (mode === 'cards' ? h('div', 'dir-grid', undefined, ...hs.map(unitCard)) : h('ul', 'list', undefined, ...hs.map(unitRow)));
      results.replaceChildren(shown.length
        ? h('div', '', undefined,
            mineHh.length ? h('h2', 'group-head', 'Your unit') : null,
            mineHh.length ? listOf(mineHh) : null,
            rest.length && mineHh.length ? h('h2', 'group-head', 'Everyone') : null,
            rest.length ? listOf(rest) : null)
        : h('div', 'dir-empty', undefined, h('p', 'lede', 'No one matches that.'), clear));
    }

    void (async () => {
      try {
        const { status, data } = await memberFetch('/api/members-me/directory');
        if (status !== 200) throw new Error(data.error || 'Could not load the directory.');
        list = data.households as DirHousehold[];
        draw();
        // Arriving from the Map's "View profile" (#/directory?unit=F-12): open that household's profile.
        const wanted = routeQuery.get('unit');
        const target = wanted ? list.find((x) => x.farmUnit === wanted) : null;
        if (target) {
          openProfile(target);
          routeQuery = new URLSearchParams();
          history.replaceState(null, '', '#/directory'); // so it does not open again on the next draw
        }
        void memberFetch('/api/members-me/unit-story').then(({ status: st, data: d }) => {
          if (st !== 200 || !d.story) return;
          mine = describeMine(d.story);
          if (built) draw();
        }, () => {});
      } catch (e) {
        const retry = h('button', 'btn', 'Try again');
        retry.setAttribute('type', 'button');
        retry.addEventListener('click', renderView);
        body.replaceChildren(h('p', 'lede', e instanceof MemberAuthError ? 'Your session ended. Sign in again.' : e instanceof Error ? e.message : 'Could not load the directory.'), ...(e instanceof MemberAuthError ? [] : [retry]));
      }
    })();
    return root;
  }

  function viewSoon(id: string): HTMLElement {
    const item = NAV.find((n) => n.id === id)!;
    return h('div', '', undefined,
      h('h1', 'page-title', item.label, h('small', '', 'Coming soon')),
      h('section', 'panel', undefined, h('h2', '', 'Planned'), h('ul', 'soon-list', undefined, ...(PLANNED[id] ?? []).map((t) => h('li', '', t)))),
    );
  }

  // A new page eases in over ~150ms instead of snapping. Cancelling the last one first keeps it interruptible; a
  // reduced-motion reader gets the swap as it was.
  const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let shownRoute = '';
  let fade: Animation | null = null;
  function fadeInView() {
    fade?.cancel();
    fade = noMotion.matches ? null : $('view').animate([{ opacity: 0 }, { opacity: 1 }], { duration: 150, easing: 'ease-out' });
  }

  function renderView() {
    const prevNext = $('view').querySelector('.next h2')?.textContent;
    const fn = route === 'dashboard' ? viewDashboard : route === 'unit' ? viewUnit : route === 'story' ? viewStory : route === 'rental' ? viewRental : route === 'directory' ? viewDirectory : route === 'sitemap' ? viewSiteMap : () => viewSoon(route);
    $('view').replaceChildren(fn());
    if (shownRoute && shownRoute !== route) fadeInView();
    shownRoute = route;
    // Same page, new next step (the member just added their number): cross-fade instead of swapping.
    const card = $('view').querySelector('.next');
    if (card && prevNext && prevNext !== card.querySelector('h2')?.textContent) card.classList.add('next--swap');
    renderNav();
    const label = NAV.find((n) => n.id === route)?.label ?? 'Home';
    document.title = `${label} · Member Portal · Tamarind Valley Collective`;
    setMenu(false);
  }

  // After the member moves to another page, put keyboard and screen-reader focus on its heading so the
  // new page is announced, instead of leaving focus on a link that has just been replaced.
  function focusView() {
    const heading = $('view').querySelector('h1');
    if (!(heading instanceof HTMLElement)) return;
    heading.tabIndex = -1;
    heading.focus({ preventScroll: true });
  }

  function onRoute() {
    const [id, query = ''] = (location.hash.replace(/^#\//, '') || 'dashboard').split('?');
    routeQuery = new URLSearchParams(query);
    route = NAV.some((n) => n.id === id) ? id : 'dashboard';
    if (route === 'sitemap' && NAV.find((n) => n.id === 'sitemap')?.hidden) route = 'dashboard'; // not switched on for this household
    if (route === 'story' && me && isFamily()) route = 'directory'; // the story is the owners' to edit
    if (route === 'rental' && NAV.find((n) => n.id === 'rental')?.hidden) route = 'dashboard'; // not switched on, or not an owner
    if (me) renderView();
  }

  // ---- sign-in and loading ----
  function showGate(message?: string) {
    me = null;
    $('shell').hidden = true;
    $('gate').hidden = false;
    const err = $('gate-error');
    err.hidden = !message;
    if (message) err.textContent = message;
    renderSignInButton();
  }

  // The page is blank until /home answers, so say so; and if it cannot be reached, say that (with a
  // way to try again) rather than sending a signed-in member back to the sign-in card as if logged out.
  function showBoot(message: string, retry = false) {
    $('gate').hidden = true;
    $('shell').hidden = true;
    $('boot').hidden = false;
    $('boot-msg').textContent = message;
    $('boot-retry').hidden = !retry;
    $('boot-skel').hidden = retry; // a failure is not a page on its way
  }

  function loadFailed() {
    if (me) return toast('Could not refresh just now. Check your connection and try again.');
    showBoot('We could not reach the member portal. Check your connection, then try again.', true);
  }

  // Draws the portal from a /home answer: the fresh one, or (fromCache) the last one this browser kept for this member.
  function showHome(data: { me: Me; households: any[] }, fromCache = false) {
    me = data.me;
    all = data.households;
    current = Math.min(current, all.length - 1);
    $('boot').hidden = true;
    $('gate').hidden = true;
    $('shell').hidden = false;
    renderWho();
    onRoute();
    if (!fromCache) afterFreshHome(); // from the cache, the real answer is on its way and does this once it arrives
  }

  function afterFreshHome() {
    void probeRental();
    void probeSiteMap();
    // A brand new member is walked through everything once, after the privacy notice (which came first above).
    if (!tourAutoStarted && me!.tourSeenThrough === null) {
      tourAutoStarted = true;
      startTour(tourPending(), true);
    }
  }

  async function load(quiet = false) {
    // A returning member sees their portal at once, from what this browser kept, while the real answer is fetched. That
    // answer is checked by the server as always: it replaces what was drawn, or a refusal takes it away again.
    const cached = me ? null : readHomeCache(getMemberToken());
    let shownFromCache = false;
    if (cached) {
      showHome(cached, true);
      shownFromCache = true;
    } else if (!me) {
      showBoot('Opening the member portal…');
    }
    try {
      const { status, data } = await memberFetch('/api/members-me/home');
      $('boot').hidden = true;
      if (status === 403) {
        clearHomeCache();
        return showGate(data.error || 'This account has not been invited to the member portal yet.');
      }
      if (status !== 200) {
        if (shownFromCache) return; // what is drawn is fine for now; saying "could not refresh" would only alarm
        return loadFailed();
      }
      if (data.privacyNoticeRequired) {
        // First sign-in (or a changed notice): read it before anything else is shown.
        clearHomeCache();
        me = null;
        $('gate').hidden = true;
        $('shell').hidden = true;
        noticeDialog(true);
        return;
      }
      writeHomeCache(getMemberToken(), data);
      // Drawn from the cache and nothing changed: leave the page alone (a re-render could undo what they have started doing).
      if (shownFromCache && JSON.stringify(data.me) === JSON.stringify(cached!.me) && JSON.stringify(data.households) === JSON.stringify(cached!.households)) {
        afterFreshHome();
        return;
      }
      showHome(data);
    } catch (err) {
      $('boot').hidden = true;
      if (err instanceof MemberAuthError) return showGate(quiet || shownFromCache ? 'Your session ended. Sign in again.' : undefined);
      if (shownFromCache) return;
      loadFailed();
    }
  }

  function handleCredentialResponse(response: { credential: string }) {
    setMemberToken(response.credential);
    load();
  }

  // Google's own button is white by default, a bright slab on the dark card, so in the dark appearance it is drawn dark.
  const deviceDark = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (currentTheme() ? currentTheme() === 'dark' : deviceDark.matches);
  function renderSignInButton() {
    if (typeof google === 'undefined') return;
    google.accounts.id.initialize({ client_id: CLIENT_ID, callback: handleCredentialResponse });
    $('g_id_signin').replaceChildren();
    google.accounts.id.renderButton($('g_id_signin'), { theme: isDark() ? 'filled_black' : 'outline', size: 'large' });
  }
  deviceDark.addEventListener('change', () => { if (!$('gate').hidden) renderSignInButton(); });

  function signOut() {
    clearMemberToken();
    clearHomeCache();
    if (typeof google !== 'undefined') google.accounts.id.disableAutoSelect();
    $('who-menu').hidden = true;
    setMenu(false);
    showGate();
  }

  // ---- wiring ----
  const phoneWidth = window.matchMedia('(max-width: 900px)');
  const shell = $('shell');

  // On a phone the menu is a drawer. Closed, it must also be out of the tab order (inert), and it
  // closes on Escape, on a tap outside it, and after choosing a page.
  function setMenu(open: boolean, returnFocus = false) {
    const opening = open && phoneWidth.matches;
    shell.classList.toggle('open', opening);
    $('menu').setAttribute('aria-expanded', String(opening));
    ($('side') as HTMLElement).inert = phoneWidth.matches && !opening;
    if (opening) $('nav').querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) $('menu').focus();
  }
  phoneWidth.addEventListener('change', () => setMenu(false));
  setMenu(false);

  let whoTimer: number | undefined;
  const whoOpen = () => !$('who-menu').hidden && !$('who-menu').classList.contains('out');
  function setWhoMenu(open: boolean, returnFocus = false) {
    const m = $('who-menu');
    clearTimeout(whoTimer);
    m.classList.remove('out');
    if (open) m.hidden = false;
    else if (!m.hidden) {
      m.classList.add('out'); // leaves faster than it arrived
      whoTimer = window.setTimeout(() => {
        m.hidden = true;
        m.classList.remove('out');
      }, 100);
    }
    $('who').setAttribute('aria-expanded', String(open));
    if (open) m.querySelector<HTMLElement>('button, a')?.focus();
    else if (returnFocus) $('who').focus();
  }

  // The desktop menu stays as the member left it. (Storage can be blocked, so it is only a convenience.)
  const COLLAPSED_KEY = 'tvc-member-menu-collapsed';
  try {
    if (localStorage.getItem(COLLAPSED_KEY) === '1') shell.classList.add('collapsed');
  } catch { /* blocked: start expanded */ }
  $('collapse').addEventListener('click', () => {
    shell.classList.toggle('collapsed');
    try {
      localStorage.setItem(COLLAPSED_KEY, shell.classList.contains('collapsed') ? '1' : '0');
    } catch { /* blocked */ }
  });

  // The bar's bottom hairline shows only once something has scrolled under it.
  const bar = document.querySelector('.topbar')!;
  window.addEventListener('scroll', () => bar.classList.toggle('scrolled', window.scrollY > 4), { passive: true });

  // Swipe the open drawer shut. It follows the finger 1:1 once the movement is clearly sideways, then
  // closes if the flick's projected landing point is past halfway, otherwise springs back. (CSS takes over
  // from the finger's position, so it is a transition rather than a velocity-carrying spring.)
  const side = $('side');
  let swipe: { id: number; x: number; y: number; t: number; dx: number; v: number; live: boolean } | null = null;
  side.addEventListener('pointerdown', (e) => {
    if (!shell.classList.contains('open') || e.pointerType === 'mouse') return;
    swipe = { id: e.pointerId, x: e.clientX, y: e.clientY, t: e.timeStamp, dx: 0, v: 0, live: false };
  });
  side.addEventListener('pointermove', (e) => {
    if (!swipe || e.pointerId !== swipe.id) return;
    const dx = e.clientX - swipe.x;
    if (!swipe.live) {
      // ~10px of hysteresis, and only a mostly-horizontal move counts, so scrolling the menu still works
      if (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(e.clientY - swipe.y)) return;
      swipe.live = true;
      side.setPointerCapture(e.pointerId);
      side.style.transition = 'none';
      $('scrim').style.transition = 'none';
    }
    const dt = Math.max(1, e.timeStamp - swipe.t);
    swipe.v = (dx - swipe.dx) / dt; // px per ms, from the last movement
    swipe.dx = dx;
    swipe.t = e.timeStamp;
    const width = side.offsetWidth;
    side.style.transform = `translateX(${Math.min(0, dx)}px)`;
    $('scrim').style.opacity = String(Math.max(0, 1 + Math.min(0, dx) / width));
  });
  let swallowClick = false;
  side.addEventListener('click', (e) => {
    if (swallowClick) e.stopPropagation(); // the tap that ended a swipe must not also follow the link under the finger
  }, { capture: true });
  const endSwipe = (e: PointerEvent) => {
    if (!swipe || e.pointerId !== swipe.id) return;
    const { live, dx, v } = swipe;
    swipe = null;
    if (!live) return;
    swallowClick = true;
    window.setTimeout(() => (swallowClick = false), 50);
    // Where the flick would come to rest: the release velocity projected with the scroll-deceleration formula
    // (v px/ms is 1000v px/s; project(v) = v/1000 * d / (1 - d), d = 0.998).
    const projected = dx + v * (0.998 / (1 - 0.998));
    side.style.transition = '';
    side.style.transform = '';
    $('scrim').style.transition = '';
    $('scrim').style.opacity = '';
    if (projected < -side.offsetWidth / 2) setMenu(false, true); // otherwise it just springs back open
  };
  side.addEventListener('pointerup', endSwipe);
  side.addEventListener('pointercancel', endSwipe);
  $('menu').addEventListener('click', () => setMenu(!shell.classList.contains('open')));
  $('scrim').addEventListener('click', () => setMenu(false, true));
  $('boot-retry').addEventListener('click', () => void load());
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (whoOpen()) setWhoMenu(false, true);
    else if (shell.classList.contains('open')) setMenu(false, true);
  });
  document.addEventListener('click', (e) => {
    if (whoOpen() && !(e.target as Element).closest('.who-wrap')) setWhoMenu(false);
  });
  $('who').addEventListener('click', () => setWhoMenu(!whoOpen()));
  window.addEventListener('hashchange', () => {
    onRoute();
    if (me) focusView();
  });
  window.addEventListener('offline', () => toast('You are offline. Anything you save will not go through until you are back online.'));

  renderNav();
  if (getMemberToken()) void load();
  else showGate();
</script>
