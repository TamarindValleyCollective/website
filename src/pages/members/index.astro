  async function openLandDoc(documentId: string) {
    const tab = window.open('', '_blank');
    try {
      const { status, data } = await memberFetch('/api/members-me/land-document-link', { method: 'POST', body: { documentId } });
      if (status !== 200 || !data.url) throw new Error(data.error || 'Could not open the file.');
      if (tab) {
        tab.opener = null;
        tab.location.href = data.url;
      } else window.location.href = data.url;
