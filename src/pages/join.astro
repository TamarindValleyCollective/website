---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { FARM_AREA_ACRES } from '../data/site-facts';
---

<BaseLayout title="Join the Collective" description="How membership at Tamarind Valley Collective actually works — community size, private transactions between members, and what matters to us in a new member." image="https://tvc.farm/images/journey/journey-43.jpg" imageWidth={1400} imageHeight={787}>
  <PageHero
    eyebrow="Membership"
    title="Joining the Collective"
    intro="TVC is unlikely to expand beyond its current 53 families — but a spot occasionally opens. Here's how that actually works, and what matters to us."
    image="https://tvc.farm/images/journey/journey-43.jpg"
    imageAlt="A large group of TVC members gathered together indoors"
  />

  <section class="section wrapper prose">
    <h2>We're unlikely to expand</h2>
    <p>TVC is <a href="/people#members">53 families</a> on {FARM_AREA_ACRES} acres — that's likely close to as large as this community will ever get. We are unlikely to expand membership, and there's no waitlist or application process in the usual sense.</p>

    <h2>How a spot occasionally opens</h2>
    <p>From time to time, for personal reasons, a member family decides to move on. When that happens, it isn't the collective selling a spot — it's a private transaction directly between that family and whoever takes their place. TVC isn't a party to the sale and doesn't broker it.</p>

    <h2>This isn't a financial investment</h2>
    <p>TVC doesn't offer a financial return — it offers a different, non-monetary one, and it's different for each member. For some it's the community itself; for others it's the social impact of the work here; for others still, it's simply living in harmony with nature. There's no single right answer, but it matters that you find your own — the members you'll talk to before joining value very different things about being here, and it's worth understanding why.</p>

    <h2>What we do care about</h2>
    <p>What matters to us is that whoever joins genuinely understands what they're signing up for — the shared labor, the land stewardship, the way decisions get made together, the responsibilities of being one of the families here. This isn't a real-estate transaction to us; it's who joins our community.</p>

    <h2>How to start</h2>
    <p>The way in is conversation, not a form. Before any transaction is discussed, we ask anyone seriously interested to engage with at least 2 existing members to understand their respective reasons for being a part of the community — so you can relate to what draws people here, and what's actually expected of a member.</p>

    <div class="member-pair">
      <figure>
        <img src="/images/members/reva-and-ranjan.jpg" alt="Reva and Ranjan, TVC member family" loading="lazy" />
        <figcaption>Reva &amp; Ranjan</figcaption>
      </figure>
      <figure>
        <img src="/images/members/rajiv-and-kritika.jpg" alt="Rajiv and Kritika, TVC member family" loading="lazy" />
        <figcaption>Rajiv &amp; Kritika</figcaption>
      </figure>
      <p class="member-pair__note">Two of the 53 member families you might end up talking to.</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrapper join-form-wrap">
      <h2>Ready to start the conversation?</h2>
      <p>If you'd like us to keep you in mind should a spot open, tell us a bit about yourself.</p>
      <form
        class="enquiry-form card"
        name="membership-enquiry"
        method="POST"
        action="/contact/thanks"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="membership-enquiry" />
        <p class="enquiry-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="enquiry-grid">
          <div>
            <label for="membership-name">Name</label>
            <input id="membership-name" type="text" name="name" placeholder="Your name" autocomplete="name" required />
          </div>
          <div>
            <label for="membership-email">Email</label>
            <input id="membership-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          </div>
          <div>
            <label for="membership-phone">Phone (optional)</label>
            <input id="membership-phone" type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" />
          </div>
        </div>
        <label for="membership-message">Tell us about yourself and why TVC interests you</label>
        <textarea id="membership-message" name="message" rows="4" required></textarea>
        <button class="button" type="submit">Send enquiry</button>
      </form>
      <p class="join-other-reason">Reaching out for a different reason? <a href="/contact">Visit our Contact page →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .join-form-wrap {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .enquiry-form {
    text-align: left;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .enquiry-form label {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .enquiry-form input,
  .enquiry-form textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  .enquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
  }

  .enquiry-form button {
    align-self: flex-start;
  }

  /* Netlify Forms spam honeypot — off-screen, not display:none (some bots
     skip hidden fields, but few check for visibility via position). */
  .enquiry-hp {
    position: absolute;
    left: -9999px;
  }

  .join-other-reason {
    margin-top: 20px;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
  }

  .member-pair {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--tvc-line);
  }

  .member-pair figure {
    margin: 0;
    text-align: center;
  }

  .member-pair img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .member-pair figcaption {
    font-size: 0.8rem;
    color: var(--tvc-ink-soft);
    margin-top: 6px;
  }

  .member-pair__note {
    margin: 0;
    color: var(--tvc-ink-soft);
    font-size: 0.9rem;
    font-style: italic;
  }
</style>

<script>
  // Netlify Forms handles the actual email for the form above (native
  // submission, no preventDefault — see its data-netlify attribute). This
  // only adds the second requirement Netlify Forms can't do on its own:
  // logging the same enquiry as a row in a Google Sheet
  // (netlify/functions/enquiry.mts). navigator.sendBeacon fires a
  // fire-and-forget POST designed to survive the page navigating away right
  // after — unlike a plain fetch() issued in the same submit handler, which
  // isn't guaranteed to complete once the browser starts navigating.
  document.querySelector<HTMLFormElement>('form[name="membership-enquiry"]')?.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const payload = {
      formType: 'membership',
      name: data.get('name'),
      email: data.get('email'),
      phone: data.get('phone'),
      message: data.get('message'),
      botField: data.get('bot-field'),
    };
    navigator.sendBeacon('/api/enquiry', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
  });
</script>
