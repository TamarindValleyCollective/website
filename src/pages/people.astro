function initials(name: string) {
  const parts = name.split('&').map((p) => p.trim()).filter(Boolean);
  if (parts.length > 1) {
    return parts.map((p) => p.split(/\s+/)[0][0]).join('').toUpperCase();
  }
  const words = parts[0].split(/\s+/);
  return (words[0][0] + (words[1]?.[0] ?? '')).toUpperCase();
}
---

<BaseLayout title="People" description="The people of Tamarind Valley Collective — the 53 member families, the local staff who run things day to day, our partners, and our work with the neighboring community." image="/images/members/reva-and-ranjan.jpg" imageWidth={768} imageHeight={576}>
  <PageHero
    eyebrow="People"
    title="Who's part of TVC"
    intro="The member families who own the land collectively, the local staff who run it day to day, and the partners and neighboring community who make it all work."
    image="/images/members/reva-and-ranjan.jpg"
    imageAlt="Two of TVC's member families at the farm"
  />

  <section class="section wrapper" id="members">
    <h2>Member families</h2>
    <p>The 53 families who make up the collective — most joined between the founding in 2017 and today.</p>
    <div class="members-grid">
      {members.map((m) => (
        <div class="member-card">
          {m.photo ? (
            <img src={m.photo} alt={m.name} class="member-photo" loading="lazy" />
          ) : (
            <div class="member-photo member-photo--placeholder" aria-hidden="true">{initials(m.name)}</div>
          )}
          <h4>{m.name}</h4>
          {m.bio && <p>{m.bio}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>Our local staff</h2>
      <p>The day-to-day activities at TVC are managed by a small, dedicated team living on-site.</p>
      <div class="staff-grid">
        {staff.map((s) => (
          <div class="card">
            <h4>{s.name}</h4>
            <p class="staff-role">{s.role}</p>
            <p>{s.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrapper" id="partners">
    <h2>Partners &amp; collaborators</h2>
    <p>Beyond TVC's own community, a handful of organizations have supported us along the way — from hospitality to permaculture design.</p>
    <div class="partners-grid">
      {partners.map((p) => (
        <a class="partner-card" href={p.data.url} target="_blank" rel="noopener noreferrer">
          {p.data.coverImage && <img src={p.data.coverImage} alt={p.data.title} loading="lazy" />}
          <h4>{p.data.title}</h4>
          <p>{p.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>Community outreach</h2>
      <p>Our ongoing work with the local community around TVC, in Odhipuram and Thaggatti village.</p>
      <a class="button button--outline" href="/people/community-outreach">See our outreach →</a>
    </div>
  </section>

  <section class="section wrapper">
    <div class="join">
      <h2>Interested in becoming a member?</h2>
      <p>Membership isn't really open — 53 families is close to as large as this community will get. When a spot does open, it passes privately between members rather than through any application process. Here's exactly how that works.</p>
      <a class="button" href="/join">Read how it works →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .member-card {
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 16px;
    text-align: center;
  }

  .member-card h4 {
    font-size: 0.88rem;
    margin: 0;
  }

  .member-card p {
    font-size: 0.78rem;
    color: var(--tvc-ink-soft);
    margin: 6px 0 0;
  }

  .member-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 10px;
    display: block;
  }

  .member-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tvc-green-tint);
    color: var(--tvc-green-dark);
    font-weight: 700;
    font-size: 1rem;
  }

  .staff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .staff-role {
    color: var(--tvc-orange);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }

  /* Each partner links straight out to its own site (see the url field on
     the partners collection) rather than to a TVC-hosted detail page --
     with only 88-130 words of content per partner, a dedicated route
     wasn't earning its keep. */
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .partner-card {
    display: block;
    background: #fff;
    border: 1px solid var(--tvc-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .partner-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(34, 41, 31, 0.14);
  }

  .partner-card img {
    width: 100px;
    height: 100px;
    object-fit: contain;
    margin: 0 auto 12px;
  }

  .partner-card h4 {
    margin: 0;
  }

  .partner-card p {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin: 8px 0 0;
  }

  .join {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
  }
</style>
