---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const WHATSAPP_GROUP_URL = 'https://chat.whatsapp.com/90AI4NABZVZJUAo8p09IAD?s=cl&p=i&ilr=0';
const MADHAVAN_WHATSAPP_NUMBER = '917406307309';
const madhavanWhatsappHref = `https://wa.me/${MADHAVAN_WHATSAPP_NUMBER}?text=${encodeURIComponent("Hi, I'd like to know more about TVC.")}`;
---

<BaseLayout title="Contact Us" description="Get in touch with Tamarind Valley Collective — the Friends of TVC WhatsApp group and general enquiries." image="/images/pages/location/hero.png" imageWidth={1177} imageHeight={673}>
  <PageHero eyebrow="Contact Us" title="Get in touch" image="/images/pages/location/hero.png" imageAlt="Map showing TVC's location on the Tamil Nadu–Karnataka border" />

  <section class="section wrapper contact-options">
    <div class="card option-card">
      <h2>Friends of TVC</h2>
      <p>Want occasional updates on events, volunteering, and life at TVC? Join the Friends of TVC WhatsApp group — no form to fill in, just tap to join.</p>
      <a class="button" href={WHATSAPP_GROUP_URL} target="_blank" rel="noopener noreferrer">Join on WhatsApp →</a>
    </div>

    <div class="card option-card">
      <h2>General enquiries</h2>
      <p>Press, partnerships, volunteering, or just a question — reach out below, or message Madhavan directly.</p>
      <div class="general-enquiry-layout">
        <form
          class="enquiry-form"
          name="general-enquiry"
          method="POST"
          action="/contact/thanks"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="general-enquiry" />
          <p class="enquiry-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="enquiry-grid">
            <div>
              <label for="general-name">Name</label>
              <input id="general-name" type="text" name="name" placeholder="Your name" autocomplete="name" required />
            </div>
            <div>
              <label for="general-email">Email</label>
              <input id="general-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
            </div>
            <div>
              <label for="general-phone">Phone (optional)</label>
              <input id="general-phone" type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" />
            </div>
          </div>
          <label for="general-message">Message</label>
          <textarea id="general-message" name="message" rows="4" required></textarea>
          <button class="button" type="submit">Send enquiry</button>
        </form>

        <div class="whatsapp-cta">
          <p>Prefer to chat? Message Madhavan directly:</p>
          <a class="button button--outline" href={madhavanWhatsappHref} target="_blank" rel="noopener noreferrer">Message Madhavan on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint wrapper contact-grid">
    <div>
      <h3>Phone</h3>
      <p>Madhav — general enquiries: <a href="tel:+917406307309">+91 74063 07309</a></p>
      <p>Visit bookings: <a href="tel:+918548065772">+91 85480 65772</a></p>

      <h3>Address</h3>
      <p>Tamarind Valley Collective<br />Thaggatti village, near Kanakapura<br />Karnataka/Tamil Nadu border, India</p>

      <h3>Social</h3>
      <p>
        <a href="https://www.facebook.com/farm.tvc" target="_blank" rel="noopener noreferrer">Facebook</a> ·
        <a href="https://twitter.com/TVCFarm" target="_blank" rel="noopener noreferrer">Twitter</a> ·
        <a href="https://www.instagram.com/tamarindvalleycollective/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </p>
    </div>

    <div>
      <h3>Location</h3>
      <div class="map-embed">
        <iframe
          loading="lazy"
          src="https://www.google.com/maps?cid=12716822598495943685&output=embed"
          width="100%"
          height="360"
          style="border:0"
          title="Tamarind Valley Collective on Google Maps"
        ></iframe>
      </div>
      <p class="caption">Pulled directly from our <a href="https://www.google.com/maps?cid=12716822598495943685" target="_blank" rel="noopener noreferrer">Google Business Profile</a> — see reviews and get directions there too.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-options {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .option-card h2 {
    margin-top: 0;
  }

  .general-enquiry-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    align-items: start;
    margin-top: 16px;
  }

  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .enquiry-form label {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .enquiry-form input,
  .enquiry-form textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  .enquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }

  .enquiry-form button {
    align-self: flex-start;
  }

  .whatsapp-cta {
    padding: 20px;
    border: 1px dashed var(--tvc-line);
    border-radius: var(--radius);
    text-align: center;
    margin-top: 16px;
  }

  .whatsapp-cta p {
    margin-bottom: 12px;
  }

  /* Netlify Forms spam honeypot — off-screen, not display:none (some bots
     skip hidden fields, but few check for visibility via position). */
  .enquiry-hp {
    position: absolute;
    left: -9999px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
  }

  .contact-grid h3 {
    margin-top: 24px;
  }

  .contact-grid h3:first-child {
    margin-top: 0;
  }

  .map-embed iframe {
    border-radius: var(--radius);
  }

  .caption {
    font-size: 0.85rem;
    color: var(--tvc-ink-soft);
    margin-top: 10px;
  }

  @media (max-width: 780px) {
    .general-enquiry-layout,
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Netlify Forms handles the actual email for the form below (native
  // submission, no preventDefault — see its data-netlify attribute). This
  // only adds the second requirement Netlify Forms can't do on its own:
  // logging the same enquiry as a row in a Google Sheet
  // (netlify/functions/enquiry.mts). navigator.sendBeacon fires a
  // fire-and-forget POST designed to survive the page navigating away right
  // after — unlike a plain fetch() issued in the same submit handler, which
  // isn't guaranteed to complete once the browser starts navigating.
  document.querySelector<HTMLFormElement>('form[name="general-enquiry"]')?.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const payload = {
      formType: 'general',
      name: data.get('name'),
      email: data.get('email'),
      phone: data.get('phone'),
      message: data.get('message'),
      botField: data.get('bot-field'),
    };
    navigator.sendBeacon('/api/enquiry', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
  });
</script>
