---
import EventDetailView from '../../../components/views/EventDetailView.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft && e.id.startsWith('kn/'));
  return events.map((event) => ({ params: { slug: event.id.replace(/^kn\//, '') }, props: { event } }));
}

const { event } = Astro.props;
---

<EventDetailView lang="kn" event={event} />
