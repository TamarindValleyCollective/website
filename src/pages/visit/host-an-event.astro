---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { formatDateRange } from '../../utils/events';
import { FARM_AREA_ACRES } from '../../data/site-facts';

// Two concrete proof points, one per audience track below - not a general
// events query, since the whole point is naming things that actually
// happened rather than a generic "see our events" pointer.
const proofIds = ['2022-12-16-the-lambda-retreat', '2024-12-21-3bs-and-1h-biodiversity-walk'];
const proofEvents = (await getCollection('events', (e) => proofIds.includes(e.id))).sort(
  (a, b) => proofIds.indexOf(a.id) - proofIds.indexOf(b.id)
);
---

<BaseLayout
  title="Host Your Event at TVC"
  description="Bring your retreat, workshop, or camp to Tamarind Valley Collective — a 98-acre hillslope in the Melagiri Hills with some of the darkest skies around, on-site camping, and a track record hosting everything from biodiversity walks to a week-long computation retreat."
  image="/images/pages/home/gallery-4.jpg"
  imageWidth={1280}
  imageHeight={960}
>
  <PageHero
    eyebrow="Visit TVC"
    title="Host Your Event at TVC"
    intro="98 acres of hill country, some of the darkest skies around, and room to camp — the setting for team outings, workshops, retreats, and camps of every kind."
    image="/images/pages/home/gallery-4.jpg"
    imageAlt="Sunset over the Melagiri Hills"
  />

  <section class="section wrapper">
    <h2>Why here</h2>
    <p>TVC is {FARM_AREA_ACRES} acres of the Melagiri Hills, on a west-facing hillslope an hour or two outside Bangalore depending on where you're coming from — far enough to feel like a real break, close enough to reach for a weekend. The valley measures just 31.8 μcd/m² of artificial brightness, so on a clear night the stars and galaxies are bright and unmistakable — a real draw whether you're running a stargazing session or just want a group to disconnect for a few days.</p>
    <p>That disconnection is literal, not just a figure of speech: there's WiFi via BSNL, which should tell you all you need to know about its reliability, and power is grid-fed with a solar backup and a generator for the rare bad day. Bring a hotspot if your event genuinely needs guaranteed connectivity — otherwise, treat the unreliability as part of the pitch.</p>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>What's possible here</h2>
      <p class="section-hint">Who runs the event doesn't matter as much as whether the setting fits it — here's what's worked, and what we're open to.</p>
      <div class="track-grid">
        <div class="card">
          <h3>Nature, wellness &amp; biodiversity</h3>
          <p>Biodiversity walks, birding, foraging, wellness retreats, or a workshop on permaculture design, bamboo craft, or growing your own food — the land's food forest, water works, and forest edge are the whole point. Over 100 bird species have been recorded here.</p>
          {proofEvents[1] && (
            <a class="track-proof" href={`/events/${proofEvents[1].id}`}>
              Proof it works: {proofEvents[1].data.title} ({formatDateRange(proofEvents[1].data.date, proofEvents[1].data.endDate)}) →
            </a>
          )}
        </div>
        <div class="card">
          <h3>Tech, maker &amp; deep-focus retreats</h3>
          <p>No open-plan office, no city noise, no reliable WiFi to half-pay-attention through — just a small group, a shared table, and days at a time to go deep on something hard.</p>
          {proofEvents[0] && (
            <a class="track-proof" href={`/events/${proofEvents[0].id}`}>
              Proof it works: {proofEvents[0].data.title} ({formatDateRange(proofEvents[0].data.date, proofEvents[0].data.endDate)}) →
            </a>
          )}
        </div>
        <div class="card">
          <h3>Team offsites &amp; anything else</h3>
          <p>Team outings, brainstorming sessions, leadership programs — facilitators from the community are available on request. Or something we haven't listed here: if your event needs a quiet, off-grid setting for a few days, tell us about it and we'll work out whether it fits.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrapper">
    <h2>What's here</h2>
    <p>Tented accommodation across the Malabar hut (two tents, each fitting up to 3 adults), the Banyan hut (one tent + deck), two bamboo huts, and dome tents — the site accommodates up to 20 people overnight. There's a lunch hut next to the kitchen for group meals, sessions, or just sitting and talking. Food is freshly prepared and mostly vegetarian, sourced on-site as far as possible, with non-veg on request. Common toilets have western closets and showers (no hot water on tap, but the kitchen can heat some up).</p>
    <p>Day-only events aren't capped at 20 — that limit is specifically the overnight camping capacity. Get in touch with your headcount and we'll work out what fits.</p>
  </section>

  <section class="section section--tint">
    <div class="wrapper">
      <h2>Get in touch</h2>
      <p class="section-hint">Tell us about your event and we'll get back to you with availability and a quote.</p>
      <form
        class="inquiry-form card"
        name="host-event-inquiry"
        method="POST"
        action="/visit/host-an-event/thanks"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="host-event-inquiry" />
        <p class="inquiry-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="inquiry-grid">
          <div>
            <label for="name">Name</label>
            <input id="name" type="text" name="name" placeholder="Your name" autocomplete="name" required />
          </div>
          <div>
            <label for="organization">Organization (optional)</label>
            <input id="organization" type="text" name="organization" placeholder="Group or organization name" autocomplete="organization" />
          </div>
          <div>
            <label for="email">Email</label>
            <input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          </div>
          <div>
            <label for="phone">Phone (optional)</label>
            <input id="phone" type="tel" name="phone" placeholder="+91 98765 43210" autocomplete="tel" />
          </div>
          <div>
            <label for="event-type">Event type</label>
            <select id="event-type" name="event-type" required>
              <option value="">Choose one</option>
              <option value="Nature, wellness, or biodiversity retreat">Nature, wellness, or biodiversity retreat</option>
              <option value="Tech, maker, or deep-focus camp">Tech, maker, or deep-focus camp</option>
              <option value="Team offsite">Team offsite</option>
              <option value="Something else">Something else</option>
            </select>
          </div>
          <div>
            <label for="group-size">Expected group size</label>
            <input id="group-size" type="text" name="group-size" placeholder="e.g. 15 people" required />
          </div>
        </div>

        <label for="dates">Preferred dates or season</label>
        <input id="dates" type="text" name="dates" placeholder="e.g. a weekend in December, or flexible" />

        <label for="message">Tell us about your event</label>
        <textarea id="message" name="message" rows="4" placeholder="What you're planning, and anything else we should know" required></textarea>

        <button class="button" type="submit">Send inquiry</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .track-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }

  .track-proof {
    display: inline-block;
    margin-top: 12px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .inquiry-form {
    max-width: 640px;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .inquiry-form label {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--tvc-line);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  .inquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  .inquiry-form button {
    align-self: flex-start;
  }

  /* Netlify Forms spam honeypot - off-screen, not display:none (some bots
     skip hidden fields, but few check for visibility via position). */
  .inquiry-hp {
    position: absolute;
    left: -9999px;
  }
</style>
