# Copy to .env for local `netlify dev` testing of the chat widget, and for
# running scripts/caption-photos.mjs (AI-drafted In Pictures captions).
# In production (Netlify), set this in Site settings > Environment variables
# instead — never commit a real key.
ANTHROPIC_API_KEY=

# Only needed locally, to run scripts/curate-photos.mjs (In Pictures photo
# curation). Never used at build/deploy time - the site itself just embeds
# the public media.tvc.farm URLs these uploads produce, so this never needs
# to be a Netlify environment variable.
# R2 dashboard: Account Home -> R2 Object Storage -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tvc-photos

# Photo pool: staff/partners drop event photos into a shared Google Drive
# folder, reviewed via /internal/photo-pool before entering the
# curate-photos.mjs pipeline above. The service account credentials are
# needed both locally (to run scripts/pull-approved-photos.mjs) and as
# Netlify env vars (for netlify/functions/photo-pool.mts) — set the
# Netlify-only ones (GDRIVE_INBOX_FOLDER_ID, GDRIVE_REJECTED_FOLDER_ID,
# PHOTO_POOL_ALLOWED_EMAILS_SHEET_ID) directly in Site settings > Environment
# variables, never here.
GDRIVE_SERVICE_ACCOUNT_EMAIL=
GDRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GDRIVE_APPROVED_FOLDER_ID=
GDRIVE_PUBLISHED_FOLDER_ID=

# Enquiry forms on /contact (membership enquiry, general enquiry): each
# submits normally via Netlify Forms (email, via a dashboard notification —
# see README.md), and separately logs a row to its own Google Sheet via
# netlify/functions/enquiry.mts, using the same service account credentials
# above. Share each spreadsheet with GDRIVE_SERVICE_ACCOUNT_EMAIL as an
# Editor (not just Viewer, since this one writes) before setting these.
MEMBERSHIP_ENQUIRY_SHEET_ID=
GENERAL_ENQUIRY_SHEET_ID=

# Rainfall chart/table/monsoon stat on /ecosystem/weather:
# netlify/functions/rainfall.mts reads the community's "Tvc rain data" Google
# Sheet live on every page view, using the same service account credentials
# above. Share the Sheet with GDRIVE_SERVICE_ACCOUNT_EMAIL as a Viewer
# (read-only is enough, this never writes) before setting this.
RAINFALL_SHEET_ID=

# scripts/check-search-console.mjs (checks Google's indexing/crawl status for
# a URL, e.g. after landing a netlify.toml redirect fix): local-only, uses the
# same service account credentials above. The service account was added as a
# Restricted user on the tvc.farm Search Console property (Settings > Users
# and permissions) on 2026-08-07 — no separate credentials or env vars needed.

# scripts/check-member-story-responses.mjs (reads the "TVC Members: Your
# Story" form's response Sheet, and marks rows processed once folded into
# MembersView.astro): local-only, uses the same service account credentials
# above. Spreadsheet ID is hardcoded in the script, not an env var, same as
# check-search-performance.mjs's SITE_URL - it's a fixed local Sheet, not a
# per-deploy-context value. The Sheet was shared with GDRIVE_SERVICE_ACCOUNT_
# EMAIL as an Editor on 2026-08-08 (needed to write the Processed-at/Notes
# columns back, not just read).

# Photo pool sign-in (Google Identity Services). PUBLIC_GOOGLE_CLIENT_ID is
# not secret — it's embedded in the dashboard's client-side JS either way —
# but it's a build-time value: local astro dev reads it straight from this
# .env file (Vite's PUBLIC_* convention), while production needs it set as a
# Netlify env var scoped to the *Builds* context specifically (not just
# Functions/Runtime like every other var here), or the deployed page
# permanently embeds an empty string until the next rebuild.
PUBLIC_GOOGLE_CLIENT_ID=
